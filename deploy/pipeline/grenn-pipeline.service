[Unit]
Description=GRENN site data: crawl, compile with GLM-4-Flash, export, publish (replaces mirroring the private repo)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=grenn
Group=grenn
# grenn's home (the news database) is read-only here
Environment=HOME=/srv/grenn/pipeline/state
ExecStart=/srv/grenn/bin/grenn-pipeline.sh
# root part: validate, re-typeset the brief, precompress and switch /srv/grenn/data/current (only after success)
ExecStartPost=+/srv/grenn/bin/sync-data.sh --force --from /srv/grenn/pipeline/repo/site/data
SyslogIdentifier=grenn-pipeline
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
MemoryMax=1200M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/grenn/pipeline
