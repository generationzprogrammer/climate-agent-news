name = "climate-news-subscriptions"
main = "src/index.js"
compatibility_date = "2026-08-01"

[vars]
CLIMATE_ALLOWED_ORIGIN = "https://generationzprogrammer.github.io"

[[kv_namespaces]]
binding = "CLIMATE_SUBSCRIBERS_KV"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

# Add CLIMATE_SUBSCRIBER_ADMIN_TOKEN as an encrypted Worker secret.
