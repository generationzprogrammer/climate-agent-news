{"text_id": "text_315856b58362a5024275", "record_id": "article_315856b58362a502", "canonical_url": "https://news.mongabay.com/2025/04/mongabay-mourns-the-loss-of-ochieng-ogodo-our-east-africa-editor", "publisher_url": "https://news.mongabay.com/2025/04/mongabay-mourns-the-loss-of-ochieng-ogodo-our-east-africa-editor", "title_original": "Mongabay mourns the loss of Ochieng’ Ogodo, our East Africa Editor", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-17T18:49:56+00:00", "source_text": "It is with deep sorrow that we announce the sudden passing of Ochieng’ Ogodo, Mongabay’s East Africa editor, who died early Thursday morning in Nairobi, Kenya, at the age of 64. According to his family, Ochieng’ experienced sudden and severe chest pain around 2:00 a.m. local time and was rushed to Mama Lucy Hospital, where […]", "text_kind": "source_excerpt", "text_characters": 328, "text_sha256": "02687500ce93746af76deab6b8dfcbba5a1c8d5b8c40fc8ce32f119e700629fd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:35.555439+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "annotation_method": "dictionary-evidence-v1", "review_status": "m