{"text_id": "text_821bbbe11d6bfc583037", "record_id": "article_821bbbe11d6bfc58", "canonical_url": "https://news.mongabay.com/2025/01/global-ocean-temperatures-set-new-record-in-2024", "publisher_url": "https://news.mongabay.com/2025/01/global-ocean-temperatures-set-new-record-in-2024", "title_original": "Global ocean temperatures set new record in 2024", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-15T14:55:49+00:00", "source_text": "Average temperatures across the world’s oceans reached an all-time high in 2024, a new multi-team study shows. The temperatures surpassed even those of 2023, which themselves represented a marked uptick over any previous years on record, according to the study published Jan.10 in the journal Advances in Atmospheric Sciences. The ocean stores about 90% of […]", "text_kind": "source_excerpt", "text_characters": 360, "text_sha256": "9bfa1db62201d7fec1ab6e98c7afcae828e914e6cc6d12fd2c0de3b897984e3e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:24.741012+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "90%", "start": 350, "end": 353, "evidence": " The ocean stores about 90% of […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 8, "end": 19, "evidence": "Average temperatures across the world’s oceans reached an all-time high in 2024, a new multi-team study shows. The temperatures surpassed even those of 2023, w"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:24.756880+00:00", "published_at_raw": "2025-01-15T14:55:49", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_9e9040009c842def4a87", "record_id": "article_9e9040009c842def", "canonical_url": "https://insideclimatenews.org/news/14012025/todays-climate-los-angeles-fires-housing-crisis", "publisher_url": "https://insideclimatenews.org/news/14012025/todays-climate-los-angeles-fires-housing-crisis", "title_original": "Los Angeles Fires Are Exacerbating the City’s Housing Crisis", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-14T20:06:05+00:00", "source_text": "As the Los Angeles area fires rage on, tens of thousands of people are left displaced. Those who lost homes to the flames are scrambling to find new or temporary housing, but face a massive barrier: Many listing prices on the market have shot up—by a lot. Last Tuesday, California Gov. Gavin Newsom declared a […]", "text_kind": "source_excerpt", "text_characters": 313, "text_sha256": "2066e24276c67cac6e7af32afcc55f133624af6503fdd04e84a5753ca03bc67d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:05.730646+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_ext