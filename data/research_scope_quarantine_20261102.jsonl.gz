{"text_id": "text_eb46d5bb62ba6aaab3ae", "record_id": "article_eb46d5bb62ba6aaa", "canonical_url": "https://news.mongabay.com/2024/03/dna-analysis-of-rare-philippine-fruit-dove-sheds-new-light-on-a-70-year-mystery", "publisher_url": "https://news.mongabay.com/2024/03/dna-analysis-of-rare-philippine-fruit-dove-sheds-new-light-on-a-70-year-mystery", "title_original": "DNA analysis of rare Philippine fruit dove sheds new light on a 70-year mystery", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-29T15:29:35+00:00", "source_text": "The Negros fruit dove was described from a single specimen collected in the Philippines in 1953 — then never seen again by scientists. Now, thanks to advances in DNA sequencing, researchers and conservationists are closer to unraveling the secrets of one of the world’s most mysterious birds — including identifying habitats where it may still […]", "text_kind": "source_excerpt", "text_characters": 347, "text_sha256": "78852d0dd53ade6b27065cae6d36e3fc762a84a0eee7ee5713191c5ef50957b5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:52.353212+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippi