{"text_id": "text_bc1e8d9bbf88b5f8d012", "record_id": "article_bc1e8d9bbf88b5f8", "canonical_url": "https://news.mongabay.com/2026/02/nepal-signs-major-carbon-deal-but-community-access-remains-challenging", "publisher_url": "https://news.mongabay.com/2026/02/nepal-signs-major-carbon-deal-but-community-access-remains-challenging", "title_original": "Nepal signs major carbon deal but community access remains challenging", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-26T02:01:14+00:00", "source_text": "KATHMANDU — Nepal signed an agreement with the LEAF Coalition on Jan. 23, becoming the first country in Asia to secure a deal expected to potentially deliver $55 million in carbon finance to support forest-dependent communities. However, carbon trade experts and forest group members say that ensuring the money reaches communities remains a challenge, as […]", "text_kind": "source_excerpt", "text_characters": 359, "text_sha256": "e9ed8391fe351ca90fb77ac027a62dd32403702e561687dc797397d40e032b40", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:59.733170+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$55 million", "start": 158, "end": 169, "evidence": " 23, becoming the first country in Asia to secure a deal expected to potentially deliver $55 million in carbon finance to support forest-dependent communities.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha