{"text_id": "text_09f8deddabd6aa41eaee", "record_id": "article_09f8deddabd6aa41", "canonical_url": "https://news.mongabay.com/2024/12/killer-whales-have-found-new-homes-in-the-arctic-ocean-potentially-reshaping-marine-ecology", "publisher_url": "https://news.mongabay.com/2024/12/killer-whales-have-found-new-homes-in-the-arctic-ocean-potentially-reshaping-marine-ecology", "title_original": "Killer whales have found new homes in the Arctic Ocean, potentially reshaping marine ecology", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-12-03T01:44:16+00:00", "source_text": "Killer whales (Orcinus orca) are finding a new place to roam in the rapidly changing Arctic Ocean. Though Indigenous people in the region have seen the whales, also known as orcas, pop up sporadically for centuries, the predators now have more access to the chilly waters than ever before. Two distinct killer whale populations now […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "a9a2cc88f7f297401b63349465b7a4786b3d2188f9cfeb1d1104a8361c473537", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:46.388083+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 106, "end": 116, "evidence": "rcinus orca) are finding a new place to roam in the rapidly changing Arctic Ocean. Though Indigenous people in the region have seen the whales, also known as orcas, pop up sporadically for centuries, the predators now have more access to th"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:46.401068+00:00", "published_at_raw": "2024-12-03T01:44:16", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_10e1276033c97b890ffe", "record_id": "article_10e1276033c97b89", "canonical_url": "https://yaleclimateconnections.org/2024/12/kids-in-portland-oregon-take-a-bike-bus-to-school", "publisher_url": "https://yaleclimateconnections.org/2024/12/kids-in-portland-oregon-take-a-bike-bus-to-school", "title_original": "Kids in Portland, Oregon, take a ‘bike bus’ to school", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-12-02T12:00:00+00:00", "source_text": "Each week, kids at Alameda Elementary School in Portland, Oregon, pedal to school together in what they call a bike bus. This parade of bicycles has a set route, and kids and parents join the growing caravan along the way. PE teacher Sam Balto organized the bike bus a few years ago. Balto: “It was a huge success. We had 75 kids and we continued to do it every Wednesday for the following school year.” By encouraging biking instead of driving, bike buses can limit planet-warming carbon pollution. Balto also says that as more people ride together, biking becomes safer. Cars slow down and give the large group space. And the kids benefit all day. Balto: “It’s well researched that children do better academically when they’re physically active before school.", "text_kind": "article_excerpt", "text_characters": 761, "text_sha256": "dc4a0a83255483ad5bd2ecbc5d09aaaa816d6b51eb7357d697bacfe690328e67", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:48:48.023087+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 474, "end": 481, "evidence": "owing school year.” By encouraging biking instead of driving, bike buses can limit planet-warming carbon pollution. Balto also says that as more people ride together, biking becomes safer. Cars slow down and give the large group space. A"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:48.059505+00:00", "published_at_raw": "2024-12-02T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_1e92e853e1e3df31d32a", "record_id": "article_1e92e853e1e3df31", "canonical_url": "https://news.mongabay.com/2024/11/antarctic-krill-store-massive-amounts-of-carbon-in-the-deep-ocean-researchers-find", "publisher_url": "https://news.mongabay.com/2024/11/antarctic-krill-store-massive-amounts-of-carbon-in-the-deep-ocean-researchers-find", "title_original": "Antarctic krill store massive amounts of carbon in the deep ocean, researchers find", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-29T10:15:14+00:00", "source_text": "In the icy waters surrounding Antarctica, small shrimp-like crustaceans called krill (Euphausia superba) swim in swarms of trillions, forming a biomass larger than the entire human population. Scientists knew these 5-centimeter-long creatures could trap carbon from the atmosphere in the ocean floor, but were unaware of the sheer scale. New research has now revealed just […]", "text_kind": "source_excerpt", "text_characters": 376, "text_sha256": "b4ff24507ddd90e3007a2aa5eefb5ee4ed233a8ee2d6ed931d4abc7710a1032e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:46.651418+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AQ", "alpha3": "ATA", "name_zh": "南极洲", "name_en": "Antarctica"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "AQ", "alpha3": "ATA", 