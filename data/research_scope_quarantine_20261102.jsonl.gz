{"text_id": "text_b4c1ce38192c86d3b261", "record_id": "article_b4c1ce38192c86d3", "canonical_url": "https://insideclimatenews.org/news/23072026/trump-administration-deep-sea-mining-lease-sale", "publisher_url": "https://insideclimatenews.org/news/23072026/trump-administration-deep-sea-mining-lease-sale", "title_original": "Trump Administration Wants to Hold World’s First Deep-Sea Mining Lease Sale", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-23T20:58:19+00:00", "source_text": "The Trump administration is moving closer to opening up U.S. waters for deep-sea mining—a contentious and largely untested industry focused on extracting mineral-rich deposits from the ocean floor containing cobalt, copper, nickel and manganese. Last week, the Department of Interior’s newly created Marine Minerals Administration (MMA) announced a proposal to hold a lease sale for […]", "text_kind": "source_excerpt", "text_characters": 386, "text_sha256": "818cabac4401c0b4389cefe34deb5c7388284d7219db77a184f15bc39ebd93df", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:37.054970+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 349, "end": 357, "evidence": "e Department of Interior’s newly created Marine Minerals Administration (MMA) announced a proposal to hold a lease sale for […]"}], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:37.067320+00:00", "published_at_raw": "2026-07-23T20:58:19", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 56, "end": 60, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_d73171ed9754acad1553", "record_id": "article_d73171ed9754acad", "canonical_url": "https://insideclimatenews.org/news/22072026/washington-state-winter-rains-leads-to-increased-drought", "publisher_url": "https://insideclimatenews.org/news/22072026/washington-state-winter-rains-leads-to-increased-drought", "title_original": "More Snow Is Falling as Rain in Washington, Leading to Increased Drought in Key Agricultural Areas", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-22T08:55:00+00:00", "source_text": "SEATTLE—In December 2025, torrential rains and catastrophic flooding hit western Washington. High precipitation levels, combined with the warmest December on record for the state, meant that many mountainous areas received rain rather than snow, leading to a deluge that broke through two levees and caused an estimated $182 million in damages to public infrastructure. The […]", "text_kind": "source_excerpt", "text_characters": 377, "text_sha256": "6b5f57d8b85b5e258e5e531c869f65d7af4941e9b963a63b8d402c9edc25b8f2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:37.493570+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$182 million", "start": 320, "end": 332, "evidence": " High precipitation levels, combined with the warmest December on record for the state, meant that many mountainous areas received rain rather than snow, leading to a deluge that broke through two levees and caused an estimated $182 million in damages to public infrastructure.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 60, "end": 65, "evidence": "SEATTLE—In December 2025, torrential rains and catastrophic flooding hit western Washington. High precipitation levels, combined with the warmest December on record for the state, meant that many mountaino"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:37.505370+00:00", "published_at_raw": "2026-07-22T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_01afa7702b60ba8c478b", "record_id": "article_01afa7702b60ba8c", "canonical_url": "https://dialogue.earth/en/climate/pakistans-solar-revolution-leans-on-workers-toiling-in-extreme-heat", "publisher_url": "https://dialogue.earth/en/climate/pakistans-solar-revolution-leans-on-workers-toiling-in-extreme-heat", "title_original": "Pakistan’s solar revolution leans on workers toiling in extreme heat", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-21T16:45:32+00:00", "source_text": "Abdul Rehman used to clean solar panels on Karachi’s rooftops during the hottest part of the day. But working through last year’s sweltering summers left the 33-year-old dizzy and severely dehydrated. “It was one of the worst experiences. I felt I would faint,” Rehman tells Dialogue Earth. “It taught me a lesson: I will have to take care of myself because no one else will.” This is a CATCH story This story is part of Dialogue Earth’s work on the Community Adaptations to City Heat (CATCH) project, in partnership with Boston University. The project is funded by Wellcome. All Dialogue Earth content is editorially independent. Read more stories from CATCH. Pakistan has been experiencing a solar boom , easing the immediate impacts of the war in Southwest Asia.", "text_kind": "article_excerpt", "text_characters": 765, "text_sha256": "4736d6916b528e25e68fd475999822fae2339b53499d90644724397a3b137004", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:28.673730+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan"}], "governance_themes": [{"id": "adaptation", "label_zh": "适应与韧性", "label_en": "Adaptation and resilience", "start": 460, "end": 470, "evidence": "will.” This is a CATCH story This story is part of Dialogue Earth’s work on the Community Adaptations to City Heat (CATCH) project, in partnership with Boston University. The project is funded by Wellcome. All Dialogue Earth content is edit"}, {"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 27, "end": 32, "evidence": "Abdul Rehman used to clean solar panels on Karachi’s rooftops during the hottest part of the day. But working through last year’s sweltering summers left the 33-year-old di"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:28.728315+00:00", "published_at_raw": "2026-07-21T16:45:32", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan", "start": 0, "end": 8, "matched_text": "Pakistan", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan", "start": 661, "end": 669, "matched_text": "Pakistan", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_n