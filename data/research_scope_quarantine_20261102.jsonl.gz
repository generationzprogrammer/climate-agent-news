{"text_id": "text_05aca13372da3936017b", "record_id": "article_05aca13372da3936", "canonical_url": "https://news.mongabay.com/2024/10/thailands-budding-mangrove-restoration-plans-spark-both-hope-and-concern", "publisher_url": "https://news.mongabay.com/2024/10/thailands-budding-mangrove-restoration-plans-spark-both-hope-and-concern", "title_original": "Thailand’s budding mangrove restoration plans spark both hope and concern", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-17T00:49:53+00:00", "source_text": "BANGKOK, Thailand — Standing on a coastal boardwalk overlooking the upper Gulf of Thailand, Wisut Leksomboon points to two mature mangrove trees whose branches intertwine like lovers’ limbs. “We found that by planting two seedlings close together, they can offer each other support as they grow. These trees are about 30 years old,” Wisut tells […]", "text_kind": "source_excerpt", "text_characters": 348, "text_sha256": "7ba40ab8a6251e8c995f06360cd3c9a4f30432fe18b26bf1b07a5d6cb5b1c363", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:09.519089+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:09.533247+00:00", "published_at_raw": "2024-10-17T00:49:53", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand", "start": 0, "end": 8, "matched_text": "Thailand", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand", "start": 9, "end": 17, "matched_text": "Thailand", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_3d691eb663e75a978382", "record_id": "article_3d691eb663e75a97", "canonical_url": "https://dialogue.earth/en/nature/qa-david-obura-you-cant-grow-forever-on-a-finite-planet", "publisher_url": "https://dialogue.earth/en/nature/qa-david-obura-you-cant-grow-forever-on-a-finite-planet", "title_original": "‘You can’t grow forever on a finite planet’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-16T15:28:18+00:00", "source_text": "On a humid September morning, David Obura speaks to Dialogue Earth from the seaside town of Kilifi in Kenya, 70 kilometres up the coast from Mombasa. His proximity to the ocean is fitting: Obura has spent nearly three decades studying and advocating for the preservation of coral reefs, becoming a world-renowned marine scientist in the process. Obura’s work ranges from hands-on research to high-level policy at global summits, which has led him to become one of the most influential voices in the global biodiversity debate. He now chairs the Intergovernmental Science-Policy Platform on Biodiversity and Ecosystem Services ( IPBES ), a group that produces influential biodiversity assessments and provides policy support.", "text_kind": "article_excerpt", "text_characters": 724, "text_sha256": "4bb6f99d40a2b8665fc58ee27bb405bd5f10450a599299824b225ae967b3855e", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:51.570376+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:51.735721+00:00", "published_at_raw": "2024-10-16T15:28:18", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 102, "end": 107, "matched_text": "Kenya", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_413bae31670ff298e57d", "record_id": "article_413bae31670ff298", "canonical_url": "https://news.mongabay.com/2024/10/local-ngo-rains-brings-relief-to-ghanas-semiarid-north-with-regenerative-farming", "publisher_url": "https://news.mongabay.com/2024/10/local-ngo-rains-brings-relief-to-ghanas-semiarid-north-with-regenerative-farming", "title_original": "Local NGO RAINS brings relief to Ghana’s semiarid north with regenerative farming", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-16T13:35:26+00:00", "source_text": "In northern Ghana, communities are facing food insecurity and declining livelihoods due to erratic weather, degraded soils and loss of forests. Among those working on ways to unpick this complicated knot of challenges in the Northern Savannah Zone is an NGO called the Regional Advisory Information and Network Systems, or RAINS. The NSZ stretches 97,000 […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "c99921ab167d5ea9f5a51ef2f04592daa370b4b8b467dba96db5e332eab55ec7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:09.540223+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:09.554755+00:00", "published_at_raw": "2024-10-16T13:35:26", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana", "start": 33, "end": 38, "matched_text": "Ghana", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana", "start": 12, "end": 17, "matched_text": "Ghana", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_9da5af1a56ca4241b034", "record_id": "article_9da5af1a56ca4241", "canonical_url": "https://insideclimatenews.org/news/16102024/california-desert-solar-development-burden", "publisher_url": "https://insideclimatenews.org/news/16102024/california-desert-solar-development-burden", "title_original": "As Solar Booms in the California Desert, Locals Feel ‘Overburdened’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-16T09:10:00+00:00", "source_text": "RIVERSIDE, Calif.—For four hours, Mark Carrington sat quietly with his neighbors at the front of his county’s supervisors’ late August board meeting, waiting for his chance to speak. They were there for the final agenda item: a vote from the county board of supervisors to approve Intersect Power’s Easley Solar Project, which would span 3,600 […]", "text_kind": "source_excerpt", "text_characters": 347, "text_sha256": "990b70a325f88015e0f40054a23c3eb6e05494b501200c7b8912c6acc935c1f1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:47.623171+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 306, "end": 311, "evidence": "nda item: a vote from the county board of supervisors to approve Intersect Power’s Easley Solar Project, which would span 3,600 […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:47.636095+00:00", "published_at_raw": "2024-10-16T09:10:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 22, "end": 32, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_f108accba89da6f46931", "record_id": "article_f108accba89da6f4", "canonical_url": "https://news.mongabay.com/2024/10/interview-with-john-perlin", "publisher_url": "https://news.mongabay.com/2024/10/interview-with-john-perlin", "title_original": "Forests and the Fate of Civilizations: A Conversation with John Perlin", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-16T08:19:48+00:00", "source_text": "The narrative of civilization’s rise and fall is often illustrated with grand achievements and epic downfalls, but one of the most understated forces behind humanity’s progress—and its moments of regression—is the forest. John Perlin’s seminal work, A Forest Journey, reveals how forests have been central to human history, shaping the fate of societies from antiquity […]", "text_kind": "source_excerpt", "text_characters": 372, "text_sha256": "653b69655abf71b052548fa4bcdf0eb1de69e9c095a1490f56d75228751a8651", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:09.591637+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:09.606202+00:00", "published_at_raw": "2024-10-16T08:19:48", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_749cfc3c57eee75d9ba2", "record_id": "article_749cfc3c57eee75d", "canonical_url": "https://insideclimatenews.org/news/15102024/saving-coral-genetics-in-turks-and-caicos-to-rebuild-reefs-of-the-future", "publisher_url": "https://insideclimatenews.org/news/15102024/saving-coral-genetics-in-turks-and-caicos-to-rebuild-reefs-of-the-future", "title_original": "Biobanking Corals: One Woman’s Mission to Save Coral Genetics in Turks and Caicos to Rebuild Reefs of the Future", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-15T09:00:00+00:00", "source_text": "PROVIDENCIALES, Turks and Caicos—On a recent Wednesday afternoon, a group of high school students studying marine science crowded inside a 540-square-foot office turned scientific lab set atop a police station at a popular marina. The students hovered over a sky blue fiberglass water tank as they prepared to watch a special group of corals eat. […]", "text_kind": "source_excerpt", "text_characters": 350, "text_sha256": "ac89059684043f7c0011007040b2ed96250dbb157735beceedc11270b7d1d019", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:47.797903+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:47.810019+00:00", "published_at_raw": "2024-10-15T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_83bed1fb579e4de79edf", "record_id": "article_83bed1fb579e4de7", "canonical_url": "https://www.carbonbrief.org/cop16-countries-miss-un-deadline-to-submit-nature-pledges", "publisher_url": "https://www.carbonbrief.org/cop16-countries-miss-un-deadline-to-submit-nature-pledges", "title_original": "COP16: More than 85% of countries miss UN deadline to submit nature pledges", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-15T06:00:00+00:00", "source_text": "More than 85% of countries are set to miss the UN’s deadline to submit new nature pledges ahead of the COP16 biodiversity summit in Colombia, according to a joint investigation by Carbon Brief and the Guardian. Three of the G7 nations are among those not to publish new national pledges, known as national biodiversity strategies and action plans (NBSAPs), ahead of the talks, which will take place in the city of Cali from from 21 October to 1 November. Only five of the 17 “ megadiverse countries ” – which together provide a home to 70% of the world’s biodiversity – have produced new pledges for tackling nature loss, according to the Carbon Brief and Guardian analysis.", "text_kind": "article_excerpt", "text_characters": 674, "text_sha256": "3a975a0d999b25aa547a4fe6a42956b616992fd5678e968d82b3378fd5a3c17b", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:42.652769+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "85%", "start": 10, "end": 13, "evidence": "More than 85% of countries are set to miss the UN’s deadline to submit new nature pledges ahead of the COP16 biodiversity summit in Colombia, according to a joint investigation by Carbon Brief and the Guardian.", "interpretation": "target_or_commitment"}, {"value_text": "70%", "start": 536, "end": 539, "evidence": " Only five of the 17 “ megadiverse countries ” – which together provide a home to 70% of the world’s biodiversity – have produced new pledges for tackling nature loss, according to the Carbon Brief and Guardian analysis.", "interpretation": "target_or_commitment"}], "conference_ids": ["COP16"], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "negotiations", "country_mentions": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:42.687540+00:00", "published_at_raw": "2024-10-15T06:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 132, "end": 140, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_9ba6dae3e751f06ca277", "record_id": "article_9ba6dae3e751f06c", "canonical_url": "https://news.mongabay.com/2024/10/new-tourism-restrictions-to-protect-bangladeshs-unique-wetlands-and-coral-rich-island", "publisher_url": "https://news.mongabay.com/2024/10/new-tourism-restrictions-to-protect-bangladeshs-unique-wetlands-and-coral-rich-island", "title_original": "New tourism restrictions to protect Bangladesh’s unique wetlands and coral-rich island", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-14T15:24:29+00:00", "source_text": "In a bid to protect biodiversity hotspots in the country, Bangladesh plans to restrict tourism and introduce environment-friendly guidelines and directions for tourists visiting the Ecologically Critical Areas (ECAs). The coral reef-rich Saint Martin’s Island and one of the largest haors — a type of wetland ecosystem — in the country, Tanguar Haor, known to […]", "text_kind": "source_excerpt", "text_characters": 363, "text_sha256": "bf3aa4038b2c293a5a9157178b45be0aeeaec31debab2f2c189a3a9066f5c7cd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:15.363599+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:15.394887+00:00", "published_at_raw": "2024-10-14T15:24:29", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh", "start": 36, "end": 46, "matched_text": "Bangladesh", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh", "start": 58, "end": 68, "matched_text": "Bangladesh", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_c43768e390584ee83956", "record_id": "article_c43768e390584ee8", "canonical_url": "https://news.mongabay.com/2024/10/deforestation-remains-low-but-fires-surge-in-brazils-amazon-rainforest", "publisher_url": "https://news.mongabay.com/2024/10/deforestation-remains-low-but-fires-surge-in-brazils-amazon-rainforest", "title_original": "Deforestation remains low, but fires surge in Brazil’s Amazon rainforest", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-12T19:24:23+00:00", "source_text": "The rate of deforestation in the Brazilian Amazon has remained near a six-year low despite a surge in the number of fires burning in Earth’s largest rainforest, according to data released on Friday by Brazil’s national space research institute, INPE. INPE’s deforestation alert system (DETER) reported that 561 square kilometers were cleared in September, bringing […]", "text_kind": "source_excerpt", "text_characters": 368, "text_sha256": "5f403b343fbaedd773ae31ba09835678eb091e0011197540c7d6c38cb7c15287", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:15.448141+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:15.478792+00:00", "published_at_raw": "2024-10-12T19:24:23", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 46, "end": 52, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 201, "end": 207, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_c554a5193e8be3cc99ea", "record_id": "article_c554a5193e8be3cc", "canonical_url": "https://insideclimatenews.org/news/11102024/todays-climate-hurricane-milton-chemicals-sewage-floods", "publisher_url": "https://insideclimatenews.org/news/11102024/todays-climate-hurricane-milton-chemicals-sewage-floods", "title_original": "After Hurricanes Helene and Milton, Bacteria and Chemicals May Lurk in Flood Waters", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-11T19:59:22+00:00", "source_text": "Florida residents are returning to their homes to start picking up the pieces after Hurricane Milton carved a destructive path through the Gulf Coast. The storm would have been far worse if not for some lucky breaks on wind shear and where it made landfall. But damage is widespread, which my colleagues reported earlier today. […]", "text_kind": "source_excerpt", "text_characters": 331, "text_sha256": "675fcac319d0f0365e3967698fbb8c54c5ef24609c7a7c074c5ef97df60013d0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:48.142296+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:48.154460+00:00", "published_at_raw": "2024-10-11T19:59:22", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_5a3fea0732d610409e3f", "record_id": "article_5a3fea0732d61040", "canonical_url": "https://yaleclimateconnections.org/2024/10/landscapes-charred-by-wildfire-can-become-ground-zero-for-floods-and-mudslides", "publisher_url": "https://yaleclimateconnections.org/2024/10/landscapes-charred-by-wildfire-can-become-ground-zero-for-floods-and-mudslides", "title_original": "Landscapes charred by wildfire can become ground zero for floods and mudslides", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-10T11:00:00+00:00", "source_text": "Earlier this year, wildfires raged near the town of Ruidoso, New Mexico, destroying more than a thousand buildings and killing two people. Within a few weeks, the fires had been contained. But then came the rain. Over the next few weeks, rain repeatedly poured down on the recently burned forest. The water rushed off the charred landscape, flooding the town and causing even more damage and danger to residents. Floods and mudslides can be common after wildfires . Wildfires destroy vegetation and coat the soil with a waxy surface, preventing water from seeping into the ground and increasing runoff. So when rain hits a burn scar, that water can quickly rush downhill while picking up dirt and debris, creating dangerous floods within mere minutes.", "text_kind": "article_excerpt", "text_characters": 751, "text_sha256": "86c70298c0bf55b1e8fc1da0e9589cce7413f792fde3a9646c3079d21d1d152a", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:05.160322+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 19, "end": 27, "evidence": "Earlier this year, wildfires raged near the town of Ruidoso, New Mexico, destroying more than a thousand buildings and killing two people. Within a few weeks, the fire"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:05.192371+00:00", "published_at_raw": "2024-10-10T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 61, "end": 71, "matched_text": "New Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_05bc802de909ed120b1b", "record_id": "article_05bc802de909ed12", "canonical_url": "https://news.mongabay.com/2024/10/the-worlds-chocolate-cravings-speed-up-deforestation-in-the-congo-basin-study", "publisher_url": "https://news.mongabay.com/2024/10/the-worlds-chocolate-cravings-speed-up-deforestation-in-the-congo-basin-study", "title_original": "The world’s chocolate cravings speed up deforestation in the Congo Basin: Study", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-09T17:00:18+00:00", "source_text": "Across West and Central Africa’s tropical agricultural belt — and one of the world’s greatest biodiversity hotspots — cacao farming has taken off as demand for chocolate rises in the Global North. The nearly $9 billion cacao bean industry satiates sweet tooths across Europe and North America with roughly 5 million tons of cacao beans […]", "text_kind": "source_excerpt", "text_characters": 339, "text_sha256": "8be6b371fccc152d3c32e70e96ee9d07af91fb1f9222cdb89a6f564b140dad47", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:16.011422+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$9 billion", "start": 208, "end": 218, "evidence": " The nearly $9 billion cacao bean industry satiates sweet tooths across Europe and North America with roughly 5 million tons of cacao beans […]", "interpretation": "not_classified"}, {"value_text": "5 million", "start": 306, "end": 315, "evidence": " The nearly $9 billion cacao bean industry satiates sweet tooths across Europe and North America with roughly 5 million tons of cacao beans […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:16.040362+00:00", "published_at_raw": "2024-10-09T17:00:18", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_edb0528d5888a1a6b431", "record_id": "article_edb0528d5888a1a6", "canonical_url": "https://www.carbonbrief.org/explainer-how-hotter-oceans-can-fuel-more-intense-atlantic-hurricanes", "publisher_url": "https://www.carbonbrief.org/explainer-how-hotter-oceans-can-fuel-more-intense-atlantic-hurricanes", "title_original": "Explainer: How hotter oceans can fuel more intense Atlantic hurricanes", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-09T16:45:47+00:00", "source_text": "Record-breaking sea temperatures across the Gulf of Mexico have been a key ingredient behind some of the intense hurricanes devastating the region this year. Last month, Hurricane Helene made landfall on Florida’s “Big Bend” and then stalled over several states to the north dumping “ enormous rainfall totals ”, resulting in epic flooding which killed at least 220 people. Just a couple of weeks later, Milton – the ninth hurricane to form in the Atlantic this year and one of the most rapidly intensifying hurricanes on record – has swept this week towards Florida’s Tampa Bay region, threatening communities that are still recovering from Helene’s impact.", "text_kind": "article_excerpt", "text_characters": 658, "text_sha256": "b9684e6eebce436f826e1bf84f66c8f3040a5683205374d26cff49ca18f962f2", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:42.880446+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 20, "end": 31, "evidence": "Record-breaking sea temperatures across the Gulf of Mexico have been a key ingredient behind some of the intense hurricanes devastating the region this year. Last month, H"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:42.897113+00:00", "published_at_raw": "2024-10-09T16:45:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 52, "end": 58, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_fb3af6a5836e755cfd80", "record_id": "article_fb3af6a5836e755c", "canonical_url": "https://news.mongabay.com/2024/10/in-bolivia-indigenous-communities-struggle-to-rebuild-as-wildfires-return", "publisher_url": "https://news.mongabay.com/2024/10/in-bolivia-indigenous-communities-struggle-to-rebuild-as-wildfires-return", "title_original": "In Bolivia, Indigenous communities struggle to rebuild as wildfires return", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-08T18:17:56+00:00", "source_text": "Every Sunday, Hermindo Vies wakes up early and travels by river from his village, Asunción de Quiquibey, in Bolivia’s Beni department, to the nearest major town to sell his produce. Though he knows the route along the Quiquibey and Beni rivers well, in recent weeks a thick smoke has settled over the area. “It was […]", "text_kind": "source_excerpt", "text_characters": 318, "text_sha256": "b37e0439d42cba4414780cea2d0ac484cda92dcdd160fe8cae7da7532083afcd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:16.255479+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BO", "alpha3": "BOL", "name_zh": "玻利维亚", "name_en": "Bolivia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BO", "alpha3": "BOL", "name_zh": "玻利维亚", "name_en": "Bolivia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:16.283094+00:00", "published_at_raw": "2024-10-08T18:17:56", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BO", "alpha3": "BOL", "name_zh": "玻利维亚", "name_en": "Bolivia", "start": 3, "end": 10, "matched_text": "Bolivia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BO", "alpha3": "BOL", "name_zh": "玻利维亚", "name_en": "Bolivia", "start": 108, "end": 115, "matched_text": "Bolivia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_a0a125321a76d80a4391", "record_id": "article_a0a125321a76d80a", "canonical_url": "https://news.mongabay.com/2024/10/in-mexico-totonac-spiritual-guides-work-with-scientists-to-revive-ecosystems", "publisher_url": "https://news.mongabay.com/2024/10/in-mexico-totonac-spiritual-guides-work-with-scientists-to-revive-ecosystems", "title_original": "In Mexico, Totonac spiritual guides work with scientists to revive ecosystems", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-07T19:34:33+00:00", "source_text": "PAPANTLA, Veracruz, México — Juan Gerónimo Simbrón, a traditional healer, walks through the tropical forest surrounding his house until he reaches a 100-year-old fig tree. Among the roots, he sets up a carpet of palm leaves with tobacco fragments as an offering. Here, he begins a prayer. His appeal is to Kiwíkgolo and Kiwichat (deities […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "8ee4064e4bf7f52c06ede0e4aa88f564b94c348b31d3648bbc8732b38679d748", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:16.469763+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:16.482379+00:00", "published_at_raw": "2024-10-07T19:34:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 3, "end": 9, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_24e22df4a0d43945c47e", "record_id": "article_24e22df4a0d43945", "canonical_url": "https://yaleclimateconnections.org/2024/10/los-posibles-escenarios-para-la-bahia-de-tampa-cuando-el-huracan-milton-toque-tierra", "publisher_url": "https://yaleclimateconnections.org/2024/10/los-posibles-escenarios-para-la-bahia-de-tampa-cuando-el-huracan-milton-toque-tierra", "title_original": "Los posibles escenarios para la Bahía de Tampa cuando el Huracán Milton toque tierra", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-07T15:48:40+00:00", "source_text": "El área metropolitana más vulnerable de los EE. UU. a los daños por marejada ciclónica es Tampa/San Petersburgo. Esto según un informe de 2015 de Karen Clark & Company, Most Vulnerable US Cities to Storm Surge Flooding . Su tormenta de 1 en 100 años (con un 1% de probabilidad de ocurrir en cualquier año) era un huracán de categoría 4 con vientos de 150 mph (240 km/h). Se espera que una tormenta de este tipo que golpee justo al norte de la Bahía de Tampa cause $230 mil millones en daños (USD de 2024), solo por la marejada ciclónica.", "text_kind": "article_excerpt", "text_characters": 537, "text_sha256": "daa45ea78c6def3733dcbd76fa8d065d701fd1ab631e213837c378bfd40429d2", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:05.786438+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "1%", "start": 258, "end": 260, "evidence": " Su tormenta de 1 en 100 años (con un 1% de probabilidad de ocurrir en cualquier año) era un huracán de categoría 4 con vientos de 150 mph (240 km/h).", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 210, "end": 215, "evidence": "gún un informe de 2015 de Karen Clark & Company, Most Vulnerable US Cities to Storm Surge Flooding . Su tormenta de 1 en 100 años (con un 1% de probabilidad de ocurrir en cualquier año) era un huracán de categoría 4 con vientos de 150 "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:05.822938+00:00", "published_at_raw": "2024-10-07T15:48:40", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 185, "end": 187, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_a929e6c743f37c71d129", "record_id": "article_a929e6c743f37c71", "canonical_url": "https://www.carbonbrief.org/guest-post-heat-stress-thresholds-are-not-designed-for-vulnerable-groups", "publisher_url": "https://www.carbonbrief.org/guest-post-heat-stress-thresholds-are-not-designed-for-vulnerable-groups", "title_original": "Guest post: Heat stress thresholds are not designed for vulnerable groups", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-07T15:39:12+00:00", "source_text": "As global temperatures rise, vast swathes of the global population are experiencing heat extremes that they have never faced before . In some parts of the world, exposure to extreme heat is breaching survival limits for even the healthiest people. Heat-related deaths have increased rapidly in recent decades. But the risks of extreme heat are even more acute for certain groups of people. Those most vulnerable include newborns, infants and children, those with preexisting medical conditions, including certain disabilities, the over 65s and workers who work outside or in a high heat indoor setting. Despite these risks, our new research – published in the International Journal of Biometeorology – shows that vulnerable groups are being overlooked in studies of heat stress.", "text_kind": "article_excerpt", "text_characters": 778, "text_sha256": "c1129e0995924e6f7748ac59d873423a8d71f2a0c56166f204f9f383e48d2682", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:43.120023+00:00", "extractor_version": "1.0.0", "document_type": "commentary_or_analysis", "document_type_basis": "explicit_title_prefix", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 10, "end": 21, "evidence": "As global temperatures rise, vast swathes of the global population are experiencing heat extremes that they have never faced before . In some parts of the world,"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:43.153806+00:00", "published_at_raw": "2024-10-07T15:39:12", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_816ffc5c863da2088b33", "record_id": "article_816ffc5c863da208", "canonical_url": "https://news.mongabay.com/2024/10/indigenous-women-in-the-amazon-must-be-empowered-interview-with-nemonte-nenquimo", "publisher_url": "https://news.mongabay.com/2024/10/indigenous-women-in-the-amazon-must-be-empowered-interview-with-nemonte-nenquimo", "title_original": "‘Indigenous women in the Amazon must be empowered’: Interview with Nemonte Nenquimo", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-07T14:18:31+00:00", "source_text": "At just six years old, Nemonte Nenquimo understood that there were two worlds. The first one was where her oko (a big house where she lived in the rainforest) existed. This world was lit by fire, and was where her family called her by her name, Nemonte, meaning “many stars.” The other world was where […]", "text_kind": "source_excerpt", "text_characters": 305, "text_sha256": "f06ab622c2950c9ba49287dc299b84d2f6f8b160fe70ff03e12754fa42e40d41", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:16.576670+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:16.604763+00:00", "published_at_raw": "2024-10-07T14:18:31", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_5a5a95bb793a11eae8b2", "record_id": "article_5a5a95bb793a11ea", "canonical_url": "https://news.mongabay.com/2024/10/a-nesting-haven-for-sea-turtles-in-suriname-is-fading-away", "publisher_url": "https://news.mongabay.com/2024/10/a-nesting-haven-for-sea-turtles-in-suriname-is-fading-away", "title_original": "A nesting haven for sea turtles in Suriname is fading away", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-07T11:21:23+00:00", "source_text": "BRAAMSPUNT BEACH, Suriname — As little as five years ago, parts of the beach here were 500 meters or wider, more than a quarter of a mile, says Kiran Balrampersad. “Now,” he says, “there are only 10-12 meters [33-39 feet] left.” For more than a decade, Balrampersad has guided sea turtle tours on Braamspunt Beach, […]", "text_kind": "source_excerpt", "text_characters": 318, "text_sha256": "a22b9a10e0d57bd9eb4c7d19ab2faacec8e79923529ecdb62fa87be1c475c1c5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:16.663806+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "SR", "alpha3": "SUR", "name_zh": "苏里南", "name_en": "Suriname"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "SR", "alpha3": "SUR", "name_zh": "苏里南", "name_en": "Suriname"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:16.693384+00:00", "published_at_raw": "2024-10-07T11:21:23", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "SR", "alpha3": "SUR", "name_zh": "苏里南", "name_en": "Suriname", "start": 35, "end": 43, "matched_text": "Suriname", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "SR", "alpha3": "SUR", "name_zh": "苏里南", "name_en": "Suriname", "start": 18, "end": 26, "matched_text": "Suriname", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_7b508cfc89784029b985", "record_id": "article_7b508cfc89784029", "canonical_url": "https://news.mongabay.com/2024/10/26-elephants-from-namibia-moved-to-angolas-only-private-conservation-area", "publisher_url": "https://news.mongabay.com/2024/10/26-elephants-from-namibia-moved-to-angolas-only-private-conservation-area", "title_original": "26 elephants from Namibia moved to Angola’s only private conservation area", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-07T09:10:08+00:00", "source_text": "Cuatir Conservation Area, ANGOLA — On Sept. 2, a team from Namibia’s Okonjati Game Reserve completed the last of four arduous translocations, taking a total of 26 elephants across the border to Cuatir Conservation Area in Angola. The 200-square-kilometer (77-square-mile) Cuatir Conservation Area, set up by Namibian-born conservationist Stefan van Wyk, is possibly the only […]", "text_kind": "source_excerpt", "text_characters": 378, "text_sha256": "c3e687061580e3df5cd8f0230c15dbacc1da1febee3143764a230942e80ee9dd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:16.699116+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NA", "alpha3": "NAM", "name_zh": "纳米比亚", "name_en": "Namibia"}, {"alpha2": "AO", "alpha3": "AGO", "name_zh": "安哥拉", "name_en": "Angola"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NA", "alpha3": "NAM", "name_zh": "纳米比亚", "name_en": "Namibia"}, {"alpha2": "AO", "alpha3": "AGO", "name_zh": "安哥拉", "name_en": "Angola"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:16.727258+00:00", "published_at_raw": "2024-10-07T09:10:08", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NA", "alpha3": "NAM", "name_zh": "纳米比亚", "name_en": "Namibia", "start": 18, "end": 25, "matched_text": "Namibia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "AO", "alpha3": "AGO", "name_zh": "安哥拉", "name_en": "Angola", "start": 35, "end": 41, "matched_text": "Angola", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "AO", "alpha3": "AGO", "name_zh": "安哥拉", "name_en": "Angola", "start": 26, "end": 32, "matched_text": "ANGOLA", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "NA", "alpha3": "NAM", "name_zh": "纳米比亚", "name_en": "Namibia", "start": 59, "end": 66, "matched_text": "Namibia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_5de52e4be058a3016002", "record_id": "article_5de52e4be058a301", "canonical_url": "https://yaleclimateconnections.org/2024/10/best-and-worst-case-hurricane-scenarios-for-tampa-bay", "publisher_url": "https://yaleclimateconnections.org/2024/10/best-and-worst-case-hurricane-scenarios-for-tampa-bay", "title_original": "Best- and worst-case hurricane scenarios for Tampa Bay", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-07T01:24:28+00:00", "source_text": "[Haz clic aquí para leerlo en español] The most vulnerable metropolitan area in the U.S. to storm surge damage is Tampa/St. Petersburg. That’s according to a 2015 report by Karen Clark & Company, Most Vulnerable US Cities to Storm Surge Flooding . Their 1-in-100-year storm (with a 1% chance of occurring in any given year) was a strong Category 4 hurricane with 150 mph (240 km/h) winds. Such a storm striking just north of Tampa Bay could be expected to cause $230 billion in damage (2024 USD) – just from the storm surge. Tampa Bay doesn’t get hit very often by hurricanes, because the city faces the ocean to the west, and the prevailing east-to-west trade winds at that latitude make it uncommon for a storm to make a direct hit on the west coast of Florida from the ocean.", "text_kind": "article_excerpt", "text_characters": 778, "text_sha256": "c335e9059473483e79c90f4f22695e1853c3ab894a1a9f6c27bd5ec1d6451604", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:05.967384+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "1%", "start": 282, "end": 284, "evidence": " Their 1-in-100-year storm (with a 1% chance of occurring in any given year) was a strong Category 4 hurricane with 150 mph (240 km/h) winds.", "interpretation": "not_classified"}, {"value_text": "$230 billion", "start": 462, "end": 474, "evidence": " Such a storm striking just north of Tampa Bay could be expected to cause $230 billion in damage (2024 USD) – just from the storm surge.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 237, "end": 242, "evidence": "rding to a 2015 report by Karen Clark & Company, Most Vulnerable US Cities to Storm Surge Flooding . Their 1-in-100-year storm (with a 1% chance of occurring in any given year) was a strong Category 4 hurricane with 150 mph (240 km/h) "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:06.012585+00:00", "published_at_raw": "2024-10-07T01:24:28", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 84, "end": 88, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_352feee6901cbd8e9d0f", "record_id": "article_352feee6901cbd8e", "canonical_url": "https://www.carbonbrief.org/antarctic-sea-ice-maximum-in-2024-is-second-lowest-on-record", "publisher_url": "https://www.carbonbrief.org/antarctic-sea-ice-maximum-in-2024-is-second-lowest-on-record", "title_original": "Antarctic sea ice maximum in 2024 is ‘second lowest’ on record", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-04T12:50:00+00:00", "source_text": "Antarctic sea ice has reached its maximum extent for the year, clocking in at the second lowest in a record stretching back to 1979, according to provisional data from the US National Snow and Ice Data Centre (NSIDC). Over the past two years, Antarctic sea ice has been “way outside anything we have witnessed in our satellite record for their winter months”, an expert tells Carbon Brief. Meanwhile, at the Earth’s other pole, the Arctic reached its summer minimum extent on 11 September, ranking as the seventh lowest on record, according to the NSIDC . The organisation notes that “the last 18 years are the lowest 18 Arctic sea ice extents in the satellite record”.", "text_kind": "article_excerpt", "text_characters": 669, "text_sha256": "33e8e5c14e3dc1d09cb872ecd15c1ccefb1ea94caf5c16b4b8cf4ce88105ab5a", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:43.237860+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:43.318432+00:00", "published_at_raw": "2024-10-04T12:50:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 172, "end": 174, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_dc707ef257025afe0672", "record_id": "article_dc707ef257025afe", "canonical_url": "https://news.mongabay.com/2024/10/in-madagascar-taniala-regenerative-camp-aims-to-heal-deforestation-scars", "publisher_url": "https://news.mongabay.com/2024/10/in-madagascar-taniala-regenerative-camp-aims-to-heal-deforestation-scars", "title_original": "In Madagascar, Taniala Regenerative Camp aims to heal deforestation scars", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-03T16:57:57+00:00", "source_text": "The Menabe Antimena Protected Area in midwestern Madagascar is badly scarred by deforestation; farmers from the surrounding communities have encroached on this unique dry forest ecosystem in search of new and fertile land to grow crops like maize and peanuts. But amid the damage, in the village of Lambokely, is a carefully tended exception. Roland […]", "text_kind": "source_excerpt", "text_characters": 353, "text_sha256": "6700a88fcabdfda764b073616bbb4407e3ac6d75c8ce961a6f758d8f0230970c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:16.817151+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MG", "alpha3": "MDG", "name_zh": "马达加斯加", "name_en": "Madagascar"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MG", "alpha3": "MDG", "name_zh": "马达加斯加", "name_en": "Madagascar"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:16.846595+00:00", "published_at_raw": "2024-10-03T16:57:57", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MG", "alpha3": "MDG", "name_zh": "马达加斯加", "name_en": "Madagascar", "start": 3, "end": 13, "matched_text": "Madagascar", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "MG", "alpha3": "MDG", "name_zh": "马达加斯加", "name_en": "Madagascar", "start": 49, "end": 59, "matched_text": "Madagascar", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_de34522c62fc549748ad", "record_id": "article_de34522c62fc5497", "canonical_url": "https://news.mongabay.com/2024/10/in-ecuador-booming-profits-in-small-scale-gold-mining-reveal-a-tainted-industry-investigation", "publisher_url": "https://news.mongabay.com/2024/10/in-ecuador-booming-profits-in-small-scale-gold-mining-reveal-a-tainted-industry-investigation", "title_original": "In Ecuador, booming profits in small-scale gold mining reveal a tainted industry – investigation", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-03T12:00:38+00:00", "source_text": "About a quarter of Ecuador’s gold exports from small-scale mining in 2023 originated from just three companies: Rockgolden, Rocadorada and Soul Metals. Their exports of $268 million in gold just to the United Arab Emirates and India was about 20 times more than the same trade the year before. A months-long investigation of their activities […]", "text_kind": "source_excerpt", "text_characters": 345, "text_sha256": "bea60807664517b5a6748268b49b6d6fb1a843d7025fc92e9883fe005ec6dc63", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:21.581429+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$268 million", "start": 169, "end": 181, "evidence": " Their exports of $268 million in gold just to the United Arab Emirates and India was about 20 times more than the same trade the year before.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}, {"alpha2": "AE", "alpha3": "ARE", "name_zh": "阿拉伯联合酋长国", "name_en": "United Arab Emirates"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}, {"alpha2": "AE", "alpha3": "ARE", "name_zh": "阿拉伯联合酋长国", "name_en": "United Arab Emirates"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:21.596780+00:00", "published_at_raw": "2024-10-03T12:00:38", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador", "start": 3, "end": 10, "matched_text": "Ecuador", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador", "start": 19, "end": 26, "matched_text": "Ecuador", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "AE", "alpha3": "ARE", "name_zh": "阿拉伯联合酋长国", "name_en": "United Arab Emirates", "start": 202, "end": 222, "matched_text": "United Arab Emirates", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 227, "end": 232, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-1