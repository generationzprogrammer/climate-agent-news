{"text_id": "text_c806dea85b3d114318b1", "record_id": "article_c806dea85b3d1143", "canonical_url": "https://news.mongabay.com/2026/02/indigenous-ikoots-community-prepares-to-relocate-as-the-pacific-floods-their-town", "publisher_url": "https://news.mongabay.com/2026/02/indigenous-ikoots-community-prepares-to-relocate-as-the-pacific-floods-their-town", "title_original": "Indigenous Ikoots community prepares to relocate as the Pacific floods their town", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-25T13:47:55+00:00", "source_text": "CUAUHTÉMOC, Mexico — On a wind-battered beach in San Mateo del Mar, Mexico, four figures haul a net into shore. Frigatebirds (Fregata magnificens) mark the fishers’ position in a high, twisting column that follows their progress from the water onto the beach. One of the men tosses a small fish onto the sand. It barely […]", "text_kind": "source_excerpt", "text_characters": 323, "text_sha256": "0938e0ddbe4ed594df2b71e4e08207ffad295978d991a79dd8d4db1267ec4233", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:00.165339+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:00.231878+00:00", "published_at_raw": "2026-02-25T13:47:55", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 12, "end": 18, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_23b4101dee090c2f589e", "record_id": "article_23b4101dee090c2f", "canonical_url": "https://yaleclimateconnections.org/2026/02/deconstruction-academy-teaches-people-how-to-reduce-construction-waste", "publisher_url": "https://yaleclimateconnections.org/2026/02/deconstruction-academy-teaches-people-how-to-reduce-construction-waste", "title_original": "‘Deconstruction Academy’ teaches people how to reduce construction waste", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-24T12:00:00+00:00", "source_text": "Transcript: When a building is torn down, much of the rubble ends up in a landfill. But many commonly discarded building materials – like doors, sinks, windows, floors, cabinets, and wood – could be reused instead . Rhines: “They’re not thrown away because they’re unusable. They’re thrown away because demolition is faster.” Petrina Rhines is executive director of the Birch Group , a Minnesota-based company that carefully takes apart old buildings to reuse the materials. She says the approach can reduce supply costs. Rhines: “We try to reclaim almost 85% of the home, of the building materials from any project that we take on … at minimum 75%.” And they teach contractors, students, and others how to do the same.", "text_kind": "article_excerpt", "text_characters": 719, "text_sha256": "619938238c96440f5fbc6685830edf7b8924670ea841add703c06851f9deed8d", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:26.368704+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "85%", "start": 556, "end": 559, "evidence": " Rhines: “We try to reclaim almost 85% of the home, of the building materials from any project that we take on … at minimum 75%.", "interpretation": "not_classified"}, {"value_text": "75%", "start": 645, "end": 648, "evidence": " Rhines: “We try to reclaim almost 85% of the home, of the building materials from any project that we take on … at minimum 75%.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:26.417031+00:00", "published_at_raw": "2026-02-24T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
