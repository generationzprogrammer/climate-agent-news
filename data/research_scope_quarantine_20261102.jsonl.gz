{"text_id": "text_2cf87f30ff8bc3786929", "record_id": "article_2cf87f30ff8bc378", "canonical_url": "https://insideclimatenews.org/news/16022024/warm-winter-threatens-recreation-revenue-in-the-upper-midwest", "publisher_url": "https://insideclimatenews.org/news/16022024/warm-winter-threatens-recreation-revenue-in-the-upper-midwest", "title_original": "Warm Winter Threatens Recreation Revenue in the Upper Midwest", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-16T10:00:00+00:00", "source_text": "A record-warm winter is drying up revenue in the Midwest. In Minnesota, organizers closed a lucrative winter arts festival early, forfeiting tens of millions of dollars in expected profit. In Wisconsin, rural towns that are typically inundated with snowmobilers and ice fishers this time of year are asking the state for help after losing an […]", "text_kind": "source_excerpt", "text_characters": 345, "text_sha256": "ff753c42549e6ac0e9e8d64c76f164dcab75213ab6afe3b97a78aa75103f6ce8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:32.232534+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:32.251192+00:00", "published_at_raw": "2024-02-16T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_2e1e280e3b6e5a03a98e", "record_id": "article_2e1e280e3b6e5a03", "canonical_url": "https://news.mongabay.com/2024/02/in-brazils-soy-belt-community-seed-banks-offer-hope-for-the-amazon", "publisher_url": "https://news.mongabay.com/2024/02/in-brazils-soy-belt-community-seed-banks-offer-hope-for-the-amazon", "title_original": "In Brazil’s soy belt, community seed banks offer hope for the Amazon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-15T23:01:47+00:00", "source_text": "COLÍDER, Brazil — Not too long ago, the plot of land that Maria Ivonete de Souza inherited was barren, the soil hardened by years of cattle ranching. When the family had arrived to the Amazon from southern Brazil four decades earlier, her father had swiftly cleared the dense rainforest to make way for pasture. “He […]", "text_kind": "source_excerpt", "text_characters": 319, "text_sha256": "aa616222001c587db168347482b69d5b4b8501386750d31da7e8998b918ffca4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:13.466981+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:13.478910+00:00", "published_at_raw": "2024-02-15T23:01:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 3, "end": 9, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 9, "end": 15, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_f7fb304d17c6f1c9fe28", "record_id": "article_f7fb304d17c6f1c9", "canonical_url": "https://news.mongabay.com/2024/02/a-highway-project-in-chile-threatens-one-of-the-worlds-longest-living-tree-species", "publisher_url": "https://news.mongabay.com/2024/02/a-highway-project-in-chile-threatens-one-of-the-worlds-longest-living-tree-species", "title_original": "A highway project in Chile threatens one of the world’s longest-living tree species", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-15T09:18:35+00:00", "source_text": "When Chilean President Gabriel Boric instructed the Ministry of Public Works (MOP) to complete the final section of a highway connecting the southern cities of La Unión and Corral in June 2023, the scientific community made their concerns known internationally. “Chile’s road plans threaten ancient forests” was the headline of a letter published in the […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "cf73fe0e146acd7f9d1309b4450a4bbd868c4e6e98f2bc6a21a15595110fdb03", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:13.493626+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en