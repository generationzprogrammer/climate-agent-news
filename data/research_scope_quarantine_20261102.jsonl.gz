{"text_id": "text_78e4dc59104c53211284", "record_id": "article_78e4dc59104c5321", "canonical_url": "https://news.mongabay.com/2026/08/in-spain-south-africa-communities-use-restoration-to-grow-fire-insurance-commentary", "publisher_url": "https://news.mongabay.com/2026/08/in-spain-south-africa-communities-use-restoration-to-grow-fire-insurance-commentary", "title_original": "In Spain & South Africa, communities use restoration to ‘grow’ fire insurance (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-24T19:24:29+00:00", "source_text": "Huddled shoulder to shoulder, a flicker of glowing orange illuminates the faces gathered around. The world quiets. The dark presses in from every side, and the cold with it. At the center of it all, a fire is roaring. Fire warmed us, fed us, and kept the dark at bay long after the sun went […]", "text_kind": "source_excerpt", "text_characters": 294, "text_sha256": "06dcd46f918817e578407fe4e70f4726f3a9bf30e70fe80e493eaab1775fb1a5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:11.174029+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa"}, {"alpha2": "ES", "alpha3": "ESP", "name_zh": "西班牙", "name_en": "Spain"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:11.233156+00:00", "published_at_raw": "2026-08-24T19:24:29", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ES", "alpha3": "ESP", "name_zh": "西班牙", "name_en": "Spain", "start": 3, "end": 8, "matched_text": "Spain", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa", "start": 11, "end": 23, "matched_text": "South Africa", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_b840a54589d57963ec0f", "record_id": "article_b840a54589d57963", "canonical_url": "https://dialogue.earth/en/energy/green-hydrogen-made-in-mena-built-with-china-sold-to-europe", "publisher_url": "https://dialogue.earth/en/energy/green-hydrogen-made-in-mena-built-with-china-sold-to-europe", "title_original": "Green hydrogen: Made in MENA, built with China, sold to Europe?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-24T17:46:16+00:00", "source_text": "The region has emerged as a hub for hydrogen investments, with construction and tech from China, and eyes on EU markets. But securing buyers remains a challenge", "text_kind": "source_excerpt", "text_characters": 160, "text_sha256": "2cf6e9ee3d7f34cc4dc5a60edb2324ddaadbb565a4d9247549fa97b304e7c7cf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:27.419986+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 36, "end": 44, "evidence": "The region has emerged as a hub for hydrogen investments, with construction and tech from China, and eyes on EU markets. But securing buyers remains a challenge"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:27.428899+00:00", "published_at_raw": "2026-08-24T17:46:16", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 41, "end": 46, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 90, "end": 95, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_a4ff7c0dc7f1746f356b", "record_id": "article_a4ff7c0dc7f1746f", "canonical_url": "https://yaleclimateconnections.org/2026/08/two-atlantic-tropical-disturbances-to-watch-tropical-storm-moke-brings-rain-to-hawaii", "publisher_url": "https://yaleclimateconnections.org/2026/08/two-atlantic-tropical-disturbances-to-watch-tropical-storm-moke-brings-rain-to-hawaii", "title_original": "Two Atlantic tropical disturbances to watch; Tropical Storm Moke brings rain to Hawaii", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-24T14:55:21+00:00", "source_text": "[Lee en español aquí] Update (4:30 p.m. EDT Wednesday): The first disturbance shown and discussed below, Invest 95L, is no longer expected to develop, as of the Tropical Weather Outlook from NHC issued at 2 p.m. EDT Wednesday . The more southerly disturbance below – now named Invest 96L – could still become a tropical depression or tropical storm over the next couple of days as it approaches the Leeward Islands and perhaps the Bahamas. The GFS (American) model and its ensemble runs continue to be much more bullish than the European model and its ensemble runs – or the Google WeatherNext 2 ensemble runs – on the future of 96L. In its Wednesday afternoon outlook, NHC assigned this system a 60% chance of development over the next two days.", "text_kind": "article_excerpt", "text_characters": 746, "text_sha256": "80110629d81c7c4395202511a322625519cb3b550ed4810a61c26f62bfe0af5a", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:37.243071+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "60%", "start": 697, "end": 700, "evidence": " In its Wednesday afternoon outlook, NHC assigned this system a 60% chance of development over the next two days.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BS", "alpha3": "BHS", "name_zh": "巴哈马", "name_en": "Bahamas"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BS", "alpha3": "BHS", "name_zh": "巴哈马", "name_en": "Bahamas"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:37.264217+00:00", "published_at_raw": "2026-08-24T14:55:21", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BS", "alpha3": "BHS", "name_zh": "巴哈马", "name_en": "Bahamas", "start": 431, "end": 438, "matched_text": "Bahamas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_341c3e35622879d999b2", "record_id": "article_341c3e35622879d9", "canonical_url": "https://insideclimatenews.org/news/23082026/new-england-wildland-firefighters-impacted-by-federal-proposals", "publisher_url": "https://insideclimatenews.org/news/23082026/new-england-wildland-firefighters-impacted-by-federal-proposals", "title_original": "Burning Questions Confront Wildland Firefighters in Maine and Across New England", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-23T09:00:00+00:00", "source_text": "Wildfires in New England rarely make national news. The spotlight is more often on the catastrophic fires of Western states, but the Northeast’s fire season has been quietly heating up. In 2025, severe drought quadrupled Maine’s late-summer fire activity. In 2024, another drought quintupled Connecticut’s fall wildfires, and one firefighter died while controlling a blaze. […]", "text_kind": "source_excerpt", "text_characters": 377, "text_sha256": "6bda7a3e1ded7a4bc72f8156c456c127ef2ba2de397965ebefc055c303344850", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:21.054471+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 0, "end": 8, "evidence": "Wildfires in New England rarely make national news. The spotlight is more often on the catastrophic fires of Western states, but the Northeast’s fir"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:21.069039+00:00", "published_at_raw": "2026-08-23T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 73, "end": 80, "matched_text": "England", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 17, "end": 24, "matched_text": "England", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_cb8544ce9cfc8487292e", "record_id": "article_cb8544ce9cfc8487", "canonical_url": "https://insideclimatenews.org/news/19082026/montana-wildfire-conditions-rapidly-change", "publisher_url": "https://insideclimatenews.org/news/19082026/montana-wildfire-conditions-rapidly-change", "title_original": "Recent Rain Slowed Southwestern Montana Wildfires. Now the Heat Is Returning.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-19T22:32:33+00:00", "source_text": "Firefighters are gaining ground on three large wildfires that have burned more than 47,000 acres across southwestern Montana, but unhelpful warmer temperatures, lower humidity and breezy conditions are returning after recent rainfall slowed the fires’ growth. According to the U.S. Forest Service, containment on the Sand Creek Fire, southeast of Wisdom, increased from 2 percent […]", "text_kind": "source_excerpt", "text_characters": 383, "text_sha256": "a46185bc167cd6dd3e0ff3a5ae4f13ce04830cfa3aa2d4f570f02cfd2d009ee1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:21.636485+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "2 percent", "start": 370, "end": 379, "evidence": " Forest Service, containment on the Sand Creek Fire, southeast of Wisdom, increased from 2 percent […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 47, "end": 55, "evidence": "Firefighters are gaining ground on three large wildfires that have burned more than 47,000 acres across southwestern Montana, but unhelpful warmer temperatures, lower humidity and breezy conditio"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:21.680226+00:00", "published_at_raw": "2026-08-19T22:32:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 277, "end": 281, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_8bc9f82cdfcba4a74845", "record_id": "article_8bc9f82cdfcba4a7", "canonical_url": "https://news.mongabay.com/2026/08/egypts-deserts-show-why-ecological-knowledge-matters-in-conservation-commentary", "publisher_url": "https://news.mongabay.com/2026/08/egypts-deserts-show-why-ecological-knowledge-matters-in-conservation-commentary", "title_original": "Egypt’s deserts show why ecological knowledge matters in conservation (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-19T15:13:56+00:00", "source_text": "Egypt’s deserts are often introduced to the world as empty: Wide horizons, silence, heat, sand and stone. In tourism brochures they become dramatic scenery. In archaeological writing they can appear as corridors around monuments. In some conservation documents they are fragile spaces that need technical management from outside. But these descriptions miss something essential. Deserts […]", "text_kind": "source_excerpt", "text_characters": 390, "text_sha256": "9471c2716cc814038ad6f608018eb3e55f707269e4eb74c98fce057ff5d6b2ac", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:12.391300+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "EG", "alpha3": "EGY", "name_zh": "埃及", "name_en": "Egypt"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "EG", "alpha3": "EGY", "name_zh": "埃及", "name_en": "Egypt"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:12.439175+00:00", "published_at_raw": "2026-08-19T15:13:56", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "EG", "alpha3": "EGY", "name_zh": "埃及", "name_en": "Egypt", "start": 0, "end": 5, "matched_text": "Egypt", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "EG", "alpha3": "EGY", "name_zh": "埃及", "name_en": "Egypt", "start": 0, "end": 5, "matched_text": "Egypt", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_00038933c8230eb2bc9b", "record_id": "article_00038933c8230eb2", "canonical_url": "https://news.mongabay.com/2026/08/tapirs-bats-and-nests-how-plastic-infiltrates-amazonian-wildlife", "publisher_url": "https://news.mongabay.com/2026/08/tapirs-bats-and-nests-how-plastic-infiltrates-amazonian-wildlife", "title_original": "Tapirs, bats and nests: How plastic infiltrates Amazonian wildlife", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-18T21:12:13+00:00", "source_text": "This is the third and final article in a special series on microplastics in the Amazon. Read the first story here and the second story here . MANAUS, Brazil — Traveling by boat up the Negro River from Amazonas state capital Manaus, it takes eight to nine hours to cover the 100 kilometers (62 miles) to Anavilhanas National Park. This protected area preserves one of the world’s largest freshwater archipelagos, comprising more than 400 islands and 60 lakes. They include Prato Lake, which is about 3.5 kilometers (about 2 miles) long and 1.5 kilometers (nearly 1 mile) wide. Yet, even here, in a protected area far from urban pressures, microplastics were found in the digestive tracts of fish.", "text_kind": "article_excerpt", "text_characters": 695, "text_sha256": "1d12c36a3526610c62087699aff264b34613af92838334477d514a987ab3f23e", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:17.573904+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:17.592272+00:00", "published_at_raw": "2026-08-18T21:12:13", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 150, "end": 156, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_7e8c7bf9762d33c0b593", "record_id": "article_7e8c7bf9762d33c0", "canonical_url": "https://news.mongabay.com/2026/08/indonesia-leads-global-tally-of-abuses-linked-to-chinese-transition-mineral-investments", "publisher_url": "https://news.mongabay.com/2026/08/indonesia-leads-global-tally-of-abuses-linked-to-chinese-transition-mineral-investments", "title_original": "Indonesia leads global tally of abuses linked to Chinese transition-mineral investments", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-18T10:59:25+00:00", "source_text": "JAKARTA — Indonesia recorded more allegations of human rights and environmental abuses linked to Chinese investments in transition minerals than any other country between 2023 and 2025, a new report says. It identifies the vast majority of problems with the country’s rapidly expanding nickel industry. The report by the Business & Human Rights Resource Centre […]", "text_kind": "source_excerpt", "text_characters": 364, "text_sha256": "9ce9ae8bad9b311b2730ec4b7efff7ea96cba04aa9487f860a93038091e83994", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:17.674822+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:17.689698+00:00", "published_at_raw": "2026-08-18T10:59:25", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 0, "end": 9, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 49, "end": 56, "matched_text": "Chinese", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 10, "end": 19, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 97, "end": 104, "matched_text": "Chinese", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_38b28efdd1d998076145", "record_id": "article_38b28efdd1d99807", "canonical_url": "https://yaleclimateconnections.org/2026/08/hawaii-reeling-after-lalas-powerful-sideswipe", "publisher_url": "https://yaleclimateconnections.org/2026/08/hawaii-reeling-after-lalas-powerful-sideswipe", "title_original": "Hawaii reeling after Lala’s powerful sideswipe", "title_zh": "夏威夷在拉拉强力擦肩而过后陷入混乱", "title_en": null, "summary_zh": "飓风“拉拉”在过周末时从夏威夷南部掠过，带来强降雨和狂风，虽未正式登陆但影响了全岛。周一下午，全州仍有超过 11万名用户断电，各地普遍发生山洪暴发，学校、法院及州县办公室均关闭。", "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-17T17:46:32+00:00", "source_text": "Hurricane Lala delivered a double-barreled punch of torrential rain and high wind as it passed just south of Hawaii over the weekend. Lala’s track put the islands on the storm’s sprawling north side, where screaming easterly winds pushed upslope against Hawaii’s rugged terrain, dumping immense amounts of rain. Flash flooding has been widespread, and the rains and winds led to major power outages. Lala reached hurricane strength just before its closest pass to South Point on the Island of Hawaii (aka the “Big Island”). Even though the storm’s northeastern eyewall briefly pushed ashore, Lala didn’t make an official landfall, because the center of the cloud-filled eye remained off the coast; it was about 30 miles southwest of South Point at its nearest approach around 6 p.m.", "text_kind": "article_excerpt", "text_characters": 782, "text_sha256": "db93d652ed67d938ee48f96891726a204938a3756135be7e4064251270701e6c", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:37.607135+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 318, "end": 323, "evidence": "ds pushed upslope against Hawaii’s rugged terrain, dumping immense amounts of rain. Flash flooding has been widespread, and the rains and winds led to major power outages. Lala reached hurricane strength just before its closest pass to"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:37.632386+00:00", "published_at_raw": "2026-08-17T17:46:32", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_7c9197e07c75e1cdd0eb", "record_id": "article_7c9197e07c75e1cd", "canonical_url": "https://insideclimatenews.org/news/16082026/project-aims-to-help-guatemalans-plagued-by-plastic-pollution", "publisher_url": "https://insideclimatenews.org/news/16082026/project-aims-to-help-guatemalans-plagued-by-plastic-pollution", "title_original": "Empowering Guatemalan Villagers Plagued by Plastic", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-16T09:00:00+00:00", "source_text": "Lea este artículo en español. This story was supported by the Pulitzer Center. JALAPA, Guatemala—On a hot, muggy afternoon in the small mountain village of El Duraznal, Soila Elizabeth Cruz carefully reached under the slats of a barbed wire fence to retrieve plastic litter stuck in the dirt as trucks whizzed by. The community comes […]", "text_kind": "source_excerpt", "text_characters": 337, "text_sha256": "f3f097d37e541453c0426eb8d45583bc9bf53561f8fb7433beccca9d1e10e383", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:22.372059+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GT", "alpha3": "GTM", "name_zh": "危地马拉", "name_en": "Guatemala"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GT", "alpha3": "GTM", "name_zh": "危地马拉", "name_en": "Guatemala"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:22.400900+00:00", "published_at_raw": "2026-08-16T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GT", "alpha3": "GTM", "name_zh": "危地马拉", "name_en": "Guatemala", "start": 87, "end": 96, "matched_text": "Guatemala", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_e5965ccbe4cc198ad15a", "record_id": "article_e5965ccbe4cc198a", "canonical_url": "https://dialogue.earth/en/pollution/in-brazils-steel-city-pollution-and-uncertainty-swirl-in-the-air", "publisher_url": "https://dialogue.earth/en/pollution/in-brazils-steel-city-pollution-and-uncertainty-swirl-in-the-air", "title_original": "In Brazil’s Steel City, pollution and uncertainty swirl in the air", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-14T17:28:45+00:00", "source_text": "The city of Volta Redonda, located in the south of Rio de Janeiro state, differs from other nearby municipalities for the colour of its sky. In a region more famous for its sunny blues, the grey skies here in Brazil’s “Steel City” are a brand of their own. In the 1940s, Brazil’s National Steel Company (CSN) established itself in Volta Redonda, in a key step for the country’s industrialisation. Today, the company’s vast iron and steel complex is home to two coal-powered blast furnaces that can produce nearly 6 million tonnes of steel a year. This complex has positioned CSN as one of the largest steelmakers in Latin America. However, this growth has often come at an environmental cost, namely in the “black dust” emitted by its operations.", "text_kind": "article_excerpt", "text_characters": 746, "text_sha256": "e1761ce3c97c2faddd1625234adc8d68b284376ee6bd627b36257c9ef78626bf", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:27.701468+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "6 million", "start": 513, "end": 522, "evidence": " Today, the company’s vast iron and steel complex is home to two coal-powered blast furnaces that can produce nearly 6 million tonnes of steel a year.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 219, "end": 224, "evidence": "of its sky. In a region more famous for its sunny blues, the grey skies here in Brazil’s “Steel City” are a brand of their own. In the 1940s, Brazil’s National Steel Company (CSN) established itself in Volta Redonda, in a key step for "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:27.724300+00:00", "published_at_raw": "2026-08-14T17:28:45", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 3, "end": 9, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 209, "end": 215, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_bef1f6204f86ad224853", "record_id": "article_bef1f6204f86ad22", "canonical_url": "https://insideclimatenews.org/news/14082026/data-center-pr-blitz-backfiring", "publisher_url": "https://insideclimatenews.org/news/14082026/data-center-pr-blitz-backfiring", "title_original": "The Data Center Industry’s PR Blitz Is Backfiring", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-14T09:00:00+00:00", "source_text": "HENDERSON, N.C.—On a recent summer evening Mitzi Parrott, who lives in Vance County, saw a television commercial on the evening news that gave her pause. Kathie Hamm and Bobbie Lequire, also of Vance County, saw it, too, streaming on Sling and posted on Nextdoor. The ad extolled the purported economic benefits of data centers, including […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "d1320b9717c42846c84469734f34f4e140c3f0b47e4c85043382cb27cbf6fd34", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:22.920243+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:22.933310+00:00", "p