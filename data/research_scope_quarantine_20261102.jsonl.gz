{"text_id": "text_62c2e700d3b672f44dfd", "record_id": "article_62c2e700d3b672f4", "canonical_url": "https://insideclimatenews.org/news/19122025/the-texas-power-grid-will-get-a-boost-from-batteries-this-winter", "publisher_url": "https://insideclimatenews.org/news/19122025/the-texas-power-grid-will-get-a-boost-from-batteries-this-winter", "title_original": "The Texas Power Grid Will Get a Boost from Batteries This Winter", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-19T17:48:28+00:00", "source_text": "Even with less available electric power capacity during cold weather in Texas, battery storage systems are reducing the risk of power outages this winter, the Electric Reliability Council of Texas (ERCOT) reported at its December board of directors meeting. In its most recent resource adequacy report, ERCOT modeled battery availability in December 2024, when operating […]", "text_kind": "source_excerpt", "text_characters": 374, "text_sha256": "41d92589ec1f2b5a67e61cf5b72d909b05d8b644e59f65a57d379f813a7e152a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:21.836455+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:21.872573+00:00", "published_at_raw": "2025-12-19T17:48:28", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 4, "end": 9, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 72, "end": 77, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_3550e0974c1fe3bfc547", "record_id": "article_3550e0974c1fe3bf", "canonical_url": "https://news.mongabay.com/2025/12/protected-areas-in-africa-are-vital-but-local-perceptions-vary-commentary", "publisher_url": "https://news.mongabay.com/2025/12/protected-areas-in-africa-are-vital-but-local-perceptions-vary-commentary", "title_original": "Protected areas in Africa are vital but local perceptions vary (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-19T16:49:33+00:00", "source_text": "Protected areas (PAs) are cornerstones of global biodiversity conservation strategy, yet their social impacts remain contentious. The prevailing narrative often pits global benefits, like biodiversity protection and carbon sequestration, against local costs like restricted access to land and resources, particularly in lower-income nations. This antagonistic framing — the interests of local people vs. the interests of other people elsewhere (or […]", "text_kind": "source_excerpt", "text_characters": 451, "text_sha256": "b0c9f4ba7ee90b123f387287fd5c8564ffbb924c6a8f52e86519d1b5de2781e6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:52.421159+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:52.449642+00:00", "published_at_raw": "2025-12-19T16:49:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_3b5b7d2ae2dc4a582786", "record_id": "article_3b5b7d2ae2dc4a58", "canonical_url": "https://news.mongabay.com/2025/12/tsunami-veteran-rescue-elephants-mobilized-for-indonesia-cyclone-disaster-relief", "publisher_url": "https://news.mongabay.com/2025/12/tsunami-veteran-rescue-elephants-mobilized-for-indonesia-cyclone-disaster-relief", "title_original": "Tsunami veteran rescue elephants mobilized for Indonesia cyclone disaster relief", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-19T04:56:31+00:00", "source_text": "PIDIE JAYA, Indonesia — A group of specialist Sumatran elephants have joined recovery operations in Aceh following the catastrophic landfall of Cyclone Senyar in late November — two decades after the veteran responders supported rescuers after the 2004 Boxing Day tsunami. “They’re guided by mahouts who know very well the characteristics of the elephants,” said […]", "text_kind": "source_excerpt", "text_characters": 366, "text_sha256": "081260af1a4318bacec592418050fd8e6cb28575d49acddac0a79a7e09a0d2ed", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:52.591802+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:52.621217+00:00", "published_at_raw": "2025-12-19T04:56:31", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 47, "end": 56, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 12, "end": 21, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_fff8df5ea3bc8aaa778c", "record_id": "article_fff8df5ea3bc8aaa", "canonical_url": "https://news.mongabay.com/2025/12/when-abandoned-conservation-projects-are-counted-as-progress-what-are-we-protecting-commentary", "publisher_url": "https://news.mongabay.com/2025/12/when-abandoned-conservation-projects-are-counted-as-progress-what-are-we-protecting-commentary", "title_original": "When abandoned conservation projects are counted as progress, what are we protecting? (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-18T18:38:54+00:00", "source_text": "COP30 has come and gone, leaving behind a familiar mix of new commitments and renewed political promises. But amid the declarations of progress, one issue that received almost backhanded attention is the quiet abandonment of conservation projects after their high-profile launches. New research published in Nature Ecology & Evolution by a team co-led by Matthew […]", "text_kind": "source_excerpt", "text_characters": 366, "text_sha256": "84edcc95224ed7141f78d90e92ff6df8fe8daab90965ddc69bc403ed6072758a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:52.749719+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": ["COP30"], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "negotiations", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "