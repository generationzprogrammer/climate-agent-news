{"text_id": "text_6987c416d4096d5448e1", "record_id": "article_6987c416d4096d54", "canonical_url": "https://news.mongabay.com/2024/01/maluku-farmers-sweat-el-nino-drought-as-indonesia-rice-prices-surge", "publisher_url": "https://news.mongabay.com/2024/01/maluku-farmers-sweat-el-nino-drought-as-indonesia-rice-prices-surge", "title_original": "Maluku farmers sweat El Niño drought as Indonesia rice prices surge", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-25T07:19:06+00:00", "source_text": "BURU ISLAND, Indonesia – At the beginning of November last year, Tamami’s rice field lay vacant except for a herd of cattle grazing on the land. Like many rice farmers here on Buru Island in Indonesia’s eastern Maluku region, 53-year-old Tamami set aside his field after the availability of water dried up. “There’s no rain,” […]", "text_kind": "source_excerpt", "text_characters": 329, "text_sha256": "ad86bf9227c0f809841d1d2e3b08fa20ae82298dae19a96571ec933d3ed76065", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:24.042923+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:24.058397+00:00", "published_at_raw": "2024-01-25T07:19:06", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 40, "end": 49, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 13, "end": 22, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_b087e0c8c070e979805f", "record_id": "article_b087e0c8c070e979", "canonical_url": "https://insideclimatenews.org/news/22012024/texas-low-water-reserves", "publisher_url": "https://insideclimatenews.org/news/22012024/texas-low-water-reserves", "title_original": "Another Hot, Dry Summer May Push Parts of Texas to the Brink", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-22T10:10:00+00:00", "source_text": "Two consecutive summers of brutal heat and drought have left some parts of Texas with notably low water supplies going into 2024. A wet year or a well-placed hurricane could quickly pull these regions back from the brink. But winter rains have disappointed so far. Monday’s downpours are the first in weeks for parts of […]", "text_kind": "source_excerpt", "text_characters": 323, "text_sha256": "d10eacc637dfa0b0007bae759d4155cd85182097a313eda8127dcecba8a4b502", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:40.967181+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 43, "end": 50, "evidence": "Two consecutive summers of brutal heat and drought have left some parts of Texas with notably low water supplies going into 2024. A wet year or a well-placed hurricane could quickly pull the"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:41.003447+00:00", "published_at_raw": "2024-01-22T10:10:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 42, "end": 47, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 75, "end": 80, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_3410cac05908175fac85", "record_id": "article_3410cac05908175f", "canonical_url": "https://insideclimatenews.org/news/21012024/blm-resource-management-plan-in-southwest-wyoming", "publisher_url": "https://insideclimatenews.org/news/21012024/blm-resource-management-plan-in-southwest-wyoming", "title_original": "A Long-Delayed BLM Resource Management Plan in Southwest Wyoming Pits Conservation Against Resource Extraction", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-21T10:00:00+00:00", "source_text": "For the last 16 years, Joy Bannon has been leading tours of the land near Rock Springs, Wyoming. Usually, Bannon and her cohort mosey through Wyoming’s southwest landscape—home to the sandstone badlands and slithering dunes of the Northern Red Desert, and the Big Sandy Foothills, a sea of sagebrush bordering the Wind River range—in vehicles, […]", "text_kind": "source_excerpt", "text_characters": 347, "text_sha256": "42f52e751c05a39adfe67ca542a8bee1b81d4c66041b3011ebba9a54729733cf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:41.431821+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:41.469528+00:00", "published_at_raw": "2024-01-21T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_43184af8b7680b1a373c", "record_id": "article_43184af8b7680b1a", "canonical_url": "https://news.mongabay.com/2024/01/carbon-catch-and-release-study-finds-bottom-trawlers-stir-up-seabed-co2", "publisher_url": "https://news.mongabay.com/2024/01/carbon-catch-and-release-study-finds-bottom-trawlers-stir-up-seabed-co2", "title_original": "How much carbon does ocean trawling put into the atmosphere?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-19T16:19:29+00:00", "source_text": "Nearly a quarter of the world’s wild-caught seafood is scooped up by bottom trawlers, fishing vessels that drag heavy nets over the seafloor. These boats fish the world over and support numerous global seafood supply chains. Yet critics have dogged them as environmentally unfriendly. Conservation experts say they can damage sensitive marine ecosystems, like deep-sea […]", "text_kind": "source_excerpt", "text_characters": 372, "text_sha256": "e2ab5f402554e379cf290ca194f3ad54e36b525f3df8fa2083cc3e12b2b1e80b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:24.338735+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:24.353659+00:00", "published_at_raw": "2024-01-19T16:19:29", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
