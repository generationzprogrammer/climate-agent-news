{"text_id": "text_736013b89d2fd88bdde4", "record_id": "article_736013b89d2fd88b", "canonical_url": "https://insideclimatenews.org/news/28082026/trump-administration-speeds-up-alaska-pipeline-environmental-review", "publisher_url": "https://insideclimatenews.org/news/28082026/trump-administration-speeds-up-alaska-pipeline-environmental-review", "title_original": "Trump Administration Speeds Up Environmental Review for 800-Mile Alaska Oil Pipeline", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-28T19:41:32+00:00", "source_text": "The Trump administration is expediting an environmental review of the 800-mile Trans-Alaska Pipeline System that would reauthorize the project for another 30 years, including the pipeline, pump stations, access roads, bridges and a fuel gas line that lie within the right-of-way. The Bureau of Land Management is also shortening the public comment period for review […]", "text_kind": "source_excerpt", "text_characters": 369, "text_sha256": "44ccd181563f31ba6670e61bd770575b34a09655596de4a78c6cc0ef92fab5e9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:13.855452+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive