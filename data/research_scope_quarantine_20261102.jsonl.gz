{"text_id": "text_bf8be17d05c31ee534e8", "record_id": "article_bf8be17d05c31ee5", "canonical_url": "https://news.mongabay.com/2026/03/disastrous-floods-in-colombia-reignite-debate-over-hydroelectric-dam", "publisher_url": "https://news.mongabay.com/2026/03/disastrous-floods-in-colombia-reignite-debate-over-hydroelectric-dam", "title_original": "Disastrous floods in Colombia reignite debate over hydroelectric dam", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-13T17:12:42+00:00", "source_text": "MONTERÍA, Colombia — In the suburb of La Palma, in the city of Montería, Córdoba, two boys stand knee-deep in water. A shimmering film of dirt spreads across its opaque surface. The two are piling family possessions into an upturned refrigerator – a makeshift raft used to ferry their belongings toward dry land. Across the […]", "text_kind": "source_excerpt", "text_characters": 327, "text_sha256": "219dc91f67a6258e19c2c5974d07e59bf242c19439d9981886b83c1db0c1661d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:46.054372+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:46.082692+00:00", "published_at_raw": "2026-03-13T17:12:42", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 21, "end": 29, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 10, "end": 18, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_47afaff4042f4e507deb", "record_id": "article_47afaff4042f4e50", "canonical_url": "https://www.carbonbrief.org/qa-why-does-gas-set-the-price-of-electricity-and-is-there-an-alternative", "publisher_url": "https://www.carbonbrief.org/qa-why-does-gas-set-the-price-of-electricity-and-is-there-an-alternative", "title_original": "Q&A: Why does gas set the price of electricity – and is there an alternative?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-13T16:17:07+00:00", "source_text": "A surge in gas prices triggered by the Iran war has caused a knock-on spike in the price of electricity in the UK, Italy and many other European markets. This is because gas almost always sets the price of power in these countries, even though a significant share of their electricity comes from cheaper sources. This “coupling”, which is part of what UK energy secretary Ed Miliband calls the “fossil-fuel rollercoaster”, is due to the “marginal pricing” system used in most electricity markets globally. After another fossil-fuel price shock, just four years after Russia’s invasion of Ukraine, this coupling between gas and electricity prices is once again under the spotlight, in the UK and the EU.", "text_kind": "article_excerpt", "text_characters": 702, "text_sha256": "47b6c5bd22ffa4812c9759c55631486b8b33065a094675df13f5b79d35a94a16", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:41.016640+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "RU", "alpha3": "RUS", "name_zh": "俄罗斯", "name_en": "Russia"}, {"alpha2": "UA", "alpha3": "UKR", "name_zh": "乌克兰", "name_en": "Ukraine"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}, {"alpha2": "IT", "alpha3": "ITA", "name_zh": "意大利", "name_en": "Italy"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 355, "end": 361, "evidence": "f their electricity comes from cheaper sources. This “coupling”, which is part of what UK energy secretary Ed Miliband calls the “fossil-fuel rollercoaster”, is due to the “marginal pricing” system used in most electricity markets globa"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "RU", "alpha3": "RUS", "name_zh": "俄罗斯", "name_en": "Russia"}, {"alpha2": "UA", "alpha3": "UKR", "name_zh": "乌克兰", "name_en": "Ukraine"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}, {"alpha2": "IT", "alpha3": "ITA", "name_zh": "意大利", "name_en": "Italy"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:41.064458+00:00", "published_at_raw": "2026-03-13T16:17:07", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran", "start": 39, "end": 43, "matched_text": "Iran", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 111, "end": 113, "matched_text": "UK", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "IT", "alpha3": "ITA", "name_zh": "意大利", "name_en": "Italy", "start": 115, "end": 120, "matched_text": "Italy", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "RU", "alpha3": "RUS", "name_zh": "俄罗斯", "name_en": "Russia", "start": 567, "end": 573, "matched_text": "Russia", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "UA", "alpha3": "UKR", "name_zh": "乌克兰", "name_en": "Ukraine", "start": 588, "end": 595, "matched_text": "Ukraine", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_a06cbed7e293d8aeda0f", "record_id": "article_a06cbed7e293d8ae", "canonical_url": "https://insideclimatenews.org/news/12032026/alabama-public-service-commission-utility-regulation-electric-bills", "publisher_url": "https://insideclimatenews.org/news/12032026/alabama-public-service-commission-utility-regulation-electric-bills", "title_original": "Alabama Poised to Drastically Overhaul Utility Regulation. Will It Lower Electric Bills?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-13T00:37:17+00:00", "source_text": "MONTGOMERY, Ala.—High electricity costs have been the talk of the session in the Alabama Legislature, and the state seems poised to totally revamp its utility regulatory process. But which changes will be made and how effective those changes will be are very much in question, as the session winds down with multiple utility bills still […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "bf6269aef456e589d1590994761d453727dc65f582082c9d7d008bf689b2e528", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:27.459206+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https