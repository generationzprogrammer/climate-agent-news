{"text_id": "text_06e35e877636b8811581", "record_id": "article_06e35e877636b881", "canonical_url": "https://news.mongabay.com/2024/07/wto-negotiations-flounder-again-over-banning-unsustainable-fishing-subsidies", "publisher_url": "https://news.mongabay.com/2024/07/wto-negotiations-flounder-again-over-banning-unsustainable-fishing-subsidies", "title_original": "WTO negotiations flounder — again — over banning unsustainable fishing subsidies", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-31T17:04:10+00:00", "source_text": "Hopes for closure on a fair deal to stop governments bankrolling overfishing flopped yet again at the recent General Council meeting of the World Trade Organization (WTO) in Geneva. Scheduled decision-making sessions aimed at closing the second half of a legally binding treaty to curb harmful fisheries subsidies were downgraded to a discussion at the […]", "text_kind": "source_excerpt", "text_characters": 356, "text_sha256": "9cec44b5ebae55fd5b42a2304af1f422bab85f78db98ccd2a1f66fede735d1ef", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:49.610304+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "subsidy", "label_zh": "补贴与激励", "label_en": "Subsidies and incentives", "start": 304, "end": 310, "evidence": "ns aimed at closing the second half of a legally binding treaty to curb harmful fisheries subsidies were downgraded to a discussion at the […]"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:49.641887+00:00", "published_at_raw": "2024-07-31T17:04:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_c79a376e8467ab4ca4b4", "record_id": "article_c79a376e8467ab4c", "canonical_url": "https://news.mongabay.com/2024/07/hydropower-plants-disrupt-fishers-lives-in-amazons-most-biodiverse-river-basin", "publisher_url": "https://news.mongabay.com/2024/07/hydropower-plants-disrupt-fishers-lives-in-amazons-most-biodiverse-river-basin", "title_original": "Hydropower plants disrupt fishers’ lives in Amazon’s most biodiverse river basin", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-31T07:00:12+00:00", "source_text": "In Middle Madeira, fishing became more costly and demanding, with fishers needing to spend more days and travel farther to spots to maintain decent productivity, which led many riverines to illegal activities.", "text_kind": "source_excerpt", "text_characters": 209, "text_sha256": "9484791010446433fa8ff648c07636cfd2eaae73a722bb42d30fb671377e5e74", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:50.026267+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:50.054691+00:00", "published_at_raw": "2024-07-31T07:00:12", "s