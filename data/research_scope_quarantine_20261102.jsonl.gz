{"text_id": "text_b57efd0d37413e901320", "record_id": "article_b57efd0d37413e90", "canonical_url": "https://news.mongabay.com/2025/07/evolution-in-overdrive-as-baltic-cod-shrink-due-to-fishing-pressure-study-shows", "publisher_url": "https://news.mongabay.com/2025/07/evolution-in-overdrive-as-baltic-cod-shrink-due-to-fishing-pressure-study-shows", "title_original": "Evolution in overdrive as Baltic cod shrink due to fishing pressure, study shows", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-18T19:49:05+00:00", "source_text": "The eastern Baltic cod has shrunk dramatically in size in recent decades due to rapid evolution — changes at the genetic level — caused by decades of intensive fishing, a new study says. It’s one of the first studies to show that a marine species has evolved in response to fishing pressure. Sampled Eastern Baltic […]", "text_kind": "source_excerpt", "text_characters": 318, "text_sha256": "ab8df629393e74b8c84534c9339945c8e89676ad4b06ff746b7ffdcb85969808", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:38.000460+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/po