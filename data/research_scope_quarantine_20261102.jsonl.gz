{"text_id": "text_4fee1d7585d6aa0c65b8", "record_id": "article_4fee1d7585d6aa0c", "canonical_url": "https://insideclimatenews.org/news/26012024/could-get-easier-to-build-solar-in-western-us", "publisher_url": "https://insideclimatenews.org/news/26012024/could-get-easier-to-build-solar-in-western-us", "title_original": "It Could Soon Get a Whole Lot Easier to Build Solar in the Western US", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-26T10:00:00+00:00", "source_text": "The Biden administration has outlined how it could dramatically expand the public lands available to streamline solar development in the Western U.S., a major step that could help sustain the surge in solar energy projects across the country. The Bureau of Land Management last week released a proposal to update its 2012 Western Solar Plan […]", "text_kind": "source_excerpt", "text_characters": 344, "text_sha256": "030db9b2baf27d9d4f0c2d9d7e8074e2d7be34384e4731006a3552894da05515", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:39.851444+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 112, "end": 117, "evidence": "on has outlined how it could dramatically expand the public lands available to streamline solar development in the Western U.S., a major step that could help sustain the surge in solar energy projects across the country. The Bureau of "}], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 294, "end": 302, "evidence": "ar energy projects across the country. The Bureau of Land Management last week released a proposal to update its 2012 Western Solar Plan […]"}], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:39.870462+00:00", "published_at_raw": "2024-01-26T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 67, "end": 69, "matched_text": "US", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 145, "end": 149, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_243da7b4799760625666", "record_id": "article_243da7b479976062", "canonical_url": "https://insideclimatenews.org/news/25012024/inside-clean-energy-decommissioning-solar-plants", "publisher_url": "https://insideclimatenews.org/news/25012024/inside-clean-energy-decommissioning-solar-plants", "title_original": "Who Pays for Cleanup When a Solar Project Reaches the End of Its Life?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-25T14:00:00+00:00", "source_text": "One of the objections to utility-scale solar power that I hear most often is that local communities will be left to cover the costs of cleanup at the end of a project’s life. But state and local rules in nearly all of the country are clear about who pays: The developer or the owner is […]", "text_kind": "source_excerpt", "text_characters": 289, "text_sha256": "f7c728b4db6121676f7b33b30432eef07f3c4f84aa049da8213825b1f9449c65", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:40.052096+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 39, "end": 44, "evidence": "One of the objections to utility-scale solar power that I hear most often is that local communities will be left to cover the costs of cleanup at the end of a project’s life. But state"}], "policy_tools": [], "policy_stag