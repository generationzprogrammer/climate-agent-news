{"text_id": "text_0c4e83c5ed6dc3781ec0", "record_id": "article_0c4e83c5ed6dc378", "canonical_url": "https://insideclimatenews.org/news/18032024/clairton-pennsylvania-environmental-policy-inequities", "publisher_url": "https://insideclimatenews.org/news/18032024/clairton-pennsylvania-environmental-policy-inequities", "title_original": "In the ‘Armpit of the Universe,’ a Window Into the Persistent Inequities of Environmental Policy", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-18T09:00:00+00:00", "source_text": "Germaine Gooden-Patterson has lived in Clairton, Pennsylvania, for more than 15 years, but it wasn’t until she began a job as a community health worker in 2019 that she understood how much air pollution was affecting her neighbors’ lives—and her own. Gooden-Patterson’s work for the Pittsburgh-based nonprofit Women for a Healthy Environment required her to visit […]", "text_kind": "source_excerpt", "text_characters": 367, "text_sha256": "1f784c88e087cd6e37bb3ae9094b33b271c0147f2292262e5081fd1fa9e27f65", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:18.233204+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:18.250068+00:00", "published_at_raw": "2024-03-18T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_c62581e842ac2963d3f6", "record_id": "article_c62581e842ac2963", "canonical_url": "https://dialogue.earth/en/climate/interview-to-find-common-ground-in-the-himalayas-is-in-our-self-interest", "publisher_url": "https://dialogue.earth/en/climate/interview-to-find-common-ground-in-the-himalayas-is-in-our-self-interest", "title_original": "Interview: ‘To find common ground in the Himalayas is in our self-interest’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-15T07:05:32+00:00", "source_text": "In June 2023, the International Centre for Integrated Mountain Development (ICIMOD) released its latest report on the cryosphere (regions where water freezes) in the Himalayan region. It stated that at least half or more of the Himalayan glaciers would be gone by 2100, and water availability would start declining from 2050. This will impact everything from hydropower and agriculture to biodiversity. One of the key regions facing these threats is the Kashmir valley. The Third Pole spoke to Shakil Ahmad Romshoo, a prominent glaciologist and and currently the vice chancellor of the Islamic University of Science and Technology, Avantipora, on these changes and their impact on Kashmir, the Himalayas, and the wider region. Edited excerpts follow.", "text_kind": "article_excerpt", "text_characters": 750, "text_sha256": "ceb892b2a47f1410ebc13296d82e7a4dbfcbf2e9a61c5cdc384b99522196e5c8", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:38.572100+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:38.604345+00:00", "published_at_raw": "2024-03-15T07:05:32", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_0e265fecda8d43668920", "record_id": "article_0e265fecda8d4366", "canonical_url": "https://news.mongabay.com/2024/03/huge-new-no-fishing-zones-give-antarctic-marine-predators-and-their-prey-a-break", "publisher_url": "https://news.mongabay.com/2024/03/huge-new-no-fishing-zones-give-antarctic-marine-predators-and-their-prey-a-break", "title_original": "Huge new no-fishing zones give Antarctic marine predators and their prey a break", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-14T19:02:30+00:00", "source_text": "Thousands of miles off the southeast coast of South America lies a set of remote islands, one broad and comma-shaped, the others a series of small dots that trail off into the South Atlantic Ocean. These are the South Georgia and South Sandwich Islands, located north of the icy mass of Antarctica. The islands, which […]", "text_kind": "source_excerpt", "text_characters": 321, "text_sha256": "2055ba3c7a272601eb58c7bb5e29918b5cb671b20b646e9736a23b4b2fb26fe9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:02.627379+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AQ", "alpha3": "ATA", "name_zh": "南极洲", "name_en": "Antarctica"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "AQ", "alpha3": "ATA", "name_zh": "南极洲", "name_en": "Antarctica"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:02.639534+00:00", "published_at_raw": "2024-03-14T19:02:30", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "AQ", "alpha3": "ATA", "name_zh": "南极洲", "name_en": "Antarctica", "start": 287, "end": 297, "matched_text": "Antarctica", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_752f623cef2de6721b31", "record_id": "article_752f623cef2de672", "canonical_url": "https://insideclimatenews.org/news/14032024/inside-clean-energy-coal-power-decline", "publisher_url": "https://insideclimatenews.org/news/14032024/inside-clean-energy-coal-power-decline", "title_original": "Coal Power Plunged Again in 2023 and Is Fading Away in the U.S. So What Replaces It?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-14T13:00:00+00:00", "source_text": "Coal power took a big step toward the exit last year in the United States, as plants continue to close and the ones that remain are being used less than before. While we’re still a decade—or maybe decades—away from the shutdown of the last U.S. coal plant, the fuel’s role in our energy economy has […]", "text_kind": "source_excerpt", "text_characters": 302, "text_sha256": "79c0a6e6918726557c00aaac5a6125ad6604f2b55cb41d85f3a2a74cb5a186f9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:18.608329+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 0, "end": 4, "evidence": "Coal power took a big step toward the exit last year in the United States, as plants continue to close and the ones that remain are being used l"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:18.619651+00:00", "published_at_raw": "2024-03-14T13:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 59, "end": 63, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 60, "end": 73, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_74152bed64e1d7c041c4", "record_id": "article_74152bed64e1d7c0", "canonical_url": "https://insideclimatenews.org/news/14032024/california-energy-regulators-to-consider-nonenergy-impacts", "publisher_url": "https://insideclimatenews.org/news/14032024/california-energy-regulators-to-consider-nonenergy-impacts", "title_original": "California Votes to Consider Health and Environment in Future Energy Planning", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-14T08:30:00+00:00", "source_text": "The California Energy Commission voted unanimously on Wednesday to begin a process to incorporate the value of “non-energy benefits,” such as health impacts and job creation, in future decisions about the state’s energy mix. The practice is not entirely uncommon. Several other states have considered certain non-energy impacts in energy decisions—Minnesota has considered air quality […]", "text_kind": "source_excerpt", "text_characters": 388, "text_sha256": "4606b768b104eeb5d257b3b6b705132837fd1085fe5ab0e45262a60225f0704b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:18.684362+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 15, "end": 21, "evidence": "The California Energy Commission voted unanimously on Wednesday to begin a process to incorporate the value of “non-energy benefits,” such as health impacts and "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:18.700857+00:00", "published_at_raw": "2024-03-14T08:30:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 10, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 4, "end": 14, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_f74b5231991c7e199962", "record_id": "article_f74b5231991c7e19", "canonical_url": "https://insideclimatenews.org/news/12032024/lawmakers-aim-to-ban-lab-grown-meat", "publisher_url": "https://insideclimatenews.org/news/12032024/lawmakers-aim-to-ban-lab-grown-meat", "title_original": "Across the Nation, Lawmakers Aim to Ban Lab-Grown Meat", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-12T09:10:00+00:00", "source_text": "Months in jail and thousands of dollars in fines and legal fees—those are the consequences Alabamians and Arizonans could soon face for selling cell-cultured meat products that could cut into the profits of ranchers, farmers and meatpackers in each state. State legislators from Florida to Arizona are seeking to ban meat grown from animal cells […]", "text_kind": "source_excerpt", "text_characters": 349, "text_sha256": "19faf42836428a9fb24b6337c35f2a436d5ffe41a66c9af42e5175bdda13318d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:18.870794+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55: