{"text_id": "text_0dc6655b8e59b9b8f347", "record_id": "article_0dc6655b8e59b9b8", "canonical_url": "https://insideclimatenews.org/news/13022025/new-pipeline-to-connect-permian-basin-texas-industrial-corridor", "publisher_url": "https://insideclimatenews.org/news/13022025/new-pipeline-to-connect-permian-basin-texas-industrial-corridor", "title_original": "New Pipeline Will Bring More Permian Gas to Texas Industrial Corridor", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-13T23:17:03+00:00", "source_text": "A Texas utility company this week announced an agreement to pipe an additional 1.5 billion cubic feet of Permian Basin gas to the Port Arthur industrial corridor. Entergy Texas, a regional utility, will partner with pipeline giant Kinder Morgan and Golden Pass LNG on the $1.7 billion, 216-mile Trident Intrastate Pipeline to meet surging power […]", "text_kind": "source_excerpt", "text_characters": 348, "text_sha256": "9fa1f99df19eade1b574809c44b7ffdb43163e9fec2c182a95735567b5a57489", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:52.104914+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "1.5 billion", "start": 79, "end": 90, "evidence": "A Texas utility company this week announced an agreement to pipe an additional 1.5 billion cubic feet of Permian Basin gas to the Port Arthur industrial corridor.", "interpretation": "not_classified"}, {"value_text": "$1.7 billion", "start": 272, "end": 284, "evidence": " Entergy Texas, a regional utility, will partner with pipeline giant Kinder Morgan and Golden Pass LNG on the $1.7 billion, 216-mile Trident Intrastate Pipeline to meet surging power […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:52.121770+00:00", "published_at_raw": "2025-02-13T23:17:03", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 44, "end": 49, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 2, "end": 7, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_deddef05b28db2ba2aca", "record_id": "article_deddef05b28db2ba", "canonical_url": "https://insideclimatenews.org/news/11022025/chestnut-alabama-public-water-access", "publisher_url": "https://insideclimatenews.org/news/11022025/chestnut-alabama-public-water-access", "title_original": "In Chestnut, Black Alabamians Have Lived for Years Without Access to Public Water. There’s Little Hope in Sight", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-11T10:00:00+00:00", "source_text": "CHESTNUT, Ala.—For Valentino Thames, it’s become a routine. Just another part of everyday life. At least once a week, he makes a trip of more than 25 miles to the nearest Walmart, located in the county seat of Monroeville, to buy gallons and gallons of water—enough for him and his wife Linda to drink, cook […]", "text_kind": "source_excerpt", "text_characters": 311, "text_sha256": "080f8c5bb77fe6af5cf3d102e9e7a0791826be095afeacbbe9898a5ab1c6349a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:52.702791+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:52.725284+00:00", "published_at_raw": "2025-02-11T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_287c133d3bd3469424f5", "record_id": "article_287c133d3bd34694", "canonical_url": "https://insideclimatenews.org/news/10022025/opting-for-coexistence-some-wisconsin-landowners-learn-to-live-with-beavers", "publisher_url": "https://insideclimatenews.org/news/10022025/opting-for-coexistence-some-wisconsin-landowners-learn-to-live-with-beavers", "title_original": "Opting for Coexistence: Some Wisconsin Landowners Learn To Live With Beavers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-10T09:55:00+00:00", "source_text": "Katie McCullough loved Arizona winters, but hot summers could be a drag. After purchasing a recreational vehicle, she spent time trekking cross-country to deliver shelter dogs to a no-kill rescue. McCullough, 56, visited friends and family, too, with her own canine pack—then, Rosy, Eddie Spaghetti, Ky, Pally, Duke, Nudge and Nutter Butter—a tossed salad of […]", "text_kind": "source_excerpt", "text_characters": 362, "text_sha256": "162234053f20615fcab71952dd27bec5878acf391e51ba6bc3343c95a0879b9c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:52.960241+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:52.979158+00:00", "published_at_raw": "2025-02-10T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_bf5ede4b367d22fe30e6", "record_id": "article_bf5ede4b367d22fe", "canonical_url": "https://news.mongabay.com/2025/02/nearly-20000-animals-seized-in-global-wildlife-trafficking-crackdown", "publisher_url": "https://news.mongabay.com/2025/02/nearly-20000-animals-seized-in-global-wildlife-trafficking-crackdown", "title_original": "Nearly 20,000 animals seized in global wildlife trafficking crackdown", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-10T09:54:49+00:00", "source_text": "Big cats, birds, primates and pangolins were among the nearly 20,000 threatened or protected animals rescued in a recent global operation against wildlife and forestry traffickers. Led by Interpol and the World Customs Organization (WCO), the campaign, called Operation Thunder 2024, involved police, customs, border patrol, forestry and wildlife officials from 138 countries and regions. […]", "text_kind": "source_excerpt", "text_characters": 392, "text_sha256": "5c56a6767fd40f107ae5f20feea7b30668c478ed529c98bf81e3da60c68f4a78", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:11.959718+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "h