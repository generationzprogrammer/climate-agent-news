{"text_id": "text_c237826ff98e1688f815", "record_id": "article_c237826ff98e1688", "canonical_url": "https://news.mongabay.com/2026/03/ecuadors-new-ecological-corridor-connects-andes-and-amazon-ecosystems", "publisher_url": "https://news.mongabay.com/2026/03/ecuadors-new-ecological-corridor-connects-andes-and-amazon-ecosystems", "title_original": "Ecuador’s new ecological corridor connects Andes and Amazon ecosystems", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-09T19:54:36+00:00", "source_text": "Ecuador has announced the creation of a new biological corridor designed to connect the eastern ranges of the Andes with the Amazon Rainforest, part of a larger initiative to strengthen ecological connectivity and protect biodiversity. The Llanganates–Yasuní Connectivity Corridor, officially announced this month, spans 2,159 square kilometers (834 square miles) across two provinces, connecting Llanganates […]", "text_kind": "source_excerpt", "text_characters": 412, "text_sha256": "b69232aa2fd43b825ed9c0b53404e34103a46e2f3eb4450096f886c83957959c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:51.058153+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:51.119658+00:00", "published_at_raw": "2026-03-09T19:54:36", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador", "start": 0, "end": 7, "matched_text": "Ecuador", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador", "start": 0, "end": 7, "matched_text": "Ecuador", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_665f06419cf9492a6085", "record_id": "article_665f06419cf9492a", "canonical_url": "https://news.mongabay.com/2026/03/the-cerrado-is-threatened-but-crucial-for-brazils-biodiversity-water-security-commentary", "publisher_url": "https://news.mongabay.com/2026/03/the-cerrado-is-threatened-but-crucial-for-brazils-biodiversity-water-security-commentary", "title_original": "The Cerrado is threatened but crucial for Brazil’s biodiversity & water security (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-09T16:37:38+00:00", "source_text": "The Brazilian Cerrado, recognized as one of the world’s most species-diverse and threatened ecodomains on the planet, faces increasing pressure from large-scale agriculture and land conversion. “Ecodomains” are large areas where the predominant native vegetation is of a given general type, such as the Cerrado. These areas, officially termed “biomes” in Brazil since 2004 (a […]", "text_kind": "source_excerpt", "text_characters": 379, "text_sha256": "91bed8822c8d0a2a9cacdeecab9a8fdd65909e9dce0a5398df14a7f1f7445d78", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:51.512654+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:51.576424+00:00", "published_at_raw": "2026-03-09T16:37:38", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 42, "end": 48, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 355, "end": 361, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_e6c49211f7e78741fb31", "record_id": "article_e6c49211f7e78741", "canonical_url": "https://insideclimatenews.org/news/08032026/icn-sunday-morning-agriculture-devours-lands", "publisher_url": "https://insideclimatenews.org/news/08032026/icn-sunday-morning-agriculture-devours-lands", "title_original": "Gobbled up by Agriculture", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-08T08:50:00+00:00", "source_text": "Agriculture is the biggest driver of forest destruction around the world, especially in well-known places like the Amazon rainforest. But new research finds that other ecosystems—the world’s grasslands, savannas and wetlands—are being gobbled up for agriculture at nearly four times the rate as forests. As with forests, the main reason is livestock. Georgina, who reports […]", "text_kind": "source_excerpt", "text_characters": 376, "text_sha256": "d9d0fb91a304ff945e9e416b9a0b469ac7e04a30d871e7c5119a9406632054e6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:33.826447+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:33.851083+00:00", "published_at_raw": "2026-03-08T08:50:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_b9371ad3f651f307691a", "record_id": "article_b9371ad3f651f307", "canonical_url": "https://dialogue.earth/en/nature/mexicos-final-glacier-is-reshaping-everything-downstream", "publisher_url": "https://dialogue.earth/en/nature/mexicos-final-glacier-is-reshaping-everything-downstream", "title_original": "Mexico’s final glacier is reshaping everything downstream", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-06T16:45:31+00:00", "source_text": "At 9am on the final day of May 2025, 70-year-old mountaineer Hilario Álvarez stopped at the edge of Mexico’s last glacier. And he listened. There it was, at an altitude of 5,300 metres: the soft crackling of melting ice. He squinted to watch the drops of water, sliding down stalactites hanging beneath the ice sheet before disappearing into the porous soil of Citlaltépetl, the highest mountain in Mexico. It is from this ice on Citlaltépetl – also known as the Pico de Orizaba volcano – that a river springs. Across hundreds of kilometres, it touches the lives of millions of people before flowing into the Gulf of Mexico. That May, Álvarez inspected a cavity that had formed between the ice and the earth, large enough for an adult to crawl inside.", "text_kind": "article_excerpt", "text_characters": 751, "text_sha256": "5082c718863ad88f56fa2a36bcee60384b556ab0c697ce9fbb228856180784cd", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:50.938670+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:50.978368+00:00", "published_at_raw": "2026-03-06T16:45:31", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 0, "end": 6, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 100, "end": 106, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_1db7a2890fac2a3552cd", "record_id": "article_1db7a2890fac2a35", "canonical_url": "https://insideclimatenews.org/news/06032026/illinois-comed-ev-rebate-funding", "publisher_url": "https://insideclimatenews.org/news/06032026/illinois-comed-ev-rebate-funding", "title_original": "Illinois Utility Announces New Round of Electric Vehicle Rebate Funding for Residents and Businesses", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-06T10:00:00+00:00", "source_text": "After a year in which the Trump administration rolled back electric-vehicle rebates and funding programs, the largest electric utility in Illinois announced an additional rebate program of nearly $70 million to fund electric-vehicle infrastructure projects in northern Illinois. Leaders of the Commonwealth Edison Co. (ComEd) promoted the program at a press conference ahead of the […]", "text_kind": "source_excerpt", "text_characters": 385, "text_sha256": "353761d3629cf2d7ee6009e0f526d262edb6266c511e925c6624675d1879895c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:34.321007+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$70 million", "start": 196, "end": 207, "evidence": "After a year in which the Trump administration rolled back electric-vehicle rebates and funding programs, the largest electric utility in Illinois announced an additional rebate program of nearly $70 million to fund electric-vehicle infrastructure projects in northern Illinois.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 88, "end": 95, "evidence": "After a year in which the Trump administration rolled back electric-vehicle rebates and funding programs, the largest electric utility in Illinois announced an additional rebate program of nearly $70 million to fund electric-vehicle in"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:34.346699+00:00", "published_at_raw": "2026-03-06T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_70e3fe48774ce44e7b29", "record_id": "article_70e3fe48774ce44e", "canonical_url": "https://news.mongabay.com/2026/03/bringing-storytelling-to-science-john-cannons-approach-to-reporting-on-nature", "publisher_url": "https://news.mongabay.com/2026/03/bringing-storytelling-to-science-john-cannons-approach-to-reporting-on-nature", "title_original": "Bringing storytelling to science: John Cannon’s approach to reporting on nature", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-05T17:40:21+00:00", "source_text": "For John Cannon, reporting on nature begins with a story grounded in the truth. “Evidence-based reporting [is] at the heart of what we do at Mongabay,” he says. “I believe it’s perhaps the most profound way we can contribute to making things better.” With a biology degree from Ohio State University and a graduate degree […]", "text_kind": "source_excerpt", "text_characters": 325, "text_sha256": "a8d0111034ef33076411e065705e3e35c23396e791e6819e68c1bb37bded628b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:52.074444+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:52.130886+00:00", "published_at_raw": "2026-03-05T17:40:21", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_abebac7eeb941e6d9fb9", "record_id": "article_abebac7eeb941e6d", "canonical_url": "https://yaleclimateconnections.org/2026/03/the-arid-rio-grande-basin-could-become-even-drier", "publisher_url": "https://yaleclimateconnections.org/2026/03/the-arid-rio-grande-basin-could-become-even-drier", "title_original": "The arid Rio Grande basin could become even drier", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-05T12:00:00+00:00", "source_text": "Transcript: The Rio Grande once reliably flowed from the mountains in Colorado across the deserts of New Mexico and Texas to the Gulf. But now, cities and farms siphon off much of that water, and drought has hit the river hard. So at times, stretches of the Rio Grande run dry – harming wildlife and people . Prunes: “In the last 20 years, there has been a loss of farmland in the Rio Grande in Colorado, in New Mexico, in the Pecos River in Texas due to water shortages.", "text_kind": "article_excerpt", "text_characters": 471, "text_sha256": "5c9fff07e91052dd5ad1cd5b63e9a32a0fa12db8ed631fdcdf0ae539027fbc9d", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:25.643485+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 196, "end": 203, "evidence": "exico and Texas to the Gulf. But now, cities and farms siphon off much of that water, and drought has hit the river hard. So at times, stretches of the Rio Grande run dry – harming wildlife and people . Prunes: “In the last 20 years, the"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:25.659551+00:00", "published_at_raw": "2026-03-05T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 101, "end": 111, "matched_text": "New Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_9415df6efec0ae0ab062", "record_id": "article_9415df6efec0ae0a", "canonical_url": "https://insideclimatenews.org/news/04032026/trump-data-center-power-costs-pledge", "publisher_url": "https://insideclimatenews.org/news/04032026/trump-data-center-power-costs-pledge", "title_original": "Big Tech Signs Trump Pledge to Pay Data-Center Power Costs. Fulfilling It Is the Hard Part.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-05T01:01:30+00:00", "source_text": "In an effort to quell blowback on data centers, President Donald Trump announced at a White House roundtable on Wednesday the “Ratepayer Protection Pledge,” a set of nonbinding promises that Big Tech companies signed to keep household utility bills from skyrocketing. “They need some P.R. help,” Trump said of the data centers, “because people think […]", "text_kind": "source_excerpt", "text_characters": 353, "text_sha256": "f63d9788d247a16e71f566eda044c0d8e7b28e845b05a63c03c0d24c381d708a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:34.783412+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts",