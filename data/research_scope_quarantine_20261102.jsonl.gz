{"text_id": "text_2fa9b72072173fc71a76", "record_id": "article_2fa9b72072173fc7", "canonical_url": "https://insideclimatenews.org/news/08102025/los-alamos-university-of-michigan-national-security-data-center", "publisher_url": "https://insideclimatenews.org/news/08102025/los-alamos-university-of-michigan-national-security-data-center", "title_original": "Los Alamos and University of Michigan Want to Build a National Security ‘Data Center’ in Ypsilanti. Residents and Local Officials See Few Benefits.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-08T09:00:00+00:00", "source_text": "First of three articles about Michigan communities organizing to stop the construction of energy-intensive computing facilities. The Huron River winds through parks and wooded areas in eastern Ypsilanti Township where thousands of residents fish, canoe and swim. Now the University of Michigan and Los Alamos National Laboratory want to add a 300,000-square-foot taxpayer-subsidized data center […]", "text_kind": "source_excerpt", "text_characters": 398, "text_sha256": "398573deae4cc16a1e0c08549c6dee63a5bd60fe1b369844bdfd3b3722867410", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:09.766817+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 90, "end": 96, "evidence": "First of three articles about Michigan communities organizing to stop the construction of energy-intensive computing facilities. The Huron River winds through parks and wooded areas in eastern Ypsilanti Township where thousands of resid"}], "policy_tools": [{"id": "subsidy", "label_zh": "补贴与激励", "label_en": "Subsidies and incentives", "start": 372, "end": 378, "evidence": "of Michigan and Los Alamos National Laboratory want to add a 300,000-square-foot taxpayer-subsidized data center […]"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:09.784808+00:00", "published_at_raw": "2025-10-08T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_d4c1f5ab794571fd1a6a", "record_id": "article_d4c1f5ab794571fd", "canonical_url": "https://insideclimatenews.org/news/08102025/arizona-residents-take-on-industrial-developers", "publisher_url": "https://insideclimatenews.org/news/08102025/arizona-residents-take-on-industrial-developers", "title_original": "Arizona Rural Grassroots Organizers Take on Industrial Developers, Aided by Urban Allies", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-08T08:50:00+00:00", "source_text": "On the evening of August 21, 2025, Chris Giokaris hopped on the interstate heading southeast from his hometown of Tucson, Arizona. His destination was Benson, a town of about 5,500 people located 50 miles away. The small town is known as the gateway to the San Pedro Valley, in large part for the San Pedro […]", "text_kind": "source_excerpt", "text_characters": 310, "text_sha256": "79db12b0f8fc18a6e43de6ac89da2694289f98ec99ac28c49c9bcfcc0a327bab", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:09.815466+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at":