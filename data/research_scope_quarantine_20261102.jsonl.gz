{"text_id": "text_94fbe56c217d043d5856", "record_id": "article_94fbe56c217d043d", "canonical_url": "https://insideclimatenews.org/news/19052026/california-sandy-fire-approaches-former-nuclear-reactor-site", "publisher_url": "https://insideclimatenews.org/news/19052026/california-sandy-fire-approaches-former-nuclear-reactor-site", "title_original": "Wildfire Crews Race to Keep Fierce California Blaze From Former Nuclear Reactor Site", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-20T01:10:36+00:00", "source_text": "WEST HILLS, Calif.—Her gray SUV packed and a fire-proof bag ready, Melissa Bumstead didn’t waste any time Monday as plumes of smoke engulfed the sky near her suburb. Most neighbors in West Hills—about 30 miles west of downtown Los Angeles—stayed put after only a voluntary “evacuation warning” was issued for the area. But not her. […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "96fb765612c2113898cfd368e7dd23990acec1cd07b247f18413948903bd7bab", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:40.627333+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:40.641218+00:00", "published_at_raw": "2026-05-20T01:10:36", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 35, "end": 45, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_8667c2367d0001db3848", "record_id": "article_8667c2367d0001db", "canonical_url": "https://insideclimatenews.org/news/19052026/todays-climate-wildfire-california-santa-rosa-island-species-risk", "publisher_url": "https://insideclimatenews.org/news/19052026/todays-climate-wildfire-california-santa-rosa-island-species-risk", "title_original": "Fire in the ‘Galapagos of North America’ Risks Species Found Nowhere Else", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-19T23:58:12+00:00", "source_text": "An unrelenting wildfire has swallowed nearly a third of Santa Rosa Island, a small strip of land off the coast of California that is largely uninhabited by people but abundant with wildlife and plants, including several found nowhere else on Earth. The blaze, which started last Friday, is human-caused but its exact origin is still […]", "text_kind": "source_excerpt", "text_characters": 336, "text_sha256": "eb0d728b8402a6166ebfdaad595f2ddfcc2de3a3cb6f27d3f7d4b696967505aa", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:40.666791+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 15, "end": 23, "evidence": "An unrelenting wildfire has swallowed nearly a third of Santa Rosa Island, a small strip of land off the coast of California that is largely uninhabited by people "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:40.678133+00:00", "published_at_raw": "2026-05-19T23:58:12", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 114, "end": 124, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_3a91a5639d71adbe9867", "record_id": "article_3a91a5639d71adbe", "canonical_url": "https://news.mongabay.com/2026/05/indonesias-nickel-boom-linked-to-rising-illness-and-worker-harm-reports-find", "publisher_url": "https://news.mongabay.com/2026/05/indonesias-nickel-boom-linked-to-rising-illness-and-worker-harm-reports-find", "title_original": "Indonesia’s nickel boom linked to rising illness and worker harm, reports find", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-19T07:47:10+00:00", "source_text": "HALMAHERA, Indonesia — New research examining Indonesia’s vast nickel-processing regions has documented rising rates of ill health and workplace harm linked to a key industry supplying the global energy transition. A report published in April by Indonesia’s human rights commission, known as Komnas HAM, cited Central Sulawesi provincial health data showing respiratory infections reached 305,191 […]", "text_kind": "source_excerpt", "text_characters": 400, "text_sha256": "e187e0749c71fa209ded1e92c689aee1130be452f19bcf87578c43f93f512a1c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:40.141589+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 196, "end": 202, "evidence": "sing rates of ill health and workplace harm linked to a key industry supplying the global energy transition. A report published in April by Indonesia’s human rights commission, known as Komnas HAM, cited Central Sulawesi provincial heal"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:40.171455+00:00", "published_at_raw": "2026-05-19T07:47:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 0, "end": 9, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 11, "end": 20, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_edc5ca831b757b76cf55", "record_id": "article_edc5ca831b757b76", "canonical_url": "https://insideclimatenews.org/news/18052026/nextera-dominion-utility-mega-merger", "publisher_url": "https://insideclimatenews.org/news/18052026/nextera-dominion-utility-mega-merger", "title_original": "A Utility Mega-Merger Is All About Data Centers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-18T23:07:40+00:00", "source_text": "A proposed merger of the largest utility in the country by market value, NextEra Energy, with the sixth-largest, Dominion, would create a megacompany at a time when data centers and rapid increases in electricity demand are reshaping the industry. The proposal, announced Monday morning and contingent on state and federal regulatory approval, would result in […]", "text_kind": "source_excerpt", "text_characters": 363, "text_sha256": "b34eb03eb2cb8c44374de746f845995abbfb51852713392d2acc5e94b7b43bd1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:40.983249+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 81, "end": 87, "evidence": "A proposed merger of the largest utility in the country by market value, NextEra Energy, with the sixth-largest, Dominion, would create a megacompany at a time when data centers and rapid increases in electricity demand are res"}], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 2, "end": 10, "evidence": "A proposed merger of the largest utility in the country by market value, NextEra Energy, with the sixth-largest, Dominion, would create a megacompany "}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:40.995692+00:00", "published_at_raw": "2026-05-18T23:07:40", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_f9c0c3aeacad19649642", "record_id": "article_f9c0c3aeacad1964", "canonical_url": "https://yaleclimateconnections.org/2026/05/seasonal-patterns-that-farmers-trusted-for-generations-have-suddenly-turned-unpredictable", "publisher_url": "https://yaleclimateconnections.org/2026/05/seasonal-patterns-that-farmers-trusted-for-generations-have-suddenly-turned-unpredictable", "title_original": "Seasonal patterns that farmers trusted for generations have suddenly turned unpredictable", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-18T11:00:00+00:00", "source_text": "Farmers in Jambhali, a village of 5,000 in western India, have long turned to 80-year-old Satgonda Patil for advice on when to plant or harvest their crops. For more than six decades, his deep knowledge and uncanny instincts helped him and his neighbors succeed and avoid weather-related losses. That started to change about five years ago. Rains arrived late, then early. Summers stretched on longer, and pests appeared at unfamiliar times. Financial losses soon followed. In October 2025, Patil grew cauliflower on his 1.5-acre field, but he couldn’t harvest the crop. It wilted as a result of a soilborne fungal disease favored by warmer temperatures. A month later, Patil tried growing cabbage, but pests arrived early and spread quickly.", "text_kind": "article_excerpt", "text_characters": 742, "text_sha256": "8fc1309801ddd987bd5f6a766324573f5be318e3c3924bc5a2a62343d259a255", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:02.564320+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 641, "end": 652, "evidence": "t harvest the crop. It wilted as a result of a soilborne fungal disease favored by warmer temperatures. A month later, Patil tried growing cabbage, but pests arrived early and spread quickly."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:02.622205+00:00", "published_at_raw": "2026-05-18T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 51, "end": 56, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_3ea5535ce95d99d36bd3", "record_id": "article_3ea5535ce95d99d3", "canonical_url": "https://yaleclimateconnections.org/2026/05/presentamos-a-una-nueva-meteorologa", "publisher_url": "https://yaleclimateconnections.org/2026/05/presentamos-a-una-nueva-meteorologa", "title_original": "¡Presentamos a una nueva meteoróloga!", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-14T17:23:29+00:00", "source_text": "Con la temporada de huracanes a la vuelta de la esquina, nos complace presentar a una escritora nueva en nuestra cobertura de Eye on the Storm para la temporada 2026. Irene Sans, la nueva meteoróloga de Eye on the Storm, llega desde Florida, donde cuenta con más de una década de experiencia. Irene cubrirá los fenómenos meteorológicos extremos tanto en inglés como en español. Irene es una de las pocas meteorólogas hispanohablantes en los EE. UU. con doble certificación (televisión y medios digitales) otorgada por la Sociedad Meteorológica Americana. Ha trabajado como meteoróloga estatal adjunta para la gestión de emergencias en Florida y ha sido meteoróloga en estaciones de televisión y radio en español e inglés en todo Estados Unidos y América Latina.", "text_kind": "article_excerpt", "text_characters": 761, "text_sha256": "1c1752938fd984ee9a08d69c7bc2c4c99c3cfa971fbce9894e5aff42014e9d70", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:03.122109+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:03.318442+00:00", "published_at_raw": "2026-05-14T17:23:29", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_61efc20b6a9dbda20486", "record_id": "article_61efc20b6a9dbda2", "canonical_url": "https://dialogue.earth/en/ocean/qa-what-a-healthier-ocean-means-to-ghana", "publisher_url": "https://dialogue.earth/en/ocean/qa-what-a-healthier-ocean-means-to-ghana", "title_original": "Q&A: What a healthier ocean means to Ghana", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-14T16:07:33+00:00", "source_text": "Last month Ghana created its first marine protected area (MPA), setting aside parts of the ocean off its coast to safeguard marine life. It covers roughly 700 sq km around the Greater Three Points area – or approximately 0.3% of Ghana’s ocean. The declaration of this MPA comes after years of warnings that Ghana’s fisheries are under huge pressure and need help to recover. The global pledge to protect at least 30% of the world’s lands and oceans by 2030 – the 30×30 goal – contrasts sharply with the scale of Ghana’s first MPA. And while its creation has been hailed by politicians and experts, it nearly did not happen after major cuts to support from the US undermined years of planning.", "text_kind": "article_excerpt", "text_characters": 692, "text_sha256": "ae2f8234a0172846012765c1bd122d94d6be882c935fe9f46f1eb1a09a24abac", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:37.365248+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "0.3%", "start": 221, "end": 225, "evidence": " It covers roughly 700 sq km around the Greater Three Points area – or approximately 0.3% of Ghana’s ocean.", "interpretation": "not_classified"}, {"value_text": "30%", "start": 413, "end": 416, "evidence": " The global pledge to protect at least 30% of the world’s lands and oceans by 2030 – the 30×30 goal – contrasts sharply with the scale of Ghana’s first MPA.", "interpretation": "target_or_commitment"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:37.400145+00:00", "published_at_raw": "2026-05-14T16:07:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana", "start": 37, "end": 42, "matched_text": "Ghana", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana", "start": 11, "end": 16, "matched_text": "Ghana", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 660, "end": 662, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_8dbed76edc872e69efe0", "record_id": "article_8dbed76edc872e69", "canonical_url": "https://news.mongabay.com/2026/05/the-southern-ocean-is-key-to-our-planets-future-we-have-a-chance-to-protect-it-this-year-commentary", "publisher_url": "https://news.mongabay.com/2026/05/the-southern-ocean-is-key-to-our-planets-future-we-have-a-chance-to-protect-it-this-year-commentary", "title_original": "The Southern Ocean is key to our planet’s future & we have a chance to protect it this year (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-13T16:02:33+00:00", "source_text": "One of the most striking images in David Attenborough’s Ocean, his defining 2025 documentary, is of supertrawlers dragging vast krill nets through a pod of feeding humpback whales off Antarctica. For most viewers, it will have been the moment a distant and invisible crisis became viscerally real. But it was also something else: a glimpse […]", "text_kind": "source_excerpt", "text_characters": 343, "text_sha256": "ec76f123dcd22e2a8d4b6c4a3ccfb8a45c4df7093d648e1a6037f493a0380a96", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:51.340113+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AQ", "alpha3": "ATA", "name_zh": "南极洲", "name_en": "Antarctica"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "AQ", "alpha3": "ATA", "name_zh": "南极洲", "name_en": "Antarctica"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:51.363598+00:00", "published_at_raw": "2026-05-13T16:02:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "AQ", "alpha3": "ATA", "name_zh": "南极洲", "name_en": "Antarctica", "start": 184, "end": 194, "matched_text": "Antarctica", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_1981c06d16dbfd0dd7ec", "record_id": "article_1981c06d16dbfd0d", "canonical_url": "https://news.mongabay.com/2026/05/how-grape-farmers-are-restoring-armenias-wine-heritage-while-safeguarding-ecosystems", "publisher_url": "https://news.mongabay.com/2026/05/how-grape-farmers-are-restoring-armenias-wine-heritage-while-safeguarding-ecosystems", "title_original": "How grape farmers are restoring Armenia’s wine heritage while safeguarding ecosystems", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-12T20:29:33+00:00", "source_text": "AGHAVNADZOR, Armenia — It’s 6 a.m. as the rising sun illuminates apricot-colored cliffs in central Armenia. It’s so still that even the distant buzz of a bee can be heard. Coca-Cola bottles filled with homemade wine for sale line the narrow road leading to acres of grapes growing quietly in an unusual vineyard. At 1,300 […]", "text_kind": "source_excerpt", "text_characters": 325, "text_sha256": "2c6f65228acd180eba66d86256cff8baf832831455c4f9dd61e06c2747c8dcec", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:51.498979+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AM", "alpha3": "ARM", "name_zh": "亚美尼亚", "name_en": "Armenia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "AM", "alpha3": "ARM", "name_zh": "亚美尼亚", "name_en": "Armenia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:51.517916+00:00", "published_at_raw": "2026-05-12T20:29:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "AM", "alpha3": "ARM", "name_zh": "亚美尼亚", "name_en": "Armenia", "start": 32, "end": 39, "matched_text": "Armenia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "AM", "alpha3": "ARM", "name_zh": "亚美尼亚", "name_en": "Armenia", "start": 13, "end": 20, "matched_text": "Armenia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_464c6eef14a8fc5f9d48", "record_id": "article_464c6eef14a8fc5f", "canonical_url": "https://dialogue.earth/en/energy/after-a-uk-knock-back-chinas-wind-power-companies-fight-on-in-europe", "publisher_url": "https://dialogue.earth/en/energy/after-a-uk-knock-back-chinas-wind-power-companies-fight-on-in-europe", "title_original": "After a UK knock-back, China’s wind power companies fight on in Europe", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-12T17:00:39+00:00", "source_text": "After being shut out of a German project, Chinese wind power company Mingyang Smart Energy had been looking to the UK as an entry point to European markets, as Dialogue Earth reported in March. Mingyang was planning to build a USD 2 billion wind power factory at a Scottish port, which would have been the UK’s largest such facility. But the UK government vetoed the project, citing security concerns. The same day, 25 March, Danish firm Vestas announced plans for an over EUR 250 million (USD 300 million) factory building nacelles for wind turbines in Scotland, as long as it secures enough UK orders. Elena Kiryakova, an economist with ODI Global, a think-tank headquartered in London, told Dialogue Earth: “There’s a clear contrast between the two decisions.", "text_kind": "article_excerpt", "text_characters": 762, "text_sha256": "2a5ab9cd35617b938e41964de5e15998954d5cc2a6e3052c10d256c74d61786a", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:37.465298+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "2 billion", "start": 231, "end": 240, "evidence": " Mingyang was planning to build a USD 2 billion wind power factory at a Scottish port, which would have been the UK’s largest such facility.", "interpretation": "not_classified"}, {"value_text": "250 million", "start": 477, "end": 488, "evidence": " The same day, 25 March, Danish firm Vestas announced plans for an over EUR 250 million (USD 300 million) factory building nacelles for wind turbines in Scotland, as long as it secures enough UK orders.", "interpretation": "not_classified"}, {"value_text": "300 million", "start": 494, "end": 505, "evidence": " The same day, 25 March, Danish firm Vestas announced plans for an over EUR 250 million (USD 300 million) factory building nacelles for wind turbines in Scotland, as long as it secures enough UK orders.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 50, "end": 60, "evidence": "After being shut out of a German project, Chinese wind power company Mingyang Smart Energy had been looking to the UK as an entry point to European markets, as Dialogue Earth reported in March. Mingya"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:37.521803+00:00", "published_at_raw": "2026-05-12T17:00:39", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 8, "end": 10, "matched_text": "UK", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 23, "end": 28, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 42, "end": 49, "matched_text": "Chinese", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 115, "end": 117, "matched_text": "UK", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_45754c68c38df080c9b0", "record_id": "article_45754c68c38df080", "canonical_url": "https://yaleclimateconnections.org/2026/05/fuel-shortages-and-high-prices-push-adoption-of-evs-in-africa-led-by-ethiopia", "publisher_url": "https://yaleclimateconnections.org/2026/05/fuel-shortages-and-high-prices-push-adoption-of-evs-in-africa-led-by-ethiopia", "title_original": "Fuel shortages and high prices push adoption of EVs in Africa, led by Ethiopia", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-12T11:00:00+00:00", "source_text": "Nairobi, KENYA (AP) — Use of electric vehicles in Africa is surging, led by Ethiopia, as soaring prices and fuel shortages compel countries to opt for cleaner and cheaper transport. Africa imported 44,358 electric vehicles from China in 2025 , according to data from China’s Commerce Ministry, up from 19,386 in 2024. The shipments, valued at over $200 million, highlight growing demand, especially in Ethiopia after it banned new imports of gas and diesel-powered vehicles in 2024. More than 115,000 EVs are now on Ethiopia’s roads, accounting for about 8% of the national fleet. In 2025, it imported a third of Africa’s imports from China , ahead of other major markets in South Africa, Egypt, Morocco, and Nigeria.", "text_kind": "article_excerpt", "text_characters": 717, "text_sha256": "8c12e6c343c5d2ea0132d9c4da911f8cb538302952f9a0f4230eb319a1b9bcce", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:09.552348+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$200 million", "start": 348, "end": 360, "evidence": " The shipments, valued at over $200 million, highlight growing demand, especially in Ethiopia after it banned new imports of gas and diesel-powered vehicles in 2024.", "interpretation": "not_classified"}, {"value_text": "8%", "start": 555, "end": 557, "evidence": " More than 115,000 EVs are now on Ethiopia’s roads, accounting for about 8% of the national fleet.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NG", "alpha3": "NGA", "name_zh": "尼日利亚", "name_en": "Nigeria"}, {"alpha2": "MA", "alpha3": "MAR", "name_zh": "摩洛哥", "name_en": "Morocco"}, {"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}, {"alpha2": "EG", "alpha3": "EGY", "name_zh": "埃及", "name_en": "Egypt"}, {"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NG", "alpha3": "NGA", "name_zh": "尼日利亚", "name_en": "Nigeria"}, {"alpha2": "MA", "alpha3": "MAR", "name_zh": "摩洛哥", "name_en": "Morocco"}, {"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}, {"alpha2": "EG", "alpha3": "EGY", "name_zh": "埃及", "name_en": "Egypt"}, {"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:09.574351+00:00", "published_at_raw": "2026-05-12T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia", "start": 70, "end": 78, "matched_text": "Ethiopia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 9, "end": 14, "matched_text": "KENYA", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia", "start": 76, "end": 84, "matched_text": "Ethiopia", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 228, "end": 233, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa", "start": 675, "end": 687, "matched_text": "South Africa", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "EG", "alpha3": "EGY", "name_zh": "埃及", "name_en": "Egypt", "start": 689, "end": 694, "matched_text": "Egypt", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "MA", "alpha3": "MAR", "name_zh": "摩洛哥", "name_en": "Morocco", "start": 696, "end": 703, "matched_text": "Morocco", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "NG", "alpha3": "NGA", "name_zh": "尼日利亚", "name_en": "Nigeria", "start": 709, "end": 716, "matched_text": "Nigeria", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_836bd848c99b658d2e83", "record_id": "article_836bd848c99b658d", "canonical_url": "https://insideclimatenews.org/news/09052026/los-angeles-smog-history", "publisher_url": "https://insideclimatenews.org/news/09052026/los-angeles-smog-history", "title_original": "Smog, Lies and Pineapples: How LA Cleaned up Its Air and What’s Left to Do", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-09T08:55:00+00:00", "source_text": "As a child growing up in Southern California, Ann Carlson remembers mountains obscured by haze and yellowish brown air that stung her eyes and made her lungs ache. It was just “the environment,” her stepfather said of the smog many years later. It would be decades before Carlson learned the complicated causes of the noxious […]", "text_kind": "source_excerpt", "text_characters": 329, "text_sha256": "b12b112891f17a89d78d13a68bee886843d6b073ab2f0e25ff8f7acaf3c262fb", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:47.904030+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:47.921616+00:00", "published_at_raw": "2026-05-09T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 34, "end": 44, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_594776962e610989388c", "record_id": "article_594776962e610989", "canonical_url": "https://news.mongabay.com/2026/05/indonesia-should-avoid-controversial-programs-to-fund-conservation-commentary", "publisher_url": "https://news.mongabay.com/2026/05/indonesia-should-avoid-controversial-programs-to-fund-conservation-commentary", "title_original": "Indonesia should avoid controversial programs to fund conservation (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-08T17:57:48+00:00", "source_text": "Protecting nature is still a struggle due to funding gaps that governments across developing countries are struggling to close. Indonesia is no exception. For instance, its national parks are chronically underfunded, receiving only about $5 per hectare ($2 per acre) per year, far below the estimated needs of around $18/hectare ($7.30/acre) per year. This long-standing […]", "text_kind": "source_excerpt", "text_characters": 374, "text_sha256": "3589cc492b620707c02e0454cb7e45b8ca4f933d4d888f2eaf5cdcca7a036b93", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:51.961558+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 45, "end": 52, "evidence": "Protecting nature is still a struggle due to funding gaps that governments across developing countries are struggling to close. Indonesia is no exception. For instance, its national parks are "}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:51.982117+00:00", "published_at_raw": "2026-05-08T17:57:48", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 0, "end": 9, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 128, "end": 137, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_9f5b3beb65b608521751", "record_id": "article_9f5b3beb65b60852", "canonical_url": "https://dialogue.earth/en/climate/democracy-meets-extreme-heat-the-end-of-summer-elections", "publisher_url": "https://dialogue.earth/en/climate/democracy-meets-extreme-heat-the-end-of-summer-elections", "title_original": "Democracy meets extreme heat: The end of summer elections?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-08T01:00:00+00:00", "source_text": "T D Achuthan went to vote at a school at 11am late last month. The 29-year-old resident of Chennai in Tamil Nadu was hoping to avoid long queues that typically form at polling sites later in the day, and the exposure to heat that comes with them. When he arrived, there were at least 60 people in line, only a third of whom could fit into the shaded corridor. “The rest of us were in an open ground without tree cover and it was a gruelling experience,” says Achuthan. Editor’s note Part 1 of this series on heat and democracy looked at the dangers of campaigning for votes when temperatures soar , while many say India is in denial about the problem. Here in Part 2, we examine what happens on polling day itself.", "text_kind": "article_excerpt", "text_characters": 714, "text_sha256": "f5415588fc263a991fea29b984fd0587ff38a0f10e972e1977bda0ccbd6013cc", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:42.912262+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 579, "end": 590, "evidence": " of this series on heat and democracy looked at the dangers of campaigning for votes when temperatures soar , while many say India is in denial about the problem. Here in Part 2, we examine what happens on polling day itself."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:42.929599+00:00", "published_at_raw": "2026-05-08T01:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 614, "end": 619, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_41378535c3d2d6ab158e", "record_id": "article_41378535c3d2d6ab", "canonical_url": "https://www.carbonbrief.org/analysis-wind-and-solar-have-saved-uk-from-gas-imports-worth-1-7bn-since-iran-war-began", "publisher_url": "https://www.carbonbrief.org/analysis-wind-and-solar-have-saved-uk-from-gas-imports-worth-1-7bn-since-iran-war-began", "title_original": "Analysis: Wind and solar have saved UK from gas imports worth £1.7bn since Iran war began", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-07T13:02:57+00:00", "source_text": "The UK has avoided the need for gas imports worth £1.7bn since the start of the Iran war, as a result of record electricity generation from wind and solar, reveals Carbon Brief analysis. The surge in wind and solar output is cutting the need for gas-fired generation, which has been nearly a third lower than last year and fell to record lows in both March and April 2026. The figure below shows that wind and solar have generated a record 21 terawatt hours (TWh) on the island of Great Britain since the end of February 2026, when the US and Israel first attacked Iran. Amid another fossil-fuel price crisis, the record wind and solar output since the start of the Iran war avoided the need to import 41TWh of gas – roughly 34 tankers of liquified natural gas (LNG).", "text_kind": "article_excerpt", "text_characters": 767, "text_sha256": "f847c8bfdcc5d409fa8d0e2f047d9c85a6cb2bfd7890f7dd98272342abdaee25", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:39.119956+00:00", "extractor_version": "1.0.0", "document_type": "commentary_or_analysis", "document_type_basis": "explicit_title_prefix", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}, {"alpha2": "IL", "alpha3": "ISR", "name_zh": "以色列", "name_en": "Israel"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 149, "end": 154, "evidence": "nce the start of the Iran war, as a result of record electricity generation from wind and solar, reveals Carbon Brief analysis. The surge in wind and solar output is cutting the need for gas-fired generation, which has been nearly a th"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}, {"alpha2": "IL", "alpha3": "ISR", "name_zh": "以色列", "name_en": "Israel"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:39.138740+00:00", "published_at_raw": "2026-05-07T13:02:57", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 36, "end": 38, "matched_text": "UK", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran", "start": 75, "end": 79, "matched_text": "Iran", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 4, "end": 6, "matched_text": "UK", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran", "start": 80, "end": 84, "matched_text": "Iran", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 536, "end": 538, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "IL", "alpha3": "ISR", "name_zh": "以色列", "name_en": "Israel", "start": 543, "end": 549, "matched_text": "Israel", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_3161e3ed15d15fdb50e3", "record_id": "article_3161e3ed15d15fdb", "canonical_url": "https://news.mongabay.com/2026/05/cerrados-hidden-carbon-highlights-gaps-in-brazils-conservation-policy", "publisher_url": "https://news.mongabay.com/2026/05/cerrados-hidden-carbon-highlights-gaps-in-brazils-conservation-policy", "title_original": "Cerrado’s hidden carbon highlights gaps in Brazil’s conservation policy", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-07T09:47:40+00:00", "source_text": "Fieldwork in the wet grasslands of the Brazilian Cerrado often means long trudges through head-high reeds, following tapir trails and watching for tick nests or boggy pitfalls. All this is made more difficult when your equipment is not waterproof. So in February 2024, when a thunderstorm broke over Chapada dos Veadeiros, a national park in […]", "text_kind": "source_excerpt", "text_characters": 345, "text_sha256": "657b04c7b62effa64b8852515263a930d6993a859e6fe177a78cee8d89bef970", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:01.118613+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:01.146430+00:00", "published_at_raw": "2026-05-07T09:47:40", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 43, "end": 49, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_bba073935b3290447874", "record_id": "article_bba073935b329044", "canonical_url": "https://insideclimatenews.org/news/05052026/california-battery-power", "publisher_url": "https://insideclimatenews.org/news/05052026/california-battery-power", "title_original": "California’s Battery Array Is as Powerful as 12 Nuclear Power Plants. Here’s What’s on the Horizon.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-05T09:00:00+00:00", "source_text": "SAN FRANCISCO—As families settled into their evening routines in late March, cooking dinner on electric stoves and flipping on their TV for the newest binge watch, the state’s energy grid was working hard. For the first time, California discharged just over 12,000 megawatts, equivalent to 12 large nuclear plants, of energy from its battery arrays. […]", "text_kind": "source_excerpt", "text_characters": 353, "text_sha256": "a3d26bd21c9afcbd9b5d05960632933835ad4a5256c527a59c0ac11dfc499ef0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:48.205840+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 176, "end": 182, "evidence": "inner on electric stoves and flipping on their TV for the newest binge watch, the state’s energy grid was working hard. For the first time, California discharged just over 12,000 megawatts, equivalent to 12 large nuclear plants, of ener"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:48.234062+00:00", "published_at_raw": "2026-05-05T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 10, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 226, "end": 236, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_99874fcf910b3f303004", "record_id": "article_99874fcf910b3f30", "canonical_url": "https://yaleclimateconnections.org/2026/05/dangerous-heavy-rains-are-getting-more-likely-and-widespread", "publisher_url": "https://yaleclimateconnections.org/2026/05/dangerous-heavy-rains-are-getting-more-likely-and-widespread", "title_original": "Dangerous heavy rains are getting more likely and widespread", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-04T11:00:00+00:00", "source_text": "Among the most dangerous extreme weather disasters are thunderstorms and tropical storms, which dump massive amounts of rain over a large geographic area, as opposed to rainfall that’s widespread yet light, or that’s intense yet localized. Over the past 77 years, the top 11 such extreme events in the contiguous U.S. have all done at least $2 billion in damage, with the top one – Category 4 Hurricane Harvey of 2017, which delivered nearly 25 inches of rain over an area of 50,000 square kilometers over Texas – ranking as the second-costliest weather disaster in world history. Most of Harvey’s $165 billion price tag (2026 USD) resulted from its extreme rains. Remarkably, six of the top 10 highest-volume U.S.", "text_kind": "article_excerpt", "text_characters": 714, "text_sha256": "08bb8b88f553a9eaa9f629cd664493bb531932f82b346adf2dca709dcbc32cfd", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:10.155643+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$2 billion", "start": 341, "end": 351, "evidence": " have all done at least $2 billion in damage, with the top one – Category 4 Hurricane Harvey of 2017, which delivered nearly 25 inches of rain over an area of 50,000 square kilometers over Texas – ranking as the second-costliest weather disaster in world history.", "interpretation": "not_classified"}, {"value_text": "$165 billion", "start": 598, "end": 610, "evidence": " Most of Harvey’s $165 billion price tag (2026 USD) resulted from its extreme rains.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:10.219203+00:00", "published_at_raw": "2026-05-04T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 313, "end": 317, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_a8571856883f00408e9b", "record_id": "article_a8571856883f0040", "canonical_url": "https://insideclimatenews.org/news/02052026/how-oil-fuels-war", "publisher_url": "https://insideclimatenews.org/news/02052026/how-oil-fuels-war", "title_original": "How Oil Fuels Conflict and War—and Who Profits", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-02T08:50:00+00:00", "source_text": "From our collaborating partner “Living on Earth,” public radio’s environmental news magazine, an interview by host Steve Curwood with Michael Klare, an emeritus professor of peace and security studies at Hampshire College. The U.S.-Israel joint war against Iran has shaken global energy markets, closed the Strait of Hormuz and restricted the flow of oil and […]", "text_kind": "source_excerpt", "text_characters": 362, "text_sha256": "22a4317af472ea9283489cbee800aecc462c0409a503cd28fdd0d1b7b55010b3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:48.995225+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}, {"alpha2": "IL", "alpha3": "ISR", "name_zh": "以色列", "name_en": "Israel"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 280, "end": 286, "evidence": "ty studie