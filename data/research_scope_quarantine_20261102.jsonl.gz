{"text_id": "text_2fa7da84443af402432b", "record_id": "article_2fa7da84443af402", "canonical_url": "https://news.mongabay.com/2025/02/ai-can-already-identify-species-in-photos-can-it-extract-even-more-data", "publisher_url": "https://news.mongabay.com/2025/02/ai-can-already-identify-species-in-photos-can-it-extract-even-more-data", "title_original": "AI can already identify species in photos. Can it extract even more data?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-05T13:37:40+00:00", "source_text": "How do you identify an animal in a photo? These days, a host of AI-driven apps are available that make this an easy task. But what if you have more questions? Is the animal looking healthy? Are its surroundings polluted? Does it look stressed because of the heat? Getting these answers would be key to […]", "text_kind": "source_excerpt", "text_characters": 305, "text_sha256": "30643e40048918c15fab0557570c85ae842f45067107343b13f074074be8f450", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:12.562419+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-