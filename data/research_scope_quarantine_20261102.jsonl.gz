{"text_id": "text_799a660719572aff69ce", "record_id": "article_799a660719572aff", "canonical_url": "https://insideclimatenews.org/news/24102025/trump-energy-department-data-center-grid-connections", "publisher_url": "https://insideclimatenews.org/news/24102025/trump-energy-department-data-center-grid-connections", "title_original": "Trump Administration Seeks to Speed Data Center Grid Connections and Expand Federal Control of Power System", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-24T20:44:56+00:00", "source_text": "A proposed rule from the Department of Energy would expand federal control over how large electricity users connect to the grid, with the goal of accelerating the construction of data centers and the power plants that serve them. The rule, announced Thursday night by Energy Secretary Chris Wright, asserts the federal government’s authority over matters […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "4f9eb8d15567a663a1a9f49148255b4c66c52154950ac1d85d4ad3271ec258f3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:02.291112+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 39, "end": 45, "evidence": "A proposed rule from the Department of Energy would expand federal control over how large electricity users