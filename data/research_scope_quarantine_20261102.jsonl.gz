{"text_id": "text_5f03d17c9f923651cf36", "record_id": "article_5f03d17c9f923651", "canonical_url": "https://insideclimatenews.org/news/20122023/dereliction-of-beauty-warning-black-women-about-dangerous-products", "publisher_url": "https://insideclimatenews.org/news/20122023/dereliction-of-beauty-warning-black-women-about-dangerous-products", "title_original": "For One Environmentalist, Warning Black Women About Dangerous Beauty Products Allows Them to Own Their Health", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-20T18:00:00+00:00", "source_text": "Dereliction of Beauty: Third in a series on how lax regulation of beauty care products victimizes women of color. When Heather McTeer Toney thinks about the disproportionate harms that she and many other Black women have suffered from toxic substances, some of her most enduring memories take her back decades to the process of straightening […]", "text_kind": "source_excerpt", "text_characters": 345, "text_sha256": "a1fe800aafda0c61ccc13f02ee31b7bdc4520c1dc408da298c2c660e469f68d4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:54.487402+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "standards", "label_zh": "标准与监管", "label_en": "Standards and regulation", "start": 52, "end": 62, "evidence": "Dereliction of Beauty: Third in a series on how lax regulation of beauty care products victimizes women of color. When Heather McTeer Toney thinks about the disproportionate harms that she and many othe"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:54.500356+00:00", "published_at_raw": "2023-12-20T18:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578434+00:00"}
{"text_id": "text_8ed4709d353fec465ed4", "record_id": "article_8ed4709d353fec46", "canonical_url": "https://dialogue.earth/en/water/new-research-raises-fresh-doubts-about-indias-river-linking-plans", "publisher_url": "https://dialogue.earth/en/water/new-research-raises-fresh-doubts-about-indias-river-linking-plans", "title_original": "New research raises fresh doubts about India’s river linking plans", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-19T17:12:08+00:00", "source_text": "A long-standing plan to shift water between rivers in north-central India powers on, despite new science that casts doubt on its efficacy, and concerns over major ecological impacts", "text_kind": "source_excerpt", "text_characters": 181, "text_sha256": "ccad1ebb6e07b70d332761cba6df2c3df37090babcd2de652efece6d5f8e2580", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:47.081450+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:47.091611+00:00", "published_at_raw": "2023-12-19T17:12:08", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 39, "end": 44, "matched_text": "India", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 68, "end": 73, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578434+00:00"}
{"text_id": "text_c4107221370d6e2b5720", "record_id": "article_c4107221370d6e2b", "canonical_url": "https://insideclimatenews.org/news/15122023/todays-climate-white-house-tribes-settlement-study-dam-removal-fish-restoration", "publisher_url": "https://insideclimatenews.org/news/15122023/todays-climate-white-house-tribes-settlement-study-dam-removal-fish-restoration", "title_original": "White House Announces Historic Agreement to Study Dam Removal and Fund Fish Restoration", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-15T18:51:52+00:00", "source_text": "The White House says it has reached a settlement in a longstanding legal battle with Native American tribes and conservation groups regarding 14 dams on the Columbia River basin. The historic agreement, which includes provisions geared toward the eventual removal of four of those dams, could end one of the nation’s most high-profile disputes over […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "59de03392d20b508d132296c76cea5d13a077d8bf2db5f36311bb166875ff6f8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:54.787185+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:54.798501+00:00", "published_at_raw": "2023-12-15T18:51:52", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578434+00:00"}
{"text_id": "text_9ba1b66ca4c5a0504723", "record_id": "article_9ba1b66ca4c5a050", "canonical_url": "https://yaleclimateconnections.org/2023/12/polar-bear-911-how-a-canadian-town-deals-with-its-hungry-bear-population", "publisher_url": "https://yaleclimateconnections.org/2023/12/polar-bear-911-how-a-canadian-town-deals-with-its-hungry-bear-population", "title_original": "‘Polar bear 911’: How a Canadian town deals with its hungry bear population", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-15T12:00:00+00:00", "source_text": "Every fall, as ice forms on Canada’s Hudson Bay, polar bears that have spent the summer on land head out onto the frozen bay to feed on seals. On their way, the bears often wander through the coastal town of Churchill, Manitoba. Maclean: “In the same way down south you can look out the window and you can see a white-tailed deer … up in Churchill you could look out the window and see an 800-pound apex predator.” Chantal Maclean is a Manitoba Conservation Officer with the Polar Bear Alert Program , which works to prevent human-bear conflicts in Churchill. Maclean: “We essentially have a polar bear 911.” When a polar bear shows up in town, their team rushes to the scene in less than two minutes and tries to scare the bear away.", "text_kind": "article_excerpt", "text_characters": 734, "text_sha256": "12a7673a461a46d54c6950b3442357ddf75d1e604aff61da3e66791a7f6af37f", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:49.886801+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:49.908409+00:00", "published_at_raw": "2023-12-15T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada", "start": 28, "end": 34, "matched_text": "Canada", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578434+00:00"}
{"text_id": "text_e35973ad489ae2271367", "record_id": "article_e35973ad489ae227", "canonical_url": "https://yaleclimateconnections.org/2023/12/lider-jesuita-venezolano-destaca-el-papel-de-la-comunidad-catolica-en-la-sostenibilidad-ambiental", "publisher_url": "https://yaleclimateconnections.org/2023/12/lider-jesuita-venezolano-destaca-el-papel-de-la-comunidad-catolica-en-la-sostenibilidad-ambiental", "title_original": "Líder jesuita venezolano destaca el papel de la comunidad católica en la sostenibilidad ambiental", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-13T18:33:10+00:00", "source_text": "En un país que tiene las mayores reservas de petróleo del mundo, el Padre Arturo Peraza lidera iniciativas como crear una cátedra de sustentabilidad hasta prácticas de reciclaje.", "text_kind": "source_excerpt", "text_characters": 178, "text_sha256": "0efa40060004418beead7678d96ce3aebd665b43fa16af0d688165ac7e1ed5fb", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:49.969324+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:49.982373+00:00", "published_at_raw": "2023-12-13T18:33:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578434+00:00"}
{"text_id": "text_cfdc7133f303917f372c", "record_id": "article_cfdc7133f303917f", "canonical_url": "https://yaleclimateconnections.org/2023/12/as-temperatures-rise-so-do-georgia-er-visits-for-venomous-snake-bites", "publisher_url": "https://yaleclimateconnections.org/2023/12/as-temperatures-rise-so-do-georgia-er-visits-for-venomous-snake-bites", "title_original": "As temperatures rise, so do Georgia ER visits for venomous snake bites", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-13T12:00:00+00:00", "source_text": "On a warm day, lots of people head outdoors to hike and enjoy nature. And they’re not the only ones taking advantage of the weather. Scovronick: “Snakes are coldblooded, which means their body temperatures and their behaviors are influenced by the ambient temperature. So the outdoor temperature influences how active they are.” Noah Scovronick was part of a team at Emory University that wanted to learn how changes in temperature affect the prevalence of snake bites in Georgia. The state is home to dozens of snake species, including seven that are venomous. The team pulled data on emergency department visits for snakebites over a seven-year period.", "text_kind": "article_excerpt", "text_characters": 654, "text_sha256": "ebbf0b0462a21e651e70c9d78d1ef072a2682eefcee389dba40854efcda86f44", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:50.068317+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 193, "end": 204, "evidence": "ing advantage of the weather. Scovronick: “Snakes are coldblooded, which means their body temperatures and their behaviors are influenced by the ambient temperature. So the outdoor temperature influences how active they are.” Noah Scovronick"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:50.085953+00:00", "published_at_raw": "2023-12-13T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578434+00:00"}
{"text_id": "text_cd37ec61c71faf6a1f45", "record_id": "article_cd37ec61c71faf6a", "canonical_url": "https://news.mongabay.com/2023/12/a-lithium-goldmine-is-buried-under-one-of-europes-last-heritage-farming-systems", "publisher_url": "https://news.mongabay.com/2023/12/a-lithium-goldmine-is-buried-under-one-of-europes-last-heritage-farming-systems", "title_original": "A lithium ‘gold mine’ is buried under one of Europe’s last heritage farming systems", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-11T20:06:11+00:00", "source_text": "COVAS DO BARROSO, Portugal — In the hills of Barroso high in northeastern Portugal, the water gushes down small channels built many centuries ago, winding through a mosaic of pastures, oak and pine forests, and arable and fallow land. Sitting on her porch overlooking a carefully kept garden full of flowers and vegetables, Aida Fernandes […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "758446455ba663983998f92a7b47be4d45e19c20deeb6089aa023aa77a802eb8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:48.492165+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PT", "alpha3": "PRT", "name_zh": "葡萄牙", "name_en": "Portugal"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PT", "alpha3": "PRT", "name_zh": "葡萄牙", "name_en": "Portugal"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:48.506533+00:00", "published_at_raw": "2023-12-11T20:06:11", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PT", "alpha3": "PRT", "name_zh": "葡萄牙", "name_en": "Portugal", "start": 18, "end": 26, "matched_text": "Portugal", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578434+00:00"}
{"text_id": "text_eed6223509a03d377795", "record_id": "article_eed6223509a03d37", "canonical_url": "https://news.mongabay.com/2023/12/deforestation-falls-for-8th-straight-month-in-the-amazon-rainforest-but-rises-in-the-cerrado", "publisher_url": "https://news.mongabay.com/2023/12/deforestation-falls-for-8th-straight-month-in-the-amazon-rainforest-but-rises-in-the-cerrado", "title_original": "Deforestation falls for 8th straight month in the Amazon rainforest, but rises in the cerrado", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-08T22:07:37+00:00", "source_text": "Deforestation in the Brazilian Amazon has decreased for the eighth consecutive month, despite the region being affected by a severe drought. According to the latest data from Brazil’s National Space Research Institute (INPE), forest clearing in November totaled 201 square kilometers. This brings the cumulative loss for the past twelve months in Earth’s largest rainforest […]", "text_kind": "source_excerpt", "text_characters": 377, "text_sha256": "130f2513a75c84f3ac58da52fd7e3c9b0b11aaa9501ce9e81b4a05cbc40aa86f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:48.623414+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 132, "end": 139, "evidence": "decreased for the eighth consecutive month, despite the region being affected by a severe drought. According to the latest data from Brazil’s National Space Research Institute (INPE), forest clearing in November totaled 201 square kilome"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:48.640005+00:00", "published_at_raw": "2023-12-08T22:07:37", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 175, "end": 181, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578434+00:00"}
{"text_id": "text_7f588de8d4fd78720e7c", "record_id": "article_7f588de8d4fd7872", "canonical_url": "https://yaleclimateconnections.org/2023/12/the-key-point-that-cop28-is-ignoring", "publisher_url": "https://yaleclimateconnections.org/2023/12/the-key-point-that-cop28-is-ignoring", "title_original": "The key point that COP28 is ignoring", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-07T12:00:00+00:00", "source_text": "I had to flee from the Camp Pendleton fire while recovering from my second open-heart surgery, still bandaged, unable to drive, and only able to escape due to the kindness of a neighbor. The day I flew from California for the last time, I was suffering from breathing difficulties as a result of yet another wildfire, where even closed windows couldn’t keep out the soot and lingering smell of smoke from the indoor air. And as a caregiver for a blind parent with mobility difficulties, I’ve experienced having to decide between staying in a house without electricity during a multiday power outage and evacuating to a hotel that doesn’t have enough rooms accessible to people with disabilities or an evacuation chair or other equipment to help someone get to the lobby when the hotel loses power.", "text_kind": "article_excerpt", "text_characters": 797, "text_sha256": "aca88fe4eab2f976a589da5e696b65cc8cf83f6851e667d284d2b15a191a4df9", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:50.235101+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 308, "end": 316, "evidence": "for the last time, I was suffering from breathing difficulties as a result of yet another wildfire, where even closed windows couldn’t keep out the soot and lingering smell of smoke from the indoor air. And as a caregiver for a blind pare"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:50.252520+00:00", "published_at_raw": "2023-12-07T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 207, "end": 217, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578434+00:00"}
{"text_id": "text_f514a92338453bdae438", "record_id": "article_f514a92338453bda", "canonical_url": "https://insideclimatenews.org/news/06122023/cop28-growing-alarm-air-pollution-harms", "publisher_url": "https://insideclimatenews.org/news/06122023/cop28-growing-alarm-air-pollution-harms", "title_original": "At COP28, a Growing Sense of Alarm Over the Harms of Air Pollution", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-06T19:30:00+00:00", "source_text": "In one home video, Ella Adoo-Kissi-Debrah bops to a choreographed Beyoncé dance. In another, she looks at the camera, and her mom and plants a big kiss on her lips. Then there is a photo of her mid-laugh when she told her mom she could not climb any more steps at a monument. And in […]", "text_kind": "source_excerpt", "text_characters": 286, "text_sha256": "9208b59022cfe2827c439877f257b8d0ab9ca928692fffb2f645627551c3aeda", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:55.683304+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:55.696645+00:00", "published_at_raw": "2023-12-06T19:30:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578973+00:00"}
{"text_id": "text_218fbe78b90481476730", "record_id": "article_218fbe78b9048147", "canonical_url": "https://yaleclimateconnections.org/2023/12/more-than-a-dozen-illinois-schools-add-evs-to-drivers-ed", "publisher_url": "https://yaleclimateconnections.org/2023/12/more-than-a-dozen-illinois-schools-add-evs-to-drivers-ed", "title_original": "More than a dozen Illinois schools add EVs to driver’s ed", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-04T12:00:00+00:00", "source_text": "Teenagers at some Illinois high schools are now taking driver’s education classes in electric cars. Mitchell: “EVs are the future. I mean, it’s something we can get these kids ready to use.” Gregg Mitchell is the driver’s ed director at Lane Tech College Prep, a public high school in Chicago. The school recently added an EV to its fleet of cars, using a grant from ComEd , the local electric utility. The utility’s EVs for Education program has allowed more than a dozen schools to buy electric cars and chargers for their driver’s ed programs over the past few years. Mitchell says driving an electric car is not that different than driving a gas-powered car, so the students generally learn the same basic skills. But the electric cars do save him time on maintenance.", "text_kind": "article_excerpt", "text_characters": 772, "text_sha256": "d41c6f101dca640c1a529d6e2a9bed92642bf7dbf04db11b3bc14519724f7e27", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:50.440435+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 356, "end": 361, "evidence": "lic high school in Chicago. The school recently added an EV to its fleet of cars, using a grant from ComEd , the local electric utility. The utility’s EVs for Education program has allowed more than a dozen schools to buy electric cars"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:50.460209+00:00", "published_at_raw": "2023-12-04T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578973+00:00"}
{"text_id": "text_c9f759293446dc1a4745", "record_id": "article_c9f759293446dc1a", "canonical_url": "https://yaleclimateconnections.org/2023/11/why-one-researcher-is-flying-less", "publisher_url": "https://yaleclimateconnections.org/2023/11/why-one-researcher-is-flying-less", "title_original": "Why one researcher is flying less", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-11-24T12:00:00+00:00", "source_text": "As a linguistics researcher, Ian Joo of South Korea is often asked to travel for research and conferences. But when he learned that taking one flight could cause more carbon pollution than the average citizen of Uganda emits in a year, he was appalled. Joo: “That was a big shock for me.” He decided to reduce his air travel. While he was a visiting researcher in the Netherlands, he attended four conferences. Joo: “For all those conferences, I took the train.” But he says sometimes flying is the only option and travel is critical for his research — for example when he must go where a specific language is spoken. In those situations, he looks for a direct flight.", "text_kind": "article_excerpt", "text_characters": 668, "text_sha256": "f33ed63888b4bfda597f7120eb039db2d0b2ee338634721412b01b9b7b968ad0", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:50.810790+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NL", "alpha3": "NLD", "name_zh": "荷兰", "name_en": "Netherlands"}, {"alpha2": "UG", "alpha3": "UGA", "name_zh": "乌干达", "name_en": "Uganda"}, {"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NL", "alpha3": "NLD", "name_zh": "荷兰", "name_en": "Netherlands"}, {"alpha2": "UG", "alpha3": "UGA", "name_zh": "乌干达", "name_en": "Uganda"}, {"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:50.831734+00:00", "published_at_raw": "2023-11-24T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea", "start": 40, "end": 51, "matched_text": "South Korea", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "UG", "alpha3": "UGA", "name_zh": "乌干达", "name_en": "Uganda", "start": 212, "end": 218, "matched_text": "Uganda", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "NL", "alpha3": "NLD", "name_zh": "荷兰", "name_en": "Netherlands", "start": 368, "end": 379, "matched_text": "Netherlands", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578973+00:00"}
{"text_id": "text_71d6c10be1df507dbac4", "record_id": "article_71d6c10be1df507d", "canonical_url": "https://dialogue.earth/en/climate/384201-hurricane-otis-the-phenomena-are-natural-but-disasters-are-socially-constructed", "publisher_url": "https://dialogue.earth/en/climate/384201-hurricane-otis-the-phenomena-are-natural-but-disasters-are-socially-constructed", "title_original": "Lessons from Hurricane Otis: ‘Disasters are socially constructed’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-11-22T18:36:46+00:00", "source_text": "On 25 October, Hurricane Otis caused devastation as it hit the state of Guerrero, on Mexico’s Pacific coast, leaving at least 45 people dead and more than 20 missing , and damaging at least 200,000 homes. Ahead of making landfall, the US National Hurricane Center described its arrival as “a nightmare scenario” for southern Mexico. Nearly a month later, Acapulco, the worst-hit city, continues to suffer from the impacts of the storm. Public transport systems are yet to be restored , and prices have risen sharply; across the city queues for ATMs stretch for blocks; and residents are seeing shortages of goods, compounded by the complexity of transporting groceries – impacts that are being disproportionately felt by low-income residents.", "text_kind": "article_excerpt", "text_characters": 742, "text_sha256": "6b9397f3fd770878806a29ae2ec0d39cb9d4e352c6e18eb950af8e0033467503", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:53.410787+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:53.449112+00:00", "published_at_raw": "2023-11-22T18:36:46", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 85, "end": 91, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 235, "end": 237, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578973+00:00"}
{"text_id": "text_3b6f00a795fa84002ee0", "record_id": "article_3b6f00a795fa8400", "canonical_url": "https://yaleclimateconnections.org/2023/11/warming-winters-threaten-a-unique-dessert-cider", "publisher_url": "https://yaleclimateconnections.org/2023/11/warming-winters-threaten-a-unique-dessert-cider", "title_original": "Warming winters threaten a unique dessert cider", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-11-22T12:00:00+00:00", "source_text": "After a holiday feast of turkey and cranberries, some people enjoy a small glass of ice cider. Léger: “It is a sweet dessert wine style of alcoholic cider … and it’s the perfect ending for all the Thanksgiving things.” Eleanor Léger is co-founder of Vermont-based Eden Ciders. She says the beverage is made possible by cold northern winters. In late fall, her team presses apples into juice, and they leave it outside in large barrels. As temperatures drop, the water in the juice freezes. Léger: “And all the heavier molecules — sugars, acids, everything that gives you flavor — those molecules are trickling down.", "text_kind": "article_excerpt", "text_characters": 615, "text_sha256": "00bb6848abe0818a3e5ccb4b2445bea63dcad523b584ceb0b36b1c84af97d9a1", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:50.859415+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 439, "end": 450, "evidence": " fall, her team presses apples into juice, and they leave it outside in large barrels. As temperatures drop, the water in the juice freezes. Léger: “And all the heavier molecules — sugars, acids, everything that gives you flavor — those mole"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:50.876584+00:00", "published_at_raw": "2023-11-22T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578973+00:00"}
{"text_id": "text_8aa146196f0444557fde", "record_id": "article_8aa146196f044455", "canonical_url": "https://yaleclimateconnections.org/2023/11/wind-power-boosts-his-familys-business-kansas-rancher-says", "publisher_url": "https://yaleclimateconnections.org/2023/11/wind-power-boosts-his-familys-business-kansas-rancher-says", "title_original": "Wind power boosts his family’s business, Kansas rancher says", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-11-17T12:00:00+00:00", "source_text": "In the Flint Hills of Kansas, Pete Ferrell owns the 7,000-acre ranch that his great-grandfather established 135 years ago. He says income from oil production on the land helped save the family’s ranch during a drought in the 1950s. Now wind energy is helping Ferrell sustain the business when times are tough. Ferrell: “I always say that wind farming is my best cash crop because the wind blows even during a drought.” Ferrell was first approached by a wind developer in the 1990s. He was initially skeptical. Ferrell: “Quite frankly, my first response was, ‘No, we’re not doing that at all.’” But after talking to other ranchers who had successfully integrated the turbines with their businesses, he felt confident moving forward. He leased land to the Elk River Wind Farm, which opened in 2005.", "text_kind": "article_excerpt", "text_characters": 796, "text_sha256": "0fe16ec8eab9da0bc778d0c251e293db20ebb3db867d224ceda79c52d8db8742", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:55.816567+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 241, "end": 247, "evidence": "uction on the land helped save the family’s ranch during a drought in the 1950s. Now wind energy is helping Ferrell sustain the business when times are tough. Ferrell: “I always say that wind farming is my best cash crop because the win"}, {"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 210, "end": 217, "evidence": "o. He says income from oil production on the land helped save the family’s ranch during a drought in the 1950s. Now wind energy is helping Ferrell sustain the business when times are tough. Ferrell: “I always say that wind farming is my "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:55.859742+00:00", "published_at_raw": "2023-11-17T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578973+00:00"}
{"text_id": "text_bc2a844daf159c2b3b0d", "record_id": "article_bc2a844daf159c2b", "canonical_url": "https://dialogue.earth/en/business/384031-what-do-argentinas-elections-mean-for-relations-with-china", "publisher_url": "https://dialogue.earth/en/business/384031-what-do-argentinas-elections-mean-for-relations-with-china", "title_original": "What do Argentina’s elections mean for relations with China?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-11-14T14:04:03+00:00", "source_text": "As centrist Sergio Massa faces libertarian Javier Milei in presidential runoff this Sunday, experts weigh up the potential changes in the country’s foreign policy", "text_kind": "source_excerpt", "text_characters": 162, "text_sha256": "b442992995e73e151580bc0014717b39551f665b58bbb7e5d2fc480ad2dd44e3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:53.964489+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:53.976845+00:00", "published_at_raw": "2023-11-14T14:04:03", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina", "start": 8, "end": 17, "matched_text": "Argentina", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 54, "end": 59, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578973+00:00"}
{"text_id": "text_a12fe503272c7b2e5d07", "record_id": "article_a12fe503272c7b2e", "canonical_url": "https://yaleclimateconnections.org/2023/11/a-tropical-storm-may-emerge-in-the-caribbean-late-this-week", "publisher_url": "https://yaleclimateconnections.org/2023/11/a-tropical-storm-may-emerge-in-the-caribbean-late-this-week", "title_original": "A tropical storm may emerge in the Caribbean late this week", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-11-13T18:55:15+00:00", "source_text": "A disturbance in the Caribbean is likely to evolve into a tropical depression or tropical storm by late week, perhaps bringing dangerously heavy amounts of rain to Hispaniola and eastern Cuba as it heads northeast. In its Tropical Weather Outlook issued at 1 p.m. EST Monday, the National Hurricane Center gave this system a 70% chance of developing into at least a tropical depression in the seven-day period through Monday, November 20. The new system is expected to emerge in the southwest Caribbean Sea, where low pressure often develops toward the end of hurricane season in October or November. As of Monday, there was little happening in this area other than scattered showers and thunderstorms (convection) associated with the Intertropical Convergence Zone.", "text_kind": "article_excerpt", "text_characters": 766, "text_sha256": "0632f3b92fe414b750111bb3279a6afbcc7f9e9f823f06acb04542e7ce57cc21", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:56.169461+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "70%", "start": 325, "end": 328, "evidence": " EST Monday, the National Hurricane Center gave this system a 70% chance of developing into at least a tropical depression in the seven-day period through Monday, November 20.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CU", "alpha3": "CUB", "name_zh": "古巴", "name_en": "Cuba"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CU", "alpha3": "CUB", "name_zh": "古巴", "name_en": "Cuba"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:56.203474+00:00", "published_at_raw": "2023-11-13T18:55:15", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CU", "alpha3": "CUB", "name_zh": "古巴", "name_en": "Cuba", "start": 187, "end": 191, "matched_text": "Cuba", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578973+00:00"}
{"text_id": "text_c0724482f1a0b0928771", "record_id": "article_c0724482f1a0b092", "canonical_url": "https://yaleclimateconnections.org/2023/11/every-single-time-it-rains-hard-here-everyone-in-town-gets-really-tense", "publisher_url": "https://yaleclimateconnections.org/2023/11/every-single-time-it-rains-hard-here-everyone-in-town-gets-really-tense", "title_original": "‘Every single time it rains hard here, everyone in town gets really tense’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-11-10T12:00:00+00:00", "source_text": "This past summer, intense rain caused historic floods in Montpelier, Vermont. Bedard: “Suddenly, we have a river where Main Street used to be. People are canoeing and kayaking to get to places to … rescue people.” Jaime Bedard is executive director of Just Basics , which runs a local food pantry. Just Basics had operated for years out of the basement of a church. But the church is located downtown, near the Winooski River, so during the floods, water inundated the food pantry. The water wiped out the group’s food supplies and destroyed fridges and freezers. Thanks to an outpouring of community support, Just Basics quickly reopened in a temporary location, so it could continue serving people during the crisis.", "text_kind": "article_excerpt", "text_characters": 718, "text_sha256": "0fd21ae52f4e084c27de56ccf3925d6f1dc5e0c945a4032cbb478ab417413a46", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:56.378653+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 47, "end": 52, "evidence": "This past summer, intense rain caused historic floods in Montpelier, Vermont. Bedard: “Suddenly, we have a river where Main Street used to be. People are canoeing and kayaking to get to places"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:56.412366+00:00", "published_at_raw": "2023-11-10T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578973+00:00"}
{"text_id": "text_c36ea158f0ef44030002", "record_id": "article_c36ea158f0ef4403", "canonical_url": "https://insideclimatenews.org/news/07112023/arizona-colorado-river-water-conservation", "publisher_url": "https://insideclimatenews.org/news/07112023/arizona-colorado-river-water-conservation", "title_original": "Feds Bet on Paying for Water Conservation to Protect the Colorado River", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-11-07T10:30:00+00:00", "source_text": "PHOENIX—Arizona’s future was at a critical juncture at the beginning of 2023. Massive cuts to the state’s Colorado River water supply were being imposed. Deadlines loomed from the federal government for the seven states that rely on Colorado River water to come up with a solution for how to cut use even further as the […]", "text_kind": "source_excerpt", "text_characters": 323, "text_sha256": "96a19b4820d17cbe74a027ede5ecddbcdb70ae973b6b594b068604ad0b513791", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:06.424905+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:06.436930+00:00", "published_at_raw": "2023-11-07T10:30:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578973+00:00"}
{"text_id": "text_2a8770cca3afab423618", "record_id": "article_2a8770cca3afab42", "canonical_url": "https://dialogue.earth/en/energy/prospects-and-challenges-of-indias-first-geothermal-plant", "publisher_url": "https://dialogue.earth/en/energy/prospects-and-challenges-of-indias-first-geothermal-plant", "title_original": "Prospects and challenges of India’s first geothermal plant", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-11-07T03:30:00+00:00", "source_text": "Construction of a geothermal plant in the Himalayan region of Ladakh is currently stalled, with the release of polluting liquid into a local stream raising concerns among the local population of environmental risks", "text_kind": "source_excerpt", "text_characters": 214, "text_sha256": "9cb6ee1e319e8a9648cb3465cebaf67a38db65db79e8406d8c45f40f076ea52d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:54.264412+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:54.286389+00:00", "published_at_raw": "2023-11-07T03:30:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 28, "end": 33, "matched_text": "India", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578973+00:00"}
{"text_id": "text_b3852ccfd140c473335a", "record_id": "article_b3852ccfd140c473", "canonical_url": "https://dialogue.earth/en/climate/scientists-say-only-transformational-change-will-avoid-environmental-tipping-points", "publisher_url": "https://dialogue.earth/en/climate/scientists-say-only-transformational-change-will-avoid-environmental-tipping-points", "title_original": "Scientists say only transformational change will avoid environmental tipping points", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-11-02T15:12:03+00:00", "source_text": "The world is facing several environmental “tipping points” that are interrelated and could cause drastic changes to societies if unaddressed, scientists have said in a new report. Published by the UN University Institute for Environment and Human Security (UNU EHS), “ Interconnected Disaster Risks ” is designed to highlight the interconnections between the risks the world faces. It underlines that when ecosystems, food systems and water systems deteriorate, instability can slowly build until a tipping point is reached, changing the system fundamentally or even causing it to collapse. The report favours solutions that address the root causes of the six risks it highlights: unbearable heat, biodiversity extinctions, groundwater depletion, glacial melt, uninsurability and space debris.", "text_kind": "article_excerpt", "text_characters": 793, "text_sha256": "4b9fc89fc012866876a1e2723ba2aa77b2e40a1cb6db76a16834734d8ba69d0b", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:57.920443+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:57.975756+00:00", "published_at_raw": "2023-11-02T15:12:03", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578973+00:00"}
{"text_id": "text_e33a64e3f9719b752023", "record_id": "article_e33a64e3f9719b75", "canonical_url": "https://dialogue.earth/en/climate/after-floods-pakistan-resilient-housing", "publisher_url": "https://dialogue.earth/en/climate/after-floods-pakistan-resilient-housing", "title_original": "After successive floods, Pakistan is forced to consider resilient housing", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-11-02T05:27:50+00:00", "source_text": "Last August, Rano, a schoolteacher from Kewal Kohli, a village in the Mirpur Khas district of Sindh province in southeastern Pakistan, saw the mud hut where he lived wash away in devastating floods . Just 8 kilometres away was a village called Pono, where a group of one-room bamboo houses had all withstood the force of the floods and remained intact. People’s houses “did not collapse [in the floods] and they were not forced to evacuate,” Rano tells The Third Pole. These houses provided shelter to people from neighbouring villages, including Rano and others from Kewal Kohli. Rano found out through villagers that the houses were designed by Yasmeen Lari, one of Pakistan’s most celebrated architects.", "text_kind": "article_excerpt", "text_characters": 706, "text_sha256": "c919287914273154b86fe722c3de82a884d644403e361650ff5e643e212d719e", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:58.006436+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 191, "end": 196, "evidence": "rovince in southeastern Pakistan, saw the mud hut where he lived wash away in devastating floods . Just 8 kilometres away was a village called Pono, where a group of one-room bamboo houses had all withstood the force of the floods and "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:58.047494+00:00", "published_at_raw": "2023-11-02T05:27:50", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan", "start": 25, "end": 33, "matched_text": "Pakistan", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan", "start": 125, "end": 133, "matched_text": "Pakistan", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578973+00:00"}
