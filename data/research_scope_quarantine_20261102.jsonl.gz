{"text_id": "text_4dc63c3407903f473283", "record_id": "article_4dc63c3407903f47", "canonical_url": "https://news.mongabay.com/2026/04/meet-the-2026-goldman-environmental-prize-winners", "publisher_url": "https://news.mongabay.com/2026/04/meet-the-2026-goldman-environmental-prize-winners", "title_original": "Meet the 2026 Goldman Environmental Prize Winners", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-20T08:00:55+00:00", "source_text": "Six environmental activists from around the world will be awarded the Goldman Environmental Prize on April 20. Known as the “Green Nobel Prize,” the Goldman Prize honors activists from the six inhabited continental regions. In a historic first, all six winners are women. This year’s winners fought to protect a rare bat in Nigeria by […]", "text_kind": "source_excerpt", "text_characters": 338, "text_sha256": "4b0ee4d49571be694759b0760bc81633135dc881d119251ca6be522c1f59c232", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:14.051662+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NG", "alpha3": "NGA", "name_zh": "尼日利亚", "name_en": "Nigeria"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NG", "alpha3": "NGA", "name_zh": "尼日利亚", "name_en": "Nigeria"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_veri