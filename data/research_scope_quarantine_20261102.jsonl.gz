{"text_id": "text_49c1830781298926bd58", "record_id": "article_49c1830781298926", "canonical_url": "https://insideclimatenews.org/news/17072026/texas-precipitation-models-underestimate-risk", "publisher_url": "https://insideclimatenews.org/news/17072026/texas-precipitation-models-underestimate-risk", "title_original": "Latest Precipitation Models Still Seem to Underestimate Risk as ‘1,000-Year’ Rain Events Pummel Texas", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-17T23:32:46+00:00", "source_text": "Parts of South Texas ravaged by flooding this week have logged a steep rise in rainfall intensity over recent decades, federal data show. The latest official dataset, published in 2018 by the National Oceanic and Atmospheric Administration (NOAA), increased estimates of benchmark rainfall events by 30 to 40 percent in the region west of San […]", "text_kind": "source_excerpt", "text_characters": 346, "text_sha256": "ca0e9e80d8dd85a469e0fc2044f3094db3fbd397e9572fd403252e04f0fa551e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:38.507893+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "40 percent", "start": 306, "end": 316, "evidence": " The latest official dataset, published in 2018 by the National Oceanic and Atmospheric Administration (NOAA), increased estimates of benchmark rainfall events by 30 to 40 percent in the region west of San […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_e