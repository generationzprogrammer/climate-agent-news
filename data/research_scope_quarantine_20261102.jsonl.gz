{"text_id": "text_b7648892bbcb73fa33d1", "record_id": "article_b7648892bbcb73fa", "canonical_url": "https://news.mongabay.com/2026/06/fire-surge-threatens-indigenous-livelihoods-and-isolated-peoples-in-brazil", "publisher_url": "https://news.mongabay.com/2026/06/fire-surge-threatens-indigenous-livelihoods-and-isolated-peoples-in-brazil", "title_original": "Fire surge in 2025 threatened isolated peoples in Brazil", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-24T13:12:59+00:00", "source_text": "In 2025, fires were responsible for a significant spike in forest loss in three territories in Brazil that are home to Indigenous peoples living in voluntary isolation, according to Global Forest Watch data analyzed by Mongabay. Indigenous leaders from the Alto Turiaçu, Uru-Eu-Wau-Wau, and Apiaká do Pontal e Isolados Indigenous territories, told Mongabay that fire […]", "text_kind": "source_excerpt", "text_characters": 370, "text_sha256": "813b55fb51b62ca526ab6b7f2ae1e4084eaa1bdd448a0114abcf99964b4c529c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:54.495741+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 119, "end": 129, "evidence": "le for a significant spike in forest loss in three territories in Brazil that are home to Indigenous peoples living in voluntary isolation, according to Global Forest Watch data analyzed by Mongabay. Indigenous leaders from the Alto Turiaçu"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:54.525606+00:00", "published_at_raw": "2026-06-24T13:12:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 50, "end": 56, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 95, "end": 101, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_125d314bc459f169b5a9", "record_id": "article_125d314bc459f169", "canonical_url": "https://insideclimatenews.org/news/23062026/tanya-trujillo-upper-colorado-river-commission", "publisher_url": "https://insideclimatenews.org/news/23062026/tanya-trujillo-upper-colorado-river-commission", "title_original": "As Colorado River States Struggle to Reach Agreement, New Mexico Brings on a Fresh Voice", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-23T22:37:14+00:00", "source_text": "The Upper Colorado River Commission welcomed a new representative from New Mexico at a meeting in downtown Denver on Tuesday, where it discussed ongoing negotiations over how to share America’s most over-allocated river. Tanya Trujillo, deputy state engineer and senior water policy advisor to New Mexico Gov. Michelle Grisham, replaced Estevan López as the state’s […]", "text_kind": "source_excerpt", "text_characters": 369, "text_sha256": "598cd0fe5db95af70e47cd6ab7f6f99af50c16be5db8a766e5dd4e3f7aa56e28", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:57.119224+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:57.133452+00:00", "published_at_raw": "2026-06-23T22:37:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 54, "end": 64, "matched_text": "New Mexico", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 71, "end": 81, "matched_text": "New Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_be5791abbf615aee644d", "record_id": "article_be5791abbf615aee", "canonical_url": "https://news.mongabay.com/2026/06/south-americas-farms-depend-in-part-on-a-healthy-amazon", "publisher_url": "https://news.mongabay.com/2026/06/south-americas-farms-depend-in-part-on-a-healthy-amazon", "title_original": "South America’s farms depend, in part, on a healthy Amazon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-22T08:30:41+00:00", "source_text": "The Amazon is often described in terms of how much carbon it stores. It also moves vast amounts of water. Its trees draw moisture from the soil and return it to the air through transpiration. Some rain caught by the canopy also evaporates back into the atmosphere. That moisture falls again, some of it […]", "text_kind": "source_excerpt", "text_characters": 306, "text_sha256": "51a823b67702ccbaeac39fc5d5e206910dbf017ed66adf5960a629e6d73c3e07", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:03.129134+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:03.184597+00:00", "published_at_raw": "2026-06-22T08:30:41", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_5466ccb8b062a453f4b2", "record_id": "article_5466ccb8b062a453", "canonical_url": "https://yaleclimateconnections.org/2026/06/small-farmers-need-a-better-safety-net-trade-group-says", "publisher_url": "https://yaleclimateconnections.org/2026/06/small-farmers-need-a-better-safety-net-trade-group-says", "title_original": "Small farmers need a better safety net, trade group says", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-19T11:00:00+00:00", "source_text": "These farms often grow a variety of crops, which makes them more resilient when extreme weather strikes. But farming this way can make it harder to get crop insurance.", "text_kind": "source_excerpt", "text_characters": 167, "text_sha256": "53d50d33fbdb33fa925752b40cb8a0793fc21aeaa58e00febd957a885fe72a90", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:53.549697+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "adaptation", "label_zh": "适应与韧性", "label_en": "Adaptation and resilience", "start": 65, "end": 73, "evidence": "These farms often grow a variety of crops, which makes them more resilient when extreme weather strikes. But farming this way can make it harder to get crop insurance."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_e