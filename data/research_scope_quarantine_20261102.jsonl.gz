{"text_id": "text_de37832bf0c09116ae47", "record_id": "article_de37832bf0c09116", "canonical_url": "https://insideclimatenews.org/news/04032026/new-york-city-congestion-pricing-continues", "publisher_url": "https://insideclimatenews.org/news/04032026/new-york-city-congestion-pricing-continues", "title_original": "Judge Rejects Trump Administration’s Plan to End NYC Congestion Pricing", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-04T16:34:30+00:00", "source_text": "A federal judge ruled Tuesday that the Trump administration’s efforts to shut down New York’s congestion pricing program are unlawful. U.S. District Judge Lewis Liman, an appointee of President Donald Trump, handed down the decision. Liman also granted an injunction in May that allowed the congestion pricing to continue while the lawsuit played out in […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "77d0595274b52741b69f005cd5bc83d7a3369a18b9e64f4c9e240e679e602e8e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:34.889649+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 245, "end": 250, "evidence": "Lewis Liman, an appointee of President Donald Tr