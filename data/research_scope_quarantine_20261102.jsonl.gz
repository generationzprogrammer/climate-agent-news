{"text_id": "text_62d479bdb01b2cbc3933", "record_id": "article_62d479bdb01b2cbc", "canonical_url": "https://news.mongabay.com/2025/09/putting-the-right-plants-in-the-right-place-boosts-restoration-commentary", "publisher_url": "https://news.mongabay.com/2025/09/putting-the-right-plants-in-the-right-place-boosts-restoration-commentary", "title_original": "Putting the right plants in the right place boosts restoration (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-16T15:40:39+00:00", "source_text": "The sun is already sharp against the terraced slopes, the scent of thyme and rosemary rising from the rocky ground. Dry wind whistles through esparto grass, and somewhere in the distance is the soft clang of goat bells. A partridge erupts from the scrub. No roads. No fields. No fences. Just the land, as it […]", "text_kind": "source_excerpt", "text_characters": 311, "text_sha256": "efef34257404832b76a3eafe4673d720e07af93d88549695deae714bf53ad738", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:06.996248+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:07.006467+00:00", "published_at_raw": "2025-09-16T15:40:39", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_8edce2d707a0108c3c52", "record_id": "article_8edce2d707a0108c", "canonical_url": "https://news.mongabay.com/2025/09/robert-redford-filmmaker-who-fought-for-nature-has-died-aged-89", "publisher_url": "https://news.mongabay.com/2025/09/robert-redford-filmmaker-who-fought-for-nature-has-died-aged-89", "title_original": "Robert Redford, filmmaker who fought for nature, has died, aged 89", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-16T15:30:50+00:00", "source_text": "Robert Redford never intended to be a spokesman for the environment. Acting and directing, the twin pillars of his professional life, were supposed to be enough. Yet for more than half a century he stood before cameras, senators, and students insisting that “the environment should be put in the category of our national security. Defense […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "6cb44d9b0e7f1f3720f03abfe4ad76f017d18ad11df66d1abc83ecb37d2f913a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:07.044406+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:07.060726+00:00", "published_at_raw": "2025-09-16T15:30:50", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_908602067d7c77a68035", "record_id": "article_908602067d7c77a6", "canonical_url": "https://news.mongabay.com/2025/09/uruguays-green-hydrogen-plans-raise-ecological-concerns-in-argentina-at-home", "publisher_url": "https://news.mongabay.com/2025/09/uruguays-green-hydrogen-plans-raise-ecological-concerns-in-argentina-at-home", "title_original": "Uruguay’s green hydrogen plans raise ecological concerns in Argentina & at home", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-15T19:00:36+00:00", "source_text": "COLÓN, Argentina — Darío Larrosa was 15 when he learned to drive a motorboat. Decades later, he still loves taking tourists fishing along the Uruguay River’s sandy shores aboard Abuela Elisa, the boat he named after his grandmother. He does ask the lucky anglers who catch something to release the fish, to help maintain the […]", "text_kind": "source_excerpt", "text_characters": 328, "text_sha256": "8e94569d1357897542b41658ae38bac8b94593cea4fc7aec893140f72058ce8a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:07.230578+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "UY", "alpha3": "URY", "name_zh": "乌拉圭", "name_en": "Uruguay"}, {"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "UY", "alpha3": "URY", "name_zh": "乌拉圭", "name_en": "Uruguay"}, {"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:07.244901+00:00", "published_at_raw": "2025-09-15T19:00:36", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "UY", "alpha3": "URY", "name_zh": "乌拉圭", "name_en": "Uruguay", "start": 0, "end": 7, "matched_text": "Uruguay", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina", "start": 60, "end": 69, "matched_text": "Argentina", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina", "start": 7, "end": 16, "matched_text": "Argentina", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "UY", "alpha3": "URY", "name_zh": "乌拉圭", "name_en": "Uruguay", "start": 142, "end": 149, "matched_text": "Uruguay", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_1d6cfe2f8cfcc2119785", "record_id": "article_1d6cfe2f8cfcc211", "canonical_url": "https://news.mongabay.com/2025/09/brazil-weighs-new-measures-to-manage-shark-trade-fishing", "publisher_url": "https://news.mongabay.com/2025/09/brazil-weighs-new-measures-to-manage-shark-trade-fishing", "title_original": "Brazil weighs new measures to manage shark trade, fishing", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-15T17:39:54+00:00", "source_text": "The Brazilian government is reviewing its legal framework for the trade in sharks. Measures now under consideration include a potential ban on fin exports and stricter rules for shark fishing and imports, as well as revising the rules governing the fishing of blue shark (Prionace glauca), the only species that’s legal to catch in Brazilian […]", "text_kind": "source_excerpt", "text_characters": 345, "text_sha256": "d2597d9b0a1ca98342f4bf7406f36a795999ba22f4cd0ad0760001fbfaccc9ee", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:07.255017+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.