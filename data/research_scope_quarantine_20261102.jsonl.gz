{"text_id": "text_547233ccbccb13ef1b19", "record_id": "article_547233ccbccb13ef", "canonical_url": "https://news.mongabay.com/2025/04/church-pressure-spurs-scrutiny-of-indonesian-geothermal-projects", "publisher_url": "https://news.mongabay.com/2025/04/church-pressure-spurs-scrutiny-of-indonesian-geothermal-projects", "title_original": "Church pressure spurs scrutiny of Indonesian geothermal projects", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-23T02:43:58+00:00", "source_text": "ENDE, Indonesia — The governor of one Indonesia’s poorest provinces said it would pause development of new geothermal energy projects on the island of Flores, following an intervention by the Catholic Church. On April 4, East Nusa Tenggara Governor Emanuel Melkiades Laka Lena said his administration would review all ongoing geothermal exploration on Flores Island, […]", "text_kind": "source_excerpt", "text_characters": 370, "text_sha256": "e0edc66b6a299dc161137ee6df7e48ab05d79ccbc62de0579355a583325bfeeb", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:30.467707+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 118, "end": 124, "evidence": "or of one Indonesia’s poorest provinces said it would pause development of new geothermal energy projects on the island of Flores, following an intervention by the Catholic Church. On April 4, East Nusa Tenggara Governor Emanuel Melkiad"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:30.499705+00:00", "published_at_raw": "2025-04-23T02:43:58", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 6, "end": 15, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
