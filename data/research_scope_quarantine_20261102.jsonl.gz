{"text_id": "text_8c04a9d3ad48ba7d3b84", "record_id": "article_8c04a9d3ad48ba7d", "canonical_url": "https://insideclimatenews.org/news/10012025/todays-climate-los-angeles-fires-evacuations", "publisher_url": "https://insideclimatenews.org/news/10012025/todays-climate-los-angeles-fires-evacuations", "title_original": "As Wildfires Threaten Urban Areas Like Los Angeles, ‘Planning for the Unprecedented’ Is Crucial, Experts Say", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-10T21:49:02+00:00", "source_text": "When Michael Huard took his dog outside on Tuesday in Pasadena, California, a strong gust of wind blew his door wide open. “Once the wind started, it was like, ‘Oh, this is real,’” he told me over the phone on Thursday. “It felt like what I imagined at the beginning of a hurricane feels like.” […]", "text_kind": "source_excerpt", "text_characters": 298, "text_sha256": "d504c5332a0263bdd26fbe48fecc37c638f7d427049cc1a85f362dae58e7cd4f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:10.800772+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:10.813674+00:00", "published_at_raw": "2025-01-10T21:49:02", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 64, "end": 74, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_52cf13c6e8faee99bd95", "record_id": "article_52cf13c6e8faee99", "canonical_url": "https://news.mongabay.com/2025/01/warming-threatens-flies-more-than-bees-raising-pollination-concerns", "publisher_url": "https://news.mongabay.com/2025/01/warming-threatens-flies-more-than-bees-raising-pollination-concerns", "title_original": "Warming threatens flies more than bees, raising pollination concerns", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-08T19:42:13+00:00", "source_text": "Life can’t function without insects. At least, not for long. They pollinate, break down waste, cycle nutrients, and touch every node in the web of life, filling endless niches across the planet. As global temperatures continue to rise, some of Earth’s most important but overlooked pollinators, the flies, may be at greater risk than previously […]", "text_kind": "source_excerpt", "text_characters": 348, "text_sha256": "d704915a21b9a61463319abd964f9a4cf4da3a615b7c9ab9c1d3e6d9861c9e5f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:29.548088+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 205, "end": 216, "evidence": " touch every node in the web of life, filling endless niches across the planet. As global temperatures continue to rise, some of Earth’s most important but overlooked pollinators, the flies, may be at greater risk than previously […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:29.562153+00:00", "published_at_raw": "2025-01-08T19:42:13", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_7bea493d43935dd9e9c4", "record_id": "article_7bea493d43935dd9", "canonical_url": "https://news.mongabay.com/2025/01/2024s-top-ocean-news-stories-commentary", "publisher_url": "https://news.mongabay.com/2025/01/2024s-top-ocean-news-stories-commentary", "title_original": "2024’s top ocean news stories (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-08T16:47:47+00:00", "source_text": "1. Long-awaited plastics treaty flops, for now Despite around-the-clock efforts from delegates, negotiators and numerous advocacy groups, the fifth session of the U.N. Environment Programme’s Intergovernmental Negotiating Committee (INC-5) on plastic pollution failed to pass the Global Plastics Treaty as a legally binding instrument by the end of negotiations Dec. 1. Recommended by a 2022 […]", "text_kind": "source_excerpt", "text_characters": 395, "text_sha256": "9c6d420387b3265aea57dc4e4e3fd472c9a47fdaa81b2ef71575fccb4f579383", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:29.607090+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02