{"text_id": "text_2c3c0d4e7cb89a490850", "record_id": "article_2c3c0d4e7cb89a49", "canonical_url": "https://news.mongabay.com/2026/10/given-a-chance-women-led-microenterprises-uplift-nepali-communities-conservation", "publisher_url": "https://news.mongabay.com/2026/10/given-a-chance-women-led-microenterprises-uplift-nepali-communities-conservation", "title_original": "Given a chance, women-led microenterprises uplift Nepali communities & conservation", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-30T18:02:46+00:00", "source_text": "NAYA PADAMPUR, Nepal — A spinning wheel whirs on a rooftop in Naya Padampur in south-central Nepal, sending ivory strands of yarn through Bin Maya Gurung’s practiced fingers. Smile lines crinkle at the corners of her eyes as she works. Her limbs move in synchrony with the wheel, both integral parts of the machine that […]", "text_kind": "source_excerpt", "text_characters": 323, "text_sha256": "b8f90219926b4a9273f2196ba4082c35b1bb98cc11d848d4a9c47ab025c5ba9c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:19.363605+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "annotation_method": "