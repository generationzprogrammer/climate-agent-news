{"text_id": "text_6cbc9f39201eb4db9d40", "record_id": "article_6cbc9f39201eb4db", "canonical_url": "https://yaleclimateconnections.org/2025/03/why-sizzling-cities-are-mapping-hot-spots-street-by-street", "publisher_url": "https://yaleclimateconnections.org/2025/03/why-sizzling-cities-are-mapping-hot-spots-street-by-street", "title_original": "Why sizzling cities are mapping hot spots street by street", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-19T11:00:00+00:00", "source_text": "In metros like Reno, Nevada, citizen scientists hit the road to collect detailed temperature data — key to taming urban heat, saving lives and designing for a warmer future", "text_kind": "source_excerpt", "text_characters": 172, "text_sha256": "9ee28240aebdb146204d6709a6664df665b070190a9db0c6f9cef6e9fd2afaee", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:14.864565+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 81, "end": 92, "evidence": "In metros like Reno, Nevada, citizen scientists hit the road to collect detailed temperature data — key to taming urban heat, saving lives and designing for a warmer future"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_sta