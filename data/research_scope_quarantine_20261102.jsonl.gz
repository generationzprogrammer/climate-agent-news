{"text_id": "text_ec366d42153b8aaf2d8d", "record_id": "article_ec366d42153b8aaf", "canonical_url": "https://insideclimatenews.org/news/01062025/gila-river-tribes-floating-solar-could-help-colorado-river", "publisher_url": "https://insideclimatenews.org/news/01062025/gila-river-tribes-floating-solar-could-help-colorado-river", "title_original": "Gila River Tribes Intend to Float Solar Panels on a Reservoir. Could the Technology Help the Colorado River?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-01T09:00:00+00:00", "source_text": "GILA RIVER INDIAN RESERVATION, Ariz.—About 33 miles south of Phoenix, Interstate 10 bisects a line of solar panels traversing the desert like an iridescent snake. The solar farm’s shape follows the path of a canal, with panels serving as awnings to shade the gently flowing water from the unforgiving heat and wind of the Sonoran […]", "text_kind": "source_excerpt", "text_characters": 333, "text_sha256": "5debcf32ec8de79bdfddb5e2b2eb5f0a09b7e72eec16ee0ce0d561e34c9b9e2d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:48.744182+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 102, "end": 107, "evidence": "NDIAN RESERVATION, Ariz.—About 33 miles south of Phoenix, Interstate 10 bisects a line of solar panels traversing the desert like an iridescent snake. The solar farm’s shape follows the path of a canal, with panels serving as awnings t"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:48.757604+00:00", "published_at_raw": "2025-06-01T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_af62e61dbcdf6756ff7f", "record_id": "article_af62e61dbcdf6756", "canonical_url": "https://dialogue.earth/en/business/brazil-leads-brics-amid-growing-us-china-tensions", "publisher_url": "https://dialogue.earth/en/business/brazil-leads-brics-amid-growing-us-china-tensions", "title_original": "Brazil leads BRICS amid growing US-China tensions", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-30T08:47:15+00:00", "source_text": "Brazil has assumed the presidency of the BRICS group of emerging economies at a pivotal moment. As the bloc prepares for its annual summit in Rio de Janeiro in July, the host nation must navigate heightened tensions and conflicts stemming from the aggressive tariff policies of US President Donald Trump. With its recent expansion and growing geopolitical ambitions, the BRICS nations must balance diverse interests while asserting themselves as a more cohesive force on the world stage. Brazil faces a delicate balance between advancing this heterogeneous alliance and avoiding a stance that might be perceived in Washington as anti-Western or anti-dollar, experts say.", "text_kind": "article_excerpt", "text_characters": 670, "text_sha256": "367c1e19bdda18f4157146ff96f28dedab54ba0f57c1bf473ae7d24fa3a7e49d", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:27.032677+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:27.098246+00:00", "published_at_raw": "2025-05-30T08:47:15", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 0, "end": 6, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 32, "end": 34, "matched_text": "US", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 35, "end": 40, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 0, "end": 6, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 278, "end": 280, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarant