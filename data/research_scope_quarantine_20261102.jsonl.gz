{"text_id": "text_5c22e358bfa722ffa23e", "record_id": "article_5c22e358bfa722ff", "canonical_url": "https://news.mongabay.com/2024/02/small-secretive-highly-venomous-snake-seen-for-first-time-in-nepals-hills", "publisher_url": "https://news.mongabay.com/2024/02/small-secretive-highly-venomous-snake-seen-for-first-time-in-nepals-hills", "title_original": "Small, secretive & highly venomous snake seen for first time in Nepal’s hills", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-01T06:53:33+00:00", "source_text": "KATHMANDU – In July 2022, Tujin Rai, an undergraduate biology student, saw a dead snake outside his home in Dhankuta in Nepal’s eastern hills. He was curious to identify it. Rai, who interns at the Kathmandu-based NGO Nature Conservation and Study Centre, posted the image of the snake on Facebook, where it was spotted by […]", "text_kind": "source_excerpt", "text_characters": 326, "text_sha256": "c8c1f6dede222fd1be70c59f53f9b4ce9491f8c71af8106c85197e035e7b35e2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:18.984519+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "annotation_method": "dictionary-eviden