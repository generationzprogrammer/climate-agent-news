elegates say is "}], "policy_tools": [], "policy_stages": [], "track": "negotiations", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:09.437587+00:00", "published_at_raw": "2024-10-17T13:37:27", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_8288b8b6474596d21fb8", "record_id": "article_8288b8b6474596d2", "canonical_url": "https://news.mongabay.com/2024/10/search-for-new-territory-led-nepals-low-altitude-snow-leopard-to-get-lost", "publisher_url": "https://news.mongabay.com/2024/10/search-for-new-territory-led-nepals-low-altitude-snow-leopard-to-get-lost", "title_original": "Search for new territory led Nepal’s ‘low-altitude’ snow leopard to get lost", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-17T05:36:31+00:00", "source_text": "KATHMANDU — A snow leopard found well outside its mountainous habitat in Nepal at the start of this year may have gotten lost while seeking out new territory, a new study says. The male snow leopard (Panthera uncia), believed to be between 1.5 and 2 years old, was found on Jan. 23 in the town […]", "text_kind": "source_excerpt", "text_characters": 297, "text_sha256": "17ace9248b00611e7e8d2adcb554f7186fd8f5ebe5c683048750f7fab89f0080", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:09.489423+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "annotation_method": "dictionary-evidence-v1", "review_status": "mach