{"text_id": "text_48fb3fc500a761ed84c5", "record_id": "article_48fb3fc500a761ed", "canonical_url": "https://news.mongabay.com/2026/06/to-improve-its-floundering-fisheries-kenya-boosts-data-collection-on-artisanal-fleet", "publisher_url": "https://news.mongabay.com/2026/06/to-improve-its-floundering-fisheries-kenya-boosts-data-collection-on-artisanal-fleet", "title_original": "To improve its floundering fisheries, Kenya boosts data collection on artisanal fleet", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-12T14:46:41+00:00", "source_text": "MTWAPA, Kenya — On a mid-morning in March, Mohamed Mwazigona, 58, had just landed a measly catch on the town beach in Mtwapa on Kenya’s north coast. His crew was preparing the boat for a second trip into the sea with hopes of better luck. As traders started trickling in to buy fish, Mwazigona sat […]", "text_kind": "source_excerpt", "text_characters": 301, "text_sha256": "8d9dba58ee5723d435fd2127e4c43491c180a9325bbcb28ecdd77f6fa1512373", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:14.770151+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "annotation_method": "dictionary-e