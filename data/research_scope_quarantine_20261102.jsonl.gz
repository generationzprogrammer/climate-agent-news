{"text_id": "text_442a301529fde466548d", "record_id": "article_442a301529fde466", "canonical_url": "https://news.mongabay.com/2025/04/how-is-conservation-preparing-for-a-much-hotter-world-experts-share", "publisher_url": "https://news.mongabay.com/2025/04/how-is-conservation-preparing-for-a-much-hotter-world-experts-share", "title_original": "How is conservation preparing for a much hotter world? Experts share", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-10T15:30:46+00:00", "source_text": "About 90 kilometers (56 miles) southeast of Cape Town lies the tranquilly-named town of Betty’s Bay in South Africa, home to less than 2,000 people. But it’s not the people that draw Nik Sekhran’s eye. “I enjoy watching the African oystercatchers,” says Sekhran, chief conservation officer at World Wildlife Fund (WWF). Big black birds with […]", "text_kind": "source_excerpt", "text_characters": 344, "text_sha256": "f7a298a7700c6575e7a18d6eb1b432238562312f244dec445c286d16217a1c9b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:36.233274+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa"}], "annotation_method": "dictiona