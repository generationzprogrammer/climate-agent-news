{"text_id": "text_f3afc91dc15e2e0efb66", "record_id": "article_f3afc91dc15e2e0e", "canonical_url": "https://news.mongabay.com/2024/05/as-plastic-talks-wrap-up-in-canada-fishers-in-indonesia-count-the-costs", "publisher_url": "https://news.mongabay.com/2024/05/as-plastic-talks-wrap-up-in-canada-fishers-in-indonesia-count-the-costs", "title_original": "As plastic talks wrap up in Canada, fishers in Indonesia count the costs", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-08T08:14:54+00:00", "source_text": "PULAU SERIBU, Indonesia — Mustaghfirin unmoors his boat every day in the Thousand Islands archipelago, two hours’ sailing from the Jakarta coast, and sets off into a sea filled with garbage. “This plastic waste is extremely annoying,” Mustaghfirin told Mongabay Indonesia in April. “The motor we use to propel the boat is small, so it […]", "text_kind": "source_excerpt", "text_characters": 338, "text_sha256": "c5d50203afc24f741d68a96b2f6e3d459a6076e56068b92965f7dd2bd7b8dd77", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:34.195077+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:34.211809+00:00", "published_at_raw": "2024-05-08T08:14:54", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada", "start": 28, "end": 34, "matched_text": "Canada", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 47, "end": 56, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 14, "end": 23, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_f80a295eede63f4b7be5", "record_id": "article_f80a295eede63f4b", "canonical_url": "https://news.mongabay.com/2024/05/uks-drax-targets-california-forests-for-two-major-wood-pellet-plants", "publisher_url": "https://news.mongabay.com/2024/05/uks-drax-targets-california-forests-for-two-major-wood-pellet-plants", "title_original": "UK’s Drax targets California forests for two major wood pellet plants", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-06T13:38:44+00:00", "source_text": "The biomass energy industry centered in the U.S. Southeast is now seeking expansion to California, with U.K. wood pellet maker Drax joining a state-funded nonprofit to increase pellet exports to Asia — a plan forest advocates oppose.", "text_kind": "source_excerpt", "text_characters": 233, "text_sha256": "8353e4fad79cc9f5c753ef0875f9c444730b94dd2beb6665121c4de0c57254f7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:34.408017+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 12, "end": 18, "evidence": "The biomass energy industry centered in the U.S. Southeast is now seeking expansion to California, with U.K. wood pellet maker Drax joining a state-funded non"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:34.428757+00:00", "published_at_raw": "2024-05-06T13:38:44", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 0, "end": 2, "matched_text": "UK", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 18, "end": 28, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 44, "end": 48, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 104, "end": 108, "matched_text": "U.K.", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_1027746e81eb782a9623", "record_id": "article_1027746e81eb782a", "canonical_url": "https://insideclimatenews.org/news/05052024/todays-climate-plastic-pennsylvania-ethane-cracker-plant", "publisher_url": "https://insideclimatenews.org/news/05052024/todays-climate-plastic-pennsylvania-ethane-cracker-plant", "title_original": "Behind the Scenes: How a Plastics Plant Has Plagued a Pennsylvania County", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-05T17:12:42+00:00", "source_text": "In 2022, the oil and gas company Shell began operations at its new plastics plant in Monaca, Pennsylvania, a town in Beaver County, about 25 miles northwest of Pittsburgh. The ethane cracker plant was set to produce millions of tons of plastic at its site along the Ohio River and promised to bring money and […]", "text_kind": "source_excerpt", "text_characters": 312, "text_sha256": "9f1b20311157ead6656aa87544b0ae7c7c77c58571e96cc23ae708f38ce9dfdf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:57.284541+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:57.299001+00:00", "published_at_raw": "2024-05-05T17:12:42", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_67cdeb1ba51cdef31cb3", "record_id": "article_67cdeb1ba51cdef3", "canonical_url": "https://insideclimatenews.org/news/05052024/ernest-moniz-natural-gas-report-industry-ties-congressional-democrats", "publisher_url": "https://insideclimatenews.org/news/05052024/ernest-moniz-natural-gas-report-industry-ties-congressional-democrats", "title_original": "Academics and Lawmakers Slam an Industry-Funded Report by a Former Energy Secretary Promoting Natural Gas and LNG", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-05T08:26:00+00:00", "source_text": "With a pair of fossil-fuel friendly senators at his side, former U.S. Energy Secretary Ernest Moniz on Tuesday released a favorable report on U.S. natural gas and liquified natural gas (LNG), funded by the natural gas industry. The report, “The Future of Natural Gas in a Low-Carbon World,” was written by the EFI Foundation, a nonprofit […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "e956e541cd819d6a95ab32387d4b169772ef544a608c1b8b292241f7e494989f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:57.351994+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 70, "end": 76, "evidence": "With a pair of fossil-fuel friendly senators at his side, former U.S. Energy Secretary Ernest Moniz on Tuesday released a favorable report on U.S. natural gas and liquified natural gas (LNG), funded by the natural ga"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:57.366879+00:00", "published_at_raw": "2024-05-05T08:26:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 65, "end": 69, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_38429bcf8232f4661a8f", "record_id": "article_38429bcf8232f466", "canonical_url": "https://yaleclimateconnections.org/2024/05/a-rare-tropical-cyclone-landfall-is-on-tap-for-tanzania", "publisher_url": "https://yaleclimateconnections.org/2024/05/a-rare-tropical-cyclone-landfall-is-on-tap-for-tanzania", "title_original": "A rare tropical cyclone landfall is on tap for Tanzania", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-03T15:45:51+00:00", "source_text": "After suffering at least 155 deaths since March from disastrous floods, Tanzania is bracing for the approach of what could be the strongest tropical cyclone to affect the region in modern recordkeeping, with torrential rains in excess of 10 inches (254 mm) likely along its path. As of 8 a.m. EDT Friday (12 UTC), the Joint Typhoon Warning Center placed the center of Tropical Cyclone Hidaya about 210 miles east-southeast of Dar es Salaam, the capital and largest city of Tanzania. Top sustained winds were 85 mph, making Hidaya the equivalent of a Category 1 hurricane. Hidaya was moving west at about 7 mph but is expected to gain speed and angle slightly north of west, which would bring it onshore just south of Dar es Salaam on Saturday night local time.", "text_kind": "article_excerpt", "text_characters": 760, "text_sha256": "9502e0367721741bc818cec9ffb20a85902af23ac9b76bd49d9040fb4fba09ef", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:06.317254+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 64, "end": 69, "evidence": "After suffering at least 155 deaths since March from disastrous floods, Tanzania is bracing for the approach of what could be the strongest tropical cyclone to affect the region in modern recordkeeping, with t"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:06.338993+00:00", "published_at_raw": "2024-05-03T15:45:51", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania", "start": 47, "end": 55, "matched_text": "Tanzania", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania", "start": 72, "end": 80, "matched_text": "Tanzania", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_9eb48ab5bb375079b498", "record_id": "article_9eb48ab5bb375079", "canonical_url": "https://dialogue.earth/en/ocean/ocean-acidification-us-pacific-shellfish-farms", "publisher_url": "https://dialogue.earth/en/ocean/ocean-acidification-us-pacific-shellfish-farms", "title_original": "Imperilled by ocean acidification: How US Pacific shellfish farms are coping", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-03T14:00:18+00:00", "source_text": "Editor’s note: Ocean acidification is damaging shellfish from West Africa’s Atlantic shores to the Pacific coast of North America. In this the final instalment of a two-part series, Dialogue Earth looks at how lessons learned on the US west coast might help. Read part 1, about Senegal’s shellfish sector, here . Oregon and Washington are at the centre of the shellfish trade on the west coast of the US. In 2007, the industry was valued at USD 111 million when it came close to collapse. It began with a mystery: oyster larvae were dying in their millions in the coastal hatcheries that supply surrounding shellfish farms. Farmers and scientists initially believed they were being ravaged by a bacterial disease.", "text_kind": "article_excerpt", "text_characters": 713, "text_sha256": "22c374300bd52baeace54886daa67333a48914909ecfddf6d2a6520c7835da39", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:25.890289+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "111 million", "start": 445, "end": 456, "evidence": " In 2007, the industry was valued at USD 111 million when it came close to collapse.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "SN", "alpha3": "SEN", "name_zh": "塞内加尔", "name_en": "Senegal"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "SN", "alpha3": "SEN", "name_zh": "塞内加尔", "name_en": "Senegal"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:25.982667+00:00", "published_at_raw": "2024-05-03T14:00:18", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 39, "end": 41, "matched_text": "US", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 233, "end": 235, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "SN", "alpha3": "SEN", "name_zh": "塞内加尔", "name_en": "Senegal", "start": 278, "end": 285, "matched_text": "Senegal", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_b7f285caec18041e0af5", "record_id": "article_b7f285caec18041e", "canonical_url": "https://news.mongabay.com/2024/05/our-life-support-system-is-at-risk-interview-with-her-deepness-sylvia-earle", "publisher_url": "https://news.mongabay.com/2024/05/our-life-support-system-is-at-risk-interview-with-her-deepness-sylvia-earle", "title_original": "‘Our life support system is at risk’: Interview with ‘Her Deepness’ Sylvia Earle", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-03T10:09:56+00:00", "source_text": "ATHENS — At 88, Sylvia Earle is at an age when most people would be slowing down. But retirement doesn’t appear to be on the radar of the famous oceanographer and marine biologist, known by many as “Her Deepness” due to the more than 7,500 hours she’s spent underwater. When Earle’s not diving in the […]", "text_kind": "source_excerpt", "text_characters": 304, "text_sha256": "1d6de26663db66d27b9e2021f79c5f1b64c59056767821d617ce969954c14d5c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:34.488266+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:34.511212+00:00", "published_at_raw": "2024-05-03T10:09:56", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_7eb080494c69781caaed", "record_id": "article_7eb080494c69781c", "canonical_url": "https://yaleclimateconnections.org/2024/05/que-esta-haciendo-mexico-respecto-al-cambio-climatico", "publisher_url": "https://yaleclimateconnections.org/2024/05/que-esta-haciendo-mexico-respecto-al-cambio-climatico", "title_original": "¿Qué está haciendo México respecto al cambio climático?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-02T12:00:00+00:00", "source_text": "Las elecciones generales de junio en México podrían marcar un punto de inflexión para garantizar que las políticas climáticas del país reflejen mejor el deseo de sus ciudadanos de enfrentar la crisis climática. Ambos principales candidatos presidenciales han expresado apoyo a la energía renovable. México es el décimo país más poblado con la decimoquinta economía más grande y también es el undécimo país más contaminante del mundo en términos de emisiones de gases de efecto invernadero. En encuestas internacionales realizadas en 2022 y 2023 , México tuvo uno de los porcentajes más altos de ciudadanos preocupados por el cambio climático causado por actividades antropogénicas, con un 92%, en comparación con solo el 63% de los estadounidenses.", "text_kind": "article_excerpt", "text_characters": 748, "text_sha256": "c95a73b6b240ba02dd3cd7841802aea03fedd42438f1146b06e46a42b8b924fa", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:06.405723+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "92%", "start": 689, "end": 692, "evidence": " En encuestas internacionales realizadas en 2022 y 2023 , México tuvo uno de los porcentajes más altos de ciudadanos preocupados por el cambio climático causado por actividades antropogénicas, con un 92%, en comparación con solo el 63% de los estadounidenses.", "interpretation": "not_classified"}, {"value_text": "63%", "start": 721, "end": 724, "evidence": " En encuestas internacionales realizadas en 2022 y 2023 , México tuvo uno de los porcentajes más altos de ciudadanos preocupados por el cambio climático causado por actividades antropogénicas, con un 92%, en comparación con solo el 63% de los estadounidenses.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:06.424699+00:00", "published_at_raw": "2024-05-02T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_92f585a8d2e5074d0a4b", "record_id": "article_92f585a8d2e5074d", "canonical_url": "https://www.carbonbrief.org/cop16-tracking-country-pledges-on-tackling-biodiversity-loss", "publisher_url": "https://www.carbonbrief.org/cop16-tracking-country-pledges-on-tackling-biodiversity-loss", "title_original": "COP16: Tracking country pledges on tackling biodiversity loss", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-02T11:16:57+00:00", "source_text": "At the COP15 biodiversity summit in December 2022, nearly every country in the world committed to a new global agreement to “halt and reverse” biodiversity loss by 2030 and “restore harmony with nature” by 2050. Under the Kunming-Montreal Global Biodiversity Framework (GBF), countries pledged to release new national plans for how they will achieve a range of goals and targets. These plans are known as national biodiversity strategies and action plans (NBSAPs). The GBF required countries to submit new NBSAPs ahead of COP16 , the next global biodiversity summit being held in Cali, Colombia in October. According to a joint investigation by Carbon Brief and Guardian , 85% of countries missed this deadline.", "text_kind": "article_excerpt", "text_characters": 711, "text_sha256": "7b26f4824b3ae9ddf0d7e82312651f26adb96341bfbd7f968c55efd8fca9a0a8", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:16.575576+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "85%", "start": 673, "end": 676, "evidence": " According to a joint investigation by Carbon Brief and Guardian , 85% of countries missed this deadline.", "interpretation": "not_classified"}], "conference_ids": ["COP15", "COP16"], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "negotiations", "country_mentions": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:16.622419+00:00", "published_at_raw": "2024-05-02T11:16:57", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 586, "end": 594, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_25ca920e64c5fec9581e", "record_id": "article_25ca920e64c5fec9", "canonical_url": "https://insideclimatenews.org/news/02052024/colorado-river-indian-tribes-water-settlement", "publisher_url": "https://insideclimatenews.org/news/02052024/colorado-river-indian-tribes-water-settlement", "title_original": "Historic Agreement with the Federal Government and Arizona Gives Colorado River Indian Tribes Control Over Use of Their Water off Tribal Land", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-02T09:05:00+00:00", "source_text": "PARKER, Ariz. — Against a backdrop of the Colorado River, members of the Colorado River Indian Tribes watched Secretary of the Interior Deb Haaland, Arizona Gov. Katie Hobbs and Amelia Flores, the tribe’s chairwoman, sign a historic agreement on April 26 that asserts the tribe’s right to lease portions of their allocation of the river’s […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "71f0d703edb88243c25d386d6572333dbedc9cb46ac5b386b6396f3a284672ae", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:57.708739+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:57.719591+00:00", "published_at_raw": "2024-05-02T09:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_f1de6ad8508f1797a109", "record_id": "article_f1de6ad8508f1797", "canonical_url": "https://insideclimatenews.org/news/01052024/united-nations-plastics-treaty-negotiations", "publisher_url": "https://insideclimatenews.org/news/01052024/united-nations-plastics-treaty-negotiations", "title_original": "Headed Toward the Finish Line, Plastics Treaty Delegates ‘Work is Far From Over’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-01T17:35:01+00:00", "source_text": "The United States and other leading oil and gas producing countries that resist caps on future plastic production had a powerful effect on the latest round of United Nations talks aimed at achieving a global agreement to end plastic waste, observers said Tuesday. Language that could result in plastic production caps remains in the text […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "0ec007998e5e4eb0d729eecbe9288f14f1fb9388343e8aa70f010c79dfb54388", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:57.770851+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:57.783266+00:00", "published_at_raw": "2024-05-01T17:35:01", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 4, "end": 17, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_c7dc8fc5c2c093c39a38", "record_id": "article_c7dc8fc5c2c093c3", "canonical_url": "https://insideclimatenews.org/news/30042024/pennsylvania-shell-plastics-plant-shockingly-bad-neighbor", "publisher_url": "https://insideclimatenews.org/news/30042024/pennsylvania-shell-plastics-plant-shockingly-bad-neighbor", "title_original": "A Plastics Plant Promised Pennsylvania Prosperity, but to Some Residents It’s Become a ‘Shockingly Bad’ Neighbor", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-30T09:00:00+00:00", "source_text": "In 2014, when Jackie Shock-Stewart and her husband Matt Stewart first moved to Beaver County, Pennsylvania, they were only vaguely aware of plans to build a petrochemical facility in this largely suburban county on the western edge of the state. Two years later, Shell officially announced the construction of a new ethane cracker plant that […]", "text_kind": "source_excerpt", "text_characters": 345, "text_sha256": "db39ee6adfa59ad8a4c9f8ee4908c281c8a1cef6ad769682eeb91aff82756568", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:57.964047+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:57.977438+00:00", "published_at_raw": "2024-04-30T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_433667491907fc4c3ad3", "record_id": "article_433667491907fc4c", "canonical_url": "https://dialogue.earth/en/business/uganda-pins-hopes-on-reviving-kilembe-copper-mines", "publisher_url": "https://dialogue.earth/en/business/uganda-pins-hopes-on-reviving-kilembe-copper-mines", "title_original": "Uganda pins hopes on reviving Kilembe copper mines", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-29T15:35:15+00:00", "source_text": "The Ugandan government is keen to restart copper and cobalt extraction at the Kilembe mines in the west of the country, near the border with the Democratic Republic of the Congo. It wishes to tap into the growing global demand for minerals, like cobalt, needed to manufacture electric vehicle (EV) batteries. In December 2023, the government received four bids to revitalise the mine – from Gingko Energy, Liaoning Hongda (trading as Wagagai Mining), Sinomine Power China, and Sarrai Group – reported national newspaper The Observer . Uganda is yet to announce its preferred bidder. The successful company would partner with Kilembe Mines Ltd (KLM), which is 99% owned by the government.", "text_kind": "article_excerpt", "text_characters": 687, "text_sha256": "97b3e34ad75a714e3ee57da2715fce934111034607b0fb40fdad00761ae7952d", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:26.556629+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "99%", "start": 659, "end": 662, "evidence": " The successful company would partner with Kilembe Mines Ltd (KLM), which is 99% owned by the government.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "UG", "alpha3": "UGA", "name_zh": "乌干达", "name_en": "Uganda"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 398, "end": 404, "evidence": " In December 2023, the government received four bids to revitalise the mine – from Gingko Energy, Liaoning Hongda (trading as Wagagai Mining), Sinomine Power China, and Sarrai Group – reported national newspaper The Observer . Uganda is"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "UG", "alpha3": "UGA", "name_zh": "乌干达", "name_en": "Uganda"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:26.649464+00:00", "published_at_raw": "2024-04-29T15:35:15", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "UG", "alpha3": "UGA", "name_zh": "乌干达", "name_en": "Uganda", "start": 0, "end": 6, "matched_text": "Uganda", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)", "start": 145, "end": 177, "matched_text": "Democratic Republic of the Congo", "method": "country-span-v2", "source_field": "source