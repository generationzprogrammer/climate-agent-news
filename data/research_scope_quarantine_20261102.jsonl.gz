{"text_id": "text_07717b68bdfa30a82869", "record_id": "article_07717b68bdfa30a8", "canonical_url": "https://insideclimatenews.org/news/27082025/trump-anti-environment-crusade-enriches-drug-traffickers-amazon", "publisher_url": "https://insideclimatenews.org/news/27082025/trump-anti-environment-crusade-enriches-drug-traffickers-amazon", "title_original": "How Trump’s Anti-Environment Crusade Enriches Drug Traffickers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-27T21:52:34+00:00", "source_text": "President Donald Trump vowed to combat drug trafficking organizations and the opioid crisis, but a new report details how his extensive cuts to staff and programs targeting environmental crimes are hindering those efforts. Illegal gold mining, one of the most ruinous environmental crimes, is filling the coffers of transnational drug organizations, generating more money than […]", "text_kind": "source_excerpt", "text_characters": 380, "text_sha256": "1370327f083a64edddd186f1f48e50b1e18f9b6c4be1a98596619d8756ff3d62", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:49.510014+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:49.526654+00:00", "published_at_raw": "2025-08-27T21:52:34", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_54705eebcbc3e6e66e16", "record_id": "article_54705eebcbc3e6e6", "canonical_url": "https://insideclimatenews.org/news/27082025/ottumwa-iowa-coal-ash-landfill-polluted-water", "publisher_url": "https://insideclimatenews.org/news/27082025/ottumwa-iowa-coal-ash-landfill-polluted-water", "title_original": "The Battle Over Polluted Water Beneath an Iowa Coal Ash Landfill", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-27T19:14:47+00:00", "source_text": "The Ottumwa-Midland Landfill holds ash from one of Iowa’s few remaining coal power plants. A stew of substances marinates within the landfill’s basin that, at high enough concentrations, is hazardous to human health. Any liquid discharges from the landfill are subject to state and federal rules governing safe treatment and disposal. But the rules aren’t […]", "text_kind": "source_excerpt", "text_characters": 359, "text_sha256": "01397b984089a4c69d4ffefabaa64c27aedd0b747809e43de24245ecb5ba5ea8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:49.548717+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 72, "end": 76, "evidence": "The Ottumwa-Midland Landfill holds ash from one of Iowa’s few remaining coal power plants. A stew of substances marinates within the landfill’s basin that, at high enough concentrations, is hazardous to human health."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:49.562077+00:00", "published_at_raw": "2025-08-27T19:14:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_7cd0801c877a2802ed32", "record_id": "article_7cd0801c877a2802", "canonical_url": "https://news.mongabay.com/2025/08/bangladesh-retreating-from-development-activities-planned-in-forest-lands", "publisher_url": "https://news.mongabay.com/2025/08/bangladesh-retreating-from-development-activities-planned-in-forest-lands", "title_original": "Bangladesh retreating from development activities planned in forest lands", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-27T14:24:48+00:00", "source_text": "In the last year, Bangladesh has seen an about-turn from occupying forest land in the name of development activities such as constructing ecotourism parks, football academies, residential and training facilities for government officials. The recently canceled sum of about 3,830 hectares (9,467 acres) of land in biodiversity-rich Sonadia Island is one of the largest chunks […]", "text_kind": "source_excerpt", "text_characters": 378, "text_sha256": "91476512c2b83592df32a17b2bda2be18ee32206212ae1461b541dc0cd4f99eb", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:18.756801+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:18.789173+00:00", "published_at_raw": "2025-08-27T14:24:48", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh", "start": 0, "end": 10, "matched_text": "Bangladesh", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh", "start": 18, "end": 28, "matched_text": "Bangladesh", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_214c329d2bd1b538f642", "record_id": "article_214c329d2bd1b538", "canonical_url": "https://www.carbonbrief.org/guest-post-china-and-india-account-for-87-of-new-coal-power-capacity-so-far-in-2025", "publisher_url": "https://www.carbonbrief.org/guest-post-china-and-india-account-for-87-of-new-coal-power-capacity-so-far-in-2025", "title_original": "Guest post: China and India account for 87% of new coal-power capacity so far in 2025", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-27T09:57:42+00:00", "source_text": "China and India accounted for 87% of the new coal-power capacity put into operation in the first half of 2025, whereas other regions continued to move away from coal. These developments, highlighting a growing global divide between many countries phasing out coal power and a handful continuing to expand new capacity, are revealed in Global Energy Monitor ’s latest Global Coal Plant Tracker results and reported here for the first time. The results include Ireland becoming the fifth EU country to phase out coal power and Latin America becoming a region with zero active proposals for new coal capacity. Meanwhile, the results show the US is on track to retire more coal capacity in 2025 than it did under the Biden administration last year, despite the efforts of the Trump White House.", "text_kind": "article_excerpt", "text_characters": 790, "text_sha256": "dbac27eb5b51c8c713234ea2c5c5bd6793d0927578511104aeb48f6969300c2a", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:08.579426+00:00", "extractor_version": "1.0.0", "document_type": "commentary_or_analysis", "document_type_basis": "explicit_title_prefix", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "87%", "start": 30, "end": 33, "evidence": "China and India accounted for 87% of the new coal-power capacity put into operation in the first half of 2025, whereas other regions continued to move away from coal.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "IE", "alpha3": "IRL", "name_zh": "爱尔兰", "name_en": "Ireland"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 45, "end": 49, "evidence": "China and India accounted for 87% of the new coal-power capacity put into operation in the first half of 2025, whereas other regions continued to move away from coal. These developments, hi"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "IE", "alpha3": "IRL", "name_zh": "爱尔兰", "name_en": "Ireland"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:08.601281+00:00", "published_at_raw": "2025-08-27T09:57:42", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 12, "end": 17, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 22, "end": 27, "matched_text": "India", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 0, "end": 5, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 10, "end": 15, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "IE", "alpha3": "IRL", "name_zh": "爱尔兰", "name_en": "Ireland", "start": 459, "end": 466, "matched_text": "Ireland", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 639, "end": 641, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_ae142a63afe0bfe0faca", "record_id": "article_ae142a63afe0bfe0", "canonical_url": "https://insideclimatenews.org/news/26082025/colorado-river-indian-tribes-rights-of-nature", "publisher_url": "https://insideclimatenews.org/news/26082025/colorado-river-indian-tribes-rights-of-nature", "title_original": "The Colorado River Is This Tribe’s ‘Lifeblood,’ Now They Want To Give It the Same Legal Rights as a Person", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-26T09:00:00+00:00", "source_text": "In far western Arizona, the dusty beige expanse of desert stretches as far as the eye can see. Under the baking summer sun, which regularly pushes temperatures above 110 degrees in the summer, even scrubby desert bushes can struggle to survive. But in the middle of that desert, the Colorado River creates a striking strip […]", "text_kind": "source_excerpt", "text_characters": 326, "text_sha256": "292bac94e2c3d68ee58962aef79718aabf9052115f4223e808bcdeb5b9a6040b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:49.692014+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 147, "end": 158, "evidence": " stretches as far as the eye can see. Under the baking summer sun, which regularly pushes temperatures above 110 degrees in the summer, even scrubby desert bushes can struggle to survive. But in the middle of that desert, the Colorado River "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:49.706117+00:00", "published_at_raw": "2025-08-26T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_dfe6647f0c6b156d78b6", "record_id": "article_dfe6647f0c6b156d", "canonical_url": "https://yaleclimateconnections.org/2025/08/after-fernand-a-quiet-spell-on-tap-for-the-atlantic", "publisher_url": "https://yaleclimateconnections.org/2025/08/after-fernand-a-quiet-spell-on-tap-for-the-atlantic", "title_original": "After Fernand, a quiet spell on tap for the Atlantic", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-25T17:37:03+00:00", "source_text": "Tropical Storm Fernand, which developed on Saturday night southeast of Bermuda, is the Atlantic’s second system in a row that will avoid a direct landfall. As of 11 a.m. EDT Monday , Fernand was about 425 miles (685 kilometers) east-northeast of Bermuda, heading north-northeast at 13 mph (20 km/h). Fernand’s top sustained winds were up to 60 mph (95 km/h). Fernand was a highly asymmetric storm on Monday. As evident in the image at top, Fernand’s intense core of showers and thunderstorms was displaced southeast of the storm’s center. The northerly wind shear of around 15 knots that’s helping to tilt Fernand is expected to continue through Tuesday.", "text_kind": "article_excerpt", "text_characters": 654, "text_sha256": "1813255bc23a87cb40453cccf09a4dd5c95cdf63eb3dab6f75256c65789e6ff5", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:21.118775+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BM", "alpha3": "BMU", "name_zh": "百慕大", "name_en": "Bermuda"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BM", "alpha3": "BMU", "name_zh": "百慕大", "name_en": "Bermuda"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:21.158371+00:00", "published_at_raw": "2025-08-25T17:37:03", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BM", "alpha3": "BMU", "name_zh": "百慕大", "name_en": "Bermuda", "start": 71, "end": 78, "matched_text": "Bermuda", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_e9e68ee9b398fbe6e23e", "record_id": "article_e9e68ee9b398fbe6", "canonical_url": "https://insideclimatenews.org/news/24082025/fighting-for-environmental-justice-china-belt-and-road-zambia", "publisher_url": "https://insideclimatenews.org/news/24082025/fighting-for-environmental-justice-china-belt-and-road-zambia", "title_original": "The Woman Holding Chinese Mining Giants Accountable", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-24T09:00:00+00:00", "source_text": "Planet China: Fifth in a series about how Beijing’s trillion-dollar development plan is reshaping the globe—and the natural world. When Jingjing Zhang saw a string of urgent texts light up her phone, she knew something had gone wrong. Photo and video messages showed a tidal wave of brown sludge rushing into the Zambian countryside with horrifying […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "033c875982945c01fcbc56eef1358ddb0b306449f835176d2981af35912e4d43", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:54.703720+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "di