{"text_id": "text_efffaf1a0494bf4fb43c", "record_id": "article_efffaf1a0494bf4f", "canonical_url": "https://news.mongabay.com/2026/07/indigenous-advocates-push-for-rights-protections-around-ai-data-centers", "publisher_url": "https://news.mongabay.com/2026/07/indigenous-advocates-push-for-rights-protections-around-ai-data-centers", "title_original": "Indigenous advocates push for rights protections around AI data centers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-16T13:59:35+00:00", "source_text": "Artificial intelligence is said to be the transformative technology of our time, with the potential to reshape our world on a global scale, according to research. Yet AI’s potential is underpinned by the need for hyperscale data centers, the large, energy-intensive sites that house servers and IT equipment. As tech companies and governments continue to […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "8fb379a99764b5153f6c9711752774ab0f190c4fa82f7750acd503177e935214", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:38.059194+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 249, "end": 255, "evidence": "ch. Yet AI’s potential is underpinned by the need for hyperscale data centers, the large, energy-intensive sites that house servers and IT equipment. As tech companies and governments continue to […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:38.071463+00:00", "published_at_raw": "2026-07-16T13:59:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_dc36ac02aebfcc71b088", "record_id": "article_dc36ac02aebfcc71", "canonical_url": "https://yaleclimateconnections.org/2026/07/families-like-mine-industrialized-the-south-we-paid-the-price-in-air-pollution", "publisher_url": "https://yaleclimateconnections.org/2026/07/families-like-mine-industrialized-the-south-we-paid-the-price-in-air-pollution", "title_original": "Families like mine industrialized the South. We paid the price in air pollution.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-15T11:00:00+00:00", "source_text": "As a kid, I remember the mornings when the air carried a metallic smell, before I had the language to understand what it meant. I grew up in Birmingham, Alabama, in a family of generations of steel and domestic workers. As the city expanded through mines and plants that produced fuel for the rest of the country, my ancestors labored. They helped build the industrial backbone that made the city prosperous. But like too many Black families who have roots in this region, we were segregated into specific neighborhoods, often closest to coke fuel plants, steel facilities, and contaminated sites. From slavery to steel production, growth in this country has too often required Black communities to bear disproportionate risk. The geography of pollution was not accidental – it was policy.", "text_kind": "article_excerpt", "text_characters": 789, "text_sha256": "ea066c9c87c9f5ed8d164a101217e370fffe02e5c3cd061a47b5765d0ad21972", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:45.565664+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 192, "end": 197, "evidence": "understand what it meant. I grew up in Birmingham, Alabama, in a family of generations of steel and domestic workers. As the city expanded through mines and plants that produced fuel for the rest of the country, my ancestors labored. T"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:45.588256+00:00", "published_at_raw": "2026-07-15T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_dac48a9151402bab495b", "record_id": "article_dac48a9151402bab", "canonical_url": "https://news.mongabay.com/2026/07/bear-dar-aims-to-give-arctic-communities-a-heads-up-on-nearby-polar-bears", "publisher_url": "https://news.mongabay.com/2026/07/bear-dar-aims-to-give-arctic-communities-a-heads-up-on-nearby-polar-bears", "title_original": "‘Bear-dar’ aims to give Arctic communities a heads-up on nearby polar bears", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-15T09:02:35+00:00", "source_text": "How do you spot polar bears in the vast, and often dark, wilderness of the Arctic? Enter Bear-dar. This AI-driven radar system scans the landscape to spot approaching polar bears. The technology was developed by the nonprofit Polar Bears International in collaboration with U.S.-based security firm Spotter Global in a bid to mitigate encounters between […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "72b7ffeafd8550ead3e1b7a2d9b2e5461129a6675d7e9bd45d1a1322fc0e9ef9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:38.340762+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:38.357113+00:00", "published_at_raw": "2026-07-15T09:02:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 274, "end": 278, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_b50498a60ea744eab30a", "record_id": "article_b50498a60ea744ea", "canonical_url": "https://news.mongabay.com/2026/07/bill-montevecchi-showed-what-seabirds-could-tell-us-about-the-sea", "publisher_url": "https://news.mongabay.com/2026/07/bill-montevecchi-showed-what-seabirds-could-tell-us-about-the-sea", "title_original": "Bill Montevecchi showed what seabirds could tell us about the sea", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-15T02:50:00+00:00", "source_text": "The North Atlantic can look empty until someone begins paying attention. A stretch of gray water off Newfoundland may hold only a few white specks at first glance. Through binoculars those specks become murres riding the swell, puffins carrying fish crosswise in their bills, or fulmars riding the wind above the waves. To Bill Montevecchi, […]", "text_kind": "source_excerpt", "text_characters": 344, "text_sha256": "b0028f66739974dbeb3cc8cbb073258a0d713962ea3579ea033b368f4d99ea59", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:38.363758+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:38.378706+00:00", "published_at_raw": "2026-07-15T02:50:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_02065a3211f483ed5e5d", "record_id": "article_02065a3211f483ed", "canonical_url": "https://news.mongabay.com/2026/07/research-offers-nature-positive-path-to-end-and-reverse-biodiversity-loss", "publisher_url": "https://news.mongabay.com/2026/07/research-offers-nature-positive-path-to-end-and-reverse-biodiversity-loss", "title_original": "Research offers nature-positive path to end and reverse biodiversity loss", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-14T15:05:31+00:00", "source_text": "From its nests high in the canopy of the Amazon, the harpy eagle depends on — and is critical to — the health of the forest around it. The species controls the numbers of animals such as sloths and monkeys that, unchecked, could consume too many leaves and turn the canopy into lace. But the […]", "text_kind": "source_excerpt", "text_characters": 295, "text_sha256": "683ac49a7b1e0849cea7e54bcf383f9cbabea14a5a54e37b02022aac95d2584a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:38.530095+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:38.547586+00:00", "published_at_raw": "2026-07-14T15:05:31", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_6f861bd3af8c8a413b96", "record_id": "article_6f861bd3af8c8a41", "canonical_url": "https://insideclimatenews.org/news/14072026/europe-turns-to-russia-as-atlantic-mackerel-supply-plummets", "publisher_url": "https://insideclimatenews.org/news/14072026/europe-turns-to-russia-as-atlantic-mackerel-supply-plummets", "title_original": "Europe Opens a New Front in the Mackerel Wars", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-14T08:50:00+00:00", "source_text": "Norway, Denmark, Iceland, the United Kingdom, the European Union and Russia all share the world’s largest and most lucrative Atlantic mackerel supply, an industry valued at more than $1 billion annually. But they can’t agree on who gets what slice of the pie. In the midst of the disagreement, the population of adult mackerel has […]", "text_kind": "source_excerpt", "text_characters": 334, "text_sha256": "4049e3b396f35b6ba9b9251f266a4ace1a8e0d656f82d3a196ba3e2dcab6812f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:45.032758+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$1 billion", "start": 183, "end": 193, "evidence": "Norway, Denmark, Iceland, the United Kingdom, the European Union and Russia all share the world’s largest and most lucrative Atlantic mackerel supply, an industry valued at more than $1 billion annually.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alp