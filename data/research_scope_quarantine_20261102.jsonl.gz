{"text_id": "text_4970569ed2f68fb25702", "record_id": "article_4970569ed2f68fb2", "canonical_url": "https://insideclimatenews.org/news/05022024/is-the-current-hurricane-warning-system-outdated", "publisher_url": "https://insideclimatenews.org/news/05022024/is-the-current-hurricane-warning-system-outdated", "title_original": "Is The Current Hurricane Warning System Outdated?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-05T20:21:44+00:00", "source_text": "As Typhoon Haiyan howled into the Philippines in November 2013, people knew that a powerful storm was coming, but they were not expecting a typhoon with 196 mile per hour winds, driving a storm surge up to 23 feet high. Haiyan killed more than 6,300 people, destroyed or damaged more than 1 million structures and […]", "text_kind": "source_excerpt", "text_characters": 317, "text_sha256": "4fc5406350220b9bb217d09d0cc5bf0f1b09b693b073737a7f90d0ea4d5b030c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:33.415352+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "1 million", "start": 289, "end": 298, "evidence": " Haiyan killed more than 6,300 people, destroyed or damaged more than 1 million structures and […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:33.427502+00:00", "published_at_raw": "2024-02-05T20:21:44", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines", "start": 34, "end": 45, "matched_text": "Philippines", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_28b40f029fc94624d2fd", "record_id": "article_28b40f029fc94624", "canonical_url": "https://yaleclimateconnections.org/2024/02/everything-was-messed-up-nycs-day-cares-grapple-with-flooding", "publisher_url": "https://yaleclimateconnections.org/2024/02/everything-was-messed-up-nycs-day-cares-grapple-with-flooding", "title_original": "‘Everything was messed up’: NYC’s day cares grapple with flooding", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-02T12:00:00+00:00", "source_text": "Over 2,000 licensed child care providers in the city use homes with basements for classrooms, offices, and storage, leaving them damage-prone when heavy rains strike.", "text_kind": "source_excerpt", "text_characters": 166, "text_sha256": "868b6cadf843c70bacffb8fb6d79c324267150ecd7ba17b68a17c90d9de3d336", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:34.808594+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:34.841249+00:00", "published_at_raw": "2024-02-02T12:00:00", "sample_frame": "public_archives_20261102", "sampli