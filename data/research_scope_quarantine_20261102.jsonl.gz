{"text_id": "text_40368a58b98a50586104", "record_id": "article_40368a58b98a5058", "canonical_url": "https://insideclimatenews.org/news/16052024/inside-clean-energy-landmark-interstate-transmission-rule", "publisher_url": "https://insideclimatenews.org/news/16052024/inside-clean-energy-landmark-interstate-transmission-rule", "title_original": "This Week’s Landmark Transmission Rule Forces Utilities to Take the Long View", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-16T13:00:00+00:00", "source_text": "A new rule requires U.S. utilities and grid operators to work together on long-term planning for transmission lines—the large power lines that deliver electricity across regions. The rule is part of an order issued Monday from the Federal Energy Regulatory Commission that is trying to drag the nation’s power system into a new era in […]", "text_kind": "source_excerpt", "text_characters": 338, "text_sha256": "6a26475212a741307887b46821d87a9e2635edf1190704ea0402d0e61b050fce", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:49.904731+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 239, "end": 245, "evidence": "r electricity across regions. The rule is part of an order issued Monday from the Federal Energy Regulatory Commission that is trying to drag the nation’s power system into a new era in […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:49.936883+00:00", "published_at_raw": "2024-05-16T13:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 20, "end": 24, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_91baaa80ebdad80addbc", "record_id": "article_91baaa80ebdad80a", "canonical_url": "https://yaleclimateconnections.org/2024/05/storms-rising-seas-are-growing-threats-to-portsmouth-village-in-north-carolina", "publisher_url": "https://yaleclimateconnections.org/2024/05/storms-rising-seas-are-growing-threats-to-portsmouth-village-in-north-carolina", "title_original": "Storms, rising seas are growing threats to Portsmouth Village in North Carolina", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-16T11:00:00+00:00", "source_text": "For centuries, ships have sailed past North Carolina’s picturesque Cape Lookout Lighthouse. And in colonial times, they often stopped in Portsmouth Village. Today, the lighthouse and village are part of the Cape Lookout National Seashore . Many of the buildings have been preserved. But increasingly, extreme weather puts them at risk. In 2019, Hurricane Dorian damaged dozens of historical buildings. And while tourists can still visit the old Portsmouth Village, rising seas are creeping in. Seekamp: “There can be standing water in the village nearly any day of the year.” Erin Seekamp is a coastal expert at North Carolina State University. By gathering community input, she’s helping decision-makers weigh the trade-offs of various strategies to protect the historical buildings.", "text_kind": "article_excerpt", "text_characters": 784, "text_sha256": "f496ae0d6f4b650ebf2c52f463316c512a6017d1dfbc2d1a603c3d9eeca7650d", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:59.209256+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:59.261681+00:00", "published_at_raw": "2024-05-16T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_06b8ba138fa99288c255", "record_id": "article_06b8ba138fa99288", "canonical_url": "https://news.mongabay.com/2024/05/twilight-zone-fishing-can-we-fish-the-oceans-mesopelagic-layer", "publisher_url": "https://news.mongabay.com/2024/05/twilight-zone-fishing-can-we-fish-the-oceans-mesopelagic-layer", "title_original": "Twilight zone fishing: Can we fish the ocean’s mesopelagic layer?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-15T18:52:27+00:00", "source_text": "Two hundred meters below the surface of the sea is a cold, faintly lit layer of water known as the mesopelagic, or twilight, zone. Here lives a menagerie of peculiar-looking creatures: blue-glowing plankton and squid; spindly fish flashing kaleidoscopes of colors, some baring rows of barbed teeth. Many of these creatures lurk in this region’s […]", "text_kind": "source_excerpt", "text_characters": 348, "text_sha256": "b1a6207a06e86a376b623f09d991d61b6b9aa6143ab5cd4c6affc24f2f0408bd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:27.000396+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:27.028004+00:00", "published_at_raw": "2024-05-15T18:52:27", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
