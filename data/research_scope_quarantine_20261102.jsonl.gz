{"text_id": "text_77df214ae702531ef2da", "record_id": "article_77df214ae702531e", "canonical_url": "https://insideclimatenews.org/news/12032026/trump-brownsville-texas-oil-refinery", "publisher_url": "https://insideclimatenews.org/news/12032026/trump-brownsville-texas-oil-refinery", "title_original": "Trump Claims Indian Investment Will Make Long-Standing Plans for Brownsville Refinery a Reality", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-12T22:26:47+00:00", "source_text": "Trump claimed a “massive win” this week when he announced that the Indian private energy company Reliance Industries is investing in a proposed oil refinery in Brownsville, Texas. Trump took to his social media platform Truth Social to announce the “FIRST new U.S. Oil Refinery in 50 YEARS” would be built in the coastal city. […]", "text_kind": "source_excerpt", "text_characters": 330, "text_sha256": "81e6dd666138f2389e4e0b06932962ffc9ac97e66b79c98607f6adae7c8458e5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:27.594395+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 82, "end": 88, "evidence": "Trump claimed a “massive win” this week when he announced that the Indian private energy company Reliance Industries is investing in a proposed oil refinery in Brownsville, Texas. Trump took to his social media platform Truth So"}], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 135, "end": 143, "evidence": "he announced that the Indian private energy company Reliance Industries is investing in a proposed oil refinery in Brownsville, Texas. Trump took to his social media platform Truth Social to announce the “FIRST new U.S. Oil Refinery in 50"}], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:27.654770+00:00", "published_at_raw": "2026-03-12T22:26:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 173, "end": 178, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_5005b7e7e0a260b8c66f", "record_id": "article_5005b7e7e0a260b8", "canonical_url": "https://news.mongabay.com/2026/03/if-florida-reefs-arent-protected-storms-will-increase-flooding-costs-study", "publisher_url": "https://news.mongabay.com/2026/03/if-florida-reefs-arent-protected-storms-will-increase-flooding-costs-study", "title_original": "If Florida reefs aren’t protected, storms will increase flooding & costs: Study", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-12T15:54:26+00:00", "source_text": "Healthy reefs aren’t just about colorful fish — they also shield shorelines from intense tropical storms. If Florida’s reefs keep degrading, flooding during tropical storms could get much worse, increasing risks to people and costing nearly a billion dollars a year in damage to buildings and economic disruption annually, a new Earth’s Future study finds. […]", "text_kind": "source_excerpt", "text_characters": 360, "text_sha256": "22ce1b150270ac51aa1c697831739f31eee4d0f65562f03b3c140a257bc4e858", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:46.256475+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 141, "end": 146, "evidence": "y also shield shorelines from intense tropical storms. If Florida’s reefs keep degrading, flooding during tropical storms could get much worse, increasing risks to people and costing nearly a billion dollars a year in damage to buildin"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:46.285938+00:00", "published_at_raw": "2026-03-12T15:54:26", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_83120225a4906ea60d95", "record_id": "article_83120225a4906ea6", "canonical_url": "https://news.mongabay.com/2026/03/brazil-supreme-court-opens-path-to-mining-in-indigenous-land-for-first-time", "publisher_url": "https://news.mongabay.com/2026/03/brazil-supreme-court-opens-path-to-mining-in-indigenous-land-for-first-time", "title_original": "Brazil Supreme Court opens path to mining in Indigenous land for first time", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-11T18:05:22+00:00", "source_text": "On Feb. 3, at the request of an association of the Indigenous Cinta Larga people in the Amazon, the Brazilian Supreme Court authorized the possibility of mining exploration and exploitation inside an Indigenous territory for the first time. While the decision does not automatically authorize mining in the Cinta Larga Indigenous territory, it has set […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "57dcf1e9a59bfa7baae1c75d1d51921609c6e586997166b94cd57d4e9cf574b4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:46.504586+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 51, "end": 61, "evidence": "On Feb. 3, at the request of an association of the Indigenous Cinta Larga people in the Amazon, the Brazilian Supreme Court authorized the possibility of mining exploration and exploitation inside an I"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:46.532481+00:00", "published_at_raw": "2026-03-11T18:05:22", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 0, "end": 6, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_763379f603769794f1d7", "record_id": "article_763379f603769794", "canonical_url": "https://yaleclimateconnections.org/2026/03/february-2026-was-earths-fifth-warmest-february-on-record", "publisher_url": "https://yaleclimateconnections.org/2026/03/february-2026-was-earths-fifth-warmest-february-on-record", "title_original": "February 2026 was Earth’s fifth-warmest February on record", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-11T17:59:14+00:00", "source_text": "Despite the lack of a planet-warming El Niño event, global ocean temperatures were the second-warmest on record in February, behind only the El Niño year of 2024.", "text_kind": "source_excerpt", "text_characters": 162, "text_sha256": "effe1cc5028cda464a62c94fa8cd6073a13aa8c4fd5ffe8b94ccd9eb5d9d89bf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:25.415858+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 29, "end": 36, "evidence": "Despite the lack of a planet-warming El Niño event, global ocean temperatures were the second-warmest on record in February, behind only the El Niño year of 2024."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:25.425616+00:00", "published_at_raw": "2026-03-11T17:59:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_86af97035670a9a7b9a4", "record_id": "article_86af97035670a9a7", "canonical_url": "https://news.mongabay.com/2026/03/plastic-from-home-and-abroad-spills-into-turkiyes-waters", "publisher_url": "https://news.mongabay.com/2026/03/plastic-from-home-and-abroad-spills-into-turkiyes-waters", "title_original": "Plastic, from home and abroad, spills into Türkiye’s waters", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-11T16:59:37+00:00", "source_text": "ADANA, Türkiye — Along the final stretch of the Seyhan River, in southern Türkiye, plastic bits in various colors dot the water and sediment. When the river bends, shredded plastic, degraded by the elements, forms large gray patches. Downstream, where the Seyhan flows into Mersin Bay, debris large enough to display clues to its origin […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "6fb2e413ee80249ae9f457f841c77bb4c70c5fad65352103cb5b71f5e8412d06", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:46.565122+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "TR", "alpha3": "TUR", "name_zh": "土耳其", "name_en": "Türkiye"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "TR", "alpha3": "TUR", "name_zh": "土耳其", "name_en": "Türkiye"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_