{"text_id": "text_fa27cf30985a5f0ed5c7", "record_id": "article_fa27cf30985a5f0e", "canonical_url": "https://insideclimatenews.org/news/10032026/todays-climate-kenya-floods-climate-whiplash", "publisher_url": "https://insideclimatenews.org/news/10032026/todays-climate-kenya-floods-climate-whiplash", "title_original": "Following Months of Drought, Floods in Kenya Kill More Than 40 People", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-10T20:50:56+00:00", "source_text": "After months of intense drought conditions, Kenya was inundated by rain late last week, triggering severe flooding that killed more than 40 people. In the country’s capital city, Nairobi, a month’s worth of rain fell in 24 hours. “The ongoing flooding in parts of Nairobi and several other areas of our country has caused immense […]", "text_kind": "source_excerpt", "text_characters": 333, "text_sha256": "1450c30f6d79b490ad31de3b3240bf600309aca0533220a362fc2b85e91f76bf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:33.181351+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 24, "end": 31, "evidence": "After months of intense drought conditions, Kenya was inundated by rain late last week, triggering severe flooding that killed more than 40 people. In the country’s capita"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:33.207581+00:00", "published_at_raw": "2026-03-10T20:50:56", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 39, "end": 44, "matched_text": "Kenya", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 44, "end": 49, "matched_text": "Kenya", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_73d7d39532c802099f3d", "record_id": "article_73d7d39532c80209", "canonical_url": "https://yaleclimateconnections.org/2026/03/5-ways-to-cut-back-on-gas", "publisher_url": "https://yaleclimateconnections.org/2026/03/5-ways-to-cut-back-on-gas", "title_original": "5 ways to cut back on gas", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-10T19:07:29+00:00", "source_text": "It might be time to fix up your rusty old bike. Gasoline prices are already spiking in what The Wall Street Journal (paywall) calls “the most severe energy crisis since the 1970s.” In response to bombing by the U.S. and Israel, Iran attacked vessels in the Strait of Hormuz, a chokepoint through which roughly 20% of the world’s oil normally flows. As a result, most shipping traffic in the strait has halted. “We are looking at what is by far the biggest disruption in world history in terms of daily oil production,” energy historian Daniel Yergin told The Wall Street Journal.", "text_kind": "article_excerpt", "text_characters": 579, "text_sha256": "8e3e5085833270514eca796683129bf3802182f36fa4f2a3d8e54a865da346fb", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:25.463468+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "20%", "start": 310, "end": 313, "evidence": " and Israel, Iran attacked vessels in the Strait of Hormuz, a chokepoint through which roughly 20% of the world’s oil normally flows.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}, {"alpha2": "IL", "alpha3": "ISR", "name_zh": "以色列", "name_en": "Israel"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 149, "end": 155, "evidence": "ices are already spiking in what The Wall Street Journal (paywall) calls “the most severe energy crisis since the 1970s.” In response to bombing by the U.S. and Israel, Iran attacked vessels in the Strait of Hormuz, a chokepoint through"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}, {"alpha2": "IL", "alpha3": "ISR", "name_zh": "以色列", "name_en": "Israel"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:25.482252+00:00", "published_at_raw": "2026-03-10T19:07:29", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 211, "end": 215, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "IL", "alpha3": "ISR", "name_zh": "以色列", "name_en": "Israel", "start": 220, "end": 226, "matched_text": "Israel", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran", "start": 228, "end": 232, "matched_text": "Iran", "method": "country-span-v2", "source_field": "sourc