{"text_id": "text_8164474f74af43bee44b", "record_id": "article_8164474f74af43be", "canonical_url": "https://news.mongabay.com/2024/11/we-need-an-indigenous-conservation-state-of-mind-commentary", "publisher_url": "https://news.mongabay.com/2024/11/we-need-an-indigenous-conservation-state-of-mind-commentary", "title_original": "We need an Indigenous conservation state of mind (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-28T15:11:36+00:00", "source_text": "Scientists agree that the biodiversity crisis we face today may be one of the most disruptive events in Earth’s history. The response so far has been for hundreds of billions in government and philanthropic donor funds – along with trillions in private sector investment capital – to be dedicated to conservation, primarily for nature conservation […]", "text_kind": "source_excerpt", "text_characters": 351, "text_sha256": "4131342007e91fe8ce16f24525d105dba17acddda222116b9d50dd46e6abb016", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:46.831469+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_a