{"text_id": "text_0059841cee394d047c28", "record_id": "article_0059841cee394d04", "canonical_url": "https://insideclimatenews.org/news/04032026/durham-nc-brenntag-drinking-water-contaminants", "publisher_url": "https://insideclimatenews.org/news/04032026/durham-nc-brenntag-drinking-water-contaminants", "title_original": "A Global Chemical Giant Racks Up Violations in Durham, N.C., Where Drinking Water for a Million Is Threatened", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-04T09:55:00+00:00", "source_text": "DURHAM, N.C.—Brenntag Mid-South continues to amass serious environmental violations related to its chemical repackaging plant in East Durham, where state inspectors cited the company in November for failing to clean up leaking barrels on the property. Recent testing also shows a chemical cocktail continues to enter a neighborhood stream that runs behind an elementary school, […]", "text_kind": "source_excerpt", "text_characters": 381, "text_sha256": "49da8aed21e8bdaaad68ff5da549486c555ece76231330ac576061557bda56f9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:35.040791+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_sour