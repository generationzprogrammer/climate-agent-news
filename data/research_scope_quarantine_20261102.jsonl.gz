{"text_id": "text_250e8a414bec98609c96", "record_id": "article_250e8a414bec9860", "canonical_url": "https://dialogue.earth/en/business/beyond-the-belt-and-road-whats-next-for-the-eu-in-latin-america", "publisher_url": "https://dialogue.earth/en/business/beyond-the-belt-and-road-whats-next-for-the-eu-in-latin-america", "title_original": "Beyond the Belt and Road? What’s next for the EU in Latin America", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-26T10:36:28+00:00", "source_text": "A year after billions in investments were launched in the region, opinion is mixed on the prospects for the Global Gateway, the EU’s answer to the Chinese initiative", "text_kind": "source_excerpt", "text_characters": 165, "text_sha256": "48d55a0a8d0d11ff199acc1a7f4768832595ca0d9933699c3d8a1ec0d710f967", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:59.700751+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T