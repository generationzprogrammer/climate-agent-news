{"text_id": "text_eaddaef94c735ceead71", "record_id": "article_eaddaef94c735cee", "canonical_url": "https://insideclimatenews.org/news/09072026/nyc-bronx-air-quality-remains-a-problem", "publisher_url": "https://insideclimatenews.org/news/09072026/nyc-bronx-air-quality-remains-a-problem", "title_original": "NYC Invests in Air Quality, but the Bronx Still Can’t Breathe Easy", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-09T09:00:00+00:00", "source_text": "NEW YORK—When Mayor Zohran Mamdani announced that $20 million from the city’s congestion pricing revenue would be redirected to fight childhood asthma in the Bronx, Javier Marchand celebrated. But Marchand, the air quality advocate for the community advocacy group South Bronx Unite, knows the new funding will not be enough to fix the pollution problem […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "9ad8ce14f499a4d7272a20b8a6d978f3cc0de862c2ec1bea4a22a6bb1ca192fc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:45.763069+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$20 million", "start": 50, "end": 61, "evidence": "NEW YORK—When Mayor Zohran Mamdani announced that $20 million from the city’s congestion pricing revenue would be redirected to fight childhood asthma in the Bronx, Javier Marchand celebrated.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governanc