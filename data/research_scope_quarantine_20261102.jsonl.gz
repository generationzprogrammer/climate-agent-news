{"text_id": "text_28caf94a12b82e0ef862", "record_id": "article_28caf94a12b82e0e", "canonical_url": "https://news.mongabay.com/2024/03/this-years-ranking-of-ev-carmakers-from-most-to-least-clean-report", "publisher_url": "https://news.mongabay.com/2024/03/this-years-ranking-of-ev-carmakers-from-most-to-least-clean-report", "title_original": "This year’s ranking of EV carmakers from most to least ‘clean’: Report", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-28T18:52:44+00:00", "source_text": "Ford and Mercedes-Benz lead the automotive world in working to clean up their supply chains, according to a new report with rankings endorsed by a labor and environmental civil society coalition. But the car industry is far from achieving a “truly clean car” and progress is “lackluster,” the scorecard notes. Car companies are increasingly embracing […]", "text_kind": "source_excerpt", "text_characters": 354, "text_sha256": "8d276606fc9314698c8d2a591d6deb439d5bf8b5f577ae4235de081c65ae12be", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:52.441684+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 185, "end": 189, "evidence": "cording to a new report with rankings endorsed by a labor and environmental civil society coalition. But the car industry is far from achieving a “truly clean car” and progress is “lackluster,” the scorecard notes. Car companies are i"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:52.454849+00:00", "published_at_raw": "2024-03-28T18:52:44", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_088d7e92922a16bd3db5", "record_id": "article_088d7e92922a16bd", "canonical_url": "https://news.mongabay.com/2024/03/study-identifies-species-with-a-long-history-but-short-future-amid-threats", "publisher_url": "https://news.mongabay.com/2024/03/study-identifies-species-with-a-long-history-but-short-future-amid-threats", "title_original": "Study identifies species with a long history but short future amid threats", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-28T09:05:33+00:00", "source_text": "Over the past 4 billion years, lifeforms have evolved into the spectacular array of species that now inhabit the planet. While many species radiated into extensive families of closely related species, others are so unique that they alone embody millions of years of evolutionary history — sole representatives of entire lineages of the tree of […]", "text_kind": "source_excerpt", "text_characters": 347, "text_sha256": "3a692457c6146ffacd217f1776d2e03855d80ae0c8c3aa0a66cdbe7a0b377ec1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:52.537046+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "4 billion", "start": 14, "end": 23, "evidence": "Over the past 4 billion years, lifeforms have evolved into the spectacular array of species that now inhabit the planet.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "p