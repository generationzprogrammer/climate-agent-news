{"text_id": "text_e94e4bb8ced82f832ddb", "record_id": "article_e94e4bb8ced82f83", "canonical_url": "https://news.mongabay.com/2024/01/2023-fires-increase-fivefold-in-indonesia-amid-el-nino", "publisher_url": "https://news.mongabay.com/2024/01/2023-fires-increase-fivefold-in-indonesia-amid-el-nino", "title_original": "2023 fires increase fivefold in Indonesia amid El Niño", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-10T05:44:17+00:00", "source_text": "JAKARTA — Fires razed nearly 1 million hectares (2.47 million acres) of lands and forests in Indonesia in 2023, as the country suffered from unusually scorching weather due to El Niño and burning for new plantations. Data from the Ministry of Environment and Forestry show that as many as 994,313.18 hectares — an area 15 […]", "text_kind": "source_excerpt", "text_characters": 325, "text_sha256": "021573c5cc79278077165b49b36f60d5b40f82b43282722e956bbd4dcfbbced3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:29.450313+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "1 million", "start": 29, "end": 38, "evidence": "JAKARTA — Fires razed nearly 1 million hectares (2.", "interpretation": "not_classified"}, {"value_text": "2.47 million", "start": 49, "end": 61, "evidence": "JAKARTA — Fires razed nearly 1 million hectares (2.47 million acres) of lands and forests in Indonesia in 2023, as the country suffered from unusually scorching weather due to El Niño and burning for new plantations.", "interpretation": "not_classified"}], "conference_ids": [], "age