{"text_id": "text_4bc44542a6fbb14eba1d", "record_id": "article_4bc44542a6fbb14e", "canonical_url": "https://news.mongabay.com/2024/03/report-links-pulpwood-estate-clearing-bornean-orangutan-habitat-to-rge-group", "publisher_url": "https://news.mongabay.com/2024/03/report-links-pulpwood-estate-clearing-bornean-orangutan-habitat-to-rge-group", "title_original": "Report links pulpwood estate clearing Bornean orangutan habitat to RGE Group", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-27T18:18:42+00:00", "source_text": "JAKARTA — Indonesia is experiencing a resurgence in forest clearance due to the expansion of pulpwood and oil palm plantations, reversing years of declining deforestation associated with these two industries. And at the forefront of this new wave of deforestation is a single company identified in a report by a coalition of environmental NGOs that […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "418d066357a12732237460191409d70f07a0dbbf68fc6c2e49ed751dc626a717", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:52.583375+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 312, "end": 316, "evidence": "refront of this new wave of deforestation is a single company identified in a report by a coalition of environmental NGOs that […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:52.597928+00:00", "published_at_raw": "2024-03-27T18:18:42", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 10, "end": 19, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_7ee2bb6337b0fc7c3f6f", "record_id": "article_7ee2bb6337b0fc7c", "canonical_url": "https://news.mongabay.com/2024/03/we-need-rapid-response-support-for-indigenous-peoples-in-the-face-of-growing-extreme-weather-events-commentary", "publisher_url": "https://news.mongabay.com/2024/03/we-need-rapid-response-support-for-indigenous-peoples-in-the-face-of-growing-extreme-weather-events-commentary", "title_original": "We need rapid response support for Indigenous peoples in the face of growing extreme weather events (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-27T16:58:29+00:00", "source_text": "In recent weeks, Rainforest Foundation UK (RFUK) has seen Indigenous peoples and local communities we work with in the Peruvian Amazon and the Congo Basin devastated by unprecedented rains. In Peru, the Ene River recently burst its banks, leaving hundreds of Asháninka families in desperate need of food, drinking water and shelter. In a cruel […]", "text_kind": "source_excerpt", "text_characters": 347, "text_sha256": "68be9d85b5e69567ff200b6794bb5893b0bbc16b3b98a90a2fabe19707cd944f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:52.604562+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 58, "end": 68, "evidence": "In recent weeks, Rainforest Foundation UK (RFUK) has seen Indigenous peoples and local communities we work with in the Peruvian Amazon and the Congo Basin devastated by unprecedented rains. In Peru, the Ene R"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:52.617277+00:00", "published_at_raw": "2024-03-27T16:58:29", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 39, "end": 41, "matched_text": "UK", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru", "start": 193, "end": 197, "matched_text": "Peru", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_ad2e00a6a9eb176f7f36", "record_id": "article_ad2e00a6a9eb176f", "canonical_url": "https://news.mongabay.com/2024/03/smaller-population-estimate-underscores-urgency-of-saving-cao-vit-gibbon", "publisher_url": "https://news.mongabay.com/2024/03/smaller-population-estimate-underscores-urgency-of-saving-cao-vit-gibbon", "title_original": "Smaller population estimate underscores urgency of saving Cao-vit gibbon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-27T15:47:18+00:00", "source_text": "The Cao-vit gibbon is one of the most critically endangered apes in the world, with its entire population living in a single patch of protected forest on the border between northern Vietnam and southern China. Until recently, population estimates for the species stood at 120. Now, a new study published in the journal Nature, calculates […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "6c6bf5fa9d13a41ff7baa0da4bf749d1324d358c4f7f357763db3538daa7c846", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:52.644910+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "VN", "alpha3": "VNM", "name_zh": "越南", "name_en": "Vietnam"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "VN", "alpha3": "VNM", "name_zh": "越南", "name_en": "Vietnam"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:52.657793+00:00", "published_at_raw": "2024-03-27T15:47:18", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "VN", "alpha3": "VNM", "name_zh": "越南", "name_en": "Vietnam", "start": 182, "end": 189, "matched_text": "Vietnam", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 203, "end": 208, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_7c1e743bd5a524bbcd25", "record_id": "article_7c1e743bd5a524bb", "canonical_url": "https://yaleclimateconnections.org/2024/03/after-a-hurricane-or-wildfire-communities-can-be-overwhelmed-by-debris", "publisher_url": "https://yaleclimateconnections.org/2024/03/after-a-hurricane-or-wildfire-communities-can-be-overwhelmed-by-debris", "title_original": "After a hurricane or wildfire, communities can be overwhelmed by debris", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-27T11:00:00+00:00", "source_text": "After a hurricane, flood, or wildfire, communities face a long process of rebuilding. But in the immediate aftermath of a disaster, there’s a lot of debris lying around — sometimes more waste than a community would typically produce all year. Townsend: “You get buildings that are destroyed. You get lots and lots of earth and trees and other debris which now need to be cleaned up and moved somewhere.” Timothy Townsend is an environmental engineer at the University of Florida. He says some of this debris can be dangerous. For example, some of the ash from last year’s Maui fires has high levels of toxic arsenic — likely from volcanic soils, old building materials, and herbicides that were once commonly used on nearby farms.", "text_kind": "article_excerpt", "text_characters": 730, "text_sha256": "b8704112742a9b1514d1ea5404db4383327c6103ab078b2d6934d9b6420af8dd", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:13.127547+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 19, "end": 24, "evidence": "After a hurricane, flood, or wildfire, communities face a long process of rebuilding. But in the immediate aftermath of a disaster, there’s a lot of debris lying ar"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:13.143993+00:00", "published_at_raw": "2024-03-27T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_bc76846130f5283d4133", "record_id": "article_bc76846130f5283d", "canonical_url": "https://insideclimatenews.org/news/27032024/ceraweek-oil-gas-executives-blast-lng-pause", "publisher_url": "https://insideclimatenews.org/news/27032024/ceraweek-oil-gas-executives-blast-lng-pause", "title_original": "Oil and Gas Executives Blast ‘LNG Pause,’ Call Natural Gas a ‘Destination Fuel’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-27T09:05:00+00:00", "source_text": "HOUSTON—When U.S. Secretary of Energy Jennifer Granholm addressed oil and gas executives last week at CERAWeek by S&P Global, one of the energy industry’s largest conferences, the response was tepid, at best. “You can applaud that,” a seemingly exasperated Granholm told a demur crowd of hundreds seated to a white tablecloth luncheon at the Hilton-Americas […]", "text_kind": "source_excerpt", "text_characters": 361, "text_sha256": "c737e506f21fd11ef85fc8ceeaab150373e8b549b5a7f22b988c167b9052b7fc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:11.941526+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 31, "end": 37, "evidence": "HOUSTON—When U.S. Secretary of Energy Jennifer Granholm addressed oil and gas executives last week at CERAWeek by S&P Global, one of the energy industry’s largest conferences, t"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:11.958075+00:00", "published_at_raw": "2024-03-27T09:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 13, "end": 17, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_43895905a777ea3a30fc", "record_id": "article_43895905a777ea3a", "canonical_url": "https://news.mongabay.com/2024/03/tanzanias-mountain-of-millipedes-yields-six-new-species-helping-to-track-rainforest-recovery", "publisher_url": "https://news.mongabay.com/2024/03/tanzanias-mountain-of-millipedes-yields-six-new-species-helping-to-track-rainforest-recovery", "title_original": "Tanzania’s ‘mountain of millipedes’ yields six new species", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-26T21:35:35+00:00", "source_text": "Scientists have recently described six new species of millipedes, including one from an entirely new genus, in Tanzania’s Eastern Arc Mountains. This brings the number of new species found in the Udzungwa Mountiains since 2014 to 81 — further confirming the rich biodiversity of these isolated mountain blocks. The newly-described millipedes are helping researchers to […]", "text_kind": "source_excerpt", "text_characters": 372, "text_sha256": "380bf8c76817bf5d222893301c42dc3076bc6a6f298168d36889c913a5c31ea3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:57.201250+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:57.214800+00:00", "published_at_raw": "2024-03-26T21:35:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania", "start": 0, "end": 8, "matched_text": "Tanzania", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania", "start": 111, "end": 119, "matched_text": "Tanzania", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_5f85f3505707f2bbc933", "record_id": "article_5f85f3505707f2bb", "canonical_url": "https://news.mongabay.com/2024/03/agroforestry-project-sows-seeds-of-hope-in-drought-hit-honduras", "publisher_url": "https://news.mongabay.com/2024/03/agroforestry-project-sows-seeds-of-hope-in-drought-hit-honduras", "title_original": "Agroforestry project sows seeds of hope in drought-hit Honduras", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-26T15:30:54+00:00", "source_text": "Ivis Rene Cabrera no longer gazes up at the sky in hopes of rain to irrigate his field. He’s come to expect the long dry spells as northwestern Honduras grapples with increasingly longer periods of drought during the dry season. Now, he and the rest of the Indigenous Tolupan community’s gaze is to the ground. […]", "text_kind": "source_excerpt", "text_characters": 314, "text_sha256": "5dd6d610935061f21668998ee195cb6c4e9569eabfa7f3073b6d20deb0ee0f83", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:57.220624+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 257, "end": 267, "evidence": "increasingly longer periods of drought during the dry season. Now, he and the rest of the Indigenous Tolupan community’s gaze is to