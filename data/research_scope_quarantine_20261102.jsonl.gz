artup, and Lennar, one of the nation’s largest homebuilders, recently completed construction of nearly 100 homes at the bas"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:49.788515+00:00", "published_at_raw": "2026-09-26T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_4ffced104d24f5eb4077", "record_id": "article_4ffced104d24f5eb", "canonical_url": "https://news.mongabay.com/2026/09/bangladeshs-rohingya-refugee-camps-become-increasingly-vulnerable-to-landslides", "publisher_url": "https://news.mongabay.com/2026/09/bangladeshs-rohingya-refugee-camps-become-increasingly-vulnerable-to-landslides", "title_original": "Bangladesh’s Rohingya refugee camps become increasingly vulnerable to landslides", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-25T12:10:34+00:00", "source_text": "According to a report by the Bangladeshi government, released on Sept. 16, more than 150,000 Rohingya people fleeing persecution in Myanmar have entered the country’s 33 Rohingya camps in Teknaf and Ukhiya areas of Cox’s Bazar in the last few months. The camps, spread across roughly 24 square kilometers (9.2 square miles), officially host 1,170,978 […]", "text_kind": "source_excerpt", "text_characters": 354, "text_sha256": "f74e9d3927e11865b09921d5f31ff65f83bf2228c9020ef0090ae4bd13c99e3f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:41.212217+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MM", "alpha3": "MMR", "name_zh": "缅甸", "name_en": "Myanmar"}, {"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_me