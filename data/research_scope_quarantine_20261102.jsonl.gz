{"text_id": "text_59d636c52e971a110edf", "record_id": "article_59d636c52e971a11", "canonical_url": "https://insideclimatenews.org/news/24092026/el-paso-electric-only-considered-gas-to-power-meta-data-center", "publisher_url": "https://insideclimatenews.org/news/24092026/el-paso-electric-only-considered-gas-to-power-meta-data-center", "title_original": "Texas Electric Utility Only Considered Gas to Power $10 Billion Meta Data Center", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-24T22:35:35+00:00", "source_text": "EL PASO—While Texas officials have hit pause on data center permitting, one project that is still moving ahead is Meta’s $10 billion, 1-gigawatt data center in northeast El Paso. Meta had already signed tax abatement agreements with El Paso, jumped through regulatory hoops and started construction before Texas officials tapped the brakes on data center […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "3ef5a25084d49bec814728ddcdc36e1ac3cfc77fb5e56a5011fec4e823dc1b2d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:50.014002+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$10 billion", "start": 121, "end": 132, "evidence": "EL PASO—While Texas officials have hit pause on data center permitting, one project that is still moving ahead is Meta’s $10 billion, 1-gigawatt data center in northeast El Paso.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:50.031631+00:00", "published_at_raw": "2026-09-24T22:35:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 5, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 14, "end": 19, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_4702306642e5ac2e9d79", "record_id": "article_4702306642e5ac2e", "canonical_url": "https://news.mongabay.com/2026/09/planned-us-tech-hub-in-philippines-hit-over-environmental-and-indigenous-land-concerns", "publisher_url": "https://news.mongabay.com/2026/09/planned-us-tech-hub-in-philippines-hit-over-environmental-and-indigenous-land-concerns", "title_original": "Planned US tech hub in Philippines hit over environmental and Indigenous land concerns", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-23T22:04:40+00:00", "source_text": "MANILA — Philippine President Ferdinand Marcos Jr. arrived at the Grand Hyatt Manila on Sept. 10 to address hundreds of foreign business representatives assembled for the Luzon Economic Corridor investors’ forum. Outside the hotel, hundreds of demonstrators had also gathered, carrying signs that read “No to Pax Silica!” The scene reflected both the government’s ambitious […]", "text_kind": "source_excerpt", "text_characters": 377, "text_sha256": "993e8e0a43092d0d38acb528ce05dd068548c869c6f579f0bb843e3f25668015", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:46.388886+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:46.411124+00:00", "published_at_raw": "2026-09-23T22:04:40", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 8, "end": 10, "matched_text": "US", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines", "start": 23, "end": 34, "matched_text": "Philippines", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_c8b87b4a808778f80c5b", "record_id": "article_c8b87b4a808778f8", "canonical_url": "https://news.mongabay.com/2026/09/two-decades-on-nepals-conservationists-search-for-new-dream-generation", "publisher_url": "https://news.mongabay.com/2026/09/two-decades-on-nepals-conservationists-search-for-new-dream-generation", "title_original": "Two decades on, Nepal’s conservationists search for new ‘dream’ generation", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-23T16:27:45+00:00", "source_text": "KATHMANDU — In September 2006, Nepal’s then Minister of Forests and Soil Conservation Gopal Rai and a contingent of conservation leaders flew to a remote village in eastern Nepal to hand over a conservation area to the people living there. On the evening of Sept. 22, Rai handed over management of the Kanchenjunga Conservation Area […]", "text_kind": "source_excerpt", "text_characters": 336, "text_sha256": "565c8f167d9cfd771ba35638764d437bb28c7d731febc739a81b2182541663a0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:46.449671+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:46.465895+00:00", "published_at_raw": "2026-09-23T16:27:45", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 16, "end": 21, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 31, "end": 36, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_0e3f96a77580b1ce3433", "record_id": "article_0e3f96a77580b1ce", "canonical_url": "https://insideclimatenews.org/news/23092026/asphalt-company-sues-consultant-opposing-proposed-plant", "publisher_url": "https://insideclimatenews.org/news/23092026/asphalt-company-sues-consultant-opposing-proposed-plant", "title_original": "Asphalt Company Alleges Operative Who Posed as a Project Opponent Committed Fraud", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-23T15:44:15+00:00", "source_text": "Maymead, a company that plans to build a controversial asphalt plant south of Winston-Salem, North Carolina, is suing a consulting firm and one of its former employees, alleging they committed fraud, civil conspiracy and deceptive trade practices in spearheading opposition to the project. The former employee, Chris Hopkins of Tennessee, used an alias, Chris Sanderson, […]", "text_kind": "source_excerpt", "text_characters": 374, "text_sha256": "8c43119a93f2bc51b851cbc3f5e6eda7e20b67a91cdde383f79f219462bd8e73", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:50.279870+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:50.292084+00:00", "published_at_raw": "2026-09-23T15:44:15", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_375096b77492cb3c1dfd", "record_id": "article_375096b77492cb3c", "canonical_url": "https://insideclimatenews.org/news/23092026/potential-breast-cancer-chemicals-taint-consumer-products", "publisher_url": "https://insideclimatenews.org/news/23092026/potential-breast-cancer-chemicals-taint-consumer-products", "title_original": "Chemicals Linked to Breast Cancer Are ‘Ubiquitous,’ Study Shows", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-23T12:00:00+00:00", "source_text": "The more scientists look for chemicals that can increase breast cancer risk, the more they find. Hundreds of potential breast carcinogens lurk in consumer goods, food, drinking water, pesticides, drugs and building materials, scientists reported in a peer-reviewed study published Wednesday in the journal Environmental Health Perspectives. Exposure to these chemicals is ubiquitous, the authors […]", "text_kind": "source_excerpt", "text_characters": 399, "text_sha256": "32206eca1be502da8bf0a6519a6701dc8048fa083b81704cde52df0e669353c8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:50.311320+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_end