{"text_id": "text_b645f256f19fced1eaff", "record_id": "article_b645f256f19fced1", "canonical_url": "https://news.mongabay.com/2026/09/migratory-bird-species-increasingly-at-risk-report-finds-but-there-is-still-hope", "publisher_url": "https://news.mongabay.com/2026/09/migratory-bird-species-increasingly-at-risk-report-finds-but-there-is-still-hope", "title_original": "Migratory bird species increasingly at risk, report finds, but there is still hope", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-11T13:54:34+00:00", "source_text": "Every year, billions of birds take to the skies, responding to changing seasons, navigating to breeding sites or escaping the cold of winter. The newest edition of BirdLife International’s State of the World’s Birds report says 45% of migratory bird species are in decline — 11% are threatened with extinction, the authors write. Launched at […]", "text_kind": "source_excerpt", "text_characters": 345, "text_sha256": "93bb394496a5585844c98895e08b902c0a0e5fc418bc9d86404f78a830346572", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:53.994992+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "45%", "start": 228, "end": 231, "evidence": " The newest edition of BirdLife International’s State of the World’s Birds report says 45% of migratory bird species are in decline — 11% are threatened with extinction, the authors write.", "interpretation": "not_classified"}, {"value_text": "11%", "start": 275, "end": 278, "evidence": " The newest edition of BirdLife International’s State of the World’s Birds report says 45% of migratory bird species are in decline — 11% are threatened with extinction, the authors write.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:54.025289+00:00", "published_at_raw": "2026-09-11T13:54:34", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_7a6d1dc1705c125ac589", "record_id": "article_7a6d1dc1705c125a", "canonical_url": "https://insideclimatenews.org/news/11092026/texas-hurricanes-mass-evacuations-risks", "publisher_url": "https://insideclimatenews.org/news/11092026/texas-hurricanes-mass-evacuations-risks", "title_original": "Hurricanes Routinely Threaten the Texas Coast. But Mass Evacuations Pose Risks of Their Own.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-11T08:45:00+00:00", "source_text": "This article was originally published by Public Health Watch, a nonprofit investigative news organization. Find out more at publichealthwatch.org. GALVESTON, Texas—Maya Hart’s hand stung as she gripped her Dodge Ram’s stick shift. She winced in pain and slammed on the brakes — a routine the 45-year-old mother had mastered in the 24 hours since she […]", "text_kind": "source_excerpt", "text_characters": 353, "text_sha256": "79a3d65759d82c21d6b07c162837787cd8c325172d559c3d4fdff36d5adcd82f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:03.976395+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method":