{"text_id": "text_a8fd4ca0c38050ecb780", "record_id": "article_a8fd4ca0c38050ec", "canonical_url": "https://news.mongabay.com/2024/11/as-sumatra-loses-mangroves-to-oil-palms-local-fishers-also-suffer", "publisher_url": "https://news.mongabay.com/2024/11/as-sumatra-loses-mangroves-to-oil-palms-local-fishers-also-suffer", "title_original": "As Sumatra loses mangroves to oil palms, local fishers also suffer", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-25T14:51:32+00:00", "source_text": "LANGKAT, Indonesia — Syafi’i has spent three decades picking up the crabs scurrying along the coast here in Langkat district on Sumatra Island’s northeastern coast, a reliable trade that provided first for his children, then his grandchildren. The income from collecting the decapods enabled Syafi’i to comfortably pay school fees and build a home for […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "a47679422e1fcdafed6960c7e95739e924a1faa93fd4db86114ec21ba86ce1b1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:51.521688+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dic