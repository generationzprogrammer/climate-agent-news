{"text_id": "text_c5dedd6df9160f7d655c", "record_id": "article_c5dedd6df9160f7d", "canonical_url": "https://news.mongabay.com/2025/06/critically-endangered-chameleon-discovered-outside-its-known-habitat-in-madagascar", "publisher_url": "https://news.mongabay.com/2025/06/critically-endangered-chameleon-discovered-outside-its-known-habitat-in-madagascar", "title_original": "Critically endangered chameleon discovered outside its known habitat in Madagascar", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-03T07:15:48+00:00", "source_text": "ANTANANARIVO — At the end of April, a team of researchers scouring a scarred area of spiny forest in southwestern Madagascar came across three individuals of a critically endangered chameleon species. Furcifer belalandaensis had not previously been recorded outside of a tiny, 4-square-kilometer (1.5-square-mile) area near the village of Belalanda after which it’s named, so […]", "text_kind": "source_excerpt", "text_characters": 379, "text_sha256": "65e042e72e18da7fd7613038fe8f6476cc05027e0d529d786449587f358421ab", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:05.123993+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MG", "alpha3": "MDG", "name_zh": "马达加斯加", "name_en": "Madagascar"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MG", "alpha3": "MDG", "name_zh": "马达加斯加", "name_en": "Madagascar"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:05.152265+00:00", "published_at_raw": "2025-06-03T07:15:48", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MG", "alpha3": "MDG", "name_zh": "马达加斯加", "name_en": "Madagascar", "start": 72, "end": 82, "matched_text": "Madagascar", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "MG", "alpha3": "MDG", "name_zh": "马达加斯加", "name_en": "Madagascar", "start": 114, "end": 124, "matched_text": "Madagascar", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_97fd37df830caf88b458", "record_id": "article_97fd37df830caf88", "canonical_url": "https://yaleclimateconnections.org/2025/06/how-farmers-can-help-rescue-water-loving-birds", "publisher_url": "https://yaleclimateconnections.org/2025/06/how-farmers-can-help-rescue-water-loving-birds", "title_original": "How farmers can help rescue water-loving birds", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-02T11:00:00+00:00", "source_text": "Cranes, sandpipers, ducks, geese and many other waterbirds have lost essential rest stops along their seasonal migration routes. Bird-friendly agriculture can assist in filling the gaps.", "text_kind": "source_excerpt", "text_characters": 186, "text_sha256": "56502bad7db860b456cd2fa0e3f458782619e3904f4b229f0fd2331878c8aae1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:50.038016+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:50.065268+00:00", "published_at_raw": "2025-06-02T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_un