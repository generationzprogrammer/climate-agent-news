{"text_id": "text_63c188e5da53d2f06f1d", "record_id": "article_63c188e5da53d2f0", "canonical_url": "https://news.mongabay.com/2025/03/mangroves-at-risk-as-el-salvador-begins-work-on-new-airport", "publisher_url": "https://news.mongabay.com/2025/03/mangroves-at-risk-as-el-salvador-begins-work-on-new-airport", "title_original": "Mangroves at risk as El Salvador begins work on new airport", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-06T20:52:29+00:00", "source_text": "Construction has begun on a new international airport in El Salvador despite ongoing concerns that the project will lead to rapid development near vulnerable wetlands and other coastal ecosystems. Officials broke ground February 25 on the Airport of the Pacific near the coastal town of La Unión, in eastern El Salvador, an area rich in […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "b185a3a11d75b4650443f058714d795f8f9d7944f9926c4b65dd5c76b2a4c3ad", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:59.923184+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "SV", "alpha3": "SLV", "name_zh": "萨尔瓦多", "name_en": "El Salvador"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "SV", "alpha3": "SLV", "name_zh": "萨尔瓦多", "name_en": "El Salvador"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:59.942961+00:00", "published_at_raw": "2025-03-06T20:52:29", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "SV", "alpha3": "SLV", "name_zh": "萨尔瓦多", "name_en": "El Salvador", "start": 21, "end": 32, "matched_text": "El Salvador", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "SV", "alpha3": "SLV", "name_zh": "萨尔瓦多", "name_en": "El Salvador", "start": 57, "end": 68, "matched_text": "El Salvador", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_a65bcc8f59a74d18f233", "record_id": "article_a65bcc8f59a74d18", "canonical_url": "https://dialogue.earth/en/pollution/inside-a-delhi-warrior-moms-fight-for-clean-air", "publisher_url": "https://dialogue.earth/en/pollution/inside-a-delhi-warrior-moms-fight-for-clean-air", "title_original": "Inside a Delhi ‘Warrior Mom’s’ fight for clean air", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-06T14:55:19+00:00", "source_text": "The air was thick, almost unbreathable. It smelled of burning fields – acrid and suffocating. On the morning of 16 November 2016, Bhavreen Kandhari stood at her window, watching as the city she called home disappeared into a toxic haze. Delhi’s sky was choked with smog so dense it looked apocalyptic. Her throat burned. Her twin daughters, then 13, woke up coughing. The news confirmed what she already knew. Pollution had reached such dangerous levels that Delhi schools would be closed for the first time in history. Warrior Mom Bhavreen Kandhari at her home in Delhi, India (Image: Shalinee Kumari) For years, she had been warning that this day would come. But seeing it unfold in real time – watching her own children struggle to breathe – was the breaking point.", "text_kind": "article_excerpt", "text_characters": 768, "text_sha256": "b3aebe6961ca319a9c48312b72a957d2ff9cc4deae858169e299e205e1026be1", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:34.857384+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:34.892862+00:00", "published_at_raw": "2025-03-06T14:55:19", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 572, "end": 577, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_cef9f38dc4305a00fd42", "record_id": "article_cef9f38dc4305a00", "canonical_url": "https://insideclimatenews.org/news/05032025/trump-aims-to-terminate-army-corps-florida-headquarters", "publisher_url": "https://insideclimatenews.org/news/05032025/trump-aims-to-terminate-army-corps-florida-headquarters", "title_original": "Trump Administration Intends to Terminate Lease for Army Corps’ Florida Headquarters", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-05T23:41:54+00:00", "source_text": "The Trump administration is aiming to terminate its lease on the Florida headquarters of the U.S. Army Corps of Engineers, the federal agency overseeing a historic effort to restore the Everglades and secure the future drinking water supply across the fast-growing region. The Army Corps’ Jacksonville district also is responsible for hurricane response in the […]", "text_kind": "source_excerpt", "text_characters": 364, "text_sha256": "c71a499f475ee5259aca4d3f37533bc0b8d8b4e8c9ab67b630b250353d4ffda8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:44.621741+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:44.635392+00:00", "published_at_raw": "2025-03-05T23:41:54", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 93, "end": 97, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_9c8bf12f32d2c58e900d", "record_id": "article_9c8bf12f32d2c58e", "canonical_url": "https://news.mongabay.com/2025/03/agroforestry-stores-less-carbon-than-reforestation-but-has-many-other-benefits-study-finds", "publisher_url": "https://news.mongabay.com/2025/03/agroforestry-stores-less-carbon-than-reforestation-but-has-many-other-benefits-study-finds", "title_original": "Agroforestry stores less carbon than reforestation, but has many other benefits, study finds", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-04T17:00:24+00:00", "source_text": "A recent study in Ecological Solutions and Evidence shows just how complicated and challenging it is to achieve carbon sequestration goals through forest management — but not impossible. The research evaluates 10 years of a 14-year-long carbon project in Panama run by an Indigenous Emberá community, which collectively owns the land and tried different methods […]", "text_kind": "source_excerpt", "text_characters": 365, "text_sha256": "1d6e8dd1c598fef4dd5f37606f5b9c767652d583c046d98cd616d2e90c976639", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:00.131992+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PA", "alpha3": "PAN", "name_zh": "巴拿马", "name_en": "Panama"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 272, "end": 282, "evidence": "ble. The research evaluates 10 years of a 14-year-long carbon project in Panama run by an Indigenous Emberá community, which collectively owns the land and tried different methods […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PA", "alpha3": "PAN", "name_zh": "巴拿马", "name_en": "Panama"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:00.148682+00:00", "published_at_raw": "2025-03-04T17:00:24", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PA", "alpha3": "PAN", "name_zh": "巴拿马", "name_en": "Panama", "start": 255, "end": 261, "matched_text": "Panama", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_3d331315766c7f6c7d05", "record_id": "article_3d331315766c7f6c", "canonical_url": "https://news.mongabay.com/2025/03/financing-conservation-of-central-asias-endangered-mammals-on-world-wildlife-day-and-every-day-commentarycommentary", "publisher_url": "https://news.mongabay.com/2025/03/financing-conservation-of-central-asias-endangered-mammals-on-world-wildlife-day-and-every-day-commentarycommentary", "title_original": "Financing conservation of Central Asia’s endangered mammals on World Wildlife Day and every day (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-03T12:03:24+00:00", "source_text": "Central Asia hosts some of the world’s largest and still relatively interconnected yet fragile grassland and mountain ecosystems. These landscapes provide essential habitats for migratory and threatened species, including the snow leopard, saiga antelope, argali sheep, Mongolian gazelle and wild ass. While these species are essential for maintaining ecological balance, they face growing threats from […]", "text_kind": "source_excerpt", "text_characters": 406, "text_sha256": "754b3d212ecd695c6e9013c2b6297c3e86650d4f4f253627c0b6b568c15f1934", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:00.246885+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:00.263948+00:00", "published_at_raw": "2025-03-03T12:03:24", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_5805fd401fe3224eb9d4", "record_id": "article_5805fd401fe3224e", "canonical_url": "https://news.mongabay.com/2025/02/adjusting-to-temperature-and-providing-water-can-help-save-kenya-farmers-bees-study-says", "publisher_url": "https://news.mongabay.com/2025/02/adjusting-to-temperature-and-providing-water-can-help-save-kenya-farmers-bees-study-says", "title_original": "Adjusting to temperature and providing water can help save Kenya farmers’ bees, study says", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-28T12:01:49+00:00", "source_text": "NAIROBI ― Temperature can increase bee colony loss in dry, hot and wet seasons, but a study has found that beekeepers practicing water provision to the bees experience up to 10% less decrease. The yearlong research conducted among bee farmers in Kenya revealed that between October 2021 and September 2022, the farmers lost an average […]", "text_kind": "source_excerpt", "text_characters": 338, "text_sha256": "47acbc0df70d356405275732324b5bb8c9c1f7c592620bc5a083e84c03be115a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:00.369083+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "10%", "start": 174, "end": 177, "evidence": "NAIROBI ― Temperature can increase bee colony loss in dry, hot and wet seasons, but a study has found that beekeepers practicing water provision to the bees experience up to 10% less decrease.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 10, "end": 21, "evidence": "NAIROBI ― Temperature can increase bee colony loss in dry, hot and wet seasons, but a study has found that beekeepers practicing water provision to the bees expe"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:00.383040+00:00", "published_at_raw": "2025-02-28T12:01:49", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 59, "end": 64, "matched_text": "Kenya", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 246, "end": 251, "matched_text": "Kenya", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_c20091162210463e1d89", "record_id": "article_c20091162210463e", "canonical_url": "https://dialogue.earth/en/climate/life-after-kenyas-floods-of-2024", "publisher_url": "https://dialogue.earth/en/climate/life-after-kenyas-floods-of-2024", "title_original": "Life after Kenya’s floods of 2024", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-27T17:12:07+00:00", "source_text": "In the shadow of the Nairobi skyline, the sprawling, informal settlement of Mathare bears the scars of nature’s fury colliding with vulnerable humans. The March-to-May rainy season of 2024 brought torrential downpours that devastated this community along the Mathare River, claiming lives and property. On 24 April, floods swept through the Kenyan capital’s second-largest slum. A month later, the humanitarian organisation Save the Children reported more than 7,000 people had been displaced in Mathare alone. When Dialogue Earth visited in October, residents were still struggling to come to terms with a scale of destruction that had gained global attention . Doreen Achieng feels lucky to be alive.", "text_kind": "article_excerpt", "text_characters": 702, "text_sha256": "f62501fda7de18e734f31d1fbed9132194fd5f8f67552d93ec757be8e58bb04c", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:35.073713+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 316, "end": 321, "evidence": "astated this community along the Mathare River, claiming lives and property. On 24 April, floods swept through the Kenyan capital’s second-largest slum. A month later, the humanitarian organisation Save the Children reported more than "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:35.108049+00:00", "published_at_raw": "2025-02-27T17:12:07", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 11, "end": 16, "matched_text": "Kenya", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_0e8c0869d3a88369fcc6", "record_id": "article_0e8c0869d3a88369", "canonical_url": "https://insideclimatenews.org/news/26022025/epa-would-shrink-to-1970-staffing-levels-when-the-skies-were-dark-with-smog-under-proposed-plan", "publisher_url": "https://insideclimatenews.org/news/26022025/epa-would-shrink-to-1970-staffing-levels-when-the-skies-were-dark-with-smog-under-proposed-plan", "title_original": "EPA Would Shrink to 1970 Staffing Levels—‘When the Skies Were Dark With Smog’—Under Proposed Plan", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-26T23:55:10+00:00", "source_text": "The U.S. Environmental Protection Agency would slash 65 percent of its workforce under plans that its administrator, Lee Zeldin, has discussed with the White House, President Donald Trump said Wednesday at his first cabinet meeting. Such a severe cutback would leave EPA with a staffing level on par with its workforce in its first year […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "a953a30c8300080b7f6053dd17cb3d627e79a37581b6d9775a8e73d8c736dcd5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:45.590555+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "65 percent", "start": 53, "end": 63, "evidence": " Environmental Protection Agency would slash 65 percent of its workforce under plans that its administrator, Lee Zeldin, has discussed with the White House, President Donald Trump said Wednesday at his first cabinet meeting.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:45.607012+00:00", "published_at_raw": "2025-02-26T23:55:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 4, "end": 8, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_8aec5eeedfa1e4a8beb5", "record_id": "article_8aec5eeedfa1e4a8", "canonical_url": "https://yaleclimateconnections.org/2025/02/the-national-hurricane-center-set-an-all-time-record-for-forecast-accuracy-in-2024", "publisher_url": "https://yaleclimateconnections.org/2025/02/the-national-hurricane-center-set-an-all-time-record-for-forecast-accuracy-in-2024", "title_original": "The National Hurricane Center set an all-time record for forecast accuracy in 2024", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-26T21:13:00+00:00", "source_text": "Finally, there’s some good news to report from NOAA, the parent organization of the National Hurricane Center, or NHC: During the highly active 2o24 Atlantic hurricane season, the NHC made record-accurate track forecasts at every time interval (12-, 24-, 36-, 48-, 60-, 72-, 96-, and 120-hour forecasts), according to the preliminary 2024 NHC Forecast Verification Report released on Feb. 24. And 2024 research suggests that the research dollars spent since 2007 on improved hurricane forecasts could have led to over $10 billion in combined benefits just for the two major hurricanes that hit in 2024, Helene and Milton. But the budget for hurricane research could be slashed under the Trump administration.", "text_kind": "article_excerpt", "text_characters": 708, "text_sha256": "c1e185471c62cde6692e92ca014b72402add9d41ee1033bff075be530fa85eb8", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:48:17.764550+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$10 billion", "start": 518, "end": 529, "evidence": " And 2024 research suggests that the research dollars spent since 2007 on improved hurricane forecasts could have led to over $10 billion in combined benefits just for the two major hurricanes that hit in 2024, Helene and Milton.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:17.831417+00:00", "published_at_raw": "2025-02-26T21:13:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_3348de81e03862f32412", "record_id": "article_3348de81e03862f3", "canonical_url": "https://www.carbonbrief.org/uk-belatedly-publishes-nature-pledge-at-cop16-in-rome-as-it-seeks-leadership-role", "publisher_url": "https://www.carbonbrief.org/uk-belatedly-publishes-nature-pledge-at-cop16-in-rome-as-it-seeks-leadership-role", "title_original": "UK belatedly publishes nature pledge at COP16 in Rome as it seeks ‘leadership role’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-26T16:05:10+00:00", "source_text": "The UK has belatedly published its plan for how it will “halt and reverse” biodiversity loss this decade, as nations gather in Rome for resumed COP16 talks. As anticipated, the plan sees the UK commit to implementing a lengthy list of global targets within its borders, including protecting 30% of its land and seas, plus restoring 30% of degraded ecosystems, by 2030. It is the last G7 nation to release its national biodiversity strategy and action plan (NBSAP) – excluding the US, which is not a party to the UN biodiversity convention. The plan comes four months after the UN deadline, which was for countries to submit plans by the start of the COP16 summit in Colombia in October.", "text_kind": "article_excerpt", "text_characters": 686, "text_sha256": "52f8048cd57f2e5e80742210f9658139c0c42aa48474c48a68a34d1db4144688", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:25.036017+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "30%", "start": 291, "end": 294, "evidence": " As anticipated, the plan sees the UK commit to implementing a lengthy list of global targets within its borders, including protecting 30% of its land and seas, plus restoring 30% of degraded ecosystems, by 2030.", "interpretation": "target_or_commitment"}, {"value_text": "30%", "start": 332, "end": 335, "evidence": " As anticipated, the plan sees the UK commit to implementing a lengthy list of global targets within its borders, including protecting 30% of its land and seas, plus restoring 30% of degraded ecosystems, by 2030.", "interpretation": "target_or_commitment"}], "conference_ids": ["COP16"], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "negotiations", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:25.056168+00:00", "published_at_raw": "2025-02-26T16:05:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 0, "end": 2, "matched_text": "UK", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 4, "end": 6, "matched_text": "UK", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 480, "end": 482, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 666, "end": 674, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_2067f383b7d6e382b6e8", "record_id": "article_2067f383b7d6e382", "canonical_url": "https://news.mongabay.com/2025/02/decline-of-cambodias-native-bees-spells-trouble-for-countrys-farming-future", "publisher_url": "https://news.mongabay.com/2025/02/decline-of-cambodias-native-bees-spells-trouble-for-countrys-farming-future", "title_original": "Decline of Cambodia’s native bees spells trouble for country’s farming future", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-25T23:47:36+00:00", "source_text": "As natural pollinators, Cambodia’s native honey bees are key to the survival of the country’s forests and farms. But these species are at a conservation crossroads, warns a recent study that foreshadows the risks of leaving growing threats unaddressed. Based on field research across Cambodia, as well as dozens of interviews with honey hunters, farmers […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "1fdef0638145b63105dccd73068510ee2ccd01f5121b638badc10bdb23d8c9c0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:00.656794+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:00.671700+00:00", "published_at_raw": "2025-02-25T23:47:36", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia", "start": 11, "end": 19, "matched_text": "Cambodia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia", "start": 24, "end": 32, "matched_text": "Cambodia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_e84947e30f804f9166e1", "record_id": "article_e84947e30f804f91", "canonical_url": "https://insideclimatenews.org/news/24022025/how-environmental-justice-forefather-thinks-about-current-moment", "publisher_url": "https://insideclimatenews.org/news/24022025/how-environmental-justice-forefather-thinks-about-current-moment", "title_original": "‘Never Let Anyone Break Your Spirit’: How an Environmental Justice Forefather Is Thinking About Our Current Moment", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-24T09:55:00+00:00", "source_text": "From our collaborating partner “Living on Earth,” public radio’s environmental news magazine, an interview by host Steve Curwood with the Rev. Ben Chavis, an environmental justice pioneer. In 1981, civil rights leader the Rev. Ben Chavis coined the phrase “environmental racism” after he was arrested for protesting North Carolina’s decision to dump tons of toxic […]", "text_kind": "source_excerpt", "text_characters": 367, "text_sha256": "05c697a8308d1fc81aa051c94b9126eb6be0d40cbe7e99f9f97be4735a4f2be3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:45.885340+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:45.908420+00:00", "published_at_raw": "2025-02-24T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_52aea0191e17463f6409", "record_id": "article_52aea0191e17463f", "canonical_url": "https://dialogue.earth/en/climate/ley-yolanda-the-struggle-to-save-argentinas-environmental-training-law", "publisher_url": "https://dialogue.earth/en/climate/ley-yolanda-the-struggle-to-save-argentinas-environmental-training-law", "title_original": "Ley Yolanda: the struggle to save Argentina’s environmental training law", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-21T15:47:27+00:00", "source_text": "An Argentinian chemist born in 1926, Yolanda Benjamina Ortiz started her professional life working at Shell and then moved into the civil service. Ortiz was made Argentina’s first environment secretary in 1973 by Juan Perón, following his exile in Spain. She believed in the inextricable connection between environmental and economic issues, saying that a “ mental revolution is necessary and urgent” to improve society’s relationship with nature. The politician is still held in high regard. In 2015, the year Ortiz celebrated her 90th birthday, an NGO was set up in Argentina called Eco House, which initially focused on environmental education but later shifted into politics.", "text_kind": "article_excerpt", "text_characters": 679, "text_sha256": "8d660395c597b98584a6dbe69577e1970ddad6a1514ac8aeb819fcc72ae018db", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:35.238153+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina"}, {"alpha2": "ES", "alpha3": "ESP", "name_zh": "西班牙", "name_en": "Spain"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina"}, {"alpha2": "ES", "alpha3": "ESP", "name_zh": "西班牙", "name_en": "Spain"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:35.259108+00:00", "published_at_raw": "2025-02-21T15:47:27", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina", "start": 34, "end": 43, "matched_text": "Argentina", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina", "start": 162, "end": 171, "matched_text": "Argentina", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "ES", "alpha3": "ESP", "name_zh": "西班牙", "name_en": "Spain", "start": 248, "end": 253, "matched_text": "Spain", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_ce066bb19619219dd668", "record_id": "article_ce066bb19619219d", "canonical_url": "https://news.mongabay.com/2025/02/indias-adani-withdraws-from-controversial-sri-lanka-wind-power-project", "publisher_url": "https://news.mongabay.com/2025/02/indias-adani-withdraws-from-controversial-sri-lanka-wind-power-project", "title_original": "India’s Adani withdraws from controversial Sri Lanka wind power project", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-21T04:38:37+00:00", "source_text": "COLOMBO — In a dramatic turn of events, Indian tycoon Gautam Adani’s Green Energy Limited (AGEL) has withdrawn from the second phase of a proposed wind power project in northern Sri Lanka. The project, which was planned to generate 250 MW through the installation of 52 wind turbines in Mannar in the island’s north, faced […]", "text_kind": "source_excerpt", "text_characters": 326, "text_sha256": "9af3526719cb74a51e75c1fc0d67e4798b020edd9a09e8ba7afa8a4448c0aabd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:06.191282+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "250 MW", "start": 232, "end": 238, "evidence": " The project, which was planned to generate 250 MW through the installation of 52 wind turbines in Mannar in the island’s north, faced […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "LK", "alpha3": "LKA", "name_zh": "斯里兰卡", "name_en": "