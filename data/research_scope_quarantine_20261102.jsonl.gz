{"text_id": "text_f9a5283ce580ae35ee41", "record_id": "article_f9a5283ce580ae35", "canonical_url": "https://news.mongabay.com/2026/09/childrens-health-at-risk-in-south-borneo-as-el-nino-intensifies-indonesia-wildfires", "publisher_url": "https://news.mongabay.com/2026/09/childrens-health-at-risk-in-south-borneo-as-el-nino-intensifies-indonesia-wildfires", "title_original": "Children’s health at risk in south Borneo as El Niño intensifies Indonesia wildfires", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-10T13:22:51+00:00", "source_text": "BANJARMASIN, Indonesia — Siti Sarah slept in fits and starts through August as the fires broke out around her village and surrounding peatlands. One fire on Aug. 18 at first seemed a safe distance away, but in a heartbeat the flames were within 100 meters (330 feet) of her home in Pengayuan, a village in […]", "text_kind": "source_excerpt", "text_characters": 309, "text_sha256": "b8cae73680357ce40e8661d36123635e4e6495d2838f4c6eed5c70087029623a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:54.186542+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_metho