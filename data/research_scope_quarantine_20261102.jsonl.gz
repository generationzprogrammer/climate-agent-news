{"text_id": "text_19f33f447fff5ae70d75", "record_id": "article_19f33f447fff5ae7", "canonical_url": "https://insideclimatenews.org/news/26112025/maine-data-center-green-innovation", "publisher_url": "https://insideclimatenews.org/news/26112025/maine-data-center-green-innovation", "title_original": "Maine’s First Major Data Center Project Touts Green Innovation", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-26T09:55:00+00:00", "source_text": "Once a Cold War outpost near Maine’s northern border, the former Loring Air Force Base could soon be home to a very different kind of facility: the state’s first large-scale data center. The sprawling 450-acre site in Limestone, Maine, would host the giant server farm as part of a plan still in its early stages […]", "text_kind": "source_excerpt", "text_characters": 316, "text_sha256": "48bffb17a0c99b3e40fc5cdc61537cb6ef3a1eceddcca9cf9c14b1731e4b64aa", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:36.807658+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:36.831328+00:00", "publishe