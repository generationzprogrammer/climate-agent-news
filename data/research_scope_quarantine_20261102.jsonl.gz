{"text_id": "text_01d6a12bab721af81a7a", "record_id": "article_01d6a12bab721af8", "canonical_url": "https://insideclimatenews.org/news/25032025/noaa-cuts-weather-balloon-launches-due-to-staff-shortages-after-doge-layoffs", "publisher_url": "https://insideclimatenews.org/news/25032025/noaa-cuts-weather-balloon-launches-due-to-staff-shortages-after-doge-layoffs", "title_original": "NOAA Cuts Weather Balloon Launches Due to Staff Shortages After DOGE Layoffs", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-25T23:01:27+00:00", "source_text": "The National Weather Service is reducing the number of weather balloons it launches across the country, an early tangible decrease in services offered in the wake of cuts by the Trump administration. The NWS, part of the National Oceanic and Atmospheric Administration, announced last week that it was halting or reducing weather balloon operations at […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "daf6f5b3a0c53f2a1e547cec32932322c477564ff54849648d6a15517511d72f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:30.832833+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:30.883653+00:00", "published_at_raw": "2025-03-25T23:01:27", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_41d8cb7433cb51baf2fe", "record_id": "article_41d8cb7433cb51ba", "canonical_url": "https://yaleclimateconnections.org/2025/03/a-colorado-couple-invested-in-wildfire-protection-for-their-home-it-paid-off", "publisher_url": "https://yaleclimateconnections.org/2025/03/a-colorado-couple-invested-in-wildfire-protection-for-their-home-it-paid-off", "title_original": "A Colorado couple invested in wildfire protection for their home. It paid off.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-25T11:00:00+00:00", "source_text": "Transcript: When the Stone Canyon Fire raged near Lyons, Colorado, last year, Nick Schneider and his wife saw most of their property go up in flames. But the couple’s home itself was spared – thanks to efforts they had taken to prevent fires from reaching the house. Schneider: “There was a pretty clear line, and everything outside that line was totally burned. And then there was a zone where, by design, the fire ran out of fuel.” Just months before the fire, the couple had contacted a group called Wildfire Partners , which helps Colorado homeowners prepare for wildfires. Schneider says the organization sent an expert to inspect their property and worked with them to identify steps they could take to help protect their home.", "text_kind": "article_excerpt", "text_characters": 733, "text_sha256": "0bf95932cf1602c95ac7cff495b4fea5840d5248425199c6571cf015e6ed45ba", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:48:08.637042+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 503, "end": 511, "evidence": "re ran out of fuel.” Just months before the fire, the couple had contacted a group called Wildfire Partners , which helps Colorado homeowners prepare for wildfires. Schneider says the organization sent an expert to inspect their property "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:08.727759+00:00", "published_at_raw": "2025-03-25T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_84bdab44599fb213917e", "record_id": "article_84bdab44599fb213", "canonical_url": "https://insideclimatenews.org/news/24032025/congress-oil-industry-tax-breaks", "publisher_url": "https://insideclimatenews.org/news/24032025/congress-oil-industry-tax-breaks", "title_original": "Congress Is Searching for Trillions of Dollars in Cuts. Will the Oil Industry’s Tax Breaks Skate By?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-24T09:05:00+00:00", "source_text": "If the only things certain in life are death and taxes, you might say corporate lobbyists spend much of their time trying to avoid at least one of the two. Few industries understand this better than oil and gas, which has benefited for at least a century from some tax rules that save them billions […]", "text_kind": "source_excerpt", "text_characters": 302, "text_sha256": "f8d76b6302521aacc66f84c6d4cae140c8f43709d90395b31d48a4e24327ab69", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:31.431096+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:31.448808+00:00", "published_at_raw": "2025-03-24T09:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_693ef0be6846b8c4b234", "record_id": "article_693ef0be6846b8c4", "canonical_url": "https://news.mongabay.com/2025/03/sumatran-culinary-heritage-at-risk-as-environment-changes-around-silk-road-river", "publisher_url": "https://news.mongabay.com/2025/03/sumatran-culinary-heritage-at-risk-as-environment-changes-around-silk-road-river", "title_original": "Sumatran culinary heritage at risk as environment changes around Silk Road river", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-24T04:37:26+00:00", "source_text": "PALEMBANG, Indonesia – The pempek restaurants in the Plaju neighborood were full to the gills in early March. Palembang chefs pulverized mudfish caught from the Musi River into subtle variations of the historic city’s specialty fish cake. “They’re sold all year, but there are more buyers during the fasting month,” Plaju resident Nining told Mongabay […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "cdc3448dbab3aa597433c52f8eaffbd278b8fc36281d7535d9b5a0bd07920a06", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:47.636552+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:47.659899+00:00", "published_at_raw": "2025-03-24T04:37:26", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 11, "end": 20, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_51fc09b77a456d11bbc0", "record_id": "article_51fc09b77a456d11", "canonical_url": "https://news.mongabay.com/2025/03/three-new-gecko-species-described-in-nepal-interview-with-herpetologist-santosh-bhattarai", "publisher_url": "https://news.mongabay.com/2025/03/three-new-gecko-species-described-in-nepal-interview-with-herpetologist-santosh-bhattarai", "title_original": "Three new gecko species described in Nepal: Interview with herpetologist Santosh Bhattarai", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-21T17:56:21+00:00", "source_text": "As Nepal’s reptiles are one of the least studied among the country’s diverse flora and fauna, researchers have long been saying that it could be home to numerous species waiting to be discovered by science. Herpetologist Santosh Bhattarai, a PhD student at Federation University Australia, is one of the handful of scientists who have dedicated […]", "text_kind": "source_excerpt", "text_characters": 348, "text_sha256": "328fa447572135880278716c028bd9038c9d6d6dbf691d810aecee70ed243ff9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:47.734225+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}, {"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track":