{"text_id": "text_25baf7070a4c0835be0d", "record_id": "article_25baf7070a4c0835", "canonical_url": "https://news.mongabay.com/2026/07/in-michoacan-mexico-drying-soil-threatens-water-supplies-and-avocados-says-study", "publisher_url": "https://news.mongabay.com/2026/07/in-michoacan-mexico-drying-soil-threatens-water-supplies-and-avocados-says-study", "title_original": "In Michoacán, Mexico, drying soil threatens water supplies and avocados, says study", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-23T21:28:29+00:00", "source_text": "MEXICO CITY — In the heart of Mexico’s southwestern state of Michoacán, Juan Madrigal spends his free time organizing to protect the city of Uruapan’s urban ecological park, a 50-hectare (124-acre) plot of land at the edge of the Río Santa Bárbara. A state-protected area since 1995, the park’s marshlands help to purify the surrounding […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "909e963756152a059521656a0fdb7257bab5adf20cf48ecc1b9711a9896630d8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:31.080531+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "an