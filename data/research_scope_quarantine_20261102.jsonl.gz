{"text_id": "text_582e72cf385d2bf3a0a6", "record_id": "article_582e72cf385d2bf3", "canonical_url": "https://news.mongabay.com/2025/08/how-will-fisheries-change-in-a-hotter-world-experts-share", "publisher_url": "https://news.mongabay.com/2025/08/how-will-fisheries-change-in-a-hotter-world-experts-share", "title_original": "How will fisheries change in a hotter world? Experts share", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-13T20:40:24+00:00", "source_text": "Lake Chad is nearly 1,130 kilometers (700 miles) from the ocean, but Nwamaka Okeke-Ogbuafor fears it is a preview of what’s ahead for African and other tropical fisheries. Straddling four countries on the southern edge of the Sahara Desert, Lake Chad began drying up dramatically during a series of droughts in the 1970s and ‘80s. […]", "text_kind": "source_excerpt", "text_characters": 334, "text_sha256": "2c00bdfcdf37cb0ff080783e33b4e32023cc3451520020d6cf114643c6959ccf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:26.034567+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 299, "end": 306, "evidence": "hern edge of the Sahara Desert, Lake Chad began drying up dramatically during a series of droughts in the 1970s and ‘80s. […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:26.067878+00:00", "published_at_raw": "2025-08-13T20:40:24", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_e80519dc7e1b8b4cffaa", "record_id": "article_e80519dc7e1b8b4c", "canonical_url": "https://insideclimatenews.org/news/13082025/iowa-ragbrai-bike-ride-heat", "publisher_url": "https://insideclimatenews.org/news/13082025/iowa-ragbrai-bike-ride-heat", "title_original": "RAGBRAI, the World’s Largest Recreational Bike Ride, Is Getting Hotter and Harder", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-13T08:55:00+00:00", "source_text": "Laura Ferguson has a strict no-plastic-water-bottle rule when she bikes across Iowa. She has managed to complete 19 RAGBRAIs—the Register’s Annual Great Bicycle Ride Across Iowa—relying solely on hoses, taps and her reusable water bottles. But on a blisteringly hot Wednesday this July, with 72 miles of Iowa roadways to cover, Ferguson finally caved, accepting […]", "text_kind": "source_excerpt", "text_characters": 365, "text_sha256": "de87aa445791ec1ff9cd6356f448eea4106378b292d201bc03f5dccd9878e8c7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:03.104902+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:03.117995+00:00", "published_at_raw": "2025-08-13T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_9939a700d53fd7ac9221", "record_id": "article_9939a700d53fd7ac", "canonical_url": "https://insideclimatenews.org/news/12082025/todays-climate-trump-wind-energy-threats", "publisher_url": "https://insideclimatenews.org/news/12082025/todays-climate-trump-wind-energy-threats", "title_original": "The Trump Administration’s Concerted Attacks on Wind Threaten the Industry’s Future", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-12T20:45:44+00:00", "source_text": "In the weeks leading up to his inauguration, President Donald Trump made a pledge: “no new windmills.” He’s made major headway on that this year. Since January, the administration has issued a flurry of orders and actions disrupting wind development on the country’s federal lands and waters, which has had ripple effects across the industry. […]", "text_kind": "source_excerpt", "text_characters": 346, "text_sha256": "15ef3ecbd49220bb0329febb63a8b25bffebd0d35c19ca0f8985097901a52753", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:03.152907+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:03.167668+00:00", "published_at_raw": "2025-08-12T20:45:44", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_6f3b9220fa741f573136", "record_id": "article_6f3b9220fa741f57", "canonical_url": "https://news.mongabay.com/2025/08/remedy-frameworks-can-improve-sustainable-forestry-certifications-right-past-wrongs-commentary", "publisher_url": "https://news.mongabay.com/2025/08/remedy-frameworks-can-improve-sustainable-forestry-certifications-right-past-wrongs-commentary", "title_original": "Remedy frameworks can improve sustainable forestry certifications & right past wrongs (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-11T19:32:00+00:00", "source_text": "For decades, environmental, social and governance systems have focused on stopping harm before it happens. Standards, certification schemes and corporate sustainability policies have all aimed to deter destruction, especially in forests and other high-risk ecosystems. But the uncomfortable truth is this: while these systems have helped reduce future damage, they remain largely unequipped to deal […]", "text_kind": "source_excerpt", "text_characters": 402, "text_sha256": "814a2e45b31a2aa7d7c0b42fae24d2d288bc263101b46473b44db97afbf004d0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:26.598679+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:26.647403+00:00", "published_at_raw": "2025-08-11T19:32:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_9ae74551bbbb238e2463", "record_id": "article_9ae74551bbbb238e", "canonical_url": "https://news.mongabay.com/2025/08/how-a-gecko-species-defied-extinction-on-a-galapagos-island", "publisher_url": "https://news.mongabay.com/2025/08/how-a-gecko-species-defied-extinction-on-a-galapagos-island", "title_original": "How a gecko species defied extinction on a Galápagos island", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-08T17:04:45+00:00", "source_text": "On Rábida Island in the Galápagos, where red-tinged beaches meet ancient lava formations, Mares’s leaf-toed gecko (Phyllodactylus maresi) is back. Once thought extinct on this island, a genetically distinct population has survived here against all odds, scientists have now confirmed. For more than a century, despite intensive collecting efforts across the Galápagos, no living specimen […]", "text_kind": "source_excerpt", "text_characters": 391, "text_sha256": "4ce5b55b962e7d2f260e782dda2fbb1b4e5698d582fe21df7a8387c36e25c2b6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:26.749428+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:26.781526+00:00", "published_at_raw": "2025-08-08T17:04:45", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_8c432bbb7194ad000afa", "record_id": "article_8c432bbb7194ad00", "canonical_url": "https://insideclimatenews.org/news/08082025/brazil-oil-wealth-underdevelopment-poverty", "publisher_url": "https://insideclimatenews.org/news/08082025/brazil-oil-wealth-underdevelopment-poverty", "title_original": "‘Where’s the Money Going?’: Why Brazilian Towns Awash With Royalties From Oil Are Still Among the Poorest", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-08T08:55:00+00:00", "source_text": "This report is a partnership between Agência Pública and the Guardian. Read it in Portuguese here. Though 60 miles (100km) apart, the Brazilian municipalities of Presidente Kennedy in Espírito Santo state and Campos dos Goytacazes in Rio de Janeiro state have one big thing in common: oil. Since late in the last century, their public funds have been bolstered […]", "text_kind": "source_excerpt", "text_characters": 364, "text_sha256": "fcc1d2b4171f64093e48aa75e0897842c3d5fa38acbddaf636a2cdb54b09d047", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:03.653780+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://inside