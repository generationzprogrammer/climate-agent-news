{"text_id": "text_a3741b045cd0eeec84d3", "record_id": "article_a3741b045cd0eeec", "canonical_url": "https://insideclimatenews.org/news/25092025/inside-climate-talks-public-lands", "publisher_url": "https://insideclimatenews.org/news/25092025/inside-climate-talks-public-lands", "title_original": "A Tumultuous Moment for Public Lands and All Who Rely on Them", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-25T08:55:00+00:00", "source_text": "Some 640 million acres of the United States are owned by the federal government for the benefit of the people. These public lands, widely loved by Americans, are being pulled in multiple directions over questions of who gets access, how the land is used and managed, and what values should guide those choices. Managing editor […]", "text_kind": "source_excerpt", "text_characters": 330, "text_sha256": "50ad298d71d46ebdbf96c00f0844082676d3b7cb81f9b4de0252fd4b76ac4051", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:27.720583+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "640 million", "start": 5, "end": 16, "evidence": "Some 640 million acres of the United States are owned by the federal government for the benefit of the people.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:27.755249+00:00", "published_at_raw": "2025-09-25T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 30, "end": 43, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_d40dc9fcba0854de48b3", "record_id": "article_d40dc9fcba0854de", "canonical_url": "https://news.mongabay.com/2025/09/permaculture-promises-peace-food-increased-equality-in-kenyan-county", "publisher_url": "https://news.mongabay.com/2025/09/permaculture-promises-peace-food-increased-equality-in-kenyan-county", "title_original": "Permaculture promises peace, food, increased equality in Kenyan county", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-24T10:09:45+00:00", "source_text": "BARINGO, Kenya — Salina Chepsat and a neighbor are loading tomatoes into a vehicle in the scorching midday heat. Chepsat picked the produce earlier that morning from her farm in the remote village of Loboi, a stone’s throw from west-central Kenya’s Lake Bogoria. From there, it’s headed to the market in the town of Marigat, […]", "text_kind": "source_excerpt", "text_characters": 328, "text_sha256": "91a328d032c54b0f546d5753069ee03cc0c259a7a7674c0e36c7a31c49a2a521", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:01.162907+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "annotation_method": "dictionary-evidence-v1", "review