{"text_id": "text_a3ba08034d61833587e5", "record_id": "article_a3ba08034d618335", "canonical_url": "https://news.mongabay.com/2024/07/protecting-nigeria-one-child-one-tree-at-a-time-interview-with-doyinsola-ogunye", "publisher_url": "https://news.mongabay.com/2024/07/protecting-nigeria-one-child-one-tree-at-a-time-interview-with-doyinsola-ogunye", "title_original": "Protecting Nigeria one child & one tree at a time: Interview with Doyinsola Ogunye", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-24T07:00:31+00:00", "source_text": "Driven to protect the planet one child, one tree and one recycled piece of plastic at a time, environmental advocate Doyinsola Ogunye is helping children, youth and women in Nigeria to create a more sustainable future for themselves. Ogunye founded the Mental and Environmental Development Initiative for Children (MEDIC), through which she also established a […]", "text_kind": "source_excerpt", "text_characters": 363, "text_sha256": "7ce2dcdfdfbd6fe928cedd33eabbaf88056dbd0c21f6404bb64b68ed4d86dc29", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:55.881440+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NG", "alpha3": "NGA", "name_zh": "尼日利亚", "name_en": "Nigeria"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NG", "alpha3": "NGA", "name_zh": "尼日利亚", "name_en": "Nigeria"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:55.898246+00:00", "published_at_raw": "2024-07-24T07:00:31", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NG", "alpha3": "NGA", "name_zh": "尼日利亚", "name_en": "Nigeria", "start": 11, "end": 18, "matched_text": "Nigeria", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "NG", "alpha3": "NGA", "name_zh": "尼日利亚", "name_en": "Nigeria", "start": 174, "end": 181, "matched_text": "Nigeria", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_f4f332bdec4ef02001c5", "record_id": "article_f4f332bdec4ef020", "canonical_url": "https://dialogue.earth/en/forests/paving-paradise-kenyans-stall-road-through-aberdare-mountains", "publisher_url": "https://dialogue.earth/en/forests/paving-paradise-kenyans-stall-road-through-aberdare-mountains", "title_original": "Paving paradise: Kenyans stall road through Aberdare Mountains", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-23T17:05:26+00:00", "source_text": "The Aberdare Mountains in central Kenya are a biodiversity haven, home to black leopards and the critically endangered black rhino. Currently under consideration for Unesco World Heritage status, Kenya’s highways authority is nonetheless seeking to clear parts of it to upgrade a road. The Aberdare range, known locally as the Nyandarua Mountains , is one of the country’s five main water-catchment areas, supplying Nairobi, the nearby Lake Naivasha, and the Lorian Swamp wetlands in east Kenya. The ecological importance of the range has long been understood, with 76,600 hectares of it designated as national park and 108,400 hectares of it as forest reserve. As well as leopards and rhinos, the reserve is frequented by servals, elephants and mountain bongos.", "text_kind": "article_excerpt", "text_characters": 762, "text_sha256": "8817c0cb089e039d45d33bd004603ae103279009687b01de3a25d3082c4b97e3", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:10.485600+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:10.577611+00:00", "published_at_raw": "2024-07-23T17:05:26", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 34, "end": 39, "matched_text": "Kenya", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_44825691cdba7648b37c", "record_id": "article_44825691cdba7648", "canonical_url": "https://insideclimatenews.org/news/21072024/electric-vehicles-strain-automaker-big-oil-alliance", "publisher_url": "https://insideclimatenews.org/news/21072024/electric-vehicles-strain-automaker-big-oil-alliance", "title_original": "Electric Vehicles Strain the Automaker-Big Oil Alliance", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-21T09:05:00+00:00", "source_text": "Politically Charged: Fourth in a series about how political polarization threatens the EV future. Since the dawn of U.S. environmental law more than half a century ago, America has tried to reconcile its love of the automobile with its hope for a liveable future. And whether the battle was over the smog that choked cities, […]", "text_kind": "source_excerpt", "text_characters": 328, "text_sha256": "0d1f733a44072653a52b1c632d18e312a8a8ff3a99dd111d8590c1d745dca19e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:24.068177+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:24.079534+00:00", "published_at_raw": "2024-07-21T09:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 116, "end": 120, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_1f12736605772a08df30", "record_id": "article_1f12736605772a08", "canonical_url": "https://insideclimatenews.org/news/19072024/biden-administration-acknowledges-plastic-pollution-crisis", "publisher_url": "https://insideclimatenews.org/news/19072024/biden-administration-acknowledges-plastic-pollution-crisis", "title_original": "Plastics Pollution Has Become a ‘Crisis,’ Biden Administration Acknowledges", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-19T18:37:58+00:00", "source_text": "Single-use plastic would be phased out of all U.S. government operations by 2035 under a new federal plastics pollution strategy unveiled Friday by President Joe Biden’s administration, which cited a “crisis” of littered oceans and poisoned air due to plastics. “The Federal government is—for the first time—formally acknowledging the severity of the plastic pollution crisis […]", "text_kind": "source_excerpt", "text_characters": 379, "text_sha256": "fdb8af0f191fdb29f5e1c7a73db496926841caf879fc80f7f70cc2bda90bfaac", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:24.287695+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:24.302799+00:00", "published_at_raw": "2024-07-19T18:37:58", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 46, "end": 50, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_68f96cc7373abaa28ee5", "record_id": "article_68f96cc7373abaa2", "canonical_url": "https://insideclimatenews.org/news/17072024/alabama-lake-guntersville-unexpected-chert-mine", "publisher_url": "https://insideclimatenews.org/news/17072024/alabama-lake-guntersville-unexpected-chert-mine", "title_original": "In Alabama’s Bald Eagle Territory, Residents Say an Unexpected Mining Operation Emerged as Independence Day Unfolded", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-17T09:05:00+00:00", "source_text": "LANGSTON, Ala.—In a state-owned lodge atop Taylor Mountain in Lake Guntersville State Park, the walls are covered with paintings of bald eagles. Busts of the national bird carved in stone adorn end tables in the wood-paneled lobby. This is Bald Eagle Country, here in rural Marshall County. The birds, delisted as an endangered species in […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "29323c0780cd9755f149212c4929327cff4cb20f8e218d8c80bde8890afa71e5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:29.217976+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:29.233458+00:00", "published_at_raw": "2024-07-17T09:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_db2cc9b86e267b635c79", "record_id": "article_db2cc9b86e267b63", "canonical_url": "https://insideclimatenews.org/news/17072024/arizona-activists-press-officials-to-stop-uranium-mining-near-grand-canyon", "publisher_url": "https://insideclimatenews.org/news/17072024/arizona-activists-press-officials-to-stop-uranium-mining-near-grand-canyon", "title_original": "Tribes and Environmentalists Press Arizona and Federal Officials to Stop Uranium Mining Near the Grand Canyon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-17T09:00:00+00:00", "source_text": "PHOENIX—Members of environmental groups stood together in the lobby of the Arizona State Capitol Executive Tower late last month to deliver a petition to Arizona Gov. Katie Hobbs, requesting that she stop uranium mining activities near the Grand Canyon National Park. The Sierra Club, Center for Biological Diversity, National Parks Conservation Association, Wild Arizona, Chispa […]", "text_kind": "source_excerpt", "text_characters": 383, "text_sha256": "21b233030ae4b558d1b96aae2ec2cca7d7936c1ee1ed1612e184663eb034297e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:29.258315+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_stat