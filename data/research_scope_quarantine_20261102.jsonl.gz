{"text_id": "text_6269e3b1e1059afc4ecc", "record_id": "article_6269e3b1e1059afc", "canonical_url": "https://insideclimatenews.org/news/16082024/wyoming-utility-solar-farms", "publisher_url": "https://insideclimatenews.org/news/16082024/wyoming-utility-solar-farms", "title_original": "Will the Cowboy State See the Light on Solar Electricity?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-16T09:05:00+00:00", "source_text": "Scott Kane, co-founder and co-owner of a solar company operating in Utah and Wyoming, does not work on the utility side of the industry, but when the United States Geological Survey released its map of utility-scale solar projects across the country late last year, he took an immediate interest. Kane is deeply invested in the […]", "text_kind": "source_excerpt", "text_characters": 331, "text_sha256": "e9e53fd445b04ac3ffe9b98ff3b1c9211b948678d6e99a23c1789b585f14681c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:14.624355+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 41, "end": 46, "evidence": "Scott Kane, co-founder and co-owner of a solar company operating in Utah and Wyoming, does not work on the utility side of the industry, but when the United