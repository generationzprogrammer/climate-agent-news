{"text_id": "text_0f14c8bbbcd404d612b6", "record_id": "article_0f14c8bbbcd404d6", "canonical_url": "https://insideclimatenews.org/news/26092024/florida-manatees-habitat-protections", "publisher_url": "https://insideclimatenews.org/news/26092024/florida-manatees-habitat-protections", "title_original": "Unprecedented Numbers of Florida Manatees Have Died in Recent Years. New Habitat Protections Could Help Them", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-26T09:00:00+00:00", "source_text": "ORLANDO, Fla.—The U.S. Fish and Wildlife Service this week proposed expanding habitat protections for ailing manatees, which in Florida have suffered in recent years through extraordinary habitat challenges that have left the sea cows emaciated and dying. The update to the manatee’s critical habitat would be the first since the animal was protected under the […]", "text_kind": "source_excerpt", "text_characters": 364, "text_sha256": "079351260d2263adf8dd99ec918351c17de0d4a4b88f4944a627d7df159a63bf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:55.043550+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 59, "end": 67, "evidence": "ORLANDO, Fla.—The U.S. Fish and Wildlife Service this week proposed expanding habitat protections for ailing manatees, which in Florida have suffered in recent years through extraordinary habitat challenges "}], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:55.056992+00:00", "published_at_raw": "2024-09-26T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 18, "end": 22, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_d048aef11c4608fe7bfa", "record_id": "article_d048aef11c4608fe", "canonical_url": "https://insideclimatenews.org/news/26092024/new-york-city-billions-in-state-green-bonds", "publisher_url": "https://insideclimatenews.org/news/26092024/new-york-city-billions-in-state-green-bonds", "title_original": "How New York City Has Lost Out on $4.2 Billion in State Green Bonds", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-26T08:55:00+00:00", "source_text": "Want more reporting from THE CITY? Sign up for Scoop, their free weekday newsletter, to have their latest news delivered right to your inbox. Expecting to see green, New York City officials are seeing red instead. Approved by voters statewide in 2022, the Clean Water, Clean Air and Green Jobs Environmental Bond Act allows the […]", "text_kind": "source_excerpt", "text_characters": 331, "text_sha256": "9dbb17209a1164051865a9a331b2b1517f497e65887b64bc1e28e25e1fcaa5cb", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:55.078407+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "adopted", "label_zh": "通过", "label_en": "Adopted", "start": 214, "end": 222, "evidence": "ht to your inbox. Expecting to see green, New York City officials are seeing red instead. Approved by voters statewide in 2022, the Clean Water, Clean Air and Green Jobs Environmental Bond Act allows the […]"}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:55.091283+00:00", "published_at_raw": "2024-09-26T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_5d9da6498d66d14f72d3", "record_id": "article_5d9da6498d66d14f", "canonical_url": "https://yaleclimateconnections.org/2024/09/helene-intensifies-en-route-to-an-expected-major-landfall-in-florida", "publisher_url": "https://yaleclimateconnections.org/2024/09/helene-intensifies-en-route-to-an-expected-major-landfall-in-florida", "title_original": "Helene intensifies en route to an expected major landfall in Florida", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-25T17:15:03+00:00", "source_text": "Hurricane Helene entered the southeast Gulf of Mexico at midday Wednesday, en route to what is likely to be a devastating landfall late Thursday in the Florida Panhandle. Hurricane warnings were in effect for much of Florida’s Gulf Coast, from Mexico Beach to the Anclote River, and storm surge warnings covered an even broader area, from Indian River south to Flamingo, including the Tampa-St. Petersburg and Fort Myers areas. Wind damage from this fast-moving and unusually large hurricane will be extensive and reach far inland into Georgia, and record- or near-record storm surge flooding is likely from Florida’s Big Bend to Tampa Bay.", "text_kind": "article_excerpt", "text_characters": 640, "text_sha256": "e593d8a552885c4a9a81fadc8171dd8a94a0ca438e65a771630dc114e101255f", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:14.280684+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 584, "end": 589, "evidence": "ll be extensive and reach far inland into Georgia, and record- or near-record storm surge flooding is likely from Florida’s Big Bend to Tampa Bay."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:14.311246+00:00", "published_at_raw": "2024-09-25T17:15:03", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 47, "end": 53, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_c70b7288c8c83b77f4a2", "record_id": "article_c70b7288c8c83b77", "canonical_url": "https://news.mongabay.com/2024/09/dream-birds-in-the-mist-first-photo-of-lost-bird-in-drc-mountains", "publisher_url": "https://news.mongabay.com/2024/09/dream-birds-in-the-mist-first-photo-of-lost-bird-in-drc-mountains", "title_original": "‘Dream birds’ in the mist: First photo of ‘lost’ bird in DRC mountains", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-23T12:10:20+00:00", "source_text": "Michael Harvey recalls the moment he first saw a flock of yellow-crested helmetshrikes flitting through a cloud forest in the eastern Democratic Republic of Congo: the first confirmed sighting by scientists of the species in 16 years. “It was more bizarre and exciting than I could have imagined,” says Harvey, an ornithologist and assistant professor […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "cd54ec54bff05d0f8b0c61e4be7964b5bbd9cd2d082440d96fea0049f09b3ebf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:22.373549+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:22.387036+00:00", "published_at_raw": "2024-09-23T12:10:20", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)", "start": 57, "end": 60, "matched_text": "DRC", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)", "start": 134, "end": 162, "matched_text": "Democratic Republic of Congo", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_7cbd3dedb616bde18680", "record_id": "article_7cbd3dedb616bde1", "canonical_url": "https://insideclimatenews.org/news/20092024/norway-seabed-mining-threatens-arctic-marine-life", "publisher_url": "https://insideclimatenews.org/news/20092024/norway-seabed-mining-threatens-arctic-marine-life", "title_original": "Norway’s Plan for Seabed Mining Threatens Arctic Marine Life, Greenpeace Says", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-20T15:54:49+00:00", "source_text": "Marine biologist Kirsten Young set sail in July for the Norwegian Sea aboard a 74-foot sailboat named Witness. She was joined by 11 other researchers and campaigners from the environmental activist group Greenpeace to conduct a scientific survey of marine mammals in waters Norway has designated for deep sea mining. For the next two weeks, […]", "text_kind": "source_excerpt", "text_characters": 344, "text_sha256": "387057f9567b60a08f3d85681899eece874a25a52f08160f5f6c4c474e823d03", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:00.600837+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:00.613350+00:00", "published_at_raw": "2024-09-20T15:54:49", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway", "start": 0, "end": 6, "matched_text": "Norway", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway", "start": 274, "end": 280, "matched_text": "Norway", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_0c108914dcc682007350", "record_id": "article_0c108914dcc68200", "canonical_url": "https://yaleclimateconnections.org/2024/09/a-large-central-american-low-could-spawn-helene", "publisher_url": "https://yaleclimateconnections.org/2024/09/a-large-central-american-low-could-spawn-helene", "title_original": "A large Central American low could spawn Helene", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-20T15:45:31+00:00", "source_text": "[Haz clic aquí para leer en español] A sprawling low-pressure system known as a Central American Gyre is developing over Central America and will bring heavy rains to much of Central America and southern Mexico over the next week. The Central American Gyre is likely to bring seven-day rainfall amounts in excess of a foot (305 mm) to Pacific-facing coasts of Mexico, Guatemala, El Salvador, Honduras, and Nicaragua, causing life-threatening flash flooding and mudslides (Fig. 1). The gyre — a type of monsoon low — is a weak but expansive area of surface low pressure that can persist for two weeks or more across Central America and adjacent parts of the Atlantic and Pacific, including the western Caribbean and southwest Gulf of Mexico.", "text_kind": "article_excerpt", "text_characters": 740, "text_sha256": "4128d9a1af826cbc3c73f31614a32e232ee51eb3915965e7c323ca55520277c1", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:14.781366+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NI", "alpha3": "NIC", "name_zh": "尼加拉瓜", "name_en": "Nicaragua"}, {"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "SV", "alpha3": "SLV", "name_zh": "萨尔瓦多", "name_en": "El Salvador"}, {"alpha2": "GT", "alpha3": "GTM", "name_zh": "危地马拉", "name_en": "Guatemala"}, {"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 448, "end": 453, "evidence": "f Mexico, Guatemala, El Salvador, Honduras, and Nicaragua, causing life-threatening flash flooding and mudslides (Fig. 1). The gyre — a type of monsoon low — is a weak but expansive area of surface low pressure that can persist for two"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NI", "alpha3": "NIC", "name_zh": "尼加拉瓜", "name_en": "Nicaragua"}, {"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "SV", "alpha3": "SLV", "name_zh": "萨尔瓦多", "name_en": "El Salvador"}, {"alpha2": "GT", "alpha3": "GTM", "name_zh": "危地马拉", "name_en": "Guatemala"}, {"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:14.814310+00:00", "published_at_raw": "2024-09-20T15:45:31", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 204, "end": 210, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "GT", "alpha3": "GTM", "name_zh": "危地马拉", "name_en": "Guatemala", "start": 368, "end": 377, "matched_text": "Guatemala", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "SV", "alpha3": "SLV", "name_zh": "萨尔瓦多", "name_en": "El Salvador", "start": 379, "end": 390, "matched_text": "El Salvador", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras", "start": 392, "end": 400, "matched_text": "Honduras", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "NI", "alpha3": "NIC", "name_zh": "尼加拉瓜", "name_en": "Nicaragua", "start": 406, "end": 415, "matched_text": "Nicaragua", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_37ea68c492f0f9f9e768", "record_id": "article_37ea68c492f0f9f9", "canonical_url": "https://dialogue.earth/en/ocean/chinas-changing-fisheries-in-numbers", "publisher_url": "https://dialogue.earth/en/ocean/chinas-changing-fisheries-in-numbers", "title_original": "China’s changing fisheries, in numbers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-19T14:46:34+00:00", "source_text": "The world’s population is due to reach 9.7 billion by 2050 and sustainable approaches to feeding the extra mouths are crucial. The fishing sector will play a vital role according to an influential report by the UN Food and Agriculture Organization (FAO). In 2022, production reached a record high, driven by a surge in animal aquaculture that exceeded wild catch for the first time, found the latest State of World Fisheries and Aquaculture report . China has played a significant role in this transition. It has been the largest source of fish production since about 1989 , for both marine wild catch and aquaculture. By 2022, China accounted for nearly 40% of global output.", "text_kind": "article_excerpt", "text_characters": 676, "text_sha256": "2d299546f9805f5caf85a6569d95bf6168c44eb026cafac76a6dbca87ca94831", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:59.849993+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "9.7 billion", "start": 39, "end": 50, "evidence": "The world’s population is due to reach 9.7 billion by 2050 and sustainable approaches to feeding the extra mouths are crucial.", "interpretation": "target_or_commitment"}, {"value_text": "40%", "start": 655, "end": 658, "evidence": " By 2022, China accounted for nearly 40% of global output.", "interpretation": "target_or_commitment"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:59.872391+00:00", "published_at_raw": "2024-09-19T14:46:34", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 0, "end": 5, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 450, "end": 455, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_dc9becc0480b8b9754a8", "record_id": "article_dc9becc0480b8b97", "canonical_url": "https://yaleclimateconnections.org/2024/09/shein-is-officially-the-biggest-polluter-in-fast-fashion-ai-is-making-things-worse", "publisher_url": "https://yaleclimateconnections.org/2024/09/shein-is-officially-the-biggest-polluter-in-fast-fashion-ai-is-making-things-worse", "title_original": "Shein is officially the biggest polluter in fast fashion", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-19T11:00:00+00:00", "source_text": "In 2023, the fast fashion giant Shein was everywhere. Crisscrossing the globe, airplanes ferried small packages of its ultra-cheap clothing from thousands of suppliers to tens of millions of customer mailboxes in 150 countries. Influencers’ “#sheinhaul” videos advertised the company’s trendy styles on social media, garnering billions of views . At every step, data was created, collected, and analyzed. To manage all this information, the fast fashion industry has begun embracing emerging AI technologies. Shein uses proprietary machine-learning applications — essentially, pattern-identification algorithms — to measure customer preferences in real time and predict demand, which it then services with an ultra-fast supply chain.", "text_kind": "article_excerpt", "text_characters": 733, "text_sha256": "815911b4cdc30bdfc60e210dcbe3c711d9c63a05ca2f3ca8c3cc401fc39586af", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:15.007236+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:15.039696+00:00", "published_at_raw": "2024-09-19T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_6f2a64186d09214d8cf9", "record_id": "article_6f2a64186d09214d", "canonical_url": "https://news.mongabay.com/2024/09/philippines-hydro-boom-rips-indigenous-communities", "publisher_url": "https://news.mongabay.com/2024/09/philippines-hydro-boom-rips-indigenous-communities", "title_original": "Philippines hydro boom rips Indigenous communities", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-18T05:31:58+00:00", "source_text": "KALINGA, Philippines — On the mountainsides flanking the mighty Chico River in the northern Philippines’ Kalinga province, residents of once tight-knit villages have drifted apart in recent years. Hearty greetings between neighbors tending to farmlands have been replaced with avoidant looks or glowering stares. “We don’t talk much like before,” says Gohn Dangoy, a 59-year-old […]", "text_kind": "source_excerpt", "text_characters": 382, "text_sha256": "67664f05f622453bc4cc93fa47f4be6fa355123365bed303ea955976f06ebb89", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:27.616307+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:27.629229+00:00", "published_at_raw": "2024-09-18T05:31:58", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines", "start": 0, "end": 11, "matched_text": "Philippines", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines", "start": 9, "end": 20, "matched_text": "Philippines", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_ed7f53e05150268a4446", "record_id": "article_ed7f53e05150268a", "canonical_url": "https://insideclimatenews.org/news/17092024/todays-climate-bad-river-band-oil-pipeline", "publisher_url": "https://insideclimatenews.org/news/17092024/todays-climate-bad-river-band-oil-pipeline", "title_original": "Q&A: Near Lake Superior, a Tribe Fights to Remove a Pipeline From the Wetlands It Depends On", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-17T20:07:03+00:00", "source_text": "This piece is part of our “Behind the Scenes” series, where Kiley Price interviews a fellow ICN reporter to learn more about one of their recent stories and how they reported it. For centuries, members of the Bad River Band of Lake Superior Chippewa have lived near the shores of the pristine wetlands of northwestern […]", "text_kind": "source_excerpt", "text_characters": 321, "text_sha256": "8e471954aa3574d824da03176a0564c97bc711bfbde6c3e7455e701e562bc291", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:00.995237+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:01.008486+00:00", "published_at_raw": "2024-09-17T20:07:03", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_b1f7e9b1513dbad4923f", "record_id": "article_b1f7e9b1513dbad4", "canonical_url": "https://dialogue.earth/en/climate/is-it-time-for-china-to-embrace-catastrophe-insurance", "publisher_url": "https://dialogue.earth/en/climate/is-it-time-for-china-to-embrace-catastrophe-insurance", "title_original": "Is it time for China to embrace catastrophe insurance?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-17T16:25:56+00:00", "source_text": "The most powerful autumn storm to hit China since 1949 made landfall on 6 September. Super Typhoon Yagi caused four deaths and 95 injuries. More than 720,000 in Guangdong province had to relocate , while half a million people were affected in Hainan province . Five or six huge turbines were also severely damaged at a wind farm in coastal Hainan, according to its operator . These turbines were insured , but not all losses will have been, and the widespread destruction has brought catastrophe insurance back into the spotlight. It has been a particularly harsh year for floods and other natural disasters in China, with 32 million people affected in the first half of 2024, according to the Ministry of Emergency Management.", "text_kind": "article_excerpt", "text_characters": 727, "text_sha256": "ac41e2cae71e43845cbbbb79dc2fe956d013e982171d575525a25b711831e956", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:00.038661+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "32 million", "start": 623, "end": 633, "evidence": " It has been a particularly harsh year for floods and other natural disasters in China, with 32 million people affected in the first half of 2024, according to the Ministry of Emergency Management.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 573, "end": 578, "evidence": " catastrophe insurance back into the spotlight. It has been a particularly harsh year for floods and other natural disasters in China, with 32 million people affected in the first half of 2024, according to the Ministry of Emergency Ma"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:00.072159+00:00", "published_at_raw": "2024-09-17T16:25:56", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 15, "end": 20, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 38, "end": 43, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_f0013dd5d21327526a8c", "record_id": "article_f0013dd5d2132752", "canonical_url": "https://yaleclimateconnections.org/2024/09/the-reality-behind-false-claims-about-criminal-migrants", "publisher_url": "https://yaleclimateconnections.org/2024/09/the-reality-behind-false-claims-about-criminal-migrants", "title_original": "The reality behind false claims about ‘criminal migrants’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-17T11:00:00+00:00", "source_text": "For nearly three decades, Arizona-based writer and journalist Todd Miller has immersed himself in the real-life people and policies defining the U.S.-Mexico border. When the Department of Homeland Security took over immigration and enforcement after Sept. 11, 2001, he was crossing the border multiple times a week with BorderLinks , a community-based organization dedicated to education and social justice in the borderlands between Arizona and Chiapas. He later became a writer for the nonprofit organization North American Congress on Latin America , which analyzes and publishes trends in Latin America, and he wrote four books about the U.S. border.", "text_kind": "article_excerpt", "text_characters": 654, "text_sha256": "77f220b0706b2490a0c8ee90337e113cc5b572a5fe480b0ef86e789d205d9bf1", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:15.345761+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:15.401761+00:00", "published_at_raw": "2024-09-17T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 145, "end": 149, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 150, "end": 156, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_7a35d8d5752d773befd9", "record_id": "article_7a35d8d5752d773b", "canonical_url": "https://news.mongabay.com/2024/09/in-cameroon-forest-and-water-source-restoration-offers-sustainable-solutions", "publisher_url": "https://news.mongabay.com/2024/09/in-cameroon-forest-and-water-source-restoration-offers-sustainable-solutions", "title_original": "In Cameroon, forest and water source restoration offers sustainable solutions", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-16T19:16:43+00:00", "source_text": "In Bamukumbit village in northwestern Cameroon, residents have traditionally depended on natural water sources. However, these springs, streams, and rivers have deteriorated and become polluted over time as a result of intensive human activities, including agriculture, deforestation, pastoralism and livestock herding. Thanks to a project implemented by the nonprofit Support Humanity Cameroon (Suhucam), these water […]", "text_kind": "source_excerpt", "text_characters": 421, "text_sha256": "484364d3f4d04e8bb0321b3e0f12e7630b4b15ebedcaf786aff39685aa5f52b2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:27.775554+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "implementation", "label_zh": "实施", "label_en": "Implementation", "start": 340, "end": 351, "evidence": "luding agriculture, deforestation, pastoralism and livestock herding. Thanks to a project implemented by the nonprofit Support Humanity Cameroon (Suhucam), these water […]"}], "track": "action", "country_mentions": [{"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:27.792834+00:00", "published_at_raw": "2024-09-16T19:16:43", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon", "start": 3, "end": 11, "matched_text": "Cameroon", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon", "start": 38, "end": 46, "matched_text": "Cameroon", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_d362b1a97309a16521ef", "record_id": "article_d362b1a97309a165", "canonical_url": "https://insideclimatenews.org/news/15092024/foreign-investor-legal-claims-threaten-to-bankrupt-honduras", "publisher_url": "https://insideclimatenews.org/news/15092024/foreign-investor-legal-claims-threaten-to-bankrupt-honduras", "title_original": "In Honduras, Libertarians and Legal Claims Threaten to Bankrupt a Nation", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-15T09:00:00+00:00", "source_text": "Lea este artículo en español. ROATÁN, Honduras—Years later, Luisa Connor and Vanessa Cárdenas would look back ruefully on the day foreigners visited their beachfront village with plans for a development next door. They had no idea the effort was backed by Silicon Valley billionaires who wanted to build a “startup city,” or that a relatively […]", "text_kind": "source_excerpt", "text_characters": 346, "text_sha256": "8403d67ab103822d547fe2df5597958c14ed2701de4d74b874fc5607871a831d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:01.280162+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:01.295306+00:00", "published_at_raw": "2024-09-15T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras", "start": 3, "end": 11, "matched_text": "Honduras", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras", "start": 38, "end": 46, "matched_text": "Honduras", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_9f6f06b033ab8aad48be", "record_id": "article_9f6f06b033ab8aad", "canonical_url": "https://www.carbonbrief.org/how-a-uk-government-backed-company-has-fuelled-gas-power-in-africa", "publisher_url": "https://www.carbonbrief.org/how-a-uk-government-backed-company-has-fuelled-gas-power-in-africa", "title_original": "How a UK government-backed company has fuelled gas power in Africa", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-13T14:40:38+00:00", "source_text": "A little-known company that is majority-owned by a UK government development body and backed by UK aid money has been pouring investment into gas power across Africa. Globeleq runs 1,119 megawatts (MW) of gas power plants in Cameroon, Ivory Coast and Tanzania. These sites make up more than two-thirds of its total energy portfolio. The company is controlled by the UK government-owned development finance institution British International Investment (BII), which receives funds from the UK aid budget. Globeleq has received hundreds of millions of dollars of investment via BII over the years. BII stresses Globeleq’s role in providing reliable power to many of the millions of Africans who would otherwise lack electricity access.", "text_kind": "article_excerpt", "text_characters": 732, "text_sha256": "a12ef40cb4085a7481ad12389d515a6debac89dd2e24562c3bb32627d57fa415", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:50.826867+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania"}, {"alpha2": "CI", "alpha3": "CIV", "name_zh": "科特迪瓦", "name_en": "Côte d’Ivoire"}, {"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 315, "end": 321, "evidence": "Cameroon, Ivory Coast and Tanzania. These sites make up more than two-thirds of its total energy portfolio. The company is controlled by the UK government-owned development finance institution British International Investment (BII), whi"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania"}, {"alpha2": "CI", "alpha3": "CIV", "name_zh": "科特迪瓦", "name_en": "Côte d’Ivoire"}, {"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:50.956816+00:00", "published_at_raw": "2024-09-13T14:40:38", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 6, "end": 8, "matched_text": "UK", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 51, "end": 53, "matched_text": "UK", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon", "start": 225, "end": 233, "matched_text": "Cameroon", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CI", "alpha3": "CIV", "name_zh": "科特迪瓦", "name_en": "Côte d’Ivoire", "start": 235, "end": 246, "matched_text": "Ivory Coast", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania", "start": 251, "end": 259, "matched_text": "Tanzania", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_3ecad36090d84c7fe2f9", "record_id": "article_3ecad36090d84c7f", "canonical_url": "https://news.mongabay.com/2024/09/honduras-taps-armed-forces-to-eliminate-deforestation-by-2029-will-it-work", "publisher_url": "https://news.mongabay.com/2024/09/honduras-taps-armed-forces-to-eliminate-deforestation-by-2029-will-it-work", "title_original": "Honduras taps armed forces to eliminate deforestation by 2029. Will it work?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-13T10:00:05+00:00", "source_text": "Honduras this year launched a plan to eliminate deforestation by 2029, with a special focus on recovering land used by criminal groups for timber trafficking. Officials have already carried out hundreds of operations and arrested dozens of people tied to organized crime. But some experts worry that the plan doesn’t go far enough. The “Zero […]", "text_kind": "source_excerpt", "text_characters": 345, "text_sha256": "2bd98a78eb5b8ad8ff1c8744fe0cb0c31c6ba3f955b5b7dc3dc29f03838448fd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:27.887772+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:27.902857+00:00", "published_at_raw": "2024-09-13T10:00:05", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras", "start": 0, "end": 8, "matched_text": "Honduras", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras", "start": 0, "end": 8, "matched_text": "Honduras", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_a24edcd7b59dc9f3dc58", "record_id": "article_a24edcd7b59dc9f3", "canonical_url": "https://insideclimatenews.org/news/13092024/lake-powell-glen-canyon-dam-plumbing", "publisher_url": "https://insideclimatenews.org/news/13092024/lake-powell-glen-canyon-dam-plumbing", "title_original": "Lake Powell Plumbing Will Be Repaired, but Some Say Glen Canyon Dam Needs a Long-Term Fix", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-13T09:00:00+00:00", "source_text": "Federal water managers will repair a set of little-used pipes within Glen Canyon Dam after discovering damage earlier this year. The tubes, called river outlet works, have been a focus for Colorado River watchers in recent years. If Lake Powell falls much lower, they could be the only way to pass water from the nation’s […]", "text_kind": "source_excerpt", "text_characters": 325, "text_sha256": "00e589ce7519f012c5f30e8b1644b1064e4256ce989f666c92b4e5ee2d6161a4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:01.476585+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:01.493717+00:00", "published_at_raw": "2024-09-13T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_112f776c436efa469d71", "record_id": "article_112f776c436efa46", "canonical_url": "https://yaleclimateconnections.org/2024/09/earth-has-its-hottest-august-and-hottest-june-august-on-record", "publisher_url": "https://yaleclimateconnections.org/2024/09/earth-has-its-hottest-august-and-hottest-june-august-on-record", "title_original": "Earth has its hottest August and hottest June-August on record", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-12T17:02:42+00:00", "source_text": "August 2024 was Earth’s warmest August in analysis of global data going back to 1850, and the past three months (summer in the Northern Hemisphere and winter in the Southern Hemisphere) were the warmest June-to-August period on record, NOAA’s National Centers for Environmental Information , or NCEI, reported September 12. August 2024 was 0.01 degrees Celsius (0.02°F) warmer than August 2023. Both came in well above all preceding Augusts, and the past 11 Augusts have all been warmer than any others on record. As opposed to being focused in one region or another, the record heat was unusually widespread. Around 10.3% of the world’s surface experienced record heat, beating the previous August record extent set in 2023 of 9.5%.", "text_kind": "article_excerpt", "text_characters": 733, "text_sha256": "b10cf4601a9f563388c0d9e61c921f2c3b8ad3385c7265e30f5cfdeb03db2fa0", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:22.719526+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "10.3%", "start": 617, "end": 622, "evidence": " Around 10.3% of the world’s surface experienced record heat, beating the previous August record extent set in 2023 of 9.", "interpretation": "not_classified"}, {"value_text": "9.5%", "start": 728, "end": 732, "evidence": "3% of the world’s surface experienced record heat, beating the previous August record extent set in 2023 of 9.5%.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:22.753371+00:00", "published_at_raw": "2024-09-12T17:02:42", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_22b790c4ff865747b154", "record_id": "article_22b790c4ff865747", "canonical_url": "https://news.mongabay.com/2024/09/clearest-picture-yet-of-amazon-carbon-density-could-help-guide-conservation", "publisher_url": "https://news.mongabay.com/2024/09/clearest-picture-yet-of-amazon-carbon-density-could-help-guide-conservation", "title_original": "Clearest picture yet of Amazon carbon density could help guide conservation", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-12T10:00:45+00:00", "source_text": "Cutting-edge machine-learning models have created one of the most detailed, high-resolution maps yet of aboveground carbon density in the Amazon Rainforest, revealing where the forest is most intact and what areas are most in need of conservation attention. A combination of machine-learning models and satellite readings show that the Amazon Rainforest contains 56.8 billion metric […]", "text_kind": "source_excerpt", "text_characters": 386, "text_sha256": "eb5fe1f6b85585fc5cfc35e7a2824343be2e97a02491482f44bfab4883bf8d07", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:27.990683+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "56.8 billion", "start": 363, "end": 375, "evidence": " A combination of machine-learning models and satellite readings show that the Amazon Rainforest contains 56.8 billion metric […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:28.004435+00:00", "published_at_raw": "2024-09-12T10:00:45", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_34fff7093fdc4fb3a71e", "record_id": "article_34fff7093fdc4fb3", "canonical_url": "https://insideclimatenews.org/news/10092024/todays-climate-amazon-rainforest-oil-drilling-vote", "publisher_url": "https://insideclimatenews.org/news/10092024/todays-climate-amazon-rainforest-oil-drilling-vote", "title_original": "Behind the Scenes: Using Direct Democracy to Keep Oil in the Ground Is More Complex Than it Seems", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-10T20:19:40+00:00", "source_text": "In 2023, more than 10 million Ecuadorians voted to ban oil operations in part of the country’s Amazon rainforest. This historic referendum was widely celebrated by environmentalists as a win for human rights and the environment. By ending operations in the Ishpingo, Tambococha and Tiputini (ITT) oil fields located in the northeast part of Yasuni […]", "text_kind": "source_excerpt", "text_characters": 351, "text_sha256": "bf99042b01276741eb42b9219508bd2d7ecc090c51f9ba69ab5a4d3504c24f64", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:01.703197+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "10 million", "start": 19, "end": 29, "evidence": "In 2023, more than 10 million Ecuadorians voted to ban oil operations in part of the country’s Amazon rainforest.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:01.719739+00:00", "published_at_raw": "2024-09-10T20:19:40", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_317dda9f59d508555830", "record_id": "article_317dda9f59d50855", "canonical_url": "https://yaleclimateconnections.org/2024/09/tropical-storm-francine-heads-for-louisiana", "publisher_url": "https://yaleclimateconnections.org/2024/09/tropical-storm-francine-heads-for-louisiana", "title_original": "Tropical Storm Francine heads for Louisiana", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-10T16:05:06+00:00", "source_text": "A Hurricane Warning and a Storm Surge Warning are up for most of the coast of Louisiana as Tropical Storm Francine heads toward landfall. Francine is expected to intensify into a hurricane by Tuesday evening, then level off in strength or weaken before making landfall as a Category 1 storm in Louisiana on Wednesday afternoon or evening. Francine is growing more organized At 11 a.m. EDT Tuesday, Francine was located 425 miles (690 km) southwest of Morgan City, Louisiana, moving north-northeast at 8 mph (13 kph), with top sustained winds of 65 mph (100 kph) and a central pressure of 988 mb. Satellite imagery and Brownsville, Texas radar showed that Francine had a modest-sized area of heavy thunderstorms which were growing more organized.", "text_kind": "article_excerpt", "text_characters": 745, "text_sha256": "1775bf748bcea7c7607c8d45797d8202b5479d735500241efc731fa1731f15a9", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:22.997955+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:23.057922+00:00", "published_at_raw": "2024-09-10T16:05:06", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 631, "end": 636, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_d6b3e4a04bb3f7baf0a0", "record_id": "article_d6b3e4a04bb3f7ba", "canonical_url": "https://www.carbonbrief.org/qa-the-global-trade-war-over-chinas-booming-ev-industry-translation", "publisher_url": "https://www.carbonbrief.org/qa-the-global-trade-war-over-chinas-booming-ev-industry-translation", "title_original": "Q&A：中国蓬勃发展的电动汽车产业引起的“贸易战”争论", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-10T11:00:00+00:00", "source_text": "近几个月来，中国的新能源汽车一直是媒体和地缘政治关注的焦点。 新能源汽车是一个中文术语，包括纯电动汽车、插电式混合动力汽车和燃料电池汽车。 根据中国海关和行业协会的数据，中国生产、销售和出口的新能源汽车绝大多数是纯电动汽车和插电式混合动力汽车。本文将这两者统称为“电动汽车”。 2023年，全球一半以上上路行驶的电动汽车都在中国，使中国成为全球最大的电动车市场和生产国。电动汽车的迅猛增长主要得益于中国政府的支持。 上微信关注《碳简报》 根据行业数据，2024年7月，在中国销售的所有汽车中，新能源汽车约占51%。Carbon Brief的分析发现，2023年，88%中国生产的新能源汽车在国内销售。 然而，产量已经超过了需求。官方媒体“澎湃新闻”报道称，除了比亚迪等少数几个主流品牌外，大多数中国电动汽车制造商去年的汽车产量远远超过其销量。 与此同时，从2019年到2023年，中国的电动汽车出口额（包括特斯拉等外国品牌）增长了160倍，这引发了外界对“产能过剩”的担忧。 作为回应，欧盟、美国和加拿大宣布对中国生产的电动汽车加征关税，一些媒体将此称为“贸易战”。迄今为止，英国——自2019年以来一直是中国电动汽车的主要进口国——尚未宣布任何加征关税措施。 中国官员强烈反对这些贸易壁垒，并对欧盟产品发起了针锋相对的调查。不过，一些业内人士认为，这只是“暂时性的挫折”，其将促使中国企业把重点转向非洲等其他市场。 中国电动汽车为何发展如此迅速？ 中国电动汽车产业正在蓬勃发展。根据中国汽车工业协会的数据，2018年，中国电动汽车产量仅为127万辆，但仅2023年10月一个月的产量就达到了280万辆。 电动汽车产量的激增与中国政府推动该产业发展的国家战略，有着明显的联系。", "text_kind": "source_excerpt", "text_characters": 738, "text_sha256": "0967c8d448918294dab226b44da1a4b3a9aca7bc5d83046312ee05df9b5dd32f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:52.347025+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "88%", "start": 281, "end": 284, "evidence": "Carbon Brief的分析发现，2023年，88%中国生产的新能源汽车在国内销售。", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 10, "end": 12, "evidence": "近几个月来，中国的新能源汽车一直是媒体和地缘政治关注的焦点。 新能源汽车是一个中文术语，包括纯电动汽车、插电式混合动力汽车和燃料电池汽车。 根据中国海关和行业协会的数据，中国生产、销售和出口的新能源汽车绝大多数是纯电动汽车和插电式混合动力汽车。本文将这两者统称为“电动汽车”。 2023年，全球一半以上上"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:52.494732+00:00", "published_at_raw": "2024-09-10T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 4, "end": 6, "matched_text": "中国", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 6, "end": 8, "matched_text": "中国", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 446, "end": 448, "matched_text": "美国", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada", "start": 449, "end": 452, "matched_text": "加拿大", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 488, "end": 490, "matched_text": "英国", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_0fd1fe14a67150a154b9", "record_id": "article_0fd1fe14a67150a1", "canonical_url": "https://news.mongabay.com/2024/09/association-for-tropical-biology-and-conservation-at-60-a-look-back-and-forward", "publisher_url": "https://news.mongabay.com/2024/09/association-for-tropical-biology-and-conservation-at-60-a-look-back-and-forward", "title_original": "Association for Tropical Biology and Conservation at 60: A look back and forward", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-09T19:26:55+00:00", "source_text": "KIGALI — When scientists, conservationists and policymakers from around the world gathered in East Africa this July — exchanging ideas, celebrating successes and planning for the future — the international group represented a living showcase of the dramatic transformations in tropical ecology research that has occurred over the last 60 years. Founded in 1963 by […]", "text_kind": "source_excerpt", "text_characters": 367, "text_sha256": "2237f5081fb9da52ed5530f53db7ace6bcfc7d9e102e039e5e48f55c249e3ede", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:32.837818+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:32.850402+00:00", "published_at_raw": "2024-09-09T19:26:55", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_cd5ebe8f2282f254efce", "record_id": "article_cd5ebe8f2282f254", "canonical_url": "https://yaleclimateconnections.org/2024/09/advertencias-de-huracan-para-luisiana-mientras-se-forma-la-tormenta-tropical-francine", "publisher_url": "https://yaleclimateconnections.org/2024/09/advertencias-de-huracan-para-luisiana-mientras-se-forma-la-tormenta-tropical-francine", "title_original": "Advertencias de huracán para Luisiana mientras se forma la Tormenta Tropical Francine", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-09T18:44:54+00:00", "source_text": "Se ha emitido una alerta de huracán y una alerta por marejada ciclónica para la mayor parte de la costa de Luisiana, ya que la tormenta Tropical Francine, ubicada actualmente sobre la Bahía de Campeche en el suroeste del Golfo de México, se dirige hacia un esperado impacto tarde el miércoles. La aparición de Francine el 9 de septiembre pone fin a un período extraordinariamente largo sin una tormenta nombrada en el Atlántico y llega 11 días después de la fecha habitual del 29 de agosto para la aparición de la sexta tormenta nombrada de la temporada. Francine se organiza de manera constante A las 11 a.m.", "text_kind": "article_excerpt", "text_characters": 609, "text_sha256": "7ef91acdaa429633e35ca581adfd5f96f574a8c9076a9598a8aa2354c9c0d72f", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:23.131883+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:23.169363+00:00", "published_at_raw": "2024-09-09T18:44:54", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_72d52e347cd4bf1b7459", "record_id": "article_72d52e347cd4bf1b", "canonical_url": "https://dialogue.earth/en/nature/tipping-points-lessons-from-cods-decline", "publisher_url": "https://dialogue.earth/en/nature/tipping-points-lessons-from-cods-decline", "title_original": "Tipping points: Lessons from cod’s decline", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-09T11:44:57+00:00", "source_text": "For hundreds of years, vast schools of cod, haddock, and herring from the waters of northern Europe fed many nations. But late last century, fish populations in the North and Baltic seas caved under the pressures of industrial fishing, declining to a fraction of historical levels. Fishery managers responded by enforcing limits that sharply reduced harvests. The amount of cod that fishers were allowed to catch was cut from 132,400 tonnes in 1999 to less than 20,000 in 2007. By 2022, further cuts limited the fleet to barely 13,000 tonnes. Throughout the region , fishing economies once dependent on cod have withered . Northern Germany alone saw its cod fleet – 2,000 vessels strong in the early 1990s – shrink by half in a quarter century.", "text_kind": "article_excerpt", "text_characters": 744, "text_sha256": "2782aa11fe8db3aba9fc0012592b1f8b78b495dc89ad414055176a9ffa7b2ddd", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:00.378775+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "132,400 tonnes", "start": 426, "end": 440, "evidence": " The amount of cod that fishers were allowed to catch was cut from 132,400 tonnes in 1999 to less than 20,000 in 2007.", "interpretation": "not_classified"}, {"value_text": "13,000 tonnes", "start": 528, "end": 541, "evidence": " By 2022, further cuts limited the fleet to barely 13,000 tonnes.", "interpretation": "target_or_commitment"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "DE", "alpha3": "DEU", "name_zh": "德国", "name_en": "Germany"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "DE", "alpha3": "DEU", "name_zh": "德国", "name_en": "Germany"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:00.443008+00:00", "published_at_raw": "2024-09-09T11:44:57", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "DE", "alpha3": "DEU", "name_zh": "德国", "name_en": "Germany", "start": 632, "end": 639, "matched_text": "Germany", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_5851d6ac54ed634635e4", "record_id": "article_5851d6ac54ed6346", "canonical_url": "https://insideclimatenews.org/news/08092024/gaslighting-north-carolina-lng-plant-permits", "publisher_url": "https://insideclimatenews.org/news/08092024/gaslighting-north-carolina-lng-plant-permits", "title_original": "As the Planet Warms, Activists in North Carolina Mobilize to Stop a Gathering Storm", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-08T09:00:00+00:00", "source_text": "Gaslighting: First in a series published in partnership with The Assembly about opposition to a wave of new natural gas pipelines, power plants and storage facilities on the drawing board in North Carolina. Listen to an audio version of this story below. ROUGEMONT, N.C.—Andrea Childers ambled down a moss-covered path with Hubert, the family Corgi, […]", "text_kind": "source_excerpt", "text_characters": 353, "text_sha256": "e883d81b887654961f3fdd488cc111e498d81c4b7fd4871e72df7539fbf67a04", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:01.976282+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:01.990459+00:00", "published_at_raw": "2024-09-08T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_1647d1989b6c373c17bd", "record_id": "article_1647d1989b6c373c", "canonical_url": "https://yaleclimateconnections.org/2024/09/a-new-era-in-hurricane-tracking-begins", "publisher_url": "https://yaleclimateconnections.org/2024/09/a-new-era-in-hurricane-tracking-begins", "title_original": "A new era in hurricane tracking begins", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-06T11:00:00+00:00", "source_text": "Editor’s note : As we gear up for another Atlantic hurricane season, we’re revisiting this story from our archives. It was no normal mission. Many of the Hurricane Hunters on the flight were seasoned, accustomed to taking on the world’s most powerful storms. Some had notched hundreds of hurricane eyewall penetrations – badges of honor coined eyewall “pennies.” But even for the veterans, this one felt different. It was after midnight in late September 2022 as the crew of 17 – engineers, scientists, and pilots – took off from a Houston runway for a flight into Hurricane Ian, a Category 3 storm on a collision course with the sandy shores of southwest Florida. They were flying a 1970s-era turboprop wrapped in bulky scientific equipment.", "text_kind": "article_excerpt", "text_characters": 742, "text_sha256": "45bac416b52a48a796d152a7e1077a97d87d65777618befaea23610256e55a95", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:23.394672+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:23.434501+00:00", "published_at_raw": "2024-09-06T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_659eff823b6fef6afc34", "record_id": "article_659eff823b6fef6a", "canonical_url": "https://news.mongabay.com/2024/09/the-future-of-extractive-industries-in-the-pan-amazon", "publisher_url": "https://news.mongabay.com/2024/09/the-future-of-extractive-industries-in-the-pan-amazon", "title_original": "The future of extractive industries in the Pan Amazon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-06T08:28:37+00:00", "source_text": "In January 2023, the federal government of the United States issued landmark decisions affecting two controversial projects to exploit mineral resources on public lands. One was an industrial-scale copper mine, the Pebble Mine in south central Alaska, and oil drilling program in the Willow Concessions on the North Slope of Alaska. The Environmental Protection Agency […]", "text_kind": "source_excerpt", "text_characters": 372, "text_sha256": "d464d24ff3bccad98f20b004f704202901bb0b9c691e8c06b0afbec52740cbf9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:32.920160+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:32.931106+00:00", "published_at_raw": "2024-09-06T08:28:37", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 47, "end": 60, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_6592288b0ab10a5cb521", "record_id": "article_6592288b0ab10a5c", "canonical_url": "https://news.mongabay.com/2024/09/in-nepal-a-humble-edible-fern-is-at-heart-of-human-tiger-conflict", "publisher_url": "https://news.mongabay.com/2024/09/in-nepal-a-humble-edible-fern-is-at-heart-of-human-tiger-conflict", "title_original": "In Nepal, a humble edible fern is at heart of human-tiger conflict", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-06T03:30:14+00:00", "source_text": "KATHMANDU — Tightly coiled fern plants with a distinctive appearance emerge amid the sal tree undergrowth as the monsoon rains fall on Nepal’s fertile floodplains. Due to its resemblance to the violin scroll, the plant is known as the “fiddle-head fern,” locally called niuro. Soon, the fern (Matteuccia struthiopteris) will travel to different parts of […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "e9a099edcbfa5bef4e9813151d68f36c9dfadaf351b35d73e90554d786e67ffd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:32.938826+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 151, "end": 156, "evidence": "earance emerge amid the sal tree undergrowth as the monsoon rains fall on Nepal’s fertile floodplains. Due to its resemblance to the violin scroll, the plant is known as the “fiddle-head fern,” locally called niuro. Soon, the fern (Mat"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:32.951779+00:00", "published_at_raw": "2024-09-06T03:30:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 3, "end": 8, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 135, "end": 140, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_4b45c450c5c1a3e9d54a", "record_id": "article_4b45c450c5c1a3e9", "canonical_url": "https://yaleclimateconnections.org/2024/09/powerful-typhoon-yagi-churns-across-northwest-pacific-en-route-to-southern-china", "publisher_url": "https://yaleclimateconnections.org/2024/09/powerful-typhoon-yagi-churns-across-northwest-pacific-en-route-to-southern-china", "title_original": "Powerful Typhoon Yagi churns across Northwest Pacific en route to southern China", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-05T15:30:17+00:00", "source_text": "Typhoon Yagi carried out a spectacular burst of rapid intensification in the Northwest Pacific on Wednesday, bringing it from a category-1-equivalent to a dangerous category 4-equivalent in less than 12 hours . Yagi’s 1-minute sustained winds reached 150 mph at 8 p.m. EDT Wednesday, according to the Joint Typhoon Warning Center. This qualified it as a super typhoon (1-minute sustained winds of at least 15o mph), and made it the Northwest Pacific’s strongest tropical cyclone of the season thus far. Wrapped in an environment with little wind shear and ample moisture, Yagi was drawing strength from sea surface temperatures around 30-31 degrees Celsius (86-88°F), about 1-2 degrees Celsius (1.8-3.6°F) warmer than average for early September.", "text_kind": "article_excerpt", "text_characters": 746, "text_sha256": "31ce6f8a62232f55576706139c7e298ec4af30f56924e54d18f06c1686947bce", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:23.581497+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 615, "end": 626, "evidence": "ent with little wind shear and ample moisture, Yagi was drawing strength from sea surface temperatures around 30-31 degrees Celsius (86-88°F), about 1-2 degrees Celsius (1.8-3.6°F) warmer than average for early September."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:23.621351+00:00", "published_at_raw": "2024-09-05T15:30:17", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 75, "end": 80, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_d400b89b308b349e3d02", "record_id": "article_d400b89b308b349e", "canonical_url": "https://news.mongabay.com/2024/09/stop-the-stupidity-indonesias-top-court-orders-end-to-mine-in-quake-zone", "publisher_url": "https://news.mongabay.com/2024/09/stop-the-stupidity-indonesias-top-court-orders-end-to-mine-in-quake-zone", "title_original": "‘Stop the stupidity’: Indonesia’s top court orders end to mine in quake zone", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-05T13:57:00+00:00", "source_text": "JAKARTA — A controversial zinc-and-lead mine being developed on the Indonesian island of Sumatra has hit a roadblock after the country’s Supreme Court ordered the revocation of its environmental permit. In its Aug. 12 ruling, the court upheld a lower court’s earlier decision that the environmental permit should never have been issued in the first […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "c2437a23faf7f7fb6fb1f8211f0ff404249dcea690a74b8ee022167b54cec845", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:33.088389+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:33.106909+00:00", "published_at_raw": "2024-09-05T13:57:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 22, "end": 31, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_46bf307b77ec027dba59", "record_id": "article_46bf307b77ec027d", "canonical_url": "https://yaleclimateconnections.org/2024/09/what-to-do-if-your-veggie-garden-floods", "publisher_url": "https://yaleclimateconnections.org/2024/09/what-to-do-if-your-veggie-garden-floods", "title_original": "What to do if your veggie garden floods", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-04T11:00:00+00:00", "source_text": "For gardeners, nothing is more satisfying than slicing into a homegrown tomato or cucumber. But a harvest can be ruined if stormwater runoff or overflow from nearby waterways floods a garden. Floodwaters can carry bacteria, sewage, or other pollution. Grubinger: “According to the Food and Drug Administration, any edible portion of a plant that touches floodwaters is considered contaminated and should not be consumed.” Vern Grubinger of the University of Vermont Extension says some contaminants will break down over time. But pollutants like heavy metals can linger in the ground, so Grubinger says gardeners might consider testing their soil after a flood.", "text_kind": "article_excerpt", "text_characters": 661, "text_sha256": "d98a6c3cd42a6db2c79dd553989159137225abe24e2a290d2287d7bd695a4c3e", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:23.775440+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 175, "end": 180, "evidence": "umber. But a harvest can be ruined if stormwater runoff or overflow from nearby waterways floods a garden. Floodwaters can carry bacteria, sewage, or other pollution. Grubinger: “According to the Food and Drug Administration, any edibl"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:23.804554+00:00", "published_at_raw": "2024-09-04T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_b153c427e2f2592ef843", "record_id": "article_b153c427e2f2592e", "canonical_url": "https://insideclimatenews.org/news/30082024/federal-judge-bars-epa-civil-rights-probes-louisiana", "publisher_url": "https://insideclimatenews.org/news/30082024/federal-judge-bars-epa-civil-rights-probes-louisiana", "title_original": "In Louisiana, Environmental Justice Advocates Ponder Next Steps After a Federal Judge Effectively Bars EPA Civil Rights Probes", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-30T23:37:17+00:00", "source_text": "When she was told that a federal judge’s ruling will effectively prevent the Environmental Protection Agency from pursuing civil rights claims against chemical manufacturers in Louisiana’s “Cancer Alley,” local activist Tisha Taylor immediately thought of the Fifth Ward Elementary School. The 300-student school in Reserve, Louisiana, sits about the length of a football field away […]", "text_kind": "source_excerpt", "text_characters": 386, "text_sha256": "a97b5f8b906227790ff09d5e2c8587d9e3ab1068ee9b30ebca5cc55d7e52abfb", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:07.323427+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_