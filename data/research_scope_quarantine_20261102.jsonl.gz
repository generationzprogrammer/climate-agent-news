{"text_id": "text_568449b5464709b49ec6", "record_id": "article_568449b5464709b4", "canonical_url": "https://insideclimatenews.org/news/14012025/albuquerque-bicycle-safety", "publisher_url": "https://insideclimatenews.org/news/14012025/albuquerque-bicycle-safety", "title_original": "Wheels Are Turning to Make Albuquerque Streets Less Threatening to Bicycle Commuters", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-14T09:55:00+00:00", "source_text": "On a typical sunny August afternoon in Albuquerque, Annie Frang was riding her bike home from work as she’d done dozens of times before. Then she was lying on the pavement next to a roundabout after being struck by a car. Multiple injuries required Frang to visit urgent care, and a separated shoulder still makes […]", "text_kind": "source_excerpt", "text_characters": 317, "text_sha256": "1e9862ec6b8169a6767ee6a70e9e299c3ba19f238586e7f9468f95d762f391b9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:05.809206+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:05.819765+00:00", "published_at_raw": "2025-01-14T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_a4deb40067649c2136c2", "record_id": "article_a4deb40067649c21", "canonical_url": "https://insideclimatenews.org/news/12012025/commercial-development-co-makes-millions-from-brownfields", "publisher_url": "https://insideclimatenews.org/news/12012025/commercial-development-co-makes-millions-from-brownfields", "title_original": "How North America’s Leading Brownfield Redeveloper Makes Millions by Not Redeveloping Brownfields", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-12T10:00:00+00:00", "source_text": "This reporting was supported by a grant from the Fund for Investigative Journalism. In 2017, a Missouri-based corporation called Jaines LLC forked over $9.6 million in exchange for 110 acres of vacant buildings and cracked concrete in Janesville, Wisconsin. The corporation was an affiliate of Commercial Development Co. (CDC), which bills itself as North America’s […]", "text_kind": "source_excerpt", "text_characters": 369, "text_sha256": "1b771adbc9bdd216c2083ffc51b4736350f8440f24a543779c1b98303f90daf8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:10.614202+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$9.6 million", "start": 152, "end": 164, "evidence": " In 2017, a Missouri-based corporation called Jaines LLC forked over $9.6 million in exchange for 110 acres of vacant buildings and cracked concrete in Janesville, Wisconsin.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_at