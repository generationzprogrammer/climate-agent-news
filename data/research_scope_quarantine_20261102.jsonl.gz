{"text_id": "text_3c9b335b2fb595589466", "record_id": "article_3c9b335b2fb59558", "canonical_url": "https://news.mongabay.com/2025/12/in-brazil-a-new-label-gives-more-visibility-to-deforestation-free-beef", "publisher_url": "https://news.mongabay.com/2025/12/in-brazil-a-new-label-gives-more-visibility-to-deforestation-free-beef", "title_original": "In Brazil, a new label gives more visibility to deforestation-free beef", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-18T14:22:42+00:00", "source_text": "Amid growing pressure for beef supply chains to be deforestation-free, a new certification system in Brazil will allow meatpackers, importers and retailers to guarantee that the meat cuts they sell are not associated with deforestation. Down the line, this could also help companies become compliant with the European Union’s regulation on deforestation-free products (EUDR). The […]", "text_kind": "source_excerpt", "text_characters": 383, "text_sha256": "ec46e9ee4b40fd711b4ee984534326fdeca07a349a2fa307ee0ac57723ee4946", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:52.869405+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [{"id": "standards", "label_zh": "标准与监管", "label_en": "Standards and regulation", "start": 326, "end": 336, "evidence": " Down the line, this could also help companies become compliant with the European Union’s regulation on deforestation-free products (EUDR). The […]"}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:52.896037+00:00", "published_at_raw": "2025-12-18T14:22:42", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 3, "end": 9, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 101, "end": 107, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_6fbb4f9d5ab410a4bfef", "record_id": "article_6fbb4f9d5ab410a4", "canonical_url": "https://insideclimatenews.org/news/18122025/a-long-wait-for-flooding-help-in-chicago-may-be-nearing-an-end", "publisher_url": "https://insideclimatenews.org/news/18122025/a-long-wait-for-flooding-help-in-chicago-may-be-nearing-an-end", "title_original": "A Long Wait for Flooding Help in Chicago May Be Nearing an End", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-18T10:00:00+00:00", "source_text": "CHICAGO—Two-and-a-half years after Dorothy Rosenthal’s home on the West Side flooded, she is still dealing with financial pain. She received $8,000 from the Federal Emergency Management Agency, but repairs have cost her $10,000, and her basement still has dry mold from the four feet of water that gushed into it in July 2023. Rosenthal is […]", "text_kind": "source_excerpt", "text_characters": 343, "text_sha256": "0279c8d198fd269df201f4e33dfd1319e35bb2557697b5c92143ef804c8f4b2d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:27.307027+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 77, "end": 82, "evidence": "CHICAGO—Two-and-a-half years after Dorothy Rosenthal’s home on the West Side flooded, she is still dealing with financial pain. She received $8,000 from the Federal Emergency Management Agency, but repairs have cost her $1"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:27.327288+00:00", "published_at_raw": "2025-12-18T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_82184bce635bbd68ccd6", "record_id": "article_82184bce635bbd68", "canonical_url": "https://insideclimatenews.org/news/17122025/liquefied-natural-gas-exports-driving-up-energy-bills", "publisher_url": "https://insideclimatenews.org/news/17122025/liquefied-natural-gas-exports-driving-up-energy-bills", "title_original": "Gas Exports Are Driving Up Americans’ Energy Bills, Report Says", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-17T22:38:26+00:00", "source_text": "During the 2024 campaign, President Donald Trump promised voters that his policies would lower their energy prices by 50 percent, repeating this pledge in speeches in New York, Pennsylvania and North Carolina. “We will cut energy and electricity prices in half within 12 months—not just for businesses but for all Americans and their families,” he […]", "text_kind": "source_excerpt", "text_characters": 351, "text_sha256": "657ea5fd3d54069ba439aea6be8d45cc7d6b2453e0229dfaf8b4bf8a90afdbba", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:27.421136+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "50 percent", "start": 118, "end": 128, "evidence": "During the 2024 campaign, President Donald Trump promised voters that his policies would lower their energy prices by 50 percent, repeating this pledge in speeches in New York, Pennsylvania and North Carolina.", "interpretation": "target_or_commitment"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_