{"text_id": "text_b4bb5816f564adcdc10e", "record_id": "article_b4bb5816f564adcd", "canonical_url": "https://news.mongabay.com/2026/03/indonesia-farmers-count-the-costs-as-rains-wash-out-java-durian-harvest", "publisher_url": "https://news.mongabay.com/2026/03/indonesia-farmers-count-the-costs-as-rains-wash-out-java-durian-harvest", "title_original": "Indonesia farmers count the costs as rains wash out Java durian harvest", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-04T04:23:07+00:00", "source_text": "BANYUMAS, Indonesia — The first two months of the year would ordinarily see Ganjar Budi Setiaji hurrying around Plana village’s durian orchard, here in the hilly Javanese district of Banyumas. But on the last Tuesday of January, the 53-year-old father instead appeared restless. “In 2024, I harvested 3,500 durians from 300 trees,” Ganjar told Mongabay […]", "text_kind": "source_excerpt", "text_characters": 356, "text_sha256": "2684a6e72bfa4cf72a72896cab02c4d41d4dc01b85f778610a3cf1912e705432", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:52.516941+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annota