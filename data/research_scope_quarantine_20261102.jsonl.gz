{"text_id": "text_a02f83203198b18fb1d1", "record_id": "article_a02f83203198b18f", "canonical_url": "https://insideclimatenews.org/news/21082025/atlantic-shore-towns-feel-hurricane-erin-without-landfall", "publisher_url": "https://insideclimatenews.org/news/21082025/atlantic-shore-towns-feel-hurricane-erin-without-landfall", "title_original": "Atlantic Shore Towns Feel Hurricane Erin’s Sting Without It Ever Making Landfall", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-21T21:39:15+00:00", "source_text": "Hurricane Erin hasn’t had to make landfall on the East Coast to batter it. Churning more than 200 miles offshore Thursday, the storm has brought flooding, life-threatening waves and rip currents and strong winds to coastal communities from Florida to Maine, according to the National Weather Service. Erin rapidly intensified to a Category 5 over […]", "text_kind": "source_excerpt", "text_characters": 350, "text_sha256": "fcbb44b23197af01db1b13ebc7c28e22ae4b35d04a032d66edd4a042b3d5a263", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:55.202999+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 145, "end": 150, "evidence": "Coast to batter it. Churning more than 200 miles offshore Thursday, the storm has brought flooding, life-threatening waves and rip currents and strong winds to coastal communities from Florida to Maine, according to the National Weathe"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:55.216216+00:00", "published_at_raw": "2025-08-21T21:39:15", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_0f35fec67272471f6824", "record_id": "article_0f35fec67272471f", "canonical_url": "https://insideclimatenews.org/news/21082025/new-york-city-newton-creek-wastewater-cleanup", "publisher_url": "https://insideclimatenews.org/news/21082025/new-york-city-newton-creek-wastewater-cleanup", "title_original": "Navigating the Troubled Waters of Newtown Creek Means an Environmental Cleanup in Brooklyn and Queens That Will Cost At Least $3.3 Billion", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-21T09:00:00+00:00", "source_text": "Hazardous: Last in a series about the ongoing struggle to clean up Brooklyn’s Superfund sites. Water has memory. I was told that once by Eymund Diegel, a co-founder of the Gowanus Community Advisory Group. The water that flows into New York City’s East River remembers that cigarette butt you flicked over the railing, the beer […]", "text_kind": "source_excerpt", "text_characters": 331, "text_sha256": "1d16591da9bae61cc9ad16435b84821825064b670899fd58fee1679cd09ed311", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:55.279193+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://