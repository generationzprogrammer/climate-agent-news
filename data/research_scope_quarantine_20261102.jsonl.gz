{"text_id": "text_11822bc73559a2c21d04", "record_id": "article_11822bc73559a2c2", "canonical_url": "https://news.mongabay.com/2025/08/cross-border-operation-cracks-down-on-environmental-crimes-in-the-amazon", "publisher_url": "https://news.mongabay.com/2025/08/cross-border-operation-cracks-down-on-environmental-crimes-in-the-amazon", "title_original": "Cross-border operation cracks down on environmental crimes in the Amazon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-06T16:00:52+00:00", "source_text": "MEXICO CITY – About two dozen police officers, government officials and a data specialist sat side by side in a command center in northern Bogotá, Colombia’s capital. For two weeks, they reviewed live camera footage and tracked geolocations of police actions that were part of Operation Green Shield, a field initiative targeting cross-border environmental crime […]", "text_kind": "source_excerpt", "text_characters": 366, "text_sha256": "59fa40a753f1920fce444ee15e330d0e4d0d239cd6094ceba6150e3b0e0cb1d3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:31.497320+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:31.524103+00:00", "published_at_raw": "2025-08-06T16:00:52", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 0, "end": 6, "matched_text": "MEXICO", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 147, "end": 155, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_af47dd90e83446743fc2", "record_id": "article_af47dd90e8344674", "canonical_url": "https://insideclimatenews.org/news/06082025/uranium-energy-corp-first-fast-tracked-mining-permits-wyoming", "publisher_url": "https://insideclimatenews.org/news/06082025/uranium-energy-corp-first-fast-tracked-mining-permits-wyoming", "title_original": "Uranium Company Receives Wyoming’s First Fast-Tracked Mining Permits", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-06T08:55:00+00:00", "source_text": "Uranium Energy Corp.’s Sweetwater uranium project has become the first mining proposal in Wyoming to be fast-tracked under President Donald Trump’s March executive order to increase U.S. mineral production. The company announced Aug. 5 that it planned to expand its uranium mining operations in Wyoming’s Red Desert as a result of the expedited permitting process. […]", "text_kind": "source_excerpt", "text_characters": 368, "text_sha256": "afa6c0d0de0877dc500c8c39502e685a0126019634a4357c2fbfbbb0de91adbc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:03.969054+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 8, "end": 14, "evidence": "Uranium Energy Corp.’s Sweetwater uranium project has become the first mining proposal in Wyoming to be fast-tracked under President Donald Trump’s March "}], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 78, "end": 86, "evidence": "Uranium Energy Corp.’s Sweetwater uranium project has become the first mining proposal in Wyoming to be fast-tracked under President Donald Trump’s March executive order to increase U.S. mineral production. The company announc"}], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:03.981386+00:00", "published_at_raw": "2025-08-06T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 182, "end": 186, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_addf801a2f8518089ec1", "record_id": "article_addf801a2f851808", "canonical_url": "https://yaleclimateconnections.org/2025/08/over-50-million-americans-struggle-to-pay-an-energy-bill", "publisher_url": "https://yaleclimateconnections.org/2025/08/over-50-million-americans-struggle-to-pay-an-energy-bill", "title_original": "Over 50 million Americans struggle to pay an energy bill", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-04T11:00:00+00:00", "source_text": "Transcript: A federal government initiative called the Low-Income Home Energy Assistance Program, or LIHEAP , has made headlines in recent months. In April, the Trump administration fired LIHEAP staffers, and the president has proposed cutting the program entirely. LIHEAP has existed for decades and helps families who are struggling to pay their energy bills. Low-income households can apply to LIHEAP via states, local governments, and community groups and receive funding to pay for part of their bills. This money is usually sent directly to the utility company to help cover the cost of oil, gas, or electric heat. In some cases, the funding helps prevent imminent shutoffs or restores people’s service, so it can be a critical lifeline – especially during the cold winter months.", "text_kind": "article_excerpt", "text_characters": 786, "text_sha256": "5800f160229d1a978b64671094e47748d08fac29a72da5883fadece40f63b393", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:32.557228+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 71, "end": 77, "evidence": "Transcript: A federal government initiative called the Low-Income Home Energy Assistance Program, or LIHEAP , has made headlines in recent months. In April, the Trump administration fired LIHEAP staffers, and the pres"}], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 468, "end": 475, "evidence": "holds can apply to LIHEAP via states, local governments, and community groups and receive funding to pay for part of their bills. This money is usually sent directly to the utility company to help cover the cost of oil, gas, or electric "}], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 227, "end": 235, "evidence": "t months. In April, the Trump administration fired LIHEAP staffers, and the president has proposed cutting the program entirely. LIHEAP has existed for decades and helps families who are struggling to pay their energy bills. Low-income ho"}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:32.629893+00:00", "published_at_raw": "2025-08-04T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_8850e4cb3aaa9a51dd32", "record_id": "article_8850e4cb3aaa9a51", "canonical_url": "https://insideclimatenews.org/news/01082025/blm-oil-gas-rules-exempted-from-public-comment", "publisher_url": "https://insideclimatenews.org/news/01082025/blm-oil-gas-rules-exempted-from-public-comment", "title_original": "BLM Calls New Oil and Gas Rules ‘Noncontroversial,’ Exempts Them From Public Comment", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-01T21:50:45+00:00", "source_text": "The Bureau of Land Management implemented four rules today that create more leeway for oil and gas companies wanting to drill on public lands, as required by the spending bill President Donald Trump and Republicans in Congress passed in July. But voters will not have a chance to comment on two of the rules. Lands […]", "text_kind": "source_excerpt", "text_characters": 318, "text_sha256": "55a636b9297c1d09784d4897376e9ee80a8cc02dc2ef5ecc76333ffe98fa0c26", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:09.761624+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "implementation", "label_zh": "实施", "label_en": "Implementation", "start": 30, "end": 41, "evidence": "The Bureau of Land Management implemented four rules today that create more leeway for oil and gas companies wanting to drill on public lands, as required by the spending bill Presi"}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:09.772692+00:00", "published_at_raw": "2025-08-01T21:50:45", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_5f72b7d622bfe2bf0636", "record_id": "article_5f72b7d622bfe2bf", "canonical_url": "https://insideclimatenews.org/news/01082025/private-companies-noaa-weather-data", "publisher_url": "https://insideclimatenews.org/news/01082025/private-companies-noaa-weather-data", "title_original": "Private Companies Step up to Gather Weather Data for NOAA as Staffing Cuts Hobble Agency Forecasting", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-01T09:00:00+00:00", "source_text": "When staffing shortages caused the National Weather Service (NWS) to suspend weather balloon launches at its Kotzebue, Alaska, station earlier this year, a startup deploying next-generation weather balloons, WindBorne Systems, stepped up to fill the void. The company began selling its western Alaskan atmospheric data to the NWS in February, plugging what could have been […]", "text_kind": "source_excerpt", "text_characters": 376, "text_sha256": "374bf5c7eee34ffa729a07a3bc0ed8a1de78edab67b50d1ad6565c79163801c3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:09.796969+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:09.812383+00:00", "published_at_raw": "2025-08-01T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_15e993c1c7be6cf28d2a", "record_id": "article_15e993c1c7be6cf2", "canonical_url": "https://news.mongabay.com/2025/07/how-cambodias-new-environmental-code-undermines-indigenous-peoples-rights-commentary", "publisher_url": "https://news.mongabay.com/2025/07/how-cambodias-new-environmental-code-undermines-indigenous-peoples-rights-commentary", "title_original": "How Cambodia’s new environmental code undermines Indigenous peoples’ rights (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-30T22:23:48+00:00", "source_text": "Cambodia’s Indigenous peoples have a deep relationship to forests, land and natural resources, which they traditionally manage in their cultural practices and everyday lives. There are 22 distinct Indigenous communities with an estimated 172,980 people, accounting for 1.11% of Cambodia’s total population. Indigenous peoples are well-known for being forest caretakers and passing down forest care […]", "text_kind": "source_excerpt", "text_characters": 401, "text_sha256": "cb5da35408fcf95499cfd4533012121ab521f2f56e6dd62ef21501839c7fcfd6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:32.198718+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "1.11%", "start": 269, "end": 274, "evidence": " There are 22 distinct Indigenous communities with an estimated 172,980 people, accounting for 1.11% of Cambodia’s total population.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 11, "end": 21, "evidence": "Cambodia’s Indigenous peoples have a deep relationship to forests, land and natural resources, which they traditionally manage in their cultural practices and ev"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:32.223159+00:00", "published_at_raw": "2025-07-30T22:23:48", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia", "start": 4, "end": 12, "matched_text": "Cambodia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia", "start": 0, "end": 8, "matched_text": "Cambodia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_0adb9750415a108846bc", "record_id": "article_0adb9750415a1088", "canonical_url": "https://news.mongabay.com/2025/07/more-than-10000-species-on-brink-of-extinction-need-urgent-action-study", "publisher_url": "https://news.mongabay.com/2025/07/more-than-10000-species-on-brink-of-extinction-need-urgent-action-study", "title_original": "More than 10,000 species on brink of extinction need urgent action: Study", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-30T16:55:45+00:00", "source_text": "Extinction is an overwhelming concept, difficult to grasp in its enormity and finality. Thousands of species are barreling toward that grim fate, unless we help. A comprehensive new study provides the clearest picture yet of Earth’s most imperiled species, and offers evidence that conservation can work. The study published in Nature Reviews Biodiversity found that […]", "text_kind": "source_excerpt", "text_characters": 370, "text_sha256": "8c15f1998b586db166299a4da2cb6ed99559c054860559ae7eb915f065a2ba1a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:32.273279+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:32.295275+00:00", "published_at_raw": "2025-07-30T16:55:45", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_479b172f80bb6c3720aa", "record_id": "article_479b172f80bb6c37", "canonical_url": "https://yaleclimateconnections.org/2025/07/robotic-machine-helps-rescue-wood-from-the-scrap-heap", "publisher_url": "https://yaleclimateconnections.org/2025/07/robotic-machine-helps-rescue-wood-from-the-scrap-heap", "title_original": "Robotic machine helps rescue wood from the scrap heap", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-29T11:00:00+00:00", "source_text": "Transcript: When a building gets knocked down, its wooden boards and beams typically get destroyed, too. In the U.S., tens of millions of tons of lumber end up in landfills or incinerators each year. But Eric Law of the company Urban Machine says much of this wood could be reused instead. Law: “It’s a massive amount of material that’s still high-quality material. It’s still completely intact, it’s still got good length to it.” Before it can be reused though, all the nails, screws, and staples must be removed. Law: “And that process is incredibly labor-intensive.” So Law’s company created a robotic machine that’s now in use near San Francisco. It locates metal fasteners in pieces of lumber and extracts them using pincers. It can process thousands of feet of material each day.", "text_kind": "article_excerpt", "text_characters": 785, "text_sha256": "e6867d852e84683aa5119a99f61a5638cda94f27708a4bb696c8a9ce911d327c", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:33.732257+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:33.835952+00:00", "published_at_raw": "2025-07-29T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 112, "end": 116, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_75554e787e713a57c306", "record_id": "article_75554e787e713a57", "canonical_url": "https://yaleclimateconnections.org/2025/07/how-to-eat-safely-when-the-power-goes-out", "publisher_url": "https://yaleclimateconnections.org/2025/07/how-to-eat-safely-when-the-power-goes-out", "title_original": "How to eat safely when the power goes out", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-28T11:00:00+00:00", "source_text": "Transcript: Disasters like wildfires and hurricanes can destroy electrical lines, leading to long blackouts. When the power is out, it’s only a matter of time before the food in the fridge and freezer starts to go bad. So if you think you might lose electricity, stock up on foods that do not need to be refrigerated , like crackers, peanut butter, cereal, and apples. Move refrigerated foods into the freezer so they’ll stay cold for a longer time without power. You can also store food in a cooler filled with ice. If you need to cook, you can use an outdoor grill when the weather is safe. Or if you have a gas stove, you may be able to manually light it with matches. During a blackout, keep the fridge and freezer doors closed as much as possible so the food stays cold.", "text_kind": "article_excerpt", "text_characters": 775, "text_sha256": "162b567b9419da69c673501d307a9e9d55034b3f2bacce7bee1f56261685995c", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:33.986939+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 27, "end": 35, "evidence": "Transcript: Disasters like wildfires and hurricanes can destroy electrical lines, leading to long blackouts. When the power is out, it’s only a matter of time before the food "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:34.063331+00:00", "published_at_raw": "2025-07-28T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_fdd22f248a1d0c994c3f", "record_id": "article_fdd22f248a1d0c99", "canonical_url": "https://news.mongabay.com/2025/07/a-forest-garden-project-attempts-to-expand-into-the-sahel", "publisher_url": "https://news.mongabay.com/2025/07/a-forest-garden-project-attempts-to-expand-into-the-sahel", "title_original": "A forest garden project attempts to expand into the Sahel", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-28T06:00:19+00:00", "source_text": "Drought, irregular rainfall, deforestation, and the legacy of unsustainable human activities have left vast areas across the arid and semiarid regions of sub-Saharan Africa degraded, causing major challenges for the human population. According to environmentalists, one solution to this problem might be forest gardens. These “gardens” use regenerative agroforestry to revive patches of degraded agricultural […]", "text_kind": "source_excerpt", "text_characters": 412, "text_sha256": "ffd1ee5da8cbb08ddffd953f5be7f67d6f5698e48e46aeb9301ac812c0313730", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:32.489905+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 0, "end": 7, "evidence": "Drought, irregular rainfall, deforestation, and the legacy of unsustainable human activities have left vast areas across the arid and semiarid regi"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:32.508531+00:00", "published_at_raw": "2025-07-28T06:00:19", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_d0356e139afeb6423701", "record_id": "article_d0356e139afeb642", "canonical_url": "https://dialogue.earth/en/climate/roundtable-what-the-latest-un-finance-for-development-summit-means-for-the-world", "publisher_url": "https://dialogue.earth/en/climate/roundtable-what-the-latest-un-finance-for-development-summit-means-for-the-world", "title_original": "Roundtable: What the latest UN Finance for Development summit means for the world", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-25T15:26:47+00:00", "source_text": "From 30 June to 3 July, representatives from governments across the world met in Seville, Spain, for the Fourth Financing for Development ( FfD4 ) summit. This UN event, last held in Addis Ababa, Ethiopia, a decade ago, is designed to be a forum for securing capital to fund global development. The Sevilla Commitment , adopted at the summit’s closure, covered a broad range of issues relating to development finance, including continued reform of the international financial architecture, the importance of South-South development cooperation as a “complement to” traditional North-South cooperation, and steps towards enhancing debt sustainability. The summit shone a spotlight on the inadequate and unhealthy state of the world’s financial architecture.", "text_kind": "article_excerpt", "text_characters": 756, "text_sha256": "b36d8e03d545e8c003dad58521e4873e2dc953d8f802321e8dcd05df961fe7fa", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:20.308653+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ES", "alpha3": "ESP", "name_zh": "西班牙", "name_en": "Spain"}, {"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia"}], "governance_themes": [], "policy_tools": [{"id": "cooperation", "label_zh": "合作与技术支持", "label_en": "Cooperation and technology", "start": 532, "end": 543, "evidence": "rm of the international financial architecture, the importance of South-South development cooperation as a “complement to” traditional North-South cooperation, and steps towards enhancing debt sustainability. The summit shone a spotlight on "}], "policy_stages": [{"id": "adopted", "label_zh": "通过", "label_en": "Adopted", "start": 320, "end": 327, "evidence": "d to be a forum for securing capital to fund global development. The Sevilla Commitment , adopted at the summit’s closure, covered a broad range of issues relating to development finance, including continued reform of the international f"}], "track": "action", "country_mentions": [{"alpha2": "ES", "alpha3": "ESP", "name_zh": "西班牙", "name_en": "Spain"}, {"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:20.358779+00:00", "published_at_raw": "2025-07-25T15:26:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ES", "alpha3": "ESP", "name_zh": "西班牙", "name_en": "Spain", "start": 90, "end": 95, "matched_text": "Spain", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia", "start": 196, "end": 204, "matched_text": "Ethiopia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_0c5b0f75750a85a3a46c", "record_id": "article_0c5b0f75750a85a3", "canonical_url": "https://news.mongabay.com/2025/07/2000-species-at-high-risk-of-extinction-from-natural-disasters-study-finds", "publisher_url": "https://news.mongabay.com/2025/07/2000-species-at-high-risk-of-extinction-from-natural-disasters-study-finds", "title_original": "2,000 species at high risk of extinction from natural disasters, study finds", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-25T15:13:58+00:00", "source_text": "In the aftermath of Hurricane Maria’s assault on the Caribbean island of Dominica in 2017, researchers made a heartbreaking discovery: dead and dying hummingbirds scattered across the forest floor. Among them were purple-throated caribs (Eulampis jugularis), the specialized pollinators of the island’s Heliconia plants. This single storm threatened an evolutionary partnership millions of years in […]", "text_kind": "source_excerpt", "text_characters": 402, "text_sha256": "108e801354e0ed2608b974e5caf96e162ad88382c6f181451510881cbfb2c88f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:37.229140+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "DM", "alpha3": "DMA", "name_zh": "多米尼克", "name_en": "Dominica"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "DM", "alpha3": "DMA", "name_zh": "多米尼克", "name_en": "Dominica"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:37.253218+00:00", "published_at_raw": "2025-07-25T15:13:58", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "DM", "alpha3": "DMA", "name_zh": "多米尼克", "name_en": "Dominica", "start": 73, "end": 81, "matched_text": "Dominica", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_aafddfcbd4dce3d2ee65", "record_id": "article_aafddfcbd4dce3d2", "canonical_url": "https://insideclimatenews.org/news/25072025/activists-will-resist-any-federal-effort-to-lift-delaware-river-fracking-ban", "publisher_url": "https://insideclimatenews.org/news/25072025/activists-will-resist-any-federal-effort-to-lift-delaware-river-fracking-ban", "title_original": "Activists Pledge to Resist Any Federal Effort to Lift Fracking Ban in Delaware River Basin", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-25T08:55:00+00:00", "source_text": "Fears that the Trump administration is looking for ways to lift a longstanding ban on fracking for natural gas in the densely populated Delaware River Basin—which includes part of Pennsylvania—have prompted environmentalists to seek public support for a commitment to defend the regulation. Activists are promoting a “Pledge of Resistance and Protection” of the watershed […]", "text_kind": "source_excerpt", "text_characters": 375, "text_sha256": "08d169150994e7cf3f473e7e53b4d56fe2aa32951883af0e3df7720dded83375", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:10.771903+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "standards", "label_zh": "标准与监管", "label_en": "Standards and regulation", "start": 279, "end": 289, "evidence": "nia—have prompted environmentalists to seek public support for a commitment to defend the regulation. Activists are promoting a “Pledge of Resistance and Protection” of the watershed […]"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:10.789674+00:00", "published_at_raw": "2025-07-25T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_ffd624dedb28db918857", "record_id": "article_ffd624dedb28db91", "canonical_url": "https://insideclimatenews.org/news/24072025/trump-ai-action-plan-waives-federal-environmental-rules", "publisher_url": "https://insideclimatenews.org/news/24072025/trump-ai-action-plan-waives-federal-environmental-rules", "title_original": "Trump’s AI Action Plan Waives Federal Environmental Rules in the Development of Data Centers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-24T23:25:14+00:00", "source_text": "Some of the most exclusive seats at President Donald Trump’s inauguration in January were reserved for the leaders of Big Tech companies like Meta, Amazon and Google. While the mega-rich have long had an outsized role in U.S. national politics, many saw the inaugural display as a tell-tale sign of the influence the tech industry […]", "text_kind": "source_excerpt", "text_characters": 334, "text_sha256": "ef5c2d6a070e7a799d0d5827c1243eb3e80618cdba828b1840b54273875c86ab", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:10.811337+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:10.825839+00:00", "published_at_raw": "2025-07-24T23:25:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 221, "end": 225, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_93374a8f830d7e50a1a0", "record_id": "article_93374a8f830d7e50", "canonical_url": "https://insideclimatenews.org/news/24072025/inside-clean-energy-consumer-tax-credits-vanish", "publisher_url": "https://insideclimatenews.org/news/24072025/inside-clean-energy-consumer-tax-credits-vanish", "title_original": "As Consumer Tax Credits Vanish, What Do You Need to Know?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-24T13:00:00+00:00", "source_text": "Consumers are facing a Sept. 30 deadline to be eligible for tax credits for EVs, followed by a Dec. 31 deadline when credits vanish for rooftop solar, air source heat pumps and certain water heaters. These are major purchases and customers will likely want to consider multiple options before making a selection, but there isn’t […]", "text_kind": "source_excerpt", "text_characters": 332, "text_sha256": "1f9b8f9f01a298f6d5f8390ce76daf84d0c65e8911931e83731a655dde7dab14", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:10.846860+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 144, "end": 149, "evidence": "e for tax credits for EVs, followed by a Dec. 31 deadline when credits vanish for rooftop solar, air source heat pumps and certain water heaters. These are major purchases and customers will likely want to consider multiple options bef"}], "policy_tools": [{"id": "subsidy", "label_zh": "补贴与激励", "label_en": "Subsidies and incentives", "start": 60, "end": 70, "evidence": "Consumers are facing a Sept. 30 deadline to be eligible for tax credits for EVs, followed by a Dec. 31 deadline when credits vanish for rooftop solar, air source heat pumps and certain water heaters. These are "}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:10.860128+00:00", "published_at_raw": "2025-07-24T13:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_6402a5ea570e9ac20f86", "record_id": "article_6402a5ea570e9ac2", "canonical_url": "https://news.mongabay.com/2025/07/indonesian-palm-oil-company-sues-experts-who-helped-secure-18m-pollution-ruling", "publisher_url": "https://news.mongabay.com/2025/07/indonesian-palm-oil-company-sues-experts-who-helped-secure-18m-pollution-ruling", "title_original": "Indonesian palm oil company sues experts who helped secure $18m pollution ruling", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-24T11:31:14+00:00", "source_text": "JAKARTA — Two of Indonesia’s most prominent environmental experts are facing a lawsuit that activists say is part of a wider trend of silencing scientists who testify against environmental violators. Bambang Hero Saharjo and Basuki Wasis, both veteran forensics experts whose testimonies have helped convict major polluters, are being sued by PT Kalimantan Lestari Mandiri […]", "text_kind": "source_excerpt", "text_characters": 376, "text_sha256": "4b6648da8ed7a45a0b2697867180dedcf1cd9b95f1addc7a2d7675e9afa235e7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:37.467213+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:37.497914+00:00", "published_at_raw": "2025-07-24T11:31:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 17, "end": 26, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_371b7b4c0dfb06dda8a0", "record_id": "article_371b7b4c0dfb06dd", "canonical_url": "https://yaleclimateconnections.org/2025/07/iowa-residents-bring-the-prairie-back-one-yard-at-a-time", "publisher_url": "https://yaleclimateconnections.org/2025/07/iowa-residents-bring-the-prairie-back-one-yard-at-a-time", "title_original": "Iowa residents bring the prairie back, one yard at a time", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-24T11:00:00+00:00", "source_text": "Transcript: Centuries ago, Iowa was covered in prairies with thick grasses and rich soils. But as farms and housing developments spread, those prairies disappeared and the soil degraded. Kasey Hutchinson works for Johnson County, Iowa. She says healthy soils have many benefits, including reducing stormwater runoff. Hutchinson: “Healthy soil can soak up so much water. This is key for preventing pollutants from getting to our creeks and streams, because if you can soak up more water, you have less runoff to pick up those pollutants.” Johnson County is reimbursing residents for part of the cost of aerating and adding compost to their lawns, which helps nutrients and water filter into the soil.", "text_kind": "article_excerpt", "text_characters": 699, "text_sha256": "35542b9c663ca6f3e8da1f7a880f961ae72fede182249b2ac4cbee93fb430a4c", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:34.444860+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:34.552843+00:00", "published_at_raw": "2025-07-24T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_a948a45cefe2375a3d6a", "record_id": "article_a948a45cefe2375a", "canonical_url": "https://news.mongabay.com/2025/07/ecuadors-new-protected-areas-law-sparks-debate-over-security-development", "publisher_url": "https://news.mongabay.com/2025/07/ecuadors-new-protected-areas-law-sparks-debate-over-security-development", "title_original": "Ecuador’s new protected areas law sparks debate over security, development", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-23T19:08:47+00:00", "source_text": "Ecuador recently passed a landmark protected areas law aimed at restoring security in the country’s national parks and reserves. The law establishes new government agencies and funding mechanisms, and tries to close legal loopholes that used to leave rainforests vulnerable to development. Reactions to the legislation have been mixed. Some environmental groups call it a […]", "text_kind": "source_excerpt", "text_characters": 375, "text_sha256": "8de6b734c15b5bf1f32ee80730e1a7011c1fe64a12131eacd63aad83272fb200", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:37.561840+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 177, "end": 184, "evidence": "he country’s national parks and reserves. The law establishes new government agencies and funding mechanisms, and tries to close legal loopholes that used to leave rainforests vulnerable to development. Reactions to the legislation have "}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:37.580003+00:00", "published_at_raw": "2025-07-23T19:08:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador", "start": 0, "end": 7, "matched_text": "Ecuador", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador", "start": 0, "end": 7, "matched_text": "Ecuador", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_a8a41d2a4b558a96b15f", "record_id": "article_a8a41d2a4b558a96", "canonical_url": "https://dialogue.earth/en/energy/can-malaysias-ai-data-centres-go-green", "publisher_url": "https://dialogue.earth/en/energy/can-malaysias-ai-data-centres-go-green", "title_original": "Can Malaysia’s AI data centres go green?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-23T16:03:52+00:00", "source_text": "Data centres are springing up across Southeast Asia as China and the US vie for AI supremacy. Tech giants – from ByteDance and Alibaba to Google and Microsoft – are setting their sights on Johor, Malaysia’s manufacturing hub just across the strait from Singapore. A rich agricultural state, Johor is now also home to sprawling data centre parks. Since 2023, Malaysia has announced MYR 99 billion (USD 23.4 billion) in data centre investments, much of it involving AI facilities, with a further MYR 149 billion (USD 35.2 billion) in the near future. With cheap electricity, labour and ample land, Malaysia has proven to be a compelling alternative to its land-constrained neighbour and is set to become the fastest-growing data-centre hotspot in Southeast Asia.", "text_kind": "article_excerpt", "text_characters": 760, "text_sha256": "708272d05e58b1a5d43a110622efe9520bd3b765cec5c033f3135bec3634344e", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:20.424736+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "99 billion", "start": 385, "end": 395, "evidence": " Since 2023, Malaysia has announced MYR 99 billion (USD 23.", "interpretation": "not_classified"}, {"value_text": "23.4 billion", "start": 401, "end": 413, "evidence": " Since 2023, Malaysia has announced MYR 99 billion (USD 23.4 billion) in data centre investments, much of it involving AI facilities, with a further MYR 149 billion (USD 35.", "interpretation": "not_classified"}, {"value_text": "149 billion", "start": 498, "end": 509, "evidence": "4 billion) in data centre investments, much of it involving AI facilities, with a further MYR 149 billion (USD 35.", "interpretation": "not_classified"}, {"value_text": "35.2 billion", "start": 515, "end": 527, "evidence": "4 billion) in data centre investments, much of it involving AI facilities, with a further MYR 149 billion (USD 35.2 billion) in the near future.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MY", "alpha3": "MYS", "name_zh": "马来西亚", "name_en": "Malaysia"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "SG", "alpha3": "SGP", "name_zh": "新加坡", "name_en": "Singapore"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MY", "alpha3": "MYS", "name_zh": "马来西亚", "name_en": "Malaysia"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "SG", "alpha3": "SGP", "name_zh": "新加坡", "name_en": "Singapore"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:20.464964+00:00", "published_at_raw": "2025-07-23T16:03:52", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MY", "alpha3": "MYS", "name_zh": "马来西亚", "name_en": "Malaysia", "start": 4, "end": 12, "matched_text": "Malaysia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 55, "end": 60, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 69, "end": 71, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "MY", "alpha3": "MYS", "name_zh": "马来西亚", "name_en": "Malaysia", "start": 196, "end": 204, "matched_text": "Malaysia", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "SG", "alpha3": "SGP", "name_zh": "新加坡", "name_en": "Singapore", "start": 253, "end": 262, "matched_text": "Singapore", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_e2947e914c7933d9eef3", "record_id": "article_e2947e914c7933d9", "canonical_url": "https://insideclimatenews.org/news/23072025/new-york-city-concrete-plant-park-green-jobs", "publisher_url": "https://insideclimatenews.org/news/23072025/new-york-city-concrete-plant-park-green-jobs", "title_original": "A South Bronx Park is a Hive of Activity—for Bees and for New Yorkers Training for Green Jobs", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-23T08:50:00+00:00", "source_text": "The buzz of bees at Concrete Plant Park in the South Bronx is a hint to some grand ambitions for job opportunities in this once abandoned industrial site. For nearly 50 years, the massive silos near the Bronx River were home to a bustling private concrete enterprise. Abandoned in the 1980s, the seven-acre site rotted […]", "text_kind": "source_excerpt", "text_characters": 322, "text_sha256": "e085e4d947f064f1d777747144dbabcc500db55de37d5e9251a49541a8635a7a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:11.191867+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:11.207101+00:00", "published_at_raw": "2025-07-23T08:50:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_99c06215666909310662", "record_id": "article_99c0621566690931", "canonical_url": "https://yaleclimateconnections.org/2025/07/el-guardian-del-agua-program-provides-spanish-language-stormwater-workshops-in-madison-wisconsin", "publisher_url": "https://yaleclimateconnections.org/2025/07/el-guardian-del-agua-program-provides-spanish-language-stormwater-workshops-in-madison-wisconsin", "title_original": "El Guardián del Agua program provides Spanish-language stormwater workshops in Madison, Wisconsin", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-22T11:00:00+00:00", "source_text": "Transcript: In Madison, Wisconsin, a program in English and Spanish teaches people about rain gardens, rain barrels, and other ways to help reduce stormwater runoff. Cristina Carvajal is with Wisconsin EcoLatinos . She says two years ago, she was talking with the director of the University of Wisconsin-Madison Arboretum, which offers programs about stormwater pollution. Carvajal: “She said, ‘You know, we have all these programs … and yet, there is little to no participation of Latinos and minorities in these programs.” So Wisconsin EcoLatinos partnered with the arboretum to change that. They held listening sessions to learn how to design the program to get more Latinos involved. Some participants said they would like programs that they could bring their kids to.", "text_kind": "article_excerpt", "text_characters": 772, "text_sha256": "c20bd656c7727ab97e8e53421d67ebc7fa914c6a156c9125bf327a68535a58c2", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:35.059718+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:35.165050+00:00", "published_at_raw": "2025-07-22T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_0f7323578b5c09486f95", "record_id": "article_0f7323578b5c0948", "canonical_url": "https://insideclimatenews.org/news/20072025/lgbtq-disaster-protection-politics", "publisher_url": "https://insideclimatenews.org/news/20072025/lgbtq-disaster-protection-politics", "title_original": "Out in the Storm", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-20T09:00:00+00:00", "source_text": "We were bombing up I-10 over Lake Pontchartrain, one week to the day after Hurricane Francine passed the same way with its tempest winds and a month’s worth of rain. Chenier “Klie” Kliebert, a Native New Orleanian so many generations back the family had lost count, drove comfortably while I sat shotgun and wide-eyed at […]", "text_kind": "source_excerpt", "text_characters": 324, "text_sha256": "268d2f3b3295a0c117ce838dce67d561bd58ef214b2fef5b622a2ba420dad087", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:16.829934+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:16.843811+00:00", "published_at_raw": "2025-07-20T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_689416b6d807a3949727", "record_id": "article_689416b6d807a394", "canonical_url": "https://insideclimatenews.org/news/18072025/former-bp-spokesperson-joins-epa-region-6", "publisher_url": "https://insideclimatenews.org/news/18072025/former-bp-spokesperson-joins-epa-region-6", "title_original": "Former BP Spokesperson Is Now EPA Region 6 Chief of Staff", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-18T21:22:16+00:00", "source_text": "Wynn Radford IV, chief of staff for the Environmental Protection Agency Region 6, previously worked as a spokesperson for the multinational oil company BP following the Deepwater Horizon disaster. The April 2010 explosion on an offshore BP drilling rig killed 11 people and caused the largest marine oil spill in history, leaking almost 134 million […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "e8d0ab921977c2ceea86891e46fa203445318ba11133c7d13f72b0ffa2ce89e4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:17.083323+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "134 million", "start": 337, "end": 348, "evidence": " The April 2010 explosion on an offshore BP drilling rig killed 11 people and caused the largest marine oil spill in history, leaking almost 134 million […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_s