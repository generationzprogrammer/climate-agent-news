{"text_id": "text_c5bfb93a6c0b831ca1f5", "record_id": "article_c5bfb93a6c0b831c", "canonical_url": "https://news.mongabay.com/2025/02/disease-surges-in-indonesia-community-on-frontline-of-world-energy-transition", "publisher_url": "https://news.mongabay.com/2025/02/disease-surges-in-indonesia-community-on-frontline-of-world-energy-transition", "title_original": "Disease surges in Indonesia community on frontline of world energy transition", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-06T02:53:33+00:00", "source_text": "LELILEF SAWAI, Indonesia — Hernemus Takuling’s life in this coastal village has changed ever since construction began on the Weda Bay Industrial Park, which borders Lelilef Sawai, home to around 5,000 people, on Indonesia’s Halmahera Island. “Everything’s filthy,” Hernemus told Mongabay Indonesia. “You need to wear a mask just to go out onto the road.” Staff […]", "text_kind": "source_excerpt", "text_characters": 364, "text_sha256": "e214cbb09a2e975fa08d46e6ec99738940aa82775a3f505d34b5e12afa78dfda", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:12.432045+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:12.445007+00:00", "published_at_raw": "2025-02-06T02:53:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 18, "end": 27, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 15, "end": 24, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_107583276d400a51419d", "record_id": "article_107583276d400a51", "canonical_url": "https://news.mongabay.com/2025/02/whats-at-stake-for-the-environment-in-ecuadors-upcoming-election", "publisher_url": "https://news.mongabay.com/2025/02/whats-at-stake-for-the-environment-in-ecuadors-upcoming-election", "title_original": "What’s at stake for the environment in Ecuador’s upcoming election?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-05T16:29:41+00:00", "source_text": "The last time Ecuador held elections, in 2023, the country’s national assembly had been dissolved and then-President Guillermo Lasso had faced potential impeachment for a corruption scandal involving embezzlement of public oil transport funds. It led to a political crisis that saw snap presidential elections usher in the young Daniel Noboa, the son of a […]", "text_kind": "source_excerpt", "text_characters": 359, "text_sha256": "75d8399f6683eac7ed9b438d4e7f847a2e98617e61998cd48e24fcea43d13727", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:12.505159+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "annotation_method": "dictio