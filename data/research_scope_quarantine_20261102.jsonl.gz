{"text_id": "text_7dbfa0f75157fadd4082", "record_id": "article_7dbfa0f75157fadd", "canonical_url": "https://insideclimatenews.org/news/03062024/new-york-landfill-letitia-james-green-amendment", "publisher_url": "https://insideclimatenews.org/news/03062024/new-york-landfill-letitia-james-green-amendment", "title_original": "In New York, Attorney General Letitia James’ Narrow View of the State’s Green Amendment", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-03T20:34:11+00:00", "source_text": "ALBANY—Citizens who breathe air polluted by New York’s largest landfill have no legal right under the state’s Green Amendment to block that facility’s application for a permit to expand, lawyers for the state Department of Environmental Conservation (DEC) argue. In a response filed Friday to a lawsuit against the DEC and the landfill, Seneca Meadows […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "3da9983c290c950334b5e65936453ed32bb0bc0199f6fe99dcb46c4a21e12ee8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:43.058927+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/w