{"text_id": "text_4fd096acf7f7582ec0e6", "record_id": "article_4fd096acf7f7582e", "canonical_url": "https://insideclimatenews.org/news/19022025/trump-fast-tracks-projects-that-would-damage-wetlands", "publisher_url": "https://insideclimatenews.org/news/19022025/trump-fast-tracks-projects-that-would-damage-wetlands", "title_original": "Trump Order Fast-Tracks Projects That Would Damage Wetlands, Environmental Groups Say", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-19T22:59:25+00:00", "source_text": "The U.S. Army Corps of Engineers has marked for fast-track review more than 600 permit applications for projects under President Donald Trump’s “Declaring a National Energy Emergency” executive order that would disturb critical wetlands and waterways, environmental groups warned Wednesday. The projects include a 37-mile crude oil pipeline in Louisiana that would affect some 234 […]", "text_kind": "source_excerpt", "text_characters": 384, "text_sha256": "b1f2ececff3ddfa4babb2d1e60d09c2618464a4887c623ab80831dcf7fb6a234", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:50.928131+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 166, "end": 172, "evidence": "600 permit applications for projects under President Donald Trump’s “Declaring a National Energy Emergency” executive order that would disturb critical wetlands and waterways, environmental groups warned Wednesday. The projects include "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:50.953046+00:00", "published_at_raw": "2025-02-19T22:59:25", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 4, "end": 8, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_1561fb7080a14c806914", "record_id": "article_1561fb7080a14c80", "canonical_url": "https://insideclimatenews.org/news/19022025/virginia-legislators-taxpayer-funds-for-natural-gas-projects", "publisher_url": "https://insideclimatenews.org/news/19022025/virginia-legislators-taxpayer-funds-for-natural-gas-projects", "title_original": "Virginia Legislators Pushing to Use Taxpayer Funds for Natural Gas Projects", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-19T10:00:00+00:00", "source_text": "RICHMOND, Va.—Lawmakers from both parties are seeking to use state tax dollars to boost new natural gas infrastructure projects related to data centers and chicken processing plants, as a proposed spending plan is nearing completion before going to the governor for review. House Appropriations Chair Del. Luke Torian (D-Prince William) is including in the House […]", "text_kind": "source_excerpt", "text_characters": 366, "text_sha256": "d734e062887d6b3845e39a304e6f277ae0d693911941aa013ee00be8c741b858", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:51.144900+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 188, "end": 196, "evidence": "l gas infrastructure projects related to data centers and chicken processing plants, as a proposed spending plan is nearing completion before going to the governor for review. House Appropriations Chair Del. Luke Torian (D-Prince William)"}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:51.172282+00:00", "published_at_raw": "2025-02-19T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_45c31981433d6137cde3", "record_id": "article_45c31981433d6137", "canonical_url": "https://news.mongabay.com/2025/02/how-country-palm-could-help-pave-the-way-toward-a-sustainable-palm-oil-future-in-liberia", "publisher_url": "https://news.mongabay.com/2025/02/how-country-palm-could-help-pave-the-way-toward-a-sustainable-palm-oil-future-in-liberia", "title_original": "How ‘country palm’ could help pave the way toward a sustainable palm oil future in Liberia", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-18T23:49:35+00:00", "source_text": "Across southeastern Liberia, oil palms grow wild in the forest. Known as “country palm,” the Elaeis guineensis tree is native to West Africa and treasured by local communities. “In the rural areas where there are palms in the wild, if you want to farm in those areas people will say to you, ‘Do not cut […]", "text_kind": "source_excerpt", "text_characters": 306, "text_sha256": "12e4684b7a59194aea447e87e43ecc497c56714eaa02fdd48789767a9b57f1fe", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:06.406063+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "LR", "alpha3": "LBR", "name_zh": "利比里亚", "name_en": "Liberia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "LR", "alpha3": "LBR", "name_zh": "利比里亚", "name_en": "Liberia"}], "annotatio