{"text_id": "text_403715bb0a8a53b077ea", "record_id": "article_403715bb0a8a53b0", "canonical_url": "https://news.mongabay.com/2026/06/our-ocean-conference-in-kenya-ends-with-6-4-billion-in-pledges-review-of-past-promises", "publisher_url": "https://news.mongabay.com/2026/06/our-ocean-conference-in-kenya-ends-with-6-4-billion-in-pledges-review-of-past-promises", "title_original": "Our Ocean Conference in Kenya ends with $6.4 billion in pledges, review of past promises", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-26T07:11:38+00:00", "source_text": "MOMBASA — Africa was front and center at the Our Ocean Conference in Kenya, the first time the annual gathering was held on the continent. The conference is built around voluntary commitments from a range of actors including governments, nonprofits, institutions and the private sector. The meeting in Mombasa, a port city on Kenya’s Indian […]", "text_kind": "source_excerpt", "text_characters": 344, "text_sha256": "f4d3dcca9da6a2913845e30153df2e089c776e809f7cfaa3a2e1a60fd872b246", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:54.049767+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_