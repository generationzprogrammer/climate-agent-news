{"text_id": "text_0928f55b37a9b4ab421f", "record_id": "article_0928f55b37a9b4ab", "canonical_url": "https://insideclimatenews.org/news/30072024/three-facilities-contribute-half-of-houston-chemical-air-pollution", "publisher_url": "https://insideclimatenews.org/news/30072024/three-facilities-contribute-half-of-houston-chemical-air-pollution", "title_original": "Three Facilities Contribute Half of Houston’s Chemical Air Pollution", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-30T20:43:14+00:00", "source_text": "This story has been updated with additional comments. Just three facilities account for more than half of chemical air pollution from industrial sources around Houston, home to the nation’s largest petrochemical and refinery complex, according to a new report. Air Alliance Houston, an environmental nonprofit, analyzed data from the U.S. Environmental Protection Agency’s Toxics Release […]", "text_kind": "source_excerpt", "text_characters": 391, "text_sha256": "8bcb1c566823b42e02df49fbf2799d7a353ef5e158a1057e7ab76d6beb599d8e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:22.944476+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:22.956454+00:00", "published_at_raw": "2024-07-30T20:43:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 334, "end": 338, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_3a80f7fd51733e41e4e4", "record_id": "article_3a80f7fd51733e41", "canonical_url": "https://dialogue.earth/en/pollution/cleaner-air-shown-to-have-reduced-suicides-in-china", "publisher_url": "https://dialogue.earth/en/pollution/cleaner-air-shown-to-have-reduced-suicides-in-china", "title_original": "Cleaner air shown to have reduced suicides in China", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-30T16:08:21+00:00", "source_text": "A new study has identified a causal link between cleaner air in China and reductions in suicide. The researchers discovered fewer suicides on days with less air pollution. Other studies have found that the impacts of extreme temperatures can compound those of air pollution to increase the risk of depression and suicide. Together, these findings demonstrate the importance of cooperation between sectors and governments to improve air quality and alleviate extreme temperatures, experts tell Dialogue Earth. Tamma Carleton is a co-author of the new study and an assistant professor at the University of California, Santa Barbara’s Bren School of Environmental Science & Management.", "text_kind": "article_excerpt", "text_characters": 682, "text_sha256": "9d8d7a6a63909de49f0050ee3d91336c6936cd51e96035f222dc4cd5c32cb8b6", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:09.673496+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "count