{"text_id": "text_edde45adc283499727d4", "record_id": "article_edde45adc2834997", "canonical_url": "https://news.mongabay.com/2026/08/as-hay-fever-sufferers-grow-in-japan-the-country-is-looking-to-plant-no-pollen-trees", "publisher_url": "https://news.mongabay.com/2026/08/as-hay-fever-sufferers-grow-in-japan-the-country-is-looking-to-plant-no-pollen-trees", "title_original": "As hay fever sufferers grow in Japan, the country is looking to plant no-pollen trees", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-26T16:09:59+00:00", "source_text": "TOKYO — For Mariko Aoki, the new year began with an itch. “Right after the New Year in January, my nose starts to get a little itchy,” Aoki said. “It peaks in March, and the sneezing, runny nose, itchy throat and itchy eyes are really bad. It lasts all the way until just before Golden […]", "text_kind": "source_excerpt", "text_characters": 289, "text_sha256": "5e033c8e9d77e993694faf790b1f27c8a986a1e86006740b06710e1b82544bd9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:10.175880+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_sourc