{"text_id": "text_a1b473d95e5ac78eeeff", "record_id": "article_a1b473d95e5ac78e", "canonical_url": "https://insideclimatenews.org/news/31102026/colorado-river-basin-gubernatorial-water-politics", "publisher_url": "https://insideclimatenews.org/news/31102026/colorado-river-basin-gubernatorial-water-politics", "title_original": "Colorado River Basin Candidates Wade Into Water Politics, but Winners Are Unlikely to Make Big Changes", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-31T09:00:00+00:00", "source_text": "In Nevada, Attorney General and Democratic candidate for governor Aaron Ford’s campaign has said Gov. Joe Lombardo, a Republican, “botched negotiations” over the future of the Colorado River. In neighboring Arizona, Rep. Andy Biggs, the Republican Party’s candidate for governor, has said Democratic Gov. Katie Hobbs has cost the state millions of gallons of water […]", "text_kind": "source_excerpt", "text_characters": 368, "text_sha256": "0343d0ad075649274dbbb42068770b5e8979f5101535dd16f87ae1f1ce670c9e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:24.387688+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": 