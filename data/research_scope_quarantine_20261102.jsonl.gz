{"text_id": "text_011f9194729b849d156b", "record_id": "article_011f9194729b849d", "canonical_url": "https://news.mongabay.com/2024/08/the-challenge-of-the-next-oil-and-gas-investments-further-in-the-pan-amazon", "publisher_url": "https://news.mongabay.com/2024/08/the-challenge-of-the-next-oil-and-gas-investments-further-in-the-pan-amazon", "title_original": "The challenge of the next oil and gas investments further in the Pan Amazon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-28T09:53:14+00:00", "source_text": "Ucayali Basin and the Camisea Megacampo Further south in Peru, the Ucayali Basin occupies a broad stretch of the Andean foothills and adjacent piedmont. It is a foreland basin located between the Contaya Arch in the North and the Manu arch in the South. Its most significant component is the Camisea gas field, which was […]", "text_kind": "source_excerpt", "text_characters": 324, "text_sha256": "0fb1fa81381d246527e7cf1b84d84e867414898001ca2780bd814688e1b61f8d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:38.323972+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:38.343352+00:00", "published_at_raw": "2024-08-28T09:53:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru", "start": 57, "end": 61, "matched_text": "Peru", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_76075e5ba61d81e3360a", "record_id": "article_76075e5ba61d81e3", "canonical_url": "https://dialogue.earth/en/justice/southeast-asias-highly-anticipated-environmental-rights-declaration-watered-down-say-critics", "publisher_url": "https://dialogue.earth/en/justice/southeast-asias-highly-anticipated-environmental-rights-declaration-watered-down-say-critics", "title_original": "Southeast Asia’s highly anticipated environmental rights declaration ‘watered down’, say critics", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-27T22:59:00+00:00", "source_text": "On 24 March, two young anti-coal activists were abducted from a tuk-tuk in San Carlos, the Philippines, and forced into another vehicle. Francisco “Eco” Dangla III and Joxelle “Jak” Tiong were later found alive; both had been assaulted. Their ordeal coincided with ongoing efforts across Southeast Asia to protect environmental defenders through a region-wide declaration on environmental rights. From 2012 to 2021, 318 land and environmental defenders were killed across Southeast Asia, representing 18% of the global total, according to Global Witness . The Philippines ranks as Asia’s most lethal country for such activists, with 281 recorded deaths since 2012.", "text_kind": "article_excerpt", "text_characters": 664, "text_sha256": "dc0e809925529d053bbefc9c54740288d5196fd88405316af443ea71d5c2a832", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:00.884052+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "18%", "start": 501, "end": 504, "evidence": " From 2012 to 2021, 318 land and environmental defenders were killed across Southeast Asia, representing 18% of the global total, according to Global Witness .", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 28, "end": 32, "evidence": "On 24 March, two young anti-coal activists were abducted from a tuk-tuk in San Carlos, the Philippines, and forced into another vehicle. Francisco “Eco” Dangla III and Joxe"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:00.902452+00:00", "published_at_raw": "2024-08-27T22:59:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines", "start": 91, "end": 102, "matched_text": "Philippines", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_c29b88e7bca2be0a554e", "record_id": "article_c29b88e7bca2be0a", "canonical_url": "https://yaleclimateconnections.org/2024/08/puerto-rican-farmers-will-replant-despite-ernestos-impacts", "publisher_url": "https://yaleclimateconnections.org/2024/08/puerto-rican-farmers-will-replant-despite-ernestos-impacts", "title_original": "Puerto Rican farmers will replant despite Ernesto’s impacts", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-27T11:00:00+00:00", "source_text": "The well-known Puerto Rican song “ Temporal ,” or “Storm,” includes the line, “the green hurts in the eyes, the harvest that is lost.” The song captures how many of us felt upon seeing images of our farmers’ crops on the ground, the result of winds and rains from Tropical Storm Ernesto as it passed through the eastern part of Puerto Rico on August 14. “Having to see years of work on the ground is something that stirs all your senses. Moreover, a lot of money is invested. I lose my appetite. It’s like mourning,” said Marisita López Cortés, a farmer from the mountainous town of Villalba, in the south of the main island of the Puerto Rican archipelago. Those words echo the sentiments of people in the region who saw their crops on the ground, people in whose eyes the green hurt.", "text_kind": "article_excerpt", "text_characters": 785, "text_sha256": "9e9b512eeb3362cce7b3fe8404e0e7071eec232adfc4ee06cd1af2e36a560f3c", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:24.390165+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PR", "alpha3": "PRI", "name_zh": "波多黎各", "name_en": "Puerto Rico"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PR", "alpha3": "PRI", "name_zh": "波多黎各", "name_en": "Puerto Rico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:24.424102+00:00", "published_at_raw": "2024-08-27T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PR", "alpha3": "PRI", "name_zh": "波多黎各", "name_en": "Puerto Rico", "start": 328, "end": 339, "matched_text": "Puerto Rico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_e002a309dc5f5d2401cb", "record_id": "article_e002a309dc5f5d24", "canonical_url": "https://yaleclimateconnections.org/2024/08/typhoon-shanshan-strengthens-en-route-to-japan", "publisher_url": "https://yaleclimateconnections.org/2024/08/typhoon-shanshan-strengthens-en-route-to-japan", "title_original": "Typhoon Shanshan strengthens en route to Japan", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-26T16:58:33+00:00", "source_text": "Typhoon Shanshan is intensifying over unusually warm waters of 30-31 degrees Celsius (86-88°F) southeast of Japan. At 11 a.m. EDT Monday, Shanshan was a Category 2 storm with 105 mph winds with a central pressure of 958 mb and was located 267 miles east-northeast of Okinawa, headed west-northwest at 9 mph, according to the Joint Typhoon Warning Center. Satellite loops showed that Shanshan had a solid area of heavy thunderstorms surrounding a prominent eye but moderate wind shear of 15-20 knots was slowing development. Shanshan’s peak intensity is predicted to occur Tuesday afternoon and evening (U.S. EDT) when the Joint Typhoon Warning Center predicts the typhoon will be moving through Japan’s Ryukyu Islands as a high-end Category 3 storm with 125 mph winds (one-minute average).", "text_kind": "article_excerpt", "text_characters": 789, "text_sha256": "74aa9a6a29a82e5774d59425275d91e6aec6216c9ceb974f74f3f9135ce2c8fb", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:24.492484+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:24.524794+00:00", "published_at_raw": "2024-08-26T16:58:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan", "start": 41, "end": 46, "matched_text": "Japan", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan", "start": 108, "end": 113, "matched_text": "Japan", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 603, "end": 607, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_465cb7cb448d58879219", "record_id": "article_465cb7cb448d5887", "canonical_url": "https://insideclimatenews.org/news/26082024/florida-everglades-lake-okeechobee-toxic-algae-management-plan", "publisher_url": "https://insideclimatenews.org/news/26082024/florida-everglades-lake-okeechobee-toxic-algae-management-plan", "title_original": "New Lake Okeechobee Plan Aims for More Water for the Everglades, Less Toxic Algae", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-26T09:00:00+00:00", "source_text": "At the heart of the vast watershed that forms Florida’s fragile Everglades is Lake Okeechobee. A century ago the water of the state’s largest lake spilled effortlessly beyond its southern shore, flowing eventually into the sawgrass prairies of the river of grass. Today the natural course of the water has been altered forever by some […]", "text_kind": "source_excerpt", "text_characters": 338, "text_sha256": "9df9ac5c240f4b9cd7a8c2828fa066c45437b211f6e8ab204cd3f4bc40c5b92a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:07.956352+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:07.969423+00:00", "published_at_raw": "2024-08-26T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_30f5bfbf65701e6cf1d4", "record_id": "article_30f5bfbf65701e6c", "canonical_url": "https://news.mongabay.com/2024/08/china-accepts-u-n-recommendations-to-improve-environmental-conflicts-in-latin-america", "publisher_url": "https://news.mongabay.com/2024/08/china-accepts-u-n-recommendations-to-improve-environmental-conflicts-in-latin-america", "title_original": "China accepts U.N. recommendations to improve environmental conflicts in Latin America", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-23T17:08:30+00:00", "source_text": "It’s been a little over a decade since China launched its Belt and Road Initiative, a global program to improve relations with Latin America and other developing regions through trillions of dollars in investment in infrastructure and energy projects. But China hasn’t always carried out those projects in a responsible way, sparking outcry about their […]", "text_kind": "source_excerpt", "text_characters": 356, "text_sha256": "2b87884ca492baf2c8effb4783562db2910ff79743698f4df7b30a17686f2636", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:38.620264+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 235, "end": 241, "evidence": "other developing regions through trillions of dollars in investment in infrastructure and energy projects. But China hasn’t always carried out those projects in a responsible way, sparking outcry about their […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:38.633986+00:00", "published_at_raw": "2024-08-23T17:08:30", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 0, "end": 5, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 39, "end": 44, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_143a8eeca55b7391621c", "record_id": "article_143a8eeca55b7391", "canonical_url": "https://insideclimatenews.org/news/23082024/invasive-seagrass-species-halophila-stipulacea", "publisher_url": "https://insideclimatenews.org/news/23082024/invasive-seagrass-species-halophila-stipulacea", "title_original": "The Seagrass Species That Is Not So Slowly Taking Over the World", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-23T09:00:00+00:00", "source_text": "It started life in the Indian Ocean, hitched a ride to the Mediterranean through the Suez Canal and kept pushing west. Now the fast-growing seagrass known as Halophila stipulacea is expanding in the Caribbean as waters warm, outcompeting important native grasses. It’s the definition of an invasive species. But how bad is this globetrotter? Scientists […]", "text_kind": "source_excerpt", "text_characters": 356, "text_sha256": "634ba320edf95f3e861ea831f5551d06fb3f2c2c45c07c7a12d3d7d540cc46a5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:08.675627+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:08.703486+00:00", "published_at_raw": "2024-08-23T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_2079444caced36dbc64c", "record_id": "article_2079444caced36db", "canonical_url": "https://news.mongabay.com/2024/08/the-indelible-traces-of-oil-and-gas-in-the-peruvian-ecuadorian-and-colombian-amazon", "publisher_url": "https://news.mongabay.com/2024/08/the-indelible-traces-of-oil-and-gas-in-the-peruvian-ecuadorian-and-colombian-amazon", "title_original": "The indelible traces of oil and gas in the Peruvian, Ecuadorian and Colombian Amazon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-22T11:29:57+00:00", "source_text": "Petroleum geologists explore for economically significant reservoirs of oil and gas using technologies that have evolved in sophistication as the industry grew to dominate the global economy in the twentieth century. They begin with geological surveys that identify the various rock formations that lie within, underneath or adjacent to a sedimentary basin capable of holding […]", "text_kind": "source_excerpt", "text_characters": 379, "text_sha256": "57815df88d8794c38a3f798ba2522be98491a693d94dbafe61b90a2930058729", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:38.722876+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:38.743082+00:00", "published_at_raw": "2024-08-22T11:29:57", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_1b4e8864c0a950014243", "record_id": "article_1b4e8864c0a95001", "canonical_url": "https://insideclimatenews.org/news/21082024/valuable-arizona-water-could-soon-hit-the-market", "publisher_url": "https://insideclimatenews.org/news/21082024/valuable-arizona-water-could-soon-hit-the-market", "title_original": "Some of Arizona’s Most Valuable Water Could Soon Hit the Market", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-21T09:00:00+00:00", "source_text": "PARKER, Arizona—South of Headgate Rock Dam, beyond riverbanks lined with willow and mesquite, the broad floodplain of the Colorado River spreads across emerald fields and sun-bleached earth. The Colorado River has nourished these lands in present-day western Arizona for millennia, from the ancestral Mohave people who cultivated corn, squash, beans, and melons, to the contemporary […]", "text_kind": "source_excerpt", "text_characters": 386, "text_sha256": "3473133737f47bf742e98ada8e0d78895fd661041cb85d7f7d191da861103715", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:08.979918+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 104, "end": 109, "evidence": "a—South of Headgate Rock Dam, beyond riverbanks lined with willow and mesquite, the broad floodplain of the Colorado River spreads across emerald fields and sun-bleached earth. The Colorado River has nourished these lands in present-da"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:08.991272+00:00", "published_at_raw": "2024-08-21T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_ac870acd43fa7cbd3f66", "record_id": "article_ac870acd43fa7cbd", "canonical_url": "https://news.mongabay.com/2024/08/conserving-restoring-waterways-can-mitigate-extreme-urban-heat-in-bangladesh", "publisher_url": "https://news.mongabay.com/2024/08/conserving-restoring-waterways-can-mitigate-extreme-urban-heat-in-bangladesh", "title_original": "Conserving & restoring waterways can mitigate extreme urban heat in Bangladesh", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-20T14:10:48+00:00", "source_text": "DHAKA — In pre-monsoon the heat of May, five teenage boys used a rope with knots in it to scale a wall and enter the national botanical gardens in Dhaka, the capital of Bangladesh. They dropped down next to a big pond surrounded by foliage encircled by a pedestrian path. Beyond the walls, the youths […]", "text_kind": "source_excerpt", "text_characters": 304, "text_sha256": "b6c93a46a05a764ac93ecfe22adaaab6144760736b48a5c3fa8170a9baed9f43", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:38.892258+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:38.907594+00:00", "published_at_raw": "2024-08-20T14:10:48", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh", "start": 68, "end": 78, "matched_text": "Bangladesh", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh", "start": 169, "end": 179, "matched_text": "Bangladesh", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_fbc3598a5dcc17e97033", "record_id": "article_fbc3598a5dcc17e9", "canonical_url": "https://yaleclimateconnections.org/2024/08/how-open-spaces-can-save-lives-during-wildfires", "publisher_url": "https://yaleclimateconnections.org/2024/08/how-open-spaces-can-save-lives-during-wildfires", "title_original": "How open spaces can save lives during wildfires", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-20T11:00:00+00:00", "source_text": "In 2018, the Camp Fire raced through Paradise, California, and destroyed the town, killing dozens of people. But many residents were saved by taking shelter in a local park, which was spared from the flames. Glaser: “The fire had burned right up to the edge of the park and stopped there. There are actually pictures where you can see all the burn around.” Deborah Glaser is a disaster specialist with the Nature Conservancy. She says the open space helped slow the fire down. Glaser: “The park is irrigated. And there’s a break from the fuel that carries fire through a forest.” So now Glaser and others are trying to create a ring of firebreaks around Paradise to protect the town from future fires. These firebreaks could include more parks as well as fields, pastures, or orchards.", "text_kind": "article_excerpt", "text_characters": 785, "text_sha256": "725db4d900d4673e9f54f70bfca02661a0ec8164136d8cfb2f5328c3094abd26", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:24.995147+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:25.043974+00:00", "published_at_raw": "2024-08-20T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 47, "end": 57, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_ed0e6ff16914a2e2184e", "record_id": "article_ed0e6ff16914a2e2", "canonical_url": "https://dialogue.earth/en/ocean/qa-twenty-years-ago-chileans-had-no-idea-we-have-whales", "publisher_url": "https://dialogue.earth/en/ocean/qa-twenty-years-ago-chileans-had-no-idea-we-have-whales", "title_original": "Q&A: ‘Twenty years ago, Chileans had no idea we have whales’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-20T09:53:55+00:00", "source_text": "Chile has shown major commitment to the protection of its seas in recent years, trebling its marine protected areas between 2010 and 2020 to cover 43% of its ocean surface, and being one of the first nations to ratify the UN High Seas Treaty in January. For Maximiliano Bello, this leadership is part of a significant change in Chilean society, toward a much greater appreciation of the ocean. Working on ocean issues for over 20 years, Bello is currently a policy advisor for Mission Blue , an NGO working to protect marine life. In this interview with Dialogue Earth, he discusses changing perceptions of the sea in Chile, the challenges ahead, and the role of Latin America in protecting the ocean.", "text_kind": "article_excerpt", "text_characters": 701, "text_sha256": "c0447f76939a5ccca608f3690166af9b8a9f2ea31873d152a467fef6488f6690", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:01.008871+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "43%", "start": 147, "end": 150, "evidence": "Chile has shown major commitment to the protection of its seas in recent years, trebling its marine protected areas between 2010 and 2020 to cover 43% of its ocean surface, and being one of the first nations to ratify the UN High Seas Treaty in January.", "interpretation": "target_or_commitment"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:01.028948+00:00", "published_at_raw": "2024-08-20T09:53:55", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile", "start": 0, "end": 5, "matched_text": "Chile", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_bc8866cdc8fd555e2fcc", "record_id": "article_bc8866cdc8fd555e", "canonical_url": "https://yaleclimateconnections.org/2024/08/ernesto-heads-toward-a-saturday-encounter-with-bermuda", "publisher_url": "https://yaleclimateconnections.org/2024/08/ernesto-heads-toward-a-saturday-encounter-with-bermuda", "title_original": "Ernesto heads toward a Saturday encounter with Bermuda", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-16T15:55:31+00:00", "source_text": "Hurricane warning flags are flying on Bermuda for the expected arrival of Ernesto as the Category 2 storm rumbles across the western Atlantic toward a close pass or direct hit on the island expected to occur early Saturday morning. Update: Ernesto made landfall on Bermuda at 4:30 a.m. AST Saturday, August 17, as a category 1 storm with 85 mph winds and a central pressure of 970 mb. Ernesto was the first hurricane to make a direct hit on the island since Cat 2 Hurricane Paulette of 2020. At 11 a.m. EDT Friday , Ernesto was a Category 2 storm with 100 mph winds and a central pressure of 970 mb, centered about 215 miles south-southwest of Bermuda, moving north-northeast at 14 mph.", "text_kind": "article_excerpt", "text_characters": 686, "text_sha256": "30d7a06191cb5589bf4d96ec85b488b5c38efa44bc726b8d0a8742728fe08ba2", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:32.038521+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attr