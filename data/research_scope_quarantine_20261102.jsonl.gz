{"text_id": "text_3cc479f4e85b054b7f18", "record_id": "article_3cc479f4e85b054b", "canonical_url": "https://insideclimatenews.org/news/28092024/fate-of-thousands-dams-rural-communities", "publisher_url": "https://insideclimatenews.org/news/28092024/fate-of-thousands-dams-rural-communities", "title_original": "The Fate of Thousands of US Dams Hangs in the Balance, Leaving Rural Communities With Hard Choices", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-28T08:50:00+00:00", "source_text": "VIROQUA, Wis.—Sheldon Auto Wrecking is a local institution in southwestern Wisconsin’s Vernon County. It’s tucked in a lush valley just downstream of a 50-foot earthen dam, locally known as “Maple Dale.” The salvage yard, which buys used vehicles and farm machinery in this rural area to sell for parts, has been in business for nearly […]", "text_kind": "source_excerpt", "text_characters": 339, "text_sha256": "c5551dfce18b23c034ef737e7bca4d81514ab7d5e9ca5b9d45ad160118f93e17", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:54.609971+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", 