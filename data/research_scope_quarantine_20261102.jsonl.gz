{"text_id": "text_0c4679d2b5d38f2ee2d0", "record_id": "article_0c4679d2b5d38f2e", "canonical_url": "https://insideclimatenews.org/news/28042025/epa-tackles-forever-chemicals-advocates-skeptical", "publisher_url": "https://insideclimatenews.org/news/28042025/epa-tackles-forever-chemicals-advocates-skeptical", "title_original": "EPA Says It Will Act on PFAS ‘Forever Chemicals.’ Advocates Raise Red Flags", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-29T00:17:02+00:00", "source_text": "As the Environmental Protection Agency works to roll back multiple public-health protections, it announced Monday that it intends to take action to combat toxic forever chemicals. Advocates are skeptical, saying the language of the announcement raises red flags. The EPA announcement consists of a list of proposed actions to target contamination by per– and polyfluoroalkyl […]", "text_kind": "source_excerpt", "text_characters": 378, "text_sha256": "df28265417baec5360fdd403939542e24c1b0bd6d5f21adcba6bf063e7b9347c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:11.415675+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 306, "end": 314, "evidence": "language of the announcement raises red flags. The EPA announcement consists of a list of proposed actions to target contamination by per– and polyfluoroalkyl […]"}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:11.446785+00:00", "published_at_raw": "2025-04-29T00:17:02", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_b829eec1972c61d327ef", "record_id": "article_b829eec1972c61d3", "canonical_url": "https://news.mongabay.com/2025/04/refocusing-conservation-funding-on-trust-community-leadership-after-usaid-freeze-commentary", "publisher_url": "https://news.mongabay.com/2025/04/refocusing-conservation-funding-on-trust-community-leadership-after-usaid-freeze-commentary", "title_original": "Refocusing conservation funding on trust & community leadership after USAID freeze (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-28T20:48:06+00:00", "source_text": "The abrupt suspension of USAID’s recent international funding sent shockwaves through the global conservation community. With more than $375 million disbursed in 2023, this freeze disrupted critical biodiversity programs across Kenya, Namibia, the Congo Basin, and Indonesia, halting ranger salaries, community conservation, and anti-trafficking operations. But beyond its immediate damage, the freeze has illuminated a […]", "text_kind": "source_excerpt", "text_characters": 423, "text_sha256": "56ef4e0fbdf130893342664b1cc3f0865b6468cd1e5277f502819886b2ef7a1c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:29.475436+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$375 million", "start": 136, "end": 148, "evidence": " With more than $375 million disbursed in 2023, this freeze disrupted critical biodiversity programs across Kenya, Namibia, the Congo Basin, and Indonesia, halting ranger salaries, community conservation, and anti-trafficking operations.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NA", "alpha3": "NAM", "name_zh": "纳米比亚", "name_en": "Namibia"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}, {"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 54, "end": 61, "evidence": "The abrupt suspension of USAID’s recent international funding sent shockwaves through the global conservation community. With more than $375 million disbursed in 2023, this freeze disrupted critical bi"}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NA", "alpha3": "NAM", "name_zh": "纳米比亚", "name_en": "Namibia"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}, {"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:29.526697+00:00", "published_at_raw": "2025-04-28T20:48:06", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 228, "end": 233, "matched_text": "Kenya", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "NA", "alpha3": "NAM", "name_zh": "纳米比亚", "name_en": "Namibia", "start": 235, "end": 242, "matched_text": "Namibia", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start"