{"text_id": "text_b17725d12df35eb82602", "record_id": "article_b17725d12df35eb8", "canonical_url": "https://yaleclimateconnections.org/2026/07/the-government-killed-this-nature-study-scientists-finished-it-anyway", "publisher_url": "https://yaleclimateconnections.org/2026/07/the-government-killed-this-nature-study-scientists-finished-it-anyway", "title_original": "The government canceled this nature study. Scientists kept going anyway.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-24T11:00:00+00:00", "source_text": "When the National Nature Assessment was shut down, the scientists who worked on it found another way. In this Q&A, one author explains what the research reveals about nature’s powerful, underused role in supporting health.", "text_kind": "source_excerpt", "text_characters": 222, "text_sha256": "4fbe21da9af18e764e8c334dd4c6a3deaebcb07f79b6f9f08a9b33d907c965ef", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:44.831829+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:44.860821+00:00", "published_at_r