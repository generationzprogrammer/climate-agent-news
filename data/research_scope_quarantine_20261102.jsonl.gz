{"text_id": "text_86d1ca317f5ad96ed62e", "record_id": "article_86d1ca317f5ad96e", "canonical_url": "https://insideclimatenews.org/news/21022026/virginia-paraquat-ban-bill", "publisher_url": "https://insideclimatenews.org/news/21022026/virginia-paraquat-ban-bill", "title_original": "Virginia House Delays Action on Bill Banning Paraquat", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-21T10:00:00+00:00", "source_text": "RICHMOND, Va.—A bill banning the pesticide paraquat died last week in the Virginia House of Delegates after the chamber’s Agriculture, Chesapeake and Natural Resources Committee voted 22-0, with little explanation, to carry the measure over to next year for consideration. Parquat is used across more than 200,000 acres in Virginia on various crops, including corn, […]", "text_kind": "source_excerpt", "text_characters": 369, "text_sha256": "242321684b2ab0da58777e5e1106eb25c30fba2a85b63b8d40457d52a09a47e8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:43.583963+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48