{"text_id": "text_b5b2fc704a42b693b503", "record_id": "article_b5b2fc704a42b693", "canonical_url": "https://insideclimatenews.org/news/01122025/judith-enck-big-plastics-book", "publisher_url": "https://insideclimatenews.org/news/01122025/judith-enck-big-plastics-book", "title_original": "Peeling Back the Curtain on Big Plastic’s False Solutions", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-01T09:50:00+00:00", "source_text": "Judith Enck has spent her entire career working to protect public health and the environment. Enck took the helm of New York’s oldest environmental organization, Environmental Advocates NY, soon after graduating college, then went on to hold senior leadership roles in state and federal government, including as deputy secretary for the environment in the New […]", "text_kind": "source_excerpt", "text_characters": 363, "text_sha256": "d6777009c6df6be7d633dd4718ad4bd44a26f9eae10c45ec5359e2239a214d1d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:36.229927+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T0