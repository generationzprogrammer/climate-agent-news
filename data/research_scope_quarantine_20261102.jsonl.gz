{"text_id": "text_cc6dd3f845df0d0399e3", "record_id": "article_cc6dd3f845df0d03", "canonical_url": "https://news.mongabay.com/2025/04/illegal-gold-mining-creeps-within-a-kilometer-of-amazons-second-tallest-tree", "publisher_url": "https://news.mongabay.com/2025/04/illegal-gold-mining-creeps-within-a-kilometer-of-amazons-second-tallest-tree", "title_original": "Illegal gold mining creeps within a kilometer of Amazon’s second-tallest tree", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-14T17:11:37+00:00", "source_text": "Illegal gold miners have been moving into Amapá in the wake of federal raids on mining hotspots in other parts of the Brazilian Amazon, including the Yanomami and Munduruku Indigenous territories.", "text_kind": "source_excerpt", "text_characters": 196, "text_sha256": "75c7149ac218536db3cdca4285ffc7c1b09f7369abb7a0912d32173413f685c1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:35.939403+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 173, "end": 183, "evidence": "ing hotspots in other parts of the Brazilian Amazon, including the Yanomami and Munduruku Indigenous territories."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted