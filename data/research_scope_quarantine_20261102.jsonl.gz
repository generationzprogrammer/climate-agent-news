{"text_id": "text_11afa58f39dbd0e2a324", "record_id": "article_11afa58f39dbd0e2", "canonical_url": "https://insideclimatenews.org/news/05052025/michigan-brownfield-sites-solar-power", "publisher_url": "https://insideclimatenews.org/news/05052025/michigan-brownfield-sites-solar-power", "title_original": "From Blight to Bright: Michigan Explores Solar Power on Brownfield Sites", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-05T09:00:00+00:00", "source_text": "Michigan has 24,000 known contaminated sites, a legacy of heavy manufacturing where industries carelessly discarded hazardous materials with minimal regulatory oversight. Taxpayers are often left to clean up these abandoned locations, known as brownfields, while the sheer volume of toxic sites has overwhelmed state regulators. With a little effort, these spaces can be more than […]", "text_kind": "source_excerpt", "text_characters": 384, "text_sha256": "1444a245eee7aec899ef527adf30ca63c1aa60afac4ff9a42c1bff99572032df", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:03.286983+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:03.299750+00:00", "published_at_raw": "2025-05-05T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_755a33eeec97cfb7eeea", "record_id": "article_755a33eeec97cfb7", "canonical_url": "https://news.mongabay.com/2025/05/in-the-pan-amazon-regulators-struggle-to-punish-environmental-crimes", "publisher_url": "https://news.mongabay.com/2025/05/in-the-pan-amazon-regulators-struggle-to-punish-environmental-crimes", "title_original": "In the Pan Amazon, regulators struggle to punish environmental crimes", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-02T18:00:50+00:00", "source_text": "Administrative law is based on legislation that creates, organizes and defines the responsibilities of government agencies. As such, the regulatory apparatus of the modern state is the product of laws creating agencies that oversee various aspects of the national economy, such as basic utilities (water and sanitation), financial services, air traffic control and telecommunications, as […]", "text_kind": "source_excerpt", "text_characters": 391, "text_sha256": "66bdb7d6b5c30abee8ca199b345b4f94bc73faa970ba9d196dcc96b51bbe6a79", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:24.103547+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "ht