{"text_id": "text_669be2cc8e843f3ee74f", "record_id": "article_669be2cc8e843f3e", "canonical_url": "https://insideclimatenews.org/news/29062025/truckers-movement-for-justice-oil-gas-hazardous-materials", "publisher_url": "https://insideclimatenews.org/news/29062025/truckers-movement-for-justice-oil-gas-hazardous-materials", "title_original": "Truckers Say Oil and Gas Companies Are Violating Hazardous Materials Transport Regulations", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-29T08:55:00+00:00", "source_text": "Fracking’s Forever Problem: Fifth in a series about the gas industry’s radioactive waste. When Tom McKnight started working for the oil and gas industry as a truck driver in Ohio more than 10 years ago, he attended an orientation where someone in the class asked about the possibility of radiation exposure from fracking waste. The […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "3cb675887086120f9008378736f219fd1583c56979b5c2f9d9f706bc1f4703a2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:27.566641+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.or