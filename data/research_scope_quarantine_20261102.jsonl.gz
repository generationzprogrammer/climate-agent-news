{"text_id": "text_1b80f4449cfe614eace0", "record_id": "article_1b80f4449cfe614e", "canonical_url": "https://news.mongabay.com/2024/04/goldman-prize-honors-brazilian-investigation-linking-jbs-deforestation", "publisher_url": "https://news.mongabay.com/2024/04/goldman-prize-honors-brazilian-investigation-linking-jbs-deforestation", "title_original": "Goldman Prize honors Brazilian investigation linking JBS & deforestation", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-29T07:00:42+00:00", "source_text": "Marcel Gomes, the executive secretary at investigative journalism outlet Repórter Brasil, is one of this year’s prestigious Goldman Environmental Prize winners.", "text_kind": "source_excerpt", "text_characters": 160, "text_sha256": "dfbf259bc3b9e0aad6a9c87cd3220a83c0c1fedd0660474442530e57b2254cf6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:40.401497+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:40.432544+00:00", "published_at_raw": "2024-04-29T07:00:42", "sample_frame": "public_archives_20261102", "sampling_method": "determinist