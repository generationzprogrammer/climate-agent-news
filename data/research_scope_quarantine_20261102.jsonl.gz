{"text_id": "text_1b1a8e50c9f34fc06158", "record_id": "article_1b1a8e50c9f34fc0", "canonical_url": "https://news.mongabay.com/2025/12/tatiana-schlossberg-environmental-journalist-has-died-aged-35", "publisher_url": "https://news.mongabay.com/2025/12/tatiana-schlossberg-environmental-journalist-has-died-aged-35", "title_original": "Tatiana Schlossberg, environmental journalist, has died, aged 35", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-30T22:09:47+00:00", "source_text": "She wrote about damage that accumulated slowly, in places most people did not look, and about the systems that allowed it to be ignored. When her own life was overtaken by illness, she approached that, too, as a problem to be understood rather than transcended. She died today, aged 35, after a year and a […]", "text_kind": "source_excerpt", "text_characters": 309, "text_sha256": "1e6d4914c099c898b6393f8c34b163c8e507983f07c5c4de1d658acde5212a59", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:39.334154+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:39.361213+00: