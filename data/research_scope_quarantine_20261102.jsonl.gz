projects hinders Wyoming coal communities’ ability to access funds that could prove critical to the transformation of local ener"}], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 94, "end": 99, "evidence": "port released this month by Resources for the Future found that the complexity of federal grant applications for energy transition projects hinders Wyoming coal communities’ ability to access funds that could prove critical to the tran"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:12.004074+00:00", "published_at_raw": "2024-12-31T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_16d57e8095949befc55f", "record_id": "article_16d57e8095949bef", "canonical_url": "https://insideclimatenews.org/news/28122024/tennessee-climbing-utility-rates", "publisher_url": "https://insideclimatenews.org/news/28122024/tennessee-climbing-utility-rates", "title_original": "In Tennessee, Climbing Utility Rates and More Than 140,000 Household Cut-Offs in 2023", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-12-28T10:00:00+00:00", "source_text": "MEMPHIS, Tenn.—Cat Grisanti’s shift at Create A Cig, a vape store in Memphis, was stressful enough even before she received an alert on her phone in March. It said she owed Memphis Light, Gas and Water $800. The 39-year-old store manager immediately went into the bathroom to scream. She had already used her income tax […]", "text_kind": "source_excerpt", "text_characters": 323, "text_sha256": "a7b6873ec7c3d79041f273e46eb41bcf5dcae355d024c0e6717204579a29e25b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:12.384329+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:1