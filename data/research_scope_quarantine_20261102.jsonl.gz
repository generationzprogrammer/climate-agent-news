{"text_id": "text_15c1e82851ef32cd4697", "record_id": "article_15c1e82851ef32cd", "canonical_url": "https://insideclimatenews.org/news/24102025/new-jersey-lng-export-terminal-lawsuit", "publisher_url": "https://insideclimatenews.org/news/24102025/new-jersey-lng-export-terminal-lawsuit", "title_original": "Environmentalists Sue Regulator Over Extension of Construction Permit for LNG Export Terminal in New Jersey", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-24T17:29:54+00:00", "source_text": "An environmental group is suing a regional regulator over its recent extension of a construction permit for a terminal to export liquefied natural gas from a town in southern New Jersey. The agency’s action marks a new turn in a multi-year battle over plans to build what would be the state’s first such plant. Delaware […]", "text_kind": "source_excerpt", "text_characters": 323, "text_sha256": "9469c317e6e99375da7b2c0b5da14edeb47e3a7e970283700dc88b56c7f2473c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:02.326083+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evid