{"text_id": "text_675535de7d4dd298813b", "record_id": "article_675535de7d4dd298", "canonical_url": "https://insideclimatenews.org/news/11092025/inside-clean-energy-utility-scale-solar-hailstorms", "publisher_url": "https://insideclimatenews.org/news/11092025/inside-clean-energy-utility-scale-solar-hailstorms", "title_original": "Utility-Scale Solar Can Withstand Severe Hailstorms. Here’s How", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-11T13:00:00+00:00", "source_text": "As Texas becomes the country’s leader in generating solar power, the state’s propensity for severe hailstorms is a hazard that energy companies aim to manage. I’m writing about solar and hail this week, not because of any incident, but because of a lack of incidents. We are near the end of the spring and summer […]", "text_kind": "source_excerpt", "text_characters": 316, "text_sha256": "da8bc8748549a095074847df4fad6a0581a6f47d5fc96baaf1206e28f2739e22", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:41.758911+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 52, "end": 57, "evidence": "As Texas becomes the country’s leader in generating solar power, the state’s propensity for severe hailstorms is a hazard that energy companies aim to manage. I’m writing about solar and hail this "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:41.777645+00:00", "published_at_raw": "2025-09-11T13:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 3, "end": 8, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_6caa1421b712db5cc3af", "record_id": "article_6caa1421b712db5c", "canonical_url": "https://news.mongabay.com/2025/09/the-need-for-success-stories-in-conservation", "publisher_url": "https://news.mongabay.com/2025/09/the-need-for-success-stories-in-conservation", "title_original": "The need for success stories in conservation (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-11T10:12:14+00:00", "source_text": "The gorilla should have vanished. In the late 1980s, the mountain gorilla clung to survival in the misted borderlands of Rwanda, Uganda, and the Democratic Republic of Congo. Poaching, snares, and civil conflict made extinction feel like a timetable. What changed was not a miracle but a grind: rangers risking their lives to keep […]", "text_kind": "source_excerpt", "text_characters": 334, "text_sha256": "7dd19dc706d60c5beb008d7c20f96fe8831c36981bcdd6d67da43cd172226308", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:07.465460+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "RW", "alpha3": "RWA", "name_zh": "卢旺达", "name_en": "Rwanda"}, {"alpha2": "UG", "alpha3": "UGA", "name_zh": "乌干达", "name_en": "Uganda"}, {"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "RW", "alpha3": "RWA", "name_zh": "卢旺达", "name_en": "Rwanda"}, {"alpha2": "UG", "alpha3": "UGA", "name_zh": "乌干达", "name_en": "Uganda"}, {"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:07.478042+00:00", "published_at_raw": "2025-09-11T10:12:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "RW", "alpha3": "RWA", "name_zh": "卢旺达", "name_en": "Rwanda", "start": 121, "end": 127, "matched_text": "Rwanda", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "UG", "alpha3": "UGA", "name_zh": "乌干达", "name_en": "Uganda", "start": 129, "end": 135, "matched_text": "Uganda", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)", "start": 145, "end": 173, "matched_text": "Democratic Republic of Congo", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_daf08c98709a712a4808", "record_id": "article_daf08c98709a712a", "canonical_url": "https://dialogue.earth/en/forests/rare-trees-find-refuge-in-chinas-temples", "publisher_url": "https://dialogue.earth/en/forests/rare-trees-find-refuge-in-chinas-temples", "title_original": "Rare trees find refuge in China’s temples", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-10T11:12:44+00:00", "source_text": "A flourishing nanmu tree towers over a four-storey Taoist temple, perhaps standing guard over it, perhaps taking refuge behind it. The tree, in Guizhou province’s Wuchuan county, is about 400 years old. Timber from the species, Phoebe zhennan , is extremely valuable and was once used in the construction of imperial temples. Nanmu trees were harvested for their timber for centuries and Phoebe zhennan is now listed as Vulnerable on the International Union for Conservation of Nature’s Red List. Yet here, in the Wenqige temple grounds, an individual survives. Nor is it a rarity. Our survey found many ancient trees surviving behind the walls of China’s temples. This made us wonder if the temples are really helping protect China’s ancient trees? If so, how?", "text_kind": "article_excerpt", "text_characters": 761, "text_sha256": "843a1a44a08b1d10d4c8c5f538ff32812d9ccbc78a31c522f8bbe8f0e522472c", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:12.817189+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:12.877161+00:00", "published_at_raw": "2025-09-10T11:12:44", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 26, "end": 31, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 648, "end": 653, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_9dd87eb985f7c08d37ea", "record_id": "article_9dd87eb985f7c08d", "canonical_url": "https://insideclimatenews.org/news/10092025/new-york-city-air-pollution", "publisher_url": "https://insideclimatenews.org/news/10092025/new-york-city-air-pollution", "title_original": "‘It’s Never Good!’: A Street-Level Look at New York City’s Air Quality", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-10T09:00:00+00:00", "source_text": "George Thurston stood at a bus stop on Manhattan’s east side, just a block from his office and the FDR Drive, a major highway in the city. He looked down at his large air monitor—a plastic tube jutted out of it, sucking in the surrounding air and measuring the amount of invisible particle pollution that […]", "text_kind": "source_excerpt", "text_characters": 308, "text_sha256": "77cb471b2ba68b3a1ac7f92a55f51e0d8a6f6d709afa581dfda0c60b99f24635", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:41.952942+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:41.967993+00:00", "published_at_raw": "2025-09-10T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_dd94d0171124ad0e54ea", "record_id": "article_dd94d0171124ad0e", "canonical_url": "https://news.mongabay.com/2025/09/independent-auditors-overvalue-credits-of-carbon-projects-study-finds", "publisher_url": "https://news.mongabay.com/2025/09/independent-auditors-overvalue-credits-of-carbon-projects-study-finds", "title_original": "‘Independent’ auditors overvalue credits of carbon projects, study finds", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-08T20:06:54+00:00", "source_text": "When questions arise about the integrity of carbon credits, project developers often point to one key safeguard: independent auditors who validate their credit claims. However, new research from the University of Pennsylvania Carey Law School suggests these auditors may not be as independent as they appear — a systemic problem that could be compromising carbon projects. The study, published on the Social Science Research Network, examined 95 projects registered with Verra, the world’s largest voluntary carbon credit registry. These projects were deliberately selected because they had been previously flagged for overstating credits.", "text_kind": "article_excerpt", "text_characters": 639, "text_sha256": "8c65ec830f94668fb6584723000786e7cd1acc7d1ea769443666e8282e732c65", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:51:12.363558+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "carbon_markets", "label_zh": "碳市场", "label_en": "Carbon markets", "start": 44, "end": 57, "evidence": "When questions arise about the integrity of carbon credits, project developers often point to one key safeguard: independent auditors who validate their credit claims. However, new research from th"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:12.388518+00:00", "published_at_raw": "2025-09-08T20:06:54", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_510d1b2208166cad40db", "record_id": "article_510d1b2208166cad", "canonical_url": "https://dialogue.earth/en/nature/the-tangle-of-biodiversity-credits", "publisher_url": "https://dialogue.earth/en/nature/the-tangle-of-biodiversity-credits", "title_original": "The tangle of biodiversity credits", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-08T11:39:16+00:00", "source_text": "Properly funding nature’s recovery on a global scale will require a staggering amount of money. In 2021, The Nature Conservancy, an environmental non-profit, estimated that reversing the global decline of biodiversity would require between USD 722 billion and USD 967 billion per year by 2030. The lion’s share of that is expected to come from public funding: redirected government subsidies, taxes and direct investment. But a substantial amount will likely need to come from the private sector. That’s where biodiversity credits could come in. These tradable certificates aim to direct money from individuals and companies toward activities that protect and restore nature. The idea took off after COP15 – the 2022 United Nations nature summit in Montreal.", "text_kind": "article_excerpt", "text_characters": 758, "text_sha256": "31c44c634bd71c8b8022cb9e1bcf86513d62630fbf5ff72b40f5c3b0a7a8ac17", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:13.020831+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "722 billion", "start": 244, "end": 255, "evidence": " In 2021, The Nature Conservancy, an environmental non-profit, estimated that reversing the global decline of biodiversity would require between USD 722 billion and USD 967 billion per year by 2030.", "interpretation": "target_or_commitment"}, {"value_text": "967 billion", "start": 264, "end": 275, "evidence": " In 2021, The Nature Conservancy, an environmental non-profit, estimated that reversing the global decline of biodiversity would require between USD 722 billion and USD 967 billion per year by 2030.", "interpretation": "target_or_commitment"}], "conference_ids": ["COP15"], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "subsidy", "label_zh": "补贴与激励", "label_en": "Subsidies and incentives", "start": 382, "end": 388, "evidence": ". The lion’s share of that is expected to come from public funding: redirected government subsidies, taxes and direct investment. But a substantial amount will likely need to come from the private sector. That’s where biodiversity credi"}, {"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 9, "end": 16, "evidence": "Properly funding nature’s recovery on a global scale will require a staggering amount of money. In 2021, The Nature Conservancy, an environmental non-profit"}], "policy_stages": [], "track": "negotiations", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:13.054768+00:00", "published_at_raw": "2025-09-08T11:39:16", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_d8cb11118c413f544d9c", "record_id": "article_d8cb11118c413f54", "canonical_url": "https://insideclimatenews.org/news/07092025/california-black-churches-energy-transition", "publisher_url": "https://insideclimatenews.org/news/07092025/california-black-churches-energy-transition", "title_original": "A California Network of Black Churches Is Embracing Solar Energy, EV Charging", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-07T08:55:00+00:00", "source_text": "HAYWARD, Calif.—On a Sunday morning, the swirling timbre of a Hammond organ drifted into the lobby at Glad Tidings International Church of God in Christ. On the stage, a lively guest preacher, Ronzel Pretlow, roused the congregation in the Hayward, California, church, his raspy voice rising and falling as he sang and shouted, prompting his […]", "text_kind": "source_excerpt", "text_characters": 345, "text_sha256": "04766df72d178d54a196e713e3791bb0492c644625bb37bb253089ab918c3115", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:42.336346+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:42.354022+00:00", "published_at_raw": "2025-09-07T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 2, "end": 12, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 249, "end": 259, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_27a76a9762c43877cf2a", "record_id": "article_27a76a9762c43877", "canonical_url": "https://insideclimatenews.org/news/07092025/icn-sunday-morning-methane-emissions", "publisher_url": "https://insideclimatenews.org/news/07092025/icn-sunday-morning-methane-emissions", "title_original": "‘Clean’ Oil and Chemical Soup", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-07T08:50:00+00:00", "source_text": "The Trump administration says that drilling in the U.S. is cleaner than in other countries due to tighter environmental oversight. But Texas, the heart of America’s oil and gas industry, tells a different story. The state’s regulator grants nearly every request to burn or vent gas into the atmosphere. When this happens, the release also […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "51fc3c3cf703e3cdb689ee2c8480e33b18ef017ba8163b5ef7675bfe82b43433", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:42.357229+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 234, "end": 239, "evidence": "e heart of America’s oil and gas industry, tells a different story. The state’s regulator grants nearly every request to burn or vent gas into the atmosphere. When this happens, the release also […]"}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:42.372635+00:00", "published_at_raw": "2025-09-07T08:50:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 51, "end": 55, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_46f53962243acbc5ebd8", "record_id": "article_46f53962243acbc5", "canonical_url": "https://insideclimatenews.org/news/06092025/trump-cancels-hog-farm-biogas-health-study", "publisher_url": "https://insideclimatenews.org/news/06092025/trump-cancels-hog-farm-biogas-health-study", "title_original": "Trump Cancels Study on Health Impacts of Industrialized Hog Farms That Produce Biogas", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-06T08:55:00+00:00", "source_text": "The Trump administration has cancelled a $417,000 federal grant that would have funded research on the social and economic impacts of biogas production from industrialized swine operations in North Carolina. Over several years, scientists from RTI International in Durham and the Gillings School of Public Health at the University of North Carolina at Chapel Hill […]", "text_kind": "source_excerpt", "text_characters": 367, "text_sha256": "8c763c7e3500867c31c666d133fb8b22c4d5f89019fc4b057625f7e6ac32a0eb", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:42.431530+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 58, "end": 63, "evidence": "The Trump administration has cancelled a $417,000 federal grant that would have funded research on the social and economic impacts of biogas production from industrialized swine operations in North Carol"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:42.445465+00:00", "published_at_raw": "2025-09-06T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_a19ef01f0b3ee06b57c4", "record_id": "article_a19ef01f0b3ee06b", "canonical_url": "https://dialogue.earth/en/energy/is-chinas-energy-system-ready-for-the-ai-boom", "publisher_url": "https://dialogue.earth/en/energy/is-chinas-energy-system-ready-for-the-ai-boom", "title_original": "Is China’s energy system ready for the AI boom?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-05T17:46:42+00:00", "source_text": "In early June, I travelled to Guiyang in southwestern China’s Guizhou province to visit China Mobile’s Gui’an Data Centre, which has been designated a “national green data centre”. The facility is located in a cluster of modern buildings in the Gui’an New Area. Since 2021, this cluster has become a hub of China’s internet infrastructure, hosting data centres operated by major tech companies. Engineer Jian Chonghai walked me through the centre’s energy-saving innovations – the modular cooling cabinets, or “maglev” air-conditioning system. Unlike traditional AC, maglev air conditioners eliminate friction in compressors, achieving the same cooling effect with 30-40% less electricity, he said. Jian’s focus on energy efficiency is driven by an ambitious expansion plan.", "text_kind": "article_excerpt", "text_characters": 774, "text_sha256": "a52165ea0d2c2f0b377c49714c2ec06c3918b9fd095c147f830a9628aed2a565", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:13.081967+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "40%", "start": 668, "end": 671, "evidence": " Unlike traditional AC, maglev air conditioners eliminate friction in compressors, achieving the same cooling effect with 30-40% less electricity, he said.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 449, "end": 455, "evidence": "s operated by major tech companies. Engineer Jian Chonghai walked me through the centre’s energy-saving innovations – the modular cooling cabinets, or “maglev” air-conditioning system. Unlike traditional AC, maglev air conditioners elim"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:13.115555+00:00", "published_at_raw": "2025-09-05T17:46:42", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 3, "end": 8, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 54, "end": 59, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_cc515b614dcd77d6343d", "record_id": "article_cc515b614dcd77d6", "canonical_url": "https://news.mongabay.com/2025/09/guatemala-closes-oil-field-increases-security-in-maya-biosphere-reserve", "publisher_url": "https://news.mongabay.com/2025/09/guatemala-closes-oil-field-increases-security-in-maya-biosphere-reserve", "title_original": "Guatemala closes oil field, increases security in Maya Biosphere Reserve", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-05T16:09:01+00:00", "source_text": "Officials in Guatemala have announced plans to occupy a recently closed oil field with the aim of increasing enforcement in protected areas badly hit by organized crime. The Xan oil field inside Laguna del Tigre National Park, in northern Guatemala, will become a base for military and law enforcement personnel tasked with protecting the rainforest […]", "text_kind": "source_excerpt", "text_characters": 353, "text_sha256": "80602f076a56a6f7c1bea540c58e01a50c63a47ce8dfae5b2eef42d7e50a190c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:12.450294+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GT", "alpha3": "GTM", "name_zh": "危地马拉", "name_en": "Guatemala"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GT", "alpha3": "GTM", "name_zh": "危地马拉", "name_en": "Guatemala"}], "annotation