{"text_id": "text_a382ab90c1028d3bd90b", "record_id": "article_a382ab90c1028d3b", "canonical_url": "https://insideclimatenews.org/news/14022025/todays-climate-global-wildlife-trade-united-states", "publisher_url": "https://insideclimatenews.org/news/14022025/todays-climate-global-wildlife-trade-united-states", "title_original": "The U.S. Imported Billions of Animals in Recent Decades, Fueling Global Wildlife Trade", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-14T21:13:29+00:00", "source_text": "The global wildlife trade is a sprawling, multi-billion dollar market—and the United States is one of the biggest players. In the past roughly two decades, people in the U.S. legally imported about 2.9 billion animals from nearly 30,000 species, according to a recent study. Wild animals and their parts are crucial for a number of […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "e833f1a77aaad481f71b5d6c9b995e79c75ce028ea2f928b2df0fe500a8b6e9a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:51.866002+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "2.9 billion", "start": 198, "end": 209, "evidence": " legally imported about 2.9 billion animals from nearly 30,000 species, according to a recent study.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "g