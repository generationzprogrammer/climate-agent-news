{"text_id": "text_e43e8f55bb9667c651ba", "record_id": "article_e43e8f55bb9667c6", "canonical_url": "https://news.mongabay.com/2025/11/as-agroforestry-declines-in-indonesias-flores-a-traditional-ecological-lexicon-fades-with-it", "publisher_url": "https://news.mongabay.com/2025/11/as-agroforestry-declines-in-indonesias-flores-a-traditional-ecological-lexicon-fades-with-it", "title_original": "As agroforestry declines in Indonesia’s Flores, a traditional ecological lexicon fades with it", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-28T15:44:35+00:00", "source_text": "In the cool highlands of Indonesia’s Flores Island, where mist settles over rice fields and coffee gardens, the Manggarai people have cultivated a close relationship with the forest. Their land is known as the rice granary of East Nusa Tenggara province, but it also produces cacao, vanilla and other crops that sustain families and the […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "03aafc30e6bab2e08c8ee53e389eb00218789299c9d7be0c7a5e3bcd0dcc1bb4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:04.705999+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "nam