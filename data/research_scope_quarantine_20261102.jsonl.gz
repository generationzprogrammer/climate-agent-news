{"text_id": "text_997f911e198d9bcaa480", "record_id": "article_997f911e198d9bca", "canonical_url": "https://insideclimatenews.org/news/13082026/colorado-river-wildfires-and-heat-challenges-ultrarunner", "publisher_url": "https://insideclimatenews.org/news/13082026/colorado-river-wildfires-and-heat-challenges-ultrarunner", "title_original": "Wildfires and Extreme Heat Challenge Water Activist’s Attempt to Run the Length of the Colorado River", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-13T09:00:00+00:00", "source_text": "Mina Guli had run more than 25 miles when she saw the plume of smoke towering over the Utah desert. The Australian ultrarunner was preparing to run another 25 miles in the morning, but watching the nearby wildfire grow made it impossible to relax and rest up for the next day’s mileage. “We would lie […]", "text_kind": "source_excerpt", "text_characters": 304, "text_sha256": "b1d1124c09187b36bb0d75795c6d81cab1676f6fa5a5f90659d01080c9d12346", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:23.250324+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 205, "end": 213, "evidence": "ultrarunner was preparing to run another 25 miles in the morning, but watching the nearby wildfire grow made it impossible to relax and rest up for the next day’s mileage. “We would lie […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:23.294187+00:00", "published_at_raw": "2026-08-13T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_7f988d08c40c188f1d16", "record_id": "article_7f988d08c40c188f", "canonical_url": "https://insideclimatenews.org/news/11082026/virginia-coast-key-congressional-race", "publisher_url": "https://insideclimatenews.org/news/11082026/virginia-coast-key-congressional-race", "title_original": "What Candidates Have Planned for Virginia’s Coast Could Decide a Key Congressional Race", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-11T09:00:00+00:00", "source_text": "With Virginia’s Aug. 4 primaries in the rearview mirror, the ballot is set in one of the nation’s most competitive congressional districts. In the state’s second congressional district, Republican incumbent Jen Kiggans will fight to hold her seat against former U.S. Rep. Elaine Luria in a district that includes Virginia Beach and Hampton Roads, and […]", "text_kind": "source_excerpt", "text_characters": 354, "text_sha256": "868a63cf89210493e1568f8ec6e8dcea1fc7d5f7b079170224352fbf2db3002f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:28.828498+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictio