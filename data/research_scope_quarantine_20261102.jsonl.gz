{"text_id": "text_7be43090dbc729e13596", "record_id": "article_7be43090dbc729e1", "canonical_url": "https://insideclimatenews.org/news/29052025/supreme-court-backs-controversial-utah-oil-railroad", "publisher_url": "https://insideclimatenews.org/news/29052025/supreme-court-backs-controversial-utah-oil-railroad", "title_original": "Supreme Court Backs a Controversial Railroad in Utah for Carrying Oil", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-29T22:55:08+00:00", "source_text": "The U.S. Supreme Court has ruled in favor of a controversial Utah railway project that critics say erodes the National Environmental Policy Act (NEPA), a bedrock of environmental law for the past half century. The case centered on a proposed 88-mile railway that would connect the oil fields of northeastern Utah to a national rail […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "7ff783a66a7dd4ccd39692ddff2f088dfda2670ec747a7386a54c60443e3d18a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:49.024272+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 233, "end": 241, "evidence": " (NEPA), a bedrock of environmental law for the past half century. The case centered on a proposed 88-mile railway that would connect the oil fields of northeastern Utah to a national rail […]"}], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:49.038246+00:00", "published_at_raw": "2025-05-29T22:55:08", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 4, "end": 8, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
