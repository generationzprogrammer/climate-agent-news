{"text_id": "text_aa3f550e05d6c89971e1", "record_id": "article_aa3f550e05d6c899", "canonical_url": "https://news.mongabay.com/2026/05/thai-island-community-rallies-to-protect-beloved-dugongs-revive-declining-seagrass", "publisher_url": "https://news.mongabay.com/2026/05/thai-island-community-rallies-to-protect-beloved-dugongs-revive-declining-seagrass", "title_original": "Thai island community rallies to protect beloved dugongs, revive declining seagrass", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-21T01:00:43+00:00", "source_text": "KOH LIBONG, Thailand — Growing up on the island of Koh Libong, Tipusa Sangsawang remembers fondly how vast numbers of dugongs used to feed on local seagrass meadows teaming with fish, crabs and mollusks. “Out there, it was like a football field,” Tipusa says, as she watches waves lap across a seemingly barren sandflat that […]", "text_kind": "source_excerpt", "text_characters": 328, "text_sha256": "93fb7897a4b9e4a64aec57fa71ee7346edac6d37c002078e1818965e8e569153", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:39.394468+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:39.421314+00:00", "published_at_raw": "2026-05-21T01:00:43", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand", "start": 12, "end": 20, "matched_text": "Thailand", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_9626bd3b335ad6033656", "record_id": "article_9626bd3b335ad603", "canonical_url": "https://www.carbonbrief.org/new-coal-plants-hit-10-year-global-high-in-2025-but-power-output-still-fell", "publisher_url": "https://www.carbonbrief.org/new-coal-plants-hit-10-year-global-high-in-2025-but-power-output-still-fell", "title_original": "New coal plants hit ‘10-year’ global high in 2025 – but power output still fell", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-20T23:01:00+00:00", "source_text": "The number of new coal-fired power plants built around the world hit a “10-year high” in 2025, even as the global coal fleet generated less electricity, amid a “widening disconnect” in the sector. That is according to the latest annual report from Global Energy Monitor (GEM), which finds that the world added nearly 100 gigawatts (GW) of new coal-power capacity in 2025, the equivalent of roughly 100 large coal plants. It adds that 95% of the new coal plants were built in India and China. Yet GEM says that the amount of electricity generated with coal fell by 0.6% in 2025 – with sharp drops in both China and India – as the fuel was displaced by record wind and solar output, among other factors.", "text_kind": "article_excerpt", "text_characters": 701, "text_sha256": "c67cb1cad497d55a83bc60201832016f5a2930183fee0f6e2891131eda611977", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:38.907211+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "95%", "start": 434, "end": 437, "evidence": " It adds that 95% of the new coal plants were built in India and China.", "interpretation": "not_classified"}, {"value_text": "0.6%", "start": 564, "end": 568, "evidence": " Yet GEM says that the amount of electricity generated with coal fell by 0.6% in 2025 – with sharp drops in both China and India – as the fuel was displaced by record wind and solar output, among other factors.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 18, "end": 22, "evidence": "The number of new coal-fired power plants built around the world hit a “10-year high” in 2025, even as the global coal fleet generated less electricity, amid a “w"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:38.927444+00:00", "published_at_raw": "2026-05-20T23:01:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 475, "end": 480, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 485, "end": 490, "matched_text": 