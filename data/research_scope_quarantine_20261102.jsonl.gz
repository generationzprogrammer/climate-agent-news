{"text_id": "text_8f62782732a016f41026", "record_id": "article_8f62782732a016f4", "canonical_url": "https://news.mongabay.com/2025/12/women-sow-seeds-restore-forests-in-guinea-the-water-tower-of-west-africa", "publisher_url": "https://news.mongabay.com/2025/12/women-sow-seeds-restore-forests-in-guinea-the-water-tower-of-west-africa", "title_original": "Women scatter seeds, restore forests in Guinea, the ‘water tower of West Africa’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-16T23:29:49+00:00", "source_text": "For Mariame Condé, the seed-collecting work came at a critical time. In January 2022, she was pregnant and nearly out of food. Her husband had left their village to search for gold in Siguiri, a mining area, and their harvest was almost gone, she told Mongabay in a WhatsApp message. That year, Condé collected 20,000 […]", "text_kind": "source_excerpt", "text_characters": 321, "text_sha256": "732c50281c1ef27ba4abcdeea2c765d5abeaa0f1d5826fc91d72162b25ed7b2c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:53.122581+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_