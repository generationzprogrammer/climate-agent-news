{"text_id": "text_7655033959d2a0c11e87", "record_id": "article_7655033959d2a0c1", "canonical_url": "https://news.mongabay.com/2025/12/philippine-mangroves-survived-a-typhoon-but-now-confront-a-human-made-challenge", "publisher_url": "https://news.mongabay.com/2025/12/philippine-mangroves-survived-a-typhoon-but-now-confront-a-human-made-challenge", "title_original": "Philippine mangroves survived a typhoon, but now confront a human-made challenge", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-04T15:56:13+00:00", "source_text": "Mangroves in the Philippine city of Tacloban, the area hit hardest by one of the most powerful typhoons ever recorded, have recovered and even expanded beyond their pre-disaster extent, thanks largely to community-led reforestation. But scientists caution that ongoing coastal development could threaten the recovering forests. In a recently published study, Hiroshi Takagi, a professor […]", "text_kind": "source_excerpt", "text_characters": 390, "text_sha256": "dcf28166758beef85d74d362b91bf4209355a83ac3017bc865e3bb3bacb40dc7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:04.077436+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:04.092814+00:00", "published_at_raw": "2025-12-04T15:56:13", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_19ae3517a0486015ebc6", "record_id": "article_19ae3517a0486015", "canonical_url": "https://news.mongabay.com/2025/12/the-indigenous-women-changing-the-course-of-their-communities", "publisher_url": "https://news.mongabay.com/2025/12/the-indigenous-women-changing-the-course-of-their-communities", "title_original": "The Indigenous women changing the course of their communities", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-04T12:27:47+00:00", "source_text": "Indigenous women leaders don’t only sustain life in their territories; they are also active defenders of water, seeds, ancestral knowledge and biodiversity. Together, they lead environmental restoration processes and care for the health of their communities. They also pave the way for political participation, claiming spaces where decision-making affects their communities. “Our fight is collective […]", "text_kind": "source_excerpt", "text_characters": 404, "text_sha256": "7000ccfc8e0263e49c4b6c0be57769b3ac518614732d9df2d1b0edaad15bc43e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:04.156255+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 0, "end": 10, "evidence": "Indigenous women leaders don’t only sustain life in their territories; they are also active defenders of water, seeds, ancestral knowledge and biodive"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:04.172353+00:00", "published_at_raw": "2025-12-04T12:27:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
