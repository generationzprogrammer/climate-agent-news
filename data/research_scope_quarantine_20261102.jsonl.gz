{"text_id": "text_d58553099f6ef809e0bc", "record_id": "article_d58553099f6ef809", "canonical_url": "https://news.mongabay.com/2024/03/communities-worry-anew-as-png-revives-seabed-mining-plans", "publisher_url": "https://news.mongabay.com/2024/03/communities-worry-anew-as-png-revives-seabed-mining-plans", "title_original": "Communities worry anew as PNG revives seabed mining plans", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-20T14:30:39+00:00", "source_text": "KONO, Papua New Guinea — Chris Malagan sits in his outrigger canoe, singing and shaking a ring of coconut shells in the water next to the boat. The inky skies backdropping the reef portend a late-morning storm that will bring a deluge of rain and tumultuous seas, likely skunking any attempt to “call” sharks to […]", "text_kind": "source_excerpt", "text_characters": 315, "text_sha256": "4dc8dc9d3a453a9c07315379b489027b6516713de7c014c83934d8b28b5b0648", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:57.697578+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PG", "alpha3": "PNG", "name_zh": "巴布亚新几内亚", "name_en": "Papua New Guinea"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PG", "alpha3": "PNG", "name_zh": "巴布亚新几内亚", "name_en": "Papua New Guinea"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine