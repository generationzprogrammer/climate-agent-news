{"text_id": "text_ff2812c6b46d7b2233cc", "record_id": "article_ff2812c6b46d7b22", "canonical_url": "https://insideclimatenews.org/news/07072026/after-a-weekend-of-heavy-rains-chicagos-deep-tunnel-is-almost-full", "publisher_url": "https://insideclimatenews.org/news/07072026/after-a-weekend-of-heavy-rains-chicagos-deep-tunnel-is-almost-full", "title_original": "After a Weekend of Heavy Rains, Chicago’s Deep Tunnel Is Almost Full", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-07T20:43:39+00:00", "source_text": "For the first time in history, Deep Tunnel, Chicago’s massive system of underground tunnels and reservoirs designed to hold flood water, is almost completely full after a weekend of heavy rain. Built over more than a half-century, Deep Tunnel sends floodwaters from Chicago and nearby suburbs through more than 100 miles of tunnels into three […]", "text_kind": "source_excerpt", "text_characters": 346, "text_sha256": "3ad10fed8a7d9b03ec9e9bdbc18eead8bc945b23793c0d1901e2dfd303d027e4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:46.032353+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 124, "end": 129, "evidence": "p Tunnel, Chicago’s massive system of underground tunnels and reservoirs designed to hold flood water, is almost completely full after a weekend of heavy rain. Built over more than a half-century, Deep Tunnel sends floodwaters from Chi"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:46.046773+00:00", "published_at_raw": "2026-07-07T20:43:39", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_8f69a30762f7766d7a8d", "record_id": "article_8f69a30762f7766d", "canonical_url": "https://insideclimatenews.org/news/07072026/fishing-bans-british-fish-stocks-are-collapsing", "publisher_url": "https://insideclimatenews.org/news/07072026/fishing-bans-british-fish-stocks-are-collapsing", "title_original": "Despite Decades of Warnings, British Fish Stocks Are Collapsing", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-07T13:31:14+00:00", "source_text": "Regulations governing British fishing are supposed to keep it “environmentally sustainable in the long term.” But fish stocks in the United Kingdom are on the brink of collapse. For those watching the industry closely, this is not a surprise: For decades, U.K. and European Union governments have regularly ignored fishing quota research recommendations. Almost 60 […]", "text_kind": "source_excerpt", "text_characters": 368, "text_sha256": "a295293693c5096281cbab74ce77a229fabb528802bcbf6518f50ff737cc6e5f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:46.065045+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [], "policy_tools": [{"id": "standards", "label_zh": "标准与监管", "label_en": "Standards and regulation", "start": 0, "end": 10, "evidence": "Regulations governing British fishing are supposed to keep it “environmentally sustainable in the long term.” But fish stocks in the United Kingdom ar"}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:46.076071+00:00", "published_at_raw": "2026-07-07T13:31:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 29, "end": 36, "matched_text": "British", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 22, "end": 29, "matched_text": "British", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_cea7e1e3af74ca0deb00", "record_id": "article_cea7e1e3af74ca0d", "canonical_url": "https://dialogue.earth/en/climate/as-pakistans-monsoon-arrives-people-with-hiv-worry", "publisher_url": "https://dialogue.earth/en/climate/as-pakistans-monsoon-arrives-people-with-hiv-worry", "title_original": "As Pakistan’s monsoon arrives, people with HIV worry", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-02T15:28:19+00:00", "source_text": "As contaminated floodwater gushed into their home in Buner, north-western Pakistan, Khalid (name changed) and his wife helped their three children up to higher ground. Amid the chaos, the couple had one more crucial thing to rescue: their life-saving HIV drugs. They trudged through neck-deep water inside their home to save their antiretroviral treatment pills from being swept away, ignoring all other valuables. “The waist-deep mud left behind by floodwaters had cut off our village for more than eight days,” Khalid recalls. “Thankfully, my wife and I still had our HIV medication with us,” says the daily wager, who contracted the virus while working abroad five years prior. This happened last monsoon, in August 2025, when the skies opened on Pakistan, causing widespread flooding.", "text_kind": "article_excerpt", "text_characters": 788, "text_sha256": "c2b69562d6725ceb8255c6e814f567abb6db1ed631e0274ee3e526b3bf76d767", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:35.009568+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 16, "end": 21, "evidence": "As contaminated floodwater gushed into their home in Buner, north-western Pakistan, Khalid (name changed) and his wife helped their three children up to higher g"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:35.065313+00:00", "published_at_raw": "2026-07-02T15:28:19", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan", "start": 3, "end": 11, "matched_text": "Pakistan", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan", "start": 74, "end": 82, "matched_text": "Pakistan", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_38d85f1e12522f2d5f82", "record_id": "article_38d85f1e12522f2d", "canonical_url": "https://news.mongabay.com/2026/07/a-possible-strong-el-nino-fuels-fears-for-fires-across-indonesian-tropical-peatlands", "publisher_url": "https://news.mongabay.com/2026/07/a-possible-strong-el-nino-fuels-fears-for-fires-across-indonesian-tropical-peatlands", "title_original": "A possible strong El Niño fuels fears for fires across Indonesian tropical peatlands", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-02T07:49:03+00:00", "source_text": "JAKARTA, Indonesia — An emerging El Niño risks fueling devastating wildfires on peatland areas in Borneo earmarked by Indonesia’s government about six years ago for a flagship food estate program, environmentalists have warned. The warning comes as Indonesia braces for heightened fire risk during the current dry season. “What we are most concerned about is […]", "text_kind": "source_excerpt", "text_characters": 362, "text_sha256": "a276bb38f2be051f7d2dcbef22ceffb052a91adf16acc4c19e49370c9b9bd275", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:51.259146+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 67, "end": 75, "evidence": "JAKARTA,