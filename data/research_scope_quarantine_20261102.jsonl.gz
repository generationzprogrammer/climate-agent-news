{"text_id": "text_ce808b2310c0f0c2e166", "record_id": "article_ce808b2310c0f0c2", "canonical_url": "https://news.mongabay.com/2025/07/nepal-sees-positive-outcome-from-reforestation-project-using-local-knowledge", "publisher_url": "https://news.mongabay.com/2025/07/nepal-sees-positive-outcome-from-reforestation-project-using-local-knowledge", "title_original": "Nepal sees positive outcome from reforestation project using local knowledge", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-08T04:53:13+00:00", "source_text": "KATHMANDU — A decade ago, people from Salija village in western Nepal traveled several hours into the uphill forests to gather firewood and feed for their livestock, Shakhamani Khorja recalls. “[Now], we have a forest growing on about 13 hectares [32 acres] of land less than a kilometer [0.6 miles] away that helps meet our […]", "text_kind": "source_excerpt", "text_characters": 328, "text_sha256": "d2fc92c3a7f947940e136d9392e4580fb4ccc6519ab7a467d33a28ca7c5ca485", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:44.216167+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:44.233637+00:00", "published_at_raw": "2025-07-08T04:53:13", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 0, "end": 5, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 64, "end": 69, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_f25f9179aa6f2062b7d8", "record_id": "article_f25f9179aa6f2062", "canonical_url": "https://yaleclimateconnections.org/2025/07/devastating-flash-floods-slam-texas-hill-country-tropical-storm-chantal-heads-for-carolinas", "publisher_url": "https://yaleclimateconnections.org/2025/07/devastating-flash-floods-slam-texas-hill-country-tropical-storm-chantal-heads-for-carolinas", "title_original": "Devastating flash floods slam Texas Hill Country; Tropical Storm Chantal heads for Carolinas", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-05T18:15:13+00:00", "source_text": "One of the nation’s deadliest flash floods in years struck one of Texas’ prime holiday recreation areas, the Guadalupe River, early on Friday, July 4. A wall of water swept away vehicles and campers and cascaded through packed campgrounds in the hours near sunrise on Friday, producing heart-wrenching tragedy. As of noon CDT Saturday, at least 27 deaths were confirmed, including 9 children, the Associated Press reported . Many others remained missing, including 27 people from Camp Mystic, a summer camp with nearly a century of operations along and near the Guadalupe River. Update : As of early Sunday afternoon, July 6, the multi-day death toll from the central Texas flooding had reached at least 70, according to the New York Times .", "text_kind": "article_excerpt", "text_characters": 741, "text_sha256": "233fde08e34d52b74acb03281502736d2f6e388a56a0a4f9a2bfec1d77ad2876", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:42.262995+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 36, "end": 41, "evidence": "One of the nation’s deadliest flash floods in years struck one of Texas’ prime holiday recreation areas, the Guadalupe River, early on Friday, July 4. A wall of water swept away veh"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:42.281381+00:00", "published_at_raw": "2025-07-05T18:15:13", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 30, "end": 35, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 66, "end": 71, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_1623f3025bc2714bd093", "record_id": "article_1623f3025bc2714b", "canonical_url": "https://insideclimatenews.org/news/03072025/trump-praises-florida-everglades-alligator-alcatraz", "publisher_url": "https://insideclimatenews.org/news/03072025/trump-praises-florida-everglades-alligator-alcatraz", "title_original": "In Florida’s Fragile Everglades, Trump Praises ‘Alligator Alcatraz’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-03T08:55:00+00:00", "source_text": "President Donald Trump landed this week on an airstrip in the Florida Everglades for a visit to a swiftly assembled detention facility that federal and state officials say will house 3,000 undocumented migrants, as the president aims to fulfill his plans for mass deportations. Dubbed “Alligator Alcatraz” for its location within a swampy thicket of […]", "text_kind": "source_excerpt", "text_characters": 353, "text_sha256": "8af9b11131d6c63b0334085824caf5edb94cefa52cbd737ce8a6c8f023f398da", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:26.297084+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 204, "end": 209, "evidence": "d detention facility that federal and state officials say will house 3,000 undocumented migrants, as the president aims to fulfill his plans for mass deportations. Dubbed “Alligator Alcatraz” for its location within a swampy thicket of"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:26.330867+00:00", "published_at_raw": "2025-07-03T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_41edf9178abf840c06dc", "record_id": "article_41edf9178abf840c", "canonical_url": "https://insideclimatenews.org/news/02072025/trump-administration-weakens-national-environmental-policy-act", "publisher_url": "https://insideclimatenews.org/news/02072025/trump-administration-weakens-national-environmental-policy-act", "title_original": "Trump Administration Acts to ‘Severely Weaken’ a Key Environmental Law", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-03T00:33:06+00:00", "source_text": "The Trump administration began this week to radically alter how the National Environmental Policy Act is implemented across the federal government, alarming environmentalists. Passed in 1970 and often called the “Magna Carta” of U.S. environmental law, NEPA requires agencies to assess the environmental impacts of their actions during the decision-making process. Its scope is broad, […]", "text_kind": "source_excerpt", "text_characters": 388, "text_sha256": "cb3b7e963168f796025771a95a02ead5669dff321c0b09c7644f752e1c44cab9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:26.484313+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "implementation", "label_zh": "实施", "label_en": "Implementation", "start": 105, "end": 116, "evidence": "istration began this week to radically alter how the National Environmental Policy Act is implemented across the federal government, alarming environmentalists. Passed in 1970 and often called the “Magna Carta” of U.S. environmental law, NEP"}], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:26.519737+00:00", "published_at_raw": "2025-07-03T00:33:06", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 229, "end": 233, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_716d777c28f3f6c79225", "record_id": "article_716d777c28f3f6c7", "canonical_url": "https://insideclimatenews.org/news/02072025/air-pollution-linked-to-lung-cancer-mutations", "publisher_url": "https://insideclimatenews.org/news/02072025/air-pollution-linked-to-lung-cancer-mutations", "title_original": "NIH Scientists Link Air Pollution and Lung Cancer Mutations in Non-Smokers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-02T18:28:23+00:00", "source_text": "New findings published Wednesday by the National Cancer Institute link tiny, toxic air pollutants to changes in lung cancer tumors at the genomic level in people who have never smoked. Lung cancer is the leading cause of cancer death in the U.S., and the American Cancer Society reports that more people die of lung cancer […]", "text_kind": "source_excerpt", "text_characters": 326, "text_sha256": "bf1f76d0fd0afea9938f705904d8f150f2676a51c48b1ca48b964cacc4a2a5cc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:26.703575+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:26.737459+00:00", "published_at_raw": "2025-07-02T18:28:23", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 241, "end": 245, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_9dbf1c2bfac86c544f3f", "record_id": "article_9dbf1c2bfac86c54", "canonical_url": "https://www.carbonbrief.org/chart-uk-misses-tree-planting-targets-by-forest-the-size-of-isle-of-wight", "publisher_url": "https://www.carbonbrief.org/chart-uk-misses-tree-planting-targets-by-forest-the-size-of-isle-of-wight", "title_original": "Chart: UK misses tree-planting targets by forest the ‘size of Isle of Wight’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-02T12:45:09+00:00", "source_text": "A forest area equivalent to the size of the Isle of Wight has not been planted because UK governments have failed to meet tree-planting goals since 2020, according to Carbon Brief analysis. The latest figures from Forest Research show that only 15,700 hectares of trees were planted across England, Scotland, Wales and Northern Ireland over the past year. This is roughly half the annual target of 30,000 hectares by 2025 that was set by the previous Conservative government. After the 2019 general election, the Department for Environment, Food and Rural Affairs (Defra) laid out a planned trajectory for England from 2020 up to 2025. Tree-planting is a devolved issue, so Scotland, Wales and Northern Ireland have had their own annual targets.", "text_kind": "article_excerpt", "text_characters": 745, "text_sha256": "a1e43e54f667df9ae65153973600db16e956901d50b985f5a6adf204a801bd40", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:15.171752+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:15.196662+00:00", "published_at_raw": "2025-07-02T12:45:09", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 7, "end": 9, "matched_text": "UK", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 87, "end": 89, "matched_text": "UK", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_0ff16c457d9e227f62f6", "record_id": "article_0ff16c457d9e227f", "canonical_url": "https://news.mongabay.com/2025/07/with-coral-rich-churna-island-now-an-mpa-pakistan-takes-baby-steps-on-ocean-protection", "publisher_url": "https://news.mongabay.com/2025/07/with-coral-rich-churna-island-now-an-mpa-pakistan-takes-baby-steps-on-ocean-protection", "title_original": "With coral-rich Churna Island now an MPA, Pakistan takes baby steps on ocean protection", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-01T19:22:01+00:00", "source_text": "KARACHI — From the sands of Manjhaar Beach on the far outskirts of Karachi, Pakistan, an island is just visible 10 kilometers, about 6 miles, offshore. Mist rising from the Arabian Sea often shrouds Churna Island from the view of sailors and tourists heading toward it for fishing or diving. Below the waves, the island […]", "text_kind": "source_excerpt", "text_characters": 323, "text_sha256": "98396d03cdaef078f03a6a438dc07bedb3710377d5d86752e379fd3bdbf635fc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:49.838866+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:49.868139+00:00", "published_at_raw": "2025-07-01T19:22:01", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan", "start": 42, "end": 50, "matched_text": "Pakistan", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan", "start": 76, "end": 84, "matched_text": "Pakistan", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_68beb526656c357b55e2", "record_id": "article_68beb526656c357b", "canonical_url": "https://insideclimatenews.org/news/01072025/national-science-foundation-loses-virginia-headquarters", "publisher_url": "https://insideclimatenews.org/news/01072025/national-science-foundation-loses-virginia-headquarters", "title_original": "National Science Foundation to Leave Virginia Headquarters as HUD Moves Out of DC", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-01T08:55:00+00:00", "source_text": "The National Science Foundation will be moving so the federal Department of Housing and Urban Development can take over its offices in Alexandria. The 1,800 employees at the science foundation were notified last week in a staff memo, a day before authorities from the federal and state government—including HUD Secretary Scott Turner and Gov. Glenn […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "dd36463c19eb5a83e45e890ae14156f07e28319574edf46cd481d444d05b1475", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:27.270427+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenew