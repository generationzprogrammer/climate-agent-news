{"text_id": "text_9b98c16396798a02f564", "record_id": "article_9b98c16396798a02", "canonical_url": "https://insideclimatenews.org/news/04032026/trump-data-center-rate-payer-protection-pledge", "publisher_url": "https://insideclimatenews.org/news/04032026/trump-data-center-rate-payer-protection-pledge", "title_original": "Few Details on Trump’s Plan for Self-Powered Data Centers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-04T09:50:00+00:00", "source_text": "RICHMOND, Va.— President Donald Trump is expected on Wednesday to sign his “Ratepayer Protection Pledge,” a deal he claims to have negotiated with major tech companies for data centers to pay their own energy costs. But he hasn’t disclosed details on how his plan would work or what roles Congress and state electricity regulators would […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "3f7cc0df86305ac099dbdc7373f99a00115d59c519a3d43933f3d07626dcccbe", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:35.117885+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 202, "end": 208, "evidence": " he claims to have negotiated with major tech companies for data centers to pay their own energy costs. But he hasn’t disclosed details on how his plan would work or what roles Congress