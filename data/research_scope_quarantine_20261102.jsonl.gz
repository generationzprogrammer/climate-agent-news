{"text_id": "text_f5abacf01c7fdd8d1ef9", "record_id": "article_f5abacf01c7fdd8d", "canonical_url": "https://insideclimatenews.org/news/28102025/philadelphia-raw-sewage-waterways", "publisher_url": "https://insideclimatenews.org/news/28102025/philadelphia-raw-sewage-waterways", "title_original": "Why Billions of Gallons of Raw Sewage Keep Ending up in Philadelphia Waterways", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-28T08:55:00+00:00", "source_text": "PHILADELPHIA—Some 280 years after a river-swimming Benjamin Franklin petitioned to curb water pollution here, the city is still struggling to meet the challenge, according to water advocates who assembled along the banks of one of its two main rivers on Monday. While Franklin’s concerns were primarily about cowhides and horns dumped by industrial tanneries, today […]", "text_kind": "source_excerpt", "text_characters": 369, "text_sha256": "5715a21c8ab614cde27e9c6a9722a698751c31ee626936190b38725be96cbc8c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:01.949575+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "a