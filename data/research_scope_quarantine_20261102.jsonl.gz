{"text_id": "text_24308563eabc9858f527", "record_id": "article_24308563eabc9858", "canonical_url": "https://news.mongabay.com/2024/08/brazils-carvalho-to-lead-isa-following-predecessors-controversial-term", "publisher_url": "https://news.mongabay.com/2024/08/brazils-carvalho-to-lead-isa-following-predecessors-controversial-term", "title_original": "Brazil’s Carvalho to lead seabed-mining authority following predecessor’s controversial term", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-03T01:16:09+00:00", "source_text": "Brazilian oceanographer Leticia Carvalho has been named the next secretary-general of the International Seabed Authority (ISA) after winning an election that could change the course of the deep-sea mining industry. Carvalho, 50, who currently works as an international civil servant for the United Nations Environment Programme (UNEP), was declared the winner of the race on […]", "text_kind": "source_excerpt", "text_characters": 378, "text_sha256": "d3218304634556c32c8916d88983cb946742426c87fbc4a52968263d6d7dacaa", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:44.411553+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:44.426589+00:00", "published_at_raw": "2024-08-03T01:16:09", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 0, "end": 6, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_180778049a639461508d", "record_id": "article_180778049a639461", "canonical_url": "https://insideclimatenews.org/news/02082024/navajo-nation-condemns-uranium-hauling-arizona-governor-negotiates-pause", "publisher_url": "https://insideclimatenews.org/news/02082024/navajo-nation-condemns-uranium-hauling-arizona-governor-negotiates-pause", "title_original": "After Navajo Nation Condemns Uranium Hauling on Its Lands, Arizona Governor Negotiates a Pause", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-02T22:59:58+00:00", "source_text": "CAMERON, Ariz.—The Navajo Nation doesn’t allow radioactive uranium ore to be transported through its lands without permission, but that’s exactly what a mining company began doing this week on roads administered by the state—which has no such restrictions. Navajo Nation President Buu Nygren told tribal police to stop the trucks, and he issued an executive […]", "text_kind": "source_excerpt", "text_characters": 361, "text_sha256": "8e2ce77922d8eadd7663186ebd8ea8f11fad5e80f76970f3e1a68d13d1475975", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:16.893112+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:16.904200+00:00", "published_at_raw": "2024-08-02T22:59:58", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_58b9a60414d0eed8f054", "record_id": "article_58b9a60414d0eed8", "canonical_url": "https://yaleclimateconnections.org/2024/08/why-you-need-a-go-bag", "publisher_url": "https://yaleclimateconnections.org/2024/08/why-you-need-a-go-bag", "title_original": "Why you need a go-bag", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-02T11:00:00+00:00", "source_text": "When a disaster strikes, you might need to evacuate your home quickly, so it’s important to pack a go-bag full of essentials beforehand. But that does not mean you need anything fancy. Wiggins: “You don’t need to buy the official, you know, space food emergency preparedness kits.” Nadia Wiggins is with Listos California , an initiative of the California Governor’s Office of Emergency Services. She says a go-bag should have nonperishable foods like canned soup or oatmeal, along with drinking water or a water purifier. You should also pack photocopies of any important documents, such as your ID and insurance coverage. Print out a map of your neighborhood and highlight evacuation routes and places you might be told to go for support.", "text_kind": "article_excerpt", "text_characters": 740, "text_sha256": "95102f717b741f014155632f4a0e43ea27f235d41dfe5c3ca42a4c73b91d24f3", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:33.944088+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:33.983353+00:00", "published_at_raw": "2024-08-02T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 311, "end": 321, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_3dd704f09883a518ab88", "record_id": "article_3dd704f09883a518", "canonical_url": "https://insideclimatenews.org/news/02082024/new-york-harbor-oyster-reefs", "publisher_url": "https://insideclimatenews.org/news/02082024/new-york-harbor-oyster-reefs", "title_original": "For Marine Species Across New York Harbor, the Oyster Is Their World", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-02T09:00:00+00:00", "source_text": "A small boat sped down the Hudson River as passengers admired the views of lower Manhattan skyscrapers and the open water. Occasionally, the boat rebounded high into the air as it bounced off the waves from the ferries operating in the waterway, causing the more inexperienced boaters to lurch forward. Pete Malinowski, executive director and […]", "text_kind": "source_excerpt", "text_characters": 346, "text_sha256": "b124710210f08cf32d4c1dd383befe96a841d3ae51e403750d1e71f20daa56c8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:22.712004+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:22.724054+00:00", "published_at_raw": "2024-08-02T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_dabe2a53f9314756c44e", "record_id": "article_dabe2a53f9314756", "canonical_url": "https://yaleclimateconnections.org/2024/08/torrential-rains-flooding-possible-from-tough-to-predict-97l", "publisher_url": "https://yaleclimateconnections.org/2024/08/torrential-rains-flooding-possible-from-tough-to-predict-97l", "title_original": "Torrential rains, flooding possible from tough-to-predict 97L", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-01T19:36:17+00:00", "source_text": "Tropical activity in the Atlantic normally picks up as July segues into August. True to form, a large tropical wave now labeled Invest 97L, centered near Haiti at midday Thursday, will be heading toward the southeastern Gulf of Mexico this weekend. This system appears likely to become Debby, the fourth named storm of the year. Its future is highly uncertain, but models are starting to gravitate toward the idea of a long-lived, slow-moving tropical storm or hurricane that could dump colossal amounts of rain along and near parts of the eastern Gulf Coast. And a coast-scraping track along or near the Southeast U.S. shore can’t yet be ruled out. On Thursday, 97L was spreading heavy rains over Hispaniola, the southeastern Bahamas, and adjacent areas.", "text_kind": "article_excerpt", "text_characters": 755, "text_sha256": "bdd6b24248aefebb8e5e8e403720f855140ab55fc6dade4a44f3fb116e477967", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:34.011319+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "BS", "alpha3": "BHS", "name_zh": "巴哈马", "name_en": "Bahamas"}, {"alpha2": "HT", "alpha3": "HTI", "name_zh": "海地", "name_en": "Haiti"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "BS", "alpha3": "BHS", "name_zh": "巴哈马", "name_en": "Bahamas"}, {"alpha2": "HT", "alpha3": "HTI", "name_zh": "海地", "name_en": "Haiti"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:34.047442+00:00", "published_at_raw": "2024-08-01T19:36:17", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "HT", "alpha3": "HTI", "name_zh": "海地", "name_en": "Haiti", "start": 154, "end": 159, "matched_text": "Haiti", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 228, "end": 234, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 615, "end": 619, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "BS", "alpha3": "BHS", "name_zh": "巴哈马", "name_en": "Bahamas", "start": 727, "end": 734, "matched_text": "Bahamas", "method":