{"text_id": "text_f7ec687890e06fff25f2", "record_id": "article_f7ec687890e06fff", "canonical_url": "https://insideclimatenews.org/news/11032025/ottawa-canada-rideau-canal-ice-rink-global-warming", "publisher_url": "https://insideclimatenews.org/news/11032025/ottawa-canada-rideau-canal-ice-rink-global-warming", "title_original": "Can the World’s Largest Ice Rink Survive a Warming Planet?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-11T09:00:00+00:00", "source_text": "OTTAWA, Canada—“Better catch up, Dad,” my daughter said as she and her brother skated into the night. We were at the start of the Rideau Canal Skateway, part of a United Nations World Heritage Site cutting through the heart of the Canadian capital. At 7.8 kilometers, or roughly 5 miles from end to end, the […]", "text_kind": "source_excerpt", "text_characters": 311, "text_sha256": "0676635de7bcbbfd070a252c6f4d0410a93b5aef8069ac141c959bdbe4f4560a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:38.824691+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not