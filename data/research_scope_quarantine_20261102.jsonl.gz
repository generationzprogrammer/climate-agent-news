{"text_id": "text_7fdbbb2d1bf1ac6aca01", "record_id": "article_7fdbbb2d1bf1ac6a", "canonical_url": "https://news.mongabay.com/2025/12/agroforestry-grows-in-popularity-among-central-colombias-coffee-farmers-analysis", "publisher_url": "https://news.mongabay.com/2025/12/agroforestry-grows-in-popularity-among-central-colombias-coffee-farmers-analysis", "title_original": "Agroforestry grows in popularity among central Colombia’s coffee farmers (analysis)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-23T18:05:36+00:00", "source_text": "Colombia is the world’s third-largest coffee producer and the main producer of Arabica coffee, which is known worldwide for its quality. The nation began developing commercial production in 1870, which now accounts for 22% of the national gross domestic product (GDP). According to the National Federation of Coffee Growers, there are approximately 560,000 farms in […]", "text_kind": "source_excerpt", "text_characters": 369, "text_sha256": "10a7a11aa0b83610ab0abe20a2a66d88158d19ab31fafb1da4b3a904cac023b6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:46.433474+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "22%", "start": 219, "end": 222, "evidence": " The nation began developing commercial production in 1870, which now accounts for 22% of the national gross domestic product (GDP).", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:46.488131+00:00", "published_at_raw": "2025-12-23T18:05:36", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 47, "end": 55, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 0, "end": 8, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_acb46a30fc9d9b5eb0a5", "record_id": "article_acb46a30fc9d9b5e", "canonical_url": "https://news.mongabay.com/2025/12/tropical-forests-in-australia-are-emitting-more-carbon-than-they-capture-study", "publisher_url": "https://news.mongabay.com/2025/12/tropical-forests-in-australia-are-emitting-more-carbon-than-they-capture-study", "title_original": "Tropical forests in Australia are emitting more carbon than they capture: Study", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-23T15:54:26+00:00", "source_text": "When it comes to capturing carbon, trees have always been our go-to. But a sinister switch is underway. A study published in the journal Nature reveals that moist tropical forests in Australia are now emitting more carbon than they capture. Researchers examined nearly five decades of forest monitoring data from the far northeast of Queensland […]", "text_kind": "source_excerpt", "text_characters": 348, "text_sha256": "1a1cec8acbf76c87ebeb86aa8cecfa3d69e710adb1e8dbe896933b2bd2f5f2b7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:46.526597+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:46.581424+00:00", "published_at_raw": "2025-12-23T15:54:26", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia", "start": 20, "end": 29, "matched_text": "Australia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia", "start": 183, "end": 192, "matched_text": "Australia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_cf8d1764df72df62acd3", "record_id": "article_cf8d1764df72df62", "canonical_url": "https://news.mongabay.com/2025/12/will-australias-main-environment-law-continue-marginalizing-indigenous-authority-despite-overhaul-commentary", "publisher_url": "https://news.mongabay.com/2025/12/will-australias-main-environment-law-continue-marginalizing-indigenous-authority-despite-overhaul-commentary", "title_original": "Will Australia’s main environment law continue marginalizing Indigenous authority, despite overhaul? (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-22T22:50:47+00:00", "source_text": "Australia’s main environmental law, the Environment Protection and Biodiversity Conservation Act 1999 (EPBC Act), has finally been rewritten. After years of warnings that the old law was “not fit for purpose,” parliament backed sweeping changes: national environmental standards, a new independent environment watchdog, higher penalties for breaches, and the closure of loopholes that had allowed […]", "text_kind": "source_excerpt", "text_characters": 400, "text_sha256": "6d808fba881053799345673f7f1656ce6787a7a201aaa1c32319e8d0382eaf5a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:46.927293+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:46.988995+00:00", "published_at_raw": "2025-12-22T22:50:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia", "start": 5, "end": 14, "matched_text": "Australia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia", "start": 0, "end": 9, "matched_text": "Australia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_68854e71632d27daff69", "record_id": "article_68854e71632d27da", "canonical_url": "https://news.mongabay.com/2025/12/jeff-foott-chronicler-of-ice-rock-and-change-has-died-aged-80", "publisher_url": "https://news.mongabay.com/2025/12/jeff-foott-chronicler-of-ice-rock-and-change-has-died-aged-80", "title_original": "Jeff Foott, chronicler of ice, rock, and change, has died, aged 80", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-21T17:12:06+00:00", "source_text": "For much of the second half of the 20th century, the American outdoors attracted a particular kind of devotee. They moved easily between disciplines, took seasonal work without much concern for titles, and regarded time in wild places as both education and obligation. Their lives did not unfold along a single career ladder so […]", "text_kind": "source_excerpt", "text_characters": 331, "text_sha256": "6230691ebf75b0aacf22a2b71bcdd618613e63042818c204057c284a7eeb5889", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:52.258268+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-1