{"text_id": "text_981e0e68b555dab1f8e7", "record_id": "article_981e0e68b555dab1", "canonical_url": "https://insideclimatenews.org/news/19032025/usaid-soybean-innovation-lab-to-close-after-trump-cuts", "publisher_url": "https://insideclimatenews.org/news/19032025/usaid-soybean-innovation-lab-to-close-after-trump-cuts", "title_original": "The Soybean Innovation Lab Is Set to Close in April After Trump Cuts", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-19T09:00:00+00:00", "source_text": "At the University of Illinois Urbana-Champaign, an island in a sea of farmland where corn and soybeans grow, sits the Soybean Innovation Lab. The institution, part of the U.S. Agency for International Development’s Feed the Future initiative, helps advance soybean production in sub-Saharan Africa, assisting farmers there and developing markets for soybean farmers in the […]", "text_kind": "source_excerpt", "text_characters": 376, "text_sha256": "8df8e9772c8938fe7aea1ba8c47e94ef3c1f0bf2f341ca4ee87c52eb31bb4730", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:37.268004+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:37.284543+00:00", "published_at_raw": "2025-03-19T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 171, "end": 175, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_9962e99bd4a99998ee90", "record_id": "article_9962e99bd4a99998", "canonical_url": "https://insideclimatenews.org/news/18032025/trump-administration-attacks-national-monuments-protests", "publisher_url": "https://insideclimatenews.org/news/18032025/trump-administration-attacks-national-monuments-protests", "title_original": "As Americans Protest Attacks on Public Lands, Trump Signals National Monuments May be Shrunk or Eliminated", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-18T09:00:00+00:00", "source_text": "CHIRICAHUA NATIONAL MONUMENT, Ariz.—It was a rare rainy day, with a brief sprinkle of snow in southeastern Arizona where the Rocky Mountains, Sierra Madre Occidental range, Sonoran and Chihuahuan deserts come together. Still, the cold didn’t stop roughly 20 locals from showing up Saturday morning to protest the Trump administration’s threats to the nation’s federal […]", "text_kind": "source_excerpt", "text_characters": 371, "text_sha256": "cd3785abae20b2b525500d17945b7c05c5ab10be20387bb3dd340040ee0323a7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:37.441814+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archi