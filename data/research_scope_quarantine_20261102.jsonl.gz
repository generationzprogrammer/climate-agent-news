{"text_id": "text_fe57b9ff6bd7558e45ee", "record_id": "article_fe57b9ff6bd7558e", "canonical_url": "https://news.mongabay.com/2026/06/one-mountain-lion-changed-the-food-web-in-a-california-suburb-study-finds", "publisher_url": "https://news.mongabay.com/2026/06/one-mountain-lion-changed-the-food-web-in-a-california-suburb-study-finds", "title_original": "One mountain lion changed the food web in a California suburb, study finds", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-29T17:13:43+00:00", "source_text": "When a mountain lion moved into a small suburban preserve near California’s Stanford University in the U.S. around 2012, its presence transformed the local food web, suggesting that apex predators can reshape ecosystems even in heavily developed landscapes. A recent study published in the journal Ecology and Evolution drew on nine years of camera trap […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "51a055775ec8abe48d82a87ee502d6433152c37d80742b964e18fb4d960ee9e7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:53.603913+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:53.701205+00:00", "published_at_raw": "2026-06-29T17:13:43", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 44, "end": 54, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 63, "end": 73, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_888a78618b092b84b7a7", "record_id": "article_888a78618b092b84", "canonical_url": "https://insideclimatenews.org/news/27062026/california-duxbury-reef-marine-protected-areas", "publisher_url": "https://insideclimatenews.org/news/27062026/california-duxbury-reef-marine-protected-areas", "title_original": "The Future of Duxbury Reef", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-27T08:55:00+00:00", "source_text": "BOLINAS, Calif.—Kent Khtikian pointed at a seemingly barren inch of reef. His hair, curly, long and grey blew wildly in the wind underneath a tan cowboy hat. He hunched over and kneeled close to a tiny tide pool, observing how a small, black periwinkle snail wiggled its way into a protected corner of rock. Khtikian […]", "text_kind": "source_excerpt", "text_characters": 320, "text_sha256": "2cecda127972b4d2c21b271d435b42a53b893feb41150e4a2b999dbe77b7db6f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:56.542135+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:56.553298+00:00", "published_at_raw": "2026-06-27T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_361992dfc325a4251a70", "record_id": "article_361992dfc325a425", "canonical_url": "https://news.mongabay.com/2026/06/how-snow-leopards-wolves-and-leopards-share-the-same-himalayan-valley-study", "publisher_url": "https://news.mongabay.com/2026/06/how-snow-leopards-wolves-and-leopards-share-the-same-himalayan-valley-study", "title_original": "How snow leopards, wolves and leopards share the same Himalayan valley, study", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-26T15:54:22+00:00", "source_text": "Three of Asia’s most formidable predators share territory in a remote Nepal valley by eating different prey, according to a new study. Researchers found that diet, not time or space, is what keeps snow leopards (Panthera uncia), common leopards (Panthera pardus), and Himalayan wolves (Canis lupus chanco) from coming into direct conflict. The study, published […]", "text_kind": "source_excerpt", "text_characters": 364, "text_sha256": "288486c27dfe1b1f674d8607ef07c19ffe50cc6f512e8903b651e6a9b7ba34ec", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:53.867469+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:53.916444+00:00", "published_at_raw": "2026-06-26T15:54:22", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 70, "end": 75, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_4698bb625979c3ae9366", "record_id": "article_4698bb625979c3ae", "canonical_url": "https://insideclimatenews.org/news/26062026/kevin-lilly-interim-fish-wildlife-assistant-secretary-lack-of-experience", "publisher_url": "https://insideclimatenews.org/news/26062026/kevin-lilly-interim-fish-wildlife-assistant-secretary-lack-of-experience", "title_original": "Interim Fish and Wildlife Assistant Secretary’s Lack of Experience Concerns Senators at Confirmation Hearings", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-26T08:55:00+00:00", "source_text": "When President Donald Trump nominated Kevin Lilly last year to oversee management of the nation’s wildlife refuges and national parks, conservation advocacy organizations raised concerns over how his lack of public lands experience would impact the Department of the Interior’s conservation commitments. Prior to assuming the role of assistant secretary for fish, wildlife and parks […]", "text_kind": "source_excerpt", "text_characters": 386, "text_sha256": "3346d03798ff2e1a1fb9a43c9ede021f42a9f36256d3799bc555da216161104a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:56.751480+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_statu