{"text_id": "text_e8df88a0f6a060b88a8b", "record_id": "article_e8df88a0f6a060b8", "canonical_url": "https://news.mongabay.com/2025/09/new-conservation-area-protects-53-of-carbon-in-northern-peruvian-amazon", "publisher_url": "https://news.mongabay.com/2025/09/new-conservation-area-protects-53-of-carbon-in-northern-peruvian-amazon", "title_original": "New conservation area protects 53% of carbon in northern Peruvian Amazon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-18T15:39:52+00:00", "source_text": "A new regional conservation area has been created in Loreto, the largest region in Peru’s Amazon. The Medio Putumayo Algodón Regional Conservation Area is the fourth protected natural area in the Putumayo region, an area connected by the Putumayo River, which flows into Colombia. The Ministry of the Environment established the area on June 6 […]", "text_kind": "source_excerpt", "text_characters": 347, "text_sha256": "2275446cb4960d74a4b98aae429e2fefd31cc7f183fa1b4fcd75c70bf5c1d0c0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:06.800398+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:06.812983+00:00", "published_at_raw": "2025-09-18T15:39:52", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru", "start": 83, "end": 87, "matched_text": "Peru", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 271, "end": 279, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_185015e972aece5a0296", "record_id": "article_185015e972aece5a", "canonical_url": "https://insideclimatenews.org/news/18092025/inside-clean-energy-iowa-solar-potential", "publisher_url": "https://insideclimatenews.org/news/18092025/inside-clean-energy-iowa-solar-potential", "title_original": "Can the Nation’s Most Wind-Powered State Look to Solar?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-18T13:00:00+00:00", "source_text": "Two-thirds of Iowa’s electricity comes from wind turbines that sprout from fields like giant beanstalks. The state’s vast expanses of exposed land—ideal for wind energy generation—also have the potential for excellent solar production. But so far, that hasn’t been the case. Instead, wind’s growth in Iowa has completely dwarfed solar, which still powers less than […]", "text_kind": "source_excerpt", "text_characters": 368, "text_sha256": "bbfb610264dcb3f8f829f17864c265681efa5cdd5ba5fd45c2a929740e17b918", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:31.302694+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 162, "end": 168, "evidence": "om fields like giant beanstalks. The state’s vast expanses of exposed land—ideal for wind energy generation—also have the potential for excellent solar production. But so 