{"text_id": "text_6c16f7c3eaee1aa9d1e6", "record_id": "article_6c16f7c3eaee1aa9", "canonical_url": "https://insideclimatenews.org/news/27012025/home-efficiency-pros-wary-of-ohio-federal-rebates", "publisher_url": "https://insideclimatenews.org/news/27012025/home-efficiency-pros-wary-of-ohio-federal-rebates", "title_original": "Are We Doing This Again? Home Efficiency Pros Are Wary as Ohio Gets Federal Rebates, Just a Few Years After State Funding Was Yanked", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-27T10:00:00+00:00", "source_text": "SUNBURY, Ohio—Dwayne Petko kneels on the concrete floor of a semi-built house and turns the knob of a large fan mounted in the front doorway, part of the most common test in his line of work. He is the owner and operator of Energy Matters LLC, an energy rating service, and he is doing a […]", "text_kind": "source_excerpt", "text_characters": 291, "text_sha256": "1ad91c55b1bb264cff12d01a794969c0f2ec0f08afe8ff05713950565598e8c5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:04.445144+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 224, "end": 230, "evidence": "oorway, part of the most common test in his line of work. He is the owner and operator of Energy Matters LLC, an energy rating service, and he is doing a […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:04.456357+00:00", "published_at_raw": "2025-01-27T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_a16abdbc64b6e096b5ec", "record_id": "article_a16abdbc64b6e096", "canonical_url": "https://insideclimatenews.org/news/26012025/how-embers-spread-wildfires", "publisher_url": "https://insideclimatenews.org/news/26012025/how-embers-spread-wildfires", "title_original": "Tiny Flames With a Huge Impact: How Embers Spread Wildfires in California and Beyond", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-26T10:00:00+00:00", "source_text": "When wildfires burn, it’s often tiny, blazing fragments of debris, known as embers, that cause the most widespread destruction. Embers are born when flames consume vegetation, structures or other fuel sources that break off into lightweight, burning particles that are easily carried by the wind. The path of an ember is erratic. These airborne fragments […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "2915e2ce57d45645c92ba361dd3db54f286c55ed92aad06c67b019bccf25ade1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:04.542160+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 5, "end": 13, "evidence": "When wildfires burn, it’s often tiny, blazing fragments of debris, known as embers, that cause the most widespread destruction. Embers are born when flam"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:04.555042+00:00", "published_at_raw": "2025-01-26T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 63, "end": 73, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_35e013a9893b0466e63c", "record_id": "article_35e013a9893b0466", "canonical_url": "https://insideclimatenews.org/news/25012025/trump-ev-positions-would-increase-car-prices", "publisher_url": "https://insideclimatenews.org/news/25012025/trump-ev-positions-would-increase-car-prices", "title_original": "Why Trump’s Positions on EVs Would Shoot America in the Foot", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-25T09:55:00+00:00", "source_text": "From our collaborating partner Living on Earth, public radio’s environmental news magazine, an interview by Aynsley O’Neill with green transportation journalist Jim Motavalli. As part of his Day One executive order titled “Unleashing American Energy,” President Donald Trump rolled back the Biden administration’s goal for half of vehicles sold in America by 2030 to be […]", "text_kind": "source_excerpt", "text_characters": 373, "text_sha256": "b4d04c1d50691fc8b687563dc13da19ff845fcc9c1dac11ae27c4cc3d4588b66", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:04.641542+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 243, "end": 249, "evidence": "rnalist Jim Motavalli. As part of his Day One executive order titled “Unleashing American Energy,” President Donald Trump rolled back the Biden administration’s goal for half of vehicles sold in America by 2030 to be […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:04.656768+00:00", "published_at_raw": "2025-01-25T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_f9c7afd810c2ce606a80", "record_id": "article_f9c7afd810c2ce60", "canonical_url": "https://yaleclimateconnections.org/2025/01/lo-que-significa-el-abando-del-acuerdo-de-paris", "publisher_url": "https://yaleclimateconnections.org/2025/01/lo-que-significa-el-abando-del-acuerdo-de-paris", "title_original": "Lo qué significa el abandono del Acuerdo de París", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-24T16:06:33+00:00", "source_text": "El Acuerdo de París es frecuentemente mencionado como una pieza clave en la lucha contra el cambio climático, pero ¿qué lo hace tan relevante? ¿Y qué implica que la administración Trump haya decidido, una vez más, empezar el proceso de retirar a Estados Unidos del acuerdo el 20 de enero de 2025? Cabe recordar que, en 2016, durante su primer mandato, el presidente Trump también tomó la misma decisión de desvincular al país de este compromiso global. En ese entonces la medida fue anunciada en junio de 2017, pero debido a las reglas de la ONU esa decisión solo entró en efecto el 20 de noviembre de 2020. “Si bien la primera retirada duró sólo cuatro meses, esta segunda retirada podría extenderse durante casi tres años, debilitando gravemente la confianza internacional en EE. UU.", "text_kind": "article_excerpt", "text_characters": 785, "text_sha256": "97e101155a6c3425c74552e0545d68ba6f3c5d56c590aa4c62491ed217d47c02", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:48:28.628490+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:28.718368+00:00", "published_at_raw": "2025-01-24T16:06:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_f7e62d2ee4f09c8921d5", "record_id": "article_f7e62d2ee4f09c89", "canonical_url": "https://news.mongabay.com/2025/01/scientists-are-tracking-global-wildlifes-contributions-to-humanity", "publisher_url": "https://news.mongabay.com/2025/01/scientists-are-tracking-global-wildlifes-contributions-to-humanity", "title_original": "Scientists are tracking global wildlife’s contributions to humanity", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-23T20:28:47+00:00", "source_text": "In October 2020, the hoofbeats of American bison thumped across the prairie of the Rosebud Reservation for the first time in more than a century. Years in the works, the release of 100 bison (Bison bison) in the U.S. state of South Dakota resulted from a collaboration between the Sicangu Lakota Oyate Nation, WWF and […]", "text_kind": "source_excerpt", "text_characters": 321, "text_sha256": "8a268c5ccb7501014f9786991dded36a27f7e0eed0cd4b75423a4d2da3e26f12", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:23.850138+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:23.871433+00:00", "published_at_raw": "2025-01-23T20:28:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 212, "end": 216, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_cb39c481fe43b48f959e", "record_id": "article_cb39c481fe43b48f", "canonical_url": "https://insideclimatenews.org/news/23012025/corpus-christi-launches-emergency-water-projects-as-reservoirs-dwindle-and-industrial-demand-grows", "publisher_url": "https://insideclimatenews.org/news/23012025/corpus-christi-launches-emergency-water-projects-as-reservoirs-dwindle-and-industrial-demand-grows", "title_original": "Corpus Christi Launches Emergency Water Projects as Reservoirs Dwindle and Industrial Demand Grows", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-23T12:11:39+00:00", "source_text": "On the South Texas coast, the city of Corpus Christi has initiated an emergency effort to boost its water supply as local reservoirs experience a yearslong decline and water demand from big industrial projects continues to grow. The Corpus Christi City Council approved a measure last week to begin leasing land for wells that will […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "88fcf5135555832e7e4f1ec739568e253f6b8314d201019b3e433dec1dff669c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:04.867841+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "adopted", "label_zh": "通过", "label_en": "Adopted", "start": 261, "end": 269, "evidence": "er demand from big industrial projects continues to grow. The Corpus Christi City Council approved a measure last week to begin leasing land for wells that will […]"}], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:04.880984+00:00", "published_at_raw": "2025-01-23T12:11:39", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 13, "end": 18, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_039320fb58894963f5bf", "record_id": "article_039320fb58894963", "canonical_url": "https://yaleclimateconnections.org/2025/01/chirps-and-songs-can-be-signs-of-an-ecosystems-health", "publisher_url": "https://yaleclimateconnections.org/2025/01/chirps-and-songs-can-be-signs-of-an-ecosystems-health", "title_original": "Chirps and songs can be signs of an ecosystem’s health", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-22T12:00:00+00:00", "source_text": "Transcript: Wildlife researchers often spend a lot of time looking through binoculars or monitoring images from trail cameras. But Elizabeth Znidersic of Charles Sturt University in Australia prefers to listen. Znidersic: “I first started to become very interested in sound when I was working on secretive marsh birds. So you usually don’t see these birds, you only ever hear them.” So to monitor the birds, she placed sound recorders in the marsh. And she found that during a major flood, the Australasian bittern stopped performing its mating call. Znidersic: “Now when that water level dropped back down, which was slightly outside of their breeding season, the birds started to call.” So researchers could tell that the birds had shifted their breeding in response to the flooding.", "text_kind": "article_excerpt", "text_characters": 785, "text_sha256": "e4941ba3272c1e7b29d18fd2285ebc5c2a91515914c049fbda9104c386fc4b8b", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:48:29.014432+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 483, "end": 488, "evidence": "tor the birds, she placed sound recorders in the marsh. And she found that during a major flood, the Australasian bittern stopped performing its mating call. Znidersic: “Now when that water level dropped back down, which was slightly o"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:29.045827+00:00", "published_at_raw": "2025-01-22T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia", "start": 182, "end": 191, "matched_text": "Australia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_dfdb8c2383285cece924", "record_id": "article_dfdb8c2383285cec", "canonical_url": "https://yaleclimateconnections.org/2025/01/moose-vs-ticks-a-battle-of-giants-and-bloodsuckers", "publisher_url": "https://yaleclimateconnections.org/2025/01/moose-vs-ticks-a-battle-of-giants-and-bloodsuckers", "title_original": "Moose vs. ticks: a battle of giants and bloodsuckers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-20T12:00:00+00:00", "source_text": "Transcript: Moose are the giants of northern forests. But in some areas, they’re threatened by tiny creatures called winter ticks. In fall, the tick larvae hide in the brush and wait for animals like moose to climb onto. Steeve Côté , a biologist at Laval University in Québec, says that by winter, some moose end up covered by thousands of ticks sucking their blood. Côté: “And it’s itchy, so they will scratch a lot on trees and they will lose hair. … They’re not eating … and they become weaker and weaker.” For moose calves, tick infestations can be deadly. So to investigate how much the ticks affect moose calf survival, Côté’s team treated some calves with anti-tick pesticides, while leaving others alone. Just 7% of the treated moose died compared with 40% of those that were untreated.", "text_kind": "article_excerpt", "text_characters": 795, "text_sha256": "223bd7aa899ee20dddbc680cfe952768e63661676cdbc89aff432e17deb78fe2", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:48:29.242102+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "7%", "start": 719, "end": 721, "evidence": " Just 7% of the treated moose died compared with 40% of those that were untreated.", "interpretation": "not_classified"}, {"value_text": "40%", "start": 762, "end": 765, "evidence": " Just 7% of the treated moose died compared with 40% of those that were untreated.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:29.307207+00:00", "published_at_raw": "2025-01-20T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_fd558076d9575168eb41", "record_id": "article_fd558076d9575168", "canonical_url": "https://insideclimatenews.org/news/20012025/wildfire-rebuild-opportunity-for-sustainable-homes", "publisher_url": "https://insideclimatenews.org/news/20012025/wildfire-rebuild-opportunity-for-sustainable-homes", "title_original": "Wildfire Rebuilds Are an Opportunity to Build More Resilient and Sustainable Homes. But That Comes With Controversy", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-20T09:55:00+00:00", "source_text": "After Colorado’s most costly wildfire, hundreds of residents in Louisville—one of the communities that burned—protested in front of city hall over building codes meant to make new homes more green and sustainable, arguing they would make the rebuilding process longer and more expensive. To rebuild, new homes would have to be built to updated energy […]", "text_kind": "source_excerpt", "text_characters": 354, "text_sha256": "43f1a97dc0a4e54363aeacb6539dfdbf3fc87b8efa778a55d3ec4d35b79a6043", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:05.198438+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 344, "end": 350, "evidence": "rocess longer and more expensive. To rebuild, new homes would have to be built to updated energy […]"}, {"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 29, "end": 37, "evidence": "After Colorado’s most costly wildfire, hundreds of residents in Louisville—one of the communities that burned—protested in front of city hall over building codes meant to make n"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:05.214701+00:00", "published_at_raw": "2025-01-20T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_8edfad5b9359febce434", "record_id": "article_8edfad5b9359febc", "canonical_url": "https://insideclimatenews.org/news/19012025/virginia-great-dismal-swamp-peatland-restoration-carbon-sinks", "publisher_url": "https://insideclimatenews.org/news/19012025/virginia-great-dismal-swamp-peatland-restoration-carbon-sinks", "title_original": "Virginia Once Drained and Dried Peatlands, but Now Eyes Them as Carbon Sinks", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-19T09:55:00+00:00", "source_text": "Fred Wurster’s favorite time to walk through the Great Dismal Swamp is at dusk. Pushing through thick vegetation and swatting away mosquitoes, he gets to a section of this 113,000-acre national wildlife refuge that was repeatedly burned by fires. Wurster, a hydrologist with the U.S. Fish and Wildlife Service, spent a decade building small dams […]", "text_kind": "source_excerpt", "text_characters": 349, "text_sha256": "8450417038ed58d40f5a801322a166c8eff3a503f63ec0d0f5cde1ba3bc965be", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:05.281296+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:05.297353+00:00", "published_at_raw": "2025-01-19T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 279, "end": 283, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_5dccdcb3e697aa6c3c84", "record_id": "article_5dccdcb3e697aa6c", "canonical_url": "https://dialogue.earth/en/ocean/eroding-homes-ghanas-disappearing-coastal-communities", "publisher_url": "https://dialogue.earth/en/ocean/eroding-homes-ghanas-disappearing-coastal-communities", "title_original": "Eroding homes: Ghana’s disappearing coastal communities", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-17T18:46:53+00:00", "source_text": "Sat on a crumbling wall of concrete blocks, 71-year-old Agbasa Stanley gazes out at the Gulf of Guinea. Here in Dzakplagbe village, in Ghana’s south-eastern Volta region, Stanley’s face is a mixture of wonder and sadness. “I was born and raised here,” he says. “Back then, the sea was miles away from where we are standing. Many houses, and whole communities, have been swallowed by the water.” Fishing communities like Dzakplagbe and Fuveme once thrived here. But this part of Volta is located on a narrow strip of land that separates the Keta Lagoon from the Atlantic Ocean, and it has been gradually sinking. Formerly fertile land is now open water. Scattered remnants of stone walls serve as faint reminders of the homes and lives that previously flourished here.", "text_kind": "article_excerpt", "text_characters": 767, "text_sha256": "eb9435c257647313089d3c2d5bfb9e94f83bcd4337f28db06646f4c46ccc6e50", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:41.365761+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana"}, {"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana"}, {"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:41.417505+00:00", "published_at_raw": "2025-01-17T18:46:53", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana", "start": 15, "end": 20, "matched_text": "Ghana", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea", "start": 96, "end": 102, "matched_text": "Guinea", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana", "start": 135, "end": 140, "matched_text": "Ghana", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_b328cddd730366acd89c", "record_id": "article_b328cddd730366ac", "canonical_url": "https://insideclimatenews.org/news/16012025/inside-clean-energy-trump-coal-plant-retirement-plans", "publisher_url": "https://insideclimatenews.org/news/16012025/inside-clean-energy-trump-coal-plant-retirement-plans", "title_original": "Has Trump Changed the Retirement Plans for the Country’s Largest Coal Plants?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-16T14:00:00+00:00", "source_text": "There is renewed talk of a coal power comeback in the United States, inspired by Donald Trump’s return to the presidency and forecasts of soaring electricity demand. The evidence so far only shows that some plants are getting small extensions on their retirement dates. This means a slowdown in coal’s rate of decline, which is […]", "text_kind": "source_excerpt", "text_characters": 331, "text_sha256": "f65fa56f98be69934afd245daac57b209d8f207aa0bbfc0f576cc002161aa7d2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:05.550781+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 27, "end": 31, "evidence": "There is renewed talk of a coal power comeback in the United States, inspired by Donald Trump’s return to the presidency and forecasts of soaring electricity demand. The e"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:05.568413+00:00", "published_at_raw": "2025-01-16T14:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 54, "end": 67, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_ff80d6177e05070032c0", "record_id": "article_ff80d6177e050700", "canonical_url": "https://insideclimatenews.org/news/16012025/fire-weather-author-john-vaillant-parallels-fort-mcmurray-los-angeles", "publisher_url": "https://insideclimatenews.org/news/16012025/fire-weather-author-john-vaillant-parallels-fort-mcmurray-los-angeles", "title_original": "‘Virtually Any City on Earth Can Burn Now’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-16T10:00:00+00:00", "source_text": "The journalist John Vaillant’s book “Fire Weather” begins in the spring of 2016 in the boreal forests surrounding the remote Canadian city of Fort McMurray, where a fire is growing. Although wildfire is a regular part of life in northern Alberta, this fire was destined to be different. “A new kind of fire introduced itself […]", "text_kind": "source_excerpt", "text_characters": 328, "text_sha256": "77bc2423f5654d6f791a4ea18140e5ccec113ff01214d39bbb67287aac11f8e1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:05.588183+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 191, "end": 199, "evidence": " surrounding the remote Canadian city of Fort McMurray, where a fire is growing. Although wildfire is a regular part of life in northern Alberta, this fire was destined to be different. “A new kind of fire introduced itself […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:05.599951+00:00", "published_at_raw": "2025-01-16T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_b6542690e7846ce7613c", "record_id": "article_b6542690e7846ce7", "canonical_url": "https://insideclimatenews.org/news/16012025/florida-manatees-retain-threatened-despite-calls-for-more-protection", "publisher_url": "https://insideclimatenews.org/news/16012025/florida-manatees-retain-threatened-despite-calls-for-more-protection", "title_original": "Florida Manatees Retain Threatened Status Under New Federal Proposal, Despite Outcry for Greater Protection", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-16T09:55:00+00:00", "source_text": "ORLANDO, Fla.—Protections for Florida’s ailing manatees would remain unchanged under a U.S. Fish and Wildlife Service proposal announced this week. The manatees would retain their listing as threatened under the Endangered Species Act, despite ample criticism that has ensued since 2017, when the federal agency downlisted the beloved sea cows from endangered. In its proposal, […]", "text_kind": "source_excerpt", "text_characters": 381, "text_sha256": "47c492d53dccde6d3cd0d73ef77dd4fb2b02845a6135a8b568c2e386eea1ddb6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:05.614779+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 118, "end": 126, "evidence": "r Florida’s ailing manatees would remain unchanged under a U.S. Fish and Wildlife Service proposal announced this week. The manatees would retain their listing as threatened under the Endangered Species Act, despite ample criticism that h"}], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:05.627528+00:00", "published_at_raw": "2025-01-16T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 87, "end": 91, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
