{"text_id": "text_e3eb6c15005a7216cd58", "record_id": "article_e3eb6c15005a7216", "canonical_url": "https://insideclimatenews.org/news/28062025/epa-decision-to-roll-back-power-plant-emissions-rules-lasting-impact", "publisher_url": "https://insideclimatenews.org/news/28062025/epa-decision-to-roll-back-power-plant-emissions-rules-lasting-impact", "title_original": "The Danger of Losing the EPA’s Endangerment Finding", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-28T08:50:00+00:00", "source_text": "From our collaborating partner “Living on Earth,” public radio’s environmental news magazine, an interview by host and executive producer Steve Curwood with Richard Lazarus, the Charles Stebbins Fairchild Professor of Law at Harvard Law School. Record summer heat is scorching the northern hemisphere around the world from Japan and China to Europe and North America. […]", "text_kind": "source_excerpt", "text_characters": 371, "text_sha256": "e67c08594b2b5c31321c6e95b259cf93919beafaa612501c2b4fb00f114ac646", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:33.288125+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:33.312965+00:00", "published_at_raw": "2025-06-28T08:50:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan", "start": 323, "end": 328, "matched_text": "Japan", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 333, "end": 338, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_04d1e6dfe963e31a6402", "record_id": "article_04d1e6dfe963e31a", "canonical_url": "https://news.mongabay.com/2025/06/friendship-benefits-male-and-female-mountain-gorillas-differently-study-shows", "publisher_url": "https://news.mongabay.com/2025/06/friendship-benefits-male-and-female-mountain-gorillas-differently-study-shows", "title_original": "Friendship benefits male and female mountain gorillas differently, study shows", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-27T15:06:30+00:00", "source_text": "Titus was just 4 years old when poachers killed his father and several other close adults in his group. Despite the violence, the young mountain gorilla developed an approach to leadership characterized by gentleness and calm behavior, building close bonds with the females in his group, who often stayed in physical contact with him. This […]", "text_kind": "source_excerpt", "text_characters": 343, "text_sha256": "70e3955a304515cb1e1ff192b1c4424183ef66ed4b4a9090fc3e28eefa90cba8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:50.212877+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.c