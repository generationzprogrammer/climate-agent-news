{"text_id": "text_c42c7db00dd1651f6fc8", "record_id": "article_c42c7db00dd1651f", "canonical_url": "https://insideclimatenews.org/news/05032024/eqt-natural-gas-fracking-expansion-in-west-virginia", "publisher_url": "https://insideclimatenews.org/news/05032024/eqt-natural-gas-fracking-expansion-in-west-virginia", "title_original": "West Virginia Families Pleaded for Help With Health Issues After Fracking Started Nearby. None Came", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-05T11:00:00+00:00", "source_text": "This article was originally published by PublicSource, a nonprofit newsroom serving the Pittsburgh region. Sign up for its free weekly newsletters at publicsource.org. This story was supported by the Pulitzer Center. June 7, 2022. Abby Tennant woke in the dead of the night. Sharp pain pierced her chest, and she felt the urge to vomit. […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "e37848587e74758050df8630cb9154859c550a2ec9f031687729724ddb04dbb2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:24.971555+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:24.986098+00:00", "published_at_raw": "2024-03-05T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 13, "matched_text": "West Virginia", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_32bec00d41ff110c6427", "record_id": "article_32bec00d41ff110c", "canonical_url": "https://news.mongabay.com/2024/03/png-communities-resist-seabed-mining-interview-with-activist-jonathan-mesulam", "publisher_url": "https://news.mongabay.com/2024/03/png-communities-resist-seabed-mining-interview-with-activist-jonathan-mesulam", "title_original": "PNG communities resist seabed mining: Interview with activist Jonathan Mesulam", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-01T19:35:08+00:00", "source_text": "KONO, Papua New Guinea — News of apparent renewed interest in deep-sea mining came as a shock to Jonathan Mesulam in late 2022. Looking out over the Bismarck Sea that separates his native island of New Ireland from Papua New Guinea’s mainland, the former teacher and U.N. aid worker-turned-activist fights back tears. It’s a dose […]", "text_kind": "source_excerpt", "text_characters": 333, "text_sha256": "f22ceb5dcca1e1cf1bca5eefa33a9675af46e9062d2dfd22e4ca8312b51673fb", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:07.974497+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PG", "alpha3": "PNG", "name_zh": "巴布亚新几内亚", "name_en": "Papua New Guinea"}, {"alpha2": "IE", "alpha3": "IRL", "name_zh": "爱尔兰", "name_en": "Ireland"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PG", "alpha3": "PNG", "name_zh": "巴布亚新几内亚", "name_en": "Papua New Guinea"}, {"alpha2": "IE", "alpha3": "IRL", "name_zh": "爱尔兰", "name_en": "Ireland"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:07.995038+00:00", "published_at_raw": "2024-03-01T19:35:08", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PG", "alpha3": "PNG", "name_zh": "巴布亚新几内亚", "name_en": "Papua New Guinea", "start": 6, "end": 22, "matched_text": "Papua New Guinea", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "IE", "alpha3": "IRL", "name_zh": "爱尔兰", "name_en": "Ireland", "start": 202, "end": 209, "matched_text": "Ireland", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_b90f171488c7dd3defe8", "record_id": "article_b90f171488c7dd3d", "canonical_url": "https://insideclimatenews.org/news/01032024/links-between-melting-arctic-ice-and-summertime-extreme-weather-in-europe", "publisher_url": "https://insideclimatenews.org/news/01032024/links-between-melting-arctic-ice-and-summertime-extreme-weather-in-europe", "title_original": "Study Pinpoints Links Between Melting Arctic Ice and Summertime Extreme Weather in Europe", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-01T10:10:00+00:00", "source_text": "The Arctic Ocean is mostly enclosed by the coldest parts of the Northern Hemisphere’s continents, ringed in by Siberia, Alaska and the Canadian Arctic, with only a small opening to the Pacific through the Bering Strait, and some narrow channels through the labyrinth of Canada’s Arctic archipelago. But east of Greenland, there’s a stretch of […]", "text_kind": "source_excerpt", "text_characters": 346, "text_sha256": "f589f3f6dc066b1775c624fa8fda0aa3f163d0c52d822a0f80fa537d4da3e62b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:25.542746+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}, {"alpha2": "GL", "alpha3": "GRL", "name_zh": "格陵兰", "name_en": "Greenland"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}, {"alpha2": "GL", "alpha3": "GRL", "name_zh": "格陵兰", "name_en": "Greenland"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:25.555132+00:00", "published_at_raw": "2024-03-01T10:10:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada", "start": 270, "end": 276, "matched_text": "Canada", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "GL", "alpha3": "GRL", "name_zh": "格陵兰", "name_en": "Greenland", "start": 311, "end": 320, "matched_text": "Greenland", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_7a8226410582f7374b84", "record_id": "article_7a8226410582f737", "canonical_url": "https://news.mongabay.com/2024/02/major-meatpackers-are-unlawfully-deforesting-brazils-cerrado-report-says", "publisher_url": "https://news.mongabay.com/2024/02/major-meatpackers-are-unlawfully-deforesting-brazils-cerrado-report-says", "title_original": "Major meatpackers are unlawfully deforesting Brazil’s Cerrado, report says", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-29T18:56:31+00:00", "source_text": "The cattle ranching industry in Brazil is deforesting one of the country’s largest ecosystems without proper authorization, often with the financial backing of major international banks. Some of the country’s largest meatpackers are clearing parts of the Cerrado at an even faster rate than the Amazon Rainforest, a new report from U.K.-based NGO Global Witness […]", "text_kind": "source_excerpt", "text_characters": 365, "text_sha256": "73782f414e5db128c79537abe084be406a7b402ba3e7c27494cebd14f4a93e33", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:08.069463+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:08.084463+00:00", "published_at_raw": "2024-02-29T18:56:31", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 45, "end": 51, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 32, "end": 38, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 332, "end": 336, "matched_text": "U.K.", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_d888e85d3809311984c0", "record_id": "article_d888e85d38093119", "canonical_url": "https://news.mongabay.com/2024/02/new-precedent-as-afro-brazilian-quilombo-community-wins-historic-land-claim", "publisher_url": "https://news.mongabay.com/2024/02/new-precedent-as-afro-brazilian-quilombo-community-wins-historic-land-claim", "title_original": "New precedent as Afro-Brazilian quilombo community wins historic land claim", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-29T16:08:22+00:00", "source_text": "After winning a historic lawsuit late last year, a traditional Afro-Brazilian community has finally obtained legal recognition of its land located in São Paulo’s Alto Ribeira Tourist State Park, a protected area. According to legal experts, the decision is a significant win for the Quilombo de Bombas community, one of hundreds across Brazil made up […]", "text_kind": "source_excerpt", "text_characters": 354, "text_sha256": "8c79a93d1133df8f5124420da15e392c34bb300a91c3bdfb58bf80d55fcaa372", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:08.104853+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:08.120506+00:00", "published_at_raw": "2024-02-29T16:08:22", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 336, "end": 342, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_40ea806a6751197381dd", "record_id": "article_40ea806a67511973", "canonical_url": "https://dialogue.earth/en/pollution/ocean-plastic-could-spread-human-disease", "publisher_url": "https://dialogue.earth/en/pollution/ocean-plastic-could-spread-human-disease", "title_original": "Ocean plastic could spread human disease", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-29T16:07:01+00:00", "source_text": "Images of paradise beaches buried under bottles and ocean animals swimming past carrier bags are the all-too-familiar evidence of how humanity’s addiction to plastic has polluted the marine world. But a less visible problem with plastic is increasingly capturing scientists’ attention: the microbes that have colonised the millions of tonnes and trillions of pieces of it in the ocean. These organisms are emerging as a real threat to animals, and that may include humans. China Dialogue Ocean spoke to Dick Vethaak, a retired professor of ecotoxicology (the study of how toxins affect organisms and ecosystems) and water quality: “We have introduced a completely new niche of substrates, used as a homeland for distinct microorganism communities.", "text_kind": "article_excerpt", "text_characters": 747, "text_sha256": "d87cea687f45585d5dcd1f58d0ee1e40c96f0178f0eb656deb3a6bc65dee7aa1", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:39.706681+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:39.764634+00:00", "published_at_raw": "2024-02-29T16:07:01", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 473, "end": 478, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_a5cb88a4c260b271c464", "record_id": "article_a5cb88a4c260b271", "canonical_url": "https://news.mongabay.com/2024/02/ecuador-colombia-and-the-guiana-shield-join-the-planning-of-sustainable-land-use", "publisher_url": "https://news.mongabay.com/2024/02/ecuador-colombia-and-the-guiana-shield-join-the-planning-of-sustainable-land-use", "title_original": "Ecuador, Colombia and the Guiana Shield join the planning of sustainable land use", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-28T22:40:08+00:00", "source_text": "Ecuador The territorial planning framework in Ecuador is known as the Plan de Desarrollo y Ordenamiento Territorial (PDOT). It is one component in an ambitious effort to articulate a Plan Nacional de Desarrollo (PND), which is being implemented via a constitutionally mandated policy to decentralize the administrative functions of the state. The PDOT is a […]", "text_kind": "source_excerpt", "text_characters": 360, "text_sha256": "e96fc3bb74ca112bbb330a46401c375b900c35c36bb3041b9f9d28af697efe80", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:08.234346+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}, {"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "governance_themes": [], "policy_tools": [{"id": "standards", "label_zh": "标准与监管", "label_en": "Standards and regulation", "start": 268, "end": 275, "evidence": "te a Plan Nacional de Desarrollo (PND), which is being implemented via a constitutionally mandated policy to decentralize the administrative functions of the state. The PDOT is a […]"}], "policy_stages": [{"id": "implementation", "label_zh": "实施", "label_en": "Implementation", "start": 233, "end": 244, "evidence": " in an ambitious effort to articulate a Plan Nacional de Desarrollo (PND), which is being implemented via a constitutionally mandated policy to decentralize the administrative functions of the state. The PDOT is a […]"}], "track": "action", "country_mentions": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:08.247987+00:00", "published_at_raw": "2024-02-28T22:40:08", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador", "start": 0, "end": 7, "matched_text": "Ecuador", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 9, "end": 17, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador", "start": 0, "end": 7, "matched_text": "Ecuador", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_03f2005fdd4154b68080", "record_id": "article_03f2005fdd4154b6", "canonical_url": "https://news.mongabay.com/2024/02/new-giant-anaconda-species-found-on-waorani-indigenous-land-in-ecuador", "publisher_url": "https://news.mongabay.com/2024/02/new-giant-anaconda-species-found-on-waorani-indigenous-land-in-ecuador", "title_original": "Giant anaconda species found on Waorani Indigenous land in Ecuador", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-28T20:54:45+00:00", "source_text": "A new species of giant anaconda has been found in the Amazon Rainforest in Ecuador, scientists announced. The snake, named the northern green anaconda (Eunectes akayima), is genetically distinct from its close relative, the green anaconda (E. murinus) and may be the largest snake species in the world. For 20 years, researchers collected blood and […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "7248918fc00e52900a0705f500d664a67af1d59ec0be9dbcdac34235001d8881", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:08.256110+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:08.273056+00:00", "published_at_raw": "2024-02-28T20:54:45", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador", "start": 59, "end": 66, "matched_text": "Ecuador", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador", "start": 75, "end": 82, "matched_text": "Ecuador", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_4c5644a1098c30171a9e", "record_id": "article_4c5644a1098c3017", "canonical_url": "https://insideclimatenews.org/news/27022024/todays-climate-sponge-city-los-angeles-atmospheric-river", "publisher_url": "https://insideclimatenews.org/news/27022024/todays-climate-sponge-city-los-angeles-atmospheric-river", "title_original": "‘Spongy’ LA Soaked Up Tons of Water From Atmospheric River", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-27T20:00:00+00:00", "source_text": "From Feb. 4 to 7, an atmospheric river passing through the skies of California unleashed 9 inches of rain on Los Angeles. Fortunately, the city has spent years preparing for this type of deluge by mimicking one of the simplest organisms in the animal kingdom: a sponge. By installing a mosaic of green spaces and […]", "text_kind": "source_excerpt", "text_characters": 316, "text_sha256": "e5f306d49eee1661548b254ef316f6008ce97a8a0a091289c0cabf081c7bd270", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:26.161022+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:26.189539+00:00", "published_at_raw": "2024-02-27T20:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 68, "end": 78, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_d71b58407c7de80fd00f", "record_id": "article_d71b58407c7de80f", "canonical_url": "https://news.mongabay.com/2024/02/u-s-natural-gas-expansion-would-surrender-world-to-fatal-warming-experts-say", "publisher_url": "https://news.mongabay.com/2024/02/u-s-natural-gas-expansion-would-surrender-world-to-fatal-warming-experts-say", "title_original": "U.S. natural gas expansion would surrender world to fatal warming, experts say", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-27T14:46:22+00:00", "source_text": "As the Biden administration pauses to ponder licenses for 12 new LNG export facilities, it is investing billions in natural gas infrastructure abroad. Critics warn U.S. gas expansion poses a direct threat to Earth’s ecosystems and people.", "text_kind": "source_excerpt", "text_characters": 238, "text_sha256": "f388c3f1a462cafdba102471f18023dd5a5cf16fef783113f7d4f1e42b577d2b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:08.373109+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:08.390068+00:00", "published_at_raw": "2024-02-27T14:46:22", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 4, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 164, "end": 168, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_b05cea0d33386050f475", "record_id": "article_b05cea0d33386050", "canonical_url": "https://news.mongabay.com/2024/02/dholes-latest-wild-canids-likely-making-comeback-in-nepal-study-shows", "publisher_url": "https://news.mongabay.com/2024/02/dholes-latest-wild-canids-likely-making-comeback-in-nepal-study-shows", "title_original": "Dholes latest wild canids likely making comeback in Nepal, study shows", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-27T14:18:29+00:00", "source_text": "KATHMANDU — Until four decades ago, villagers in Nepal’s mountains would likely name Himalayan wolves as their primary concern among the wild animals native to their region. Lower down in the country’s plains region, it was the dhole, or Indian wild dog, that rural communities would watch out for. In each landscape, locals witnessed packs […]", "text_kind": "source_excerpt", "text_characters": 344, "text_sha256": "111bbff13d71d67a590f65a1779b1ee7a6aaf059ab1928f8c06865624ac1aa47", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:08.402162+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:08.415617+00:00", "published_at_raw": "2024-02-27T14:18:29", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 52, "end": 57, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 49, "end": 54, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_2a1c7ebbfe3334a0de52", "record_id": "article_2a1c7ebbfe3334a0", "canonical_url": "https://yaleclimateconnections.org/2024/02/whats-behind-this-winters-u-s-snow-drought", "publisher_url": "https://yaleclimateconnections.org/2024/02/whats-behind-this-winters-u-s-snow-drought", "title_original": "What’s behind this winter’s U.S. snow drought?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-26T16:35:59+00:00", "source_text": "It’s not that the United States has been entirely bereft of snow during what’s likely to end up as the nation’s warmest winter on record. But for most of the traditionally snowy swaths from the northern Great Plains to the Northeast, there’s been a startling lack of winter storms in 2023-24. The result: widespread bare ground in midwinter and what could end up being some all-time lows for seasonal snowfall. On top of that, there have been a couple of bizarre cases of extremely dry or wet snows, both of which threw monkey wrenches into the forecast and left many snow lovers crestfallen. At weather.com, Jonathan Erdman pulled together some of the noteworthy seasonal stats for a February 23 writeup . Erdman noted that the average snow extent across the contiguous U.S.", "text_kind": "article_excerpt", "text_characters": 775, "text_sha256": "a36426f1598c1aca2b7019104dfb3167f044271e961c42e4528732871d3c3603", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:24.621471+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:24.709884+00:00", "published_at_raw": "2024-02-26T16:35:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 28, "end": 32, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 18, "end": 31, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_8bb631b68954118154e3", "record_id": "article_8bb631b689541181", "canonical_url": "https://insideclimatenews.org/news/24022024/robert-bullard-says-2024-is-year-of-environmental-justice-for-shiloh-alabama", "publisher_url": "https://insideclimatenews.org/news/24022024/robert-bullard-says-2024-is-year-of-environmental-justice-for-shiloh-alabama", "title_original": "Q&A: Robert Bullard Says 2024 Is the Year of Environmental Justice for an Inundated Shiloh, Alabama", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-24T10:00:00+00:00", "source_text": "From our collaborating partner “Living on Earth,” public radio’s environmental news magazine, an interview by host Steve Curwood with Robert Bullard, a Distinguished Professor of Urban Planning and Environmental Policy at Texas Southern. Back in 1979, Robert Bullard was a freshly minted Ph.D. sociologist at Texas Southern University, researching segregated residential housing. One day, his […]", "text_kind": "source_excerpt", "text_characters": 396, "text_sha256": "88d4e993a71982947b610a93432ecec402c227364951d45a07ff86f2de725a14", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:26.841747+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:26.871972+00:00", "published_at_raw": "2024-02-24T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 222, "end": 227, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_a48120924f52d0ab1a0f", "record_id": "article_a48120924f52d0ab", "canonical_url": "https://news.mongabay.com/2024/02/controversy-brews-over-proposed-dam-on-kathmandus-bagmati-river", "publisher_url": "https://news.mongabay.com/2024/02/controversy-brews-over-proposed-dam-on-kathmandus-bagmati-river", "title_original": "Controversy brews over proposed dam on Kathmandu’s Bagmati River", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-22T10:16:14+00:00", "source_text": "KATHMANDU — The Bagmati River, coursing through Nepal’s capital, Kathmandu, has transformed into a sewer canal in recent decades, with untreated raw sewage discharged into its waters. Officials are now drafting plans to rejuvenate the sacred river, which also passes through the revered Pashupatinath Temple, by building a dam 95-meters (311 feet) tall to collect […]", "text_kind": "source_excerpt", "text_characters": 367, "text_sha256": "873e014f0da6a2944123d73ebed63c73fba7776652f17d3f718c16d0a26986be", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:13.060962+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:13.074379+00:00", "published_at_raw": "2024-02-22T10:16:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 48, "end": 53, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_31aeec50620973ac9078", "record_id": "article_31aeec50620973ac", "canonical_url": "https://dialogue.earth/en/water/389449-drought-in-mexico-three-ways-local-projects-are-overcoming-water-issues", "publisher_url": "https://dialogue.earth/en/water/389449-drought-in-mexico-three-ways-local-projects-are-overcoming-water-issues", "title_original": "Drought in Mexico: Three ways local projects are overcoming water issues", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-21T12:46:59+00:00", "source_text": "In recent weeks, Mexico City and the surrounding State of Mexico have been experiencing a period of extreme water scarcity, with at least 280 of the city’s 1,800-plus neighbourhoods affected. Daily TV news clips have shown long lines of people queueing to buy water from tankers, dirty dishes piling up, and people desperate for a shower, having been unable to take one for days. In some areas, the shortages have led to protests, with citizens blockading main thoroughfares and taking to the streets with banners. The problem is not a new one for Mexico City, with decreased rainfall, groundwater depletion and poor management having posed challenges for several years. But the severity of the situation has been increasing.", "text_kind": "article_excerpt", "text_characters": 725, "text_sha256": "0a1606deb559f3009d60a0bc2ba206072ca02fd57b41fca213025d7e3726d8aa", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:40.430432+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:40.469014+00:00", "published_at_raw": "2024-02-21T12:46:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 11, "end": 17, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 17, "end": 23, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_bdad1536a2bb3c54e25a", "record_id": "article_bdad1536a2bb3c54", "canonical_url": "https://yaleclimateconnections.org/2024/02/a-rare-bird-in-the-south-atlantic-tropical-storm-akara", "publisher_url": "https://yaleclimateconnections.org/2024/02/a-rare-bird-in-the-south-atlantic-tropical-storm-akara", "title_original": "A rare bird in the South Atlantic: Tropical Storm Akará", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-19T17:10:56+00:00", "source_text": "The only ocean basin on Earth that does not regularly see tropical cyclones develop is the South Atlantic, but it had a rare tropical storm form on Sunday night. Tropical Depression 01Q was designated by the Brazilian Navy Hydrographic Center at 7 a.m. EST Sunday and by 7 p.m., it had been upgraded to Tropical Storm Akará, with top sustained winds estimated at 40 mph and a central pressure of 1000 millibars. NOAA’s Office of Satellite and Product Operations was also tracking Akará and assigning Dvorak intensity ratings. Although one or two subtropical storms typically form each year in the South Atlantic, Akará is the region’s first officially recognized tropical storm that has been named since Iba in 2019 and only the third one there since Anita in 2010.", "text_kind": "article_excerpt", "text_characters": 765, "text_sha256": "a48e2fcf6da3375370ce6ab48c07af902d8122bd44652f5dfe3ed2c9a09e65fc", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:25.712001+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:25.769210+00:00", "published_at_raw": "2024-02-19T17:10:56", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_3ee387f4b3ee5a6a6d27", "record_id": "article_3ee387f4b3ee5a6a", "canonical_url": "https://yaleclimateconnections.org/2024/02/company-gives-retired-wind-turbine-blades-new-life", "publisher_url": "https://yaleclimateconnections.org/2024/02/company-gives-retired-wind-turbine-blades-new-life", "title_original": "Company gives retired wind turbine blades new life", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-19T12:00:00+00:00", "source_text": "A wind turbine usually lasts 20 years or more. But at the end of its life, its giant blades often end up in a landfill. That’s because many turbine blades are built out of a composite material made of glass fibers mixed with a hardened resin or other polymer. Recycling this composite material is difficult. But a company called Carbon Rivers has found a way to give this material a new life. Morgan: “We know how to do this with paper, we know how to do this with metal, and we know how to do this with plastic. Now we’re doing this with composite.” That’s David Morgan of Carbon Rivers . The company shreds each turbine blade and runs the pieces through an oxygen-free reactor to separate the polymer from the glass fibers. Those fibers can then be recovered and reused.", "text_kind": "article_excerpt", "text_characters": 772, "text_sha256": "1d9526b3975a52f0b383fb3b998a4bed37c95bcaa807cb5071288c2b2dde39ab", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:25.822980+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:25.865314+00:00", "published_at_raw": "2024-02-19T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_890971061284f43843e6", "record_id": "article_890971061284f438", "canonical_url": "https://insideclimatenews.org/news/17022024/feds-deny-permits-for-hydro-projects-on-navajo-land", "publisher_url": "https://insideclimatenews.org/news/17022024/feds-deny-permits-for-hydro-projects-on-navajo-land", "title_original": "Feds Deny Permits for Hydro Projects on Navajo Land, Citing Lack of Consultation With Tribes", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-17T10:10:00+00:00", "source_text": "Federal officials Thursday denied preliminary permits for multiple pumped storage hydroelectric projects proposed on the Navajo Nation that would have required vast sums of water from limited groundwater aquifers and the declining Colorado River, citing a lack of support from tribal communities. In the order, the Federal Energy Regulatory Commission announced it was implementing a […]", "text_kind": "source_excerpt", "text_characters": 387, "text_sha256": "8215019b42d51c43ec16d338c67ea3a7990c6c70f21e7faaa0f26a6f330ae7db", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:32.063915+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 323, "end": 329, "evidence": "lorado River, citing a lack of support from tribal communities. In the order, the Federal Energy Regulatory Commission announced it was implementing a […]"}], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 105, "end": 113, "evidence": "ls Thursday denied preliminary permits for multiple pumped storage hydroelectric projects proposed on the Navajo Nation that would have required vast sums of water from limited groundwater aquifers and the declining Colorado River, citing"}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:32.077951+00:00", "published_at_raw": "2024-02-17T10:10:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_914a49bb3af1bce934cc", "record_id": "article_914a49bb3af1bce9", "canonical_url": "https://insideclimatenews.org/news/16022024/todays-climate-whale-entanglement-adds-tension-to-lobstering-conflict", "publisher_url": "https://insideclimatenews.org/news/16022024/todays-climate-whale-entanglement-adds-tension-to-lobstering-conflict", "title_original": "A Beached Whale Has Reignited the Fight Between Conservationists and Maine’s Lobster Industry", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-16T19:05:31+00:00", "source_text": "At the end of January, an endangered female North Atlantic right whale washed ashore on Martha’s Vineyard. Federal officials found rope twisted around the dead whale’s tail, which had worn away flesh over time, evidence of a “chronic entanglement,” according to the National Oceanic and Atmospheric Administration. On Wednesday, NOAA confirmed that these sea-worn ropes […]", "text_kind": "source_excerpt", "text_characters": 373, "text_sha256": "dc70fc868996784e0bf442f2f37bf2d3b14b8d1f21afebcc7cb9f8516ad638e0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:32.151452+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_ve