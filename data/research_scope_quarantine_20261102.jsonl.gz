{"text_id": "text_9e5aad447d938a2d11a4", "record_id": "article_9e5aad447d938a2d", "canonical_url": "https://insideclimatenews.org/news/14092026/midwest-wildfire-risk", "publisher_url": "https://insideclimatenews.org/news/14092026/midwest-wildfire-risk", "title_original": "Is Wildfire Risk Increasing in the Midwest?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-14T09:00:00+00:00", "source_text": "On the night of July 6, a storm moved over northern Minnesota near the Boundary Waters Canoe Area Wilderness. The boreal forest there, composed of species like balsam fir, spruce and pine, was extremely dry after a flash drought and unusually warm temperatures sapped the trees of their moisture. As the storm blew across the […]", "text_kind": "source_excerpt", "text_characters": 329, "text_sha256": "ae330c58ec68db08a8e08267c65b3d65fe20e516448cd7f17801ec0c00ba9fae", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:01.195358+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 221, "end": 228, "evidence": "re, composed of species like balsam fir, spruce and pine, was extremely dry after a flash drought and unusually warm temperatures sapped the trees of their moisture. As the storm blew across the […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:01.228196+00:00", "published_at_raw": "2026-09-14T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_0fc3345195ac3d1abead", "record_id": "article_0fc3345195ac3d1a", "canonical_url": "https://insideclimatenews.org/news/11092026/court-rules-against-trump-order-to-keep-costly-michigan-coal-plant-running", "publisher_url": "https://insideclimatenews.org/news/11092026/court-rules-against-trump-order-to-keep-costly-michigan-coal-plant-running", "title_original": "Court Rules Against Trump Order to Keep Costly Michigan Coal Plant Running", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-11T22:14:08+00:00", "source_text": "A federal appeals court has struck down the Trump administration’s use of emergency powers to require a coal-fired power plant in Michigan to remain open, ruling that the U.S. Department of Energy exceeded its authority. The 3-0 decision in the U.S. Court of Appeals for the District of Columbia is a rebuke of the administration’s […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "46f6e168b567bf7d67b37d2d84be8ad76403b102ec7917d1e1443ba9663f8248", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:02.632639+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 104, "end": 108, "evidence": "als court has struck down the Trump administration’s use of emergency powers to require a coal-fired power plant in Michigan to remain open, ruling that the U.S. Department of Energy exceeded its authority. The 3-0 decision in the U.S"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:02.679280+00:00", "published_at_raw": "2026-09-11T22:14:08", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 171, "end": 175, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_5dc298a707f9292a612f", "record_id": "article_5dc298a707f9292a", "canonical_url": "https://yaleclimateconnections.org/2026/09/la-tierra-acaba-de-vivir-su-agosto-mas-caluroso-registrado", "publisher_url": "https://yaleclimateconnections.org/2026/09/la-tierra-acaba-de-vivir-su-agosto-mas-caluroso-registrado", "title_original": "La Tierra acaba de vivir su agosto más caluroso registrado", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-11T16:10:43+00:00", "source_text": "El intenso súper El Niño, combinado con el calentamiento global, hace prever que 2026 será el año más caluroso registrado, y se espera que 2027 sea aún más caluroso.", "text_kind": "source_excerpt", "text_characters": 165, "text_sha256": "ac36cdf206d1f7d2b433631a1f61a4b39d22bcb11a06b0a742ece6beffc044ab", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:29.681145+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:29.691248+00:00", "published_at_raw": "2026-09-11T16:10:43", "sample_frame": "public_archives_20261102", "sampling_method": "d