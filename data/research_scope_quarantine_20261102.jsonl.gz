{"text_id": "text_f1d637e94bac206e0a8b", "record_id": "article_f1d637e94bac206e", "canonical_url": "https://insideclimatenews.org/news/08012026/inside-clean-energy-what-to-expect-in-2026", "publisher_url": "https://insideclimatenews.org/news/08012026/inside-clean-energy-what-to-expect-in-2026", "title_original": "Looking Ahead to a Deepening Affordability Crisis, an Election and the Threat of an AI Investment Bubble", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-08T14:00:00+00:00", "source_text": "U.S. energy markets and policy are heading toward the equivalent of a multicar pileup in 2026. The key factors are consumer frustration with rising energy prices, Trump administration policies that are making the problem worse despite promises to make it better and a growing awareness that investment in AI data centers is part of a […]", "text_kind": "source_excerpt", "text_characters": 337, "text_sha256": "d607d14bae9d6766fafbb089242af79caa1e8ef9a1ab28d5bb1121cf16b3654c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:12.913712+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 5, "end": 11, "evidence": "U.S. energy markets and policy are heading toward the equivalent of a mult