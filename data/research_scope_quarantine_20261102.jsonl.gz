{"text_id": "text_f25d4ed4f022c64219bf", "record_id": "article_f25d4ed4f022c642", "canonical_url": "https://news.mongabay.com/2024/06/sugarcane-megaproject-poses-latest-threat-to-papuas-forests-communities", "publisher_url": "https://news.mongabay.com/2024/06/sugarcane-megaproject-poses-latest-threat-to-papuas-forests-communities", "title_original": "Sugarcane megaproject poses latest threat to Papua’s forests, communities", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-19T15:56:10+00:00", "source_text": "JAKARTA — The Indonesian government plans to establish 2 million hectares, or nearly 5 million acres, of sugarcane plantations in the eastern region of Papua, home to the last great expanse of rainforest in Southeast Asia. The country’s investment minister, Bahlil Lahadalia, said the land, spanning an area 30 times the size of Jakarta, was available in […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "7689b0dd4a7cda575c835aabafecba3de5ee35a6e8be426dd095a524f6a9de12", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:07.542524+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "2 million", "start": 55, "end": 64, "evidence": "JAKARTA — The Indonesian government plans to establish 2 million hectares, or nearly 5 million acres, of sugarcane plantations in the eastern region of Papua, home to the last great expanse of rainforest in Southeast Asia.", "interpretation": "not_classified"}, {"value_text": "5 million", "start": 85, "end": 94, "evidence": "JAKARTA — The Indonesian government plans to establish 2 million hectares, or nearly 5 million acres, of sugarcane plantations in the eastern region of Papua, home to the last great expanse of rainforest in Southeast Asia.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:07.556201+00:00", "published_at_raw": "2024-06-19T15:56:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_f782c3c208d4de35ad3f", "record_id": "article_f782c3c208d4de35", "canonical_url": "https://www.carbonbrief.org/experts-what-is-causing-food-prices-to-spike-around-the-world", "publisher_url": "https://www.carbonbrief.org/experts-what-is-causing-food-prices-to-spike-around-the-world", "title_original": "Experts: What is causing food prices to spike around the world?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-19T14:44:39+00:00", "source_text": "Print article Share Spiking food prices have made headlines around the world this year, from eggs in the US to vegetables in India . The UN Food and Agriculture Organization’s Food Price Index has been slowly increasing over the past six months following declines over much of 2023. For example, the price of orange juice concentrate in the US was 42% higher in April than it was a year ago, while the price of fresh orange juice in the UK has risen 25% over the last year. In Greece, the price of olive oil rose by nearly 30% over 2023 and by more than 63% in April of this year. No single factor alone can explain the rising prices. But geopolitical conflict, extreme weather events, high input costs and increased demand are all playing a role.", "text_kind": "article_excerpt", "text_characters": 747, "text_sha256": "c9b488439cf89b0eeb8a4c71f45ea71757c053ecee700b5441351e73806cdb33", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:02.343111+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "42%", "start": 348, "end": 351, "evidence": " For example, the price of orange juice concentrate in the US was 42% higher in April than it was a year ago, while the price of fresh orange juice in the UK has risen 25% over the last year.", "interpretation": "not_classified"}, {"value_text": "25%", "start": 450, "end": 453, "evidence": " For example, the price of orange juice concentrate in the US was 42% higher in April than it was a year ago, while the price of fresh orange juice in the UK has risen 25% over the last year.", "interpretation": "not_classified"}, {"value_text": "30%", "start": 523, "end": 526, "evidence": " In Greece, the price of olive oil rose by nearly 30% over 2023 and by more than 63% in April of this year.", "interpretation": "not_classified"}, {"value_text": "63%", "start": 554, "end": 557, "evidence": " In Greece, the price of olive oil rose by nearly 30% over 2023 and by more than 63% in April of this year.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}, {"alpha2": "GR", "alpha3": "GRC", "name_zh": "希腊", "name_en": "Greece"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}, {"alpha2": "GR", "alpha3": "GRC", "name_zh": "希腊", "name_en": "Greece"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:02.412398+00:00", "published_at_raw": "2024-06-19T14:44:39", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 105, "end": 107, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 125, "end": 130, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 437, "end": 439, "matched_text": "UK", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "GR", "alpha3": "GRC", "name_zh": "希腊", "name_en": "Greece", "start": 477, "end": 483, "matched_text": "Greece", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_07ca091aecbab6698aae", "record_id": "article_07ca091aecbab669", "canonical_url": "https://dialogue.earth/en/business/chinas-position-in-the-global-race-for-alternative-ev-batteries", "publisher_url": "https://dialogue.earth/en/business/chinas-position-in-the-global-race-for-alternative-ev-batteries", "title_original": "China’s position in the global race for alternative EV batteries", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-18T11:00:48+00:00", "source_text": "At the Beijing Auto Show in April, CATL, the world’s largest electric vehicle (EV) battery maker, stunned many with a new product. The Shenxing Plus battery can power an EV for more than 1,000 kilometres on a single charge, according to CATL. That’s enough to get from Guangzhou to Wuhan, or London to Berlin. “[The battery] can reach a range of 600 kilometres with a 10-minute charge, equalling one kilometre every second,” Gao Huan, chief technology officer of CATL’s electric car business, proudly announced at the launch ceremony. Chinese firms have been unveiling new lithium-ion cells with longer ranges, shorter charging times and more charging cycles in their lifespans, at a frequency unseen anywhere else in the world.", "text_kind": "article_excerpt", "text_characters": 728, "text_sha256": "29784a90f8670b866af70efecdd3dfc80198cfb752edb0a3ec074d8424871568", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:14.143445+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:14.175042+00:00", "published_at_raw": "2024-06-18T11:00:48", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 0, "end": 5, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 7, "end": 14, "matched_text": "Beijing", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_c60269b05bcf5acda19b", "record_id": "article_c60269b05bcf5acd", "canonical_url": "https://insideclimatenews.org/news/18062024/everglades-wetlands-toxic-algae-pollution", "publisher_url": "https://insideclimatenews.org/news/18062024/everglades-wetlands-toxic-algae-pollution", "title_original": "Billions of Gallons of Freshwater Are Dumped at Florida’s Coasts. Environmentalists Want That Water in the Everglades", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-18T09:00:00+00:00", "source_text": "Scattered between the vast sugar cane and vegetable fields of Florida’s heartland and the fragile marshes of the Everglades are a series of wetlands, resembling nature but hardly natural, that together represent the largest experiment of its kind in the world. The wetlands were built over the last 30 years to serve as a buffer […]", "text_kind": "source_excerpt", "text_characters": 332, "text_sha256": "d8bfa3c7429b492c281cd4423b801eedb5b2d64392ff964a7387254239efa6d6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:37.098256+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:37.110310+00:00", "published_at_raw": "2024-06-18T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_ae69209ba1486f16ed83", "record_id": "article_ae69209ba1486f16", "canonical_url": "https://news.mongabay.com/2024/06/brazils-br-319-highway-the-latest-maneuver-to-obtain-approval-for-an-environmental-disaster-commentary", "publisher_url": "https://news.mongabay.com/2024/06/brazils-br-319-highway-the-latest-maneuver-to-obtain-approval-for-an-environmental-disaster-commentary", "title_original": "Brazil’s BR-319 Highway: The latest maneuver to obtain approval for an environmental disaster (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-17T00:23:15+00:00", "source_text": "Brazil’s Amazon deforestation has traditionally been primarily in the “arc of deforestation” along the southern and eastern edges of the forest, but highways connecting this arc, such as the BR-163 (Santarém-Cuiabá) highway, are allowing this destruction to expand to rainforest areas to the north. Of particular concern at the present time is the BR-319 (Manaus-Porto […]", "text_kind": "source_excerpt", "text_characters": 372, "text_sha256": "2142d0c6420551e2c14cff7eabd7c6b9500b119c0a3f47502746d5885e20d4a8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:12.537087+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:12.589436+00:00", "published_at_raw": "2024-06-17T00:23:15", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 0, "end": 6, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 0, "end": 6, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_0d29c5a7aea1ff972601", "record_id": "article_0d29c5a7aea1ff97", "canonical_url": "https://news.mongabay.com/2024/06/deforestation-in-earths-largest-rainforest-continues-to-plummet-despite-a-rise-in-fires", "publisher_url": "https://news.mongabay.com/2024/06/deforestation-in-earths-largest-rainforest-continues-to-plummet-despite-a-rise-in-fires", "title_original": "Deforestation in Earth’s largest rainforest continues to plummet despite a rise in fires", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-15T19:32:29+00:00", "source_text": "Deforestation in the Brazilian Amazon continued to plummet in May, reaching the lowest level since March 2018, according to new data from the alert system run by Brazil’s national space research institute, INPE. According to INPE’s DETER system, deforestation in May 2024 amounted to 501 square kilometers (193 square miles), an area 147 times the […]", "text_kind": "source_excerpt", "text_characters": 351, "text_sha256": "fe57a03cc13c0360a751e170f0aff107ce52fd7787f84eeed3ea9604d9b9acb7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:12.595921+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:12.629599+00:00", "published_at_raw": "2024-06-15T19:32:29", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 162, "end": 168, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_fec50df324fc5aab52ed", "record_id": "article_fec50df324fc5aab", "canonical_url": "https://insideclimatenews.org/news/15062024/firefly-populations-climate-change-threat", "publisher_url": "https://insideclimatenews.org/news/15062024/firefly-populations-climate-change-threat", "title_original": "Will the Lightning Bug Show Go On?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-15T09:05:00+00:00", "source_text": "Every year in late June, Peggy Butler and her husband, Ken, welcome visitors to rural northwestern Pennsylvania for the chance to glimpse the rare and beguiling Photinus carolinus. This firefly species flashes synchronously, creating dazzling spectacles of light. The abundance of fireflies on their property in Forest County—there are at least 17 species in addition […]", "text_kind": "source_excerpt", "text_characters": 371, "text_sha256": "c4ac257591e38831bdd2fb38f4250bbaa89ed819893c5aa58cea1725a06b825c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:37.287430+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:37.304063+00:00", "published_at_raw": "2024-06-15T09:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_adaaa605b6153aafa7f2", "record_id": "article_adaaa605b6153aaf", "canonical_url": "https://yaleclimateconnections.org/2024/06/tropical-attention-turns-from-florida-to-the-western-gulf", "publisher_url": "https://yaleclimateconnections.org/2024/06/tropical-attention-turns-from-florida-to-the-western-gulf", "title_original": "Tropical attention turns from Florida to the western Gulf", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-14T19:32:18+00:00", "source_text": "The Miami-Fort Lauderdale area was thrown into flood-induced chaos on Wednesday as a persistent rain band south of the disturbance Invest 90L brought 10 to 20 inches of rain to some areas. Localized heavy rains were still a threat in South Florida on Friday, while 90L has a slim chance of becoming a tropical cyclone this weekend as it races into the northwest Atlantic. Next week, a much more prolonged and potentially serious setup will take shape in the western Gulf of Mexico. At midday Friday , 90L was located about 100 miles southeast of the Outer Banks of North Carolina. The weak system, with a central pressure of around 1008 millibars and top sustained winds of around 35 mph, was shuttling northeastward along a stationary front. 90L was embedded in a moist atmosphere.", "text_kind": "article_excerpt", "text_characters": 782, "text_sha256": "137595e24ab223da32a096210d5bb20914a5686ee571d35cf88d4d6226031093", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:51.335345+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 47, "end": 52, "evidence": "The Miami-Fort Lauderdale area was thrown into flood-induced chaos on Wednesday as a persistent rain band south of the disturbance Invest 90L brought 10 to 20 inches of rain to some areas. Loc"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:51.370862+00:00", "published_at_raw": "2024-06-14T19:32:18", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 474, "end": 480, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_d3c3677d3e7932bdb379", "record_id": "article_d3c3677d3e7932bd", "canonical_url": "https://yaleclimateconnections.org/2024/06/may-2024-earths-12th-consecutive-warmest-month-on-record", "publisher_url": "https://yaleclimateconnections.org/2024/06/may-2024-earths-12th-consecutive-warmest-month-on-record", "title_original": "May 2024: Earth’s 12th-consecutive warmest month on record", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-13T16:16:09+00:00", "source_text": "May 2024 was Earth’s warmest May since global record-keeping began in 1850 and was the planet’s 12th consecutive warmest month on record, NOAA’s National Centers for Environmental Information , or NCEI, reported June 13. Record heat was unusually widespread, with 16.1% of the world’s surface experiencing record heat, a record for the month of May. NASA placed May at 1.37 degrees Celsius (2.47 °F) above the 1880-1899 period, its best estimate for when preindustrial temperatures last occurred. This beat the previous May record (from 2020) by an impressive 0.13 degrees Celsius (0.23 °F).", "text_kind": "article_excerpt", "text_characters": 591, "text_sha256": "64504f69304b2bb1e21f808810424fdd3a4a6baa4931f8c30e6507a9db6c4ea6", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:51.489911+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "16.1%", "start": 264, "end": 269, "evidence": " Record heat was unusually widespread, with 16.1% of the world’s surface experiencing record heat, a record for the month of May.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 469, "end": 480, "evidence": "es Celsius (2.47 °F) above the 1880-1899 period, its best estimate for when preindustrial temperatures last occurred. This beat the previous May record (from 2020) by an impressive 0.13 degrees Celsius (0.23 °F)."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:51.519901+00:00", "published_at_raw": "2024-06-13T16:16:09", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_394fd89a52d93025d3ca", "record_id": "article_394fd89a52d93025", "canonical_url": "https://insideclimatenews.org/news/13062024/blue-cross-north-carolina-cancels-hog-farm-documentary-screening", "publisher_url": "https://insideclimatenews.org/news/13062024/blue-cross-north-carolina-cancels-hog-farm-documentary-screening", "title_original": "Blue Cross of North Carolina Decided Against an Employee Screening of a Documentary That Links the State’s Massive Hog Farms to Public Health Ills", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-13T09:05:00+00:00", "source_text": "René Miller rests in a recliner in a darkened room, gasping through a nebulizer to ease her asthma. On days like this, the air smells so acrid it feels like her lungs are filled with shards of glass. Miller lives across the road from a factory farm in rural eastern North Carolina that raises thousands […]", "text_kind": "source_excerpt", "text_characters": 306, "text_sha256": "25b2bfff19ebe4693f950b96a1d43017b9a084aed54be828a1bec16da75ed362", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:41.952093+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:41.964106+00:00", "published_at_raw": "2024-06-13T09:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_4bde4af3785e1bbc06e0", "record_id": "article_4bde4af3785e1bbc", "canonical_url": "https://insideclimatenews.org/news/11062024/peru-central-andes-glaciers-may-disappear-by-2050s", "publisher_url": "https://insideclimatenews.org/news/11062024/peru-central-andes-glaciers-may-disappear-by-2050s", "title_original": "Glaciers in Peru’s Central Andes Might Be Gone by 2050s, Study Says", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-11T09:00:00+00:00", "source_text": "In a village in Checacupe, in the southern region of Cusco in the Peruvian Andes, there used to be a ceremony to prepare a glacier lagoon to gather water, said Richart Aybar Quispe Soto, a local hospital worker. It was a ritual that revered the apus, the spirits of the mountains and water, he said. […]", "text_kind": "source_excerpt", "text_characters": 303, "text_sha256": "8fa97c7a36a86c881f82ad0ee5922a5c45f317ff9a6d452b6da367755e799c3f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:42.211758+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:42.223582+00:00", "published_at_raw": "2024-06-11T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru", "start": 12, "end": 16, "matched_text": "Peru", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_d4f6e0f664b500210833", "record_id": "article_d4f6e0f664b50021", "canonical_url": "https://news.mongabay.com/2024/06/2-years-after-bruno-doms-murders-amazon-region-still-rife-with-gangs", "publisher_url": "https://news.mongabay.com/2024/06/2-years-after-bruno-doms-murders-amazon-region-still-rife-with-gangs", "title_original": "2 years after Bruno & Dom’s murders, Amazon region still rife with gangs", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-10T19:22:10+00:00", "source_text": "“Unfortunately, with your passing, we have succeeded!” Beto Marubo wrote to his friend Bruno Pereira in a farewell letter a few weeks after Pereira’s murder. “We have managed to make everyone see our problems. We have exposed how forgotten we, the Indigenous people of the Javari Valley, have been …” British journalist Dom Phillips and Indigenous expert Bruno Pereira were shot to death June 5, 2022, in a remote area of Brazil’s Amazonas state. Phillips, a longtime Guardian reporter, was in the Javari Valley researching a book about rainforest conservation with Pereira as his local host. Pereira was one of the most prestigious Brazilian Indigenous experts and was serving as a consultant for an Indigenous organization after working several years at Brazil’s Indigenous affairs agency, Funai.", "text_kind": "article_excerpt", "text_characters": 798, "text_sha256": "c9893abbd204a2a7e010f9e69f53dad9a2a7b077be2b928f9d16570ca6977a24", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:55:13.356636+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 248, "end": 258, "evidence": "“We have managed to make everyone see our problems. We have exposed how forgotten we, the Indigenous people of the Javari Valley, have been …” British journalist Dom Phillips and Indigenous expert Bruno Pereira were shot to death June 5, 20"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:13.383557+00:00", "published_at_raw": "2024-06-10T19:22:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 301, "end": 308, "matched_text": "British", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 422, "end": 428, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_49b2bcd7291ec552c429", "record_id": "article_49b2bcd7291ec552", "canonical_url": "https://news.mongabay.com/2024/06/activists-decry-latest-arrests-of-east-african-oil-pipeline-opponents", "publisher_url": "https://news.mongabay.com/2024/06/activists-decry-latest-arrests-of-east-african-oil-pipeline-opponents", "title_original": "Activists decry latest arrests of East African oil pipeline opponents", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-07T17:19:30+00:00", "source_text": "Police in northwestern Tanzania have arrested four villagers in Hanang District, after they criticized a controversial oil pipeline being built through the area, in what activists say is just the latest instance of harassment of critics of the project. Gabrieli Daudi, Tiofili Israeli, Marseli Martini and Kamili Fabiano were arrested on June 2 after publicly […]", "text_kind": "source_excerpt", "text_characters": 363, "text_sha256": "effd8dbee4ef5dbd89a5b4eaea3afb6f1e1b2c3f96ad70e4ba2f755ce9e60448", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:13.425388+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:13.440494+00:00", "published_at_raw": "2024-06-07T17:19:30", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania", "start": 23, "end": 31, "matched_text": "Tanzania", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_f7650e46e4f3ce049bd9", "record_id": "article_f7650e46e4f3ce04", "canonical_url": "https://insideclimatenews.org/news/07062024/nevada-lithium-mine-threatens-endangered-wildflower", "publisher_url": "https://insideclimatenews.org/news/07062024/nevada-lithium-mine-threatens-endangered-wildflower", "title_original": "A Proposed Nevada Lithium Mine Could Destroy Critical Habitat for an Endangered Wildflower Found Nowhere Else in the World", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-07T09:00:00+00:00", "source_text": "In less than half a day, you could walk all the way around the 10 acres the endemic species Tiehm’s buckwheat calls home in the Silver Peak Range of Nevada, where the small wildflower with yellow pom-poms grows in part thanks to the soil beneath it being filled with lithium and boron. Those two minerals […]", "text_kind": "source_excerpt", "text_characters": 308, "text_sha256": "b8ea8ead34f4d19bd54b04855ce1b5e15f1dd48a63b685864b230d0ec53c56c0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:42.603676+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:42.617043+00:00", "published_at_raw": "2024-06-07T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_c87325ee6ea4f4cc7b24", "record_id": "article_c87325ee6ea4f4cc", "canonical_url": "https://news.mongabay.com/2024/06/unrest-and-arrests-in-sumatra-as-community-fights-to-protect-mangroves", "publisher_url": "https://news.mongabay.com/2024/06/unrest-and-arrests-in-sumatra-as-community-fights-to-protect-mangroves", "title_original": "Unrest and arrests in Sumatra as community fights to protect mangroves", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-05T19:57:52+00:00", "source_text": "LANGKAT, Indonesia — Ilham was sitting outside on his terrace in the village of Kwala Langkat on April 18 when a scrum of men in plainclothes arrived at his home and strong-armed him into a waiting car. Ilham’s younger brother said the men didn’t show any credentials, and that there was a scuffle as Ilham […]", "text_kind": "source_excerpt", "text_characters": 310, "text_sha256": "2e3c1055d0dbc74f6e8c2d16e7003056473c44244dc93fccfc7659617be8c66b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:13.522940+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:13.536565+00:00", "published_at_raw": "2024-06-05T19:57:52", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 9, "end": 18, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_93ba1d0587507744012a", "record_id": "article_93ba1d0587507744", "canonical_url": "https://yaleclimateconnections.org/2024/06/research-on-earths-raging-fever-of-2023-24-is-picking-up", "publisher_url": "https://yaleclimateconnections.org/2024/06/research-on-earths-raging-fever-of-2023-24-is-picking-up", "title_original": "Research on Earth’s raging fever of 2023-24 is picking up", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-05T17:24:26+00:00", "source_text": "If you’ve got a chronic health concern and you suddenly get acutely sick, you and your doctors face two big issues: what’s behind your short-term crisis, and what are the implications for your longer-term health? Our world’s “planet doctors” have been at a similar stress point for close to a year now. They’ve been scrambling to figure out why Earth’s surface – including both atmosphere and oceans – got hit with an unprecedented spike of heat that’s run from mid-2023 well into 2024. They’ve also been addressing what, if anything, the spike tells us about the next few years and beyond. Several fresh papers are out on two unique and much-publicized factors that may have influenced the astounding global heat of 2023-24.", "text_kind": "article_excerpt", "text_characters": 725, "text_sha256": "a4b0992c724ffef1f470334ff8202f082578014276b1ad4231c91bfa648d8725", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:57.615760+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:57.634075+00:00", "published_at_raw": "2024-06-05T17:24:26", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_f6089b411b56e9b27b53", "record_id": "article_f6089b411b56e9b2", "canonical_url": "https://news.mongabay.com/2024/06/restoring-indigenous-aquaculture-heals-both-ecosystems-and-communities-in-hawaii", "publisher_url": "https://news.mongabay.com/2024/06/restoring-indigenous-aquaculture-heals-both-ecosystems-and-communities-in-hawaii", "title_original": "Restoring Indigenous aquaculture heals both ecosystems and communities in Hawai‘i", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-05T15:19:39+00:00", "source_text": "For generations, native Hawaiians have understood that their aquaculture systems, fishponds known as loko i‘a, serve as nurseries that seed fish populations in surrounding waters. For the first time, a team of scientists from the Hawaiʻi Institute of Marine Biology (HIMB) have modeled this feat of Indigenous science in a study. “We are using science […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "624284969b6c6bff287e72b109eb62821a2ee8ac68d8c273b62520f3fbee8213", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:13.600330+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 299, "end": 309, "evidence": " scientists from the Hawaiʻi Institute of Marine Biology (HIMB) have modeled this feat of Indigenous science in a study. “We are using science […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:13.614502+00:00", "published_at_raw": "2024-06-05T15:19:39", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_96dbc716f8e126aa0b9a", "record_id": "article_96dbc716f8e126aa", "canonical_url": "https://dialogue.earth/en/business/chinese-companies-pilot-nature-related-disclosures", "publisher_url": "https://dialogue.earth/en/business/chinese-companies-pilot-nature-related-disclosures", "title_original": "Chinese companies pilot nature-related disclosures", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-05T12:00:38+00:00", "source_text": "At the Davos World Economic Forum in January, 320 businesses and investment institutions representing 46 different countries announced they would start disclosing their impacts on nature. They did so in line with recommendations from the Taskforce on Nature-related Financial Disclosures ( TNFD ), a global initiative that last year released its framework for nature-related corporate disclosures. Research has found that over half of global GDP (USD 58 trillion) is moderately or highly dependent on nature. Issues such as deforestation and biodiversity loss present systemic risks to this value. Nature-related disclosures will see firms reveal the impact of their activities on nature, so investors can monitor these issues and the public can exercise oversight.", "text_kind": "article_excerpt", "text_characters": 765, "text_sha256": "54e7270d39bb34c4b8d053cc4fd9c801b236f0e8a4332de279305cd62b63d64b", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:22.216843+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "58 trillion", "start": 451, "end": 462, "evidence": " Research has found that over half of global GDP (USD 58 trillion) is moderately or highly dependent on nature.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:22.443922+00:00", "published_at_raw": "2024-06-05T12:00:38", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 0, "end": 7, "matched_text": "Chinese", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_97335a0404e03ab4ae3d", "record_id": "article_97335a0404e03ab4", "canonical_url": "https://dialogue.earth/en/climate/indias-bihar-has-a-plan-for-extreme-heat-why-are-so-many-people-dying", "publisher_url": "https://dialogue.earth/en/climate/indias-bihar-has-a-plan-for-extreme-heat-why-are-so-many-people-dying", "title_original": "India’s Bihar has a plan for extreme heat. Why are so many people dying?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-04T12:33:32+00:00", "source_text": "Despite the existence of a heat plan in a key Indian state and visible improvement in multiple health centres, brutal heat claimed dozens of lives as officials were distracted by elections", "text_kind": "source_excerpt", "text_characters": 188, "text_sha256": "c96937d7a0d2f48a7841e98efc04ba272d1bc2baacd36a973c5f55108234f4b7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:22.653788+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:22.705159+00:00", "published_at_ra