{"text_id": "text_5e20c73f0e7e1238e8b6", "record_id": "article_5e20c73f0e7e1238", "canonical_url": "https://insideclimatenews.org/news/09092026/industry-interests-spent-big-money-to-stop-california-from-banning-pfas-pesticides", "publisher_url": "https://insideclimatenews.org/news/09092026/industry-interests-spent-big-money-to-stop-california-from-banning-pfas-pesticides", "title_original": "Industry Interests Spent Big Money to Stop California From Banning PFAS Pesticides", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-10T01:19:00+00:00", "source_text": "An ambitious bill to keep toxic “forever chemicals” off California produce lost its teeth after the chemical and agricultural industry spent hundreds of thousands of dollars lobbying against it. The bill that landed on Gov. Gavin Newsom’s desk last week simply requires regulators to track and disclose pesticide applications in the state. It’s “a shell […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "73bcdc26425d22710cb487e6b105d71a4a44881ba66377e5ccf83350c3181486", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:04.838393+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:04.854653+00:00", "published_at_raw": "2026-09-10T01:19:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 43, "end": 53, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 56, "end": 66, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_22b0e35ba9280bf47178", "record_id": "article_22b0e35ba9280bf4", "canonical_url": "https://dialogue.earth/en/energy/sodium-batteries-are-coming-to-europe", "publisher_url": "https://dialogue.earth/en/energy/sodium-batteries-are-coming-to-europe", "title_original": "Sodium batteries are coming to Europe", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-09T18:05:04+00:00", "source_text": "Abundant sodium could reduce critical-mineral vulnerabilities and support Europe’s electrification, but Chinese manufacturers hold a commanding lead in the market", "text_kind": "source_excerpt", "text_characters": 162, "text_sha256": "a94ad15e0e7ba3a61e8840ca0c3f76c2505809a218ec53e54e3dec34c45004d2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:21.417504+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:21.442062+00:00", "published_at_raw": "2026-09-09T18:05:04", "sample_frame": "pub