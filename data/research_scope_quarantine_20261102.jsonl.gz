{"text_id": "text_2c017f690db706b406ff", "record_id": "article_2c017f690db706b4", "canonical_url": "https://news.mongabay.com/2026/07/can-fog-harvesting-help-solve-water-scarcity-in-chiles-atacama-desert", "publisher_url": "https://news.mongabay.com/2026/07/can-fog-harvesting-help-solve-water-scarcity-in-chiles-atacama-desert", "title_original": "Can ‘fog harvesting’ help solve water scarcity in Chile’s Atacama Desert?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-17T20:09:16+00:00", "source_text": "Chile’s Atacama Desert is one of the driest places in the world. Some areas only see rainfall a few times in a century, while others have never recorded rainfall at all. In many rural communities there, local governments have to truck in water from other parts of the country or extract it from deep underground […]", "text_kind": "source_excerpt", "text_characters": 315, "text_sha256": "755b116ce5185343a08f6ea91f0a770b814abaa2d61961063653546c389d80ea", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:37.538339+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:37.551731+00:00", "published_at_raw": "2026-07-17T20:09:16", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile", "start": 50, "end": 55, "matched_text": "Chile", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile", "start": 0, "end": 5, "matched_text": "Chile", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_7c4b7b493df1c9aa3b3c", "record_id": "article_7c4b7b493df1c9aa", "canonical_url": "https://dialogue.earth/en/energy/refine-baby-refine", "publisher_url": "https://dialogue.earth/en/energy/refine-baby-refine", "title_original": "‘Refine baby, refine’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-16T14:30:49+00:00", "source_text": "“Drill baby, drill,” said NJ Ayuk, executive chairman of the African Energy Chamber in April. He was speaking in Cape Town at the African Refiners & Distributors Association Week, where he also said “Refine baby, refine.” The conflict in the Gulf is inspiring new debate on energy transitions and energy dependency across Africa. Within a few months of the disruption in the global energy market, economic uncertainty triggered unrest in several African countries, including violent protests in Kenya and strikes in Mozambique. Now an unexpected crisis is turning into a new normal. Recent days have seen renewed US strikes on Iran, strikes by Iran on oil-producing neighbours and LNG vessels, and new threats to impose shipping tolls in the Strait of Hormuz.", "text_kind": "article_excerpt", "text_characters": 759, "text_sha256": "1f7769030732b65d506248495f0743f9dadf6c820a5e1be9b6fce24047c649a5", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:28.894813+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MZ", "alpha3": "MOZ", "name_zh": "莫桑比克", "name_en": "Mozambique"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}, {"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 69, "end": 75, "evidence": "“Drill baby, drill,” said NJ Ayuk, executive chairman of the African Energy Chamber in April. He was speaking in Cape Town at the African Refiners & Distributors Association Week, where he also said “Refine baby, re"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MZ", "alpha3": "MOZ", "name_zh": "莫桑比克", "name_en": "Mozambique"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}, {"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:28.930404+00:00", "published_at_raw": "2026-07-16T14:30:49", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 495, "end": 500, "matched_text": "Kenya", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "MZ", "alpha3": "MOZ", "name_zh": "莫桑比克", "name_en": "Mozambique", "start": 516, "end": 526, "matched_text": "Mozambique", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 613, "end": 615, "matched_text": "US", "method": "country-a