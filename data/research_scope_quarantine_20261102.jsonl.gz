{"text_id": "text_59530746edf6d8487813", "record_id": "article_59530746edf6d848", "canonical_url": "https://insideclimatenews.org/news/07062026/icn-sunday-morning-north-carolina-ratepayer-bill", "publisher_url": "https://insideclimatenews.org/news/07062026/icn-sunday-morning-north-carolina-ratepayer-bill", "title_original": "The Terrible Combined With the Good", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-07T08:50:00+00:00", "source_text": "The Ratepayer Protection Act, making its way through the North Carolina legislature, conjoins two opposing ideas. On one side, the bill would rein in data centers and their ravenous power consumption, and shield North Carolinians from paying higher electric bills as a result of data centers’ operations. On the other, the measure would liberate Duke […]", "text_kind": "source_excerpt", "text_characters": 354, "text_sha256": "6601212567c7738a4ba56820fd6b545f630088f5c5e4abcbcb429e21cce0577d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:13.363563+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-