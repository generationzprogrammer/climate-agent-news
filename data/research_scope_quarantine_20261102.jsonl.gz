{"text_id": "text_0417d7ae4f94083852c2", "record_id": "article_0417d7ae4f940838", "canonical_url": "https://insideclimatenews.org/news/16012026/a-year-out-from-one-of-the-worlds-largest-battery-facility-fires", "publisher_url": "https://insideclimatenews.org/news/16012026/a-year-out-from-one-of-the-worlds-largest-battery-facility-fires", "title_original": "A Year Out From One of the World’s Largest Battery Facility Fires", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-16T22:38:51+00:00", "source_text": "MOSS LANDING, Calif.—A snarl of steel and debris still sits front and center at the Moss Landing Power Plant, after one of the largest battery fires in the world burned here a year ago. The damage, cloistered behind guarded gates, is one of the few visible remnants of the historic inferno. Surrounding the plant, life […]", "text_kind": "source_excerpt", "text_characters": 322, "text_sha256": "f71ec3b8fc30ec403f8f722313d8137f6ea535e8f67a68be75bf598db472155f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:08.919644+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 32, "end": 37, "evidence": "MOSS LANDING, Calif.—A snarl of steel and debris still sits front and center at the Moss Landing Power Plant, after one of the largest battery fires in the world burned here a y"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:08.950575+00:00", "published_at_raw": "2026-01-16T22:38:51", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_c947bfbe1ae7a0fca6dc", "record_id": "article_c947bfbe1ae7a0fc", "canonical_url": "https://insideclimatenews.org/news/16012026/trump-california-public-lands-oil-extraction", "publisher_url": "https://insideclimatenews.org/news/16012026/trump-california-public-lands-oil-extraction", "title_original": "Will Trump’s Push to Drill on California Public Lands be More Successful This Time Around?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-16T10:00:00+00:00", "source_text": "While President Donald Trump pursues Venezuelan oil reserves abroad, his administration continues to double down on efforts to expand drilling in the United States, most recently in California. The Bureau of Land Management (BLM) on Monday proposed plans to open nearly 2 million acres of land from Santa Barbara to the Bay Area for oil […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "529dbc328ba73671e8f1661d1e41fb106664c819e25fe5bf25af94e0c33f40a9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:09.076961+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "2 million", "start": 270, "end": 279, "evidence": " The Bureau of Land Management (BLM) on Monday proposed plans to open nearly 2 million acres of land from Santa Barbara to the Bay Area for oil […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 240, "end": 248, "evidence": "United States, most recently in California. The Bureau of Land Management (BLM) on Monday proposed plans to open nearly 2 million acres of land from Santa Barbara to the Bay Area for oil […]"}], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:09.106535+00:00", "published_at_raw": "2026-01-16T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 30, "end": 40, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 150, "end": 163, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_883ca2ad45ce5f1a53d4", "record_id": "article_883ca2ad45ce5f1a", "canonical_url": "https://news.mongabay.com/2026/01/involuntary-parks-human-conflict-is-creating-unintended-refuges-for-wildlife", "publisher_url": "https://news.mongabay.com/2026/01/involuntary-parks-human-conflict-is-creating-unintended-refuges-for-wildlife", "title_original": "Involuntary parks: Human conflict is creating unintended refuges for wildlife", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-15T16:10:43+00:00", "source_text": "Few locations on Earth are as haunting or deeply ironic as so-called involuntary parks — places too toxic, dangerous, or otherwise made off-limits for human habitation, but which have paradoxically and unintentionally become sanctuaries for wildlife in our absence. As the name coined by science fiction author Bruce Sterling suggests, involuntary parks weren’t established for […]", "text_kind": "source_excerpt", "text_characters": 381, "text_sha256": "fcad5d4d5869f129b3e85f0928d0ad3d93ef6b9b5ab03b8be4c22ecfe2acbd55", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:31.295372+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:31.322382+00:00", "published_at_raw": "2026-01-15T16:10:43", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_979eea2077b406abecd2", "record_id": "article_979eea2077b406ab", "canonical_url": "https://insideclimatenews.org/news/14012026/tidal-turbine-study-tracks-impact-on-marine-life", "publisher_url": "https://insideclimatenews.org/news/14012026/tidal-turbine-study-tracks-impact-on-marine-life", "title_original": "Underwater Cameras Could Help Unlock America’s Tidal Energy Industry", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-14T19:00:00+00:00", "source_text": "At the narrow entrance to Sequim Bay’s tidal channel, an underwater, four-bladed turbine spinning above the seabed might look like a hazard. But here, in Washington state, underwater acoustic cameras bring to life a different story: Schools of Pacific herring swim through the rotors; harbor seals stop and curiously approach; diving cormorants instinctively steer clear. […]", "text_kind": "source_excerpt", "text_characters": 375, "text_sha256": "7be926ef6a29de66a171bc1408f2a17c17f116050d0df45f37b7be50fc60276f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:09.794597+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:09.823904+00:00", "published_at_raw": "2026-01-14T19:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_6889fed604df4cc24c27", "record_id": "article_6889fed604df4cc2", "canonical_url": "https://yaleclimateconnections.org/2026/01/fourth-warmest-year-in-u-s-history-2025", "publisher_url": "https://yaleclimateconnections.org/2026/01/fourth-warmest-year-in-u-s-history-2025", "title_original": "2025: The fourth-warmest year in U.S. history was full of deadly weather extremes", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-13T18:06:37+00:00", "source_text": "The sizzling temperature pace set nationally in recent years continued in 2025, as the contiguous 48 United States experienced its fourth-hottest annual average temperature on record. As reported by NOAA’s National Centers for Environmental Information (NCEI) on January 13, the 48-state temperature of 54.64°F for 2025 placed fourth behind 2024, 2012, and 2016. The average for 2025 came in 2.63°F above the average of 52.01°F for the entire 20th century (1901-2000). Across the entire 131 years of U.S. recordkeeping, the 10 warmest years are now packed into the last two decades, and nine of those years have occurred since 2011. For over half a century, the Dust Bowl year of 1934 reigned as the nation’s hottest on record, but since 2015, most years have ranked warmer than 1934.", "text_kind": "article_excerpt", "text_characters": 784, "text_sha256": "82b103a9d256db59fb3160f7dddf8854dfa06bc3f64a1d61dc719c11496d17af", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:35.122210+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 13, "end": 24, "evidence": "The sizzling temperature pace set nationally in recent years continued in 2025, as the contiguous 48 United States experienced its fourth-hottest annual average tem"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:35.159659+00:00", "published_at_raw": "2026-01-13T18:06:37", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 33, "end": 37, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 101, "end": 114, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_29e2ce4caa1e467babaf", "record_id": "article_29e2ce4caa1e467b", "canonical_url": "https://insideclimatenews.org/news/13012026/congress-bill-would-reduce-money-to-clean-abandoned-coal-mine-lands", "publisher_url": "https://insideclimatenews.org/news/13012026/congress-bill-would-reduce-money-to-clean-abandoned-coal-mine-lands", "title_original": "Coal Communities Accuse Congress of Breaking Its Promise to Clean Up Abandoned Mine Lands", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-13T09:50:00+00:00", "source_text": "When the Infrastructure Investment and Jobs Act was signed into law in 2021, authorizing more than $11 billion in new funding to reclaim lands and waterways damaged by abandoned coal mines, the people who lead this work on the ground were ecstatic. “We were to the moon,” said Amanda Pitzer, the executive director at Friends […]", "text_kind": "source_excerpt", "text_characters": 329, "text_sha256": "9c859ee801895cbf66d25bf955c780269fb9a491af58c8b1e76dee435a43ecfb", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:10.626472+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$11 billion", "start": 99, "end": 110, "evidence": "When the Infrastructure Investment and Jobs Act was signed into law in 2021, authorizing more than $11 billion in new funding to reclaim lands and waterways damaged by abandoned coal mines, the people who lead this work on the ground were ecstatic.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "themati