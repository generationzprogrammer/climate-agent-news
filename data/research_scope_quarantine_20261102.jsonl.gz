{"text_id": "text_4cd5712637f41fe89dec", "record_id": "article_4cd5712637f41fe8", "canonical_url": "https://insideclimatenews.org/news/07012026/billions-needed-to-pump-more-venezuela-oil", "publisher_url": "https://insideclimatenews.org/news/07012026/billions-needed-to-pump-more-venezuela-oil", "title_original": "Oil Industry Will Eye Venezuela Warily, Experts Say", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-07T20:08:59+00:00", "source_text": "Last March, Venezuela’s two most prominent opposition leaders transmitted a video message to Houston, appealing to one of the largest and most influential annual meetings of global energy titans. “Venezuela represents the greatest untapped opportunity in the world,” said Edmundo González Urrutia, the former ambassador widely seen as the rightful winner of the nation’s disputed […]", "text_kind": "source_excerpt", "text_characters": 383, "text_sha256": "4380a13a6fc04b353d4aa46241b81ccc63194e45b2410050de41879aefaa9fc9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:17.899196+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "VE", "alpha3": "VEN", "name_zh": "委内瑞拉玻利瓦尔共和国", "name_en": "Venezuela"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 181, "end": 187, "evidence": "o Houston, appealing to one of the largest and most influential annual meetings of global energy titans. “Venezuela represents the greatest untapped opportunity in the world,” said Edmundo González Urrutia, the former ambassador widely "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "VE", "alpha3": "VEN", "name_zh": "委内瑞拉玻利瓦尔共和国", "name_en": "Venezuela"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:17.929248+00:00", "published_at_raw": "2026-01-07T20:08:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "VE", "alpha3": "VEN", "name_zh": "委内瑞拉玻利瓦尔共和国", "name_en": "Venezuela", "start": 22, "end": 31, "matched_text": "Venezuela", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "VE", "alpha3": "VEN", "name_zh": "委内瑞拉玻利瓦尔共和国", "name_en": "Venezuela", "start": 12, "end": 21, "matched_text": "Venezuela", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_7b8d059c5dbf0186106f", "record_id": "article_7b8d059c5dbf0186", "canonical_url": "https://dialogue.earth/en/nature/chinas-wind-farms-can-protect-migratory-birds-if-well-placed", "publisher_url": "https://dialogue.earth/en/nature/chinas-wind-farms-can-protect-migratory-birds-if-well-placed", "title_original": "China’s wind farms can protect migratory birds, if well placed", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-06T16:30:38+00:00", "source_text": "A black-faced spoonbill takes off from South Korea to migrate south for winter across the Yellow Sea. The rare bird holds a steady course for 500 km towards the Tiaozini wetlands on China’s Jiangsu coast. About 60 km away from his destination, he veers north after flying through two wind farms. After another 60 km, the bird encounters a third wind farm. The line on the tracker now becomes confused, as the bird circles back on himself, unsure of where to go. Ultimately, he gives up and sets course for the Korean breeding grounds he just left, where he will not survive the winter. This tragic case from November 2021 appeared in a 2024 paper in the journal Ecology.", "text_kind": "article_excerpt", "text_characters": 670, "text_sha256": "06f9af2b2c3bb843abe2d2943efe8abd0dcd17c9c4f54d37b38b3a0bce3a78e7", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:00.041986+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:00.170966+00:00", "published_at_raw": "2026-01-06T16:30:38", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 0, "end": 5, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea", "start": 39, "end": 50, "matched_text": "South Korea", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 182, "end": 187, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_c23a7400d071014d75bd", "record_id": "article_c23a7400d071014d", "canonical_url": "https://news.mongabay.com/2026/01/massive-amazon-conservation-program-pledges-to-put-communities-first", "publisher_url": "https://news.mongabay.com/2026/01/massive-amazon-conservation-program-pledges-to-put-communities-first", "title_original": "Massive Amazon conservation program pledges to put communities first", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-05T17:05:54+00:00", "source_text": "In the Chico Mendes Extractive Reserve in the Brazilian Amazon, locals tap rubber and extract Brazil nuts from the rainforest for a living. It’s a way of life dependent on the forest that goes back generations — and which rubber tapper Chico Mendes, who gave the area its name, was murdered trying to defend in […]", "text_kind": "source_excerpt", "text_characters": 314, "text_sha256": "523fb89badc9ee4377c5d3f56a70d863d016747e904ba07eee36fdbf534324a7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:38.584129+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:38.616849+00:00", "published_at_raw": "2026-01-05T17:05:54", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 94, "end": 100, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_82e9c099a75b8691f3cd", "record_id": "article_82e9c099a75b8691", "canonical_url": "https://yaleclimateconnections.org/2026/01/why-this-colorado-coal-town-is-digging-geothermal", "publisher_url": "https://yaleclimateconnections.org/2026/01/why-this-colorado-coal-town-is-digging-geothermal", "title_original": "Why this Colorado coal town is digging geothermal", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-05T12:00:00+00:00", "source_text": "For decades, Dallas Robinson’s family excavation company developed coal mines and power plants in the rugged, fossil-fuel-rich region of northwest Colorado. It was a good business to be in, one that helped hamlets like Hayden grow from outposts to bustling mountain towns — and kept families like Robinson’s rooted in place for generations. “This area, with the exception of agriculture, was built on oil and gas and coal,” said Robinson, a former town councilor for Hayden. But that era is coming to a close. Across the United States, bad economics and even worse environmental impacts are driving coal companies out of business. The 441-megawatt coal-burning power plant just outside Hayden is no exception: It’s shutting down by the end of 2028 .", "text_kind": "article_excerpt", "text_characters": 749, "text_sha256": "c47d8c9ab44136c09165dd8dbde74b9ef6d82b10a4a0a84d9815725811610ef7", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:40.432235+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 67, "end": 71, "evidence": "For decades, Dallas Robinson’s family excavation company developed coal mines and power plants in the rugged, fossil-fuel-rich region of northwest Colorado. It was a good business to be in, one that helped hamle"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:40.497224+00:00", "published_at_raw": "2026-01-05T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 521, "end": 534, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_986c9a675ecef8115c71", "record_id": "article_986c9a675ecef811", "canonical_url": "https://insideclimatenews.org/news/03012026/a-network-blooms-to-connect-fiber-farmers-with-fabric-artisans", "publisher_url": "https://insideclimatenews.org/news/03012026/a-network-blooms-to-connect-fiber-farmers-with-fabric-artisans", "title_original": "A Network Blooms to Connect Fiber Farmers With Fabric Artisans", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-03T09:45:00+00:00", "source_text": "When yarn-maker Anne Choi moved to New Jersey in 2014, she noticed the lack of connection between natural fiber farmers, who raise sheep, alpacas and goats or grow cotton and flax, and fiber artists, who knit, spin and dye the wool or thread into clothing, textiles and other goods. The linkage between fiber farmers and […]", "text_kind": "source_excerpt", "text_characters": 324, "text_sha256": "635aeb1eedaab5c39f6b499095787095252b9c2ec5302d9097bda0b859df1500", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:18.701108+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:18.721438+00:00", "published_at_raw": "2026-01-03T09:45:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 35, "end": 45, "matched_text": "New Jersey", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_7c4aec0a32c9d0bd044c", "record_id": "article_7c4aec0a32c9d0bd", "canonical_url": "https://news.mongabay.com/2025/12/deep-sea-hotels-reveal-20-new-species-hiding-in-oceans-twilight-zone", "publisher_url": "https://news.mongabay.com/2025/12/deep-sea-hotels-reveal-20-new-species-hiding-in-oceans-twilight-zone", "title_original": "Deep-sea ‘hotels’ reveal 20 new species hiding in Pacific Ocean twilight zone near Guam", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-31T18:20:28+00:00", "source_text": "A transparent goby fish drifted through the darkness, its skeleton visible through paper-thin skin. Nearby, a sea slug wore yellow polka dots like a party dress, while an orange fish with bulging eyes hid among the coral. No human had ever seen these creatures — until now. They live in the ocean’s “twilight zone,” a […]", "text_kind": "source_excerpt", "text_characters": 321, "text_sha256": "55ce233759bd3866134756239e86571c174755ef60e58a566377a15c1cc83211", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:38.861838+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GU", "alpha3": "GUM", "name_zh": "关岛", "name_en": "Guam"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_sour