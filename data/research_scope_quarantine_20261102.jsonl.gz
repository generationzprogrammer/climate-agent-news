{"text_id": "text_4024ada4d5a390057b70", "record_id": "article_4024ada4d5a39005", "canonical_url": "https://news.mongabay.com/2024/12/conservationists-and-nature-defenders-who-died-in-2024", "publisher_url": "https://news.mongabay.com/2024/12/conservationists-and-nature-defenders-who-died-in-2024", "title_original": "Conservationists and nature defenders who died in 2024", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-12-27T16:32:22+00:00", "source_text": "The world lost many conservationists, Indigenous leaders, and environmentalists in 2024. Their lives were devoted to safeguarding the planet’s biodiversity, protecting vulnerable communities, and advocating for justice in the face of profound challenges. While each had a unique story, they shared a commitment to the environment, often working on the frontlines of conservation or battling […]", "text_kind": "source_excerpt", "text_characters": 394, "text_sha256": "cd1b15d3720cb3ce6d60c31e6358b1a2b54c25ad741a5a1f238700d0b34900a8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:30.325022+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 38, "end": 48, "evidence": "The world lost many conservationists, Indigenous leaders, and environmentalists in 2024. Their lives were devoted to safeguarding the planet’s biodiversity, protecting vulnerable communiti"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:30.343073+00:00", "published_at_raw": "2024-12-27T16:32:22", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_ef131877539cf448e71f", "record_id": "article_ef131877539cf448", "canonical_url": "https://news.mongabay.com/2024/12/photos-top-new-species-from-2024", "publisher_url": "https://news.mongabay.com/2024/12/photos-top-new-species-from-2024", "title_original": "Photos: Top new species from 2024", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-12-26T22:47:48+00:00", "source_text": "A giant anaconda, a vampire hedgehog, a dwarf squirrel, and a tiger cat were among the new species named by science in 2024. Found from the depths of the Pacific Ocean to the mountaintops of Southeast Asia, each new species shows us that even our well-known world contains unexplored chambers of life. This year, in […]", "text_kind": "source_excerpt", "text_characters": 319, "text_sha256": "d640ff5ded0859a55d50c3cb5474c38368ff540b6ad0ce88282c3c49799df820", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:30.496319+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:30.511556+00:00", "published_at_raw": "2024-12-26T22:47:48", "sample_frame": "public_archive