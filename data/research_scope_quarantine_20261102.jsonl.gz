{"text_id": "text_5401777f6b6c7c6ceb63", "record_id": "article_5401777f6b6c7c6c", "canonical_url": "https://news.mongabay.com/2026/01/a-catastrophe-that-might-offer-a-glimpse-of-hope-for-indonesia", "publisher_url": "https://news.mongabay.com/2026/01/a-catastrophe-that-might-offer-a-glimpse-of-hope-for-indonesia", "title_original": "A catastrophe that might offer a glimpse of hope for Indonesia (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-11T13:06:47+00:00", "source_text": "It was 27 December 2004. I was sitting at my computer in my office in Jakarta, Indonesia, my mind busy with plans for the New Year party I had organized with friends in the city, when my phone started ringing nonstop. First came a call from colleagues, frustrated that our North Sumatra office wasn’t picking […]", "text_kind": "source_excerpt", "text_characters": 312, "text_sha256": "7a643db380bd14d0c2865b4be66a3887318319f381bd00945c86fb5ee5dbf8cd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:38.053171+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:38.078137+00:00", "published_at_raw": "2026-01-11T13:06:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 53, "end": 62, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 79, "end": 88, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_3109ecab0fc99335d197", "record_id": "article_3109ecab0fc99335", "canonical_url": "https://insideclimatenews.org/news/09012026/plastic-waste-fuel-endangers-millions-in-global-south", "publisher_url": "https://insideclimatenews.org/news/09012026/plastic-waste-fuel-endangers-millions-in-global-south", "title_original": "Burning Plastic Waste for Household Fuel Endangers Millions", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-09T20:35:03+00:00", "source_text": "Several global trends are colliding with disastrous consequences for health and the environment, new research warns. Plastic production has skyrocketed since the 1950s, from a few million tons a year to nearly half a billion tons today, and is on track to triple by 2060. And since just a small fraction of plastics is recycled, […]", "text_kind": "source_excerpt", "text_characters": 332, "text_sha256": "37dd5ad21c5e5a573ef69901573546be6a791ea6836772fb150e6f496099dac4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:11.941088+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected