{"text_id": "text_5586fb8edd41d8df77fa", "record_id": "article_5586fb8edd41d8df", "canonical_url": "https://news.mongabay.com/2024/09/ever-smarter-consumer-electronics-push-world-toward-environmental-brink", "publisher_url": "https://news.mongabay.com/2024/09/ever-smarter-consumer-electronics-push-world-toward-environmental-brink", "title_original": "Ever-smarter consumer electronics push world toward environmental brink", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-30T15:15:21+00:00", "source_text": "In recent decades, the electronics industry experienced meteoric growth as it swiftly invented and marketed a galaxy of novel products for consumers hungry for the next innovation, better performance and greater convenience. In 2024, the consumer electronics market alone is expected to top $809 billion, exceeding $1.4 trillion by 2034. But there’s a dark side […]", "text_kind": "source_excerpt", "text_characters": 365, "text_sha256": "229308fab0364bb5732458439099119b1698104ce0bcc05b4d39b4694b9fa882", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:21.820226+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$809 billion", "start": 291, "end": 303, "evidence": " In 2024, the consumer electronics market alone is expected to top $809 billion, exceeding $1.", "interpretation": "not_classified"}, {"value_text": "$1.4 trillion", "start": 315, "end": 328, "evidence": " In 2024, the consumer electronics market alone is expected to top $809 billion, exceeding $1.4 trillion by 2034.", "interpretation": "target_or_commitment"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:21.833515+00:00", "published_at_raw": "2024-09-30T15:15:21", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_aecea755ac3e5be9f4ef", "record_id": "article_aecea755ac3e5be9", "canonical_url": "https://insideclimatenews.org/news/30092024/california-cities-new-buildings-gas-bans-lawsuit", "publisher_url": "https://insideclimatenews.org/news/30092024/california-cities-new-buildings-gas-bans-lawsuit", "title_original": "California Cities Planned to Shut off Gas in New Buildings, but a Lawsuit Turned it Back On. Now What?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-30T09:00:00+00:00", "source_text": "When Berkeley stopped enforcing its much-watched ban on gas appliances in new construction earlier this year, many city planners around California went into a temporary state of shock. The decision followed a protracted legal battle with the California Restaurant Association, which prevailed in federal court. “It definitely created a chill,” said Misti Bruceri, an energy […]", "text_kind": "source_excerpt", "text_characters": 377, "text_sha256": "4a79e4177913d1af244619077fcbb0af48b6fecd0207d335451ad97c3a91b649", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:54.177478+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 367, "end": 373, "evidence": "which prevailed in federal court. “It definitely created a chill,” said Misti Bruceri, an energy […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:54.205075+00:00", "published_at_raw": "2024-09-30T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 10, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 136, "end": 146, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_77c2e3078c55869fa3dc", "record_id": "article_77c2e3078c55869f", "canonical_url": "https://insideclimatenews.org/news/30092024/wyoming-towns-aging-water-sewer-systems-federal-funds", "publisher_url": "https://insideclimatenews.org/news/30092024/wyoming-towns-aging-water-sewer-systems-federal-funds", "title_original": "Budget-Strapped Wyoming Towns Race for Federal Funds To Fix Aging Water, Sewer Systems", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-30T08:55:00+00:00", "source_text": "After a town council shakeup, Micah Foster was suddenly mayor of his tiny eastern Wyoming agricultural town. A wave of resignations last April meant that in addition to getting up at 2 a.m. each day for his regular job—delivering bread to grocery stores for Bimbo Bakeries—Foster found himself running his 400-person town. In June, as […]", "text_kind": "source_excerpt", "text_characters": 338, "text_sha256": "9701bb81ff95f21d04138396fffb518f18df61792569c3905ca4883c9abbc261", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:54.231641+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:54.248714+00:00", "published_at_raw": "2024-09-30T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_0d8d4f907e6b605df94c", "record_id": "article_0d8d4f907e6b605d", "canonical_url": "https://yaleclimateconnections.org/2024/09/at-least-52-killed-in-helenes-southeast-rampage", "publisher_url": "https://yaleclimateconnections.org/2024/09/at-least-52-killed-in-helenes-southeast-rampage", "title_original": "At least 93 killed in Helene’s Southeast rampage", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-28T18:37:42+00:00", "source_text": "Helene, the fourth landfalling U.S. Gulf Coast hurricane of 2024 – and by far the worst so far – has taken dozens of lives and inflicted what will likely end up being many billions in damage. Helene crashed into the Big Bend crescent along Florida’s Gulf Coast on Thursday night, September 26, as a Category 4 storm with top sustained winds estimated at 140 mph. Helene’s havoc continued well beyond landfall as the fast-moving storm raced across eastern Georgia, then looped westward into the Tennessee Valley, dumping record-smashing rains and triggering flash floods and mudslides across the southern Appalachians. Update: At least 93 deaths related to Helene in six states had been confirmed by Sunday evening, September 29, according to the Associated Press.", "text_kind": "article_excerpt", "text_characters": 763, "text_sha256": "7c73e91dd9b77694a07802218f35f336d0c5c94bccc44b7c5cde808ea838c836", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:13.792626+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 563, "end": 568, "evidence": "ed westward into the Tennessee Valley, dumping record-smashing rains and triggering flash floods and mudslides across the southern Appalachians. Update: At least 93 deaths related to Helene in six states had been confirmed by Sunday ev"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:13.837582+00:00", "published_at_raw": "2024-09-28T18:37:42", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 31, "end": 35, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_018ae8d8987423705ce1", "record_id": "article_018ae8d898742370", "canonical_url": "https://news.mongabay.com/2024/09/brazils-race-to-approve-the-end-of-the-amazon-forest-the-br-319-highway-project-needs-a-new-environmental-impact-assessment", "publisher_url": "https://news.mongabay.com/2024/09/brazils-race-to-approve-the-end-of-the-amazon-forest-the-br-319-highway-project-needs-a-new-environmental-impact-assessment", "title_original": "Brazil’s race to approve the end of the Amazon: The BR-319 highway needs a new environmental impact assessment (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-28T15:02:54+00:00", "source_text": "The proposed reconstruction of Brazil’s BR-319 (Manaus-Porto Velho) highway (Figure 1) needs a new environmental impact assessment (EIA). No rational decision can be made on going ahead with this project without considering all its major impacts, and everything points to the project being a monumental disaster for the environment, among other negative effects (see here […]", "text_kind": "source_excerpt", "text_characters": 375, "text_sha256": "dcdd3c70a814a41bdf0196174b87760ec1e071f393eeb5098faac4fe982a61fc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:21.910643+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [],