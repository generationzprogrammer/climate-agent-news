{"text_id": "text_251889bb9c99100321d8", "record_id": "article_251889bb9c991003", "canonical_url": "https://insideclimatenews.org/news/03022025/western-pennsylvania-norfolk-southern-rail-bridges-disrepair", "publisher_url": "https://insideclimatenews.org/news/03022025/western-pennsylvania-norfolk-southern-rail-bridges-disrepair", "title_original": "Norfolk Southern Rail Bridges in Western Pennsylvania in Disrepair, Study Warns", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-03T10:05:00+00:00", "source_text": "In February 2023, 38 train cars owned by the company Norfolk Southern derailed in East Palestine, Ohio, sparking a fire and leading to the vent and burn of thousands of gallons of the toxic chemical vinyl chloride. Norfolk Southern recently announced a settlement with the town for $22 million. Since the derailment, rail safety in […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "10ee91ce9279388ba1803c67db6eddd99fadd06eb62548dec82513e411c1d481", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:58.546718+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$22 million", "start": 282, "end": 293, "evidence": " Norfolk Southern recently announced a settlement with the town for $22 million.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:58.568991+00:00", "published_at_raw": "2025-02-03T10:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_8b6081a9d4497be08f81", "record_id": "article_8b6081a9d4497be0", "canonical_url": "https://insideclimatenews.org/news/02022025/wyoming-tribes-fight-for-water-sovereignty", "publisher_url": "https://insideclimatenews.org/news/02022025/wyoming-tribes-fight-for-water-sovereignty", "title_original": "Giving a Dam: Wyoming Tribes Push to Control Reservation Water as the State Proposes Sending it to Outside Irrigators", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-02T10:05:00+00:00", "source_text": "FT. WASHAKIE, Wyo.—Indigenous Peoples’ Day in October was thick with smoke on the Wind River Indian Reservation, with glimmers of fall foliage along its southwestern rivers shrouded in haze beneath a fuzzy horizon. Reservoirs were shriveled by drought, wildfires raged to the northwest, snow was conspicuously absent from mountain peaks and rivers dried to trickles. […]", "text_kind": "source_excerpt", "text_characters": 370, "text_sha256": "941334452e77a129b87792407ad11a48c797bfd202d48aae430a05ef996a8ec2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:58.656673+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 19, "end": 29, "evidence": "FT. WASHAKIE, Wyo.—Indigenous Peoples’ Day in October was thick with smoke on the Wind River Indian Reservation, with glimmers of fall foliage along its southwestern riv"}, {"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 244, "end": 251, "evidence": "outhwestern rivers shrouded in haze beneath a fuzzy horizon. Reservoirs were shriveled by drought, wildfires raged to the northwest, snow was conspicuously absent from mountain peaks and rivers dried to trickles. […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:58.674250+00:00", "published_at_raw": "2025-02-02T10:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_29adca77ccd42579132c", "record_id": "article_29adca77ccd42579", "canonical_url": "https://insideclimatenews.org/news/30012025/mid-atlantic-states-pjm-electricity-price-cap", "publisher_url": "https://insideclimatenews.org/news/30012025/mid-atlantic-states-pjm-electricity-price-cap", "title_original": "Mid-Atlantic States, PJM Agree to Price Cap for Capacity Auction, Temporarily Easing Energy Affordability Concerns", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-30T21:02:00+00:00", "source_text": "A settlement between PJM Interconnection, the regional grid operator, and the state of Pennsylvania will temporarily cap soaring electricity costs for 65 million consumers across the Mid-Atlantic and Midwest, offering relief from record-high capacity auction prices that threaten to drive up bills and strain state economies. The two-year price cap on capacity auctions will likely […]", "text_kind": "source_excerpt", "text_characters": 385, "text_sha256": "f2c02a98ade0fee253b754ff613e8757043f0e65ebc68a0117290d7b75ec1bf1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:59.313860+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "65 million", "start": 151, "end": 161, "evidence": "A settlement between PJM Interconnection, the regional grid operator, and the state of Pennsylvania will temporarily cap soaring electricity costs for 65 million consumers across the Mid-Atlantic and Midwest, offering relief from record-high capacity auction prices that threaten to drive up bills and strain state economies.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:59.332493+00:00", "published_at_raw": "2025-01-30T21:02:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_7c3696f3d1571eb202c5", "record_id": "article_7c3696f3d1571eb2", "canonical_url": "https://insideclimatenews.org/news/30012025/nyc-officials-advocates-demand-more-funds-for-parks", "publisher_url": "https://insideclimatenews.org/news/30012025/nyc-officials-advocates-demand-more-funds-for-parks", "title_original": "City Council Members, Park Conservancies and Advocates Demand More Funds for NYC Parks", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-30T19:11:31+00:00", "source_text": "On a frigid morning last week on the steps of City Hall in New York City, advocates for increasing city funds to the Parks Department demanded $95 million to hire 1,000 additional workers in response to the mayor’s preliminary budget for the next fiscal year, which starts July 1. “Parks are power, parks are key,” […]", "text_kind": "source_excerpt", "text_characters": 318, "text_sha256": "03ccd0f1a15bcf76ac65ac759f5533ca1a25e361f7d59185809db0d375b2f28c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:59.358013+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$95 million", "start": 143, "end": 154, "evidence": "On a frigid morning last week on the steps of City Hall in New York City, advocates for increasing city funds to the Parks Department demanded $95 million to hire 1,000 additional workers in response to the mayor’s preliminary budget for the next fiscal year, which starts July 1.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:59.379943+00:00", "published_at_raw": "2025-01-30T19:11:31", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_b29131cc8dccbcef8776", "record_id": "article_b29131cc8dccbcef", "canonical_url": "https://insideclimatenews.org/news/30012025/inside-clean-energy-china-deepseek-ai", "publisher_url": "https://insideclimatenews.org/news/30012025/inside-clean-energy-china-deepseek-ai", "title_original": "DeepSeek’s Emergence Shows the Power Sector’s AI Dreams May Not Proceed as Expected", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-30T14:00:00+00:00", "source_text": "The power sector’s data center mania just got a dose of reality. Instead of looking forward to huge increases in electricity demand from data centers that power artificial intelligence tools, companies are facing the possibility that this growth may be smaller and less predictable than previously thought. China-based DeepSeek released information this month about its […]", "text_kind": "source_excerpt", "text_characters": 373, "text_sha256": "e100e742ea3ba465764e164dfb99f30fd8bfe80daeea07aa3a7172e14f86fa28", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:59.416594+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:59.435633+00:00", "published_at_raw": "2025-01-30T14:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 307, "end": 312, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_85ab61ba2533db391618", "record_id": "article_85ab61ba2533db39", "canonical_url": "https://insideclimatenews.org/news/29012025/pesticidas-venenosos-cuentan-la-historia-de-dos-californias", "publisher_url": "https://insideclimatenews.org/news/29012025/pesticidas-venenosos-cuentan-la-historia-de-dos-californias", "title_original": "Pesticidas venenosos cuentan la historia de dos Californias", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-29T23:13:59+00:00", "source_text": "Read this article in English. Capturado: Esta es la segunda parte de una serie sobre cómo los entes reguladores de pesticidas ponen las ganancias de la industria por encima de la salud pública. WATSONVILLE, California—Esperanza se estaba limpiando la tierra y el sudor del cuerpo después de otro día agotador en los campos de fresas […]", "text_kind": "source_excerpt", "text_characters": 336, "text_sha256": "db7f0b4ea2a616bed632ec958082578ff140ba0160679a7e9faf3f14014bf69f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:59.645145+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:59.659134+00:00", "published_at_raw": "2025-01-29T23:13:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 207, "end": 217, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_49d237a7f0ac7ce004a4", "record_id": "article_49d237a7f0ac7ce0", "canonical_url": "https://yaleclimateconnections.org/2025/01/do-americans-really-want-urban-sprawl", "publisher_url": "https://yaleclimateconnections.org/2025/01/do-americans-really-want-urban-sprawl", "title_original": "Do Americans really want urban sprawl?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-29T12:00:00+00:00", "source_text": "Growing up in suburban Ohio, I was used to seeing farmland and woods disappear to make room for new subdivisions, strip malls, and big box stores. I didn’t usually welcome the changes, but I assumed others did. If people didn’t want to live in sprawling suburbs, why did I see this kind of development everywhere I went? But the situation is more complicated than it seems. Although sprawling development is still a familiar sight across the U.S., many experts in urban planning and housing believe this doesn’t occur because of a uniquely American passion for giant parking lots, but as a result of a dysfunctional market. Many people are hungry for denser, more walkable communities, they believe; there just aren’t enough of them to go around.", "text_kind": "article_excerpt", "text_characters": 746, "text_sha256": "55de454766cfd27a0ef52dec36db94853429f0ffebdd700b355a74e5846c0407", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:48:27.990617+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:28.052678+00:00", "published_at_raw": "2025-01-29T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 442, "end": 446, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_ba64e06b2773b98b7f7a", "record_id": "article_ba64e06b2773b98b", "canonical_url": "https://insideclimatenews.org/news/28012025/los-angeles-fire-victims-therapy", "publisher_url": "https://insideclimatenews.org/news/28012025/los-angeles-fire-victims-therapy", "title_original": "LA Fire Victims Have Become ‘Dysregulated,’ Making it Hard to Focus and Make Decisions", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-28T10:05:00+00:00", "source_text": "Cate Parker, a busy psychotherapist in Pasadena, California, has had a chaotic few weeks. Just as she was settling back into the post-holiday swing of things, she and many of her clients found themselves among the tens of thousands of people forced to evacuate as the Eaton Fire engulfed neighboring Altadena. Parker has long had […]", "text_kind": "source_excerpt", "text_characters": 333, "text_sha256": "45cf5bea2a72ca421825d78fae962deb909cc7f6ceb29473f88165898ae09d0f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:04.352674+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:04.365777+00:00", "published_at_raw": "2025-01-28T10:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 49, "end": 59, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_4b4ef3e65c83c65a06e1", "record_id": "article_4b4ef3e65c83c65a", "canonical_url": "https://insideclimatenews.org/news/28012025/colorado-river-money-uncertain-fate-under-trump", "publisher_url": "https://insideclimatenews.org/news/28012025/colorado-river-money-uncertain-fate-under-trump", "title_original": "Money for the Colorado River Faces an Uncertain Fate Under Trump", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-28T09:55:00+00:00", "source_text": "Payments to help Western states respond to drought are on pause after an order from President Donald Trump. A pool of $388.3 million from the Inflation Reduction Act had already been allocated to fund water conservation projects by the Biden administration, and its future now hangs in the balance. The Colorado River supplies water for […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "555a09a87b943a9523959b6d75c0d988e49a36e97e0b3cb4e785cb0086c4df87", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:04.413744+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$388.3 million", "start": 118, "end": 132, "evidence": " A pool of $388.3 million from the Inflation Reduction Act had already been allocated to fund water conservation projects by the Biden administration, and its future now hangs in the balance.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 43, "end": 50, "evidence": "Payments to help Western states respond to drought are on pause after an order from President Donald Trump. A pool of $388.3 million from the Inflation Reduction Act had already been allocat"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:04.424410+00:00", "published_at_raw": "2025-01-28T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_5ac751258829b92d9aa2", "record_id": "article_5ac751258829b92d", "canonical_url": "https://news.mongabay.com/2025/01/calls-for-protection-as-new-images-emerge-of-uncontacted-amazonian-tribe", "publisher_url": "https://news.mongabay.com/2025/01/calls-for-protection-as-new-images-emerge-of-uncontacted-amazonian-tribe", "title_original": "Calls for protection as new images emerge of uncontacted Amazonian tribe", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-27T16:05:24+00:00", "source_text": "Unprecedented images of uncontacted Indigenous people in Brazil’s Massaco Indigenous Territory, in the Amazon region, have prompted a push for greater enforcement to protect the land of these vulnerable populations.", "text_kind": "source_excerpt", "text_characters": 215, "text_sha256": "a231e6e255f62f9d2b7d4f8ba408e4c75da6a5b77487ba87e22b2ae42e99a427", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:18.282452+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 36, "end": 46, "evidence": "Unprecedented images of uncontacted Indigenous people in Brazil’s Massaco Indigenous Territory, in the Amazon region, have prompted a push for greater enforcement to protect the land of "}], "policy_tools": []