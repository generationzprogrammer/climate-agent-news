{"text_id": "text_a8f7f16134ce2e3933c1", "record_id": "article_a8f7f16134ce2e39", "canonical_url": "https://insideclimatenews.org/news/24082025/trump-administration-dismisses-endangered-species-list", "publisher_url": "https://insideclimatenews.org/news/24082025/trump-administration-dismisses-endangered-species-list", "title_original": "The Trump Administration Dismisses the Endangered Species List as ‘Hotel California.’ But There’s Far More to the Story", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-24T08:55:00+00:00", "source_text": "“You can check out any time you like, but you can never leave.” It’s the ominous slogan for “Hotel California,” an iconic fictional lodging dreamed up by the Eagles in 1976. One of the rock band’s lead singers, Don Henley, said in an interview that the song and place “can have a million interpretations.” For […]", "text_kind": "source_excerpt", "text_characters": 313, "text_sha256": "84fa151e202858451323248d21f4630e503341de703083a5b5a4a079de014169", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:54.746945+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "an