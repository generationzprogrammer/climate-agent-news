{"text_id": "text_c21538419e8230417864", "record_id": "article_c21538419e823041", "canonical_url": "https://dialogue.earth/en/energy/coal-phase-out-lessons-from-a-coal-power-giant", "publisher_url": "https://dialogue.earth/en/energy/coal-phase-out-lessons-from-a-coal-power-giant", "title_original": "Coal phase out lessons from a coal-power giant", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-26T09:02:31+00:00", "source_text": "Shandong province has led China in retiring small coal-fired power units. But the real test, cutting coal reliance while keeping heat and power supplies secure, lies ahead", "text_kind": "source_excerpt", "text_characters": 171, "text_sha256": "4195814c93d3fd29c594a92e120396fb41c8e753ed6eb4d06c081f6146b4186c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:27.367686+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 50, "end": 54, "evidence": "Shandong province has led China in retiring small coal-fired power units. But the real test, cutting coal reliance while keeping heat and power supplies secure, lies ahead"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_