": 62, "matched_text": "Malaysia", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines", "start": 68, "end": 79, "matched_text": "Philippines", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia", "start": 81, "end": 89, "matched_text": "Cambodia", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 91, "end": 97, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 103, "end": 116, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras", "start": 122, "end": 130, "matched_text": "Honduras", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_9bbaa36529f9c2a7a1b6", "record_id": "article_9bbaa36529f9c2a7", "canonical_url": "https://insideclimatenews.org/news/10062026/dead-trees-and-coral-shape-ecosystems", "publisher_url": "https://insideclimatenews.org/news/10062026/dead-trees-and-coral-shape-ecosystems", "title_original": "Across Ecosystems, Dead Organisms Help Shape the Living World", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-10T18:31:17+00:00", "source_text": "Death casts a shadow over life, not only for people but also other animals, plants and entire ecosystems. In some ways, the phenomenon is well known. A fallen tree sprouts a plethora of mushrooms while also hosting ants, beetles and the creatures that feast on them. But a new paper argues that these forces play […]", "text_kind": "source_excerpt", "text_characters": 316, "text_sha256": "b7e9418792be4af674f5fde04b632b77d124cff70a3aeeace26b00d84f002805", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:11.398526+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:11.473353+00:00", "published_at_raw": "2026-06-10T18:31:17", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_71100fbb650502bb800d", "record_id": "article_71100fbb650502bb", "canonical_url": "https://insideclimatenews.org/news/10062026/north-carolina-sues-brenntag-for-water-contamination", "publisher_url": "https://insideclimatenews.org/news/10062026/north-carolina-sues-brenntag-for-water-contamination", "title_original": "North Carolina Sues Chemical Company for Polluting a Nearby Creek", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-10T16:50:17+00:00", "source_text": "DURHAM, N.C.—Acetone and ethanol, 1,4-dioxane and “mucilaginous goo.” For decades, state regulatory documents show, a chemical repackaging and distribution company in Durham has discharged high levels of toxic chemicals, as well as other unknown substances, into a neighborhood creek that flows behind an elementary school, through a public park in a predominantly Black neighborhood, and […]", "text_kind": "source_excerpt", "text_characters": 392, "text_sha256": "1eb8689f796003c9f1047faeffc370c1c94b4aee0dc4045ca4de303be19e1ccc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:11.610514+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:11.673922+00:00", "published_at_raw": "2026-06-10T16:50:17", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_721cc6adba128b15b07b", "record_id": "article_721cc6adba128b15", "canonical_url": "https://insideclimatenews.org/news/09062026/todays-climate-heat-wildlife-forecast", "publisher_url": "https://insideclimatenews.org/news/09062026/todays-climate-heat-wildlife-forecast", "title_original": "Heat Is Killing Wildlife Across the Animal Kingdom. A New Forecasting Tool May Help.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-09T21:15:14+00:00", "source_text": "At the end of May, eight endangered Asiatic lions died at a national park in India. Officials feared the animals had succumbed to a tick-borne parasitic disease that previously killed lions in the area. But over the weekend, the Gujarat government announced that the lions’ real killer was extreme heat, The Hindu reports. These casualties […]", "text_kind": "source_excerpt", "text_characters": 343, "text_sha256": "9d8ea3ff3ac1260d2ca9ec99e9aa69c6bc4f397af6711631c6a98bfe19d61f53", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:12.100754+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:12.190280+00:00", "published_at_raw": "2026-06-09T21:15:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 77, "end": 82, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_f6e01303f761d1f56c68", "record_id": "article_f6e01303f761d1f5", "canonical_url": "https://news.mongabay.com/2026/06/how-sound-can-reveal-what-satellite-images-miss", "publisher_url": "https://news.mongabay.com/2026/06/how-sound-can-reveal-what-satellite-images-miss", "title_original": "Why conservation urgently needs acoustic baselines", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-09T00:32:45+00:00", "source_text": "From above, an intact forest can look reassuringly complete. A satellite image may show an unbroken canopy, a block of green still standing amid plantations, roads or logged land. For many conservation programs, that view has become the starting point for measurement. If the canopy remains, the forest is often treated as if much of […]", "text_kind": "source_excerpt", "text_characters": 337, "text_sha256": "151b64168d3ec29a0bd8ad258d45f44e93dc58ed4eab5d1563b2a189049061c0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:15.850226+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:15.878845+00:00", "published_at_raw": "2026-06-09T00:32:45", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_628310639f1fcffd65a8", "record_id": "article_628310639f1fcffd", "canonical_url": "https://news.mongabay.com/2026/06/a-year-on-australias-biggest-harmful-algal-bloom-continues-to-wreak-havoc", "publisher_url": "https://news.mongabay.com/2026/06/a-year-on-australias-biggest-harmful-algal-bloom-continues-to-wreak-havoc", "title_original": "A year on, Australia’s biggest harmful algal bloom continues to wreak havoc", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-08T18:42:40+00:00", "source_text": "PORT HUGHES, Australia — Situated midway along the Great Southern Reef that spans Australia’s southern coastline, the waters off Port Hughes typically teem with life. The coastal hamlet northwest of Adelaide plays host to a multitude of coral, bivalve and fish species. But in late March, the largest and longest harmful algal bloom (HAB) in […]", "text_kind": "source_excerpt", "text_characters": 345, "text_sha256": "ea683f3bd5b2b4b535783bd0fb84b74b711b28001aaa71bba3325b303820d7d9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:15.962954+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia"}], "annotation_