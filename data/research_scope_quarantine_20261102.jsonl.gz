{"text_id": "text_d94c2c5afee865722f67", "record_id": "article_d94c2c5afee86572", "canonical_url": "https://news.mongabay.com/2025/10/a-very-successful-story-an-egypt-tribe-welcomes-tourists-protects-its-coast", "publisher_url": "https://news.mongabay.com/2025/10/a-very-successful-story-an-egypt-tribe-welcomes-tourists-protects-its-coast", "title_original": "‘A very successful story’: An Egypt tribe welcomes tourists & protects its coast", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-27T06:51:50+00:00", "source_text": "AL QULA’AN, Egypt — In the south of Egypt’s Wadi El Gemal protected area, where the desert meets the Red Sea, lies Al-Qula’an, a small village standing on white sand with mangroves in the backdrop. The “eco-village” is free of the hectic activity that characterizes tourist haunts, like Marsa Alam, a resort town about 100 […]", "text_kind": "source_excerpt", "text_characters": 326, "text_sha256": "3e01c42a547631507093738c3aeba7e38f71a95dd8d6cd31862c6dada8495863", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:40.160445+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "EG", "alpha3": "EGY", "name_zh": "埃及", "name_en": "Egypt"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "EG", "alpha3": "EGY", "name_zh": "埃及", "name_en": "Egypt"}], "annotation_method": "dictionary-e