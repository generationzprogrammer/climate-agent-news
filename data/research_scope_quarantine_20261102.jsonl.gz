{"text_id": "text_648d2115c870e67fbf87", "record_id": "article_648d2115c870e67f", "canonical_url": "https://news.mongabay.com/2024/11/sweden-conservation-commentary", "publisher_url": "https://news.mongabay.com/2024/11/sweden-conservation-commentary", "title_original": "Will the new EU environment leader change Sweden’s conservation direction? (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-07T16:40:47+00:00", "source_text": "The evidence is irrefutable: Sweden has spent the last few years trying to frustrate any EU-proposed measures to protect forests. A brief – and far from comprehensive – snapshot of this unhappy record reads as follows: In 2021, a leaked EU Forest Strategy draft revealed European Commission (EC) plans to reduce the clear-cutting that’s ravaged […]", "text_kind": "source_excerpt", "text_characters": 348, "text_sha256": "9d262e1034b49fd25561043ff602f57e75e6c5acd31906d9770236c8808cbc65", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:57.319335+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "SE", "alpha3": "SWE", "name_zh": "瑞典", "name_en": "Sweden"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 92, "end": 100, "evidence": "e evidence is irrefutable: Sweden has spent the last few years trying to frustrate any EU-proposed measures to 