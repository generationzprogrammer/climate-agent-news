{"text_id": "text_8c77a8e5530a170b0e5d", "record_id": "article_8c77a8e5530a170b", "canonical_url": "https://news.mongabay.com/2026/02/malawis-solar-boom-is-leaving-a-toxic-legacy-of-lead-waste", "publisher_url": "https://news.mongabay.com/2026/02/malawis-solar-boom-is-leaving-a-toxic-legacy-of-lead-waste", "title_original": "Malawi’s solar boom is leaving a toxic legacy of lead waste", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-20T09:03:23+00:00", "source_text": "BLANTYRE, Malawi — On Lagson Gumbo’s side of the stream, BCA is a slum. Running parallel to the trickle of murky water is a narrow, dusty street lined with small, unplastered houses and shops trading in groceries, cheap alcohol and artisan services for residents of this crowded sector of Malawi’s principal commercial city, Blantyre. On […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "102410c3089595bd7e2cf25351176ae6b771be455342154372b555fa7d7595aa", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:01.262286+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MW", "alpha3": "MWI", "name_zh": "马拉维", "name_en": "Malawi"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MW", "alpha3": "MWI", "name_zh": "马拉维", "name_en": "Malawi"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:01.303665+00:00", "published_at_raw": "2026-02-20T09:03:23", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MW", "alpha3": "MWI", "name_zh": "马拉维", "name_en": "Malawi", "start": 0, "end": 6, "matched_text": "Malawi", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "MW", "alpha3": "MWI", "name_zh": "马拉维", "name_en": "Malawi", "start": 10, "end": 16, "matched_text": "Malawi", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_6293db2326bf129a5a23", "record_id": "article_6293db2326bf129a", "canonical_url": "https://news.mongabay.com/2026/02/the-amazon-generates-20-billion-of-dollars-worth-of-rainfall-each-year-study-finds", "publisher_url": "https://news.mongabay.com/2026/02/the-amazon-generates-20-billion-of-dollars-worth-of-rainfall-each-year-study-finds", "title_original": "The Amazon’s most valuable export isn’t timber — it’s rain", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-19T00:40:28+00:00", "source_text": "Rainfall is often treated as a gift of geography — a function of latitude, oceans, and atmospheric circulation. A growing body of research suggests that in the tropics, it is also a product of ecosystems. Forests do not merely receive rain. They help generate it, regulate its distribution, and sustain the conditions that allow it […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "39c739a898068fc22b3d8adbb01250b5df51d06a6820826195423f57e30e3628", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:01.679637+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:01.731736+00:00", "published_at_raw": "2026-02-19T00:40:28", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_0a3cb0339b863851e7bd", "record_id": "article_0a3cb0339b863851", "canonical_url": "https://yaleclimateconnections.org/2026/02/why-disabled-people-are-particularly-vulnerable-during-power-outages", "publisher_url": "https://yaleclimateconnections.org/2026/02/why-disabled-people-are-particularly-vulnerable-during-power-outages", "title_original": "Why disabled people are particularly vulnerable during power outages", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-18T12:00:00+00:00", "source_text": "Transcript: Five years ago, Winter Storm Uri knocked out power across much of Texas during a frigid cold snap. Frederick: “It was a statewide traumatic experience for millions of Texans … but for specific groups of disabled people, the loss of heat had extra layers of danger.” In her new book, “ Disabled Power ,” Angela Frederick of the University of Texas at El Paso shares what some of them endured during the disaster. She says some people with chronic conditions, like MS, suffer severe pain and lose mobility during extreme heat or cold.", "text_kind": "article_excerpt", "text_characters": 544, "text_sha256": "93153e5b88af3a053e52d93ca1ace2c7c1d56f62cdcf389c6477c0b0d88c0d03", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:26.695025+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:26.729894+00:00", "published_at_raw": "2026-02-18T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 78, "end": 83, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_db1360525d3603b77926", "record_id": "article_db1360525d3603b7", "canonical_url": "https://news.mongabay.com/2026/02/un-recognition-is-latest-boost-to-restoring-spekboom-across-south-africas-semidesert-karoo", "publisher_url": "https://news.mongabay.com/2026/02/un-recognition-is-latest-boost-to-restoring-spekboom-across-south-africas-semidesert-karoo", "title_original": "UN recognition is latest boost to restoring spekboom across South Africa’s semidesert Karoo", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-17T12:40:57+00:00", "source_text": "“Spekboom is everywhere, it’s all anyone talks about … what used to be an Angora goat farming town is now a spekboom town,” says field ecologist Rae Attridge. In the past two years, Nat Carbon, the carbon project developer Attridge works for, has planted 10,000 hectares (nearly 25,000 acres) of spekboom in the Klein Karoo, […]", "text_kind": "source_excerpt", "text_characters": 328, "text_sha256": "2f2b65a38d83adb0d20fd829b3fe9960fcd780970fd66a5cd774bcceacb2b394", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:10.798073+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:10.858456+00:00", "published_at_raw": "2026-02-17T12:40:57", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa", "start": 60, "end": 72, "matched_text": "South Africa", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_a5d58b7794effe369b4e", "record_id": "article_a5d58b7794effe36", "canonical_url": "https://news.mongabay.com/2026/02/the-business-case-for-biodiversity", "publisher_url": "https://news.mongabay.com/2026/02/the-business-case-for-biodiversity", "title_original": "The business case for biodiversity", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-12T22:42:55+00:00", "source_text": "In Manchester this week, governments endorsed a report that tries to do something business has long resisted: treat biodiversity as economically material. The new assessment from the Intergovernmental Platform on Biodiversity and Ecosystem Services (IPBES) argues that the loss of nature is no longer an environmental side issue. It is a systemic risk to firms, […]", "text_kind": "source_excerpt", "text_characters": 365, "text_sha256": "eafca689d07cde6cebd3b78402c4247f508c1529809101bfeafdea66eca42bdc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:11.481934+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:11.517283+00:00", "published_at_raw": "2026-02-12T22:42:55", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_593c021efd93b1597301", "record_id": "article_593c021efd93b159", "canonical_url": "https://news.mongabay.com/2026/02/another-controversial-land-deal-in-suriname-threatens-the-amazon-rainforest", "publisher_url": "https://news.mongabay.com/2026/02/another-controversial-land-deal-in-suriname-threatens-the-amazon-rainforest", "title_original": "Another controversial land deal in Suriname threatens the Amazon Rainforest", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-11T18:05:21+00:00", "source_text": "Officials in Suriname are trying to cancel a controversial agribusiness contract that could result in the clearance of over a hundred thousand hectares of Amazon rainforest, risking the country’s carbon-negative status. In 2024, the agriculture ministry partnered with a private company to develop 113,465 hectares (280,378 acres) of rainforest for industrial agriculture in the northwestern […]", "text_kind": "source_excerpt", "text_characters": 395, "text_sha256": "90a082d32c5f645efc7d25ba2f6e15f4abbd18f93c026266ae1fe935e4271733", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:11.923754+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "SR", "alpha3": "SUR", "name_zh": "苏里南", "name_en": "Suriname"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "SR", "alpha3": "SUR", "name_zh": "苏里南", "name_en": "Suriname"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:11.961809+00:00", "published_at_raw": "2026-02-11T18:05:21", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "SR", "alpha3": "SUR", "name_zh": "苏里南", "name_en": "Suriname", "start": 35, "end": 43, "matched_text": "Suriname", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "SR", "alpha3": "SUR", "name_zh": "苏里南", "name_en": "Suriname", "start": 13, "end": 21, "matched_text": "Suriname", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_9b9684e6cde9b8482738", "record_id": "article_9b9684e6cde9b848", "canonical_url": "https://news.mongabay.com/2026/02/mapping-underground-fungal-networks-interview-with-spuns-toby-kiers", "publisher_url": "https://news.mongabay.com/2026/02/mapping-underground-fungal-networks-interview-with-spuns-toby-kiers", "title_original": "Mapping underground fungal networks: Interview with SPUN’s Toby Kiers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-11T10:16:46+00:00", "source_text": "All around her, scientists had their eyes set on studying flora and fauna that lived aboveground. But Toby Kiers’s interest always lay in the oft-overlooked biodiversity that existed beneath it. It was the mysterious nature of the vast mycorrhizal fungal networks that so fascinated Kiers. “It’s so alive, but humble and quiet,” Kiers, an evolutionary […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "6f4dd26be614e748e87e7809506f7532d05590b67b952ad2e82b278be2a8cabc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:12.196864+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:12.218340+00:00", "published_at_raw": "2026-02-11T10:16:46", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_7e5b21b9009db28c808d", "record_id": "article_7e5b21b9009db28c", "canonical_url": "https://www.carbonbrief.org/g7-falling-behind-china-as-worlds-wind-and-solar-plans-reach-new-high-in-2025", "publisher_url": "https://www.carbonbrief.org/g7-falling-behind-china-as-worlds-wind-and-solar-plans-reach-new-high-in-2025", "title_original": "G7 ‘falling behind’ China as world’s wind and solar plans reach new high in 2025", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-10T00:01:00+00:00", "source_text": "The G7 major economies “f[e]ll notably behind China and the rest of the world” in 2025 as the amount of wind and solar power being developed reached a new high, according to Global Energy Monitor (GEM). A new report from the analysts says that the amount of wind and large-scale solar capacity being built or planned around the world reached a record 4,900 gigawatts (GW) in 2025. This “pipeline” of projects has grown by 500GW (11%) since 2024, GEM says, with the increase “predominantly” coming from developing countries. China alone has a pipeline of more than 1,500GW, equivalent to that of the next six countries combined: Brazil (401GW); Australia (368GW); India (234GW); the US (226GW); Spain (165GW); and the Philippines (146GW).", "text_kind": "article_excerpt", "text_characters": 737, "text_sha256": "a7315709c7a22c972de7967c32dec702ca4abc54a9e14c32225c55f7f95c1695", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:48.156578+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "500GW", "start": 422, "end": 427, "evidence": " This “pipeline” of projects has grown by 500GW (11%) since 2024, GEM says, with the increase “predominantly” coming from developing countries.", "interpretation": "not_classified"}, {"value_text": "11%", "start": 429, "end": 432, "evidence": " This “pipeline” of projects has grown by 500GW (11%) since 2024, GEM says, with the increase “predominantly” coming from developing countries.", "interpretation": "not_classified"}, {"value_text": "1,500GW", "start": 564, "end": 571, "evidence": " China alone has a pipeline of more than 1,500GW, equivalent to that of the next six countries combined: Brazil (401GW); Australia (368GW); India (234GW); the US (226GW); Spain (165GW); and the Philippines (146GW).", "interpretation": "not_classified"}, {"value_text": "401GW", "start": 636, "end": 641, "evidence": " China alone has a pipeline of more than 1,500GW, equivalent to that of the next six countries combined: Brazil (401GW); Australia (368GW); India (234GW); the US (226GW); Spain (165GW); and the Philippines (146GW).", "interpretation": "not_classified"}, {"value_text": "368GW", "start": 655, "end": 660, "evidence": " China alone has a pipeline of more than 1,500GW, equivalent to that of the next six countries combined: Brazil (401GW); Australia (368GW); India (234GW); the US (226GW); Spain (165GW); and the Philippines (146GW).", "interpretation": "not_classified"}, {"value_text": "234GW", "start": 670, "end": 675, "evidence": " China alone has a pipeline of more than 1,500GW, equivalent to that of the next six countries combined: Brazil (401GW); Australia (368GW); India (234GW); the US (226GW); Spain (165GW); and the Philippines (146GW).", "interpretation": "not_classified"}, {"value_text": "226GW", "start": 686, "end": 691, "evidence": " China alone has a pipeline of more than 1,500GW, equivalent to that of the next six countries combined: Brazil (401GW); Australia (368GW); India (234GW); the US (226GW); Spain (165GW); and the Philippines (146GW).", "interpretation": "not_classified"}, {"value_text": "165GW", "start": 701, "end": 706, "evidence": " China alone has a pipeline of more than 1,500GW, equivalent to that of the next six countries combined: Brazil (401GW); Australia (368GW); India (234GW); the US (226GW); Spain (165GW); and the Philippines (146GW).", "interpretation": "not_classified"}, {"value_text": "146GW", "start": 730, "end": 735, "evidence": " China alone has a pipeline of more than 1,500GW, equivalent to that of the next six countries combined: Brazil (401GW); Australia (368GW); India (234GW); the US (226GW); Spain (165GW); and the Philippines (146GW).", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}, {"alpha2": "ES", "alpha3": "ESP", "name_zh": "西班牙", "name_en": "Spain"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 113, "end": 118, "evidence": "“f[e]ll notably behind China and the rest of the world” in 2025 as the amount of wind and solar power being developed reached a new high, according to Global Energy Monitor (GEM). A new report from the analysts says that the amount of "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN