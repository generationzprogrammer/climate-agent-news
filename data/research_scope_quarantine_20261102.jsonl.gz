{"text_id": "text_37937dbd947a65a56d96", "record_id": "article_37937dbd947a65a5", "canonical_url": "https://news.mongabay.com/2025/06/indonesia-halts-most-nickel-mining-in-raja-ampat-but-allows-one-controversial-permit", "publisher_url": "https://news.mongabay.com/2025/06/indonesia-halts-most-nickel-mining-in-raja-ampat-but-allows-one-controversial-permit", "title_original": "Indonesia halts most nickel mining in Raja Ampat, but allows one controversial permit", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-10T11:17:19+00:00", "source_text": "JAKARTA — The Indonesian government has revoked four out of five nickel mining permits in the Raja Ampat archipelago following a public outcry over mining in one of the world’s most biodiverse marine ecosystems. Environmental groups have welcomed the decision, but criticized the decision not to revoke the permit for the remaining concession in Raja […]", "text_kind": "source_excerpt", "text_characters": 354, "text_sha256": "725cbc394ebe5cfd393e25782e9e837b9d4bbc04a9be1a98eae01eb5009ee415", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:03.637422+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:03.665171+00:00", "published_at_raw": "2025-06-10T11:17:19", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 0, "end": 9, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_0b5f26fbc23a949affa9", "record_id": "article_0b5f26fbc23a949a", "canonical_url": "https://insideclimatenews.org/news/09062025/ocean-acidification-crosses-planetary-boundaries", "publisher_url": "https://insideclimatenews.org/news/09062025/ocean-acidification-crosses-planetary-boundaries", "title_original": "The World’s Oceans Are a ‘Ticking Time Bomb,’ Reaching Dangerous Acidification Levels Earlier Than Scientists Thought", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-10T00:07:22+00:00", "source_text": "A critical measure of the ocean’s health suggests that the world’s marine systems are in greater peril than scientists had previously realized and that parts of the ocean have already reached dangerous tipping points. A study, published Monday in the journal Global Change Biology, found that ocean acidification—the process in which the world’s oceans absorb […]", "text_kind": "source_excerpt", "text_characters": 363, "text_sha256": "269edd538deaa60a4c813da89170321d972508c70fad7fff30816bc30edb9170", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:42.052414+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_end