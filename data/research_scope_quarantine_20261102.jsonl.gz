{"text_id": "text_e593bba0dabd3300dcc5", "record_id": "article_e593bba0dabd3300", "canonical_url": "https://news.mongabay.com/2025/04/dugong-numbers-plummet-amid-seagrass-decline-in-thailands-andaman-sea", "publisher_url": "https://news.mongabay.com/2025/04/dugong-numbers-plummet-amid-seagrass-decline-in-thailands-andaman-sea", "title_original": "Dugong numbers plummet amid seagrass decline in Thailand’s Andaman Sea", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-10T09:04:43+00:00", "source_text": "Unprecedented numbers of emaciated dugongs have washed up dead along Thailand’s Andaman Sea coast over the past three years, prompting marine scientists to urgently investigate what’s driving their decline. Thailand’s Department of Marine and Coastal Resources (DMCR) recorded an average 42 dugong (Dugong dugon) fatalities in 2023 and 2024 — more than double the annual […]", "text_kind": "source_excerpt", "text_characters": 374, "text_sha256": "5d39ac0862835229dc7b40d28c5ad17e781edd2a96c89b7c86fa053aa4813932", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:36.319976+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:36.349429+00:00", "published_at_raw": "2025-04-10T09:04:43", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand", "start": 48, "end": 56, "matched_text": "Thailand", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand", "start": 69, "end": 77, "matched_text": "Thailand", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_5e12b4cfb38dbb966b79", "record_id": "article_5e12b4cfb38dbb96", "canonical_url": "https://insideclimatenews.org/news/10042025/alabama-spotted-salamander-private-university-development", "publisher_url": "https://insideclimatenews.org/news/10042025/alabama-spotted-salamander-private-university-development", "title_original": "In Alabama, a Fight for the Spotted Salamander", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-10T09:00:00+00:00", "source_text": "HOMEWOOD, Ala.—Ellen McLaughlin said she wasn’t speaking for herself. “I speak for the salamanders,” she told those gathered at a community meeting in late March. McLaughlin, a retired Samford University biology professor, was one of dozens who showed up at the Homewood Senior Center to express their frustration over a proposed “town square” development that […]", "text_kind": "source_excerpt", "text_characters": 364, "text_sha256": "f09f96635cdbc86a4469ae2535418037d86331ae9a7b9ef7f7cdc2e373ba68ca", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:22.215803+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 321, "end": 329, "evidence": "of dozens who showed up at the Homewood Senior Center to express their frustration over a proposed “town square” development that […]"}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:22.236133+00:00", "published_at_raw": "2025-04-10T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_ae1209e97cba9504b55a", "record_id": "article_ae1209e97cba9504", "canonical_url": "https://news.mongabay.com/2025/04/after-decade-of-delays-pressure-mounts-on-indonesia-to-pass-indigenous-rights-bill", "publisher_url": "https://news.mongabay.com/2025/04/after-decade-of-delays-pressure-mounts-on-indonesia-to-pass-indigenous-rights-bill", "title_original": "After decade of delays, pressure mounts on Indonesia to pass Indigenous rights bill", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-09T08:15:28+00:00", "source_text": "JAKARTA — Rights activists have lambasted Indonesia’s parliament for delaying yet again a long-awaited Indigenous rights bill — stuck in limbo for more than a decade — even as communities continue to lose millions of hectares of land and face criminalization for defending their ancestral territories. The bill is widely seen as a crucial step […]", "text_kind": "source_excerpt", "text_characters": 347, "text_sha256": "c47f47f652c2af7b682687dc59f34551e14303ffa56d46d0ca91d24c8e3dd354", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:36.532144+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 103, "end": 113, "evidence": "hts activists have lambasted Indonesia