{"text_id": "text_936ec424b7007571da45", "record_id": "article_936ec424b7007571", "canonical_url": "https://insideclimatenews.org/news/02102024/chile-killer-whales-prey-on-dolphins", "publisher_url": "https://insideclimatenews.org/news/02102024/chile-killer-whales-prey-on-dolphins", "title_original": "Killer Whales in Chile Have Begun Preying on Dolphins. What Does It Mean?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-02T08:55:00+00:00", "source_text": "In six years studying orcas off Chile’s coast, marine biologist Ana García-Cegarra had never witnessed anything like what she saw in May 2023. In the vast Pacific waters near Antofagasta, a killer whale hurled a small dusky dolphin into the air before devouring it. Moments later, four more orcas arrived to join the feast. “Such […]", "text_kind": "source_excerpt", "text_characters": 333, "text_sha256": "da76c5bf400039a0c911a4f28a889dd82a88e98fa52136572610d9432e6d97a4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:53.990624+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:54.007673+00:00", "published_at_raw": "2024-10-02T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile", "start": 17, "end": 22, "matched_text": "Chile", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile", "start": 32, "end": 37, "matched_text": "Chile", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_f72c4ef4a24ba6a29906", "record_id": "article_f72c4ef4a24ba6a2", "canonical_url": "https://insideclimatenews.org/news/01102024/hurricane-helene-lays-bare-the-growing-threat-of-inland-flooding", "publisher_url": "https://insideclimatenews.org/news/01102024/hurricane-helene-lays-bare-the-growing-threat-of-inland-flooding", "title_original": "Hurricane Helene Lays Bare the Growing Threat of Inland Flooding", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-01T20:20:25+00:00", "source_text": "Six months ago, Craig Colten moved from Baton Rouge, Louisiana, to Asheville, North Carolina—a historic city tucked in the Blue Ridge Mountains. He’d fallen in love with the region over the summers while in college and was eager to evade the near-constant threat of hurricanes that loomed over his life in Louisiana. “​​I moved up […]", "text_kind": "source_excerpt", "text_characters": 334, "text_sha256": "ee77572831b16de0b37aebec7f621dd43cfc05f70a36cc10ca1bc21c02ec93fa", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:54.047925+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:54.061186+00:00", "published_at_raw": "2024-10-01T20:20:25", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_c3bed862800a93d4007b", "record_id": "article_c3bed862800a93d4", "canonical_url": "https://yaleclimateconnections.org/2024/09/a-still-toasty-atlantic-is-bristling-with-tropical-cyclones", "publisher_url": "https://yaleclimateconnections.org/2024/09/a-still-toasty-atlantic-is-bristling-with-tropical-cyclones", "title_original": "A still-toasty Atlantic is bristling with tropical cyclones", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-09-30T17:12:16+00:00", "source_text": "Since Thursday, Helene and Isaac have departed, Joyce and Kirk have arrived, and two other systems may rear their heads, including one in the western Caribbean.", "text_kind": "source_excerpt", "text_characters": 160, "text_sha256": "5bbb9f2417c20647eb59adaa1dfd15b7a009f5666c01564b970c0eb5115ad819", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:13.624776+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:13.645865+00:00", "published_at_raw": "2024-09-30T17:12:16", "sample_frame": "public_archives_20261102", "sampling_method": "det