{"text_id": "text_723571d8cd5d1ef96f57", "record_id": "article_723571d8cd5d1ef9", "canonical_url": "https://news.mongabay.com/2024/08/35m-debt-for-nature-deal-aims-to-protect-indonesias-coral-reefs", "publisher_url": "https://news.mongabay.com/2024/08/35m-debt-for-nature-deal-aims-to-protect-indonesias-coral-reefs", "title_original": "$35m debt-for-nature deal aims to protect Indonesia’s coral reefs", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-30T16:51:44+00:00", "source_text": "JAKARTA — A milestone debt-for-nature agreement to conserve coral reefs in Indonesia, the world’s largest archipelagic country, has drawn a mix of optimism and skepticism from environmentalists. While welcoming the flush of funding and attention to the country’s imperiled reef ecosystems, some warn that to be successful, the agreement must reshape the way reef conservation […]", "text_kind": "source_excerpt", "text_characters": 379, "text_sha256": "9bfe89ae061617b416e8a0b9e68c50b028d106a045009a488a62df8d6f78375c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:33.380714+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 224, "end": 231, "evidence": "awn a mix of optimism and skepticism from environmentalists. While welcoming the flush of funding and attention to the country’s imperiled reef ecosystems, some warn that to be successful, the agreement must reshape the way reef conserva"}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:33.400416+00:00", "published_at_raw": "2024-08-30T16:51:44", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 42, "end": 51, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 75, "end": 84, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_2f0a87e1d0332f1ccdc6", "record_id": "article_2f0a87e1d0332f1c", "canonical_url": "https://news.mongabay.com/2024/08/government-inaction-leaves-nepal-without-strategy-to-tackle-invasive-species", "publisher_url": "https://news.mongabay.com/2024/08/government-inaction-leaves-nepal-without-strategy-to-tackle-invasive-species", "title_original": "Government inaction leaves Nepal without strategy to tackle invasive species", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-29T13:59:44+00:00", "source_text": "KATHMANDU — Nepal ranks as one of the countries most vulnerable to invasive species, yet still hasn’t finalized a management strategy to address the issue. A draft of the strategy, considered vital for the country to tackle the growing threat of invasive plant and animal species and meet its international obligations, was prepared seven years […]", "text_kind": "source_excerpt", "text_characters": 348, "text_sha256": "81f5dceeac4b896cc1024a9bb57f1a959a6c1e57d3e7dbaab64bd0bc0d77c1a5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:33.594703+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "annotation_