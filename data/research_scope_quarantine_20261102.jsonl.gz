{"text_id": "text_8861193ec7698d60cbad", "record_id": "article_8861193ec7698d60", "canonical_url": "https://insideclimatenews.org/news/31122025/idaho-valley-fire-torched-lucky-peak-bird-research-station", "publisher_url": "https://insideclimatenews.org/news/31122025/idaho-valley-fire-torched-lucky-peak-bird-research-station", "title_original": "An Idaho Bird Research Station Rises From the Ashes of a Wildfire", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-31T10:00:00+00:00", "source_text": "BOISE, Idaho—Ping. The sound that wrenched Lucian Davis awake was a phone notification from the wildfire-tracking app Watch Duty. There was a fire just a few miles downslope from the tent where he had been sleeping. Davis was the lead bander at the Lucky Peak station, a research site run by Boise State University’s Intermountain […]", "text_kind": "source_excerpt", "text_characters": 334, "text_sha256": "991d4e3d1524bd5b7f25364193259f3fd61f86b3205d9cecdc54ca3249bd8970", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:18.906337+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 96, "end": 104, "evidence": " Idaho—Ping. The sound that wrenched Lucian Davis awake was a phone notification from the wildfire-tracking app Watch Duty. There was a fire just a few 