{"text_id": "text_bd6dcda390497dd7f046", "record_id": "article_bd6dcda390497dd7", "canonical_url": "https://yaleclimateconnections.org/2026/04/category-4-typhoon-sinlaku-powers-through-the-u-s-northern-mariana-islands", "publisher_url": "https://yaleclimateconnections.org/2026/04/category-4-typhoon-sinlaku-powers-through-the-u-s-northern-mariana-islands", "title_original": "Category 4 Typhoon Sinlaku powers through the U.S. Northern Mariana Islands", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-14T16:55:02+00:00", "source_text": "Sinlaku is the 10th Category 4 or 5 tropical cyclone to hit a U.S. state or territory in the past 10 years — as many Cat 4 and Cat 5 landfalls as the U.S. suffered in the prior 57 years.", "text_kind": "source_excerpt", "text_characters": 186, "text_sha256": "513c04f22e9d71d73983a2488088adfde9aa3cf95543eae435bb0645d059393b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:11.849124+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MP", "alpha3": "MNP", "name_zh": "北马里亚纳群岛", "name_en": "Northern Mariana Islands"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:11.856853+00:00", "published_at_raw": "2026-04-14T16:55:02", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 46, "end": 50, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "MP", "alpha3": "MNP", "name_zh": "北马里亚纳群岛", "name_en": "Northern Mariana Islands", "start": 51, "end": 75, "matched_text": "Northern Mariana Islands", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 62, "end": 66, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_6aea314333377a8ba032", "record_id": "article_6aea314333377a8b", "canonical_url": "https://dialogue.earth/en/ocean/giant-water-park-plans-enflame-tourism-tensions-in-mexico", "publisher_url": "https://dialogue.earth/en/ocean/giant-water-park-plans-enflame-tourism-tensions-in-mexico", "title_original": "Giant water park plans enflame tourism tensions in Mexico", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-14T16:09:11+00:00", "source_text": "Mahahual, on the southern end of Quintana Roo state in south-east Mexico, has just 2,800 inhabitants. But each year more than a million tourists flock to what travel agents sell as one of the last remaining unspoiled paradises in the Caribbean. Editor’s note: Mexican authorities announced on 19 May that the Perfect Day water park would not be approved. Some residents now fear that “unspoiled” status is in jeopardy. The all-inclusive cruise company Royal Caribbean has unveiled plans to develop a huge water park in Mahahual, named Perfect Day Mexico. It could attract millions more visitors to the town. Mahahual’s corals are a key part of the second largest barrier reef in the world, the Mesoamerican Reef .", "text_kind": "article_excerpt", "text_characters": 713, "text_sha256": "f0032d24d24fe8b9583d6483927026da3104e10f4343417d86c5c509618220f4", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:44.117770+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "adopted", "label_zh": "通过", "label_en": "Adopted", "start": 345, "end": 353, "evidence": "ote: Mexican authorities announced on 19 May that the Perfect Day water park would not be approved. Some residents now fear that “unspoiled” status is in jeopardy. The all-inclusive cruise company Royal Caribbean has unveiled plans to dev"}], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:44.134827+00:00", "published_at_raw": "2026-04-14T16:09:11", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 51, "end": 57, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 66, "end": 72, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_6f14316c889b30f4f47f", "record_id": "article_6f14316c889b30f4", "canonical_url": "https://insideclimatenews.org/news/14042026/trump-epa-chemical-safety-rollback", "publisher_url": "https://insideclimatenews.org/news/14042026/trump-epa-chemical-safety-rollback", "title_original": "Chemical Threats Nearby? Trump’s EPA Doesn’t Want You to Know.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-14T09:00:00+00:00", "source_text": "Raschelle Grandison had just walked out her front door to grab something from her car on a chilly March morning in 2019 when she stopped dead in her tracks. Grandison stared in disbelief at what looked like a nuclear mushroom cloud approaching the Houston home she shared with her mother, who ran outside to see […]", "text_kind": "source_excerpt", "text_characters": 315, "text_sha256": "20064a12b020906fd3c5aa2b997ebcdad31c9db77147ad6b6fe24458a5b6cc49", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:03.039385+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:03.081766+00:00", "published_at_raw": "2026-04-14T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_cee2d5457a4289f70b6b", "record_id": "article_cee2d5457a4289f7", "canonical_url": "https://news.mongabay.com/2026/04/can-nature-outcompete-war-in-eastern-congo", "publisher_url": "https://news.mongabay.com/2026/04/can-nature-outcompete-war-in-eastern-congo", "title_original": "Can nature outcompete war in Eastern Congo?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-13T23:26:11+00:00", "source_text": "In eastern Democratic Republic of the Congo, discussion of conservation often centers on loss: forests cleared, wildlife depleted, conflict spreading across landscapes that once supported some of the richest ecosystems on Earth. At Virunga National Park, those pressures are concentrated. The park, Africa’s oldest, contains glaciers, volcanoes, forests, and wetlands within a single protected area. […]", "text_kind": "source_excerpt", "text_characters": 403, "text_sha256": "3479ca1e5973c520eb389e02d13ec77393d82dd0b7054ccd114ae29139af9abc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:23.135653+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:23.160669+00:00", "published_at_raw": "2026-04-13T23:26:11", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)", "start": 11, "end": 43, "matched_text": "Democratic Republic of the Congo", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_6d67f7be0f4adf2ef2de", "record_id": "article_6d67f7be0f4adf2e", "canonical_url": "https://yaleclimateconnections.org/2026/04/cat-5-super-typhoon-sinlaku-the-2nd-strongest-typhoon-so-early-in-the-year", "publisher_url": "https://yaleclimateconnections.org/2026/04/cat-5-super-typhoon-sinlaku-the-2nd-strongest-typhoon-so-early-in-the-year", "title_original": "Cat 5 Super Typhoon Sinlaku the 2nd-strongest typhoon so early in the year", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-13T01:33:53+00:00", "source_text": "Tropical Cyclone Sinlaku put on a spectacular display of rapid intensification over the warm Pacific waters southeast of Guam early Sunday, becoming the world’s second Category 5 tropical cyclone of 2026 at 11 a.m. EDT April 12, with 175 mph (280 km/h) winds, as rated by the Joint Typhoon Warning Center (JTWC). Sinlaku will pose an extremely dangerous threat to the U.S. Northern Mariana Islands on Monday and Tuesday. Sinlaku likely peaked at 5 p.m. EDT Sunday, with 180 mph (285 km/hr) winds.", "text_kind": "article_excerpt", "text_characters": 496, "text_sha256": "2188857c83bead7c480a413f1b991e4fa47d38b303bbe727a81e30293d61fa3e", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:18.278268+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MP", "alpha3": "MNP", "name_zh": "北马里亚纳群岛", "name_en": "Northern Mariana Islands"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "GU", "alpha3": "GUM", "name_zh": "关岛", "name_en": "Guam"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MP", "alpha3": "MNP", "name_zh": "北马里亚纳群岛", "name_en": "Northern Mariana Islands"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "GU", "alpha3": "GUM", "name_zh": "关岛", "name_en": "Guam"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:18.294276+00:00", "published_at_raw": "2026-04-13T01:33:53", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GU", "alpha3": "GUM", "name_zh": "关岛", "name_en": "Guam", "start": 121, "end": 125, "matched_text": "Guam", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 368, "end": 372, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "MP", "alpha3": "MNP", "name_zh": "北马里亚纳群岛", "name_en": "Northern Mariana Islands", "start": 373, "end": 397, "matched_text": "Northern Mariana Islands", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_030ee8714b33626e23b0", "record_id": "article_030ee8714b33626e", "canonical_url": "https://insideclimatenews.org/news/12042026/cancer-rates-higher-near-livestock-operations-study-finds", "publisher_url": "https://insideclimatenews.org/news/12042026/cancer-rates-higher-near-livestock-operations-study-finds", "title_original": "Cancer Rates Are Higher Near Large Livestock Feeding Operations in 3 States, a New Study Finds", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-12T08:55:00+00:00", "source_text": "People in three states living near large livestock feeding operations experience higher rates of cancer, a new analysis found. The study, published in the Environmental Research journal, focused on California, Iowa and Texas because of the availability of cancer incidence data, the number of feeding operations in those states and the variety of animals on […]", "text_kind": "source_excerpt", "text_characters": 361, "text_sha256": "8ea6a37ac4e3cbf3ca56e3703855cb912189ba142386a60e3e7632eb779fff6d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:03.693296+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:03.717865+00:00", "published_at_raw": "2026-04-12T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 198, "end": 208, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_7abf16006cbb42854b80", "record_id": "article_7abf16006cbb4285", "canonical_url": "https://insideclimatenews.org/news/10042026/maryland-senate-utility-accountability-bills", "publisher_url": "https://insideclimatenews.org/news/10042026/maryland-senate-utility-accountability-bills", "title_original": "Utility Accountability Bills Divide Maryland’s Democratic Leadership", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-10T09:00:00+00:00", "source_text": "In its most recent energy affordability legislation, the Maryland Senate has reversed key utility accountability proposals passed by the state House and added new ways for utility companies to earn profit, including by reviving a billion-dollar gas subsidy that requires all ratepayers to cover the cost of running new gas pipelines to housing developments. The […]", "text_kind": "source_excerpt", "text_characters": 365, "text_sha256": "9c2192e8da3fe5d5b364f01fbd5571c882a6dc5ce8ba004e1817241b323e5079", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:04.681614+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 19, "end": 25, "evidence": "In its most recent energy affordability legislation, the Maryland Senate has reversed key utility accountability proposals passed by the state House and added new wa"}], "policy_tools": [{"id": "subsidy", "label_zh": "补贴与激励", "label_en": "Subsidies and incentives", "start": 249, "end": 255, "evidence": "new ways for utility companies to earn profit, including by reviving a billion-dollar gas subsidy that requires all ratepayers to cover the cost of running new gas pipelines to housing developments. The […]"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:04.735049+00:00", "published_at_raw": "2026-04-10T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_69674990584f2b8c6352", "record_id": "article_69674990584f2b8c", "canonical_url": "https://insideclimatenews.org/news/09042026/severe-exposure-to-forever-chemicals-during-pregnancy-could-lead-to-childhood-asthma", "publisher_url": "https://insideclimatenews.org/news/09042026/severe-exposure-to-forever-chemicals-during-pregnancy-could-lead-to-childhood-asthma", "title_original": "Severe Exposure to ‘Forever Chemicals’ During Pregnancy Could Lead to Childhood Asthma", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-09T18:21:12+00:00", "source_text": "Exposure to “forever chemicals” during pregnancy could increase the risk of childhood asthma, according to new research from Sweden. Researchers from Lund University found that prenatal exposure to very high levels of per- and polyfluoroalkyl substances, known as PFAS, in drinking water corresponded with a higher incidence of childhood asthma in a community dealing with […]", "text_kind": "source_excerpt", "text_characters": 376, "text_sha256": "7f9c24609a5129a698451082787fd440fa1284c9c73ccb7a1ffb21a97e21b73b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:05.044656+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "SE", "alpha3": "SWE", "name_zh": "瑞典", "name_en": "Sweden"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "SE", "alpha3": "SWE", "name_zh": "瑞典", "name_en": "Sweden"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:05.083484+00:00", "published_at_raw": "2026-04-09T18:21:12", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "SE", "alpha3": "SWE", "name_zh": "瑞典", "name_en": "Sweden", "start": 125, "end": 131, "matched_text": "Sweden", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_4429af2d603003313d0c", "record_id": "article_4429af2d60300331", "canonical_url": "https://yaleclimateconnections.org/2026/04/forecasters-predict-a-slightly-below-average-2026-atlantic-hurricane-season", "publisher_url": "https://yaleclimateconnections.org/2026/04/forecasters-predict-a-slightly-below-average-2026-atlantic-hurricane-season", "title_original": "Forecasters predict a slightly below-average 2026 Atlantic hurricane season", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-09T15:42:27+00:00", "source_text": "Colorado State University’s hurricane forecasting team is expecting El Niño to bring a slightly below-average season with 13 named storms, six hurricanes, and two major hurricanes.", "text_kind": "source_excerpt", "text_characters": 180, "text_sha256": "427a1f039aadfcd734d7268a2af0d1481766fcbb1a9e74841ff96e82fc516461", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:18.396648+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:18.408240+00:00", "published_at_raw": "2026-04-09T15:42:27", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_9493ea992ebc8cff3bc0", "record_id": "article_9493ea992ebc8cff", "canonical_url": "https://news.mongabay.com/2026/04/in-indonesia-a-coastal-vine-used-as-medicine-now-signals-ecological-decline", "publisher_url": "https://news.mongabay.com/2026/04/in-indonesia-a-coastal-vine-used-as-medicine-now-signals-ecological-decline", "title_original": "In Indonesia, a coastal vine used as medicine now signals ecological decline", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-09T11:34:10+00:00", "source_text": "SUMALATA, Indonesia — Following encounters while diving, Gusnar Ismail has long turned to the morning glory plants growing on sandbanks here on the north of Indonesia’s Sulawesi Island. “When I get stung or stabbed by an animal in the sea, I’ll go straight away to look for batata to use as medicine,” Gusnar told Mongabay […]", "text_kind": "source_excerpt", "text_characters": 326, "text_sha256": "c559224caa205b5fbbbdc1371fcfbc102e4c90d07460f9024895ee18362cb427", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:23.560854+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:23.583939+00:00", "published_at_raw": "2026-04-09T11:34:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 3, "end": 12, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 10, "end": 19, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_79bc66c3903e5e2fd3fe", "record_id": "article_79bc66c3903e5e2f", "canonical_url": "https://www.carbonbrief.org/iran-war-analysis-how-60-nations-have-responded-to-the-global-energy-crisis", "publisher_url": "https://www.carbonbrief.org/iran-war-analysis-how-60-nations-have-responded-to-the-global-energy-crisis", "title_original": "Iran war analysis: How 60 nations have responded to the global energy crisis", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-08T14:55:37+00:00", "source_text": "Print article Share One month into the US and Israel’s war on Iran, at least 60 countries have taken emergency measures in response to the subsequent global energy crisis , according to analysis by Carbon Brief. So far, these countries have announced nearly 200 policies to save fuel, support consumers and boost domestic energy supplies. Carbon Brief has drawn on tracking by the International Energy Agency (IEA) and other sources to assess the global policy response, just as a temporary ceasefire is declared. Since the start of the war in late February, both sides have bombed vital energy infrastructure across the region as Iran has blocked the Strait of Hormuz – a key waterway through which around a fifth of global oil and liquified natural gas (LNG) trade passes.", "text_kind": "article_excerpt", "text_characters": 774, "text_sha256": "f36445b04ee417be1f6e37788f50f7df2d79cc90fc532cfca56de8337913cb43", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:39.597976+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}, {"alpha2": "IL", "alpha3": "ISR", "name_zh": "以色列", "name_en": "Israel"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 157, "end": 163, "evidence": " at least 60 countries have taken emergency measures in response to the subsequent global energy crisis , according to analysis by Carbon Brief. So far, these countries have announced nearly 200 policies to save fuel, support consumers "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}, {"alpha2": "IL", "alpha3": "ISR", "name_zh": "以色列", "name_en": "Israel"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:39.619242+00:00", "published_at_raw": "2026-04-08T14:55:37", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran", "start": 0, "end": 4, "matched_text": "Iran", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 39, "end": 41, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "IL", "alpha3": "ISR", "name_zh": "以色列", "name_en": "Israel", "start": 46, "end": 52, "matched_text": "Israel", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran", "start": 62, "end": 66, "matched_text": "Iran", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_d6fca74be345c1798051", "record_id": "article_d6fca74be345c179", "canonical_url": "https://news.mongabay.com/2026/04/a-french-city-cut-its-marine-pollution-and-its-seagrass-bounced-back", "publisher_url": "https://news.mongabay.com/2026/04/a-french-city-cut-its-marine-pollution-and-its-seagrass-bounced-back", "title_original": "A French city cut its marine pollution — and its seagrass bounced back", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-07T19:53:26+00:00", "source_text": "Neptune grass is generally regarded as the most ecologically important seagrass and shallow-water habitat in the Mediterranean Sea. It suffered a severe decline during the 20th century, and there have been myriad efforts to actively restore it via replanting schemes. A new study points to the merits of a different approach: Remove the human-caused drivers […]", "text_kind": "source_excerpt", "text_characters": 361, "text_sha256": "b9cd6b60f44107d926b9a79387cc6242cd7d4cfbbb67f72fe97a8c19aa019cea", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:29.492336+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:29.513138+00:00", "published_at_raw": "2026-04-07T19:53:26", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_6850a044c9d99c0339e7", "record_id": "article_6850a044c9d99c03", "canonical_url": "https://news.mongabay.com/2026/04/latin-americas-largest-hospital-complex-cancels-plan-to-buy-shark-meat", "publisher_url": "https://news.mongabay.com/2026/04/latin-americas-largest-hospital-complex-cancels-plan-to-buy-shark-meat", "title_original": "Latin America’s largest hospital complex cancels plan to buy shark meat", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-07T14:59:19+00:00", "source_text": "The University of São Paulo Medical School Hospital said it would cancel a plan to buy more than 17 metric tons of shark meat as part of a 2026 procurement, citing concerns over heavy metals. HCFMUSP is the largest public hospital complex in Latin America. It consists of at least eight institutes in São Paulo, […]", "text_kind": "source_excerpt", "text_characters": 315, "text_sha256": "9f1dbb1bbdc6943b246e3195c85dc0327ace1a9a41d7a70683d1f2376d66031c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:29.608821+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:29.648108+00:00", "published_at_raw": "2026-04-07T14:59:19", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_93e28246a557605c790a", "record_id": "article_93e28246a557605c", "canonical_url": "https://news.mongabay.com/2026/04/how-saving-birds-protects-the-planet-interview-with-author-scott-weidensaul", "publisher_url": "https://news.mongabay.com/2026/04/how-saving-birds-protects-the-planet-interview-with-author-scott-weidensaul", "title_original": "How saving birds protects the planet: Interview with author Scott Weidensaul", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-07T14:55:50+00:00", "source_text": "Best-selling author Scott Weidensaul’s new book is a celebration of species recovery efforts led by scientists, conservationists, and Indigenous communities around the world, beginning with the successful rebound of the American oystercatcher (Haematopus palliatus), a large and charismatic shorebird which had been declining for decades, until people made a plan and the birds responded. But […]", "text_kind": "source_excerpt", "text_characters": 396, "text_sha256": "278be1fc9e9fbf5b24aa850990d7eb6457cd6af72d1c7be0b6fde5aaca0b704e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:29.664415+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 134, "end": 144, "evidence": "ook is a celebration of species recovery efforts led by scientists, conservationists, and Indigenous communities around the world, beginning with the successful rebound of the American oystercatcher (Haematopus palliatus), a large and chari"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:29.701942+00:00", "published_at_raw": "2026-04-07T14:55:50", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_8de6d5b9405e49986671", "record_id": "article_8de6d5b9405e4998", "canonical_url": "https://news.mongabay.com/2026/04/why-conservation-needs-stories-of-progress", "publisher_url": "https://news.mongabay.com/2026/04/why-conservation-needs-stories-of-progress", "title_original": "Why conservation needs stories of progress", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-07T14:35:59+00:00", "source_text": "I’m writing this from deep in the Congo rainforest after a day spent observing elephants and gorillas. The presence of such magnificent creatures is both invigorating and a reminder of how much still endures. Yet the pressures are visible, too. Logging roads push deeper each year. Poaching still threatens wildlife that once seemed unassailable. Industrial […]", "text_kind": "source_excerpt", "text_characters": 361, "text_sha256": "a5c25c8eb116c7bd5f1cc446c73523f0daf53f6e18afafddc47a89658f497b62", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:29.761493+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:29.794321+00:00", "published_at_raw": "2026-04-07T14:35:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_ccd27188c422fccbda87", "record_id": "article_ccd27188c422fccb", "canonical_url": "https://dialogue.earth/en/energy/qa-if-you-are-in-the-business-of-peace-you-must-talk-to-those-who-are-at-war", "publisher_url": "https://dialogue.earth/en/energy/qa-if-you-are-in-the-business-of-peace-you-must-talk-to-those-who-are-at-war", "title_original": "Q&A: ‘If you are in the business of peace, you must talk to those who are at war’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-07T11:07:03+00:00", "source_text": "Rafael Grossi has spent the past six years at the centre of the world’s most dangerous nuclear standoffs – and now he wants the world’s most demanding diplomatic job. The 65-year-old Argentine has led the International Atomic Energy Agency (IAEA), the UN’s nuclear watchdog, since 2019. In that time, he has navigated the decline of the Iran nuclear deal, negotiated ceasefires between Russia and Ukraine, and has found himself at the centre of a war that is redrawing the politics of nuclear risk, energy and global trade. This has led to threats from Iranian officials and Austrian intelligence has provided him with round-the-clock protection. He has pressed on regardless, maintaining inspectors inside Iran and contact with all sides.", "text_kind": "article_excerpt", "text_characters": 739, "text_sha256": "c19a726c1dfc0af5bc42b3889e151ef97eea19d017ff530098472629e302e2f6", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:44.535401+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "RU", "alpha3": "RUS", "name_zh": "俄罗斯", "name_en": "Russia"}, {"alpha2": "UA", "alpha3": "UKR", "name_zh": "乌克兰", "name_en": "Ukraine"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 226, "end": 232, "evidence": "most demanding diplomatic job. The 65-year-old Argentine has led the International Atomic Energy Agency (IAEA), the UN’s nuclear watchdog, since 2019. In that time, he has navigated the decline of the Iran nuclear deal, negotiated cease"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "RU", "alpha3": "RUS", "name_zh": "俄罗斯", "name_en": "Russia"}, {"alpha2": "UA", "alpha3": "UKR", "name_zh": "乌克兰", "name_en": "Ukraine"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:44.589513+00:00", "published_at_raw": "2026-04-07T11:07:03", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran", "start": 337, "end": 341, "matched_text": "Iran", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "RU", "alpha3": "RUS", "name_zh": "俄罗斯", "name_en": "Russia", "start": 386, "end": 392, "matched_text": "Russia", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "UA", "alpha3": "UKR", "name_zh": "乌克兰", "name_en": "Ukraine", "start": 397, "end": 404, "matched_text": "Ukraine", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_8954d3c3d293093d9b48", "record_id": "article_8954d3c3d293093d", "canonical_url": "https://news.mongabay.com/2026/04/is-the-galapagos-damselfish-extinct", "publisher_url": "https://news.mongabay.com/2026/04/is-the-galapagos-damselfish-extinct", "title_original": "Is the Galápagos damselfish extinct?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-07T01:06:25+00:00", "source_text": "A small, blue-gray fish that once gathered in loose schools along the rocky shores of the Galápagos Islands has become the subject of a more precise question: whether it is already gone. The Galápagos damselfish (Azurina eupalama) has not been recorded since 1983. Before that, it was regularly encountered. Specimens were collected by nearly […]", "text_kind": "source_excerpt", "text_characters": 346, "text_sha256": "c8c86af552a9e42052a7c12cd9c2f98d646cc2e95a0c0c9ab7b0bb726c26bb3f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:29.927360+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:29.956128+00:00", "published_at_raw": "2026-04-07T01:06:25", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_ea7988aadcf5aec6e5bc", "record_id": "article_ea7988aadcf5aec6", "canonical_url": "https://dialogue.earth/en/nature/the-fight-to-save-indias-ancient-aravallis-from-rampant-mining", "publisher_url": "https://dialogue.earth/en/nature/the-fight-to-save-indias-ancient-aravallis-from-rampant-mining", "title_original": "The fight to save India’s ancient Aravallis from rampant mining", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-04T12:42:16+00:00", "source_text": "Over two billion years old, the Aravalli mountain range in north-western India feels like an oasis running through Rajasthan’s hot, arid landscape. Its rolling hills, biodiverse forests and water bodies form a massive green wall protecting the rest of the country from the heat and dust that rises from the Thar Desert on the western edge of the state. Yet despite its ecological significance, commercial mining has been degrading the Aravallis. At least 29,209 instances of illegal mining were reported between 2018 and 2023 in Aravalli districts. Mining pressure linked to urban expansion continues to reshape the landscape.", "text_kind": "article_excerpt", "text_characters": 626, "text_sha256": "fbb6f522b494eabad09d9841a1523811cb3f476a8a35f7fc99c79f0f19897d4b", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:44.617526+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:44.650704+00:00", "published_at_raw": "2026-04-04T12:42:16", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 18, "end": 23, "matched_text": "India", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 73, "end": 78, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_9600cf5cd087ce4fd7d2", "record_id": "article_9600cf5cd087ce4f", "canonical_url": "https://insideclimatenews.org/news/03042026/craig-watts-fights-poultry-farming-system", "publisher_url": "https://insideclimatenews.org/news/03042026/craig-watts-fights-poultry-farming-system", "title_original": "Critics Call the Poultry Farming System Rigged. Craig Watts Is Fighting to Overturn It.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-03T09:00:00+00:00", "source_text": "FAIRMONT, N.C.—Craig Watts unlocked a small room made of plywood, flipped on the lights and tapped the photos he had taped to the fuse box. Tap, tap, tap. One for every child. Watts, a contract farmer for the poultry giant Perdue Farms, swung open a second door to the barn, where a deafening choir of […]", "text_kind": "source_excerpt", "text_characters": 305, "text_sha256": "aa219f84ed398efd70c49139c88d7797c1a7ec12142bf1a9ec2a8ce68a2a9dab", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:08.601410+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:08.658125+00:00", "published_at_raw": "2026-04-03T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_0708684e58027ecdd98d", "record_id": "article_0708684e58027ecd", "canonical_url": "https://news.mongabay.com/2026/04/indonesias-deforestation-surges-66-in-2025-reversing-years-of-decline", "publisher_url": "https://news.mongabay.com/2026/04/indonesias-deforestation-surges-66-in-2025-reversing-years-of-decline", "title_original": "Indonesia’s deforestation surges 66% in 2025, reversing years of decline", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-03T03:50:22+00:00", "source_text": "JAKARTA — Indonesia’s deforestation surged in 2025, rising 66% from the previous year, marking a sharp reversal after several years of decline, according to new data from the NGO Auriga Nusantara. Based on satellite analysis, Auriga estimates that 433,751 hectares (1.1 million acres) of forest, an area more than twice the size of London, were […]", "text_kind": "source_excerpt", "text_characters": 348, "text_sha256": "e5c7d7288c7395d0196dcb323af79001c24a2784baa3f9eb7cd55527c49f4ede", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:30.264456+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "66%", "start": 59, "end": 62, "evidence": "JAKARTA — Indonesia’s deforestation surged in 2025, rising 66% from the previous year, marking a sharp reversal after several years of decline, according to new data from the NGO Auriga Nusantara.", "interpretation": "not_classified"}, {"value_text": "1.1 million", "start": 266, "end": 277, "evidence": " Based on satellite analysis, Auriga estimates that 433,751 hectares (1.1 million acres) of forest, an area more than twice the size of London, were […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:30.288290+00:00", "published_at_raw": "2026-04-03T03:50:22", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 0, "end": 9, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 10, "end": 19, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_e270436c741cd079c74f", "record_id": "article_e270436c741cd079", "canonical_url": "https://news.mongabay.com/2026/04/green-and-gray-mangroves-and-dikes-show-potential-in-protecting-shorelines-together", "publisher_url": "https://news.mongabay.com/2026/04/green-and-gray-mangroves-and-dikes-show-potential-in-protecting-shorelines-together", "title_original": "Green and gray: Mangroves and dikes show potential in protecting shorelines together", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-02T20:25:33+00:00", "source_text": "With their dense mats of submerged roots, mangrove forests hold down shorelines worldwide like a coastal Swiss Army knife. They’re a nursery for juvenile fish and a home for important species in and out of the water. They’re also a filtration system for pollution, a holdfast against erosion, and a speed bump that slows incoming […]", "text_kind": "source_excerpt", "text_characters": 333, "text_sha256": "e258d34dde4f403597260ddcb484d79f40b6ba3ea3295fbe1aa0ab575abece87", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:30.361114+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:30.383035+00:00", "published_at_raw": "2026-04-02T20:25:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_12195714bacf590e90a5", "record_id": "article_12195714bacf590e", "canonical_url": "https://news.mongabay.com/2026/04/how-underinvesting-in-information-threatens-our-collective-well-being", "publisher_url": "https://news.mongabay.com/2026/04/how-underinvesting-in-information-threatens-our-collective-well-being", "title_original": "How underinvesting in information threatens our collective well-being", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-02T14:21:00+00:00", "source_text": "This essay is adapted from the article, “Information as Civic Infrastructure—and How Philanthropy Can Support the Ecosystem,” which was originally published in Nonprofit Quarterly on March 3, 2026. Philanthropy has grown accustomed to funding the “final” solution. It is comfortable buying land, backing new technologies, and underwriting the services or policies that address urgent problems. […]", "text_kind": "source_excerpt", "text_characters": 397, "text_sha256": "ac53ea97fbe5b44c43fa27d6dd8142f5e744db346ba6c65c63d19d7bd917b259", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:30.431279+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 235, "end": 242, "evidence": "y published in Nonprofit Quarterly on March 3, 2026. Philanthropy has grown accustomed to funding the “final” solution. It is comfortable buying land, backing new technologies, and underwriting the services or policies that address urgen"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:30.453504+00:00", "published_at_raw": "2026-04-02T14:21:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_7d3a7716ed06a392909b", "record_id": "article_7d3a7716ed06a392", "canonical_url": "https://dialogue.earth/en/forests/end-of-soy-pact-amazon-deforestation", "publisher_url": "https://dialogue.earth/en/forests/end-of-soy-pact-amazon-deforestation", "title_original": "Could end of soy pact lead to Amazon deforestation surge?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-31T17:42:35+00:00", "source_text": "For nearly 20 years, soybean traders have been honouring a pledge not to source from areas subject to deforestation in the Amazon. That agreement, known as the soy moratorium, is currently hollowing out. Experts fear deforestation could rise by a third over the next 20 years as a result. In early January, the Brazilian Association of Vegetable Oil Industries (Abiove), which represents the main grain trading companies, announced its withdrawal from the pledge. This followed a recent legal challenge to the moratorium, which was submitted to Brazil’s competition regulator, and the passing of local legislation that removed tax breaks for companies signed up to it. Both issues have reached the supreme court, which referred them to its mediation body on 19 March.", "text_kind": "article_excerpt", "text_characters": 767, "text_sha256": "12bd8510bd05eea71230f178fd4a0793d854f7e9a4d26228ddad352b47b33029", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:44.874986+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:44.908829+00:00", "published_at_raw": "2026-03-31T17:42:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 545, "end": 551, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_8fd2f4a0a1c167a67c65", "record_id": "article_8fd2f4a0a1c167a6", "canonical_url": "https://news.mongabay.com/2026/03/indonesia-reviews-firms-in-river-basins-after-latest-floods-affect-7-of-bornean-province", "publisher_url": "https://news.mongabay.com/2026/03/indonesia-reviews-firms-in-river-basins-after-latest-floods-affect-7-of-bornean-province", "title_original": "Indonesia reviews firms in river basins after latest floods affect 7% of Bornean province", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-31T13:38:50+00:00", "source_text": "BANJAR, Indonesia – Indonesia’s government continues to review mines and plantations in the river basins of southern Borneo, months after more than 7% of the population there was impacted by flooding in December last year. “An audit is still in progress,” environment ministry spokesperson Yulia Suryanti told Mongabay Indonesia. South Kalimantan is one of five […]", "text_kind": "source_excerpt", "text_characters": 365, "text_sha256": "722eddf2c395f7719cdca9a4526f42a16cbb091e078befcce8cae6ed038cbd63", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:30.769992+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "7%", "start": 148, "end": 150, "evidence": "BANJAR, Indonesia – Indonesia’s government continues to review mines and plantations in the river basins of southern Borneo, months after more than 7% of the population there was impacted by flooding in December last year.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": n