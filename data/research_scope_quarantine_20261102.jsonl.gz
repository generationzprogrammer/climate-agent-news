{"text_id": "text_16adc8a58cfa68cbc133", "record_id": "article_16adc8a58cfa68cb", "canonical_url": "https://insideclimatenews.org/news/30112025/texas-petrochemical-expansion-will-fall-heavily-on-communities-of-color", "publisher_url": "https://insideclimatenews.org/news/30112025/texas-petrochemical-expansion-will-fall-heavily-on-communities-of-color", "title_original": "Petrochemical Expansion in Texas Will Fall Heavily on Communities of Color, Study Finds", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-30T09:55:00+00:00", "source_text": "Researchers at Texas Southern University in Houston have analyzed demographic data around the locations of almost 100 industrial facilities proposed statewide and found that about 90 percent are located in counties with higher concentrations of people of color and families in poverty than statewide averages. In a report released this month, the Bullard Center for […]", "text_kind": "source_excerpt", "text_characters": 369, "text_sha256": "5a93c33c413a29d4622ac67ddce7a552ae0a7382215800957f3fb038de4d2cc7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:36.427316+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "90 percent", "start": 180, "end": 190, "evidence": "Researchers at Texas Southern University in Houston have analyzed demographic data around the locations of almost 100 industrial facilities proposed statewide and found that about 90 percent are located in counties with higher concentrations of people of color and families in poverty than statewi