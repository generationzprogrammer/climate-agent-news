"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia", "start": 681, "end": 689, "matched_text": "Cambodia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_154d876aa21f974aabcf", "record_id": "article_154d876aa21f974a", "canonical_url": "https://yaleclimateconnections.org/2026/04/pennsylvania-farmers-found-a-way-around-rising-power-bills", "publisher_url": "https://yaleclimateconnections.org/2026/04/pennsylvania-farmers-found-a-way-around-rising-power-bills", "title_original": "Pennsylvania farmers found a way around rising power bills", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-24T11:00:00+00:00", "source_text": "Transcript: Electricity prices are rising across the country. But a group of organic farmers near Pittsburgh is less affected by these rising costs thanks to rooftop solar panels. Holmes: “When you’re creating that energy yourself, you have stability, and that’s kind of what farmers like, is stability.” Nathan Holmes owns the grocery distribution company Three Rivers Grown . And he also helps manage Clarion River Organics , a cooperative of Amish farmers that supplies produce to stores in Pittsburgh and beyond. He says the warehouse where the co-op stores its crops has three walk-in coolers, which use a lot of energy.", "text_kind": "article_excerpt", "text_characters": 625, "text_sha256": "5343435e0aa2c7e9c19d175b52fc06a83db26e57769654a48fc82b8d2cb40073", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:11.006610+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 166, "end": 171, "evidence": " organic farmers near Pittsburgh is less affected by these rising costs thanks to rooftop solar panels. Holmes: “When you’re creating that energy yourself, you have stability, and that’s kind of what farmers like, is stability.” Nathan"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:11.040504+00:00", "published_at_raw": "2026-04-24T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_2d7d61aea2904a3f7e44", "record_id": "article_2d7d61aea2904a3f", "canonical_url": "https://insideclimatenews.org/news/23042026/endangered-species-act-amendments-faces-setback", "publisher_url": "https://insideclimatenews.org/news/23042026/endangered-species-act-amendments-faces-setback", "title_original": "A Bill to Gut Endangered Species Protections Faced a Major Setback This Week", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-23T22:25:33+00:00", "source_text": "The Trump administration and congressional Republicans have spent the last year trying to defang the Endangered Species Act, the country’s bedrock conservation law. But one of the most aggressive and far-reaching attempts just faced a major setback—and concerns from within the party were at least part of the reason. Republicans in the U.S. House of […]", "text_kind": "source_excerpt", "text_characters": 354, "text_sha256": "151c40d1fb7eea50cab7bbf9caf875897fe87684cc1c65ffafdc1554668cf448", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:55.284133+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:55.297684+00:00", "published_at_raw": "2026-04-23T22:25:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 337, "end": 341, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_2494e10e5495aafc30e9", "record_id": "article_2494e10e5495aafc", "canonical_url": "https://news.mongabay.com/2026/04/little-known-company-targets-south-african-biodiversity-hotspot-for-mining", "publisher_url": "https://news.mongabay.com/2026/04/little-known-company-targets-south-african-biodiversity-hotspot-for-mining", "title_original": "Little-known company targets South African biodiversity hotspot for mining", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-23T10:04:59+00:00", "source_text": "A slew of applications by a little-known mining group to explore for critical minerals in South Africa’s Northern Cape province, including within the buffer zone of a nature reserve, has alarmed environmental groups and activists. They warn that the remote and water-scarce region, a globally significant biodiversity hotspot with unique ecosystems and exceptional plant diversity, […]", "text_kind": "source_excerpt", "text_characters": 385, "text_sha256": "a86dc30272bbb7183483a404f74f5a2af8b132f50a52ad24d178751f92943ee8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:13.389678+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:13.412537+00:00", "published_at_raw": "2026-04-23T10:04:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa", "start": 90, "end": 102, "matched_text": "South Africa", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_6d72e61052babe1f9048", "record_id": "article_6d72e61052babe1f", "canonical_url": "https://yaleclimateconnections.org/2026/04/how-strong-can-a-hurricane-get-in-a-warming-world", "publisher_url": "https://yaleclimateconnections.org/2026/04/how-strong-can-a-hurricane-get-in-a-warming-world", "title_original": "How strong can a hurricane get in a warming world?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-22T11:00:00+00:00", "source_text": "In the Gulf of Mexico and western Caribbean, hurricanes with 224 mph (100 m/s) winds are possible. Warming the oceans will increase this maximum potential intensity, with potentially devastating effects.", "text_kind": "source_excerpt", "text_characters": 203, "text_sha256": "2a3fe15e7ec3c3970cf2cacfca414096b752f958a134b43b554e8bff2d9cdb60", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:11.205300+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 99, "end": 106, "evidence": "lf of Mexico and western Caribbean, hurricanes with 224 mph (100 m/s) winds are possible. Warming the oceans will increase this maximum potential intensity, with potentially devastating effects."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:11.247281+00:00", "published_at_raw": "2026-04-22T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 15, "end": 21, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_d093e2aeb5f2a7b07e28", "record_id": "article_d093e2aeb5f2a7b0", "canonical_url": "https://insideclimatenews.org/news/21042026/transco-southeast-pipeline-lawsuit", "publisher_url": "https://insideclimatenews.org/news/21042026/transco-southeast-pipeline-lawsuit", "title_original": "Transco Pipeline Project Faces Legal Challenge", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-21T19:59:37+00:00", "source_text": "Five environmental groups are petitioning a federal appeals court to invalidate a water quality permit issued by the U.S. Army Corps of Engineers for a controversial Transco pipeline. The $1.5 billion Southeast Supply Enhancement Project (SSEP) would run through five states, including North Carolina, where it would extend for 28 miles in Rockingham, Guilford, Forsyth […]", "text_kind": "source_excerpt", "text_characters": 373, "text_sha256": "e021315e99fae474498745542c896c7f478cd39c9778b607cac037a99357d33e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:55.805975+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$1.5 billion", "start": 188, "end": 200, "evidence": " The $1.5 billion Southeast Supply Enhancement Project (SSEP) would run through five states, including North Carolina, where it would extend for 28 miles in Rockingham, Guilford, Forsyth […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:55.822380+00:00", "published_at_raw": "2026-04-21T19:59:37", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 117, "end": 121, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_267bc3871b159463e3a0", "record_id": "article_267bc3871b159463", "canonical_url": "https://insideclimatenews.org/news/21042026/tesla-lithium-refinery-toxic-wastewater", "publisher_url": "https://insideclimatenews.org/news/21042026/tesla-lithium-refinery-toxic-wastewater", "title_original": "Independent Testing Where Tesla’s Lithium Refinery Discharges Wastewater Found Toxic Metals", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-21T19:11:26+00:00", "source_text": "After Texas regulators said Tesla’s lithium refinery near Corpus Christi wasn’t violating its permits by discharging what local officials reported as black wastewater into a drainage ditch, independent water testing there this month found two toxic metals and other contaminants. Eurofins Environment Testing, an accredited lab with locations across the globe, reported traces of hexavalent […]", "text_kind": "source_excerpt", "text_characters": 394, "text_sha256": "f552305846b29698d06e55b8cc8fdcc54529ff5553fe4e86efaf5c23512cde40", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:55.857363+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:55.873510+00:00", "published_at_raw": "2026-04-21T19:11:26", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 6, "end": 11, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_f8db46922308dc30d317", "record_id": "article_f8db46922308dc30", "canonical_url": "https://insideclimatenews.org/news/20042026/rio-grande-compact-meeting-low-river-flows", "publisher_url": "https://insideclimatenews.org/news/20042026/rio-grande-compact-meeting-low-river-flows", "title_original": "Facing Drought and Low Snowpack, Rio Grande States Expect a ‘Challenging’ Year", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-20T22:35:35+00:00", "source_text": "Reporting supported by the Water Desk at the University of Colorado Boulder. SANTA FE, N.M.—“Severe.“ “Critical.” “Dire.” “Challenging.” “Record-low.” Officials at the Rio Grande Compact Commission annual meeting Friday worked through the thesaurus to describe the conditions on the river that flows out of southwestern Colorado. Compact signatory states—Colorado, New Mexico and Texas—along with federal […]", "text_kind": "source_excerpt", "text_characters": 408, "text_sha256": "67320868fc6f04549cb207ebe9a390b032191b57d2517c6eb7d1a45ea04a3a5f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:56.043745+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:56.058151+00:00", "published_at_raw": "2026-04-20T22:35:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 365, "end": 375, "matched_text": "New Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_34264f4b7dba9581705a", "record_id": "article_34264f4b7dba9581", "canonical_url": "https://news.mongabay.com/2026/04/nigerian-bat-specialist-wins-goldman-prize-for-community-conservation-work", "publisher_url": "https://news.mongabay.com/2026/04/nigerian-bat-specialist-wins-goldman-prize-for-community-conservation-work", "title_original": "Nigerian bat specialist wins Goldman Prize for community conservation work", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-20T18:59:08+00:00", "source_text": "In the forested highlands of southern Nigeria’s Cross River state, plumes of smoke signal the annual fire season from January to April, when farmers routinely use fire to clear new land for planting cacao, maize and cassava. In five villages near the Afi Mountain Wildlife Sanctuary, the period is also marked by another signal: the […]", "text_kind": "source_excerpt", "text_characters": 336, "text_sha256": "fdf2bbb4f9c9424af965e2638e6e12b66c0be8282e30770ba90a4f8e135feead", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:13.894510+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NG", "alpha3": "NGA", "name_zh": "尼日利亚", "name_en": "Nigeria"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NG", "alpha3": "NGA", "name_zh": "尼日利亚", "name_en": "Nigeria"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:13.914767+00:00", "published_at_raw": "2026-04-20T18:59:08", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NG", "alpha3": "NGA", "name_zh": "尼日利亚", "name_en": "Nigeria", "start": 38, "end": 45, "matched_text": "Nigeria", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_cf82e095e91c7168ade1", "record_id": "article_cf82e095e91c7168", "canonical_url": "https://insideclimatenews.org/news/20042026/plastic-waste-plant-violating-pollution-rules-expands", "publisher_url": "https://insideclimatenews.org/news/20042026/plastic-waste-plant-violating-pollution-rules-expands", "title_original": "As a Plastic Waste Plant Violates Pollution Rules, Its Owner Makes the Case for a Second Location", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-20T09:00:00+00:00", "source_text": "Belching smoke from a new plastic waste processing plant in central Ohio has stirred opposition to an even larger “chemical recycling” factory planned for Arizona by the same company. The Freepoint Eco-Systems plant near Hebron, Ohio, fired up its processing kilns for the first time in 2024. Since then, it’s faced multiple citizen complaints about […]", "text_kind": "source_excerpt", "text_characters": 353, "text_sha256": "881b1a0527919f03292f8355b516b14f55da5b50544028ecf7b0e0dd8e9269e5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:56.115073+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://ins