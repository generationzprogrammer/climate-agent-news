{"text_id": "text_d2b062bb1b3754c1c53a", "record_id": "article_d2b062bb1b3754c1", "canonical_url": "https://insideclimatenews.org/news/09022025/usfws-keeps-grizzly-bears-endangered-states-disagree", "publisher_url": "https://insideclimatenews.org/news/09022025/usfws-keeps-grizzly-bears-endangered-states-disagree", "title_original": "After the Feds Kept Grizzlies on the Endangered Species List Last Month, State Leaders Try to Remove Them", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-09T10:00:00+00:00", "source_text": "For over a quarter century, a female grizzly bear roamed the terrain around Grand Teton National Park, giving visitors a spectacular look at the life of one of the most charismatic and revered mammals in the United States. She lived to the age of 28, one of the 12 oldest grizzlies ever documented in the […]", "text_kind": "source_excerpt", "text_characters": 308, "text_sha256": "83661f6592a33757f9b3900fdf99d2574cf7493145ea4826699e4ea162b1cc52", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:57.321713+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:57.348865+00:00", "published_at_raw": "2025-02-09T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 208, "end": 221, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_4aafc6244ee7754dfe9b", "record_id": "article_4aafc6244ee7754d", "canonical_url": "https://insideclimatenews.org/news/07022025/todays-climate-delta-smelt-california-water-endangered", "publisher_url": "https://insideclimatenews.org/news/07022025/todays-climate-delta-smelt-california-water-endangered", "title_original": "Why Trump Keeps Blaming the Delta Smelt for California’s Water Woes—and What It Could Mean for Endangered Species", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-07T23:06:48+00:00", "source_text": "It’s tiny, it’s silver and it’s at the center of a decades-long controversy over California’s water system. It’s the delta smelt. This threatened fish lives exclusively in the Sacramento-San Joaquin River Delta in northern California, where it depends on the slightly brackish water of the wetland. But the delta is also crucial for people, supplying […]", "text_kind": "source_excerpt", "text_characters": 354, "text_sha256": "9d26e622d6c457d5b9926226223f235f1c1589db23278cd5271ef4a12a4b6d8c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:57.521563+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:57.544052+00:00", "published_at_raw": "2025-02-07T23:06:48", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 44, "end": 54, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 81, "end": 91, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_44c7447d028c509c78c3", "record_id": "article_44c7447d028c509c", "canonical_url": "https://dialogue.earth/en/business/argentinas-provinces-deepen-relations-with-china", "publisher_url": "https://dialogue.earth/en/business/argentinas-provinces-deepen-relations-with-china", "title_original": "Argentina’s provinces deepen relations with China", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-02-07T17:57:56+00:00", "source_text": "While diplomatic relations between Argentina’s national government and China remain ambiguous, provincial leaders have been bypassing Buenos Aires to bolster links with Beijing. These subnational efforts are mobilising investment opportunities in natural resources, energy, infrastructure and trade expansion. They have been yielding varying degrees of success as the provinces navigate several challenges, including a lack of China knowledge among provincial leaders, as well as preparation on the part of trade missions headed to China. Economic constraints at the national level also continue to cast a shadow.", "text_kind": "article_excerpt", "text_characters": 613, "text_sha256": "69391c87199d012771035308001724a8a95bbe1529a68936856da8122baf771d", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:40.624517+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": 