{"text_id": "text_39d7734af51a4aa7f370", "record_id": "article_39d7734af51a4aa7", "canonical_url": "https://news.mongabay.com/2025/04/indonesia-bets-on-reuse-to-curb-plastic-waste-and-build-a-circular-economy", "publisher_url": "https://news.mongabay.com/2025/04/indonesia-bets-on-reuse-to-curb-plastic-waste-and-build-a-circular-economy", "title_original": "Indonesia bets on ‘reuse’ to curb plastic waste and build a circular economy", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-10T11:24:36+00:00", "source_text": "JAKARTA — With the Islamic month of Ramadan now over, a familiar sight has returned to the streets of daytime Jakarta: street vendors serving up chicken porridge, and everyone from office workers to delivery drivers perched on plastic stools around the steaming carts, digging into a bowl of the congee-like breakfast staple. As with most […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "f19e843a5177dd49f55971b6953d849ef22bf6cad8bdc8866cc62a5548aaef55", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:36.272995+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_