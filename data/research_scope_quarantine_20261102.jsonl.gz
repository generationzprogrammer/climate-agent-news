{"text_id": "text_553c9f56e651889c3eca", "record_id": "article_553c9f56e651889c", "canonical_url": "https://insideclimatenews.org/news/07042025/human-rights-defenders-face-serious-risks", "publisher_url": "https://insideclimatenews.org/news/07042025/human-rights-defenders-face-serious-risks", "title_original": "Rural Human Rights Defenders Face Serious and Growing Risks, UN Report Reveals", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-07T09:00:00+00:00", "source_text": "When a gold mine in rural Liberia spewed three million gallons of cyanide-laced wastewater into soil and groundwater in 2016, affected Indigenous communities’ calls for accountability went largely unanswered. Locals protested the Turkish company responsible and criticized its officials for failing to clean up the toxic mess. In response, the Liberian government arrested, tortured and […]", "text_kind": "source_excerpt", "text_characters": 390, "text_sha256": "df738158f80688628a8f548daf2dfd33a0aa4d851fe0d60ca5fae19e08d80dc6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:22.759640+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "LR", "alpha3": "LBR", "name_zh": "利比里亚", "name_en": "Liberia"}, {"alpha2": "TR", "alpha3": "TUR", "name_zh": "土耳其", "name_en": "Türkiye"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 135, "end": 145, "evidence": "e million gallons of cyanide-laced wastewater into soil and groundwater in 2016, affected Indigenous communities’ calls for accountability went largely unanswered. Locals protested the Turkish company responsible and criticized its official"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "LR", "alpha3": "LBR", "name_zh": "利比里亚", "name_en": "Liberia"}, {"alpha2": "TR", "alpha3": "TUR", "name_zh": "土耳其", "name_en": "Türkiye"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:22.790661+00:00", "published_at_raw": "2025-04-07T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "LR", "alpha3": "LBR", "name_zh": "利比里亚", "name_en": "Liberia", "start": 26, "end": 33, "matched_text": "Liberia", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "TR", "alpha3": "TUR", "name_zh": "土耳其", "name_en": "Türkiye", "start": 230, "end": 237, "matched_text": "Turkish", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_418f557c97139835c01e", "record_id": "article_418f557c97139835", "canonical_url": "https://insideclimatenews.org/news/05042025/new-york-jamaica-bay-documentary", "publisher_url": "https://insideclimatenews.org/news/05042025/new-york-jamaica-bay-documentary", "title_original": "New Documentary Explores the Natural Wonders of NYC’s Jamaica Bay Through One of Its Most-Beloved Characters", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-05T08:55:00+00:00", "source_text": "Broad Channel is one of the lesser known of New York City’s 350 or so neighborhoods, a community of a few thousand residents on the only populated island in Jamaica Bay, directly across from JFK airport. The Queens hamlet looks like a tiny seaside town, with modest houses on canals where the calls of ospreys […]", "text_kind": "source_excerpt", "text_characters": 313, "text_sha256": "f7c9163e6742e905287d88a8f620a02168b7fe7a85bdcffb26e0501902e760bd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:23.068165+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "JM", "alpha3": "JAM", "name_zh": "牙买加", "name_en": "Jamaica"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "JM", "alpha3": "JAM", "name_zh": "牙买加", "name_en": "Jamaica"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:23.102514+00:00", "published_at_raw": "2025-04-05T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "JM", "alpha3": "JAM", "name_zh": "牙买加", "name_en": "Jamaica", "start": 54, "end": 61, "matched_text": "Jamaica", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "JM", "alpha3": "JAM", "name_zh": "牙买加", "name_en": "Jamaica", "start": 157, "end": 164, "matched_text": "Jamaica", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_196e135ac7825dafcca9", "record_id": "article_196e135ac7825daf", "canonical_url": "https://yaleclimateconnections.org/2025/04/three-ways-american-cities-can-become-more-flood-resilient-and-beautiful", "publisher_url": "https://yaleclimateconnections.org/2025/04/three-ways-american-cities-can-become-more-flood-resilient-and-beautiful", "title_original": "Three ways American cities can become more flood-resilient and beautiful", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-04T11:00:00+00:00", "source_text": "From shiny metallic blue amphitheaters that serve as floodwater storage pools, basketball courts, and skateboarding rinks to double-decker road tunnels that can fill with stormwater and still remain usable for travel, cities around the world feature creatively designed multipurpose facilities that can both protect communities from weather disasters and bring people together in public spaces with nature. As storms and floods become more frequent, intense, and expensive in terms of finances and lost lives , city life is becoming more precarious. Amit Prothi, the director general of the Coalition for Disaster Resilient Infrastructure , has spent decades working on making communities more resilient across more than 15 countries in North America, Asia, and Europe.", "text_kind": "article_excerpt", "text_characters": 769, "text_sha256": "458beb135e3d30831d4037c5d90668ec460fb2689d6feca8afe31e9501bca669", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:48:06.468707+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "adaptation", "label_zh": "适应与韧性", "label_en": "Adaptation and resilience", "start": 614, "end": 622, "evidence": "becoming more precarious. Amit Prothi, the director general of the Coalition for Disaster Resilient Infrastructure , has spent decades working on making communities more resilient across more than 15 countries in North America, Asia, and "}, {"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 591, "end": 595, "evidence": "t lives , city life is becoming more precarious. Amit Prothi, the director general of the Coalition for Disaster Resilient Infrastructure , has spent decades working on making communities more resilient across more than 15 countries i"}, {"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 53, "end": 58, "evidence": "From shiny metallic blue amphitheaters that serve as floodwater storage pools, basketball courts, and skateboarding rinks to double-decker road tunnels that can fill with stormwater and still remain"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:06.529956+00:00", "published_at_raw": "2025-04-04T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_c2086753e5192026473e", "record_id": "article_c2086753e5192026", "canonical_url": "https://insideclimatenews.org/news/01042025/pennsylvania-health-advocates-say-gov-shapiro-has-let-residents-down-on-fracking-protections", "publisher_url": "https://insideclimatenews.org/news/01042025/pennsylvania-health-advocates-say-gov-shapiro-has-let-residents-down-on-fracking-protections", "title_original": "Pennsylvania Health Advocates Say Gov. Shapiro Has Let Residents Down on Fracking Protections", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-01T21:23:35+00:00", "source_text": "Public health advocates assessing Josh Shapiro’s first two years as Pennsylvania’s governor concluded that he hasn’t done enough to protect residents from the damaging effects of hydraulic fracturing for natural gas—despite charting a roadmap for such actions almost five years ago while he was attorney general. Environmental Health Project (EHP), a Pittsburgh-based nonprofit, said Shapiro […]", "text_kind": "source_excerpt", "text_characters": 395, "text_sha256": "5dcfedfa6a60e7f2a456332284cb4e2032aac47ce3a5e99350cd45f16fbbfc49", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:28.684025+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:28.703694+00:00", "published_at_raw": "2025-04-01T21:23:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_e2da3d611e47334c6ee1", "record_id": "article_e2da3d611e47334c", "canonical_url": "https://yaleclimateconnections.org/2025/04/thrill-seekers-heres-your-chance-at-the-ride-of-a-lifetime", "publisher_url": "https://yaleclimateconnections.org/2025/04/thrill-seekers-heres-your-chance-at-the-ride-of-a-lifetime", "title_original": "Thrill seekers, here’s your chance at the ride of a lifetime", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-01T11:00:00+00:00", "source_text": "Recent cuts across the federal government have raised questions about whether President Donald Trump’s administration will aim to dismantle and privatize the National Weather Service, part of the National Oceanic and Atmospheric Administration. Project 2025, a 922-page blueprint of policy proposals published during the presidential campaign and intended to guide the Trump administration should it win a second term contained language suggesting that NOAA “should be broken up and downsized” and that the NWS “should fully commercialize its forecasting operations.” — ABC News, March 25, 2025 Are you bored with routine skydiving? Does the survival rate of base jumping strike you as excessively high?", "text_kind": "article_excerpt", "text_characters": 703, "text_sha256": "a11af8ecf682c7936c31a9fc49a6e9e37a002e177efdbdc14c3d903b24cbfde0", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:48:07.763481+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:07.844574+00:00", "published_at_raw": "2025-04-01T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_98abec6aa57d9d1822e3", "record_id": "article_98abec6aa57d9d18", "canonical_url": "https://insideclimatenews.org/news/01042025/should-oil-and-gas-drilling-expand-in-this-biodiverse-national-forest-the-public-overwhelmingly-says-no", "publisher_url": "https://insideclimatenews.org/news/01042025/should-oil-and-gas-drilling-expand-in-this-biodiverse-national-forest-the-public-overwhelmingly-says-no", "title_original": "Should Oil and Gas Drilling Expand in This Biodiverse National Forest? The Public Overwhelmingly Says No", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-01T09:01:00+00:00", "source_text": "CONECUH NATIONAL FOREST, Ala.—Jimmy Stiles knows Conecuh National Forest. He lives in it. Stiles, a field biologist, has lived in his home in the northern section of the forest, which lines the Alabama-Florida border, for nearly 25 years. He said he’s loved every second of it. That’s why, Stiles said, he’s willing to fight for […]", "text_kind": "source_excerpt", "text_characters": 332, "text_sha256": "3d682650e31fa7b4f3cddb68663f0fe02b687cc26a322d12dbe71b5828e36a2d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:28.733169+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:28.751277+00:00", "published_at_raw": "2025-04-01T09:01:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_4ab3548546e37b147e0c", "record_id": "article_4ab3548546e37b14", "canonical_url": "https://news.mongabay.com/2025/04/smuggling-networks-exploit-migrant-debt-to-fuel-tiger-poaching-in-malaysia-study-shows", "publisher_url": "https://news.mongabay.com/2025/04/smuggling-networks-exploit-migrant-debt-to-fuel-tiger-poaching-in-malaysia-study-shows", "title_original": "Smuggling networks exploit migrant debt to fuel tiger poaching in Malaysia, study shows", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-01T03:20:53+00:00", "source_text": "Fewer than 150 Malayan tigers remain in their home range of Peninsular Malaysia. Poaching to supply an illegal trade in their body parts is a major threat to the survival of this critically endangered subspecies of tiger, Panthera tigris jacksoni. A new study details a link between the trafficking of people and Malayan tiger parts: […]", "text_kind": "source_excerpt", "text_characters": 337, "text_sha256": "366c115b7fb8195b24874464092759edfb6ce0aceb082ddb74f66773914d48f1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:42.156890+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MY", "alpha3": "MYS", "name_zh": "马来西亚", "name_en": "Malaysia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MY", "alpha3": "MYS", "name_zh": "马来西亚", "name_en": "Malaysia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:42.184062+00:00", "published_at_raw": "2025-04-01T03:20:53", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MY", "alpha3": "MYS", "name_zh": "马来西亚", "name_en": "Malaysia", "start": 66, "end": 74, "matched_text": "Malaysia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "MY", "alpha3": "MYS", "name_zh": "马来西亚", "name_en": "Malaysia", "start": 71, "end": 79, "matched_text": "Malaysia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_f5d001f47bf2f09b2638", "record_id": "article_f5d001f47bf2f09b", "canonical_url": "https://www.carbonbrief.org/guest-post-saudi-arabias-surprisingly-large-imports-of-solar-panels-from-china", "publisher_url": "https://www.carbonbrief.org/guest-post-saudi-arabias-surprisingly-large-imports-of-solar-panels-from-china", "title_original": "Guest post: Saudi Arabia’s surprisingly large imports of solar panels from China", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-31T09:30:20+00:00", "source_text": "Saudi Arabia and Pakistan were among the top importers of Chinese solar panels in 2024, with more than half heading to countries in the global south. The findings come from Ember’s China’s solar PV export explorer, which tracks shipments to more than 200 countries and was recently updated with figures for the full year of 2024. In total, China’s solar panel exports rose by 10% in 2024, with imports by global-south countries rising by 32% and those to the global north falling by 6%. This means Chinese exports grew less quickly than the 30% rise in solar installations outside China last year, indicating that other countries have been boosting their own solar manufacturing capacity and that already-imported stocks were being run down.", "text_kind": "article_excerpt", "text_characters": 741, "text_sha256": "48e8085cf4966ce2503a204cf387cb91c59c51e6cb6f417453d9a2a17c9e8224", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:23.434998+00:00", "extractor_version": "1.0.0", "document_type": "commentary_or_analysis", "document_type_basis": "explicit_title_prefix", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "10%", "start": 376, "end": 379, "evidence": " In total, China’s solar panel exports rose by 10% in 2024, with imports by global-south countries rising by 32% and those to the global north falling by 6%.", "interpretation": "not_classified"}, {"value_text": "32%", "start": 438, "end": 441, "evidence": " In total, China’s solar panel exports rose by 10% in 2024, with imports by global-south countries rising by 32% and those to the global north falling by 6%.", "interpretation": "not_classified"}, {"value_text": "6%", "start": 483, "end": 485, "evidence": " In total, China’s solar panel exports rose by 10% in 2024, with imports by global-south countries rising by 32% and those to the global north falling by 6%.", "interpretation": "not_classified"}, {"value_text": "30%", "start": 541, "end": 544, "evidence": " This means Chinese exports grew less quickly than the 30% rise in solar installations outside China last year, indicating that other countries have been boosting their own solar manufacturing capacity and that already-imported stocks were being run down.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan"}, {"alpha2": "SA", "alpha3": "SAU", "name_zh": "沙特阿拉伯", "name_en": "Saudi Arabia"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 66, "end": 71, "evidence": "Saudi Arabia and Pakistan were among the top importers of Chinese solar panels in 2024, with more than half heading to countries in the global south. The findings come from Ember’s China’s solar PV export explor"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan"}, {"alpha2": "SA", "alpha3": "SAU", "name_zh": "沙特阿拉伯", "name_en": "Saudi Arabia"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:23.538806+00:00", "published_at_raw": "2025-03-31T09:30:20", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "SA", "alpha3": "SAU", "name_zh": "沙特阿拉伯", "name_en": "Saudi Arabia", "start": 12, "end": 24, "matched_text": "Saudi Arabia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 75, "end": 80, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "SA", "alpha3": "SAU", "name_zh": "沙特阿拉伯", "name_en": "Saudi Arabia", "start": 0, "end": 12, "matched_text": "Saudi Arabia", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan", "start": 17, "end": 25, "matched_text": "Pakistan", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 58, "end": 65, "matched_text": "Chinese", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_54a2e9375262fc55f1e5", "record_id": "article_54a2e9375262fc55", "canonical_url": "https://insideclimatenews.org/news/30032025/china-belt-and-road-argentina-environmental-cost", "publisher_url": "https://insideclimatenews.org/news/30032025/china-belt-and-road-argentina-environmental-cost", "title_original": "China Is Reshaping Global Development. Is That Good for the Planet?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-30T09:00:00+00:00", "source_text": "Planet China: First in a series about how Beijing’s trillion-dollar development plan is reshaping the globe—and the natural world. EL CALAFATE, Argentina—Deep in Southern Patagonia, Mariana Martinez wades barefoot into the turquoise waters of a glacial lake. In the rugged mountains surrounding her, the sun streams into forest-draped valleys and intense Patagonian winds spray water into […]", "text_kind": "source_excerpt", "text_characters": 392, "text_sha256": "9f29dd53e7d9a18999c2715774433995389da4264f1649b9dd2116528704dae9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:29.171169+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mention