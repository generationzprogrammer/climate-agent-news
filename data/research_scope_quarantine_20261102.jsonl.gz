{"text_id": "text_e23fc00e8ca11d24f6a0", "record_id": "article_e23fc00e8ca11d24", "canonical_url": "https://insideclimatenews.org/news/14092025/florida-insurance-crisis-hits-hardest-in-disadvantaged-counties", "publisher_url": "https://insideclimatenews.org/news/14092025/florida-insurance-crisis-hits-hardest-in-disadvantaged-counties", "title_original": "In the Midst of Florida’s Insurance Crisis, What Recourse Do Residents Have?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-14T09:00:00+00:00", "source_text": "OKEECHOBEE, Fla.—If you want to get to know this hamlet sprinkled among ranchlands on the north side of Lake Okeechobee, one of the best people to talk to is its mayor, Dowling Watford. Watford has lived here all his life. A self-described history buff, he can tell you how early in its existence Okeechobee was […]", "text_kind": "source_excerpt", "text_characters": 315, "text_sha256": "da94250c2942da0b1b7e076924a3ae46b4bb42a922e2b19277bb185829038b16", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:40.324824+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:40.360873+00:00", "published_at_raw": "2025-09-14T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_ad3f22fd61039bd5cd04", "record_id": "article_ad3f22fd61039bd5", "canonical_url": "https://insideclimatenews.org/news/14092025/icn-sunday-morning-new-chapter-for-environmental-justice", "publisher_url": "https://insideclimatenews.org/news/14092025/icn-sunday-morning-new-chapter-for-environmental-justice", "title_original": "A New Chapter for Environmental Justice", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-14T08:45:00+00:00", "source_text": "The environmental justice movement suffered a striking blow this year when the Trump administration rescinded $3 billion in grants to support EJ initiatives. EPA Administrator Lee Zeldin terminated the grant programs and eliminated the EPA’s environmental justice office after the president tried to re-brand EJ as a “radical and wasteful” form of reverse discrimination and […]", "text_kind": "source_excerpt", "text_characters": 378, "text_sha256": "e1c43f6f69a33baeb675154dda0d771ad09d8480fe8d56e53c6665e64eb9728e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:40.556760+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$3 billion", "start": 110, "end": 120, "evidence": "The environmental justice movement suffered a striking blow this year when the Trump administration rescinded $3 billion in grants to support EJ initiatives.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 124, "end": 129, "evidence": " suffered a striking blow this year when the Trump administration rescinded $3 billion in grants to support EJ initiatives. EPA Administrator Lee Zeldin terminated the grant programs and eliminated the EPA’s environmental justice offic"}], "policy_stages": [{"id": "withdrawn", "label_zh": "撤回", "label_en": "Withdrawn", "start": 100, "end": 109, "evidence": "nmental justice movement suffered a striking blow this year when the Trump administration rescinded $3 billion in grants to support EJ initiatives. EPA Administrator Lee Zeldin terminated the grant programs and eliminated the EPA’s environ"}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:40.589377+00:00", "published_at_raw": "2025-09-14T08:45:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_d0d3b4db8fbba8def04f", "record_id": "article_d0d3b4db8fbba8de", "canonical_url": "https://insideclimatenews.org/news/13092025/beaver-habitat-impact-land-resilience", "publisher_url": "https://insideclimatenews.org/news/13092025/beaver-habitat-impact-land-resilience", "title_original": "Researchers Use AI to Predict Beavers’ Impact on Local Habitats—and Show How Humans Can Help", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-13T20:55:00+00:00", "source_text": "Across the Rockies and Great Plains, beaver dams interrupt narrow streams, slowing currents into chains of ponds that reshape channels and spread wetlands across valleys. The mud-and-stick barriers create habitat for willows and cottonwoods, sustain corridors of green vegetation long after surrounding hills have browned, and soften the force of floods. In the West, as […]", "text_kind": "source_excerpt", "text_characters": 374, "text_sha256": "c77e64f9a2412c9a63f64becc063d24b483d14c6801416f30f786f885e4f3670", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:40.633481+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 347, "end": 352, "evidence": "rs of green vegetation long after surrounding hills have browned, and soften the force of floods. In the West, as […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:40.683162+00:00", "published_at_raw": "2025-09-13T20:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_b495203b360efd289eb8", "record_id": "article_b495203b360efd28", "canonical_url": "https://dialogue.earth/en/energy/roundtable-how-has-the-sco-summit-impacted-the-global-energy-landscape", "publisher_url": "https://dialogue.earth/en/energy/roundtable-how-has-the-sco-summit-impacted-the-global-energy-landscape", "title_original": "Roundtable: How has the SCO summit impacted the global energy landscape?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-11T16:54:57+00:00", "source_text": "China put energy cooperation centre stage at the recent Shanghai Cooperation Organisation (SCO) meetings in Tianjin. President Xi Jinping announced that China will invest in building 10 gigawatts (GW) of solar and 10 GW of wind power across SCO member countries over the next five years. What is the Shanghai Cooperation Organisation? The SCO is a Eurasian political and economic alliance established in Shanghai in 2001. Back then it was formed of China, Kazakhstan, Kyrgyzstan, Russia, Tajikistan and Uzbekistan. It has since grown to include India, Pakistan, Iran and Belarus. From an initial focus on regional security, the SCO has expanded its remit to development cooperation. At the recent SCO meetings in Tianjin, energy was positioned at the centre of the organisation’s priorities.", "text_kind": "article_excerpt", "text_characters": 791, "text_sha256": "5fb0b4c82c4fad9778714675a701b4e1554f7ab783927cfa3bbda7b30e3861b7", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:12.715508+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "q