{"text_id": "text_4176c55b90be5fa64955", "record_id": "article_4176c55b90be5fa6", "canonical_url": "https://insideclimatenews.org/news/11072026/antarctica-missing-ice", "publisher_url": "https://insideclimatenews.org/news/11072026/antarctica-missing-ice", "title_original": "The Case of the (France-Sized) Missing Antarctic Ice", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-11T08:55:00+00:00", "source_text": "From our collaborating partner Living on Earth, public radio’s environmental news magazine, an interview by producer Aynsley O’Neill with UC Boulder senior research scientist Ted Scambos. Midsummer in the Northern Hemisphere marks the dead of winter in Antarctica, usually a time when temperatures plunge and the surrounding ocean ices over, nearly doubling the continent’s size. […]", "text_kind": "source_excerpt", "text_characters": 383, "text_sha256": "63b85b74a372215a1cf5447098c4c8ab777e85e021863effb7038e506f600f46", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:45.378051+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AQ", "alpha3": "ATA", "name_zh": "南极洲", "name_en": "Antarctica"}, {"alpha2": "FR", "alpha3": "FRA", "name_zh": "法国", "name_en": "France"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 285, "end": 296, "evidence": "er in the Northern Hemisphere marks the dead of winter in Antarctica, usually a time when temperatures plunge and the surrounding ocean ices over, nearly doubling the continent’s size. […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "AQ", "alpha3": "ATA", "name_zh": "南极洲", "name_en": "Antarctica"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:45.389557+00:00", "published_at_raw": "2026-07-11T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "FR", "alpha3": "FRA", "name_zh": "法国", "name_en": "France", "start": 17, "end": 23, "matched_text": "France", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "AQ", "alpha3": "ATA", "name_zh": "南极洲", "name_en": "Antarctica", "start": 253, "end": 263, "matched_text": "Antarctica", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_adc9630eb2623be25cf8", "record_id": "article_adc9630eb2623be2", "canonical_url": "https://news.mongabay.com/2026/07/conserving-sierra-leones-western-chimpanzees-interview-with-tacugamas-willie-tucker", "publisher_url": "https://news.mongabay.com/2026/07/conserving-sierra-leones-western-chimpanzees-interview-with-tacugamas-willie-tucker", "title_original": "Conserving Sierra Leone’s western chimpanzees: Interview with Tacugama’s Willie Tucker", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-10T19:24:13+00:00", "source_text": "In Sierra Leone, the critically endangered western chimpanzee (Pan troglodytes verus) faces growing threats from habitat loss, deforestation, illegal wildlife trade and expanding human activity. For the past 30 years, Tacugama Chimpanzee Sanctuary has worked to rescue, rehabilitate and protect chimpanzees affected by these challenges. Few people have witnessed the sanctuary’s journey as closely as […]", "text_kind": "source_excerpt", "text_characters": 404, "text_sha256": "4a29d64afadbb1d53d5941a176e89ffe814e13887d4e605558244d732952524f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:44.031802+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "SL", "alpha3": "SLE", "name_zh": "塞拉利昂", "name_en": "Sierra Leone"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "SL", "alpha3": "SLE", "name_zh": "塞拉利昂", "name_en": "Sierra Leone"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:44.043661+00:00", "published_at_raw": "2026-07-10T19:24:13", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "SL", "alpha3": "SLE", "name_zh": "塞拉利昂", "name_en": "Sierra Leone", "start": 11, "end": 23, "matched_text": "Sierra Leone", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "SL", "alpha3": "SLE", "name_zh": "塞拉利昂", "name_en": "Sierra Leone", "start": 3, "end": 15, "matched_text": "Sierra Leone", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_5b42e5a5969d35876e03", "record_id": "article_5b42e5a5969d3587", "canonical_url": "https://insideclimatenews.org/news/10072026/trump-florida-coal-plant-order-legal-challenge", "publisher_url": "https://insideclimatenews.org/news/10072026/trump-florida-coal-plant-order-legal-challenge", "title_original": "Grassroots Justice Group Challenges Trump Administration Order to Keep Florida Coal Plant Running", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-10T08:50:00+00:00", "source_text": "The Trump administration is facing a new legal challenge over an emergency order keeping a Florida coal-fired power plant, which had been scheduled for retirement, in operation. The motion, filed by the Environmental Defense Fund, Sierra Club and Earthjustice, on behalf of Florida Rising, a grassroots group representing communities of color, asks the Department of […]", "text_kind": "source_excerpt", "text_characters": 370, "text_sha256": "fc7703292e8c0cb3174a9476447062a9d3e063d5c32eb5f1e94186b4a1c2c3dd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:45.554031+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 99, "end": 103, "evidence": " administration is facing a new legal challenge over an emergency order keeping a Florida coal-fired power plant, which had been scheduled for retirement, in operation. The motion, filed by the Environmental Defense Fund, Sierra Club "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:45.570678+00:00", "published_at_raw": "2026-07-10T08:50:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_82c7d62f7d3de3f46fba", "record_id": "article_82c7d62f7d3de3f4", "canonical_url": "https://insideclimatenews.org/news/09072026/florida-regulators-stood-by-as-sloths-died", "publisher_url": "https://insideclimatenews.org/news/09072026/florida-regulators-stood-by-as-sloths-died", "title_original": "Florida Regulators Stood by as Dozens of Sloths Died, New Records Reveal", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-09T18:14:38+00:00", "source_text": "The first warning reached the Florida Fish and Wildlife Conservation Commission before a single sloth had arrived in Orlando. On Dec. 9, 2024, a member of the public called the agency after seeing advertisements for a new business called Sloth World. The caller said owner Benjamin Agresta was hiring employees and telling prospective workers that […]", "text_kind": "source_excerpt", "text_characters": 351, "text_sha256": "99657f4e12a69fd49ef94b46db3028a6c62cc209f450fca7e790559613d6374d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:45.688092+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive