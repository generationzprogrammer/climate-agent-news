{"text_id": "text_cec7dd217c5d29fa7e7e", "record_id": "article_cec7dd217c5d29fa", "canonical_url": "https://insideclimatenews.org/news/22102025/dallas-startup-3d-solar-towers", "publisher_url": "https://insideclimatenews.org/news/22102025/dallas-startup-3d-solar-towers", "title_original": "A Dallas Startup Raises $5.5 Million to Build 3-D Solar Towers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-22T08:55:00+00:00", "source_text": "DALLAS—Texas has more solar power than anywhere else in the U.S. But there’s plenty of opposition to the energy resource that’s credited with helping avoid the risk of summer blackouts this year. Chief among these criticisms is the issue of land. More often than not, roofs and lots end up often being finite spaces. For […]", "text_kind": "source_excerpt", "text_characters": 324, "text_sha256": "41386dc24ac2dec2aea61ba12fe4a90d9fe262303fd10cfd69150f1afa8fde8e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:02.818588+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 22, "end": 27, "evidence": "DALLAS—Texas has more solar power than anywhere else in the U.S. But there’s plenty of opposition to the energy resource that’s credited with helping avoid the risk of"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:02.836782+00:00", "published_at_raw": "2025-10-22T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 7, "end": 12, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_af24d235cf8a5bde09a0", "record_id": "article_af24d235cf8a5bde", "canonical_url": "https://www.carbonbrief.org/analysis-just-28-of-countries-have-released-nature-pledges-a-year-after-un-deadline", "publisher_url": "https://www.carbonbrief.org/analysis-just-28-of-countries-have-released-nature-pledges-a-year-after-un-deadline", "title_original": "Analysis: Just 28% of countries have released nature pledges a year after UN deadline", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-22T08:00:31+00:00", "source_text": "Just 28% of countries have met a UN call to submit new plans on addressing nature loss – a year after the original deadline, Carbon Brief analysis shows. Several of the world’s most biodiverse countries – including Brazil, the Democratic Republic of the Congo and South Africa – are among those that have not yet released their nature plans. Countries were asked to submit their pledges, known as national biodiversity strategies and action plans (NBSAPs), by the start of the COP16 biodiversity summit in Colombia on 21 October 2024. After only 15% of nations met the original deadline, countries agreed at the summit to a new text that “urges” countries to release their NBSAPs “as soon as possible”.", "text_kind": "article_excerpt", "text_characters": 702, "text_sha256": "b992978f1a00069f6faca80ec34005879047cffd87a7648c71753fb368d51b82", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:59.745973+00:00", "extractor_version": "1.0.0", "document_type": "commentary_or_analysis", "document_type_basis": "explicit_title_prefix", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "28%", "start": 5, "end": 8, "evidence": "Just 28% of countries have met a UN call to submit new plans on addressing nature loss – a year after the original deadline, Carbon Brief analysis shows.", "interpretation": "not_classified"}, {"value_text": "15%", "start": 546, "end": 549, "evidence": " After only 15% of nations met the original deadline, countries agreed at the summit to a new text that “urges” countries to release their NBSAPs “as soon as possible”.", "interpretation": "not_classified"}], "conference_ids": ["COP16"], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa"}, {"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "negotiations", "country_mentions": [{"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa"}, {"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:59.799497+00:00", "published_at_raw": "2025-10-22T08:00:31", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 215, "end": 221, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)", "start": 227, "end": 259, "matched_text": "Democratic Republic of the Congo", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa", "start": 264, "end": 276, "matched_text": "South Africa", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 506, "end": 514, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_62bc6e0277db5b62600c", "record_id": "article_62bc6e0277db5b62", "canonical_url": "https://insideclimatenews.org/news/21102025/todays-climate-alaska-flood-typhoon-halong-evacuation-recovery", "publisher_url": "https://insideclimatenews.org/news/21102025/todays-climate-alaska-flood-typhoon-halong-evacuation-recovery", "title_original": "Evacuating Remote Alaska Was Hard. Rebuilding Will Be Even Harder.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-21T21:03:47+00:00", "source_text": "When the remnants of a deadly typhoon slammed Western Alaska’s Yukon-Kuskokwim Delta a week and a half ago, it brought hurricane-force winds and catastrophic flooding to the remote area. More than 1,500 people were evacuated from small villages scattered across this part of the Alaskan tundra, an extremely difficult process in an area only reachable […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "86a459e3e02da1587c5d87cd4738347b98be26eda8c94e1ab4bd847ff85def9d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:02.911482+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 158, "end": 163, "evidence": "-Kuskokwim Delta a week and a half ago, it brought hurricane-force winds and catastrophic flooding to the remote area. More than 1,500 people were evacuated from small villages scattered across this part of the Alaskan tundra, an extre"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:02.924129+00:00", "published_at_raw": "2025-10-21T21:03:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_4f84e557445c15510888", "record_id": "article_4f84e557445c1551", "canonical_url": "https://yaleclimateconnections.org/2025/10/tropical-storm-melissa-on-track-to-be-a-dangerous-caribbean-hurricane", "publisher_url": "https://yaleclimateconnections.org/2025/10/tropical-storm-melissa-on-track-to-be-a-dangerous-caribbean-hurricane", "title_original": "Tropical Storm Melissa on track to be a dangerous Caribbean hurricane", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-21T20:12:59+00:00", "source_text": "It’s still uncertain which way Melissa will track, and how quickly, but the storm is likely to bring colossal rains and life-threatening flooding to multiple islands in the Caribbean.", "text_kind": "source_excerpt", "text_characters": 183, "text_sha256": "d02017c7ce213b55a85cb644cfe54dfc5e920af2e40012895f0209a656521e1f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:59.885840+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 137, "end": 142, "evidence": "ck, and how quickly, but the storm is likely to bring colossal rains and life-threatening flooding to multiple islands in the Caribbean."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:59.933803+00:00", "published_at_raw": "2025-10-21T20:12:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_1f6294dcf48f3043a304", "record_id": "article_1f6294dcf48f3043", "canonical_url": "https://insideclimatenews.org/news/21102025/new-england-merrimack-station-coal-plant-closes", "publisher_url": "https://insideclimatenews.org/news/21102025/new-england-merrimack-station-coal-plant-closes", "title_original": "New England Says Goodbye to Coal as Merrimack Station Powers Down", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-21T08:55:00+00:00", "source_text": "The towering smokestacks of New England’s last coal-fired power plant have gone quiet. Merrimack Station in Bow, New Hampshire, shut down in September, years ahead of its scheduled closure, marking the end of coal-fired energy production in the region. Merrimack Station had supplied electricity to the region since the 1960s. But as coal’s financial viability […]", "text_kind": "source_excerpt", "text_characters": 364, "text_sha256": "4c322fde4b8502b3dc5c774c4e73fe4aff729434ca31526185fe32f566d2c5ab", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:03.048566+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 47, "end": 51, "evidence": "The towering smokestacks of New England’s last coal-fired power plant have gone quiet. Merrimack Station in Bow, New Hampshire, shut down in September, years ahead of its scheduled closure, m"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:03.060734+00:00", "published_at_raw": "2025-10-21T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 4, "end": 11, "matched_text": "England", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 32, "end": 39, "matched_text": "England", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
