{"text_id": "text_a4fb939807c639271a0a", "record_id": "article_a4fb939807c63927", "canonical_url": "https://news.mongabay.com/2026/10/as-sand-becomes-more-valuable-sierra-leones-mahera-coast-grows-more-vulnerable", "publisher_url": "https://news.mongabay.com/2026/10/as-sand-becomes-more-valuable-sierra-leones-mahera-coast-grows-more-vulnerable", "title_original": "As sand becomes more valuable, Sierra Leone’s Mahera Coast grows more vulnerable", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-13T17:27:17+00:00", "source_text": "PORT LOKO, Sierra Leone — When the tide pulls away from the beach in the agricultural regions in Mahera in Lungi, about 27 kilometers (17 miles) across the sea from the country’s capital, Freetown, the digging commences. Young men shovel sand into cement bags and carry them to a flat open area to pile sand […]", "text_kind": "source_excerpt", "text_characters": 311, "text_sha256": "d46d510fd3c70caa0f2ef253031b6308976a96f9be2a93d299d3f8226019cc64", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:33.373976+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "SL", "alpha3": "SLE", "name_zh": "塞拉利昂", "name_en": "Sierra Leone"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "SL", "alpha3": "SLE", "name_zh": "塞拉利昂", "name_en": "Sierra Leone"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:33.400220+00:00", "published_at_raw": "2026-10-13T17:27:17", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "SL", "alpha3": "SLE", "name_zh": "塞拉利昂", "name_en": "Sierra Leone", "start": 31, "end": 43, "matched_text": "Sierra Leone", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "SL", "alpha3": "SLE", "name_zh": "塞拉利昂", "name_en": "Sierra Leone", "start": 11, "end": 23, "matched_text": "Sierra Leone", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_6738e63e25521acf769c", "record_id": "article_6738e63e25521acf", "canonical_url": "https://insideclimatenews.org/news/11102026/greece-ambracian-gulf-fish-farming", "publisher_url": "https://insideclimatenews.org/news/11102026/greece-ambracian-gulf-fish-farming", "title_original": "The Greek National Park Suffocated by Fish Farming", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-11T09:00:00+00:00", "source_text": "This story is part of an investigation conducted by an international team of journalists based at The Outlaw Ocean Project. Read the other stories here. For two thousand years, the Ambracian Gulf in western Greece provided life to its Mediterranean neighbors. Today, it’s an industrial graveyard. Trace the Gulf’s northern coast, and you’ll uncover beaches […]", "text_kind": "source_excerpt", "text_characters": 360, "text_sha256": "3ce576375e691453aa332aea8714a72dfdd6770e932142acc930d3f6907224f3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:35.341849+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GR", "alpha3": "GRC", "name_zh": "希腊", "name_en": "Greece"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GR", "alpha3": "GRC", "name_zh": "希腊", "name_en": "Greece"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:35.353839+00:00", "published_at_raw": "2026-10-11T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GR", "alpha3": "GRC", "name_zh": "希腊", "name_en": "Greece", "start": 207, "end": 213, "matched_text": "Greece", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_e235a39e528ff9facba3", "record_id": "article_e235a39e528ff9fa", "canonical_url": "https://yaleclimateconnections.org/2026/10/hurricane-isaias-steadily-intensifying-over-record-warm-gulf-waters", "publisher_url": "https://yaleclimateconnections.org/2026/10/hurricane-isaias-steadily-intensifying-over-record-warm-gulf-waters", "title_original": "Hurricane Isaias steadily intensifying over record-warm Gulf waters", "title_zh": "飓风伊萨亚斯在创纪录温暖的墨西哥湾水域持续增强", "title_en": null, "summary_zh": "飓风伊萨亚斯在墨西哥湾创纪录温暖的海水表面持续增强，已升级为二级飓风，中心附近最大持续风速达到每小时 100 英里。该飓风预计将于周五晚间在密西西比河口至佛罗里达州苏万尼之间登陆，届时可能带来严重的风暴潮灾害。", "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-08T22:44:07+00:00", "source_text": "Hurricane warnings are flying for portions of Mississippi, Alabama, and the Florida Panhandle as steadily intensifying Hurricane Isaias heads towards an anticipated Friday night landfall. Isaias became the first hurricane of the 2026 Atlantic hurricane season on Wednesday night, 57 days later than the typical formation date for the season’s first hurricane. This was the latest date since 1914 for the Atlantic’s first hurricane (no hurricanes and just one tropical storm occurred that year). Isaias’s 40 mph increase in intensity in the 24 hours ending at 5 a.m. EDT Thursday exceeded the definition for rapid intensification of a 35-mph increase in winds in 24 hours. By Thursday afternoon, Isaias was a Cat 2 hurricane.", "text_kind": "article_excerpt", "text_characters": 724, "text_sha256": "4beb124e3aa55502d3da8c9c80cab2811176c43e7e588751e9e8748f5d5ce09e", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:22.755620+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:22.808779+00:00", "published_at_raw": "2026-10-08T22:44:07", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_0b4728580534618358e7", "record_id": "article_0b47285805346183", "canonical_url": "https://news.mongabay.com/2026/10/can-warwilding-defend-polands-borders-and-save-europes-last-ancient-forest", "publisher_url": "https://news.mongabay.com/2026/10/can-warwilding-defend-polands-borders-and-save-europes-last-ancient-forest", "title_original": "Can WarWilding defend Poland’s borders and save Europe’s last ancient forest?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-07T20:13:42+00:00", "source_text": "BIAŁOWIEŻA, Poland — Michal Żmihorski, deputy director of the Institute of Environmental Protection, will never forget the morning of Aug. 1, 2023. Two Belarusian helicopters entered Polish airspace, hovering above the village of Białowieża in eastern Poland, three kilometers (1.9 miles) from the Polish-Belarusian border. The panic was palpable. “We didn’t know if the invasion […]", "text_kind": "source_excerpt", "text_characters": 383, "text_sha256": "0ff6d575dfc3df1a90108f7252717290c361f3f4917e9cb75f8441c68ccbf9d3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:34.210164+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PL", "alpha3": "POL", "name_zh": "波兰", "name_en": "Poland"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PL", "alpha3": "POL", "name_zh": "波兰", "name_en": "Poland"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:34.228955+00:00", "published_at_raw": "2026-10-07T20:13:42", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PL", "alpha3": "POL", "name_zh": "波兰", "name_en": "Poland", "start": 22, "end": 28, "matched_text": "Poland", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "PL", "alpha3": "POL", "name_zh": "波兰", "name_en": "Poland", "start": 12, "end": 18, "matched_text": "Poland", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_6cad65e25e342cf48ad1", "record_id": "article_6cad65e25e342cf4", "canonical_url": "https://yaleclimateconnections.org/2026/10/she-had-unexplained-blood-pressure-fluctuations-and-bouts-of-pneumonia-it-took-years-to-learn-why", "publisher_url": "https://yaleclimateconnections.org/2026/10/she-had-unexplained-blood-pressure-fluctuations-and-bouts-of-pneumonia-it-took-years-to-learn-why", "title_original": "She had unexplained blood pressure fluctuations and bouts of pneumonia. It took years to learn why", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-07T10:59:00+00:00", "source_text": "Transcript: For years, North Carolina resident Tami McGraw struggled with unexplained medical problems. McGraw: “I kept getting sick. I had pneumonia numerous times … and I was diagnosed with asthma, and I was using inhalers. … And it was getting really scary because I had a lot of blood pressure fluctuations … and nobody really could find an answer to what was causing all my issues.” Finally, McGraw was diagnosed with alpha-gal syndrome. It’s an allergy to red meat – and sometimes to dairy – that’s caused by a lone star tick bite. She says once she understood her condition, she could start managing it. McGraw: “I was so relieved to have an answer.” And she wanted to help others who were struggling with similar symptoms or had been recently diagnosed.", "text_kind": "article_excerpt", "text_characters": 761, "text_sha256": "e319a7f8c7214f0b5a410f8a0e7ae32918d997a795ee19a620da7109fcb7f67d", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:22.980914+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:23.015792+00:00", "published_at_raw": "2026-10-07T10:59:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_8f85a335cac6b5bf044c", "record_id": "article_8f85a335cac6b5bf", "canonical_url": "https://yaleclimateconnections.org/2026/10/aumentan-las-probabilidades-de-que-un-huracan-toque-tierra-en-la-costa-estadounidense-del-golfo-de-mexico", "publisher_url": "https://yaleclimateconnections.org/2026/10/aumentan-las-probabilidades-de-que-un-huracan-toque-tierra-en-la-costa-estadounidense-del-golfo-de-mexico", "title_original": "Aumentan las probabilidades de que un huracán toque tierra en la costa estadounidense del Golfo de México", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-06T22:15:41+00:00", "source_text": "Se prevé que una depresión tropical que se está organizando sobre las aguas excepcionalmente cálidas del oeste del Golfo de México llegue como el huracán Isaias el viernes por la noche.", "text_kind": "source_excerpt", "text_characters": 185, "text_sha256": "2e8d4efd0e91cbff20b2929e604878987aea09636bb40f3817a39c9cf3f32ece", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:23.037313+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:23.048594+00:00", "published_at_raw": "2026-10-06T22:15:41", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_ec9b5256ec97c62853ca", "record_id": "article_ec9b5256ec97c628", "canonical_url": "https://yaleclimateconnections.org/2026/10/odds-of-a-u-s-gulf-coast-hurricane-landfall-are-rising", "publisher_url": "https://yaleclimateconnections.org/2026/10/odds-of-a-u-s-gulf-coast-hurricane-landfall-are-rising", "title_original": "Odds of a U.S. Gulf Coast hurricane landfall are rising", "title_zh": "美国墨西哥湾沿岸发生飓风登陆的概率正在上升", "title_en": null, "summary_zh": "墨西哥湾西部破纪录的温暖海水中正在孕育一个热带低压，预计将于周五夜间以伊萨亚斯飓风强度登陆。美国国家飓风中心预测该系统将持续增强，并于周二夜间发展为热带风暴。由于海面温度异常偏高且人为变暖推高了极端海温概率，预测模型正密切追踪其路径与强度。", "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-06T21:22:12+00:00", "source_text": "[Lee este artículo en español aquí] Residents from southeast Louisiana to the Florida Panhandle should keep close tabs on an intensifying system in the western Gulf of Mexico that was designated Tropical Depression 9 at 5 p.m. EDT Tuesday . TD 9 is predicted by the NOAA/NWS National Hurricane Center to intensify steadily, becoming a tropical storm on Tuesday night and reaching the U.S. Gulf Coast on Friday night at hurricane strength. Forecast models generally agree on a curving track across the Gulf, but there is more uncertainty around the exact timing and intensity – and in this case, the two are closely related.", "text_kind": "article_excerpt", "text_characters": 623, "text_sha256": "b750f917230e6292cf60e9acb0fadf43bab72287bb8d0892fd34729bb9b598bc", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:23.075385+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:23.092708+00:00", "published_at_raw": "2026-10-06T21:22:12", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 10, "end": 14, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 168, "end": 174, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 384, "end": 388, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_e8d1aec34bc4bb397137", "record_id": "article_e8d1aec34bc4bb39", "canonical_url": "https://news.mongabay.com/2026/10/uncertainty-mounts-as-suriname-struggles-to-evict-illegal-settlers-in-the-amazon", "publisher_url": "https://news.mongabay.com/2026/10/uncertainty-mounts-as-suriname-struggles-to-evict-illegal-settlers-in-the-amazon", "title_original": "Uncertainty mounts as Suriname struggles to evict illegal settlers in the Amazon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-05T19:03:50+00:00", "source_text": "The government in Suriname this year said it planned to evict illegal settlers in the Amazon Rainforest, and possibly send many of them back to their home countries. But eviction has proven much more complicated than it first appeared, with settlers allegedly ignoring court orders and officials expressing confusion about which people are breaking what […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "635bb8e3be95ddd4dd001d47f2165cabae4042fc4d4d73df99c103553db898f5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:39.895968+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "SR", "alpha3": "SUR", "name_zh": "苏里南", "name_en": "Suriname"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "SR", "alpha3": "SUR", "name_zh": "苏里南", "name_en": "Suriname"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:39.924082+00:00", "published_at_raw": "2026-10-05T19:03:50", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "SR", "alpha3": "SUR", "name_zh": "苏里南", "name_en": "Suriname", "start": 22, "end": 30, "matched_text": "Suriname", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "SR", "alpha3": "SUR", "name_zh": "苏里南", "name_en": "Suriname", "start": 18, "end": 26, "matched_text": "Suriname", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_3a7124bcb2a26a0059f6", "record_id": "article_3a7124bcb2a26a00", "canonical_url": "https://insideclimatenews.org/news/04102026/california-law-aims-to-stop-predatory-developers-after-disasters", "publisher_url": "https://insideclimatenews.org/news/04102026/california-law-aims-to-stop-predatory-developers-after-disasters", "title_original": "New California Law Aims to Stop ‘Predatory’ Developers From Moving in on Wildfire-Ravaged Community", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-04T09:00:00+00:00", "source_text": "ALTADENA, Calif.—Sylvie Andrews walks among the brilliant white poppies, purple California grapes and olive-green thorns surrounding her yard’s blackened pizza oven—one of the only things that survived last year’s devastating Eaton Fire. But her eyes scan the block beyond, ever-aware of changes to her neighborhood. Andrews says virtually all of her neighbors have received unsolicited […]", "text_kind": "source_excerpt", "text_characters": 390, "text_sha256": "abf867b017474e83b782199f3476ebf0f5bf667c08e1a554706c791b582316f9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:42.246423+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:42.260279+00:00", "published_at_raw": "2026-10-04T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 4, "end": 14, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 80, "end": 90, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_b51b6346f337aa2d8a3f", "record_id": "article_b51b6346f337aa2d", "canonical_url": "https://insideclimatenews.org/news/03102026/nature-protections-could-drive-down-home-insurance-costs", "publisher_url": "https://insideclimatenews.org/news/03102026/nature-protections-could-drive-down-home-insurance-costs", "title_original": "‘Nature-Based’ Solutions Could Save Insurers and Policyholders Billions", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-03T09:00:00+00:00", "source_text": "After years trudging through marshes around San Francisco Bay studying conservation practices, coastal ecologist Megan Kelso realized that one of the largest determinants of wetland health may not be an invasive species lurking with her among the sea grasses, but decisions made miles away in the executive suites of insurance companies. Wetlands absorb massive volumes […]", "text_kind": "source_excerpt", "text_characters": 373, "text_sha256": "482e17e5b177a03db272acd74f74b22bcfbbf83e76fedc6fa7f5cea5623d95e4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:42.305924+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:42.319235+00:00", "published_at_raw": "2026-10-03T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_6f41724ba46be4c531a0", "record_id": "article_6f41724ba46be4c5", "canonical_url": "https://news.mongabay.com/2026/10/vietnams-fishers-face-rising-costs-declining-catches-and-a-contested-sea", "publisher_url": "https://news.mongabay.com/2026/10/vietnams-fishers-face-rising-costs-declining-catches-and-a-contested-sea", "title_original": "Vietnam’s fishers face rising costs, declining catches and a contested sea", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-02T18:01:16+00:00", "source_text": "QUANG NGAI, Vietnam — When diesel prices in Vietnam hit an all-time high in March, Vo Huu Viet, a fisherman with more than 30 years at sea in Quang Ngai province in Central Vietnam, did something he rarely does. He stayed on shore. “The catch is simply not enough to make up for the labor of […]", "text_kind": "source_excerpt", "text_characters": 295, "text_sha256": "9abcac5c1b8465e5657834acbdb34732c38e690275b408b117c77f93598c4334", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:39.999211+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "VN", "alpha3": "VNM", "name_zh": "越南", "name_en": "Vietnam"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "VN", "alpha3": "VNM", "name_zh": "越南", "name_en": "Vietnam"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_