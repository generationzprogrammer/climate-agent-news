{"text_id": "text_d2b270978614104fcc12", "record_id": "article_d2b270978614104f", "canonical_url": "https://insideclimatenews.org/news/11022024/30-years-of-us-environmental-justice-in-port-arthur-texas", "publisher_url": "https://insideclimatenews.org/news/11022024/30-years-of-us-environmental-justice-in-port-arthur-texas", "title_original": "‘A Dream Deferred:’ 30 Years of U.S. Environmental Justice in Port Arthur, Texas", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-11T10:05:00+00:00", "source_text": "PORT ARTHUR, Tex.—Downtown Port Arthur has the feel of a ghost town, until you look to the horizon. Boarded-up buildings stand next to vacant lots, like missing teeth in a smile that faded decades ago. There are few people on the sidewalks, and 10 minutes can pass before a single car drives by on Proctor […]", "text_kind": "source_excerpt", "text_characters": 309, "text_sha256": "a634e10d996475d143f12841733faf2eec96354f5ecb71e687a7d7267544ad8a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:32.860111+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_sourc