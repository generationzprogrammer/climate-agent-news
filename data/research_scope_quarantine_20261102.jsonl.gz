{"text_id": "text_4dc325ededaf28c7ee81", "record_id": "article_4dc325ededaf28c7", "canonical_url": "https://insideclimatenews.org/news/22082025/judge-orders-alligator-alcatraz-to-wind-down-environmental-concerns", "publisher_url": "https://insideclimatenews.org/news/22082025/judge-orders-alligator-alcatraz-to-wind-down-environmental-concerns", "title_original": "Citing Environmental Concerns, Judge Orders Alligator Alcatraz to Wind Down Operations", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-22T21:58:35+00:00", "source_text": "A federal judge has ordered a winding down of operations at Florida’s Alligator Alcatraz, the hastily assembled Everglades detention site where the Trump administration aims to incarcerate thousands of undocumented migrants before deporting them. Judge Kathleen Williams Thursday granted a preliminary injunction for environmental groups and the Miccosukee Tribe, which had sued to stop the […]", "text_kind": "source_excerpt", "text_characters": 394, "text_sha256": "44c35057f7e1e345f114991474930b085a33776f4bf16b73d7bf34a21b36c0b7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:54.935580+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 217, "end": 222, "evidence": "ntion site where the Trump administration aims to incarcerate thousands of undocumented migrants before deporting them. Judge Kathleen Williams Thursday granted a preliminary injunction for environmental groups and the Miccosukee Tribe"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:54.956520+00:00", "published_at_raw": "2025-08-22T21:58:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_93632384fb2e0258f7c9", "record_id": "article_93632384fb2e0258", "canonical_url": "https://insideclimatenews.org/news/22082025/phillips-la-refinery-closure-cleanup", "publisher_url": "https://insideclimatenews.org/news/22082025/phillips-la-refinery-closure-cleanup", "title_original": "There’s a ‘Lake’ of Oil Under LA’s Soon-to-Close Refinery. Who’s Going to Clean It Up?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-22T08:50:00+00:00", "source_text": "This story was originally published by Capital & Main. One of Los Angeles County’s most polluted stretches of land will soon be cleared for new development, and a full accounting of the ground’s degradation will be left largely to an oil company. For almost 40 years in the middle of the 20th century, workers at an oil refinery […]", "text_kind": "source_excerpt", "text_characters": 332, "text_sha256": "f59714054cfb96bc2079c18a767978f1de871a1850d4ab33ffeb42aea1d788a1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:55.134098+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "