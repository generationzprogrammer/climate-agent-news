{"text_id": "text_4f453f7dbce5969f70c0", "record_id": "article_4f453f7dbce5969f", "canonical_url": "https://insideclimatenews.org/news/21042025/mari-luz-canaquiri-murayari-wins-goldman-prize-peru-rights-of-nature", "publisher_url": "https://insideclimatenews.org/news/21042025/mari-luz-canaquiri-murayari-wins-goldman-prize-peru-rights-of-nature", "title_original": "Rights of Nature Defender Wins Goldman Prize for Precedent-Setting Work Protecting an Imperiled River", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-21T07:30:00+00:00", "source_text": "Mari Luz Canaquiri Murayari, an Indigenous Kukama leader from the Peruvian Amazon, has been awarded the prestigious Goldman Environmental Prize for her decades-long fight to protect the Marañón River, home to her peoples’ ancestors and a lifesource for rainforest ecosystems that keep the world livable. The award, announced Monday, recognizes her leadership in advancing the […]", "text_kind": "source_excerpt", "text_characters": 379, "text_sha256": "d890b8e938e5eadb57b97379f9c81de8ae31885ffcecc4a9769f3ce0178c2c54", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:12.928287+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 32, "end": 42, "evidence": "Mari Luz Canaquiri Murayari, an Indigenous Kukama leader from th