{"text_id": "text_dac07c8174d19d782403", "record_id": "article_dac07c8174d19d78", "canonical_url": "https://news.mongabay.com/2026/10/the-women-keeping-uttarakhands-native-bees-alive", "publisher_url": "https://news.mongabay.com/2026/10/the-women-keeping-uttarakhands-native-bees-alive", "title_original": "The women keeping Uttarakhand’s native bees alive", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-20T17:58:40+00:00", "source_text": "PITHORAGARH, Uttarakhand, India — The world comes alive during summers in Himalayan states like Uttarakhand. The forests are budding with new green leaves, and almost every trail is lined on both sides with flowers of many shapes, sizes and colors. With the flora, fauna comes to life as well. Saraswati Devi, 80, sits in her […]", "text_kind": "source_excerpt", "text_characters": 329, "text_sha256": "604305d1e20573d8d54b129971d4d2cc6c2ed0ac8c6bd62238b51510b66f961d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:26.951568+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_sou