{"text_id": "text_41cb44e13d7e0bddf577", "record_id": "article_41cb44e13d7e0bdd", "canonical_url": "https://insideclimatenews.org/news/27102026/governor-races-energy-future", "publisher_url": "https://insideclimatenews.org/news/27102026/governor-races-energy-future", "title_original": "The High-Stakes Governors’ Races That Could Reshape America’s Energy Future", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-27T22:18:39+00:00", "source_text": "The right governor can put a state on a dramatically different energy and environmental path—and next week’s election could set the stage for major policy shifts across the country. Democrats are favored to retain governorships in Arizona, Michigan, Pennsylvania, and Wisconsin, according to Sabato’s Crystal Ball at the University of Virginia. The party is also […]", "text_kind": "source_excerpt", "text_characters": 366, "text_sha256": "782cb410be7a11da72657a8bdaf2ad2c2fbf42c80e3f224dd9142aa5d6d61432", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:25.807188+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 63, "end": 69, "evidence": "The right governor can put a state on a dramatically different energy and environmental path—and next week’s election could set the stage for major policy shifts across the country. Democrats are favored to re"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:25.820580+00:00", "published_at_raw": "2026-10-27T22:18:39", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_9f4ab0fe515e49bda08e", "record_id": "article_9f4ab0fe515e49bd", "canonical_url": "https://news.mongabay.com/2026/10/influence-without-enforcement-indonesias-fires-test-singapores-anti-haze-law", "publisher_url": "https://news.mongabay.com/2026/10/influence-without-enforcement-indonesias-fires-test-singapores-anti-haze-law", "title_original": "‘Influence without enforcement’: Indonesia’s fires test Singapore’s anti-haze law", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-27T11:11:55+00:00", "source_text": "SINGAPORE — As Singapore comes off its longest streak of unhealthy air since the 2015 Southeast Asian haze crisis, authorities have served notices to 20 firms linked to Indonesia’s fires, but have stopped short of taking further legal action. Half of the notices were sent to concession holders in Sumatra and Kalimantan where the fires […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "8714ebcfe18529f91d9d1c04578be249e239f40a8503314f5767453268d4cee8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:20.552307+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "SG", "alpha3": "SGP", "name_zh": "新加坡", "name_en": "Singapore"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "SG", "alpha3": "SGP", "name_zh": "新加坡", "name_en": "Singapore"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:20.596219+00:00", "published_at_raw": "2026-10-27T11:11:55", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 33, "end": 42, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "SG", "alpha3": "SGP", "name_zh": "新加坡", "name_en": "Singapore", "start": 56, "end": 65, "matched_text": "Singapore", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "SG", "alpha3": "SGP", "name_zh": "新加坡", "name_en": "Singapore", "start": 0, "end": 9, "matched_text": "SINGAPORE", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 169, "end": 178, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_4a128fb33156be54c02e", "record_id": "article_4a128fb33156be54", "canonical_url": "https://yaleclimateconnections.org/2026/10/can-we-harness-the-oceans-energy", "publisher_url": "https://yaleclimateconnections.org/2026/10/can-we-harness-the-oceans-energy", "title_original": "Can we harness the oceans’ energy?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-27T10:59:00+00:00", "source_text": "Earth’s oceans hold a tremendous amount of energy, both in the waves that traverse vast distances and then break against shores, and in the tides that move massive volumes of water in two directions twice every day of every year. Surely we can harness some of that energy for human use! So far, though, we have managed this feat only on small scales and mostly for short periods of time. This list of articles and resources will give you a sense of the state of the field These two older stories from Canary Media do an excellent job of outlining the overall situation. Each focuses on a single project while also describing both the seemingly great potential of ocean energy and the many barriers to harnessing that energy. “ Can shore-based wave power unlock clean, affordable ocean energy?", "text_kind": "article_excerpt", "text_characters": 792, "text_sha256": "7ac1f935cbc3f779a3f6807b5142568327baab60e249aa4df96aa5c995aeb1af", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:21.190100+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 43, "end": 49, "evidence": "Earth’s oceans hold a tremendous amount of energy, both in the waves that traverse vast distances and then break against shores, and in the tides that move massive volumes of water in two d"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:21.231402+00:00", "published_at_raw": "2026-10-27T10:59:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_29d9fd6f7e1d358a5b35", "record_id": "article_29d9fd6f7e1d358a", "canonical_url": "https://news.mongabay.com/2026/10/a-rare-victory-for-multilateralism-in-the-fight-against-environmental-crime-commentary", "publisher_url": "https://news.mongabay.com/2026/10/a-rare-victory-for-multilateralism-in-the-fight-against-environmental-crime-commentary", "title_original": "A rare victory for multilateralism in the fight against environmental crime (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-26T20:20:26+00:00", "source_text": "Multilateralism has had a miserable few years. International institutions are under strain, geopolitical rivalries are intensifying and governments struggle to agree on even the most elementary rules. Governments struggle to agree on even elementary rules. Yet last week in Vienna, there was an unexpected breakthrough. Countries agreed to begin negotiating a global treaty to tackle […]", "text_kind": "source_excerpt", "text_characters": 387, "text_sha256": "58ace7bfa191c50b79e018d8a030c4ac89256655b4269a5824971e6fbf2422c0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:20.629835+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:20.661435+00:00", "published_at_raw": "2026-10-26T20:20:26", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_4b2e9c2e64df3b5842ff", "record_id": "article_4b2e9c2e64df3b58", "canonical_url": "https://insideclimatenews.org/news/23102026/researchers-find-widespread-pfas-contamination-in-florida-waterways", "publisher_url": "https://insideclimatenews.org/news/23102026/researchers-find-widespread-pfas-contamination-in-florida-waterways", "title_original": "Researchers Find Widespread PFAS Contamination in Florida Waterways", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-23T09:00:00+00:00", "source_text": "A new report suggests dozens of “forever chemicals” linked with cancer and other human health problems are prevalent in Florida waterways, reflecting widespread contamination of the toxic chemicals in streams, rivers and lakes across the country. Roughly 96 percent of 23 Florida waterways tested between 2022 and 2024 contained 43 different kinds of PFAS, according […]", "text_kind": "source_excerpt", "text_characters": 370, "text_sha256": "6ac566dd21ac574b7f0ca6b7c90340da6c30ee6491b81a6c78eff6dc90bd6960", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:26.411366+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "96 percent", "start": 255, "end": 265, "evidence": " Roughly 96 percent of 23 Florida waterways tested between 2022 and 2024 contained 43 different kinds of PFAS, according […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:26.426354+00:00", "published_at_raw": "2026-10-23T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_eb7fe556be912c01a92f", "record_id": "article_eb7fe556be912c01", "canonical_url": "https://insideclimatenews.org/news/23102026/pennsylvania-data-centers-congressional-elections", "publisher_url": "https://insideclimatenews.org/news/23102026/pennsylvania-data-centers-congressional-elections", "title_original": "Data Centers Are ‘Front and Center’ in Pennsylvania’s Competitive Congressional Elections", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-23T08:55:00+00:00", "source_text": "ALLENTOWN, Pa.—In all her 38 years living in South Whitehall Township in the Lehigh Valley, Laurie Gilley had never attended a municipal meeting, much less gotten involved in the politics of her community. But then she learned that a data center was being planned for 400 acres of land across from her home and the […]", "text_kind": "source_excerpt", "text_characters": 318, "text_sha256": "b79878c59b7061878dd619998f89bf1e135e3aa335a72f6df2dd8e976b741c20", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:26.481975+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_c