{"text_id": "text_f0a372f70796259768e3", "record_id": "article_f0a372f707962597", "canonical_url": "https://insideclimatenews.org/news/15042025/interior-secretary-doug-burgum-visits-alabama-coal-mine-safety-violations", "publisher_url": "https://insideclimatenews.org/news/15042025/interior-secretary-doug-burgum-visits-alabama-coal-mine-safety-violations", "title_original": "Trump Official Visits, Touts Alabama Coal Mine With Thousands of Federal Safety Violations", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-15T17:12:14+00:00", "source_text": "TUSCALOOSA, Ala.—When Secretary of the Interior Doug Burgum visited two Warrior Met coal mines in central Alabama last week, he said he was emphasizing the administration’s commitment to “clean, beautiful coal” and its plans to roll back regulation. The department’s press office swiftly posted on social media after the trip his ultimate goal: “Mine, Baby, […]", "text_kind": "source_excerpt", "text_characters": 361, "text_sha256": "adb8886a3f9ec533e74a8fe7bed0107aa4fab5b28bf2f85f390bfaf348cb1908", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:21.374606+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 84, "end": 88, "evidence": "TUSCALOOSA, Ala.—When Secretary of the Interior Doug Burgum visited two Warrior Met coal mines in central Alabama last week, he said he was emphasizing the administration’s commitment to “clean, beautiful coal” and its plans to "}], "policy_tools": [{"id": "standards", "label_zh": "标准与监管", "label_en": "Standards and regulation", "start": 238, "end": 248, "evidence": "ing the administration’s commitment to “clean, beautiful coal” and its plans to roll back regulation. The department’s press office swiftly posted on social media after the trip his ultimate goal: “Mine, Baby, […]"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:21.386950+00:00", "published_at_raw": "2025-04-15T17:12:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
