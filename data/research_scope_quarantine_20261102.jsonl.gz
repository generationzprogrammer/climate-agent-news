{"text_id": "text_1fd1bd201ba4ea647702", "record_id": "article_1fd1bd201ba4ea64", "canonical_url": "https://insideclimatenews.org/news/28032024/midwest-early-wildfire-season", "publisher_url": "https://insideclimatenews.org/news/28032024/midwest-early-wildfire-season", "title_original": "From Michigan to Nebraska, Midwest States Face an Early Wildfire Season", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-28T09:05:00+00:00", "source_text": "The Midwest received some much needed moisture this week following an especially hot and dry winter that hamstrung outdoor recreation and sparked an early spring wildfire season in several states. Parts of the Midwest saw as much as 24 inches of snow and rain by Wednesday morning, according to the National Weather Service. The powerful […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "697b8a2cd32213f657c1b195471276f20a72433523a7e6066edb8624899799e7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:11.817001+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 162, "end": 170, "evidence": "pecially hot and dry winter that hamstrung outdoor recreation and sparked an early spring wildfire season in several states. Parts of the Midwest saw as much as 24 inches of snow and rain by Wednesday morning, according to the National We"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:11.838002+00:00", "published_at_raw": "2024-03-28T09:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_f5000d04772fa14d8189", "record_id": "article_f5000d04772fa14d", "canonical_url": "https://news.mongabay.com/2024/03/previously-logged-forests-struggle-to-thrive-even-with-restoration-study-finds", "publisher_url": "https://news.mongabay.com/2024/03/previously-logged-forests-struggle-to-thrive-even-with-restoration-study-finds", "title_original": "Previously logged forests struggle to thrive, even with restoration, study finds", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-27T18:22:55+00:00", "source_text": "Young trees face significant challenges surviving in previously logged forests compared to intact forests, even in areas with active restoration efforts, according to a recent study. The findings, published in the journal Global Change Biology, raise concerns about the long-term recovery of biodiversity in logged forests. This concern is growing as human-modified forests now exceed […]", "text_kind": "source_excerpt", "text_characters": 388, "text_sha256": "5d3434120a0e4e0f450529c6750d7e2b2e36d6c8d02cb37c4cb7210aa78e65a8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:52.556909+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "a