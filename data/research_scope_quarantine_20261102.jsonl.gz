{"text_id": "text_855c9bfcb2a1b34a5ea5", "record_id": "article_855c9bfcb2a1b34a", "canonical_url": "https://news.mongabay.com/2024/12/why-are-canadian-moose-declining-interviews-with-indigenous-communities-offer-new-clues", "publisher_url": "https://news.mongabay.com/2024/12/why-are-canadian-moose-declining-interviews-with-indigenous-communities-offer-new-clues", "title_original": "Why are Canadian moose declining? Interviews with Indigenous communities offer new clues", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-12-04T01:00:47+00:00", "source_text": "As one of the most iconic creatures in their ecosystems, moose have lumbered their way into the fabric of Canadian culture in Ontario. Recreational hunting, Indigenous well-being and the region’s ecosystem health all depend on these antlered giants. But in the last two decades, their population has declined by 20 percent. Now, a new collaboration […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "e342d5be98abc737b2d76a61969ef1565c5256f5c47d1fa3866904e932f53ca3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:46.293496+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "20 percent", "start": 312, "end": 322, "evidence": " But in the last two decades, their population has declined by 20 percent.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 157, "end": 167, "evidence": " lumbered their way into the fabric of Canadian culture in Ontario. Recreational hunting, Indigenous well-being and the region’s ecosystem health all depend on these antlered giants. But in the last two decades, their population has decline"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:46.308139+00:00", "published_at_raw": "2024-12-04T01:00:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_c8143c89b296fafae63a", "record_id": "article_c8143c89b296fafa", "canonical_url": "https://news.mongabay.com/2024/12/how-are-mangrove-restoration-projects-doing-interview-with-tom-worthington", "publisher_url": "https://news.mongabay.com/2024/12/how-are-mangrove-restoration-projects-doing-interview-with-tom-worthington", "title_original": "How are mangrove restoration projects doing? Interview with Tom Worthington", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-12-03T14:10:03+00:00", "source_text": "Where are mangrove restoration projects taking place? How many of them are successful? If they’ve failed, what happened? Finding answers to these questions isn’t easy. But those answers are critical to track how the world is working to protect a fast-degrading ecosystem. A team of researchers and conservationists have now developed a tool to streamline […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "389e1d092a9937c59ea0e23d0f7509c8f39551241d70801447f0db45fba997f4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:46.367708+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mong