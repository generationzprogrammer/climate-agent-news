{"text_id": "text_c3fb930c285d79ead482", "record_id": "article_c3fb930c285d79ea", "canonical_url": "https://news.mongabay.com/2025/04/orangutan-habitat-under-siege-as-palm-oil-company-clears-forest-in-borneo", "publisher_url": "https://news.mongabay.com/2025/04/orangutan-habitat-under-siege-as-palm-oil-company-clears-forest-in-borneo", "title_original": "Orangutan habitat under siege as palm oil company clears forest in Borneo", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-29T02:45:26+00:00", "source_text": "JAKARTA — A palm oil company is gearing up to expand into critical orangutan habitat in Indonesian Borneo, raising alarms over the survival of the critically endangered great apes. PT Equator Sumber Rezeki (ESR) is part of Jakarta-based First Borneo Group, which is currently one of the most active deforesters in Indonesia’s palm oil industry. […]", "text_kind": "source_excerpt", "text_characters": 348, "text_sha256": "972c2c70e286ae4b849038414c1670b842db09368208f78adf595c7db2ae3578", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:29.418006+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotati