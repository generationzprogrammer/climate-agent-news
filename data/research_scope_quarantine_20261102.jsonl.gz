{"text_id": "text_58526074bbd3f049fadd", "record_id": "article_58526074bbd3f049", "canonical_url": "https://insideclimatenews.org/news/01062024/florida-homebuyers-flood-history-law", "publisher_url": "https://insideclimatenews.org/news/01062024/florida-homebuyers-flood-history-law", "title_original": "New Law to Provide Florida Homebuyers With More Transparency on Flood History", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-01T09:05:00+00:00", "source_text": "ORLANDO, Fla.—For the first time, Florida home sellers will have to disclose certain aspects of a property’s flood history, under legislation Gov. Ron DeSantis signed into law this week. The measure is seen as an important step toward addressing growth and development in risky areas, an issue that has gained prominence since Hurricane Ian dropped […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "d3f961e11af7e8f37af60a25605bb023523f4c2b8f2c54110215f9012a54bbfb", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:43.277345+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 109, "end": 114, "evidence": "he first time, Florida home sellers will have to disclose certain aspects of a property’s flood history, under legislation Gov. Ron DeSantis signed into law this week. The measure is seen as an important step toward addressing growth a"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:43.293956+00:00", "published_at_raw": "2024-06-01T09:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_d543f96351aef634f056", "record_id": "article_d543f96351aef634", "canonical_url": "https://insideclimatenews.org/news/31052024/biden-administration-offshore-wind-challenges", "publisher_url": "https://insideclimatenews.org/news/31052024/biden-administration-offshore-wind-challenges", "title_original": "Is US Offshore Wind Dead in the Water—Or Just Poised for the Next Big Gust?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-31T09:00:00+00:00", "source_text": "This story was originally published by Floodlight. In the early 2000s, a long-time Louisiana engineer and entrepreneur thought it would be natural for the oil and gas industry in the Gulf of Mexico to expand into offshore wind. The industry could use the same workforce, the same shipyards and possibly even the same platforms to generate […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "5dcf29f91540b49b314554af552afc17b5c2375011b01b1bf55b95d0d497a4bf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:43.447870+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 39, "end": 44, "evidence": "This story was originally published by Floodlight. In the early 2000s, a long-time Louisiana engineer and entrepreneur thought it would be natural for the oil and gas industry in the G"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:43.464601+00:00", "published_at_raw": "2024-05-31T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 3, "end": 5, "matched_text": "US", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 191, "end": 197, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_d4a0142db22bc6dfac13", "record_id": "article_d4a0142db22bc6df", "canonical_url": "https://news.mongabay.com/2024/05/an-ancestral-solution-ensures-water-for-peruvian-alpaca-farmers-but-is-it-enough", "publisher_url": "https://news.mongabay.com/2024/05/an-ancestral-solution-ensures-water-for-peruvian-alpaca-farmers-but-is-it-enough", "title_original": "An ancestral solution ensures water for Peruvian alpaca farmers, but is it enough?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-30T14:59:16+00:00", "source_text": "In Ayacucho province in Peru’s southern Andes, a three-hour drive from the provincial capital, Huamanga, stands the snowcapped mountain of Rit’ipata, popular among tourists. Every January, high summer in the Southern Hemisphere, groups of young people climb its peak to take photos and play in the snow. But what they don’t know is that the […]", "text_kind": "source_excerpt", "text_characters": 344, "text_sha256": "b742dd10734fc01693ed59941d2d8c6ec297e1e6849031f4bd7493127713765b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:20.162191+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:20.179068+00:00", "published_at_raw": "2024-05-30T14:59:16", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru", "start": 24, "end": 28, "matched_text": "Peru", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_daf3ac17da3d36f63907", "record_id": "article_daf3ac17da3d36f6", "canonical_url": "https://news.mongabay.com/2024/05/floods-set-to-worsen-on-sumatra-peat-as-landscape-gives-way", "publisher_url": "https://news.mongabay.com/2024/05/floods-set-to-worsen-on-sumatra-peat-as-landscape-gives-way", "title_original": "Floods set to worsen on Sumatra peat as landscape gives way", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-30T02:31:25+00:00", "source_text": "PEKANBARU, Indonesia — Traffic stopped gradually, then suddenly, as the new year approached around an hour’s drive out of the city of Pekanbaru here on the Indonesian island of Sumatra. Within minutes, the arterial highway linking the island’s east and west coasts turned into a dark river. “The problem is complex,” said Sigit Sutikno, a […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "537e8164dcabaab04213653eeb15574325a79631d9902688ba218e2ebbfcb38d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:20.285202+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:20.301995+00:00", "published_at_raw": "2024-05-30T02:31:25", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 11, "end": 20, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_e6e7e06ca682682d88ff", "record_id": "article_e6e7e06ca682682d", "canonical_url": "https://news.mongabay.com/2024/05/uzbekistan-plants-a-forest-where-a-sea-once-lay", "publisher_url": "https://news.mongabay.com/2024/05/uzbekistan-plants-a-forest-where-a-sea-once-lay", "title_original": "Uzbekistan plants a forest where a sea once lay", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-29T15:38:07+00:00", "source_text": "Between the borders of Uzbekistan and Kazakhstan, the Aral Sea, once the lifeblood of peoples in both countries, is parched, shrouded in a layer of toxic salt and dust that’s now taking a heavy toll on the health and farmlands of these very communities. Since the Aral Sea, technically a lake, began shrinking in the […]", "text_kind": "source_excerpt", "text_characters": 320, "text_sha256": "c38c49826a8cdd161d9b7e3c7af774bf3f534b5d00d1aaae1a4f016053a60924", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:20.355664+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "UZ", "alpha3": "UZB", "name_zh": "乌兹别克斯坦", "name_en": "Uzbekistan"}, {"alpha2": "KZ", "alpha3": "KAZ", "name_zh": "哈萨克斯坦", "name_en": "Kazakhstan"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "UZ", "alpha3": "UZB", "name_zh": "乌兹别克斯坦", "name_en": "Uzbekistan"}, {"alpha2": "KZ", "alpha3": "KAZ", "name_zh": "哈萨克斯坦", "name_en": "Kazakhstan"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:20.388051+00:00", "published_at_raw": "2024-05-29T15:38:07", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "UZ", "alpha3": "UZB", "name_zh": "乌兹别克斯坦", "name_en": "Uzbekistan", "start": 0, "end": 10, "matched_text": "Uzbekistan", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "UZ", "alpha3": "UZB", "name_zh": "乌兹别克斯坦", "name_en": "Uzbekistan", "start": 23, "end": 33, "matched_text": "Uzbekistan", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "KZ", "alpha3": "KAZ", "name_zh": "哈萨克斯坦", "name_en": "Kazakhstan", "start": 38, "end": 48, "matched_text": "Kazakhstan", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_c9eef9cc2b84cd4bb9cb", "record_id": "article_c9eef9cc2b84cd4b", "canonical_url": "https://news.mongabay.com/2024/05/new-bill-to-expand-farmlands-in-the-amazon-can-derail-brazils-green-efforts", "publisher_url": "https://news.mongabay.com/2024/05/new-bill-to-expand-farmlands-in-the-amazon-can-derail-brazils-green-efforts", "title_original": "New bill to expand farmlands in the Amazon may derail Brazil’s green efforts", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-29T14:22:49+00:00", "source_text": "A bill that would reduce the amount of primary forest that landowners in the Brazilian Amazon must preserve may lead to the deforestation of an area twice the size of Rio de Janeiro state.", "text_kind": "source_excerpt", "text_characters": 188, "text_sha256": "159c80749fe69a1a2e95e6aec81a0fd1211dca247ef1a4fb0c8f729aff09d84c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:20.401575+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:20.422534+00:00", "published_at_raw": "2024-05-29T14:22:49", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 54, "end": 60, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_b2bc0991808b8d107f83", "record_id": "article_b2bc0991808b8d10", "canonical_url": "https://yaleclimateconnections.org/2024/05/sunshades-vines-and-trees-can-help-keep-playgrounds-cool", "publisher_url": "https://yaleclimateconnections.org/2024/05/sunshades-vines-and-trees-can-help-keep-playgrounds-cool", "title_original": "Sunshades, vines, and trees can help keep playgrounds cool", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-27T11:00:00+00:00", "source_text": "On a sweltering sunny day, many playgrounds become unusable. Swings and slides are scorching to the touch. And there’s nowhere for kids and families to cool off. But at Kids Together Playground in Cary, North Carolina, children play under tall trees, vine-topped pergolas, and pole-mounted canopies. Moore: “When you walk into that space from the parking lot, the temperature drops 10 degrees immediately because of the shade.” Robin Moore is co-founder of the Natural Learning Initiative at North Carolina State University. The group researches and designs outdoor play environments. He says shade is vital for protecting kids from harmful UV rays and keeping them safe and comfortable on very hot days. Big leafy trees are an ideal solution. But they take time to grow.", "text_kind": "article_excerpt", "text_characters": 771, "text_sha256": "79de4bfffc332e63756b282e7f1d7ab3d8801cc85f550e9e998762aee6ef6d31", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:58.136903+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 364, "end": 375, "evidence": "nd pole-mounted canopies. Moore: “When you walk into that space from the parking lot, the temperature drops 10 degrees immediately because of the shade.” Robin Moore is co-founder of the Natural Learning Initiative at North Carolina State Un"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:58.155347+00:00", "published_at_raw": "2024-05-27T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_26e07975fc2dadf3c8a8", "record_id": "article_26e07975fc2dadf3", "canonical_url": "https://dialogue.earth/en/climate/examining-assams-disaster-readiness-after-the-2022-floods", "publisher_url": "https://dialogue.earth/en/climate/examining-assams-disaster-readiness-after-the-2022-floods", "title_original": "Examining Assam’s disaster readiness after the 2022 floods", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-27T05:00:00+00:00", "source_text": "Two years after catastrophic floods devastated over 300 households in Gumra Grant village in Assam state, residents like Shahra Begum and her three children are still reeling from the trauma. “I will never forget the banna [flood] that hit us two years ago. It was pouring and soon we were in chest-high water. I was trapped with my three children. All we could see was muddy water with dead cattle floating on it,” says the 35-year-old. Stranded and with no government assistance, the villagers were forced to improvise rafts from the stems of banana trees to escape to higher ground. Gumra Grant, in Cachar district, lies just 500 metres from the Bangladesh border.", "text_kind": "article_excerpt", "text_characters": 667, "text_sha256": "94f943cca57d680dbecf3a1df52e096bf6d6f9f3b8445eefd77b35936a3fcf88", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:23.737113+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 29, "end": 34, "evidence": "Two years after catastrophic floods devastated over 300 households in Gumra Grant village in Assam state, residents like Shahra Begum and her three children are still reeling"}], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 76, "end": 81, "evidence": "Two years after catastrophic floods devastated over 300 households in Gumra Grant village in Assam state, residents like Shahra Begum and her three children are still reeling from the trauma. “I will never forget the bann"}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:23.821803+00:00", "published_at_raw": "2024-05-27T05:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh", "start": 649, "end": 659, "matched_text": "Bangladesh", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_d49ff239f1de9eeac3cf", "record_id": "article_d49ff239f1de9eea", "canonical_url": "https://insideclimatenews.org/news/26052024/todays-climate-art-mexico-arizona-border-wildlife", "publisher_url": "https://insideclimatenews.org/news/26052024/todays-climate-art-mexico-arizona-border-wildlife", "title_original": "In Arizona, an Art Installation Highlights the US-Mexico Border’s Impact on Wildlife", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-26T20:13:33+00:00", "source_text": "Earlier in May, a towering image of a jaguar suddenly rippled into view on the border wall straddling Nogales, Arizona, and Sonora, Mexico. A striking Mexican wolf then shimmered in the big cat’s stead, followed by a brown bear, a pronghorn and a mountain lion. This menagerie of animal projections reflect the iconic species that […]", "text_kind": "source_excerpt", "text_characters": 334, "text_sha256": "50603c1b8354966456d225904f247f97668b86c5b60797531e0d68d993c1df5b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:48.739292+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:48.756873+00:00", "published_at_raw": "2024-05-26T20:13:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 47, "end": 49, "matched_text": "US", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 50, "end": 56, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 132, "end": 138, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_4d5ee6af8bde0573e7fd", "record_id": "article_4d5ee6af8bde0573", "canonical_url": "https://news.mongabay.com/2024/05/otter-preneurs-female-sea-otters-lead-the-way-in-tool-use-for-survival", "publisher_url": "https://news.mongabay.com/2024/05/otter-preneurs-female-sea-otters-lead-the-way-in-tool-use-for-survival", "title_original": "Otter-preneurs: Female sea otters lead the way in tool use for survival", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-24T17:43:04+00:00", "source_text": "In California’s Monterey Bay, where the vast Pacific Ocean meets lush kelp forests, sea otters, especially the females, are becoming more resourceful. These charismatic marine mammals, known for their playful nature and voracious appetites, are facing new challenges and using tools to overcome them. For generations, southern sea otters (Enhydra lutris nereis) have relied on […]", "text_kind": "source_excerpt", "text_characters": 380, "text_sha256": "173a66404826410e8dbe773bf289ee1ab30ae16d84577d4777031844a73c4bb7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:25.699636+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:25.732338+00:00", "published_at_raw": "2024-05-24T17:43:04", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 3, "end": 13, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_6d8eb8687ef638186fba", "record_id": "article_6d8eb8687ef63818", "canonical_url": "https://news.mongabay.com/2024/05/in-brazils-cerrado-aquifers-are-losing-more-water-than-they-can-replace", "publisher_url": "https://news.mongabay.com/2024/05/in-brazils-cerrado-aquifers-are-losing-more-water-than-they-can-replace", "title_original": "In Brazil’s Cerrado, aquifers are losing more water than they can replace", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-24T14:30:53+00:00", "source_text": "Aquifers are vital for balanced ecosystems and human existence. While only 3% of the water on Earth is freshwater, almost 99% of that unfrozen volume is located in these geological formations. Despite their importance, little is known about the water that flows beneath our feet — almost always invisibly — and supplies rivers and lakes, […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "6eb51c4612a14f11c757730b136c811625dd9b32019080cac7c6ac9c7023a2c3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:25.771585+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "3%", "start": 75, "end": 77, "evidence": " While only 3% of the water on Earth is freshwater, almost 99% of that unfrozen volume is located in these geological formations.", "interpretation": "not_classified"}, {"value_text": "99%", "start": 122, "end": 125, "evidence": " While only 3% of the water on Earth is freshwater, almost 99% of that unfrozen volume is located in these geological formations.", "interpretation": 