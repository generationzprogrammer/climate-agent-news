{"text_id": "text_8148b39a2f6b29b9387e", "record_id": "article_8148b39a2f6b29b9", "canonical_url": "https://news.mongabay.com/2024/03/planting-water-eating-caatinga-irrigating-with-the-sun-interview-with-agroecologist-tiao-alves", "publisher_url": "https://news.mongabay.com/2024/03/planting-water-eating-caatinga-irrigating-with-the-sun-interview-with-agroecologist-tiao-alves", "title_original": "‘Planting water, eating Caatinga & irrigating with the sun’: Interview with agroecologist Tião Alves", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-25T16:40:19+00:00", "source_text": "While wind turbines and solar panels multiply across the Brazilian dry forests, Tião Alves insists on tin windmills and PET bottle-based heaters. “Backcountry technology,” as he defines it, arguing that the best solutions to make life possible in the Caatinga semiarid region are those born from popular wisdom. “Those that sprout like a seed you […]", "text_kind": "source_excerpt", "text_characters": 350, "text_sha256": "99a0bbe4748d5a8a3c710fff1beb87b611131787c3bc5df0b07736e691e870a0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:57.350263+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 24, "end": 29, "evidence": "While wind turbines and solar panels multiply across the Brazilian dr