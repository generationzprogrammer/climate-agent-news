{"text_id": "text_218342fd81b162a791b8", "record_id": "article_218342fd81b162a7", "canonical_url": "https://insideclimatenews.org/news/20032025/uc-berkeley-faculty-protest-trump-attacks-on-academic-freedom", "publisher_url": "https://insideclimatenews.org/news/20032025/uc-berkeley-faculty-protest-trump-attacks-on-academic-freedom", "title_original": "UC Berkeley Faculty Organize Rally to Protest Trump’s Attacks on Academic Freedom", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-20T19:55:24+00:00", "source_text": "Hundreds of people gathered on the University of California, Berkeley campus Wednesday to protest the Trump administration’s latest attack on academic freedom. They stood before the famed steps named after Free Speech Movement leader Mario Savio to celebrate the pursuit of knowledge, defend freedom of expression and protect access to higher education for all. “Today, […]", "text_kind": "source_excerpt", "text_characters": 373, "text_sha256": "983a5b120d274440bf0729054509d5f2535deac2d2f3dbd509153edb2b1884be", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:31.878180+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国