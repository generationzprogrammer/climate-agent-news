evidence": "The Texas Commission on Environmental Quality on Friday approved an investigation report on Tesla’s battery-grade lithium compounds manufacturing facility near Robstown in Nueces County, finding no violat"}], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:24.828635+00:00", "published_at_raw": "2026-03-19T20:11:09", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 6, "end": 11, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 4, "end": 9, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_65f6950f6775c8dee8c5", "record_id": "article_65f6950f6775c8de", "canonical_url": "https://news.mongabay.com/2026/03/indonesia-plan-to-rezone-elephant-reserve-for-carbon-trading-and-tourism-sparks-backlash", "publisher_url": "https://news.mongabay.com/2026/03/indonesia-plan-to-rezone-elephant-reserve-for-carbon-trading-and-tourism-sparks-backlash", "title_original": "Indonesia plan to rezone elephant reserve for carbon trading and tourism sparks backlash", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-19T06:38:06+00:00", "source_text": "JAKARTA — Environmental experts and activists have slammed plans for carbon and tourism projects in an Indonesian park that’s home to critically endangered tigers, rhinos and elephants. The government has framed the proposed rezoning of half of the core area of Way Kambas National Park for carbon trading and luxury tourism as a way to […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "f705f12401c0227f10b004231c20bfa166827e38cbb857c351627a02f0e20b78", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:45.076171+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 216, "end": 224, "evidence": "home to critically endangered tigers, rhinos and elephants. The government has framed the proposed rezoning of half of the core area of Way Kambas National Park for carbon trading and luxury tourism as a way to […]"}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:45.136912+00:00", "published_at_raw": "2026-03-19T06:38:06", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 0, "end": 9, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_0fdc534210ce901177da", "record_id": "article_0fdc534210ce9011", "canonical_url": "https://news.mongabay.com/2026/03/paul-ehrlich-population-bomb-ecologist-dies-at-93", "publisher_url": "https://news.mongabay.com/2026/03/paul-ehrlich-population-bomb-ecologist-dies-at-93", "title_original": "Paul Ehrlich, ‘Population Bomb’ ecologist, dies at 93", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-18T17:54:15+00:00", "source_text": "The modern environmental movement acquired many of its arguments from scientists who studied forests, oceans and the atmosphere. Few supplied it with a warning as stark, or as controversial, as that delivered by Paul Ehrlich. A population biologist trained on insects, he became one of the most recognizable public intellectuals of the environmental age. His […]", "text_kind": "source_excerpt", "text_characters": 362, "text_sha256": "a6b52a35d91dd7902bf5a473c4f9bde8de2093121aa3ff91149daacb4ce30fda", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:45.226323+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:45.268957+00:00", "published_at_raw": "2026-03-18T17:54:15", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_7dc835d48b50fc45d79a", "record_id": "article_7dc835d48b50fc45", "canonical_url": "https://insideclimatenews.org/news/18032026/the-planet-is-overheating-but-you-might-not-know-it-from-the-news", "publisher_url": "https://insideclimatenews.org/news/18032026/the-planet-is-overheating-but-you-might-not-know-it-from-the-news", "title_original": "The Planet Is Overheating, But You Might Not Know It From the News", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-18T08:50:00+00:00", "source_text": "This story was originally published by Grist. Sign up for Grist’s weekly newsletter here. Scientists are pretty sure that Earth is hotter than at any time in the last 125,000 years, but the news media is moving on, trying to keep on top of a fire hose of pressing news—from the daily chaos of the […]", "text_kind": "source_excerpt", "text_characters": 300, "text_sha256": "e49333fdc971f321b98d8d6276a7519c5b4ee3913aa1fbd251e2e6bc9bb0e3f4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:25.214835+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_