{"text_id": "text_9b1c449639c6db4a701e", "record_id": "article_9b1c449639c6db4a", "canonical_url": "https://news.mongabay.com/2025/07/billions-spent-biodiversity-declines-gef-insists-it-remains-fit-for-purpose", "publisher_url": "https://news.mongabay.com/2025/07/billions-spent-biodiversity-declines-gef-insists-it-remains-fit-for-purpose", "title_original": "Billions spent, biodiversity declines — GEF insists it remains fit for purpose", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-18T19:05:10+00:00", "source_text": "As Africa’s environment ministers meet this week in Nairobi, Kenya, for the 20th African Ministerial Conference on the Environment (AMCEN), the Global Environment Facility (GEF)is touting its decades of support to the continent: more than $7.7 billion in grants across more than 2,000 projects, supplemented by billions in co-financing. Yet despite this scale of investment, […]", "text_kind": "source_excerpt", "text_characters": 378, "text_sha256": "2653e9e3c6748ef273319a5db044d5b61e8f6dbf91ad97ece729665c5760474e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:38.035047+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$7.7 billion", "start": 239, "end": 251, "evidence": "As Africa’s environment ministers meet this week in Nairobi, Kenya, for the 20th African Ministerial Conference on the Environment (AMCEN), the Global Environment Facility (GEF)is touting its decades of support to the continent: more than $7.7 billion in grants across more than 2,000 projects, supplemented by billions in co-financing.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 255, "end": 260, "evidence": "cility (GEF)is touting its decades of support to the continent: more than $7.7 billion in grants across more than 2,000 projects, supplemented by billions in co-financing. Yet despite this scale of investment, […]"}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:38.061011+00:00", "published_at_raw": "2025-07-18T19:05:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 61, "end": 66, "matched_text": "Kenya", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_3bd14ecdc766308c6a34", "record_id": "article_3bd14ecdc766308c", "canonical_url": "https://news.mongabay.com/2025/07/brazils-congress-passes-devastation-bill-in-major-environmental-setback", "publisher_url": "https://news.mongabay.com/2025/07/brazils-congress-passes-devastation-bill-in-major-environmental-setback", "title_original": "Brazil’s Congress passes ‘devastation bill’ in major environmental setback", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-17T20:22:28+00:00", "source_text": "In the early hours of July 17, the Brazilian Chamber of Deputies approved a bill to ease environmental licensing, which NGOs and environmentalists have dubbed the “devastation bill” and consider the nation’s most significant environmental setback in nearly 40 years. The final score was 267 in favor and 116 against it. The law changes several rules of the environmental licensing framework, which is mandatory for all enterprises that use natural resources and may cause damage to the environment or local communities.", "text_kind": "article_excerpt", "text_characters": 519, "text_sha256": "4911d843e9974403f8c79b269ffddcba3f86b36e2bff1c6ace9cd788417740a4", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:51:38.178139+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "adopted", "label_zh": "通过", "label_en": "Adopted", "start": 65, "end": 73, "evidence": "In the early hours of July 17, the Brazilian Chamber of Deputies approved a bill to ease environmental licensing, which NGOs and environmentalists have dubbed the “devastation bill” and consider the nation’s most "}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:38.201249+00:00", "published_at_raw": "2025-07-17T20:22:28", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 0, "end": 6, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_c17aa15063d9415b63bc", "record_id": "article_c17aa15063d9415b", "canonical_url": "https://news.mongabay.com/2025/07/in-a-warming-world-can-california-save-its-joshua-trees", "publisher_url": "https://news.mongabay.com/2025/07/in-a-warming-world-can-california-save-its-joshua-trees", "title_original": "In a warming world, can California save its Joshua trees?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-17T18:32:07+00:00", "source_text": "In early springtime in the Mojave Desert, Joshua trees provide one of the few foods available to many of the wildlife species in this part of the southwestern U.S. Stretching above the surrounding dry vegetation and desert soil, the tall yuccas blossom with clusters of large white flowers that beckon insects, birds, deer, cattle, ground […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "efabbff6cde27e16e616e002a689f9d457a372f9719fc05a0e5f893011b684ae", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:38.215295+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:38.233818+00:00", "published_at_raw": "2025-07-17T18:32:07", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 24, "end": 34, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 159, "end": 163, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_634d84766abf5a43f24a", "record_id": "article_634d84766abf5a43", "canonical_url": "https://insideclimatenews.org/news/17072025/everglades-scientist-tom-van-lent-prepares-for-jail", "publisher_url": "https://insideclimatenews.org/news/17072025/everglades-scientist-tom-van-lent-prepares-for-jail", "title_original": "Prominent Everglades Scientist Prepares for Jail Amid Bitter Legal Dispute with Former Employer", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-17T08:50:00+00:00", "source_text": "A prominent scientist whose work has helped steer a restoration of the Everglades that is among the most ambitious of its kind in human history will surrender Thursday in Miami for a 10-day jail sentence, a consequence of a bitter legal dispute with his former employer. Tom Van Lent is accused of stealing “trade secrets” […]", "text_kind": "source_excerpt", "text_characters": 326, "text_sha256": "ad58187903ee8bd42fc03a1469d96765c5192c31652f5d5802a0517924d76a6e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:17.528161+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:17.544681+00:00", "published_at_raw": "2025-07-17T08:50:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_88ff7173029484d08853", "record_id": "article_88ff7173029484d0", "canonical_url": "https://news.mongabay.com/2025/07/global-tracking-study-reveals-marine-megafauna-hotspots-lie-largely-unprotected", "publisher_url": "https://news.mongabay.com/2025/07/global-tracking-study-reveals-marine-megafauna-hotspots-lie-largely-unprotected", "title_original": "Global tracking study reveals marine megafauna hotspots lie largely unprotected", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-16T16:02:51+00:00", "source_text": "A global study tracking nearly 13,000 individual marine animals has uncovered a sharp disconnect between where these animals actually spend their time and where marine protections exist. The findings raise concerns over whether current conservation targets can deliver for ocean giants. Published in the journal Science on June 5, the study mapped the movements of […]", "text_kind": "source_excerpt", "text_characters": 368, "text_sha256": "606605fadd58c1ef6525606876df52d7cd99511d0258a5b397f112b100287a4f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:38.412165+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:38.434565+00:00", "published_at_raw": "2025-07-16T16:02:51", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_9190d8c62e5aac6e8036", "record_id": "article_9190d8c62e5aac6e", "canonical_url": "https://yaleclimateconnections.org/2025/07/free-vegan-meals-for-people-and-the-planet", "publisher_url": "https://yaleclimateconnections.org/2025/07/free-vegan-meals-for-people-and-the-planet", "title_original": "Free vegan meals for people and the planet", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-16T11:00:00+00:00", "source_text": "Transcript: You may not know who in your community is struggling with hunger. Trinidad: “It could be your next-door neighbor. It could be your friend.” Eloisa Trinidad is with the nonprofit Chilis on Wheels . The New York-based group has built a network of chapters around the country that share free, vegan meals. She says the food is delicious and healthy. And she says her chapter’s menu represents different cultures. Trinidad: “Maybe we’ll have Thai food one day, maybe the next day it’ll be Indian food, maybe the next day it’ll be Mexican food. We have a very diverse community, and so we really try to bring what the people want to eat.” The program provides food for people in need who do not want to give up a vegan diet.", "text_kind": "article_excerpt", "text_characters": 731, "text_sha256": "77352d2e1b4d994d1352c59f6ab6812cc86b4f4f8bf4a3bbb2b8b06ee5c9553e", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:41.499944+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:41.536754+00:00", "published_at_raw": "2025-07-16T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_81ffbb5118187ec355f9", "record_id": "article_81ffbb5118187ec3", "canonical_url": "https://insideclimatenews.org/news/16072025/hillsborough-north-carolina-canceled-fema-program-chantal-damage", "publisher_url": "https://insideclimatenews.org/news/16072025/hillsborough-north-carolina-canceled-fema-program-chantal-damage", "title_original": "Before Tropical Depression Chantal Swamped Hillsborough, the Town Had Been Counting on FEMA", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-16T09:00:00+00:00", "source_text": "HILLSBOROUGH, N.C.—About nine hours after Tropical Depression Chantal inundated central North Carolina last week, Jeff Mahagan’s phone woke him at 3 in the morning. The person working on call at the Hillsborough wastewater treatment plant was scared. Mahagan, the town’s deputy utilities director for water treatment, didn’t immediately grasp the severity of the situation. He […]", "text_kind": "source_excerpt", "text_characters": 380, "text_sha256": "42f99f8d7f281ea4adb878b0ea5732274526fdb1e8cee0fdd7b94d65472653ad", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:17.747836+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:17.768447+00:00", "published_at_raw": "2025-07-16T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_4851f14488686c9dec04", "record_id": "article_4851f14488686c9d", "canonical_url": "https://insideclimatenews.org/news/15072025/humans-are-wiping-out-water-bodies-that-life-depends-on-new-report-says", "publisher_url": "https://insideclimatenews.org/news/15072025/humans-are-wiping-out-water-bodies-that-life-depends-on-new-report-says", "title_original": "Humans Are Wiping Out Water Bodies That Life Depends On, New Report Says", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-15T14:42:15+00:00", "source_text": "A landmark report for the global agreement on wetlands paints a dire picture of the state of the world’s water bodies that underpin all life on Earth. The report, released Tuesday by the secretariat of the Convention on Wetlands, says that since 1970 more than one-fifth of wetlands have been lost, meaning they have shrunk […]", "text_kind": "source_excerpt", "text_characters": 327, "text_sha256": "2fb27130d996617cfebafe1b272ee50e79d328af212a505943b1be4293a5ba38", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:18.099555+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:18.131670+00:00", "published_at_raw": "2025-07-15T14:42:15", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_e5b371936c503a3d18d7", "record_id": "article_e5b371936c503a3d", "canonical_url": "https://insideclimatenews.org/news/14072025/bessemer-alabama-data-center-environmental-impact-potential-legal-action", "publisher_url": "https://insideclimatenews.org/news/14072025/bessemer-alabama-data-center-environmental-impact-potential-legal-action", "title_original": "Bessemer, Alabama, Could Face Legal Action Over Environmental Impacts From a ‘Hyperscale’ Data Center", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-14T22:47:32+00:00", "source_text": "BESSEMER, Ala.—Do not move forward without more information. That’s the advice representatives of the Center for Biological Diversity have provided to Bessemer City Council members ahead of a Tuesday vote to green light a $14.5 billion data center project that could cause significant environmental harm. In a letter sent to the council members on Monday, […]", "text_kind": "source_excerpt", "text_characters": 359, "text_sha256": "df107ae17857f013485e45692afb6155c2421caf3d15a8d25f39f07c9fd407f5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:18.227563+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$14.5 billion", "start": 222, "end": 235, "evidence": " That’s the advice representatives of the Center for Biological Diversity have provided to Bessemer City Council members ahead of a Tuesday vote to green light a $14.5 billion data center project that could cause significant environmental harm.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:18.260920+00:00", "published_at_raw": "2025-07-14T22:47:32", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_6823e3dee84630498406", "record_id": "article_6823e3dee8463049", "canonical_url": "https://dialogue.earth/en/climate/chinas-vulnerable-outdoor-workers-face-extreme-heat", "publisher_url": "https://dialogue.earth/en/climate/chinas-vulnerable-outdoor-workers-face-extreme-heat", "title_original": "China’s vulnerable outdoor workers face extreme heat", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-11T11:59:55+00:00", "source_text": "The afternoon sun blazed down in Beijing on 28 May, with breezes blowing waves of heat as the mercury climbed past 32C. Food delivery driver Zhang Ye, 28, sat cross-legged on his electric bike in a sweat-drenched short-sleeved shirt, scrolling through Douyin (Chinese TikTok). Nearby, a food court and bank are both air-conditioned, but he sits by the roadside in the shade of a tree, awaiting his next order. In Beijing alone there are over 50,000 food delivery drivers like Zhang Ye working outdoors under this relatively new model of employment. Across China, the number already exceeds 10 million . Many other workers are also exposed to high temperatures in Chinese cities.", "text_kind": "article_excerpt", "text_characters": 678, "text_sha256": "62e4db129bc004c754246ea89dd99221660beddfcac58e325a634498d40e4332", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:20.726314+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "10 million", "start": 590, "end": 600, "evidence": " Across China, the number already exceeds 10 million .", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 647, "end": 658, "evidence": "hina, the number already exceeds 10 million . Many other workers are also exposed to high temperatures in Chinese cities."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:20.745180+00:00", "published_at_raw": "2025-07-11T11:59:55", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 0, "end": 5, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 33, "end": 40, "matched_text": "Beijing", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_e0c6e7cb7c1bd7722efa", "record_id": "article_e0c6e7cb7c1bd772", "canonical_url": "https://news.mongabay.com/2025/07/iconic-brazil-nut-crop-plunges-after-extreme-drought-skyrocketing-prices", "publisher_url": "https://news.mongabay.com/2025/07/iconic-brazil-nut-crop-plunges-after-extreme-drought-skyrocketing-prices", "title_original": "Iconic Brazil nut crop plunges after extreme drought, skyrocketing prices", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-10T11:58:16+00:00", "source_text": "KARIPUNA INDIGENOUS TERRITORY, Brazil — Each year, the rainforest communities of Brazil eagerly await the arrival of harvest season for Brazil nuts, which typically begins in November and goes on until March. Also known as Pará nuts or Amazonian chestnuts, the seed is the primary source of income for many extractivist, Indigenous and riverine communities, who spend the remainder of the year living on small farms. “The money from the nuts is used to support the family, build houses, and buy food, shoes and clothes,” Elziane Ribeiro de Souza, from the Cajari Extractive Reserve in Amapá state, told Mongabay by phone. “When possible, it is used to buy a motorcycle, a car or a small boat. We survive on it.", "text_kind": "article_excerpt", "text_characters": 710, "text_sha256": "dfb9e20b422d91620c90837308e2c74c932669ec67dbac1261a205bd8c902275", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:51:43.928905+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 9, "end": 19, "evidence": "KARIPUNA INDIGENOUS TERRITORY, Brazil — Each year, the rainforest communities of Brazil eagerly await the arrival of harvest season for Brazil nuts, which typi"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:43.961618+00:00", "published_at_raw": "2025-07-10T11:58:16", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 7, "end": 13, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 31, "end": 37, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
