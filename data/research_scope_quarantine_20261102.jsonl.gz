{"text_id": "text_bd4f23a5ec3c8eecc09f", "record_id": "article_bd4f23a5ec3c8eec", "canonical_url": "https://news.mongabay.com/2026/09/caribbean-scientists-document-uncharted-deep-sea-waters-in-trinidad-and-tobago", "publisher_url": "https://news.mongabay.com/2026/09/caribbean-scientists-document-uncharted-deep-sea-waters-in-trinidad-and-tobago", "title_original": "Caribbean scientists document uncharted deep-sea waters in Trinidad and Tobago", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-09T15:45:47+00:00", "source_text": "During a recent monthlong expedition, a team of scientists conducted one of the most comprehensive surveys ever undertaken in the deep waters of Trinidad and Tobago, a dual-island nation located in the southern Caribbean Sea. Nearly 93% of the country’s waters are deeper than can be reached by recreational scuba diving, making it impossible to […]", "text_kind": "source_excerpt", "text_characters": 349, "text_sha256": "0fc4e50b2e70c9215ca73d3b6b7e3c47ce5af279d24f571ebddaf383e66d3666", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:54.322885+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "93%", "start": 233, "end": 236, "evidence": " Nearly 93% of the country’s waters are deeper than can be reached by recreational scuba diving, making it impossible to […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_