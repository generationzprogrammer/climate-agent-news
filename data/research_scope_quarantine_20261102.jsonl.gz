{"text_id": "text_7abdee952c5f134c5463", "record_id": "article_7abdee952c5f134c", "canonical_url": "https://news.mongabay.com/2025/10/abandoning-antarctic-krill-management-measure-threatens-conservation-progress-commentary", "publisher_url": "https://news.mongabay.com/2025/10/abandoning-antarctic-krill-management-measure-threatens-conservation-progress-commentary", "title_original": "Abandoning Antarctic krill management measure threatens conservation progress (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-13T14:25:09+00:00", "source_text": "All along the western Antarctic Peninsula, whales, penguins and seals in their millions depend on krill (Euphausia superba) throughout the year. In the most rapidly warming region on the continent, they are now facing an additional and unprecedented threat. For the first time in 15 years, industrial vessels may undertake increased and more concentrated fishing […]", "text_kind": "source_excerpt", "text_characters": 366, "text_sha256": "1ac7b982e95802ed1c8270d0c25f07974b32872a242a5bc2d6ac050d8e91b256", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:46.855718+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 165, "end": 172, "evidence": "eir millions depend on krill (Euphausia superba) throughout the y