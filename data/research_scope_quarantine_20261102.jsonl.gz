{"text_id": "text_c8f76c855b586aa6262f", "record_id": "article_c8f76c855b586aa6", "canonical_url": "https://insideclimatenews.org/news/29102026/senate-debate-on-bipartisan-permitting-bill-approaches", "publisher_url": "https://insideclimatenews.org/news/29102026/senate-debate-on-bipartisan-permitting-bill-approaches", "title_original": "As Permitting Bill Debate Approaches, Senators Have Fresh Doubts and an Ultimatum", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-29T22:34:38+00:00", "source_text": "In less than two weeks, U.S. Senate leaders plan to take an initial vote on the divisive permitting reform bill aimed at easing regulatory barriers that can delay energy projects. As the date nears, some of the country’s leading environmental groups are ramping up their opposition, arguing that the measure would do more harm than […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "5f50032c7b3714a6e79f1777de90ff9057ea14e978693f83038ef826d1f6dedd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:25.101266+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 163, "end": 169, "evidence": "on the divisive permitting reform bill aimed at easing regulatory barriers that can delay energy projects. As the date nears, some of the country’s leading environmental groups are ramping up their opposition, arguing that the measure w"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:25.128914+00:00", "published_at_raw": "2026-10-29T22:34:38", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 24, "end": 28, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_684df5475fe15e48295f", "record_id": "article_684df5475fe15e48", "canonical_url": "https://news.mongabay.com/2026/10/as-the-sea-swallows-a-nigerian-community-migratory-bird-habitat-disappears", "publisher_url": "https://news.mongabay.com/2026/10/as-the-sea-swallows-a-nigerian-community-migratory-bird-habitat-disappears", "title_original": "As the sea swallows a Nigerian community, migratory bird habitat disappears", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-28T07:58:40+00:00", "source_text": "The point where land meets sea at Ayetoro, in southwestern Nigeria, is marked by the skeletons of now-submerged landmarks. Birdcalls, crashing waves, and the sounds of local fishing boats’ outboard engines wash over the crumbling remains of old buildings as well as a wetland that’s a vital stopover and wintering site for migratory waterbirds like […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "b6f233477726a02ab89ec9f3036c86f901fc537f35aaaf69cd4679355a11310e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:20.204699+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NG", "alpha3": "NGA", "name_zh": "尼日利亚", "name_en": "Nigeria"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NG", "alpha3": "NGA", "name_zh": "尼日利亚", "name_en": "Nigeria"}], "annota