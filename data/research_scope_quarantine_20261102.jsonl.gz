{"text_id": "text_6f7915602673f933ed79", "record_id": "article_6f7915602673f933", "canonical_url": "https://insideclimatenews.org/news/08092026/oil-prices-spike-amid-trump-climate-rollbacks", "publisher_url": "https://insideclimatenews.org/news/08092026/oil-prices-spike-amid-trump-climate-rollbacks", "title_original": "As Hostilities Flare and Oil Prices Spike, U.S. Consumers Pay at the Pump", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-09T00:08:08+00:00", "source_text": "Hours after President Donald Trump predicted on Truth Social that oil prices would fall precipitously once the United States wins its war with Iran, strikes on Saudi Arabia’s oil infrastructure by Iranian-backed Houthis Tuesday caused global oil prices to spike to nearly $100 per barrel. The latest runup, bringing the global crude price up 33 […]", "text_kind": "source_excerpt", "text_characters": 348, "text_sha256": "6589ef66edc2b81bb7d16a9b6a39f91e2f0efb2db75eda979b58215cca04bc5c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:05.197011+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "SA", "alpha3": "SAU", "name_zh": "沙特阿拉伯", "name_en": "Saudi Arabia"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "SA", "alpha3": "SAU", "name_zh": "沙特阿拉伯", "name_en": "Saudi Arabia"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:05.222412+00:00", "published_at_raw": "2026-09-09T00:08:08", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 43, "end": 47, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 111, "end": 124, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran", "start": 143, "end": 147, "matched_text": "Iran", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "SA", "alpha3": "SAU", "name_zh": "沙特阿拉伯", "name_en": "Saudi Arabia", "start": 160, "end": 172, "matched_text": "Saudi Arabia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_bd3b71fff48962cec33d", "record_id": "article_bd3b71fff48962ce", "canonical_url": "https://yaleclimateconnections.org/2026/09/hurricane-lowell-slams-hawaii-triggering-historic-tornado-watch-and-widespread-flooding", "publisher_url": "https://yaleclimateconnections.org/2026/09/hurricane-lowell-slams-hawaii-triggering-historic-tornado-watch-and-widespread-flooding", "title_original": "Hurricane Lowell slams Hawaii, triggering historic tornado watch and widespread flooding", "title_zh": "飓风“洛厄尔”袭击夏威夷，引发历史性龙卷风预警与大范围洪灾", "title_en": null, "summary_zh": "飓风“洛厄尔”在夏威夷近海掠过，未直接登陆但造成严重破坏，带来狂风暴雨、巨浪、大范围洪灾及大面积停电，并触发该州历史上首次龙卷风预警。考爱岛及周边地区受灾严重，道路被倒伏树木和洪水阻断。", "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-08T20:49:32+00:00", "source_text": "Hurricane Lowell delivered a major blow to Hawaii, bringing torrential rain, damaging winds, dangerous surf, widespread flooding, prolonged power outages, and the first tornado watch ever issued for the state. The storm’s center stayed just offshore, passing west of Kauai and Niihau, but Lowell’s large circulation meant significant impacts spread well beyond the eye. It was another reminder that a hurricane does not need to make landfall to cause serious problems. Lowell had earlier undergone rapid intensification over the open Pacific, reaching Category 5 strength with maximum sustained winds of 160 mph. It gradually weakened on approach to Hawaii and was a Category 2 hurricane during its closest pass, tracking north-northeast just west of Kauai.", "text_kind": "article_excerpt", "text_characters": 757, "text_sha256": "07658d940c9ae2e46e386af75874404934f9f5fb9dea54a3745b695148c55008", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:29.827025+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 120, "end": 125, "evidence": "ajor blow to Hawaii, bringing torrential rain, damaging winds, dangerous surf, widespread flooding, prolonged power outages, and the first tornado watch ever issued for the state. The storm’s center stayed just offshore, passing west o"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:29.846043+00:00", "published_at_raw": "2026-09-08T20:49:32", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_8df792e30cf726c37819", "record_id": "article_8df792e30cf726c3", "canonical_url": "https://news.mongabay.com/2026/09/birds-know-no-borders-interview-with-birdlife-africas-alex-ngari", "publisher_url": "https://news.mongabay.com/2026/09/birds-know-no-borders-interview-with-birdlife-africas-alex-ngari", "title_original": "‘Birds know no borders’: Interview with BirdLife Africa’s Alex Ngari", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-08T07:36:54+00:00", "source_text": "Every year, twice a year, millions of birds belonging to hundreds of species fly between breeding grounds in Europe and Asia and their non-breeding habitats in Africa. Scientists have surprisingly sparse knowledge of exactly where many species actually go — or what risks and obstacles the migrating birds encounter along the way. Populations of the […]", "text_kind": "source_excerpt", "text_characters": 353, "text_sha256": "967cf67081c89328099d52e1f46d0490f954ed7190c921554c2448c890c6ed3f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:54.558445+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:54.572755+00:00", "published_at_raw": "2026-09-08T07:36:54", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_a21d2ad6a058bbd45855", "record_id": "article_a21d2ad6a058bbd4", "canonical_url": "https://news.mongabay.com/2026/09/indigenous-knowledge-helps-reveal-the-ties-between-reefs-and-mangroves", "publisher_url": "https://news.mongabay.com/2026/09/indigenous-knowledge-helps-reveal-the-ties-between-reefs-and-mangroves", "title_original": "Indigenous knowledge helps reveal the ties between reefs and mangroves", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-06T07:00:38+00:00", "source_text": "In a recent scientific article in the journal Ocean & Coastal Management, alongside the list of scientist-authors were the Bardi Jawi and Oorany Rangers and the Bardi Jawi Traditional Owners. For the past decade, Bardi Jawi rangers and traditional owners have been working with the Australian Institute of Marine Science (AIMS) to study and protect […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "cfdf5e0c38f9c661c851399058209e9a639d7348f79ba7cb84bcf5c9b23e090c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:54.633268+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:54.651844+00:00", "published_at_raw": "2026-09-06T07:00:38", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_9e02db0ab2cf82161683", "record_id": "article_9e02db0ab2cf8216", "canonical_url": "https://news.mongabay.com/2026/09/urban-water-quality-pose-challenges-to-low-income-communities-in-sri-lankas-commercial-capital", "publisher_url": "https://news.mongabay.com/2026/09/urban-water-quality-pose-challenges-to-low-income-communities-in-sri-lankas-commercial-capital", "title_original": "Urban water quality pose challenges to low-income communities in Sri Lanka’s commercial capital", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-05T06:49:03+00:00", "source_text": "COLOMBO — As part of his morning routine, Nalin Kaluwitharana from “Ranjan Wijerathnapura,” a low-income settlement in the heart of Colombo, waters his home garden before setting off to work. Like many others in his neighborhood, he works as a three-wheeler driver. “We obtain pipe-borne water provided by the National Water Supply and Drainage Board […]", "text_kind": "source_excerpt", "text_characters": 354, "text_sha256": "183b33bdf4044ffb9f0a183c76618c4e49410f4555c01b9f5716ca04d21a9e17", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:54.661706+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "LK", "alpha3": "LKA", "name_zh": "斯里兰卡", "name_en": "Sri Lanka"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:54.681389+00:00", "published_at_raw": "2026-09-05T06:49:03", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "LK", "alpha3": "LKA", "name_zh": "斯里兰卡", "name_en": "Sri Lanka", "start": 65, "end": 74, "matched_text": "Sri Lanka", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_efb2bca61f2eb506e2b5", "record_id": "article_efb2bca61f2eb506", "canonical_url": "https://insideclimatenews.org/news/04092026/new-mexico-bans-uranium-leasing", "publisher_url": "https://insideclimatenews.org/news/04092026/new-mexico-bans-uranium-leasing", "title_original": "New Mexico Bans Uranium Leasing on State Lands", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-04T21:40:04+00:00", "source_text": "Officials in New Mexico, the nation’s largest historic producer of uranium ore, banned new leasing of state lands for uranium mining on Friday. State Land Commissioner Stephanie Garcia Richard signed the executive order at a press conference in Sante Fe as the Trump administration seeks to revive American uranium mining and rebuild a domestic supply […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "41358f5abc9d376753aa7e157b4321899f13bb63fed536b966e42db1092926bf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:05.600476+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:05.629959+00:00", "published_at_raw": "2026-09-04T21:40:04", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 10, "matched_text": "New Mexico", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 13, "end": 23, "matched_text": "New Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_392c84cb61251a4ec935", "record_id": "article_392c84cb61251a4e", "canonical_url": "https://news.mongabay.com/2026/09/tanzanias-first-official-wildlife-corridor-links-savanna-elephants-to-rainforest", "publisher_url": "https://news.mongabay.com/2026/09/tanzanias-first-official-wildlife-corridor-links-savanna-elephants-to-rainforest", "title_original": "Tanzania’s first official wildlife corridor links savanna elephants to rainforest", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-04T19:42:57+00:00", "source_text": "African savanna elephants in southern Tanzania have an unusual habit: They climb mountains. Up to 1,000 of the pachyderms spend part of their time in the Udzungwa Mountains, clambering up and down steep slopes that are clad in lush, closed-canopy rainforest. “They go everywhere,” said Trevor Jones, director of strategy and development at the Southern […]", "text_kind": "source_excerpt", "text_characters": 356, "text_sha256": "7342651c9a40b30346258da8437dd42f4827da6a1e37f476dcd5cf7df622ddc7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:54.690053+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:54.708032+00:00", "published_at_raw": "2026-09-04T19:42:57", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania", "start": 0, "end": 8, "matched_text": "Tanzania", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania", "start": 38, "end": 46, "matched_text": "Tanzania", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_0e7b0d93c4d0e67d7e02", "record_id": "article_0e7b0d93c4d0e67d", "canonical_url": "https://insideclimatenews.org/news/03092026/inside-clean-energy-electricity-generation-boom", "publisher_url": "https://insideclimatenews.org/news/03092026/inside-clean-energy-electricity-generation-boom", "title_original": "These States Are Leading the Electricity Generation Boom", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-03T13:00:00+00:00", "source_text": "As data centers and other large users drove demand higher, U.S. power plants increased their output by 2.1 percent in the first half of the year compared to the first half of 2025. This week, I looked at which states rose and fell the most and which power sources drove those changes, based on figures […]", "text_kind": "source_excerpt", "text_characters": 305, "text_sha256": "f3e81e1f86585ffdebfca55b27b7f772bb9683898341986ab199dd8d0f794a1c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:12.646794+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "2.1 percent", "start": 103, "end": 114, "evidence": " power plants increased their output by 2.1 percent in the first half of the year compared to the first half of 2025.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:12.673530+00:00", "published_at_raw": "2026-09-03T13:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 59, "end": 63, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_fc654d02080d9c060237", "record_id": "article_fc654d02080d9c06", "canonical_url": "https://insideclimatenews.org/news/03092026/epa-clean-water-act-provision-would-limit-state-power", "publisher_url": "https://insideclimatenews.org/news/03092026/epa-clean-water-act-provision-would-limit-state-power", "title_original": "New Trump Rules Would Limit State Power to Block Pipelines, Energy Projects", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-03T09:00:00+00:00", "source_text": "When the Trump administration last fall unveiled its cornerstone policy for carrying out the Clean Water Act—new language spelling out the reach of the Environmental Protection Agency’s authority—it said one of its goals was to return power to states and tribes. “This proposal recognizes that states and tribes know their local land and water resources […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "613691ea3f4029ee99571601e4dc67c5f049e2c29c51d29bd50c5874a890d30c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:12.739036+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 269, "end": 277, "evidence": "ency’s authority—it said one of its goals was to return power to states and tribes. “This proposal recognizes that states and tribes know their local land and water resources […]"}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:12.768571+00:00", "published_at_raw": "2026-09-03T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_aa9486d760118e34aca5", "record_id": "article_aa9486d760118e34", "canonical_url": "https://insideclimatenews.org/news/03092026/homestead-florida-electricity-bill-disconnections", "publisher_url": "https://insideclimatenews.org/news/03092026/homestead-florida-electricity-bill-disconnections", "title_original": "In South Florida, a Crackdown on Overdue Electricity Bills Coincides With Peak Summer Heat, ICE Enforcement", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-03T08:55:00+00:00", "source_text": "HOMESTEAD, Fla.—It was too hot to sleep. When the lights turned off and the air conditioning unit went quiet that night in July, it didn’t come as a surprise for Mirella Estrada, 51. She and her husband, both farmworkers, had long been struggling to pay off their climbing electricity bill debt. Earlier that week, a […]", "text_kind": "source_excerpt", "text_characters": 320, "text_sha256": "f1a44a6647559bd50c57d18498c029b4fdf2427d0c11aacd5da53e7c0f6a7cbc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:12.801891+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:12.829508+00:00", "published_at_raw": "2026-09-03T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_0026eb9fcc6e1965b2af", "record_id": "article_0026eb9fcc6e1965", "canonical_url": "https://news.mongabay.com/2026/09/nepals-flood-disaster-puts-its-hydropower-first-strategy-exports-to-the-test", "publisher_url": "https://news.mongabay.com/2026/09/nepals-flood-disaster-puts-its-hydropower-first-strategy-exports-to-the-test", "title_original": "Nepal’s flood disaster puts its hydropower-first strategy, exports to the test", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-02T16:12:52+00:00", "source_text": "KATHMANDU — Nepal’s long-held policy of harnessing hydroelectricity and using it for economic growth has met new challenges: potential catastrophic floods in the snow-fed rivers amid rising global temperatures. The Aug. 26 floods that originated on the Nepal-China border, and which knocked out around 10% of installed power from the national grid, has prompted a […]", "text_kind": "source_excerpt", "text_characters": 367, "text_sha256": "4b8ad2824ce1594b54051280bd7d825701a383363aeded8d9dbf825e7e05e250", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:01.252047+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "10%", "start": 302, "end": 305, "evidence": " 26 floods that originated on the Nepal-China border, and which knocked out around 10% of installed power from the national grid, has prompted a […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 148, "end": 153, "evidence": "ectricity and using it for economic growth has met new challenges: potential catastrophic floods in the snow-fed rivers amid rising global temperatures. The Aug. 26 floods that originated on the Nepal-China border, and which knocked ou"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:01.421994+00:00", "published_at_raw": "2026-09-02T16:12:52", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 0, "end": 5, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 12, "end": 17, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 259, "end": 264, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_74d03502ec200c3926e3", "record_id": "article_74d03502ec200c39", "canonical_url": "https://yaleclimateconnections.org/2026/09/a-pro-soccer-stars-struggle-highlights-youth-sports-risks", "publisher_url": "https://yaleclimateconnections.org/2026/09/a-pro-soccer-stars-struggle-highlights-youth-sports-risks", "title_original": "A pro soccer star’s struggle highlights youth sports risks", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-02T10:59:00+00:00", "source_text": "Transcript: In July, at a professional soccer game in New York City, athletes sweltered in above 90-degree weather and smoke from Canadian wildfires filled the air. Even star player Trinity Rodman seemed to struggle in the conditions. Schmitz: “During halftime, she had to take an oxygen mask and was clearly exhausted.” Samantha Schmitz works with Moms Clean Air Force and the Environmental Defense Fund. She says Rodman is a pro athlete in peak shape. And her team has medical staff on hand, ready to help out. But kids who play sports rarely have access to these resources. And their young bodies are at greater risk of heat-related illness or respiratory problems. Schmitz: “There’s almost 5 million American kids that have asthma.", "text_kind": "article_excerpt", "text_characters": 735, "text_sha256": "37b265e2fb0f1df678dff55184cd864aba4695264b6da434aa26e075d1f5e00e", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:36.458467+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "5 million", "start": 694, "end": 703, "evidence": " Schmitz: “There’s almost 5 million American kids that have asthma.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 139, "end": 147, "evidence": "e in New York City, athletes sweltered in above 90-degree weather and smoke from Canadian wildfires filled the air. Even star player Trinity Rodman seemed to struggle in the conditions. Schmitz: “During halftime, she had to take an oxygen"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:36.491746+00:00", "published_at_raw": "2026-09-02T10:59:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_c70bb43c865e7bd7d7ba", "record_id": "article_c70bb43c865e7bd7", "canonical_url": "https://news.mongabay.com/2026/09/scientists-use-mining-data-to-build-malaria-alert-system-in-amazon", "publisher_url": "https://news.mongabay.com/2026/09/scientists-use-mining-data-to-build-malaria-alert-system-in-amazon", "title_original": "Scientists use mining data to build malaria alert system in the Amazon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-01T14:21:58+00:00", "source_text": "A study detailing the links between illegal gold mining and malaria cases in the Yanomami Indigenous Territory in the Brazilian Amazon won second place in the MapBiomas Award, announced in July. The research collective produces data on land use in Brazil and recognizes initiatives that use this information to promote conservation. The study examined the explosion in malaria cases under the government of Jair Bolsonaro, Brazil’s president from January 2019 to 2022, whose far-right policies encouraged illegal miners to invade Brazil’s largest Indigenous land, home to 31,567 Yanomami.", "text_kind": "article_excerpt", "text_characters": 588, "text_sha256": "dabca8459dcef240e84455f89e9326f6aee6b7c68a02f947c2842b5baf830389", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:02.365477+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 90, "end": 100, "evidence": "A study detailing the links between illegal gold mining and malaria cases in the Yanomami Indigenous Territory in the Brazilian Amazon won second place in the MapBiomas Award, announced in July. The research collective produces data on land"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:02.386568+00:00", "published_at_raw": "2026-09-01T14:21:58", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 248, "end": 254, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_5b0bc56d387a5568a681", "record_id": "article_5b0bc56d387a5568", "canonical_url": "https://insideclimatenews.org/news/01092026/amazons-defenders-declare-state-of-emergency", "publisher_url": "https://insideclimatenews.org/news/01092026/amazons-defenders-declare-state-of-emergency", "title_original": "The Amazon’s Defenders Declare a State of Emergency", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-01T09:01:00+00:00", "source_text": "PUYO, Ecuador—People fighting oil wells, mines and other threats to their homelands did not come to this Amazonian city to lobby politicians at an environmental conference hosted by governments. They built the conference themselves. The 12th Pan-Amazonian Social Forum, known as FOSPA, brought together Indigenous leaders, Afro-descendent communities, women, youth and other environmental defenders and […]", "text_kind": "source_excerpt", "text_characters": 406, "text_sha256": "c299ae02e2ea29ff96e003d367e45d41b06b6b5e26c2a45d7172c4120aef6c80", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:13.344106+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 303, "end": 313, "evidence": "ference themselves. The 12th Pan-Amazonian Social Forum, known as FOSPA, brought together Indigenous leaders, Afro-descendent communities, women, youth and other environmental defenders and […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:13.370174+00:00", "published_at_raw": "2026-09-01T09:01:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador", "start": 6, "end": 13, "matched_text": "Ecuador", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_c70370f74ac62f2453f3", "record_id": "article_c70370f74ac62f24", "canonical_url": "https://news.mongabay.com/2026/08/gulf-of-mexicos-unique-orca-basin-shouldnt-become-a-carbon-dump-commentary", "publisher_url": "https://news.mongabay.com/2026/08/gulf-of-mexicos-unique-orca-basin-shouldnt-become-a-carbon-dump-commentary", "title_original": "Gulf of Mexico’s unique Orca Basin shouldn’t become a carbon dump (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-31T20:56:30+00:00", "source_text": "It’s 3 a.m. and I am standing on the deck of a research vessel, staring into water so dark it looks solid. I feel what I felt standing at the rim of the Grand Canyon, watching the sun set: there are places in this world deserving of our reverence, our protection, and our humility. The […]", "text_kind": "source_excerpt", "text_characters": 289, "text_sha256": "cb58af646074df70ccbfc4c5426aa9a94e87a454a04ddffbb139563a6dabbe8c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:02.949779+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:03.033845+00:00", "published_at_raw": "2026-08-31T20:56:30", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 8, "end": 14, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_02699513ed6f96dcb5ed", "record_id": "article_02699513ed6f96dc", "canonical_url": "https://insideclimatenews.org/news/31082026/iceland-rejects-european-union-for-fishing", "publisher_url": "https://insideclimatenews.org/news/31082026/iceland-rejects-european-union-for-fishing", "title_original": "Why Iceland Chose Fish Over European Alliances", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-31T16:06:18+00:00", "source_text": "Over the weekend, Iceland voted against resuming talks to join the European Union. At the heart of the referendum question: fish. More than a decade since talks previously collapsed, Euroskeptics won 52.8 percent of the vote, according to the National Electoral Commission. Just over 12,700 votes separated the two camps. While the referendum—which was moved […]", "text_kind": "source_excerpt", "text_characters": 362, "text_sha256": "83337c4aed6a6d9a505888a111797a6c3a44fce94134f7fe2a415abaed23ac3f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:13.493386+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "52.8 percent", "start": 200, "end": 212, "evidence": " More than a decade since talks previously collapsed, Euroskeptics won 52.8 percent of the vote, according to the National Electoral Commission.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IS", "alpha3": "ISL", "name_zh": "冰岛", "name_en": "Iceland"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IS", "alpha3": "ISL", "name_zh": "冰岛", "name_en": "Iceland"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:13.505549+00:00", "published_at_raw": "2026-08-31T16:06:18", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IS", "alpha3": "ISL", "name_zh": "冰岛", "name_en": "Iceland", "start": 4, "end": 11, "matched_text": "Iceland", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "IS", "alpha3": "ISL", "name_zh": "冰岛", "name_en": "Iceland", "start": 18, "end": 25, "matched_text": "Iceland", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_32eb73819ad15dd37881", "record_id": "article_32eb73819ad15dd3", "canonical_url": "https://news.mongabay.com/2026/08/scientists-use-satellites-to-track-whale-strandings-in-remote-places-from-space", "publisher_url": "https://news.mongabay.com/2026/08/scientists-use-satellites-to-track-whale-strandings-in-remote-places-from-space", "title_original": "Scientists use satellites to track whale strandings in remote places from space", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-31T13:33:25+00:00", "source_text": "In 2015, the remote coastal fjords of southern Patagonia turned into a whale graveyard. That June, scientists found 337 dead and decomposing sei whales, a species of baleen whale, on the beaches between the Gulf of Penas and Puerto Natales in Chile. Researchers flew over the area, then took samples from the rotting bodies, trying […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "c0c06504a80b5f475690c0d75c7c89d2365a56d075afe4ab0a40959bf224c959", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:03.522162+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile"}], "annotation_method