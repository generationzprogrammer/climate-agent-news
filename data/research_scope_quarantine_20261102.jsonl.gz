{"text_id": "text_ac4c1cacecc807e31e28", "record_id": "article_ac4c1cacecc807e3", "canonical_url": "https://news.mongabay.com/2025/06/indonesia-new-capital-yet-to-spark-electricity-for-low-income-neighbors-on-borneo", "publisher_url": "https://news.mongabay.com/2025/06/indonesia-new-capital-yet-to-spark-electricity-for-low-income-neighbors-on-borneo", "title_original": "Indonesia new capital yet to spark electricity for low-income neighbors on Borneo", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-05T02:41:10+00:00", "source_text": "RANGAN, Indonesia — Every night for three decades, Marwati would worry about snakes crawling out of the walls of her house near the east coast of Borneo. Today, a small rooftop solar panel powers a 3-watt bulb, illuminating the interior of her timber home in a reassuring glow. However, Marwati begins to worry again when […]", "text_kind": "source_excerpt", "text_characters": 325, "text_sha256": "9913a705a14633806dc8b6d60fb5104cd9f88845d4d413f9dd7996f64694c0e9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:04.633177+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 177, "end": 182, "evidence": "wling out of the walls of her house near the east coast of Borneo. Today, a small rooftop solar panel powers a 3-watt bulb, illuminating the interior of her timber home in a reassuring glow. However, Marwati begins to worry again when "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:04.663839+00:00", "published_at_raw": "2025-06-05T02:41:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 0, "end": 9, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 8, "end": 17, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_e9e039e017b012d1af26", "record_id": "article_e9e039e017b012d1", "canonical_url": "https://www.carbonbrief.org/analysis-uks-solar-power-surges-42-after-sunniest-spring-on-record", "publisher_url": "https://www.carbonbrief.org/analysis-uks-solar-power-surges-42-after-sunniest-spring-on-record", "title_original": "Analysis: UK’s solar power surges 42% after sunniest spring on record", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-04T15:33:29+00:00", "source_text": "The UK’s solar farms and rooftops generated more electricity than ever before in the first five months of 2025, as the country enjoyed its sunniest spring on record. The figures, revealed in new Carbon Brief analysis, show that the nation’s solar sites have generated a record 7.6 terawatt hours (TWh) of electricity during January to May 2025. This is some 42% higher than the 5.4TWh generated in the same period last year, as well as marking a much larger 160% increase in the past decade. Solar hit a new half-hourly record of 13.2 gigawatts (GW) on 6 April and, for the first time, accounted for more than 10% of monthly electricity generation in two consecutive months (April and May).", "text_kind": "article_excerpt", "text_characters": 690, "text_sha256": "15a68835a54deb3e2857aee7c8a1705c4761efea4809488e14ac37bed7f437c5", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:16.185619+00:00", "extractor_version": "1.0.0", "document_type": "commentary_or_analysis", "document_type_basis": "explicit_title_prefix", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "42%", "start": 358, "end": 361, "evidence": " This is some 42% higher than the 5.", "interpretation": "not_classified"}, {"value_text": "160%", "start": 458, "end": 462, "evidence": "4TWh generated in the same period last year, as well as marking a much larger 160% increase in the past decade.", "interpretation": "not_classified"}, {"value_text": "10%", "start": 610, "end": 613, "evidence": "2 gigawatts (GW) on 6 April and, for the first time, accounted for more than 10% of monthly electricity generation in two consecutive months (April and May).", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 9, "end": 14, "evidence": "The UK’s solar farms and rooftops generated more electricity than ever before in the first five months of 2025, as the country enjoyed its sunniest spring"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:16.208810+00:00", "published_at_raw": "2025-06-04T15:33:29", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 10, "end": 12, "matched_text": "UK", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 4, "end": 6, "matched_text": "UK", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_5ec9388e492fc617726d", "record_id": "article_5ec9388e492fc617", "canonical_url": "https://yaleclimateconnections.org/2025/06/this-farming-shortcut-promised-better-harvests-it-may-be-hurting-the-soil-instead", "publisher_url": "https://yaleclimateconnections.org/2025/06/this-farming-shortcut-promised-better-harvests-it-may-be-hurting-the-soil-instead", "title_original": "This farming shortcut promised better harvests. It may be hurting the soil instead.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-04T11:00:00+00:00", "source_text": "When someone asks farmer Naiku Gaikwad about soil pollution in his village, he points to an abandoned 40-foot well filled with plastic. “After harvesting their crops, farmers here toss hundreds of kilograms of plastic mulch into this well,” said the 69-year-old farmer from Jambhali village in Maharashtra, India. Farmers started using plastic mulch in this village two decades ago because it provided short-term benefits like earlier harvests, increased water-use efficiency, higher yields, and reduced labor costs. The mulch is a thin, flexible sheet, usually black- or silver-colored, that farmers spread over the soil like a blanket to suppress weeds, retain moisture, and regulate soil temperature.", "text_kind": "article_excerpt", "text_characters": 703, "text_sha256": "42e08622987b6acd7083e6d12fbb9be6d8b31d52b27e3d73eaa3dae4811b5828", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:49.701121+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 691, "end": 702, "evidence": "spread over the soil like a blanket to suppress weeds, retain moisture, and regulate soil temperature."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:49.772993+00:00", "published_at_raw": "2025-06-04T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 307, "end": 312, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_e6f759a7e65102135bec", "record_id": "article_e6f759a7e6510213", "canonical_url": "https://insideclimatenews.org/news/03062025/pennsylvania-community-fights-to-stop-landfill", "publisher_url": "https://insideclimatenews.org/news/03062025/pennsylvania-community-fights-to-stop-landfill", "title_original": "Fearing Radioactive Waste, a Western Pennsylvania Community Fights to Stop a Landfill’s Re-Opening", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-03T08:55:00+00:00", "source_text": "Fracking’s Forever Problem: Fourth in a series about the gas industry’s radioactive waste. For years, residents of Grove City, Pennsylvania, have fought to stop a decades-old landfill from resuming operations in their town. They were worried the landfill would make legacy pollution in the area worse. But in 2022, information about the kind of waste the […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "05b808fa9252f3ecc0715d9d381db4dba78d6952cbdadac529a7883b3b3170fc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:48.561952+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclima