{"text_id": "text_3be57b0ad93af4df48d0", "record_id": "article_3be57b0ad93af4df", "canonical_url": "https://news.mongabay.com/2026/07/thai-mp-calls-for-new-committee-to-scrutinize-ai-data-centers-environmental-impact", "publisher_url": "https://news.mongabay.com/2026/07/thai-mp-calls-for-new-committee-to-scrutinize-ai-data-centers-environmental-impact", "title_original": "Thai MP calls for new committee to scrutinize AI data centers’ environmental impact", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-27T02:48:48+00:00", "source_text": "BANGKOK — An opposition member of Thailand’s parliament has called for the creation of a parliamentary committee on the regulation of data centers. The call comes amid a raft of new project approvals linked to the sector, which requires large amounts of water and electricity. “I believe Thailand needs to rethink its overall approach to […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "805f7ab6d86bbd8a3dda3f68cb45fef05633963f05b58675487d3ff49190ea1b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:30.891328+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand"}], "governance_themes": [], "policy_tools": [{"id": "standards", "label_zh": "标准与监管", "label_en": "Standards and regulation", "start": 120, "end": 130, "evidence": " of Thailand’s parliament has called for the creation of a parliamentary committee on the regulation of data centers. The call comes amid a raft of new project approvals linked to the sector, which requires large amounts of water and electr"}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:30.923455+00:00", "published_at_raw": "2026-07-27T02:48:48", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand", "start": 34, "end": 42, "matched_text": "Thailand", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_7900fb80b3f22216fb28", "record_id": "article_7900fb80b3f22216", "canonical_url": "https://insideclimatenews.org/news/24072026/trump-administration-eyes-massive-coal-reserves-under-federal-lands", "publisher_url": "https://insideclimatenews.org/news/24072026/trump-administration-eyes-massive-coal-reserves-under-federal-lands", "title_original": "Trump Administration Eyes Massive Coal Reserves Under Federal Lands", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-24T21:36:50+00:00", "source_text": "More than 356 billion tons of coal resources lie beneath federally owned land in the contiguous United States, according to a government report, whose new and comprehensive findings could escalate mining in those areas, most of them in the West. The U.S. Geological Survey (USGS) issued the report, which estimated an additional 4.2 billion tons […]", "text_kind": "source_excerpt", "text_characters": 349, "text_sha256": "8575b7ee0ac1cdb67fefb1db16738729e763cc220f4a8ebfcd6bf66178f79722", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:36.900937+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "356 billion", "start": 10, "end": 21, "evidence": "More than 356 billion tons of coal resources lie beneath federally owned land in the contiguous United States, according to a government report, whose new and comprehensive findings could escalate mining in those areas, most of them in the West.", "interpretation": "not_classified"}, {"value_text": "4.2 billion", "start": 329, "end": 340, "evid