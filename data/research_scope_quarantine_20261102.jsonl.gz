{"text_id": "text_ea7a432dead7da19da31", "record_id": "article_ea7a432dead7da19", "canonical_url": "https://news.mongabay.com/2026/07/new-indonesia-roadmap-aims-to-protect-indigenous-knowledge-for-biodiversity", "publisher_url": "https://news.mongabay.com/2026/07/new-indonesia-roadmap-aims-to-protect-indigenous-knowledge-for-biodiversity", "title_original": "New Indonesia roadmap aims to protect Indigenous knowledge for biodiversity", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-02T03:12:35+00:00", "source_text": "JAKARTA — The Indonesian government is developing a roadmap to protect local wisdom in biodiversity conservation, a move aimed at strengthening the recognition and protection of Indigenous peoples and local communities (IPLCs) whose traditional practices have long safeguarded some of the country’s richest ecosystems. The roadmap, the drafting of which began in June 2026, comes […]", "text_kind": "source_excerpt", "text_characters": 383, "text_sha256": "9e3bce2d67c766259eb3787c35be7d37f7e007386dc48ea3f42545dcdc3432ad", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:51.934016+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 178, "end": 188, "evidence": "iodiversity conservation, a move aimed at strengthening the recognition and protection of Indigenous peoples and local communities (IPLCs) whose traditional practices have long safeguarded some of the country’s richest ecosystems. The roadm"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:51.991491+00:00", "published_at_raw": "2026-07-02T03:12:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 4, "end": 13, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_c3726d4546bb82757d3b", "record_id": "article_c3726d4546bb8275", "canonical_url": "https://news.mongabay.com/2026/07/can-coastal-infrastructure-be-engineered-to-harbor-marine-life-instead-of-harming-it", "publisher_url": "https://news.mongabay.com/2026/07/can-coastal-infrastructure-be-engineered-to-harbor-marine-life-instead-of-harming-it", "title_original": "Can coastal infrastructure be engineered to harbor marine life instead of harming it?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-01T18:57:56+00:00", "source_text": "COBH, Ireland — On a bright, warm day in April in Cobh, Ireland, I step down a centuries-old cobbled slipway that descends into a harbor packed with fishing boats. Halfway down, something interrupts the weathered wall: an installation of 60 hexagonal concrete panels bolted into the stone. Some panels are ridged or textured; others are […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "8a3c5bfcf9753523314fc45adbdcd7fe0ea7fd135be3fe885e327f59f2f16a38", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:52.511821+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IE", "alpha3": "IRL", "name_zh": "爱尔兰", "name_en": "Ireland"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IE", "alpha3": "IRL", "name_zh": "爱尔兰", "name_en": "Ire