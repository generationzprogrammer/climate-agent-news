{"text_id": "text_3cce9d4a045cc85fe9df", "record_id": "article_3cce9d4a045cc85f", "canonical_url": "https://news.mongabay.com/2025/12/the-top-10-most-listened-to-podcasts-of-2025-from-mongabay", "publisher_url": "https://news.mongabay.com/2025/12/the-top-10-most-listened-to-podcasts-of-2025-from-mongabay", "title_original": "The top 10 most listened-to podcasts of 2025 from Mongabay", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-23T22:05:51+00:00", "source_text": "With 2025 drawing to a close, Mongabay’s flagship podcast has added more than 40 episodes over the course of the year. From professors and authors to Mongabay staffers, conservationists and advocates, we’ve hosted a diverse group of individuals, detailing their investigations, research, advocacy philosophy — all in service to shining a light on the existential […]", "text_kind": "source_excerpt", "text_characters": 366, "text_sha256": "15086d3f5461337f3a2e07ba23fcef5049143d1f93b7039c9c981abe0fafcd7f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:46.204093+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_c