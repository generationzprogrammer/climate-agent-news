{"text_id": "text_91af92c75871dbe3ac92", "record_id": "article_91af92c75871dbe3", "canonical_url": "https://insideclimatenews.org/news/20122025/how-proposed-changes-to-the-endangered-species-act-could-further-threaten-the-countrys-imperiled-species", "publisher_url": "https://insideclimatenews.org/news/20122025/how-proposed-changes-to-the-endangered-species-act-could-further-threaten-the-countrys-imperiled-species", "title_original": "How Proposed Changes to the Endangered Species Act Could Further Threaten the Country’s Imperiled Species", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-20T09:50:00+00:00", "source_text": "A polar bear stood outside the Department of the Interior’s headquarters in Washington, D.C., Thursday with a message: “Stop Trump’s Extinction Plan.” The sign-carrying Arctic creature—actually an environmentalist dressed in a shockingly realistic costume—was joined by around 35 people to protest the Trump administration’s recently proposed changes to the Endangered Species Act. In front of […]", "text_kind": "source_excerpt", "text_characters": 397, "text_sha256": "149ed12614b6be700f85bec643c8dbbc9053a4926c9e90035c31c3f4f99f20a8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:21.400897+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 334, "end": 342, "evidence": "tic costume—was joined by around 35 people to protest the Trump administration’s recently proposed changes to the Endangered Species Act. In front of […]"}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:21.439288+00:00", "published_at_raw": "2025-12-20T09:50:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_3b6eb63b67f15a1a4e01", "record_id": "article_3b6eb63b67f15a1a", "canonical_url": "https://insideclimatenews.org/news/19122025/trumps-epa-focus-delay-rescind-dismantle", "publisher_url": "https://insideclimatenews.org/news/19122025/trumps-epa-focus-delay-rescind-dismantle", "title_original": "Trump’s EPA Focus: Delay, Rescind, Dismantle Environmental and Health Protections", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-19T22:15:03+00:00", "source_text": "Over the past year, environmental experts who have dedicated their lives to public service have watched the partisan, unilateral destruction of the agency they once helped run. “What’s happening at the EPA right now is not business as usual,” said Marc Boom, senior director of public affairs for the Environmental Protection Network (EPN), a group […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "71a33f239557b0cfb61177cfab475c95db07a4cdddda83da97c9d5b882ce925b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:21.610743+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "a