{"text_id": "text_33f8448dc36c63fa3e14", "record_id": "article_33f8448dc36c63fa", "canonical_url": "https://insideclimatenews.org/news/25102024/todays-climate-behind-the-scenes-whales-rope", "publisher_url": "https://insideclimatenews.org/news/25102024/todays-climate-behind-the-scenes-whales-rope", "title_original": "Behind the Scenes: Inside Tech Efforts to Protect Right Whales from Fishing Gear", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-25T19:31:04+00:00", "source_text": "It’s been a dark decade for the endangered North Atlantic right whale. More than 40 of these ocean giants have perished since 2017, mainly due to two human-driven factors: vessel strikes and getting tangled up in fishing gear. But this week, scientists announced a rare bit of good news for the struggling species. In 2023, […]", "text_kind": "source_excerpt", "text_characters": 327, "text_sha256": "46ef968af6751279af790d486496132f1358613b53032359cbef9f5f1afcee31", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:40.415371+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:40.428629+00:00", "published_at_raw": "2024-10-25T19:31:04", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_7172109ba5dc1feac3a0", "record_id": "article_7172109ba5dc1fea", "canonical_url": "https://insideclimatenews.org/news/25102024/colorado-river-reservoir-expansion-federal-court-ruling", "publisher_url": "https://insideclimatenews.org/news/25102024/colorado-river-reservoir-expansion-federal-court-ruling", "title_original": "Federal Court Ruling on a Reservoir Expansion Could Have Big Implications for the Colorado River", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-25T09:00:00+00:00", "source_text": "A federal district court judge ruled last week that the U.S. Army Corps of Engineers violated the National Environmental Protection Act and the Clean Water Act when it approved expanding a Colorado reservoir. But a footnote to that decision is even more significant, experts and environmentalists say, with potentially far-reaching impacts on water management in […]", "text_kind": "source_excerpt", "text_characters": 366, "text_sha256": "35b1fa019b1be0b1cb5b030806c024321e7c50cb15c30b6719de05954e007bf2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:40.453319+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "adopted", "label_zh": "通过", "label_en": "Adopted", "start": 168, "end": 176, "evidence": "ineers violated the National Environmental Protection Act and the Clean Water Act when it approved expanding a Colorado reservoir. But a footnote to that decision is even more significant, experts and environmentalists say, with potential"}], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:40.471045+00:00", "published_at_raw": "2024-10-25T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 56, "end": 60, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_ed8e7ccda3f80ee6ebc2", "record_id": "article_ed8e7ccda3f80ee6", "canonical_url": "https://news.mongabay.com/2024/10/new-survey-puts-human-face-on-pollution-caused-by-u-s-wood-pellet-mills", "publisher_url": "https://news.mongabay.com/2024/10/new-survey-puts-human-face-on-pollution-caused-by-u-s-wood-pellet-mills", "title_original": "New survey puts human face on pollution caused by U.S. wood pellet mills", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-24T14:37:19+00:00", "source_text": "Forest biomass companies working in the U.S. Southeast in 2023 produced 9.54 million metric tons of wood pellets for export at their 28 mills scattered across the region. That’s a 5.7% increase over 2022. And there’s no end in sight for the sector’s growth — with new U.S. mills planned for the Deep South and […]", "text_kind": "source_excerpt", "text_characters": 313, "text_sha256": "a1003f6d12f7eade8e1eda1608cdb67acec4459f0c26ee0ca87ec1cb081ab200", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:08.468081+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "9.54 million", "start": 72, "end": 84, "evidence": " Southeast in 2023 produced 9.54 million metric tons of wood pellets for export at their 28 mills scattered across the region.", "interpretation": "not_classified"}, {"value_text": "5.7%", "start": 180, "end": 184, "evidence": " That’s a 5.7% increase over 2022.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:08.495501+00:00", "published_at_raw": "2024-10-24T14:37:19", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 50, "end": 54, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 40, "end": 44, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_41ee1b0734d35b24da11", "record_id": "article_41ee1b0734d35b24", "canonical_url": "https://news.mongabay.com/2024/10/deforestation-plunges-but-environmental-threats-remain-as-colombia-hosts-cop16", "publisher_url": "https://news.mongabay.com/2024/10/deforestation-plunges-but-environmental-threats-remain-as-colombia-hosts-cop16", "title_original": "Deforestation plunges but environmental threats remain as Colombia hosts COP16", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-21T20:28:11+00:00", "source_text": "As global leaders, experts, activists and Indigenous voices meet this October in the Colombian city of Cali at the U.N. Biodiversity Conference, COP16, missteps and successes within President Gustavo Petro’s environment agenda are watched closely.", "text_kind": "source_excerpt", "text_characters": 247, "text_sha256": "ce3ae917156cdc93908434fc0dd62375b549967ab551781b9a34750c3637da40", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:08.820542+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": ["COP16"], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 42, "end": 52, "evidence": "As global leaders, experts, activists and Indigenous voices meet this October in the Colombian city of Cali at the U.N. Biodiversity Conference, COP16, missteps and successes within President "}], "policy_tools": [], "policy_stages": [], "track": "negotiations", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:08.846023+00:00", "published_at_raw": "2024-10-21T20:28:11", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 58, "end": 66, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_09496808aec6dbc20a22", "record_id": "article_09496808aec6dbc2", "canonical_url": "https://yaleclimateconnections.org/2024/10/vertical-solar-panels-help-farmers-produce-both-energy-and-crops", "publisher_url": "https://yaleclimateconnections.org/2024/10/vertical-solar-panels-help-farmers-produce-both-energy-and-crops", "title_original": "Vertical solar panels help farmers produce both energy and crops", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-21T11:00:00+00:00", "source_text": "Producing solar energy on a farm typically means covering a field with panels. But now some companies make solar panels that stand vertically, so they take up less space and can be more easily integrated into pastures or croplands. Biernath: “You still can work on the land, and it’s not just a solar farm and that’s it.” Helge Biernath is the CEO of Sunstall , which makes vertical solar systems called Sunzaun . At one winery in California, the Sunzaun solar systems snake in between rows of grapevines. And Rutgers University is testing the use of Sunzaun panels in a cattle grazing field. Biernath says the panels can double as fences, shade structures, or windbreaks. And in addition to their use on farms, they could be installed along canals, railroads, or highways.", "text_kind": "article_excerpt", "text_characters": 773, "text_sha256": "e45d077863831af3294f634261d5b1fa6caf2f4c1a9eb88cac72962d2a812d80", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:04.012995+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 10, "end": 15, "evidence": "Producing solar energy on a farm typically means covering a field with panels. But now some companies make solar panels that stand vertically, so they take"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:04.057871+00:00", "published_at_raw": "2024-10-21T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 431, "end": 441, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_3fab48d538c618dea8b9", "record_id": "article_3fab48d538c618de", "canonical_url": "https://news.mongabay.com/2024/10/cambodian-logging-syndicate-tied-to-major-u-s-wood-flooring-supply-chains", "publisher_url": "https://news.mongabay.com/2024/10/cambodian-logging-syndicate-tied-to-major-u-s-wood-flooring-supply-chains", "title_original": "Cambodian logging syndicate tied to major U.S. wood flooring supply chains", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-21T02:43:38+00:00", "source_text": "This is the second part of a Mongabay series investigating Cambodia’s illicit timber trade. Read Part One. Several Cambodian journalists helped to report this investigation, but have requested not to be named due to the sensitive nature of the story. SIHANOUKVILLE, Cambodia — On a rain-sodden day in September 2023, reporters entered the Sihanoukville Special […]", "text_kind": "source_excerpt", "text_characters": 364, "text_sha256": "6135e87e736d1f60edf41ff25caa7c4c51304f1c898fc97a04e9e95e35891d81", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:08.975824+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:09.005475+00:00", "published_at_raw": "2024-10-21T02:43:38", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 42, "end": 46, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia", "start": 59, "end": 67, "matched_text": "Cambodia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_c4bb1a07884e4ed64846", "record_id": "article_c4bb1a07884e4ed6", "canonical_url": "https://insideclimatenews.org/news/20102024/lobster-traps-harm-right-whales", "publisher_url": "https://insideclimatenews.org/news/20102024/lobster-traps-harm-right-whales", "title_original": "The Futures of Right Whales and Lobstermen Are Entangled. Could High-Tech Gear Help Save Them Both?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-20T09:00:00+00:00", "source_text": "It was a blessedly calm day as Scott Landry’s team set out in their inflatable boat to scan the glistening waters of Great South Channel between Rhode Island and Massachusetts for an endangered whale affectionately known as Wart. They were on a mission to save her life. The group, from the nonprofit Center for Coastal […]", "text_kind": "source_excerpt", "text_characters": 323, "text_sha256": "595a43b2bfe257f75c4e2f05097d323a6943d9dbdaa8e3be5e75820baed7db5a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:41.236313+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_stat