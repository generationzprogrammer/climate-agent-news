{"text_id": "text_f9ad36db7c7bcba516c6", "record_id": "article_f9ad36db7c7bcba5", "canonical_url": "https://news.mongabay.com/2026/02/plastic-household-waste-burned-as-fuel-on-rise-in-global-south-risking-health", "publisher_url": "https://news.mongabay.com/2026/02/plastic-household-waste-burned-as-fuel-on-rise-in-global-south-risking-health", "title_original": "Plastic household waste burned as fuel on rise in Global South, risking health", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-05T18:34:42+00:00", "source_text": "Burning plastic waste for household fuel, or to manage household waste, may be far more prevalent in poor urban areas in developing countries than previously thought, raising serious environmental pollution and public health concerns for individuals, families and communities. That’s according to a new global study that surveyed more than 1,000 “key informants,” including researchers, […]", "text_kind": "source_excerpt", "text_characters": 390, "text_sha256": "ba3f5e3a67b0a57be8d685ffe01d6c8c162a9903b4a8c04214dc812393148cf9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:20.528220+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "arc