{"text_id": "text_6d7998965a5e8839da51", "record_id": "article_6d7998965a5e8839", "canonical_url": "https://news.mongabay.com/2025/01/indonesian-company-defies-order-plants-acacia-in-orangutan-habitat", "publisher_url": "https://news.mongabay.com/2025/01/indonesian-company-defies-order-plants-acacia-in-orangutan-habitat", "title_original": "Indonesian company defies order, plants acacia in orangutan habitat", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-07T16:42:59+00:00", "source_text": "JAKARTA — The Indonesian company responsible for the largest amount of deforestation, PT Mayawana Persada, has largely ceased clearing peatlands in the western part of Borneo. However, it has shifted focus to planting acacia trees on previously cleared peatlands, defying a government directive to halt activities and rehabilitate degraded land. Environmental activists warn that the […]", "text_kind": "source_excerpt", "text_characters": 387, "text_sha256": "b92d0374c852f6724235585844e5b1f0fdba8a23d89a97a8348fb2f2225c676c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:29.712560+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:29.725708+00:00", "published_at_raw": "2025-01-07T16:42:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.575747+00:00"}
{"text_id": "text_395c4300558061f1a394", "record_id": "article_395c4300558061f1", "canonical_url": "https://insideclimatenews.org/news/04012025/carbon-footprint-of-lng-exports", "publisher_url": "https://insideclimatenews.org/news/04012025/carbon-footprint-of-lng-exports", "title_original": "Why the Argument That LNG Is Essential to the Energy Transition Is ‘Nonsense’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-01-04T09:55:00+00:00", "source_text": "From our collaborating partner Living on Earth, public radio’s environmental news magazine, an interview by Paloma Beltran with Robert Howarth, a professor of ecology and environmental biology at Cornell University. When you fire up your gas range to cook dinner, the natural gas that’s delivered through pipes to your stove is, well, a gas. But […]", "text_kind": "source_excerpt", "text_characters": 349, "text_sha256": "3d9c6059d0c9df873d53da3ec7c05357495cb9df72cbc49731f1a710bb86fde6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:11.599005+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "20