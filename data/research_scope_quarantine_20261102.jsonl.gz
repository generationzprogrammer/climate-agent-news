{"text_id": "text_c551073381fe39111c71", "record_id": "article_c551073381fe3911", "canonical_url": "https://news.mongabay.com/2025/06/bitcoin-boom-comes-with-huge-intensifying-environmental-footprint", "publisher_url": "https://news.mongabay.com/2025/06/bitcoin-boom-comes-with-huge-intensifying-environmental-footprint", "title_original": "Bitcoin boom comes with huge intensifying environmental footprint", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-25T16:36:18+00:00", "source_text": "While much has been written about bitcoin, many people still find it a hard topic to comprehend, even as promoters like U.S. President Donald Trump rave about it being a revolutionary digital currency that will rapidly replace hard currency. However, unlike money, there’s currently no bank or government to back up, insure and regulate bitcoin, […]", "text_kind": "source_excerpt", "text_characters": 349, "text_sha256": "634dca3b08a05ac721f13e91507b60853e749d1d688670e8118e6202ee8078a6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:50.494940+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictiona