{"text_id": "text_1651b32398c9c9530bb8", "record_id": "article_1651b32398c9c953", "canonical_url": "https://news.mongabay.com/2024/03/norway-pension-fund-breaks-with-u-k-conglomerate-jardines-over-endangered-orangutan-habitat", "publisher_url": "https://news.mongabay.com/2024/03/norway-pension-fund-breaks-with-u-k-conglomerate-jardines-over-endangered-orangutan-habitat", "title_original": "Norway pension fund breaks with U.K. conglomerate Jardines over endangered orangutan habitat", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-12T04:28:00+00:00", "source_text": "JAKARTA — The Norwegian state pension fund has cut ties with U.K. conglomerate Jardine Matheson (Jardines) due to concerns that the group’s gold mining activity in Indonesia could damage the only known habitat of the most threatened great ape in the world, the Tapanuli orangutan. Environmentalists have welcomed the decision, saying that it should serve […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "17f36bd681e428ed2d8abde416004724a399c25cb88e846d771dd29ab652b2ad", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:02.935576+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_e