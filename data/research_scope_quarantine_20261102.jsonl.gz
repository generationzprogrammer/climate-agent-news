{"text_id": "text_f0e3291a2514a7a23cfd", "record_id": "article_f0e3291a2514a7a2", "canonical_url": "https://news.mongabay.com/2025/06/new-method-can-detect-nearly-every-coral-genus-in-japan-from-water-samples", "publisher_url": "https://news.mongabay.com/2025/06/new-method-can-detect-nearly-every-coral-genus-in-japan-from-water-samples", "title_original": "New method can detect nearly every coral genus in Japan from water samples", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-05T15:46:43+00:00", "source_text": "Sending scuba divers down to survey corals is time-consuming and expensive. In recent years, scientists have developed other methods to determine what kinds of corals are down there just by collecting water samples, sometimes right from the surface. These rely on analysis of the DNA that the corals secrete into the water. Now, a team […]", "text_kind": "source_excerpt", "text_characters": 339, "text_sha256": "8e9714c6ede7c0ecd56ca70a73518334f1ea43905c2857fad08b698a0e83749b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:04.435621+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verifi