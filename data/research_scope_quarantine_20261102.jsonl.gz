{"text_id": "text_81fd86b88fb863496e74", "record_id": "article_81fd86b88fb86349", "canonical_url": "https://insideclimatenews.org/news/20072026/west-africa-thriving-coral-reef", "publisher_url": "https://insideclimatenews.org/news/20072026/west-africa-thriving-coral-reef", "title_original": "The Thriving Coral Reef That ‘Defeated Time’ in West Africa", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-20T09:00:00+00:00", "source_text": "In the 1960s, fishing surveyors off West Africa’s Benin coast hauled up heads of coral in their nets. Employed by local governments to assess fish diversity and discover potentially trawlable seabeds in the sandy-bottomed Gulf of Guinea, the researchers shrugged off the discovery at the time, burying the find in a brief paragraph in a […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "4d8847dfd8c9bb0f219deb9411b347c8f9de81cf5723dea0996678e7f910a54a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:38.028874+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BJ", "alpha3": "BEN", "name_zh": "贝宁", "name_en": "Benin"}, {"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BJ", "alpha3": "BEN", "name_zh": "贝宁", "name_en": "Benin"}, {"alpha2": "GN", "alpha3"