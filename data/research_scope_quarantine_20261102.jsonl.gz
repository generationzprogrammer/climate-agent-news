{"text_id": "text_0534a70d664600edd9e3", "record_id": "article_0534a70d664600ed", "canonical_url": "https://insideclimatenews.org/news/09022026/south-florida-plants-animals-endangered-species-act", "publisher_url": "https://insideclimatenews.org/news/09022026/south-florida-plants-animals-endangered-species-act", "title_original": "Trump Administration to Finalize Protections for 11 South Florida Plants and Animals", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-09T23:35:21+00:00", "source_text": "The Trump administration has agreed to finalize protections under the Endangered Species Act for 11 South Florida plants and animals, settling federal litigation over their plight. The agreement involves the Florida Keys mole skink, Rim Rock crowned snake and Key ring-necked snake. Also included in the settlement are eight rare plants, including three imperiled by […]", "text_kind": "source_excerpt", "text_characters": 370, "text_sha256": "5a3bc87f14e3687f57d3e279c85154ec3510b5477d61b016559bd4ed0925d13c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:52.413036+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:52.471499+00:00", "published_at_raw": "2026-02-09T23:35:21", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_1a09d84ee2b7612aa390", "record_id": "article_1a09d84ee2b7612a", "canonical_url": "https://www.carbonbrief.org/ipbes-four-key-takeaways-on-how-nature-loss-threatens-the-global-economy", "publisher_url": "https://www.carbonbrief.org/ipbes-four-key-takeaways-on-how-nature-loss-threatens-the-global-economy", "title_original": "IPBES: Four key takeaways on how nature loss threatens the global economy", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-09T14:58:20+00:00", "source_text": "The “undervaluing” of nature by businesses is fuelling its decline and putting the global economy at risk, according to a major new report. An assessment from the Intergovernmental Science-Policy Platform on Biodiversity and Ecosystem Services (IPBES) outlines more than 100 actions for measuring and reducing impacts on nature across business, government, financial institutions and civil society. A co-chair of the assessment says that nature loss is one of the most “serious threats” to businesses, but the “twisted reality is that it often seems more profitable to businesses to degrade biodiversity than to protect it”. The “ business and biodiversity ” report says that global “finance flows” of more than $7tn (£5.1tn) had “direct negative impacts on nature” in 2023.", "text_kind": "article_excerpt", "text_characters": 774, "text_sha256": "c82994809d66caed5a043b57bb55e6b7eb04c56bb2f9b7210b3b7e9be81aa901", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:48.196500+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:48.221514+00:00", "published_at_raw": "2026-02-09T14:58:20", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_48be374a10e36ad25729", "record_id": "article_48be374a10e36ad2", "canonical_url": "https://yaleclimateconnections.org/2026/02/the-consumer-friendly-energy-star-program-survived-trump-what-about-other-efficiency-efforts", "publisher_url": "https://yaleclimateconnections.org/2026/02/the-consumer-friendly-energy-star-program-survived-trump-what-about-other-efficiency-efforts", "title_original": "The consumer-friendly Energy Star program survived Trump. What about other efficiency efforts?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-09T12:00:00+00:00", "source_text": "Energy Star, the program that helps guide consumers to more energy-efficient appliances and electronics, has survived the Trump administration’s plans to cut it. The program received sufficient support in Congress that it was included in budget legislation signed last week by President Donald Trump. Environmentalists and advocates called it good news for consumers and the planet but raised concerns over how the program will be administered under a shrunken Environmental Protection Agency . But Energy Star is not the only energy efficiency program targeted by Trump. Here’s what to know about the outlook for that program and others. What’s Trump got against energy efficiency?", "text_kind": "article_excerpt", "text_characters": 682, "text_sha256": "378a97ba9f432b49977a2eec0086440f6d1128827046a193f92d555349331659", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:32.844000+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 0, "end": 6, "evidence": "Energy Star, the program that helps guide consumers to more energy-efficient appliances and electronics, has survived the Trump administration’s p"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:32.862434+00:00", "published_at_raw": "2026-02-09T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_40c602fa94ebb7591923", "record_id": "article_40c602fa94ebb759", "canonical_url": "https://insideclimatenews.org/news/07022026/environmental-justice-under-trump", "publisher_url": "https://insideclimatenews.org/news/07022026/environmental-justice-under-trump", "title_original": "The State of Environmental Justice Under Trump 2.0", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-07T09:50:00+00:00", "source_text": "From our collaborating partner Living on Earth, public radio’s environmental news magazine, an interview by Paloma Beltran with Monique Harden, an environmental justice lawyer and advocate in New Orleans. For generations, African American and other communities of color have been exposed to higher levels of pollution from landfills, chemical plants and highways. While the majority […]", "text_kind": "source_excerpt", "text_characters": 386, "text_sha256": "268bd71f3312bd571dfb1603d8a4523882fce2aea70ba022f2f44cecf098f4a3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:53.062798+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:53.099333+00:00", "published_at_raw": "2026-02-07T09:50:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_e84dbf83c8077f81aa21", "record_id": "article_e84dbf83c8077f81", "canonical_url": "https://news.mongabay.com/2026/02/ethiopias-renaissance-mega-dam-fuels-energy-hopes-and-regional-anxiety", "publisher_url": "https://news.mongabay.com/2026/02/ethiopias-renaissance-mega-dam-fuels-energy-hopes-and-regional-anxiety", "title_original": "Ethiopia’s Renaissance mega-dam fuels energy hopes and regional anxiety", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-06T06:30:32+00:00", "source_text": "This January, U.S. President Donald Trump offered to act as a mediator between Egypt and Ethiopia over Nile River waters, signaling renewed interest in the dispute. Ethiopia’s flagship project, the Grand Ethiopian Renaissance Dam (GERD), launched in 2011, has been a source of prolonged friction among Nile Basin countries. The row intensified with the dam’s […]", "text_kind": "source_excerpt", "text_characters": 362, "text_sha256": "a104e15cef2dfb6ab58b30057c0132875eb898f6144c07591af358b1482df688", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:20.168815+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "EG", "alpha3": "EGY", "name_zh": "埃及", "name_en": "Egypt"}, {"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "EG", "alpha3": "EGY", "name_zh": "埃及", "name_en": "Egypt"}, {"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:20.212935+00:00", "published_at_raw": "2026-02-06T06:30:32", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia", "start": 0, "end": 8, "matched_text": "Ethiopia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 14, "end": 18, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "EG", "alpha3": "EGY", "name_zh": "埃及", "name_en": "Egypt", "start": 79, "end": 84, "matched_text": "Egypt", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia", "start": 89, "end": 97, "matched_text": "Ethiopia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_b21b9c01c99ec49ac46b", "record_id": "article_b21b9c01c99ec49a", "canonical_url": "https://news.mongabay.com/2026/02/whats-next-for-the-major-pledge-to-halt-reverse-congo-basin-deforestation", "publisher_url": "https://news.mongabay.com/2026/02/whats-next-for-the-major-pledge-to-halt-reverse-congo-basin-deforestation", "title_original": "What’s next for the major pledge to halt & reverse Congo Basin deforestation?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-05T23:01:00+00:00", "source_text": "Copince Ngoma, a member of the Bakouele Indigenous community, has relied on the lush green Congo Basin rainforest his whole life. His village’s forests, located in the Democratic Republic of Congo’s Sangha region, are a wide repertoire for hunting, fishing and medicinal plants to care for his family. But in the last few years, as […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "4be4077e98e66c05fb0af4d92c88fd0a06f2c9082bdd1350f07be4897b660a82", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:20.434455+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 40, "end": 50, "evidence": "Copince Ngoma, a member of the Bakouele Indigenous community, has r