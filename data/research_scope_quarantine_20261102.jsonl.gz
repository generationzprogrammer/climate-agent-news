{"text_id": "text_2ef19a6bbd46b046c973", "record_id": "article_2ef19a6bbd46b046", "canonical_url": "https://news.mongabay.com/2024/07/jokowis-religious-mining-rule-divides-indonesia-faith-group", "publisher_url": "https://news.mongabay.com/2024/07/jokowis-religious-mining-rule-divides-indonesia-faith-group", "title_original": "Jokowi’s religious mining rule divides Indonesia’s largest Islamic organization", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-15T05:57:39+00:00", "source_text": "A widely criticized move by Indonesian President Joko Widodo to reform mining rules to bestow coal mining licenses on an allied religious organization is carving a rift between its executive leadership and Islamic activists in the community, sources told Mongabay Indonesia. On May 30, the president, commonly known as Jokowi, signed a revision to existing […]", "text_kind": "source_excerpt", "text_characters": 360, "text_sha256": "5725d2777ec486033356cf0aeea646b1194ccc0ba2e3cf0b9ccf5454519d76f9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:56.586699+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 94, "end": 98, "evidence": "dely criticized move by Indonesian President Joko Widodo to reform mining rules to bestow coal mining licenses on an allied religious organization is carving a rift between its executive leadership and Islamic activists in the communi"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:56.600901+00:00", "published_at_raw": "2024-07-15T05:57:39", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 39, "end": 48, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 264, "end": 273, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_9a53c4637036bdb145da", "record_id": "article_9a53c4637036bdb1", "canonical_url": "https://insideclimatenews.org/news/11072024/us-energy-information-agency-bitcoin-mining-electricity-usage-data", "publisher_url": "https://insideclimatenews.org/news/11072024/us-energy-information-agency-bitcoin-mining-electricity-usage-data", "title_original": "US Government Launches New Attempt to Gather Data on Electricity Usage of Bitcoin Mining", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-11T21:33:04+00:00", "source_text": "The fast-growing cryptocurrency industry is a major consumer of electricity, but no one—not even the U.S. government—knows exactly how much energy goes into the armada of computers used to ‘mine’ Bitcoin and other digital assets. The U.S. Energy Information Agency estimates that cryptocurrency mining uses between 0.6 percent and 2.3 percent of all electricity per […]", "text_kind": "source_excerpt", "text_characters": 369, "text_sha256": "54e32a5ca93a0ebb188953cf97bb8b5e1b411acb7bfc7f2eeb07aaaab80ae6cb", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:29.855545+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "0.6 percent", "start": 315, "end": 326, "evidence": " Energy Information Agency estimates that cryptocurrency mining uses between 0.6 percent and 2.", "interpretation": "not_classified"}, {"value_text": "2.3 percent", "start": 331, "end": 342, "evidence": "6 percent and 2.3 percent of all electricity per […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 140, "end": 146, "evidence": "r consumer of electricity, but no one—not even the U.S. government—knows exactly how much energy goes into the armada of computers used to ‘mine’ Bitcoin and other digital assets. The U.S. Energy Information Agency estimates that crypto"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:29.868345+00:00", "published_at_raw": "2024-07-11T21:33:04", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 2, "matched_text": "US", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 101, "end": 105, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_4fd5d2019cbf84e1de17", "record_id": "article_4fd5d2019cbf84e1", "canonical_url": "https://dialogue.earth/en/nature/chinas-futuristic-city-restored-mangroves", "publisher_url": "https://dialogue.earth/en/nature/chinas-futuristic-city-restored-mangroves", "title_original": "How China’s most ‘futuristic’ city restored its mangroves", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-11T15:34:42+00:00", "source_text": "Each spring, as Shenzhen’s mangroves burst into life, the region becomes a prime spot for birdwatchers observing the endangered black-faced spoonbill. Known as the giant panda of birds , this species winters in Shenzhen Bay from October to April, in preparation for its northbound migration. Shenzhen Bay, located in southern China and part of the Pearl River Delta expanding into Hong Kong , is a crucial stop-off point for migratory birds using the East Asian-Australasian flyway . The mangroves support over 200 species of birds and host 100,000 migratory birds each winter, drawing enthusiasts and scientists alike to witness these natural spectacles against the backdrop of one of China’s most bustling urban settings.", "text_kind": "article_excerpt", "text_characters": 723, "text_sha256": "9a4ff5b91d550707a8cfc4bf14d9d19eb8ac4c43c942447baa8b72e83fc1f7b6", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:12.338572+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:12.455635+00:00", "published_at_raw": "2024-07-11T15:34:42", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 4, "end": 9, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 326, "end": 331, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_ef2b3f4fa31d7b968111", "record_id": "article_ef2b3f4fa31d7b96", "canonical_url": "https://yaleclimateconnections.org/2024/07/a-roundup-of-common-myths-about-evs", "publisher_url": "https://yaleclimateconnections.org/2024/07/a-roundup-of-common-myths-about-evs", "title_original": "A roundup of common myths about EVs", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-10T11:00:00+00:00", "source_text": "There seems to be little doubt that EVs are in the future of every car owner or driver. As with all new technologies, questions abound. And as with technologies that replace familiar ones — and are changing very rapidly — so do inaccuracies of various kinds. Here are some pieces that will help you separate fact from fiction. Three one-stop collections of myths and corrections: “ Factcheck: 21 misleading myths about electric vehicles .” Simon Evans, Carbon Brief. UK-centered. “ EV mythbusters .” Series of articles, Jasper Jolly, The Guardian. “ All the arguments against EVs are wrong .” Noah Smith, economics blog, Substack.", "text_kind": "article_excerpt", "text_characters": 630, "text_sha256": "5c3f80acb1565fdaaa19556bd9490148eb88e604eb3700cb3d4fd9f0afde0ad8", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:42.437146+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:42.476215+00:00", "published_at_raw": "2024-07-10T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 467, "end": 469, "matched_text": "UK", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_48c469dfee65dc2939e3", "record_id": "article_48c469dfee65dc29", "canonical_url": "https://insideclimatenews.org/news/10072024/texas-bitcoin-mining-threatens-power-grid", "publisher_url": "https://insideclimatenews.org/news/10072024/texas-bitcoin-mining-threatens-power-grid", "title_original": "Texas Leaders Worry That Bitcoin Mines Threaten to Crash the State Power Grid", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-10T10:00:00+00:00", "source_text": "GRANBURY, TEXAS — Cheryl Shadden cannot sleep. The 61-year-old nurse, who works at hospitals giving patients anesthesia, says she is kept up at night by the nonstop mechanical whir of fans spinning to cool tens of thousands of computers. Shadden lives in Granbury, Texas, about 40 miles southwest of Fort Worth, with her seven dogs, […]", "text_kind": "source_excerpt", "text_characters": 336, "text_sha256": "44c931d435e3666a35c52cd00abdcba8e78178d739772f084eb59eb85bc321f5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:30.085324+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:30.099633+00:00", "published_at_raw": "2024-07-10T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 5, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 10, "end": 15, "matched_text": "TEXAS", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_b6f6a536be7fb2030f90", "record_id": "article_b6f6a536be7fb203", "canonical_url": "https://insideclimatenews.org/news/09072024/average-global-temperatures-above-pre-industrial-levels-for-12-months", "publisher_url": "https://insideclimatenews.org/news/09072024/average-global-temperatures-above-pre-industrial-levels-for-12-months", "title_original": "Average Global Temperature Has Warmed 1.5 Degrees Celsius Above Pre-industrial Levels for 12 Months in a Row", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-09T11:37:48+00:00", "source_text": "Last month wasn’t only the hottest June by far in the observed temperature record, but marked the first-ever 12-month stretch of the Earth’s average temperature exceeding 1.5 degrees Celsius of temperature rise above the pre-industrial baseline against which human-caused warming is measured. “This is more than a statistical oddity and it highlights a large and […]", "text_kind": "source_excerpt", "text_characters": 366, "text_sha256": "8f71262408822355f7582f7c8cec23bb62cb8a6e0745c9be8f5fa3ae4c9d64ad", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:30.182039+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 63, "end": 74, "evidence": "Last month wasn’t only the hottest June by far in the observed temperature record, but marked the first-ever 12-month stretch of the Earth’s average temperature exceeding 1.5 degrees Celsius of temperature rise abo"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:30.194803+00:00", "published_at_raw": "2024-07-09T11:37:48", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_ea21f26313c081a2d0b4", "record_id": "article_ea21f26313c081a2", "canonical_url": "https://yaleclimateconnections.org/2024/07/houston-area-slammed-by-beryls-winds-and-water", "publisher_url": "https://yaleclimateconnections.org/2024/07/houston-area-slammed-by-beryls-winds-and-water", "title_original": "Houston area slammed by Beryl’s winds and water", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-08T17:33:17+00:00", "source_text": "Hurricane Beryl pounded the Houston area with power-cutting winds, heavy rain, and storm surge on Monday morning, July 8, after making landfall at 5 a.m. EDT near Matagorda, Texas, about 90 miles southwest of Galveston. At landfall, Beryl was a strengthening Category 1 hurricane with 80 mph winds and a central pressure of 989 mb. At landfall, Beryl had a large eye with a diameter of 32 miles, which gave the hurricane a relatively large radius of maximum winds that prevented rapid intensification. However, Beryl maintained its hurricane-force strength as its stronger right-hand side moved directly over central Houston, bringing the city some of its strongest winds since Hurricane Ike in 2008.", "text_kind": "article_excerpt", "text_characters": 700, "text_sha256": "269e76f8fe54bf96699f7a6d2b670fd2abb198a61108996c5958da560d2087b3", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:42.714323+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:42.756561+00:00", "published_at_raw": "2024-07-08T17:33:17", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 174, "end": 179, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_c0692a3b76fa47937c29", "record_id": "article_c0692a3b76fa4793", "canonical_url": "https://news.mongabay.com/2024/07/global-migratory-freshwater-fish-populations-plummet-by-81-report", "publisher_url": "https://news.mongabay.com/2024/07/global-migratory-freshwater-fish-populations-plummet-by-81-report", "title_original": "Global migratory freshwater fish populations plummet by 81%: Report", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-08T16:02:30+00:00", "source_text": "A new global report reveals a stark reality: populations of migratory freshwater fish species, including salmon, trout, eel and sturgeon, are declining dramatically. The 2024 update on the Living Planet Index for Migratory Freshwater Fishes shows an average 81% decrease in these fish populations between 1970 and 2020. “The catastrophic decline in migratory fish populations […]", "text_kind": "source_excerpt", "text_characters": 379, "text_sha256": "048e9813339b07384883236d897371f0fbde2ffc1f9b1b6de58d79ddebe98b75", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:01.210859+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "81%", "start": 258, "end": 261, "evidence": " The 2024 update on the Living Planet Index for Migratory Freshwater Fishes shows an average 81% decrease in these fish populations between 1970 and 2020.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:01.224356+00:00", "published_at_raw": "2024-07-08T16:02:30", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_9a63366650d3bb604b12", "record_id": "article_9a63366650d3bb60", "canonical_url": "https://insideclimatenews.org/news/06072024/new-york-harbor-islands-heron-habitat-loss", "publisher_url": "https://insideclimatenews.org/news/06072024/new-york-harbor-islands-heron-habitat-loss", "title_original": "Attacked on All Sides: Wading Birds Nest in New York’s Harbor Islands", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-06T10:52:41+00:00", "source_text": "For bird enthusiasts and average residents alike, the sight of wild, colorful migratory birds like the great egret or the black-crowned night heron, in a dense and loud city like New York is something to behold. Every spring, these wading birds migrate to the unoccupied islands along the city’s coast, as well as to certain […]", "text_kind": "source_excerpt", "text_characters": 328, "text_sha256": "7ea53df6c3bc07fee5a1f525672c6ed5737009873a3984aad2f959e6de691e4d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:30.518399+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-0