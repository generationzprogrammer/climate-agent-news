{"text_id": "text_0c833f136393124b0ece", "record_id": "article_0c833f136393124b", "canonical_url": "https://news.mongabay.com/2024/02/rewilding-in-argentina-helps-giant-anteaters-return-to-south-brazil", "publisher_url": "https://news.mongabay.com/2024/02/rewilding-in-argentina-helps-giant-anteaters-return-to-south-brazil", "title_original": "Rewilding in Argentina helps giant anteaters return to south Brazil", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-12T14:00:10+00:00", "source_text": "Playing back hours of footage from a camera trap set in Espinilho State Park in the south of Brazil in August 2023, Fábio Mazim and his team banked on possible sightings of the maned wolf or the Pantanal deer and had their fingers crossed for a glimpse of a Pampas cat (Leopardus pajeros), one of […]", "text_kind": "source_excerpt", "text_characters": 300, "text_sha256": "1973f1e43e5ceb47624f781eefbd7acf110462e585d9fc5e3e2b36e3c5f2757c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:13.819831+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotatio