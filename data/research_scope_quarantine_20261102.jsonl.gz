{"text_id": "text_c92c5f9e3a570c2602fe", "record_id": "article_c92c5f9e3a570c26", "canonical_url": "https://insideclimatenews.org/news/24052024/a-walk-in-the-woods-with-my-brain-on-fire-spring", "publisher_url": "https://insideclimatenews.org/news/24052024/a-walk-in-the-woods-with-my-brain-on-fire-spring", "title_original": "A Walk in the Woods With My Brain on Fire: Spring", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-24T09:05:00+00:00", "source_text": "PLEASANT VALLEY, Mass.—Two visits to this wildlife sanctuary. One week apart. I came to report the arrival of spring, an under-covered story. In the hope, too, that the new season might extinguish the fire in my brain, ablaze in the Anthropocene: The accelerating heat with its cascading catastrophes; the barbaric wars with their crimes against […]", "text_kind": "source_excerpt", "text_characters": 349, "text_sha256": "943d2f4ba815ee4dd3a12bfdb238a542f6a2f51f0c798cb5fc7086adf3b9f9bd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:48.990107+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:49.007021+00:00", "published_at_raw": "2024-05-24T09:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_3d13d503855a2e39f19a", "record_id": "article_3d13d503855a2e39", "canonical_url": "https://news.mongabay.com/2024/05/global-markets-and-their-effects-on-resource-exploitation-in-the-pan-amazon", "publisher_url": "https://news.mongabay.com/2024/05/global-markets-and-their-effects-on-resource-exploitation-in-the-pan-amazon", "title_original": "Global markets and their effects on resource exploitation in the Pan Amazon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-21T13:38:24+00:00", "source_text": "Investment capital flows when prices are high, but companies scale back investments when they fall. Nonetheless, companies do not often abandon projects once underway; in part, this is a natural resistance to writing-off an existing investment, but experienced businessmen also know that markets are cyclical. If companies wish to ‘cash in’ when prices are high, […]", "text_kind": "source_excerpt", "text_characters": 366, "text_sha256": "eac71504b07066cd5a046b9baa7a1ed83803730d8615c333a0728a3a5c99cd47", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:26.415333+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:26.445417+00:00", "published_at_raw": "2024-05-21T13:38:24", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_4b838a55d29a5698ae24", "record_id": "article_4b838a55d29a5698", "canonical_url": "https://www.carbonbrief.org/guest-post-heat-pumps-gained-european-market-share-in-2023-despite-falling-sales", "publisher_url": "https://www.carbonbrief.org/guest-post-heat-pumps-gained-european-market-share-in-2023-despite-falling-sales", "title_original": "Guest post: Heat pumps gained European market share in 2023 despite falling sales", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-21T11:43:46+00:00", "source_text": "Following several years of strong growth, heat pump markets slowed in Europe in 2023. In previous articles for Carbon Brief, we discussed this initial surge in 2021 and explored the impact of the energy crisis in 2022. Yet, despite a drop in heat pump sales in key European regions, the trends in 2023 are more nuanced than an outright downturn. Heat pumps generally increased their position relative to fossil heating systems and, in some of the continent’s biggest heating markets, they saw continued growth. If policymakers want to keep the transition to low-carbon heating on track, then thorough, consistent and coordinated policy efforts remain critical to scaling up heat pump markets.", "text_kind": "article_excerpt", "text_characters": 692, "text_sha256": "c45f96fcc65a601e4d862823ecb43ecbeb77a850e07dc4e5d44bd4e4688a4e5e", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:06.340445+00:00", "extractor_version": "1.0.0", "document_type": "commentary_or_analysis", "document_type_basis": "explicit_title_prefix", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 196, "end": 202, "evidence": " for Carbon Brief, we discussed this initial surge in 2021 and explored the impact of the energy crisis in 2022. Yet, despite a drop in heat pump sales in key European regions, the trends in 2023 are more nuanced than an outright downtu"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:06.454715+00:00", "published_at_raw": "2024-05-21T11:43:46", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_61469c1532fc48a14e3b", "record_id": "article_61469c1532fc48a1", "canonical_url": "https://news.mongabay.com/2024/05/beyond-deforestation-oil-palm-estates-pose-flood-and-water-contamination-risks", "publisher_url": "https://news.mongabay.com/2024/05/beyond-deforestation-oil-palm-estates-pose-flood-and-water-contamination-risks", "title_original": "Beyond deforestation, oil palm estates pose flood and water contamination risks", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-21T10:58:57+00:00", "source_text": "JAKARTA — Briantama Asmara first visited the village of Kais in Indonesian Papua, on the island of New Guinea, in 2017 as an university researcher. The village lies two time zones away from Jakarta, the Indonesian capital, but it takes a four-hour flight, followed by a four-hour car ride and a three-hour boat trip to […]", "text_kind": "source_excerpt", "text_characters": 322, "text_sha256": "c6e9b418b2c82c6285dd5d0b9bb4323affcea68a5cd404a129a4cd0a40f8ad23", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:26.451990+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:26.480970+00:00", "published_at_raw": "2024-05-21T10:58:57", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea", "start": 103, "end": 109, "matched_text": "Guinea", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
