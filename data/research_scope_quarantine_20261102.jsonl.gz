{"text_id": "text_19d566d6dd50f8507b9f", "record_id": "article_19d566d6dd50f850", "canonical_url": "https://news.mongabay.com/2024/10/bangladeshs-new-government-implements-strong-measures-to-eliminate-single-use-plastic", "publisher_url": "https://news.mongabay.com/2024/10/bangladeshs-new-government-implements-strong-measures-to-eliminate-single-use-plastic", "title_original": "Bangladesh’s new government implements strong measures to eliminate single-use plastic", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-02T17:48:12+00:00", "source_text": "The newly formed government in Bangladesh is about to implement the existing law regarding plastic usage by strictly banning — initially — single-use plastic and, gradually, all possible plastic uses. Civil society members formed the current non-political government on Aug. 8, 2024, after former Prime Minister Sheikh Hasina and her cabinet left the country on […]", "text_kind": "source_excerpt", "text_characters": 365, "text_sha256": "9a58b46c41dde74271b5c7e2951f79cd4abbb6277dac39e7c512924e37ac0fc3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:21.626730+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:21.646219+00:00", "published_at_raw": "2024-10-02T17:48:12", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh", "start": 0, "end": 10, "matched_text": "Bangladesh", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh", "start": 31, "end": 41, "matched_text": "Bangladesh", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_74d32a7729803d401450", "record_id": "article_74d32a7729803d40", "canonical_url": "https://news.mongabay.com/2024/10/controversial-us-marine-geoengineering-test-delayed-until-next-year", "publisher_url": "https://news.mongabay.com/2024/10/controversial-us-marine-geoengineering-test-delayed-until-next-year", "title_original": "Controversial US marine geoengineering test delayed until next year", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-02T15:34:04+00:00", "source_text": "A controversial experiment to field-test a way to quickly sequester more carbon in the world’s oceans has been pushed back until 2025, according to the Woods Hole Oceanographic Institution (WHOI). The LOC-NESS project, headed by WHOI, had planned to disseminate 20 metric tons of sodium hydroxide (commonly known as lye) along with tracer dye into […]", "text_kind": "source_excerpt", "text_characters": 351, "text_sha256": "23bddb4ea3125f520fa4d3fb5bfbdf863e4e6c2a1ac6f688259594b9f7697dfc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:21.692997+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:21.706621+00:00", "published_at_raw": "2024-10-02T15:34:04", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 14, "end": 16, "matched_text": "US", "method": "country-acronym-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_cc92761caea049f12ae0", "record_id": "article_cc92761caea049f1", "canonical_url": "https://insideclimatenews.org/news/02102024/gaslighting-north-carolina-beekeepers-pipeline-expansion", "publisher_url": "https://insideclimatenews.org/news/02102024/gaslighting-north-carolina-beekeepers-pipeline-expansion", "title_original": "A Family of Beekeepers Could Lose Their Hives Because of a Massive Pipeline Expansion", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-02T09:00:00+00:00", "source_text": "Gaslighting: Second in a series about opposition to a wave of new natural gas pipelines, power plants and storage facilities on the drawing board in North Carolina. Listen to an audio version of this story below. MIDWAY, N.C.—Thousands of honey bees hover over a small meadow where the air seems to vibrate in time with […]", "text_kind": "source_excerpt", "text_characters": 323, "text_sha256": "0a48292b9616116fbe01232cbd324ee0a7988e47a631a67d23071d5ebb72a8a8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:53.959716+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/pos