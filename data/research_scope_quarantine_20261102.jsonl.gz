{"text_id": "text_704466095a54a227b9d5", "record_id": "article_704466095a54a227", "canonical_url": "https://news.mongabay.com/2024/03/another-catastrophe-flooding-destroys-indigenous-agroforestry-projects-in-perus-amazon", "publisher_url": "https://news.mongabay.com/2024/03/another-catastrophe-flooding-destroys-indigenous-agroforestry-projects-in-perus-amazon", "title_original": "‘Another catastrophe’: Flooding destroys Indigenous agroforestry projects in Peru’s Amazon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-26T14:55:59+00:00", "source_text": "Flooding caused by heavy rains in central Peru in March displaced hundreds of Indigenous families and destroyed their sustainable agroforestry projects, raising concerns about how they’ll recover and what steps need to be taken to protect against future extreme weather events. Heavy rains likely caused by El Niño began flooding the Ene River the first […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "5bb167b43aa9cf60e2d115640e7592577d1ea6619d630d33191568e4f5db947c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:57.237850+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 78, "end": 88, "evidence": "Flooding caused by heavy rains in central Peru in March displaced hundreds of Indigenous families and destroyed their sustainable agroforestry projects, raising concerns about how they’ll recover and what steps need to be taken "}, {"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 0, "end": 5, "evidence": "Flooding caused by heavy rains in central Peru in March displaced hundreds of Indigenous families and destroyed their sustainable agroforestry pr"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:57.248245+00:00", "published_at_raw": "2024-03-26T14:55:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru", "start": 77, "end": 81, "matched_text": "Peru", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru", "start": 42, "end": 46, "matched_text": "Peru", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
