{"text_id": "text_a3651081f46ade2a8842", "record_id": "article_a3651081f46ade2a", "canonical_url": "https://insideclimatenews.org/news/10102025/federal-shutdown-hampers-chesapeake-bay-agreement-talks", "publisher_url": "https://insideclimatenews.org/news/10102025/federal-shutdown-hampers-chesapeake-bay-agreement-talks", "title_original": "Federal Shutdown Hampers Chesapeake Bay Agreement Talks", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-10T23:40:48+00:00", "source_text": "The ongoing federal shutdown has eclipsed the final stretch of negotiations on an updated agreement to guide restoration of the Chesapeake Bay, leaving partner states to contemplate a less ambitious pact with scaled-back targets and modest cleanup goals. Nearly all normally participating federal agencies have been absent from these deliberations since the Oct. 1 shutdown. […]", "text_kind": "source_excerpt", "text_characters": 378, "text_sha256": "652d974ec9881d0d2112c8fd179b2310fb7d5dcf7a4657e6f8e5be1ab5bf457a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:09.105121+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:09.121486+00:00", "published_at_raw": "2025-10-10T23:40:48", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_34891bc0133cdea76436", "record_id": "article_34891bc0133cdea7", "canonical_url": "https://news.mongabay.com/2025/10/uphill-battle-to-save-californias-endangered-mountain-yellow-legged-frog", "publisher_url": "https://news.mongabay.com/2025/10/uphill-battle-to-save-californias-endangered-mountain-yellow-legged-frog", "title_original": "Uphill battle to save California’s endangered mountain yellow-legged frog", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-10T16:32:44+00:00", "source_text": "Earlier this year, 350 endangered mountain yellow-legged frogs hopped into their new home in Bluff Lake in Southern California’s San Bernardino Mountains. It’s the latest step in a long-running battle fought by authorities, including the U.S. Fish and Wildlife Service, the U.S. Geological Survey, the California Department of Fish and Wildlife and conservationists to stave […]", "text_kind": "source_excerpt", "text_characters": 378, "text_sha256": "c8308bcf6ca4729c3b21bb23a42d832f0a5efde75c2bba78a9cffc7465412dc8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:47.009754+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:47.068505+00:00", "published_at_raw": "2025-10-10T16:32:44", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 22, "end": 32, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 116, "end": 126, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_d5b389296b7838a9079c", "record_id": "article_d5b389296b7838a9", "canonical_url": "https://news.mongabay.com/2025/10/cameroon-inaugurates-controversial-dam-despite-local-dissent", "publisher_url": "https://news.mongabay.com/2025/10/cameroon-inaugurates-controversial-dam-despite-local-dissent", "title_original": "Cameroon inaugurates controversial dam despite local dissent", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-10T14:31:24+00:00", "source_text": "YAOUNDÉ, Cameroon — In the village of Ndji, old electrical cables are draped over rickety wooden poles, hanging so low in places, they touch the ground. These makeshift installations provide electricity in this hamlet of about a thousand inhabitants. But Wilfried Eyebe, a local fisherman, explained that this power supply is unreliable. “The voltage is […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "ef8453f546c2fb6cb9ab87b78b3d50d3fb2fc9c9d7e3be0821dc284ef24b140b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:52.718056+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:52.737356+00:00", "published_at_raw": "2025-10-10T14:31:24", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon", "start": 0, "end": 8, "matched_text": "Cameroon", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon", "start": 9, "end": 17, "matched_text": "Cameroon", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_6911e602f906cae8e8b0", "record_id": "article_6911e602f906cae8", "canonical_url": "https://news.mongabay.com/2025/10/a-cacao-rush-drives-alarming-deforestation-in-liberia", "publisher_url": "https://news.mongabay.com/2025/10/a-cacao-rush-drives-alarming-deforestation-in-liberia", "title_original": "A cacao rush drives ‘alarming’ deforestation in Liberia", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-10T07:37:37+00:00", "source_text": "A rush to plant cacao in southeastern Liberia is destroying large tracts of rainforest. According to satellite data as well as interviews with local environmental advocates and government officials, the establishment of new plantations in regions that border Côte d’Ivoire is causing extensive deforestation and spurring conflicts over land. While some of the plantations are […]", "text_kind": "source_excerpt", "text_characters": 379, "text_sha256": "c66089f73bda973baa708412a8543427ea258f7b36ba149728a847b48a45ba11", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:52.774916+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "LR", "alpha3": "LBR", "name_zh": "利比里亚", "name_en": "Liberia"}, {"alpha2": "CI", "alpha3": "CIV", "name_zh": "科特迪瓦", "name_en": "Côte d’Ivoire"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "LR", "alpha3": "LBR", "na