{"text_id": "text_846d3e3865f3b20ef078", "record_id": "article_846d3e3865f3b20e", "canonical_url": "https://news.mongabay.com/2026/01/growing-native-plants-to-heal-land-at-indigenous-owned-nursery-in-british-columbia", "publisher_url": "https://news.mongabay.com/2026/01/growing-native-plants-to-heal-land-at-indigenous-owned-nursery-in-british-columbia", "title_original": "Growing native plants to heal land at Indigenous owned nursery in British Columbia", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-21T17:13:33+00:00", "source_text": "CRANBROOK, British Colombia | At the Nupqu Native Plant Nursery in the Canadian province of British Columbia, sulfur buckwheat seedlings fill Styrofoam trays. It’s October, the end of the growing season, and each is just a small cluster of dark-green, waxy, oval leaves, undersides bleeding to purple. Sulfur buckwheat (Eriogonum umbellatum) is a high-altitude grassland […]", "text_kind": "source_excerpt", "text_characters": 374, "text_sha256": "43c21a68470ca58687fa3bd5fc70ec05150246f6e73c9d2418642638b9ad737e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:30.791471+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:30.820216+00:00", "published_at_raw": "2026-01-21T17:13:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada", "start": 66, "end": 82, "matched_text": "British Columbia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 11, "end": 18, "matched_text": "British", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 19, "end": 27, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada", "start": 92, "end": 108, "matched_text": "British Columbia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_5572951b2dbd6c70dc8b", "record_id": "article_5572951b2dbd6c70", "canonical_url": "https://dialogue.earth/en/energy/how-the-global-south-can-deepen-the-benefits-of-chinese-clean-tech-investment", "publisher_url": "https://dialogue.earth/en/energy/how-the-global-south-can-deepen-the-benefits-of-chinese-clean-tech-investment", "title_original": "How the Global South can deepen the benefits of Chinese clean-tech investment", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-20T17:49:00+00:00", "source_text": "In late 2024, some of the largest Chinese-owned solar factories in Vietnam paused production. They were responding to preliminary rulings by the US on anti-dumping and countervailing duties. The pause exposed the risk of countries relying too heavily on foreign investment in factory operations alone. What had been missing was technology transfer. In other words, foreign firms sharing knowledge and technical capabilities with local firms and workers, enabling them to use and eventually develop technologies themselves. Also limited was the connected provision of value addition, meaning the creation of solid local jobs and industries, and movement up the value chain from product assembly or raw material export.", "text_kind": "article_excerpt", "text_characters": 717, "text_sha256": "52ff2b2ed30f793d943792164f4c171509fc9aa4caab3cb274a28a37d81e6c60", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:59.208877+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "VN", "alpha3": "VNM", "name_zh": "越南", "name_en": "Vietnam"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 48, "end": 53, "evidence": "In late 2024, some of the largest Chinese-owned solar factories in Vietnam paused production. They were responding to preliminary rulings by the US on anti-dumping and countervailing duties. Th"}], "policy_tools": [{"id": "cooperation", "label_zh": "合作与技术支持", "label_en": "Cooperation and technology", "start": 328, "end": 347, "evidence": " too heavily on foreign investment in factory operations alone. What had been missing was technology transfer. In other words, foreign firms sharing knowledge and technical capabilities with local firms and workers, enabling them to use and eventual"}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "VN", "alpha3": "VNM", "name_zh": "越南", "name_en": "Vietnam"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:59.243305+00:00", "published_at_raw": "2026-01-20T17:49:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 48, "end": 55, "matched_text": "Chinese", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 34, "end": 41, "matched_text": "Chinese", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "VN", "alpha3": "VNM", "name_zh": "越南", "name_en": "Vietnam", "start": 67, "end": 74, "matched_text": "Vietnam", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 145, "end": 147, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_a89db5d7745fc4a59b41", "record_id": "article_a89db5d7745fc4a5", "canonical_url": "https://news.mongabay.com/2026/01/too-many-african-plants-fall-into-the-iucns-not-evaluated-trap-commentary", "publisher_url": "https://news.mongabay.com/2026/01/too-many-african-plants-fall-into-the-iucns-not-evaluated-trap-commentary", "title_original": "Too many African plants fall into the IUCN’s ‘not evaluated’ trap (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-20T16:41:05+00:00", "source_text": "Many African conservation decisions such as funding, policy, species prioritization and nursery propagation implicitly treat the IUCN Red List as a complete map of extinction risk. It is not. For plants including trees, the biggest risk is not only that we mis-rank species, it’s that we overlook vast numbers of species that have never been […]", "text_kind": "source_excerpt", "text_characters": 345, "text_sha256": "16b6d3dc935de10d5d1f29e477311e06f284ca7919a3d731759c462781dd3d84", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:30.894403+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 44, "end": 51, "evidence": "Many African conservation decisions such as funding, policy, species prioritization and nursery propagation implicitly treat the IUCN Red List as a complete map of extinction risk. It is not."}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:30.918044+00:00", "published_at_raw": "2026-01-20T16:41:05", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_45536177097d89624f29", "record_id": "article_45536177097d8962", "canonical_url": "https://yaleclimateconnections.org/2026/01/milwaukee-pushes-ahead-on-energy-efficiency-despite-lost-federal-funds", "publisher_url": "https://yaleclimateconnections.org/2026/01/milwaukee-pushes-ahead-on-energy-efficiency-despite-lost-federal-funds", "title_original": "Milwaukee pushes ahead on energy efficiency despite lost federal funds", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-20T12:00:00+00:00", "source_text": "Transcript: In late November, after months of uncertainty, the federal government released billions of dollars to fund the low-income home energy assistance program, or LIHEAP. LIHEAP helps people pay their energy bills so they can keep their homes warm in winter. But in many cities, programs that could help residents cut their energy use – so their bills are lower – remain under threat. Shambarger: “There are things that we can do in our homes to cut energy use without impacting the comfort of the home, so things like making sure that our homes are properly insulated, and when it comes time to replace furnaces and air conditioners, to think about heat pumps.” Erick Shambarger is Milwaukee’s environmental sustainability director.", "text_kind": "article_excerpt", "text_characters": 739, "text_sha256": "898400f9ae7c4c6fd7dbf2363b880248e4b561f48ad32dfdd150842b6229fa0c", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:34.593206+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 139, "end": 145, "evidence": "ertainty, the federal government released billions of dollars to fund the low-income home energy assistance program, or LIHEAP. LIHEAP helps people pay their energy bills so they can keep their homes warm in winter. But in many cities, "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:34.612362+00:00", "published_at_raw": "2026-01-20T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_2a9af678e6cd76c6671c", "record_id": "article_2a9af678e6cd76c6", "canonical_url": "https://insideclimatenews.org/news/16012026/federal-court-allows-dominion-energy-in-virginia-to-continue-offshore-wind-project", "publisher_url": "https://insideclimatenews.org/news/16012026/federal-court-allows-dominion-energy-in-virginia-to-continue-offshore-wind-project", "title_original": "Federal Court Allows Dominion Energy in Virginia to Continue Offshore Wind Project", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-17T02:03:22+00:00", "source_text": "NORFOLK, Va.—U.S. District Court Judge Jamar K. Walker granted Dominion Energy a preliminary injunction on Friday, pausing a stop work order from the Trump administration and allowing the utility to resume construction on its Coastal Virginia Offshore Wind project as a court case proceeds. The ruling comes after the Interior Department last month issued the […]", "text_kind": "source_excerpt", "text_characters": 363, "text_sha256": "feca5858b2a4fb0ccdc7fe28700278580e23a14b4910dd51945d1eb9d25dfbae", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:08.761690+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 72, "end": 78, "e