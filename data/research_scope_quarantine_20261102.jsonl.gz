{"text_id": "text_725b1b401a23b41701e9", "record_id": "article_725b1b401a23b417", "canonical_url": "https://insideclimatenews.org/news/01052026/florida-opens-criminal-probe-into-sloth-world", "publisher_url": "https://insideclimatenews.org/news/01052026/florida-opens-criminal-probe-into-sloth-world", "title_original": "Florida Opens Criminal Probe Into Sloth World After Dozens of Animal Deaths", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-01T19:34:47+00:00", "source_text": "The Florida Attorney General’s office announced a criminal investigation into the deaths of dozens of sloths at a now-shuttered Orlando business, a development that signals a new level of animal-welfare accountability in the commercial wildlife trade. In a letter released Friday, Attorney General James Uthmeier confirmed his office is assisting the Ninth Judicial Circuit of […]", "text_kind": "source_excerpt", "text_characters": 380, "text_sha256": "53b7d8dc0e2d82e49b0e7920c7a4c8001dd14713dc3388888de1914d27ccef49", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:49.240359+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:49.272403+00:00", "published_at_raw": "2026-05-01T19:34:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_9164e1e32f74cf4cd256", "record_id": "article_9164e1e32f74cf4c", "canonical_url": "https://news.mongabay.com/2026/04/bangladesh-struggles-to-choose-between-food-security-stable-groundwater-table", "publisher_url": "https://news.mongabay.com/2026/04/bangladesh-struggles-to-choose-between-food-security-stable-groundwater-table", "title_original": "Bangladesh struggles to choose between food security & stable groundwater table", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-04-30T17:19:02+00:00", "source_text": "Considering the rapidly depleting groundwater table in Bangladesh’s northwestern zone, known as the Barind Tract, the country declared 25 subdistricts of the region as water crisis-prone areas in December 2025. In a circular, the government suggested that farmers immediately cut their cultivation of the high irrigation-intensive rice variety boro. At the same time, it directed […]", "text_kind": "source_excerpt", "text_characters": 383, "text_sha256": "756b860786b0b3df95092c3a764437f515374b17d4f798b2744ef91f331915fa", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:02.025975+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BD", "alpha3": "BGD", "name_