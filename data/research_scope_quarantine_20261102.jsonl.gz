{"text_id": "text_1af3bcb93795e7e94a59", "record_id": "article_1af3bcb93795e7e9", "canonical_url": "https://news.mongabay.com/2026/09/decline-of-migratory-birds-spurs-calls-for-coordinated-conservation", "publisher_url": "https://news.mongabay.com/2026/09/decline-of-migratory-birds-spurs-calls-for-coordinated-conservation", "title_original": "Decline of migratory birds spurs calls for coordinated conservation", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-14T14:09:40+00:00", "source_text": "NAIROBI — The decline of many migratory bird populations is a red flag that ecosystems around the world are under increasing pressure, conservation experts warn, adding it’s time for governments to come together and coordinate conservation efforts across national borders. Representatives from governments, conservation agencies, NGOs, financial institutions, and donors gathered in Nairobi from Sept. […]", "text_kind": "source_excerpt", "text_characters": 405, "text_sha256": "f83e95cc43bdc35d1fb195636df3e2f68ab8a1d2b8898b28cb56d5bb2d25befc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:53.801552+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endp