{"text_id": "text_4b452c4be8174a9f1132", "record_id": "article_4b452c4be8174a9f", "canonical_url": "https://insideclimatenews.org/news/16122025/new-orleans-architect-finds-dutch-answer-to-living-with-water", "publisher_url": "https://insideclimatenews.org/news/16122025/new-orleans-architect-finds-dutch-answer-to-living-with-water", "title_original": "After Hurricane Katrina, a New Orleans Architect Turned to the Dutch to Learn to Live With Water", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-16T09:50:00+00:00", "source_text": "For years, David Waggonner designed courthouses and other public buildings at his architectural practice, Waggonner & Ball, in New Orleans. Then Hurricane Katrina struck in 2005, and Waggonner became convinced that New Orleans was getting something fundamentally wrong about its approach to flooding and water. For help, Waggonner turned to the Netherlands, a country with […]", "text_kind": "source_excerpt", "text_characters": 376, "text_sha256": "f14a3100028eb40a1cdcb4d6fce25b15bd61e538123fb1ba32b30e7c3d1a8677", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:27.869468+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NL", "alpha3": "NLD", "name_zh": "荷兰", "name_en": "Netherlands"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 291, "end": 296, "evidence": "onvinced that New Orleans was getting something fundamentally wrong about its approach to flooding and water. For help, Waggonner turned to the Netherlands, a country with […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NL", "alpha3": "NLD", "name_zh": "荷兰", "name_en": "Netherlands"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:27.892680+00:00", "published_at_raw": "2025-12-16T09:50:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NL", "alpha3": "NLD", "name_zh": "荷兰", "name_en": "Netherlands", "start": 345, "end": 356, "matched_text": "Netherlands", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_2d72a348ab5ef2c95329", "record_id": "article_2d72a348ab5ef2c9", "canonical_url": "https://insideclimatenews.org/news/14122025/cokeville-wyoming-ranch-scale-solar", "publisher_url": "https://insideclimatenews.org/news/14122025/cokeville-wyoming-ranch-scale-solar", "title_original": "Wyoming Ranchers Hoping Solar Can Lower Costs Say Utilities and the State Stand in Their Way", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-14T10:00:00+00:00", "source_text": "COKEVILLE, Wyo.—Tim Teichert and Jason Thornock want the sun to help them survive as ranchers in Cokeville, Wyoming. On an overcast May day, the two drove around the one-restaurant town, lamenting high electricity prices and restrictive Wyoming laws that they say have thrown an unnecessary burden onto their broad shoulders. “I pay $90,000 in an […]", "text_kind": "source_excerpt", "text_characters": 350, "text_sha256": "fcd98a0571cc5acb59e70ad89dec12e3916f56685f9276f457f07f8f1994fac8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:28.069325+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:28.093837+00:00", "published_at_raw": "2025-12-14T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_2ff565c1a5c42f3f7640", "record_id": "article_2ff565c1a5c42f3f", "canonical_url": "https://news.mongabay.com/2025/12/top-down-projects-exotic-trees-weak-tenure-congo-basin-restoration-misses-the-mark", "publisher_url": "https://news.mongabay.com/2025/12/top-down-projects-exotic-trees-weak-tenure-congo-basin-restoration-misses-the-mark", "title_original": "Top-down projects, exotic trees, weak tenure: Congo Basin restoration misses the mark", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-12T16:49:18+00:00", "source_text": "The Congo Basin, the world’s largest tropical rainforest after the Amazon, is under mounting pressure. The Congo’s vast green canopy, stretching across six countries and storing more carbon than the Amazon, is vanishing at an alarming rate — losing an average of 1.79 million hectares (4.42 million acres) per year between 2015 and 2019. The […]", "text_kind": "source_excerpt", "text_characters": 345, "text_sha256": "16b6830394536c047a02c068cf1075f8ecdbab8633a7ddd2e761945624d91139", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:58.552363+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "1.79 million", "start": 263, "end": 275, "evidence": " The Congo’s vast green canopy, stretching across six countries and storing more carbon than the Amazon, is vanishing at an alarming rate — losing an average of 1.79 million hectares (4.", "interpretation": "not_classified"}, {"value_text": "4.42 million", "start": 286, "end": 298, "evidence": "79 million hectares (4.42 million acres) per year between 2015 and 2019.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:58.581363+00:00", "published_at_raw": "2025-12-12T16:49:18", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_5fc95a7b2f744b83711d", "record_id": "article_5fc95a7b2f744b83", "canonical_url": "https://insideclimatenews.org/news/12122025/gaza-catastrophic-winter-amid-environmental-humanitarian-devastation", "publisher_url": "https://insideclimatenews.org/news/12122025/gaza-catastrophic-winter-amid-environmental-humanitarian-devastation", "title_original": "Gaza Faces Another Catastrophic Winter as Environmental and Humanitarian Devastation Mount", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-12T09:55:00+00:00", "source_text": "Every day when Rajaa Musleh wakes up and checks her phone, she fears she will see news that another member of her family has been killed in Gaza. Musleh, a nurse and humanitarian worker who evacuated from Gaza to Cairo last year, works at the charity organization Human Concern International delivering food, medicine and other […]", "text_kind": "source_excerpt", "text_characters": 331, "text_sha256": "8935cace85026735d5b97db11323f4e00a8c9a38975b18208642ef9df3bb6304", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:28.420160+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:28.440111+00:00", "published_at_raw": "2025-12-12T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_4ae754a6ebb0ee8b07ac", "record_id": "article_4ae754a6ebb0ee8b", "canonical_url": "https://news.mongabay.com/2025/12/my-mother-would-not-be-happy-with-the-state-of-the-planet-interview-with-wanjira-mathai", "publisher_url": "https://news.mongabay.com/2025/12/my-mother-would-not-be-happy-with-the-state-of-the-planet-interview-with-wanjira-mathai", "title_original": "‘My mother would not be happy with the state of the planet’: Interview with Wanjira Mathai", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-11T16:16:10+00:00", "source_text": "Twenty years after Wangari Maathai received the Nobel Peace Prize for her courageous defense of forests, democracy and women’s rights, the United Nations Environment Programme honored her legacy this week at a commemorative event held in Nairobi. The moment unfolded as more than 6,000 delegates gathered in the Kenyan capital for the seventh session of […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "34d70475d848c9fff7ef43c3631f7df942f7955b147bbf46ab2c51b7dafa8085", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:58.760146+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:58.794202+00:00", "published_at_raw": "2025-12-11T16:16:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_1cfcfa363acfd921d95d", "record_id": "article_1cfcfa363acfd921", "canonical_url": "https://news.mongabay.com/2025/12/small-cat-conservationists-hail-ugandas-new-echuya-forest-national-park", "publisher_url": "https://news.mongabay.com/2025/12/small-cat-conservationists-hail-ugandas-new-echuya-forest-national-park", "title_original": "Small cat conservationists hail Uganda’s new Echuya Forest National Park", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-11T14:56:58+00:00", "source_text": "In what’s being called immensely good news for the African golden cat, often described as the continent’s most elusive and threatened wildcat species, Uganda’s Echuya Forest will become a national park. “Having Echuya elevated to that level of protection is massive,” says Badru Mugerwa, founder and director of Embaka, an NGO, and of the African […]", "text_kind": "source_excerpt", "text_characters": 350, "text_sha256": "c89b15cb3db7d3b6820628d9cfde630e0d5037e26fe50f4fe32aaee52fd4646c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:58.804787+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "UG", "alpha3": "UGA", "name_zh": "乌干达", "name_en": "Uganda"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "UG", "alpha3": "UGA", "name_zh": "乌干达", "name_en": "Uganda"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:58.886035+00:00", "published_at_raw": "2025-12-11T14:56:58", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "UG", "alpha3": "UGA", "name_zh": "乌干达", "name_en": "Uganda", "start": 32, "end": 38, "matched_text": "Uganda", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "UG", "alpha3": "UGA", "name_zh": "乌干达", "name_en": "Uganda", "start": 151, "end": 157, "matched_text": "Uganda", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_8e1072f69f3b7e74aee7", "record_id": "article_8e1072f69f3b7e74", "canonical_url": "https://dialogue.earth/en/climate/highlights-from-2025-on-dialogue-earth", "publisher_url": "https://dialogue.earth/en/climate/highlights-from-2025-on-dialogue-earth", "title_original": "Highlights from 2025 on Dialogue Earth", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-10T16:58:20+00:00", "source_text": "In April 2024, we became Dialogue Earth, uniting our four previous homes – China Dialogue, China Dialogue Ocean, The Third Pole and Diálogo Chino. As our first full year under one roof draws to a close, we present some highlights from our mission to publish environmental journalism that builds a common understanding of global challenges and platforms local voices. There are dozens more Dialogue Earth articles that easily could have qualified for our selection below. We encourage you to browse all of our articles if you have time.", "text_kind": "article_excerpt", "text_characters": 535, "text_sha256": "68c33f3eb68bd0a9105d96ccd7c2a865ff62e873e8e50c0a3c32c5c56bc3b49b", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:01.549856+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:01.673798+00:00", "published_at_raw": "2025-12-10T16:58:20", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 75, "end": 80, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_5fc97c508ea1612468c9", "record_id": "article_5fc97c508ea16124", "canonical_url": "https://insideclimatenews.org/news/10122025/greenpeace-spotlights-energy-transfer-pipeline-environmental-record", "publisher_url": "https://insideclimatenews.org/news/10122025/greenpeace-spotlights-energy-transfer-pipeline-environmental-record", "title_original": "Greenpeace Scrutinizes the Environmental Record of the Company That Sued the Group", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-10T11:00:00+00:00", "source_text": "The environmental nonprofit Greenpeace was under the microscope in a North Dakota trial this year. Now the organization is calling attention to the environmental impacts of the pipeline company that brought it to court and won a $345 million judgment. A new report released Wednesday identifies oil spills, gas releases, air pollution and other incidents […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "bd9363357fa15e0aac3cc0d87ded29a8c862d95803155dad6456e65ae61d4f49", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:28.896903+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$345 million", "start": 229, "end": 241, "evidence": " Now the organization is calling attention to the environmental impacts of the pipeline company that brought it to court and won a $345 million judgment.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:28.916831+00:00", "published_at_raw": "2025-12-10T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_3f56d77c9b269acc4e39", "record_id": "article_3f56d77c9b269acc", "canonical_url": "https://insideclimatenews.org/news/10122025/gas-stoves-nitrogen-dioxide-exposure", "publisher_url": "https://insideclimatenews.org/news/10122025/gas-stoves-nitrogen-dioxide-exposure", "title_original": "Gas Stoves Account For More Than Half of Some Americans’ Exposure to a Known Toxic Substance, New Research Concludes", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-10T09:55:00+00:00", "source_text": "Pollution from gas stoves accounts for more than half of some Americans’ total exposure to nitrogen dioxide (NO2), a toxic substance linked to asthma, a study in the academic journal PNAS Nexus concludes. The findings, published this month, provide the first nationwide, community-level estimates of residential NO2 exposure. The study assessed both outdoor air pollution […]", "text_kind": "source_excerpt", "text_characters": 375, "text_sha256": "58d669962da154c26df2db8812007068128ad4be44e514eb22a16b3b7990ba6b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:29.028628+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:29.053491+00:00", "published_at_raw": "2025-12-10T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_801824b06f3fc3a96888", "record_id": "article_801824b06f3fc3a9", "canonical_url": "https://insideclimatenews.org/news/04122025/trump-administration-national-monuments-threats-could-endanger-drinking-water", "publisher_url": "https://insideclimatenews.org/news/04122025/trump-administration-national-monuments-threats-could-endanger-drinking-water", "title_original": "Trump Administration’s Threats to Shrink or Eliminate National Monuments Could Endanger Drinking Water for Millions", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-04T17:15:00+00:00", "source_text": "The 31 national monuments designated since the Clinton administration, which could be downsized as the Trump administration pushes to open more public lands to extractive industries, safeguard clean water for millions of Americans, according to a new analysis from the Center for American Progress. Using geospatial data to quantify the miles of rivers and watersheds […]", "text_kind": "source_excerpt", "text_characters": 371, "text_sha256": "d35f5cd4fe7b7ced0b160477fff64868763e774b928e564f3d46abfe8be27042", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:34.989925+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_stat