{"text_id": "text_1b31db5cd50f0d67e780", "record_id": "article_1b31db5cd50f0d67", "canonical_url": "https://insideclimatenews.org/news/26102025/virginia-data-center-capital-ai-boom", "publisher_url": "https://insideclimatenews.org/news/26102025/virginia-data-center-capital-ai-boom", "title_original": "How Did This State Become the Data Center Capital of the World?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-26T09:00:00+00:00", "source_text": "ASHBURN, Va.—Driving up the six-lane Route 28 in Loudoun County, Virginia, there’s a dark blue one on the left. Further up the way in a small clearing of trees, there’s a gray one on the right. Across the landscape, metal cables criss-cross in every direction to connect power to the sprawling buildings. They’re not big-box […]", "text_kind": "source_excerpt", "text_characters": 328, "text_sha256": "12e9a7124bc28d326537c1c1af97cb1f7644c25d4e17bf0b071f89ba174dec3e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:02.095273+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:02.109229+