{"text_id": "text_268d57dab135ad9a1cbb", "record_id": "article_268d57dab135ad9a", "canonical_url": "https://insideclimatenews.org/news/08082024/vp-candidate-tim-walz-agriculture-conservation-connections", "publisher_url": "https://insideclimatenews.org/news/08082024/vp-candidate-tim-walz-agriculture-conservation-connections", "title_original": "VP Candidate Tim Walz Has Deep Connections to Agriculture and Conservation", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-08T22:11:01+00:00", "source_text": "Soon after Vice President Kamala Harris selected Tim Walz as her running mate this week, pictures of the Minnesota governor began to spread across social media—of Walz holding a piglet, of Walz on thrill rides at the state fair, of Walz and his rescue dog. All of it coalesces into an image of a guy […]", "text_kind": "source_excerpt", "text_characters": 303, "text_sha256": "9bd56d978d341853f261230446fe6c5088d75270e3f53300b367e530e56b113d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:15.557000+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 267, "end": 271, "evidence": " piglet, of Walz on thrill rides at the state fair, of Walz and his rescue dog. All of it coalesces into an image of a guy […]"}], "policy_tools": [], "policy_stages": [], "track": 