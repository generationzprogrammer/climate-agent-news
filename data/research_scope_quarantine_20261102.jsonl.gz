{"text_id": "text_eb30b3b79e2682f97f11", "record_id": "article_eb30b3b79e2682f9", "canonical_url": "https://yaleclimateconnections.org/2025/04/worlds-cargo-ships-to-pay-more-for-dirty-fuel-under-new-rules", "publisher_url": "https://yaleclimateconnections.org/2025/04/worlds-cargo-ships-to-pay-more-for-dirty-fuel-under-new-rules", "title_original": "World’s cargo ships to pay more for dirty fuel under new rules", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-28T11:00:00+00:00", "source_text": "A landmark policy crafted in April by members of the U.N.’s International Maritime Organization, or IMO, will tax international shippers based on the carbon content of their fuels. The draft policy is due to be finalized in late 2025. The agreement that emerged from the 83rd meeting of the IMO’s Marine Environment Protection Committee was undeniably a compromise – critiqued by activists and oil-rich nations alike. Yet it’s also undeniably historic.", "text_kind": "article_excerpt", "text_characters": 452, "text_sha256": "1c0cf47e16f552c876892469126190577e1c2acc806411b88f00b104428f703b", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:58.621332+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:58.639118+00:00", "published_at_raw": "2025-04-28T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_e7c81c884b153a2799fe", "record_id": "article_e7c81c884b153a27", "canonical_url": "https://insideclimatenews.org/news/27042025/texas-wastewater-polluting-rivers-streams", "publisher_url": "https://insideclimatenews.org/news/27042025/texas-wastewater-polluting-rivers-streams", "title_original": "In Booming Central Texas, Wastewater Is Polluting Rivers and Streams", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-27T09:00:00+00:00", "source_text": "TARPLEY, Texas–Margo Denke set out to rally the town when she learned that a Christian youth camp planned to build a wastewater treatment plant and discharge its effluent into the pristine Hill Country creek that ran through her small ranch. Denke, a 1981 graduate of Harvard Medical School who moved to the Hill Country in […]", "text_kind": "source_excerpt", "text_characters": 327, "text_sha256": "64eeb37c59c1bca9314676aeac5bcdd8375b5dc6142b3d60be835f0ff00bcaba", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:11.672048+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:11.688122+00:00", "published_at_raw": "2025-04-27T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 19, "end": 24, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 9, "end": 14, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_cffaeafbe995062f0315", "record_id": "article_cffaeafbe995062f", "canonical_url": "https://insideclimatenews.org/news/25042025/todays-climate-last-mile-warehouses-pollution-shopping", "publisher_url": "https://insideclimatenews.org/news/25042025/todays-climate-last-mile-warehouses-pollution-shopping", "title_original": "Behind the Scenes: Communities Around ‘Last-Mile Warehouses’ Struggle With Online Shopping Boom’s Pollution", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-25T18:35:07+00:00", "source_text": "Online shopping has reached epic proportions in the United States—and Manhattan is its beating heart. More than 2.4 million packages are delivered to New York City every weekday, and around 90 percent of goods are transported into or around the city by trucks. While shipping may be free for consumers on many of these orders, […]", "text_kind": "source_excerpt", "text_characters": 330, "text_sha256": "ab7447bd8915e0c0f119ed9cc29d872a28957f50184a423e5ec922d24ca12a59", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:11.951315+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "2.4 million", "start": 112, "end": 123, "evidence": " More than 2.4 million packages are delivered to New York City every weekday, and around 90 percent of goods are transported into or around the city by trucks.", "interpretation": "not_classified"}, {"value_text": "90 percent", "start": 190, "end": 200, "evidence": "4 million packages are delivered to New York City every weekday, and around 90 percent of goods are transported into or around the city by trucks.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:11.977953+00:00", "published_at_raw": "2025-04-25T18:35:07", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 52, "end": 65, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_aa5ffe38737a14f834c9", "record_id": "article_aa5ffe38737a14f8", "canonical_url": "https://insideclimatenews.org/news/25042025/jbs-brazil-meet-company-gets-approval-for-new-york-stock-exchange", "publisher_url": "https://insideclimatenews.org/news/25042025/jbs-brazil-meet-company-gets-approval-for-new-york-stock-exchange", "title_original": "The World’s Biggest Meat Company Gets the Greenlight to Go Public on the New York Stock Exchange", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-25T08:55:00+00:00", "source_text": "The world’s largest meat company, Brazil-based JBS, has sought a listing on the New York Stock Exchange for more than a decade, but the company, which has long been accused of links to illegal deforestation in the Amazon, was stymied by corruption charges. On Wednesday, the U.S. Securities and Exchange Commission greenlighted the listing, despite […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "57ebf662883da68607d6ceb4f9e5084b8d08d646cdebf87ebfdc69f38c70d6bf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:12.147952+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:12.164927+00:00", "published_at_raw": "2025-04-25T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 34, "end": 40, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 275, "end": 279, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_a7a0f35e1139a5d112d3", "record_id": "article_a7a0f35e1139a5d1", "canonical_url": "https://insideclimatenews.org/news/24042025/inside-clean-energy-community-solar-plays-defense-in-minnesota", "publisher_url": "https://insideclimatenews.org/news/24042025/inside-clean-energy-community-solar-plays-defense-in-minnesota", "title_original": "Community Solar Plays Defense in Minnesota", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-24T13:00:00+00:00", "source_text": "A groundbreaking community solar program is fighting for its life in Minnesota. Legislation in the state Senate would end the subscription-based “solar garden” program that started in 2013, got a major revision in 2023 and has been a model for other states. The case against this initiative can be summed up by testimony last month […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "db0451b45c3e9135769349c5d15b8c8056925013c975acdf91ea277e25444f01", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:12.314634+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 27, "end": 32, "evidence": "A groundbreaking community solar program is fighting for its life in Minnesota. Legislation in the state Senate would end the subscription-based “solar garden” program that"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:12.330576+00:00", "published_at_raw": "2025-04-24T13:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_a487e218a8a87df169ee", "record_id": "article_a487e218a8a87df1", "canonical_url": "https://insideclimatenews.org/news/23042025/pine-barrens-prescribed-burns-reduced-then-wildfire-hit", "publisher_url": "https://insideclimatenews.org/news/23042025/pine-barrens-prescribed-burns-reduced-then-wildfire-hit", "title_original": "New Jersey Cut Back on Prescribed Burns in the Pine Barrens—and Faces a Wildfire That Charred Thousands of Acres", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-23T16:21:51+00:00", "source_text": "New Jersey has a million acres filled with towering pitch pines. It’s springtime and the trees stand straight, bare and bonelike, above a carpet of winter needles that worry state fire service professionals. This week, a swath of the Pine Barrens went up in flames, a stark warning of what might be a treacherous fire […]", "text_kind": "source_excerpt", "text_characters": 321, "text_sha256": "e7eb157aafb9fe9cfaed47cf79d8a67572c498a926e39b9d0a306d22689d73f7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:12.443368+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:12.468924+00:00", "published_at_raw": "2025-04-23T16:21:51", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 10, "matched_text": "New Jersey", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 10, "matched_text": "New Jersey", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_38c9484b6600995812ab", "record_id": "article_38c9484b66009958", "canonical_url": "https://news.mongabay.com/2025/04/building-environmental-laws-across-amazon-countries", "publisher_url": "https://news.mongabay.com/2025/04/building-environmental-laws-across-amazon-countries", "title_original": "Building environmental laws across Amazon countries", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-23T12:02:19+00:00", "source_text": "Historically, most countries regulated their biological resources via the agriculture ministry, using laws specific for managing forests, wildlife and fish. Many were inspired by commitments made via United Nations treaties, most notably the World Heritage Convention (WHC) and the Convention on International Trade in Endangered Species of Wild Fauna and Flora (CITES), or by decisions […]", "text_kind": "source_excerpt", "text_characters": 390, "text_sha256": "e91e6271b55247ada5a5fd1450ccbeea6b639bdc5d3df4481ef5e11288ec867d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:30.370102+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archiv