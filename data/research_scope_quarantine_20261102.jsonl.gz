{"text_id": "text_7ec2c3e16e0caf642783", "record_id": "article_7ec2c3e16e0caf64", "canonical_url": "https://yaleclimateconnections.org/2024/05/april-2024-earths-11th-consecutive-warmest-month-on-record", "publisher_url": "https://yaleclimateconnections.org/2024/05/april-2024-earths-11th-consecutive-warmest-month-on-record", "title_original": "April 2024: Earth’s 11th-consecutive warmest month on record", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-14T15:06:08+00:00", "source_text": "During April 2024, an astonishing 34 nations or territories set or tied an all-time monthly heat record, and seven set or tied an all-time heat record for any month.", "text_kind": "source_excerpt", "text_characters": 165, "text_sha256": "69d1728f31ea747a18bd6c599bb80029e65cb57401b804c616c28211ddaa840c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:05.809961+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:05.821739+00:00", "published_at_raw": "2024-05-14T15:06:08", "sample_frame": "public_archives_20261102", "sampling_method": 