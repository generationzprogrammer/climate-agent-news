{"text_id": "text_227b20cc293c1a6f7cb1", "record_id": "article_227b20cc293c1a6f", "canonical_url": "https://insideclimatenews.org/news/21112024/whale-ship-collision-global-hotspots-lack-protections", "publisher_url": "https://insideclimatenews.org/news/21112024/whale-ship-collision-global-hotspots-lack-protections", "title_original": "Scientists Identify Global Hotspots for Whale-Ship Collisions—and Hardly Any Have Protections in Place", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-21T20:51:39+00:00", "source_text": "An estimated 90 percent of all traded goods travel by sea, where vessels tap into a vast network of shipping routes that connect even the most far-flung places. But humans aren’t the only ones traversing vast distances across these marine highways. A new study found that shipping occurs in more than 90 percent of whale […]", "text_kind": "source_excerpt", "text_characters": 324, "text_sha256": "951ebbc24c651c7e45e84b42ef49976b35fc8ab70840b2c73d084251f68853af", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:27.991546+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "90 percent", "start": 13, "end": 23, "evidence": "An estimated 90 percent of all traded goods travel by sea, where vessels tap into a vast network of shipping routes that connect even the most far-flung places.", "interpretation": "not_classified"}, {"value_text": "90 percent", "start": 301, "end": 311, "evidence": " A new study found that shipping occurs in more than 90 percent of whale […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:28.016688+00:00", "published_at_raw": "2024-11-21T20:51:39", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_836b5b01cf7423480e3c", "record_id": "article_836b5b01cf742348", "canonical_url": "https://dialogue.earth/en/climate/uruguay-elections-what-environmental-issues-face-its-next-president", "publisher_url": "https://dialogue.earth/en/climate/uruguay-elections-what-environmental-issues-face-its-next-president", "title_original": "Uruguay elections: What environmental issues face its next president?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-21T17:50:15+00:00", "source_text": "On 1 March 2025, a new government will take office in Uruguay. Should the projections of some forecasts come to fruition, the new administration will face its first hurdle in a drought, potentially as severe as the one the country suffered in winter 2023 . During one of the country’s worst ever water crises, more than 1.6 million citizens had to resort to using fresh water mixed with salt water, due to a decline in the Santa Lucia River basin, the sole supplier of water to capital city Montevideo and its metropolitan area. Water and access to sanitation, recognised as human rights in Uruguay’s constitution , have been among the most important issues for the two campaigns that will contest the ballot this Sunday 24 November.", "text_kind": "article_excerpt", "text_characters": 733, "text_sha256": "8d02483f30acab9e9dc5d2e1b3f8606e21826e1ccf7c5da26eee73830390eac9", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:48.662323+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "1.6 million", "start": 320, "end": 331, "evidence": " During one of the country’s worst ever water crises, more than 1.6 million citizens had to resort to using fresh water mixed with salt water, due to a decline in the Santa Lucia River basin, the sole supplier of water to capital city Montevideo and its metropolitan area.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "UY", "alpha3": "URY", "name_zh": "乌拉圭", "name_en": "Uruguay"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 177, "end": 184, "evidence": "f some forecasts come to fruition, the new administration will face its first hurdle in a drought, potentially as severe as the one the country suffered in winter 2023 . During one of the country’s worst ever water crises, more than 1.6 "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "UY", "alpha3": "URY", "name_zh": "乌拉圭", "name_en": "Uruguay"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:48.682300+00:00", "published_at_raw": "2024-11-21T17:50:15", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "UY", "alpha3": "URY", "name_zh": "乌拉圭", "name_en": "Uruguay", "start": 0, "end": 7, "matched_text": "Uruguay", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "UY", "alpha3": "URY", "name_zh": "乌拉圭", "name_en": "Uruguay", "start": 54, "end": 61, "matched_text": "Uruguay", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_exce