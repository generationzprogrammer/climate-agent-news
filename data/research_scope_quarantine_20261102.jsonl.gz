{"text_id": "text_d16452f71e093ade4e86", "record_id": "article_d16452f71e093ade", "canonical_url": "https://news.mongabay.com/2025/12/fish-deformities-expose-collapse-of-xingu-rivers-pulse-after-construction-of-belo-monte-dam", "publisher_url": "https://news.mongabay.com/2025/12/fish-deformities-expose-collapse-of-xingu-rivers-pulse-after-construction-of-belo-monte-dam", "title_original": "Fish deformities expose ‘collapse’ of Xingu River’s pulse after construction of Belo Monte Dam", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-31T09:43:07+00:00", "source_text": "On Feb. 17, 2016, the gears ground into life at the massive Belo Monte hydroelectric plant, on the “Large Curve” of the Xingu River, or Volta Grande do Xingu, in the Brazilian Amazon. By April that year, the 11.2-gigawatt plant was already in commercial operation. That same year, researcher Jansen Zuanon visited Volta Grande do […]", "text_kind": "source_excerpt", "text_characters": 333, "text_sha256": "0b620c47727094a0529bf0d8c4a4189fe8a793aa8432fd5d92416252ef1c87f4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:39.158916+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_e