{"text_id": "text_c76b2351b473b3ee9a85", "record_id": "article_c76b2351b473b3ee", "canonical_url": "https://news.mongabay.com/2024/01/extreme-drought-in-western-para-pushes-family-farmers-into-agroforestry", "publisher_url": "https://news.mongabay.com/2024/01/extreme-drought-in-western-para-pushes-family-farmers-into-agroforestry", "title_original": "Extreme drought in western Pará pushes family farmers into agroforestry", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-04T10:17:08+00:00", "source_text": "JURUTI, Pará — As we approach the airport in Santarém, Pará, astonishment echoes loudly throughout the plane as its passengers see the extent of the drought below. Through the tiny window, we see the immense waters recede, leaving sandbanks exposed in the landscape. Beneath a sky that has not brought rain in months and walking […]", "text_kind": "source_excerpt", "text_characters": 332, "text_sha256": "6aa7773bd323649c7682c75416f13fd43bdd1d89713296b2aec3a572233e691e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:34.126616+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 149, "end": 156, "evidence": ", astonishment echoes loudly throughout the plane as its passengers see the extent of the drought below. Through the tiny window, we see the immense waters recede, leaving sandbanks exposed in the landscape. Beneath a sky that has not br"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:34.140187+00:00", "published_at_raw": "2024-01-04T10:17:08", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_2213909fb96ec289e22b", "record_id": "article_2213909fb96ec289", "canonical_url": "https://news.mongabay.com/2024/01/beyond-the-myths-anthropologist-alison-richard-on-madagascars-environmental-realities-and-future", "publisher_url": "https://news.mongabay.com/2024/01/beyond-the-myths-anthropologist-alison-richard-on-madagascars-environmental-realities-and-future", "title_original": "Beyond the myths: Anthropologist Alison Richard on Madagascar’s environmental realities and future", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-03T23:18:09+00:00", "source_text": "The island nation of Madagascar is celebrated for its extraordinary biodiversity, characterized by remarkably high rates of endemicism; approximately 90% of its wildlife is unique to the island, making it an unique and irreplaceable treasure trove of biological richness. This includes a myriad of distinctive species, such as lemurs, chameleons, and a diverse range of […]", "text_kind": "source_excerpt", "text_characters": 373, "text_sha256": "c6bd31c45ca993cb49217d201d20380cbb7f36ccb2bc521860ddbc88a72f83b5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:34.175327+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "90%", "start": 150, "end": 153, "evidence": "The island nation of Madagascar is celebrated for its extraordinary biodiversity, characterized by remarkably high rates of endemicism; approximately 90% of its wildlife is unique to the island, making it an unique and irreplaceable treasure trove of biological richness.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MG", "alpha3": "MDG", "name_zh": "马达加斯加", "name_en": "Madagascar"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MG", "alpha3": "MDG", "name_zh": "马达加斯加", "name_en": "Madagascar"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:34.191659+00:00", "published_at_raw": "2024-01-03T23:18:09", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MG", "alpha3": "MDG", "name_zh": "马达加斯加", "name_en": "Madagascar", "start": 51, "end": 61, "matched_text": "Madagascar", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "MG", "alpha3": "MDG", "name_zh": "马达加斯加", "name_en": "Madagascar", "start": 21, "end": 31, "matched_text": "Madagascar", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_bcbd650a591e098dfb03", "record_id": "article_bcbd650a591e098d", "canonical_url": "https://insideclimatenews.org/news/03012024/youngstown-ohio-tires-synthetic-gas-plant", "publisher_url": "https://insideclimatenews.org/news/03012024/youngstown-ohio-tires-synthetic-gas-plant", "title_original": "A Plant Proposed in Youngstown, Ohio, Would Have Turned Tons of Tires Into Synthetic Gas. Local Officials Said Not So Fast", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-03T10:00:00+00:00", "source_text": "Officials in Youngstown, Ohio, have dealt a setback to a company’s plan to build and operate a recycled tire waste-to-energy plant near the center of the city and adjacent to a neighborhood of predominantly Black residents, enacting a one-year moratorium on such industrial processes. Mayor Jamael Tito Brown signed the ordinance Dec. 26. The developer, […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "f8fa3fc1a14c451c6bf2cc98e6054ceae03132d405aa4a8479e99127555a01ea", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:48.879209+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 118, "end": 124, "evidence": "o, have dealt a setback to a company’s plan to build and operate a recycled tire waste-to-energy plant near the center of the city and adjacent to a neighborhood of predominantly Black residents, enacting a one-year moratorium on such i"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:48.893447+00:00", "published_at_raw": "2024-01-03T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_0c5548d49b5412fd8896", "record_id": "article_0c5548d49b5412fd", "canonical_url": "https://news.mongabay.com/2024/01/outlook-for-rainforests-2024", "publisher_url": "https://news.mongabay.com/2024/01/outlook-for-rainforests-2024", "title_original": "2024 outlook for rainforests", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-03T05:16:36+00:00", "source_text": "Last week, Mongabay published a recap of the major trends in the world’s tropical rainforests for 2023. Here’s a glimpse into some of the key issues to monitor in 2024. Brazil The deforestation rate in the Brazilian Amazon has declined significantly during President Lula’s first year of his third term, following the reinstatement of various […]", "text_kind": "source_excerpt", "text_characters": 346, "text_sha256": "b9157081e524667163c293cca4e1016853d68feb6923233b87d6831c1c2e4aab", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:34.320311+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:34.336983+00:00", "published_at_raw": "2024-01-03T05:16:36", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 169, "end": 175, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_c83777a3f05f5e5874d7", "record_id": "article_c83777a3f05f5e58", "canonical_url": "https://insideclimatenews.org/news/01012024/ireland-rights-of-nature-human-right-to-clean-environment", "publisher_url": "https://insideclimatenews.org/news/01012024/ireland-rights-of-nature-human-right-to-clean-environment", "title_original": "Ireland Could Become the Next Nation to Recognize the Rights of Nature and a Human Right to a Clean Environment", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-01T10:00:00+00:00", "source_text": "Ireland—a nation synonymous with its abundant, verdant landscapes—is considering a nationwide referendum on the rights of nature and the human right to a healthy environment. If that happens, Ireland would become the first European country to constitutionally recognize that ecosystems, similar to humans and corporations, possess legal rights. More than two-thirds of the 27 European […]", "text_kind": "source_excerpt", "text_characters": 388, "text_sha256": "9e5fc1f1a34c8065cb5d6e9f045b15c5281ac27ec3183be0949ed28341933386", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:48.948095+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IE", "alpha3": "IRL", "name_zh": "爱尔兰", "name_en": "Ireland"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IE", "alpha3": "IRL", "name_zh": "爱尔兰", "name_en": "Ireland"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:48.962499+00:00", "published_at_raw": "2024-01-01T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IE", "alpha3": "IRL", "name_zh": "爱尔兰", "name_en": "Ireland", "start": 0, "end": 7, "matched_text": "Ireland", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "IE", "alpha3": "IRL", "name_zh": "爱尔兰", "name_en": "Ireland", "start": 0, "end": 7, "matched_text": "Ireland", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_74198858202ee813ee67", "record_id": "article_74198858202ee813", "canonical_url": "https://news.mongabay.com/2023/12/nepals-birds-pay-cost-for-countrys-infrastructure-development", "publisher_url": "https://news.mongabay.com/2023/12/nepals-birds-pay-cost-for-countrys-infrastructure-development", "title_original": "Nepal’s birds pay cost for country’s infrastructure development", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-29T13:58:19+00:00", "source_text": "KATHMANDU — As Nepal, one of the least industrialized countries in the world, invests in hydropower and roads to lift its people’s living standards, balancing public aspirations with conservation has proved to be a major challenge. That was the view of leading ornithologist Hem Sagar Baral when illustrating the hurdles to biodiversity conservation, especially when […]", "text_kind": "source_excerpt", "text_characters": 370, "text_sha256": "2e223bc9dd8c69117bf5f6423229c9ede4728158468b0f5913a7175e13e5add4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:34.514053+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:34.526847+00:00", "published_at_raw": "2023-12-29T13:58:19", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 0, "end": 5, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 15, "end": 20, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_cae75fe6bce2e8e9a4d7", "record_id": "article_cae75fe6bce2e8e9", "canonical_url": "https://insideclimatenews.org/news/28122023/milking-it-battle-underway-california-dairy-biogas-market", "publisher_url": "https://insideclimatenews.org/news/28122023/milking-it-battle-underway-california-dairy-biogas-market", "title_original": "A Battle Is Underway Over California’s Lucrative Dairy Biogas Market", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-28T10:00:00+00:00", "source_text": "Every month, Cathy and Lenard Moreno hang fresh disposable fly traps around their backyard. In a few weeks, the plastic bags hang heavy, swollen with as many as 20,000 flies each. “That’s just disgusting,” said Lenard Moreno. “We’re constantly battling them.” The Morenos live in Planada, an unincorporated community in the heart of California’s Central […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "aaf953bb41c2f00d61ef70991ec7edb846966701a4cde7269f9c11c74124d4f1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:49.115883+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:49.138200+00:00", "published_at_raw": "2023-12-28T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 26, "end": 36, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 333, "end": 343, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_b7dd1343490feda4a897", "record_id": "article_b7dd1343490feda4", "canonical_url": "https://yaleclimateconnections.org/2023/12/floatovoltaics-could-help-the-southwest-generate-power-and-conserve-water", "publisher_url": "https://yaleclimateconnections.org/2023/12/floatovoltaics-could-help-the-southwest-generate-power-and-conserve-water", "title_original": "Floatovoltaics could help the Southwest generate power and conserve water", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-27T12:00:00+00:00", "source_text": "Just southeast of Phoenix, over 150 miles of canals sit uncovered in one of the hottest and driest regions of the country. The Gila River Indian community’s solar panel project , which would cover some of those canals with solar panels, could be the start of a new wave of such solar projects, known as floatovoltaics. A new study by an international team of researchers shows just how useful wide-scale floatovoltaics could be. They calculate that covering 30% of the surface of 115,000 reservoirs globally could generate 9,434 terawatt hours of power a year. That’s more than twice the energy the entire United States generates annually and enough to fully power over 6,200 cities in 124 countries.", "text_kind": "article_excerpt", "text_characters": 700, "text_sha256": "e36eddf1cdb3e842e9c9487b3bccdb2a68b3c219b85588b0fa281753ec54bedb", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:43.622803+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "30%", "start": 458, "end": 461, "evidence": " They calculate that covering 30% of the surface of 115,000 reservoirs globally could generate 9,434 terawatt hours of power a year.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 157, "end": 162, "evidence": "n one of the hottest and driest regions of the country. The Gila River Indian community’s solar panel project , which would cover some of those canals with solar panels, could be the start of a new wave of such solar projects, known as"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:43.646381+00:00", "published_at_raw": "2023-12-27T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 606, "end": 619, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_64f81fe75713c147145c", "record_id": "article_64f81fe75713c147", "canonical_url": "https://news.mongabay.com/2023/12/with-half-its-surface-water-area-lost-an-amazonian-state-runs-dry", "publisher_url": "https://news.mongabay.com/2023/12/with-half-its-surface-water-area-lost-an-amazonian-state-runs-dry", "title_original": "With half its surface water area lost, an Amazonian state runs dry", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-26T15:13:03+00:00", "source_text": "Water bodies across the Brazilian state of Roraima have shrunk in area by half over the past 20 years, according to research from the mapping collective MapBiomas.", "text_kind": "source_excerpt", "text_characters": 163, "text_sha256": "703d733718a8da23c6aae06289870e996a1da4282aabe617e7939b122dd6c99b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:34.921707+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:34.933418+00:00", "published_at_raw": "2023-12-26T15:13:03", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_167a2f8e579f5e6fecf6", "record_id": "article_167a2f8e579f5e6f", "canonical_url": "https://news.mongabay.com/2023/12/company-sells-indigenous-land-in-amazonas-as-nfts-without-communitys-knowledge", "publisher_url": "https://news.mongabay.com/2023/12/company-sells-indigenous-land-in-amazonas-as-nfts-without-communitys-knowledge", "title_original": "Company sells Indigenous land in Amazonas as NFTs without community’s knowledge", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-26T14:48:57+00:00", "source_text": "Areas of the Apurinã territory in the Lower Seruini area, in southern Amazonas state, were sold by Nemus under an NFT project that promises to preserve the forest and generate carbon credits.", "text_kind": "source_excerpt", "text_characters": 191, "text_sha256": "134a33033ef4d2234b3ab27c398a9956737f9a5bc2522622a7631a5b6688c90d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:34.948682+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "carbon_markets", "label_zh": "碳市场", "label_en": "Carbon markets", "start": 176, "end": 189, "evidence": "were sold by Nemus under an NFT project that promises to preserve the forest and generate carbon credits."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:34.958165+00:00", "published_at_raw": "2023-12-26T14:48:57", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578434+00:00"}
{"text_id": "text_5f4c11b190cb19e3c762", "record_id": "article_5f4c11b190cb19e3", "canonical_url": "https://yaleclimateconnections.org/2023/12/theres-still-time-to-save-50-of-the-worlds-glaciers", "publisher_url": "https://yaleclimateconnections.org/2023/12/theres-still-time-to-save-50-of-the-worlds-glaciers", "title_original": "There’s still time to save 50% of the world’s glaciers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-25T12:00:00+00:00", "source_text": "By 2100, researchers have found, an area of glaciers somewhere between the size of Iowa and New Mexico (or even a bit larger) will melt, leaving new ecosystems — terrestrial, marine, and freshwater — behind. But the final toll will depend on how much the world pollutes in the decades to come. Currently, about 10% of the land on Earth is covered in glaciers, but by the year 2100, an enormous number of these glaciers will melt, leaving behind novel ecosystems where there were previously glaciers. In a 2023 Nature article, “ Future emergence of new ecosystems caused by glacial retreat ,” scientists tallied up just how large an area of glaciers could melt by the turn of the century.", "text_kind": "article_excerpt", "text_characters": 687, "text_sha256": "6d570f7dca6873950106ee17e647c0b9a5d78812dd5b1efdb1b05252c1e2dcb0", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:43.715337+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "10%", "start": 311, "end": 314, "evidence": " Currently, about 10% of the land on Earth is covered in glaciers, but by the year 2100, an enormous number of these glaciers will melt, leaving behind novel ecosystems where there were previously glaciers.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:43.732965+00:00", "published_at_raw": "2023-12-25T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 92, "end": 102, "matched_text": "New Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578434+00:00"}
{"text_id": "text_d8cfbc25543cd4cffa8b", "record_id": "article_d8cfbc25543cd4cf", "canonical_url": "https://insideclimatenews.org/news/24122023/alabama-surface-mine-operating-without-permits", "publisher_url": "https://insideclimatenews.org/news/24122023/alabama-surface-mine-operating-without-permits", "title_original": "In Alabama, What Does It Take to Shut Down a Surface Mine Operating Without Permits?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-24T10:00:00+00:00", "source_text": "ADDISON, Alabama—When state environmental regulators in June approached the president of Rock Creek Stone, an Alabama-based sandstone quarry along Rock Creek, they were clear that a National Pollutant Discharge Elimination System (NPDES) permit and an air pollution permit, were required for operation, according to state records. “I reminded Mr. Johnson that he should not be […]", "text_kind": "source_excerpt", "text_characters": 380, "text_sha256": "3d24058a44b65d886865e455edbd37f16b2facbcb9a39578c0aff66ae9906d20", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:49.499087+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:49.513762+00:00", "published_at_raw": "2023-12-24T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.578434+00:00"}
{"text_id": "text_4ee1b9c70629fb68ea82", "record_id": "article_4ee1b9c70629fb68", "canonical_url": "https://news.mongabay.com/2023/12/u-s-and-u-k-lawmakers-must-wake-up-to-the-coffee-problem-commentary", "publisher_url": "https://news.mongabay.com/2023/12/u-s-and-u-k-lawmakers-must-wake-up-to-the-coffee-problem-commentary", "title_original": "U.S. and U.K. lawmakers must wake up to the coffee problem (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2023-12-21T01:19:13+00:00", "source_text": "Coffee. Nectar of the gods. Lifesaving energy booster that helps many of us start our days. Ubiquitously consumed around the world by people like me – without my beloved morning brew I am something of a discombobulatedgrumpyhedgehog. And yet, this top, globally traded agri-commodity is also a major driver of deforestation, mass extinction, child labor, slavery, […]", "text_kind": "source_excerpt", "text_characters": 367, "text_sha256": "bc168b8f279dabdd47e01998dfcb88815e44b47553b53884123434c42545a682", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:42.545926+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 39, 