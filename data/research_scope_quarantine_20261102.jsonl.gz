{"text_id": "text_ade49e3f560e6af50b4b", "record_id": "article_ade49e3f560e6af5", "canonical_url": "https://news.mongabay.com/2025/05/a-honduran-reef-stumps-conservationists-with-its-unlikely-resilience", "publisher_url": "https://news.mongabay.com/2025/05/a-honduran-reef-stumps-conservationists-with-its-unlikely-resilience", "title_original": "A Honduran reef stumps conservationists with its unlikely resilience", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-02T15:02:51+00:00", "source_text": "TELA BAY, Honduras — Viewed from the boat, the mighty elkhorn corals shimmer through the clear water, their tips grazing the surface and seeming to reach for the hull. But it’s only when one is submerged that the corals display their full size and strength, and all the busy biodiversity swarming around them. Some of […]", "text_kind": "source_excerpt", "text_characters": 321, "text_sha256": "95b31a07c3d80b80b1961c91e150d5883d76db25c7d9a18bac878cfccde02e84", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:24.169725+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 289, "end": 296, "evidence": "rged that the corals display their full size and strength, and all the busy biodiversity swarming around them. Some of […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:24.195715+00:00", "published_at_raw": "2025-05-02T15:02:51", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "HN", "alpha3": "HND", "name_zh": "洪都拉斯", "name_en": "Honduras", "start": 10, "end": 18, "matched_text": "Honduras", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_3d6dff95c88e0150ad30", "record_id": "article_3d6dff95c88e0150", "canonical_url": "https://www.carbonbrief.org/forests-taking-longer-to-recover-from-severe-megafires-since-2010", "publisher_url": "https://www.carbonbrief.org/forests-taking-longer-to-recover-from-severe-megafires-since-2010", "title_original": "Forests taking longer to recover from severe ‘megafires’ since 2010", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-02T12:07:50+00:00", "source_text": "Forests around the world are taking longer to recover from severe wildfires – potentially indicating forest decline, according to a new study. The research, published in Nature Ecology & Evolution , finds a “significant increase” in the severity of forest fires from 2001-10 to 2010-21 – especially in western North America, parts of Siberia and south-eastern Australia. It also finds that recovery from large fires has become “more difficult” for forests in recent years, particularly in the boreal forests of the far-northern latitudes. Furthermore, fewer than one-third of all forests studied recovered successfully within seven years of a “megafire” – a broad term used to refer to extreme fires.", "text_kind": "article_excerpt", "text_characters": 700, "text_sha256": "b567f298632759959a8b7e45b508a7bbaabf33c3624eca35359867eef4e7beeb", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:21.879719+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 66, "end": 74, "evidence": "Forests around the world are taking longer to recover from severe wildfires – potentially indicating forest decline, according to a new study. The research, published in Nature Ecology & Evolution , finds a “signif"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:21.916288+00:00", "published_at_raw": "2025-05-02T12:07:50", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia", "start": 360, "end": 369, "matched_text": "Australia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_c485c8991e148f8e57c6", "record_id": "article_c485c8991e148f8e", "canonical_url": "https://yaleclimateconnections.org/2025/05/how-to-reduce-microplastic-exposure-and-protect-your-health", "publisher_url": "https://yaleclimateconnections.org/2025/05/how-to-reduce-microplastic-exposure-and-protect-your-health", "title_original": "How to reduce microplastic exposure and protect your health", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-02T11:00:00+00:00", "source_text": "Microplastics have been found everywhere on Earth and in every part of the human body where scientists have looked. Even organs that have additional protective barriers – think the blood-brain barrier or the blood-testis barrier – have proved no match for keeping out these tiny particles, which form as larger plastic objects break down or shed into our air, water, and food. Even newborns taking their first breath have already been doused in many plastic-related chemicals. Many of these chemicals are endocrine disruptors, meaning they can mimic or interfere with the body’s hormone signals. It has become impossible to ignore: Tiny fragments of plastic and the chemicals used to make them are everywhere. We also have mounting evidence that they harm our health.", "text_kind": "article_excerpt", "text_characters": 767, "text_sha256": "90111a6232b85ed19409d0143ed535453de5106859c8a8c70bba3c38242bd80c", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:58.236190+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:58.261497+00:00", "published_at_raw": "2025-05-02T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_973dcbbebcfc2ef67992", "record_id": "article_973dcbbebcfc2ef6", "canonical_url": "https://news.mongabay.com/2025/05/colombias-amazon-peoples-provide-solutions-interview-with-jose-homero-mutumbajoy", "publisher_url": "https://news.mongabay.com/2025/05/colombias-amazon-peoples-provide-solutions-interview-with-jose-homero-mutumbajoy", "title_original": "‘Colombia’s Amazon peoples provide solutions’: Interview with José Homero Mutumbajoy", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-01T21:52:51+00:00", "source_text": "This is the second of three interviews with Indigenous representatives at the United Nations about the latest issues in their country’s Amazon forests. Read the interview about the Peruvian Amazon here and Brazilian Amazon here. NEW YORK CITY — Mongabay caught up with José Homero Mutumbajoy, an Indigenous rights defender in Colombia, to get his […]", "text_kind": "source_excerpt", "text_characters": 350, "text_sha256": "9cde7e58f61be112126f7cc63512c495492f57f2ea8ad0d56cf1f95337d39cfe", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:24.254639+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 44, "end": 54, "evidence": "This is the second of three interviews with Indigenous representatives at the United Nations about the latest issues in their country’s Amazon forests. Read the interview about the Peruvian Amaz"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:24.276968+00:00", "published_at_raw": "2025-05-01T21:52:51", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 1, "end": 9, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CO", "alpha3": "COL", "name_zh": "哥伦比亚", "name_en": "Colombia", "start": 326, "end": 334, "matched_text": "Colombia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_819829dfcedd4ec7d5e5", "record_id": "article_819829dfcedd4ec7", "canonical_url": "https://insideclimatenews.org/news/01052025/house-republicans-target-california-vehicle-pollution-rules", "publisher_url": "https://insideclimatenews.org/news/01052025/house-republicans-target-california-vehicle-pollution-rules", "title_original": "Ignoring Federal Law, House GOP Targets California’s Nation-Leading Vehicle Pollution Rules", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-01T21:42:35+00:00", "source_text": "On a warm July morning in 1943, in the middle of World War II, a thick cloud of acrid smoke blanketed downtown Los Angeles, turning its clear blue skies into an inscrutable brown haze that left Angelenos with burning eyes, noses and throats. The aerial assault was so intense it sparked rumors of chemical warfare […]", "text_kind": "source_excerpt", "text_characters": 317, "text_sha256": "008fe752826bbfc783a100d2baf8b81ec0333f1c5b91dc8d373d67df457658b3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:04.108202+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:04.141093+00:00", "published_at_raw": "2025-05-01T21:42:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 40, "end": 50, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_7a9b23e1cfee0d1fdb44", "record_id": "article_7a9b23e1cfee0d1f", "canonical_url": "https://news.mongabay.com/2025/05/landslide-deaths-again-highlight-safety-failures-in-indonesias-nickel-industry", "publisher_url": "https://news.mongabay.com/2025/05/landslide-deaths-again-highlight-safety-failures-in-indonesias-nickel-industry", "title_original": "Landslide deaths again highlight safety failures in Indonesia’s nickel industry", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-01T00:39:25+00:00", "source_text": "JAKARTA — A deadly landslide in an Indonesian industrial park has reignited concerns over poor safety and environmental standards in the country’s booming nickel sector, a key supplier of battery metals for electric vehicles. The incident occurred on March 22 in a storage facility for mining waste, or tailings, in the Indonesia Morowali Industrial Park […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "ac2f5d70a14ae7c49136cc105701160442ca81097d039ac05c9807f794e47fbf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:24.377027+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:24.393431+00:00", "published_at_raw": "2025-05-01T00:39:25", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 52, "end": 61, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 320, "end": 329, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_9917936240e3c9de5bd5", "record_id": "article_9917936240e3c9de", "canonical_url": "https://insideclimatenews.org/news/30042025/trump-second-administration-first-100-days-assault-on-the-environment", "publisher_url": "https://insideclimatenews.org/news/30042025/trump-second-administration-first-100-days-assault-on-the-environment", "title_original": "In His First 100 Days, Trump Launched an ‘All-Out Assault’ on the Environment", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-30T09:00:00+00:00", "source_text": "One hundred days into the second Trump administration, many environmentalists’ worst fears about the new presidency have been realized—and surpassed. Facing a spate of orders, pronouncements and actions that target America’s most cherished natural resources and most vulnerable communities, advocates fear the Trump agenda, unchecked, will set the country back decades. “It is not an […]", "text_kind": "source_excerpt", "text_characters": 387, "text_sha256": "9df532dd5722a242fcaa1195042342a4fdff82cedb7d4b820a4d7d24768050e7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:04.924011+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_veri