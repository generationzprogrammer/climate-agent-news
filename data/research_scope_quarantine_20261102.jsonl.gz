{"text_id": "text_5346229ef67f61699fb3", "record_id": "article_5346229ef67f6169", "canonical_url": "https://news.mongabay.com/2024/03/java-rice-farmers-suffer-crop-failure-as-copper-mine-pollutes-local-irrigation", "publisher_url": "https://news.mongabay.com/2024/03/java-rice-farmers-suffer-crop-failure-as-copper-mine-pollutes-local-irrigation", "title_original": "Java rice farmers suffer crop failure as copper mine pollutes local irrigation", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-11T15:12:07+00:00", "source_text": "PACITAN, Indonesia — Parno looked weary at he stared out over his rice field, occasionally shaking his head as he considered prospects for the coming harvest. “How can I not be angry?” the 69-year-old told Mongabay Indonesia at his field in Cokrokembang village. “It’s been 20 days and the plants are not growing.” Like many […]", "text_kind": "source_excerpt", "text_characters": 328, "text_sha256": "8d364b0760da025d9c2d3f3828b0ade14bb3566751af2476b5ab6db327cd27a1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:03.015412+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:03.027540+00:00", "published_at_raw": "2024-03-11T15:12:07", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 9, "end": 18, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_fbdca1879e73be27574c", "record_id": "article_fbdca1879e73be27", "canonical_url": "https://insideclimatenews.org/news/10032024/belize-tropical-rainforest-deforestation-carbon-offsets", "publisher_url": "https://insideclimatenews.org/news/10032024/belize-tropical-rainforest-deforestation-carbon-offsets", "title_original": "Can Carbon Offsets Save a Fragile Band of Belize’s Tropical Rainforest?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-10T09:10:00+00:00", "source_text": "GALLON JUG, Belize — Deep in a jungle in northern Belize, Elma Kay stood at the base of a rare, ancient mahogany tree, perhaps the only one for miles around. On the trunk above her head were healed gashes where loggers had erected a platform decades ago in an aborted attempt to fell the giant […]", "text_kind": "source_excerpt", "text_characters": 297, "text_sha256": "e0c60fa0f0eb84593c3225bdac71ac5a1ed209c9ac84ca390091f6b85da0c4e4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:19.215420+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BZ", "alpha3": "BLZ", "name_zh": "伯利兹", "name_en": "Belize"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BZ", "alpha3": "BLZ", "name_zh": "伯利兹", "name_en": "Belize"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:19.228685+00:00", "published_at_raw": "2024-03-10T09:10:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BZ", "alpha3": "BLZ", "name_zh": "伯利兹", "name_en": "Belize", "start": 42, "end": 48, "matched_text": "Belize", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BZ", "alpha3": "BLZ", "name_zh": "伯利兹", "name_en": "Belize", "start": 12, "end": 18, "matched_text": "Belize", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_107ae5b4d656231cb045", "record_id": "article_107ae5b4d656231c", "canonical_url": "https://insideclimatenews.org/news/09032024/new-york-city-greenways-along-rivers-railways-parks", "publisher_url": "https://insideclimatenews.org/news/09032024/new-york-city-greenways-along-rivers-railways-parks", "title_original": "New York City Ready to Expand Greenways Along Rivers, Railways and Parks", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-09T10:10:00+00:00", "source_text": "New York City is poised for a year of opportunity with the opening of miles of city-wide greenways, a success for community advocates who are cautious but optimistic about the effort to create fresh or upgraded public paths across the boroughs. Greenways are multi-use paths for walking, biking and electric-assisted transport, often situated along rivers […]", "text_kind": "source_excerpt", "text_characters": 359, "text_sha256": "cc3e9789ccedf07c6998ddd15273bb4e63b467e4e34a4e6fc8dfe0046e846e43", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:19.314636+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:19.333540+00:00", "published_at_raw": "2024-03-09T10:10:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_5c94eeb89173cfac653d", "record_id": "article_5c94eeb89173cfac", "canonical_url": "https://insideclimatenews.org/news/09032024/battle-over-plastic-bag-bans", "publisher_url": "https://insideclimatenews.org/news/09032024/battle-over-plastic-bag-bans", "title_original": "Q&A: The Latest in the Battle Over Plastic Bag Bans", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-09T10:00:00+00:00", "source_text": "From our collaborating partner “Living on Earth,” public radio’s environmental news magazine, an interview by host Paloma Beltran with Judith Enck, former EPA Regional Administrator and president of Beyond Plastics. A decade ago, California became the first U.S. state to ban single-use plastic bags, and eleven states as well as some territories followed suit. But […]", "text_kind": "source_excerpt", "text_characters": 369, "text_sha256": "6febc0a274c8ac8011fcd4454c4cf91db7eb7c384dcd14104e0ad066433887bf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:19.361871+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:19.384366+00:00", "published_at_raw": "2024-03-09T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 230, "end": 240, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_66d31a67bac28782347c", "record_id": "article_66d31a67bac28782", "canonical_url": "https://insideclimatenews.org/news/08032024/texas-coast-new-lake-petrochemical-expansion", "publisher_url": "https://insideclimatenews.org/news/08032024/texas-coast-new-lake-petrochemical-expansion", "title_original": "New Lake Will Fuel Petrochemical Expansion on Texas Coast", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-08T10:00:00+00:00", "source_text": "Texas regulators last month approved water rights for a new, 2,500-acre reservoir to meet the growing needs of chemical plants, refineries and other industries on the Gulf Coast. A draft permit issued Feb. 23 by the Texas Commission on Environmental Quality authorizes the Lavaca-Navidad River Authority (LNRA) to divert up to 31 billion gallons per […]", "text_kind": "source_excerpt", "text_characters": 353, "text_sha256": "ed18ec6276c7013e86c7ae9d0c19ca08588b7344acb4831dc0608aa3bb7db9be", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:24.654567+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "31 billion", "start": 327, "end": 337, "evidence": " 23 by the Texas Commission on Environmental Quality authorizes the Lavaca-Navidad River Authority (LNRA) to divert up to 31 billion gallons per […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "adopted", "label_zh": "通过", "label_en": "Adopted", "start": 28, "end": 36, "evidence": "Texas regulators last month approved water rights for a new, 2,500-acre reservoir to meet the growing needs of chemical plants, refineries and other industries on the Gulf Coas"}], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:24.669259+00:00", "published_at_raw": "2024-03-08T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 46, "end": 51, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 5, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_4e8011cb6480eb7cf000", "record_id": "article_4e8011cb6480eb7c", "canonical_url": "https://news.mongabay.com/2024/03/pollution-poses-big-risks-to-global-clean-water-supplies-study-shows", "publisher_url": "https://news.mongabay.com/2024/03/pollution-poses-big-risks-to-global-clean-water-supplies-study-shows", "title_original": "Pollution poses big risks to global clean water supplies, study shows", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-06T17:23:55+00:00", "source_text": "Nitrogen pollution from agriculture and human waste, along with other pollutants including plastics, could make clean water scarce in many watersheds worldwide, potentially contributing to declines in public health.", "text_kind": "source_excerpt", "text_characters": 215, "text_sha256": "5f4234e3807b9cfa592305cfc5085c7b6372e39ecba165f04f2105fd6a7c7401", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:03.189241+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:03.198023+00:00", "published_at_raw": "2024-03-06T17:23:55", "sample_frame": "public_arc