{"text_id": "text_cdfa40ca56ca9728cc5d", "record_id": "article_cdfa40ca56ca9728", "canonical_url": "https://news.mongabay.com/2026/08/at-global-desertification-conference-pastoralists-call-for-greater-recognition", "publisher_url": "https://news.mongabay.com/2026/08/at-global-desertification-conference-pastoralists-call-for-greater-recognition", "title_original": "At global desertification conference, pastoralists call for greater recognition", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-25T20:36:04+00:00", "source_text": "Cattle are a central part of the identity of Andrew Msami’s Maasai community in northeast Tanzania. Herd size determines social position, and many people keep all their wealth in livestock, not banks. In recent years, however, Msami and others have been forced to sell the animals and buy goats, which can handle drought better but […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "c55906efcdfbe553d0d06356550b5878c30e9d27c74619f2f0cf3b7ebdbb5487", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:10.681961+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 313, "end": 320, "evidence": "er, Msami and others have been forced to sell the animals and buy goats, which can handle drought better but […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:10.711570+00:00", "published_at_raw": "2026-08-25T20:36:04", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania", "start": 90, "end": 98, "matched_text": "Tanzania", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_ff89eaf6b745993b3c85", "record_id": "article_ff89eaf6b745993b", "canonical_url": "https://insideclimatenews.org/news/25082026/texas-data-center-gas-projects", "publisher_url": "https://insideclimatenews.org/news/25082026/texas-data-center-gas-projects", "title_original": "Data Center Developers in Texas Plan Massive New Gas Power Projects", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-25T08:55:00+00:00", "source_text": "The 12 largest gas power projects planned in Texas are all specifically intended to run data centers, according to data released Tuesday by Global Energy Monitor, a global nonprofit that maps and tracks energy infrastructure. The volume of gas power generation planned in Texas has continued to surge, growing by 50 percent in the last […]", "text_kind": "source_excerpt", "text_characters": 339, "text_sha256": "c6e4af8c507dd03b25934479f9c17a1dfc52f2a0a9a0f76474540dcbfb9f9e66", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:14.393011+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "50 percent", "start": 313, "end": 323, "evidence": " The volume of gas power generation planned in Texas has continued to surge, growing by 50 percent in the last […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "labe