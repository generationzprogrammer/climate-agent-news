{"text_id": "text_459986b75f50b2b883b2", "record_id": "article_459986b75f50b2b8", "canonical_url": "https://news.mongabay.com/2024/02/new-environmental-rules-for-chiles-protected-areas-rile-the-salmon-industry", "publisher_url": "https://news.mongabay.com/2024/02/new-environmental-rules-for-chiles-protected-areas-rile-the-salmon-industry", "title_original": "New environmental rules for Chile’s protected areas rile the salmon industry", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-09T10:57:59+00:00", "source_text": "Chile’s salmon-farming industry, a major driver of the economy, has lashed out at new rules restricting its operation in protected areas, but environmental groups say the change is necessary, given the industry’s history of environmental violations. The new rules are laid out in a memorandum issued in October by Chile’s Ministry of the Environment, as […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "74f6a3f03f6f47a91c3781f32d9751dd666561f3aff630a460918aa5d3cee279", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:18.337253+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:18.355164+00:00", "published_at_raw": "2024-02-09T10:57:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile", "start": 28, "end": 33, "matched_text": "Chile", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile", "start": 0, "end": 5, "matched_text": "Chile", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_e65eb860bbe0d20bd194", "record_id": "article_e65eb860bbe0d20b", "canonical_url": "https://yaleclimateconnections.org/2024/02/when-communities-evacuate-residents-lacking-cars-can-be-left-behind", "publisher_url": "https://yaleclimateconnections.org/2024/02/when-communities-evacuate-residents-lacking-cars-can-be-left-behind", "title_original": "When communities evacuate, residents lacking cars can be left behind", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-08T12:00:00+00:00", "source_text": "When a hurricane, wildfire, or other disaster is about to strike, local officials sometimes tell residents to evacuate to safety. But for people who do not have cars, evacuating can be difficult — if not impossible. Perez: “And so oftentimes, those who rely on public transit really face much longer wait times or are literally left behind.” Yesenia Perez is with the Greenlining Institute , which advocates for economic and environmental justice for people of color. In a recent report , her group noted that during Hurricane Katrina, hundreds of thousands of people had no way to evacuate by car. And many struggled to find trains or buses to take them to safety.", "text_kind": "article_excerpt", "text_characters": 665, "text_sha256": "d443a8da9cf3a6fc7b26a125d5cc011a922423605d65c279520f4bdc1ec3ce64", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:33.892097+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 18, "end": 26, "evidence": "When a hurricane, wildfire, or other disaster is about to strike, local officials sometimes tell residents to evacuate to safety. But for people who do not have cars,"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:34.041596+00:00", "published_at_raw": "2024-02-08T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_c4372016665df612e8aa", "record_id": "article_c4372016665df612", "canonical_url": "https://insideclimatenews.org/news/08022024/epa-reports-widespread-noncompliance-with-toxic-coal-ash-regulations", "publisher_url": "https://insideclimatenews.org/news/08022024/epa-reports-widespread-noncompliance-with-toxic-coal-ash-regulations", "title_original": "EPA Reports ‘Widespread Noncompliance’ With the Nation’s First Regulations on Toxic Coal Ash", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-08T10:10:00+00:00", "source_text": "ORLANDO, Fla.—There is “widespread noncompliance” with the nation’s first regulations on coal ash, the toxic waste left after coal is burned for electricity, the Biden administration recently announced. In an enforcement alert issued late last year, the Environmental Protection Agency said the conclusion is based on “numerous facility assessments and inspections to determine compliance with […]", "text_kind": "source_excerpt", "text_characters": 397, "text_sha256": "cb3d9fad0bbdfe62d88354faebc4e3589ffb041774c2802b8ee75154ae869901", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:33.168858+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 89, "end": 93, "evidence": "ORLANDO, Fla.—There is “widespread noncompliance” with the nation’s first regulations on coal ash, the toxic waste left after coal is burned for electricity, the Biden administration recently announced. In an enforcement alert issued"}], "policy_tools": [{"id": "standards", "label_zh": "标准与监管", "label_en": "Standards and regulation", "start": 74, "end": 84, "evidence": "ORLANDO, Fla.—There is “widespread noncompliance” with the nation’s first regulations on coal ash, the toxic waste left after coal is burned for electricity, the Biden administration recently announced. In an enforcement ale"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:33.182833+00:00", "published_at_raw": "2024-02-08T10:10:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_b831a82ffba811b6bf8e", "record_id": "article_b831a82ffba811b6", "canonical_url": "https://insideclimatenews.org/news/07022024/first-year-pennsylvania-governor-josh-shapiro-forged-alliances-with-natural-gas-industry", "publisher_url": "https://insideclimatenews.org/news/07022024/first-year-pennsylvania-governor-josh-shapiro-forged-alliances-with-natural-gas-industry", "title_original": "In His First Year as Governor, Josh Shapiro Forged Alliances With the Natural Gas Industry, Angering Environmentalists Who Once Supported Him", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-07T10:05:00+00:00", "source_text": "In June 2020, then Pennsylvania attorney general Josh Shapiro appeared at a press conference in Harrisburg to announce the findings of a two-year grand jury investigation into the state’s fracking industry. The 235-page report concluded that Pennsylvania’s Department of Environmental Protection and Department of Health had failed to protect residents from the worst effects of […]", "text_kind": "source_excerpt", "text_characters": 382, "text_sha256": "39d50f0e7d81a804afe5be82ccbc9974f50a5318c2e680c79498181f48f7e918", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:33.252383+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:33.264999+00:00", "published_at_raw": "2024-02-07T10:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_45742d09e742c62d6e6e", "record_id": "article_45742d09e742c62d", "canonical_url": "https://yaleclimateconnections.org/2024/02/chiles-wildfire-death-toll-hits-123", "publisher_url": "https://yaleclimateconnections.org/2024/02/chiles-wildfire-death-toll-hits-123", "title_original": "Chile’s wildfire death toll rises above 130", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-06T16:53:10+00:00", "source_text": "[Leer en español] The death toll from the horrific February 2-3 fires near the coastal city of Viña del Mar, Chile, has risen to 123, with over 300 people missing. Over 14,000 buildings were damaged or destroyed with damage in the billions. According to statistics from EM-DAT , the international disaster database, this makes the fires the fifth-deadliest worldwide since 1900. The fires were stoked by near-record warm temperatures that have affected central Chile in recent weeks, with temperatures up to 42.9 degrees Celsius (109°F). The accompanying lack of rainfall has created extreme drought and very dangerous fire conditions. These conditions came on top of the Central Chile megadrought that began in 2010 — the region’s longest drought in at least 1,000 years.", "text_kind": "article_excerpt", "text_characters": 772, "text_sha256": "764309b43c7b3129b2f3a7f72d76cb8b763097b68ebe9bb18b0c319a11ccf786", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:34.341639+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 421, "end": 432, "evidence": "fires the fifth-deadliest worldwide since 1900. The fires were stoked by near-record warm temperatures that have affected central Chile in recent weeks, with temperatures up to 42.9 degrees Celsius (109°F). The accompanying lack of rainfall "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:34.409644+00:00", "published_at_raw": "2024-02-06T16:53:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile", "start": 0, "end": 5, "matched_text": "Chile", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CL", "alpha3": "CHL", "name_zh": "智利", "name_en": "Chile", "start": 109, "end": 114, "matched_text": "Chile", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_84710894b09b8f279dd9", "record_id": "article_84710894b09b8f27", "canonical_url": "https://news.mongabay.com/2024/02/fashioning-a-circular-future-for-traditional-and-alternative-leather", "publisher_url": "https://news.mongabay.com/2024/02/fashioning-a-circular-future-for-traditional-and-alternative-leather", "title_original": "Fashioning a circular future for traditional and alternative leather", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-06T15:34:25+00:00", "source_text": "Historically, the leather industry has created large amounts of pollution and waste, while using huge amounts of water. But some companies are cleaning up their act, even as synthetic and biobased alternatives multiply.", "text_kind": "source_excerpt", "text_characters": 219, "text_sha256": "628c147230ad28ce5510b7077628e3afcdb9028b225b55abe0c3da7405bd9b9b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:18.693011+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:18.704429+00:00", "published_at_raw": "2024-02-06T15:34:25", "sample_frame": "public_