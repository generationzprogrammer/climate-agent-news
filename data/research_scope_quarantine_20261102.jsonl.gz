{"text_id": "text_b91e15fc248317701971", "record_id": "article_b91e15fc24831770", "canonical_url": "https://insideclimatenews.org/news/21122025/ecuador-debt-for-nature-swap-china-conservation", "publisher_url": "https://insideclimatenews.org/news/21122025/ecuador-debt-for-nature-swap-china-conservation", "title_original": "Countries Want Debt Relief for Conservation. Is China Ready to Play a Role?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-21T09:55:00+00:00", "source_text": "Planet China: Thirteenth in a series about how Beijing’s trillion-dollar development plan is reshaping the globe—and the natural world. LIMÓN INDANZA, Ecuador—Long drifts of mist settle between the mountain peaks in this region, almost indistinguishable from clouds. Underneath, species found only here depend on the intricacies of this high-altitude rainforest, one of the most biodiverse […]", "text_kind": "source_excerpt", "text_characters": 393, "text_sha256": "38862ca32e11a7f18db98885d1bc81750115d0243927bc6e73322a6531674a12", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:20.945454+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:20.987725+00:00", "published_at_raw": "2025-12-21T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 48, "end": 53, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 7, "end": 12, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador", "start": 151, "end": 158, "matched_text": "Ecuador", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_d8ba65dd82a29a639078", "record_id": "article_d8ba65dd82a29a63", "canonical_url": "https://insideclimatenews.org/news/21122025/icn-sunday-morning-pennsylvania-fracking-waste", "publisher_url": "https://insideclimatenews.org/news/21122025/icn-sunday-morning-pennsylvania-fracking-waste", "title_original": "A Messy Trail of Toxic Oil and Gas Waste", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-21T09:50:00+00:00", "source_text": "Pennsylvania is ground zero for the fracking boom. It’s increased natural gas production there 37-fold since 2008. That production generates a lot of waste, but the state’s ability to track it has failed to keep up. A decade ago, regulators promised to improve reporting standards for the waste, which can include radioactive material, heavy metals […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "48e9b25c234e07889e62c7c0803c96f00f90368b49064c3af7f76a596fc8f350", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:21.010633+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-1