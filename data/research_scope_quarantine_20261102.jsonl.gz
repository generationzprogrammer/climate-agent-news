{"text_id": "text_40e9e19c3e608b0581cc", "record_id": "article_40e9e19c3e608b05", "canonical_url": "https://insideclimatenews.org/news/08082024/lessons-for-democracy-from-the-amazon-brazil", "publisher_url": "https://insideclimatenews.org/news/08082024/lessons-for-democracy-from-the-amazon-brazil", "title_original": "Lessons for Democracy From the Brazilian Amazon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-08T09:10:00+00:00", "source_text": "There was a time when the most dangerous part of Hugo Loss’ job was the grueling rainforest terrain and armed men blasting riverbeds and razing trees for profit. But Loss, an analyst with Brazil’s elite environmental enforcement agency, learned recently that being effective at his job has made him a target, whether he’s helicoptering into […]", "text_kind": "source_excerpt", "text_characters": 344, "text_sha256": "6c0dc062630870cc5806bae7f59c8679f31e960cd42048842185aaafe125ad73", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:15.715034+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extra