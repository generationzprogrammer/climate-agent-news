{"text_id": "text_276c9151de695371af2c", "record_id": "article_276c9151de695371", "canonical_url": "https://insideclimatenews.org/news/11082024/pennsylvania-senate-race-dave-mccormick-bob-casey", "publisher_url": "https://insideclimatenews.org/news/11082024/pennsylvania-senate-race-dave-mccormick-bob-casey", "title_original": "In Pennsylvania’s Competitive Senate Race, Fracking Takes Center Stage", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-11T09:00:00+00:00", "source_text": "Vice President Kamala Harris has been the official Democratic nominee for president for less than a week, but her presence is already changing the dynamic in critical races down the ballot. On July 26, Pennsylvania’s Republican candidate for U.S. Senate, Dave McCormick, visited a fracking rig in Warren County. One reason for his trip? To […]", "text_kind": "source_excerpt", "text_characters": 343, "text_sha256": "053a85a5d3390af52f31befcbbb5ffb41562521d6ce80e353c51787e6372ab79", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:15.053656+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary