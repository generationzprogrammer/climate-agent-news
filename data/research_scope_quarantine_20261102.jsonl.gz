{"text_id": "text_185f9da2bc9b6a46a22e", "record_id": "article_185f9da2bc9b6a46", "canonical_url": "https://news.mongabay.com/2024/06/borneos-dayak-adapt-indigenous-forestry-to-modern-peat-management", "publisher_url": "https://news.mongabay.com/2024/06/borneos-dayak-adapt-indigenous-forestry-to-modern-peat-management", "title_original": "Borneo’s Dayak adapt Indigenous forestry to modern peat management", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-25T02:31:38+00:00", "source_text": "PULANG PISAU, Indonesia — Bandi paddled through the black swamp, passing alongside banks of high brush outside Kalawa village here in the south of Borneo Island. The narrow canoe, known here as a ces, arrowed through the water, leaving a low ripple in its wake. “Since there’s been community forestry here, we can now protect […]", "text_kind": "source_excerpt", "text_characters": 329, "text_sha256": "bcc471747b112967ab72eb641d88af7c5b473d3b43ef78c20e84b47837b8c16f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:07.146790+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "rev