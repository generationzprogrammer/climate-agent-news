{"text_id": "text_1f2ec918fecf77caf5f9", "record_id": "article_1f2ec918fecf77ca", "canonical_url": "https://news.mongabay.com/2024/01/prevention-is-best-defense-against-bangladesh-crop-diseases-researchers-say", "publisher_url": "https://news.mongabay.com/2024/01/prevention-is-best-defense-against-bangladesh-crop-diseases-researchers-say", "title_original": "Prevention is best defense against Bangladesh crop diseases, researchers say", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-15T13:14:39+00:00", "source_text": "Bangladeshi farmers are struggling with five major crop diseases, likely reducing the crop yield by up to 62% annually. Researchers suggest no effective insecticides for these diseases except for taking precautions and preventive measures. Rice blast disease, rice tungro disease, wheat blast disease, jute stem rot and powdery mildew are the five major types of […]", "text_kind": "source_excerpt", "text_characters": 366, "text_sha256": "286d37d52ee1e5c591e6b274c2861424295b538a944dcd31dedf982e815deea8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:29.245894+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "62%", "start": 106, "end": 109, "evidence": "Bangladeshi farmers are struggling with five major crop diseases, likely reducing the crop yield by up to 62% annually.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:29.258463+00:00", "published_at_raw": "2024-01-15T13:14:39", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh", "start": 35, "end": 45, "matched_text": "Bangladesh", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_9c3011d68ad844a144d0", "record_id": "article_9c3011d68ad844a1", "canonical_url": "https://yaleclimateconnections.org/2024/01/2023-was-earths-hottest-year-on-record", "publisher_url": "https://yaleclimateconnections.org/2024/01/2023-was-earths-hottest-year-on-record", "title_original": "2023 was Earth’s hottest year on record", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-12T18:05:30+00:00", "source_text": "Twenty-nine percent of the global population, 77 countries, and three continents experienced their warmest year on record; 21 nations or territories set an all-time extreme heat record.", "text_kind": "source_excerpt", "text_characters": 185, "text_sha256": "54761a9fbc12c7be2c7a7141a23023d6c7b579bda7b43ebac9caf58e74b265af", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:42.801621+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:42.814256+00:00", "published_at_raw": "2024-01-12T18:05:30", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampli