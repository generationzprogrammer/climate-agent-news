{"text_id": "text_b16b5ef7474147bf5249", "record_id": "article_b16b5ef7474147bf", "canonical_url": "https://news.mongabay.com/2025/09/24-years-on-part-one-of-wto-treaty-curbing-fisheries-subsidies-takes-effect", "publisher_url": "https://news.mongabay.com/2025/09/24-years-on-part-one-of-wto-treaty-curbing-fisheries-subsidies-takes-effect", "title_original": "24 years on, part one of WTO treaty curbing fisheries subsidies takes effect", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-17T18:57:41+00:00", "source_text": "Part one of the World Trade Organization (WTO)’s treaty to ban harmful fisheries subsidies finally came into force Sept. 15. WTO member states adopted the treaty in June 2022 following a grueling 21-year negotiation. The agreement, dubbed “Fish One,” aims to improve ocean sustainability by banning government subsidies that support the fishing of already-overfished stocks […]", "text_kind": "source_excerpt", "text_characters": 377, "text_sha256": "a01186bfd0bf66736105baa678f4bb8b7c909b58ed14f060e0284c2128016671", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:06.851421+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "subsidy", "label_zh": "补贴与激励", "label_en": "Subsidies and incentives", "start": 81, "end": 87, "evidence": "Part one of the World Trade Organization (WTO)’s treaty to ban harmful fisheries subsidies finally came into force Sept. 15. WTO member states adopted the treaty in June 2022 following a grueling 21-year negotiation. The agreem"}], "policy_stages": [{"id": "adopted", "label_zh": "通过", "label_en": "Adopted", "start": 143, "end": 150, "evidence": "ty to ban harmful fisheries subsidies finally came into force Sept. 15. WTO member states adopted the treaty in June 2022 following a grueling 21-year negotiation. The agreement, dubbed “Fish One,” aims to improve ocean sustainability by"}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:06.865222+00:00", "published_at_raw": "2025-09-17T18:57:41", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_c58f00cf4b7c6e925875", "record_id": "article_c58f00cf4b7c6e92", "canonical_url": "https://dialogue.earth/en/climate/pakistans-floods-leave-lasting-scars-on-its-children", "publisher_url": "https://dialogue.earth/en/climate/pakistans-floods-leave-lasting-scars-on-its-children", "title_original": "Pakistan’s floods leave lasting scars on its children", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-17T16:54:34+00:00", "source_text": "Azan “has seen everything. He knows his parents are gone. He just doesn’t yet understand how to live without them.” Shams ur Rehman is talking about his nine-year-old nephew Muhammad Azan, who has been staying with him and his family in Buner, a district in north-western Pakistan’s Khyber Pakhtunkhwa province. Azan’s parents, as well as his three brothers, were killed when flash floods tore through the valley in the middle of August. Also in Buner, 17-year-old Qadir Ahmed has to carry another burden. On 15 August, his family house collapsed in the floods. “The water carried away my mother… now, I must look after my [four] younger brothers and sisters.” Not long ago, Ahmed passed his matriculation exams and aspired to go to college.", "text_kind": "article_excerpt", "text_characters": 741, "text_sha256": "4421c148f016d33361fd97accb248ec542f9b571b233f9ca54f6c1f7590eee06", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:12.500896+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 382, "end": 387, "evidence": "khtunkhwa province. Azan’s parents, as well as his three brothers, were killed when flash floods tore through the valley in the middle of August. Also in Buner, 17-year-old Qadir Ahmed has to carry another burden. On 15 August, his fam"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:12.536699+00:00", "published_at_raw": "2025-09-17T16:54:34", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan", "start": 0, "end": 8, "matched_text": "Pakistan", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "PK", "alpha3": "PAK", "name_zh": "巴基斯坦伊斯兰共和国", "name_en": "Pakistan", "start": 272, "end": 280, "matched_text": "Pakistan", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
