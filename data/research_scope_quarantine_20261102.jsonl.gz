{"text_id": "text_e350a4571ecf52c5a002", "record_id": "article_e350a4571ecf52c5", "canonical_url": "https://insideclimatenews.org/news/13052024/alabama-coal-company-delinquent-safety-violations", "publisher_url": "https://insideclimatenews.org/news/13052024/alabama-coal-company-delinquent-safety-violations", "title_original": "Alabama Coal Company Sued for a Home Explosion That Killed a Man Is Delinquent on Dozens of Penalties, Records Show", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-13T22:53:05+00:00", "source_text": "OAK GROVE, Ala.—Clara Riley thought she was having a heart attack. As an Alabama mine has slowly approached the coal seam under her home, Riley’s anxiety has sometimes gotten the best of her. In late April, after a mine representative visited her home, the 90-year-old said she broke down. She could feel the weight of […]", "text_kind": "source_excerpt", "text_characters": 322, "text_sha256": "69cf31cb2fc41ab8110930193a9b28c553e9df447a78f5d368a9c02c5fa232d1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:50.387429+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 112, "end": 116, "evidence": "Riley thought she was having a heart attack. As an Alabama mine has slowly approached the coal seam under her home, Riley’s anxiety has sometimes gotten the best of her. In late April, after a mine representative visited her home, the"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:50.420016+00:00", "published_at_raw": "2024-05-13T22:53:05", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_a8489cb8ce7f02f9033b", "record_id": "article_a8489cb8ce7f02f9", "canonical_url": "https://www.carbonbrief.org/eu-spending-up-to-e48bn-on-nature-harming-activities-each-year-report-says", "publisher_url": "https://www.carbonbrief.org/eu-spending-up-to-e48bn-on-nature-harming-activities-each-year-report-says", "title_original": "EU spending up to €48bn on nature-harming activities each year, report says", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-13T22:00:00+00:00", "source_text": "The EU could be investing tens of billions of euros each year into activities that damage biodiversity, according to a new report from WWF . With biodiversity declining at an unprecedented rate around the world, the EU intends to put nature on a “ path to recovery ” by 2030, in line with global goals. Finance is a key part of this and the bloc has pledged to raise at least €20bn in nature funding each year by the end of the decade. However, a new report estimates that EU countries could be spending between €34-48bn each year on projects that can end up damaging biodiversity in sectors such as agriculture, forestry and fisheries.", "text_kind": "article_excerpt", "text_characters": 636, "text_sha256": "74bd3cd2b1cd418fbb660d24a7131a16937c102e59ddb11e50cd308f76c266c9", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:08.023551+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 392, "end": 399, "evidence": " Finance is a key part of this and the bloc has pledged to raise at least €20bn in nature funding each year by the end of the decade. However, a new report estimates that EU countries could be spending between €34-48bn each year on proje"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:08.076429+00:00", "published_at_raw": "2024-05-13T22:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_d3a830ce963b29402ef2", "record_id": "article_d3a830ce963b2940", "canonical_url": "https://insideclimatenews.org/news/12052024/alabama-restrictive-deed-covenants-flooding-claims", "publisher_url": "https://insideclimatenews.org/news/12052024/alabama-restrictive-deed-covenants-flooding-claims", "title_original": "How Alabama Turned to Restrictive Deed Covenants to Ward Off Flooding Claims From Black Residents", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-12T09:00:00+00:00", "source_text": "SHILOH COMMUNITY, Ala.—Their land is bound forever. The deeds of three homeowners—Pastor Timothy Williams, Aretha Wright and Page Jones—all living in the historically Black Shiloh community of south Alabama, tell the tale. Restrictive covenants attached to their deeds limit the ability of current and future residents to file actions against the state. The legal instruments […]", "text_kind": "source_excerpt", "text_characters": 379, "text_sha256": "300dd8096c50153bee2c6a8649932eff5ea3a4d9b80192bdeb6579ac6ff6d6a7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:50.798758+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:50.828136+00:00", "published_at_raw": "2024-05-12T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_9066721dafd5a3305a6c", "record_id": "article_9066721dafd5a330", "canonical_url": "https://insideclimatenews.org/news/10052024/puerto-rico-rooftop-solar", "publisher_url": "https://insideclimatenews.org/news/10052024/puerto-rico-rooftop-solar", "title_original": "A Puerto Rico Community Pushes for Rooftop Solar as Fossil-Fuel Plants Face Retirement", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-10T09:00:00+00:00", "source_text": "GUAYAMA, PUERTO RICO — The coastal communities of Guayama and Salinas in southern Puerto Rico feature acres of vibrant green farmland, and a rich, biodiverse estuary, the protected Jobos Bay, which stretches between the neighboring townships. But this would-be tropical paradise is also the home of both a 52-year-old oil-fired power plant and a 22-year-old […]", "text_kind": "source_excerpt", "text_characters": 361, "text_sha256": "d6aa32d4589bf9f1e7cd0eefc5551b48eac11817e036ef504286d06e6e3503a4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:51.157955+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PR", "alpha3": "PRI", "name_zh": "波多黎各", "name_en": "Puerto Rico"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PR", "alpha3": "PRI", "name_zh": "波多黎各", "name_en": "Puerto Rico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:51.192455+00:00", "published_at_raw": "2024-05-10T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PR", "alpha3": "PRI", "name_zh": "波多黎各", "name_en": "Puerto Rico", "start": 2, "end": 13, "matched_text": "Puerto Rico", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "PR", "alpha3": "PRI", "name_zh": "波多黎各", "name_en": "Puerto Rico", "start": 9, "end": 20, "matched_text": "PUERTO RICO", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_7af44838374ce72dc949", "record_id": "article_7af44838374ce72d", "canonical_url": "https://insideclimatenews.org/news/08052024/sunzia-transmission-line-legal-challenges-continue", "publisher_url": "https://insideclimatenews.org/news/08052024/sunzia-transmission-line-legal-challenges-continue", "title_original": "Legal Challenges Continue for SunZia Transmission Line", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-08T09:05:00+00:00", "source_text": "This story is co-published with Arizona Luminaria, a nonprofit newsroom dedicated to community-centered reporting. When Peter Else left the University of Arizona in 2005 to live in the San Pedro Valley full time, he planned to spend his retirement farming in one of the most ecologically intact landscapes left in southern Arizona, where the nearby river […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "0412e40762f3573e87884787754a492d9e4309d54d1990d445aa60f1d35684b8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:56.891995+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "ar