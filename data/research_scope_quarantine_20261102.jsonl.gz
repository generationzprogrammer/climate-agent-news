{"text_id": "text_499378b1b89d6d11acbe", "record_id": "article_499378b1b89d6d11", "canonical_url": "https://insideclimatenews.org/news/31102024/threats-to-the-west-if-trump-dismantles-noaa", "publisher_url": "https://insideclimatenews.org/news/31102024/threats-to-the-west-if-trump-dismantles-noaa", "title_original": "Hindered Wildfire Responses, Costlier Agriculture Likely If Trump Dismantles NOAA, Experts Warn", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-31T09:05:00+00:00", "source_text": "As the Popo Agie river wends its way down from the glaciers atop Wyoming’s Wind River Mountains toward the city of Lander, it flows into a limestone cave and disappears. The formation, known as the Sinks, spits the river back out at another feature called the Rise a quarter of a mile east, a little […]", "text_kind": "source_excerpt", "text_characters": 303, "text_sha256": "d0df24f2493cfdc6e70c2cea48ab754f757408d012ba203c7d4a379686bc8e68", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:39.681889+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026