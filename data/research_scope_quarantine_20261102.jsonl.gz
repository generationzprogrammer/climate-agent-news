{"text_id": "text_0eac2b218bb54a496a24", "record_id": "article_0eac2b218bb54a49", "canonical_url": "https://insideclimatenews.org/news/26042024/encina-pennsylvania-chemical-recycling-plant-canceled", "publisher_url": "https://insideclimatenews.org/news/26042024/encina-pennsylvania-chemical-recycling-plant-canceled", "title_original": "A Giant Plastics Chemical Recycling Plant Planned for Pennsylvania Died After Two Years. What Happened?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-26T09:05:00+00:00", "source_text": "A Houston-based company’s first effort to turn plastic waste into the chemical feedstocks for new plastic products has crumbled amid unanswered questions about its technology, trouble securing the necessary permits and rising community opposition. Encina Development Group announced last week that it was pulling the plug on its proposed Point Township Circular Manufacturing Facility, two […]", "text_kind": "source_excerpt", "text_characters": 393, "text_sha256": "19fda2aaff5c424e7bf280e222590954669319cb5fcb90c12b3eb262f47b6ff3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:58.340789+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "proposed", "label_zh": "提出", "label_en": "Proposed", "start": 329, "end": 337, "evidence": "osition. Encina Development Group announced last week that it was pulling the plug on its proposed Point Township Circular Manufacturing Facility, two […]"}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:58.360247+00:00", "published_at_raw": "2024-04-26T09:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_603bfa30692a73fedbb2", "record_id": "article_603bfa30692a73fe", "canonical_url": "https://news.mongabay.com/2024/04/eu-law-to-reduce-deforestation-is-on-a-knifes-edge-will-leaders-act-commentary", "publisher_url": "https://news.mongabay.com/2024/04/eu-law-to-reduce-deforestation-is-on-a-knifes-edge-will-leaders-act-commentary", "title_original": "EU law to reduce deforestation is on a knife’s edge, will leaders act? (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-25T14:41:41+00:00", "source_text": "We are now in a make-or break-moment for the landmark law to halt imported global deforestation into the European Union. Global forest defenders watch with bated breath as in the next few days, the President of the European Commission Ursula von der Leyen will either decide to support the EU Deforestation Regulation (EUDR), or to […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "192dcdd351fc4d966053ffac1c466fb3aafc0cc76fd7e75893815ae873ddfd5d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:40.766556+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "standards", "label_zh": "标准与监管", "label_en": "Standards and regulation", "start": 307, "end": 317, "evidence": "ropean Commission Ursula von der Leyen will either decide to support the EU Deforestation Regulation (EUDR), or to […]"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:40.804774+00:00", "published_at_raw": "2024-04-25T14:41:41", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_12ad96bd45136c05bbe7", "record_id": "article_12ad96bd45136c05", "canonical_url": "https://insideclimatenews.org/news/25042024/inside-clean-energy-tesla-exxonmobil-market-value", "publisher_url": "https://insideclimatenews.org/news/25042024/inside-clean-energy-tesla-exxonmobil-market-value", "title_original": "Tesla Fell Behind, Then Leapt Ahead of ExxonMobil in Market Value This Week", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-25T13:00:00+00:00", "source_text": "One of the sideshows in a wild week for Tesla is how its market capitalization tumbled behind and then jumped back ahead of ExxonMobil. The fact that this is even a topic of conversation is a testament to how much Tesla has fallen, with sluggish sales and a vehicle lineup that is overdue for an […]", "text_kind": "source_excerpt", "text_characters": 299, "text_sha256": "cda248634de410fa334ea829eaf6ad73c97b5d19bd23dbd8968b0c3765014fc9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:58.483225+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:58.494607+00:00", "published_at_raw": "2024-04-25T13:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_7dcaa931b1c656f0628c", "record_id": "article_7dcaa931b1c656f0", "canonical_url": "https://news.mongabay.com/2024/04/global-study-maps-most-detailed-tree-of-life-yet-for-flowering-plants", "publisher_url": "https://news.mongabay.com/2024/04/global-study-maps-most-detailed-tree-of-life-yet-for-flowering-plants", "title_original": "Global study maps most detailed tree of life yet for flowering plants", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-24T15:34:12+00:00", "source_text": "After the first flower bloomed on the Earth, flowering plants evolved a staggering diversity and now make up about 90% of all plant life. Charles Darwin called this rapid domination an “abominable mystery.” A study published today, April 24, in the journal Nature and led by the Royal Botanic Gardens, Kew, unveiled the most comprehensive […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "a3ec8f246b4f57de504aa4b0fef7f1df029ccead1128fdc2d00fef0cdc2ad697", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:41.042122+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "90%", "start": 115, "end": 118, "evidence": "After the first flower bloomed on the Earth, flowering plants evolved a staggering diversity and now make up about 90% of all plant life.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:41.082071+00:00", "published_at_raw": "2024-04-24T15:34:12", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_3bcca1a3ca5453769771", "record_id": "article_3bcca1a3ca545376", "canonical_url": "https://www.carbonbrief.org/alaska-refuge-drilling-could-threaten-polar-bears-with-lethal-oil-spills", "publisher_url": "https://www.carbonbrief.org/alaska-refuge-drilling-could-threaten-polar-bears-with-lethal-oil-spills", "title_original": "Alaska refuge drilling could threaten polar bears with ‘lethal’ oil spills", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-24T09:44:12+00:00", "source_text": "Fossil-fuel drilling in Alaska’s Arctic National Wildlife Refuge (ANWR) could put polar bears at risk of “lethal” oil spills, new research suggests. Former president Donald Trump passed a law to enable drilling in the refuge in 2017. This followed decades of fierce debate between Democrats and Republicans about whether to allow extractive activities in the 7.7m-hectare (19m-acre) expanse, a haven for wildlife sitting on top of an estimated 11bn barrels of oil. On his first day in office, US president Joe Biden suspended drilling inside the ANWR pending a review. In 2023, his administration cancelled the seven oil and gas licences issued for the reserve under Trump.", "text_kind": "article_excerpt", "text_characters": 673, "text_sha256": "d509e1c64e500192bfd25064cc9d7a606f3cf2b7fda1b5b730782bf851947ab0", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:16.998847+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:17.029880+00:00", "published_at_raw": "2024-04-24T09:44:12", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 493, "end": 495, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_a7a1ab3d81ebe2a98ea9", "record_id": "article_a7a1ab3d81ebe2a9", "canonical_url": "https://news.mongabay.com/2024/04/warming-seas-push-indias-fishers-into-distant-and-more-dangerous-waters", "publisher_url": "https://news.mongabay.com/2024/04/warming-seas-push-indias-fishers-into-distant-and-more-dangerous-waters", "title_original": "Warming seas push India’s fishers into distant, and more dangerous, waters", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-23T16:55:34+00:00", "source_text": "KANNIYAKUMARI, India — Anthoni Dhasan, 47, sits on the deck of his fishing boat at the harbor of Thengapattanam in Tamil Nadu, India’s southernmost state, peering out at the stormy Indian Ocean. It’s been a year since his last fishing expedition — the one that almost took his life. On Feb. 19, 2023, Dhasan and […]", "text_kind": "source_excerpt", "text_characters": 315, "text_sha256": "04275c9854492479c258ff6c55110a51677b8fa9568c5b45257a023d586ab42d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:41.269154+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:41.300191+00:00", "published_at_raw": "2024-04-23T16:55:34", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 18, "end": 23, "matched_text": "India", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 15, "end": 20, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_a0a3bd529f5d515219d6", "record_id": "article_a0a3bd529f5d5152", "canonical_url": "https://insideclimatenews.org/news/23042024/inflation-reduction-act-solar-for-all", "publisher_url": "https://insideclimatenews.org/news/23042024/inflation-reduction-act-solar-for-all", "title_original": "IRA’s Solar for All Program Will Install Nearly 1 Million Systems in US", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-23T16:07:28+00:00", "source_text": "For people who have spent their careers trying to expand access to rooftop solar energy, the announcement on Monday of $7 billion worth of project support from the Biden administration is almost unfathomable in its size and scope. Money from the Solar for All program, which is part of the Inflation Reduction Act, will go […]", "text_kind": "source_excerpt", "text_characters": 326, "text_sha256": "515676e2d0ab6b3a319a0f7dbcd4a5cbd40036305a0c187a4578198dfa667c45", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:03.548832+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$7 billion", "start": 119, "end": 129, "evidence": "For people who have spent their careers trying to expand access to rooftop solar energy, the announcement on Monday of $7 billion worth of project support from the Biden administration is almost unfathomable in its size and scope.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 75, "end": 80, "evidence": "For people who have spent their careers trying to expand access to rooftop solar energy, the announcement on Monday of $7 billion worth of project support from the Biden administration is almost unfathomable in its size "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:03.560215+00:00", "published_at_raw": "2024-04-23T16:07:28", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 69, "end": 71, "matched_text": "US", "method": "country-acronym-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_89838192cd0bebe6003b", "record_id": "article_89838192cd0bebe6", "canonical_url": "https://dialogue.earth/en/forests/ethiopias-tree-planting-scheme-needs-better-coordination", "publisher_url": "https://dialogue.earth/en/forests/ethiopias-tree-planting-scheme-needs-better-coordination", "title_original": "Ethiopia’s tree-planting scheme needs better coordination", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-23T13:10:00+00:00", "source_text": "Over 85% of Ethiopia’s land is considered moderately to very severely degraded, according to a 2007 estimate by the UN convention on desertification. This is a particularly acute problem in a country where 85% of people rely on agriculture and pastoralism for their livelihoods. To halt and reverse the degradation, various measures have been taken including the Green Legacy initiative. Launched in 2019, by the end of 2022 the government said the initiative had mobilised Ethiopians to plant 25 billion seedlings. There were plans to restore an “additional 22 million hectares of degraded land by 2030,” it said, equivalent to one-fifth of the country’s land area. A worker prepares an evergreen sapling in a nursery in Bishoftu ahead of tree-planting season.", "text_kind": "article_excerpt", "text_characters": 761, "text_sha256": "65a37f9d8905cfaff3ba1e7ad84d8877d5a064b4caac1877be1d03bfbd9566a6", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:27.392424+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "85%", "start": 5, "end": 8, "evidence": "Over 85% of Ethiopia’s land is considered moderately to very severely degraded, according to a 2007 estimate by the UN convention on desertification.", "interpretation": "not_classified"}, {"value_text": "85%", "start": 206, "end": 209, "evidence": " This is a particularly acute problem in a country where 85% of people rely on agriculture and pastoralism for their livelihoods.", "interpretation": "not_classified"}, {"value_text": "25 billion", "start": 494, "end": 504, "evidence": " Launched in 2019, by the end of 2022 the government said the initiative had mobilised Ethiopians to plant 25 billion seedlings.", "interpretation": "not_classified"}, {"value_text": "22 million", "start": 559, "end": 569, "evidence": " There were plans to restore an “additional 22 million hectares of degraded land by 2030,” it said, equivalent to one-fifth of the country’s land area.", "interpretation": "target_or_commitment"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:27.484463+00:00", "published_at_raw": "2024-04-23T13:10:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia", "start": 0, "end": 8, "matched_text": "Ethiopia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia", "start": 12, "end": 20, "matched_text": "Ethiopia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_73d7911c99d56fd64bee", "record_id": "article_73d7911c99d56fd6", "canonical_url": "https://yaleclimateconnections.org/2024/04/44-of-latinos-live-in-u-s-counties-with-a-high-flood-risk", "publisher_url": "https://yaleclimateconnections.org/2024/04/44-of-latinos-live-in-u-s-counties-with-a-high-flood-risk", "title_original": "44% of Latinos live in U.S. counties with a high flood risk", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-23T11:00:00+00:00", "source_text": "In recent years, many U.S. residents have endured devastating floods. But a new report from the nonprofits Headwaters Economics and Hispanic Access Foundation warns that Latino communities in the states are especially at risk. The authors found that 44% of Latinos live in counties with a high flood risk, compared to just 35% of non-Latinos. What’s more, Latino residents often face other challenges like language barriers and high housing costs, which can make floods even more harmful. Hernandez: “A third of Latinos live in flood-prone communities with unaffordable housing. And that can obviously create a lot of stress when floods occur and destroy some of the only affordable housing in a community.” Patty Hernandez is with Headwaters Economics.", "text_kind": "article_excerpt", "text_characters": 753, "text_sha256": "d98cde359bd6fd8699ca7d1affa47b503496ec17d466c80fd6050af94efbedba", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:06.873368+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "44%", "start": 250, "end": 253, "evidence": " The authors found that 44% of Latinos live in counties with a high flood risk, compared to just 35% of non-Latinos.", "interpretation": "not_classified"}, {"value_text": "35%", "start": 323, "end": 326, "evidence": " The authors found that 44% of Latinos live in counties with a high flood risk, compared to just 35% of non-Latinos.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 62, "end": 67, "evidence": "In recent years, many U.S. residents have endured devastating floods. But a new report from the nonprofits Headwaters Economics and Hispanic Access Foundation warns that Latino communities in the states are "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:06.897302+00:00", "published_at_raw": "2024-04-23T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 23, "end": 27, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 22, "end": 26, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_6f59467c8b019181862c", "record_id": "article_6f59467c8b019181", "canonical_url": "https://news.mongabay.com/2024/04/un-puts-spotlight-on-attacks-against-indigenous-land-defenders", "publisher_url": "https://news.mongabay.com/2024/04/un-puts-spotlight-on-attacks-against-indigenous-land-defenders", "title_original": "UN puts spotlight on attacks against Indigenous land defenders", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-18T22:29:20+00:00", "source_text": "When around 70,000 Indigenous Maasai were expelled from their lands in northern Tanzania in 2022, it didn’t happen in a vacuum. For years, the Tanzanian government has systematically attacked Maasai communities, imprisoning Maasai leaders and land defenders on trumped-up charges, confiscating livestock, using lethal violence, and claiming that the Maasai’s pastoralist lifestyle is causing environmental […]", "text_kind": "source_excerpt", "text_characters": 409, "text_sha256": "48774647ea2cc7a02bedd9263382e6ee3566646fe59cec521e25d4f8e6f671d6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:46.438035+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 19, "end": 29, "evidence": "When around 70,000 Indigenous Maasai were expelled from their lands in northern Tanzania in 2022, it didn’t happen in a vacuum. For years, the Tanzanian government has s"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:46.457157+00:00", "published_at_raw": "2024-04-18T22:29:20", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "TZ", "alpha3": "TZA", "name_zh": "坦桑尼亚", "name_en": "Tanzania", "start": 80, "end": 88, "matched_text": "Tanzania", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_d5ff06577806cfe9f8f1", "record_id": "article_d5ff06577806cfe9", "canonical_url": "https://yaleclimateconnections.org/2024/04/india-makes-a-big-bet-on-electric-buses", "publisher_url": "https://yaleclimateconnections.org/2024/04/india-makes-a-big-bet-on-electric-buses", "title_original": "India makes a big bet on electric buses", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-18T11:00:00+00:00", "source_text": "Public transportation riders in Pune, India, love the city’s new electric buses so much they will actually skip an older diesel bus that arrives earlier to wait for a smoother, cooler ride in a new model. This has fed a new problem: overcrowding. Fortunately, more new buses are on the way. Last fall, India’s Ministry of Housing and Urban Affairs launched a $7 billion initiative to support 10,000 new electric buses in 169 Indian cities. The PM-eBus Sewa program prioritizes small to medium-sized cities of up to 4 million people, particularly those now lacking organized bus service. India hopes this will make public transport — not private vehicles — integral to sustainable urban growth and city culture in the country that last year overtook China to become the world’s most populous nation.", "text_kind": "article_excerpt", "text_characters": 798, "text_sha256": "055aa3e222ad7601f745f365d2112186e1a10ff150578102de74558b966af7be", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:07.064318+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$7 billion", "start": 359, "end": 369, "evidence": " Last fall, India’s Ministry of Housing and Urban Affairs launched a $7 billion initiative to support 10,000 new electric buses in 169 Indian cities.", "interpretation": "not_classified"}, {"value_text": "4 million", "start": 515, "end": 524, "evidence": " The PM-eBus Sewa program prioritizes small to medium-sized cities of up to 4 million people, particularly those now lacking organized bus service.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:07.088040+00:00", "published_at_raw": "2024-04-18T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 0, "end": 5, "matched_text": "India", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 38, "end": 43, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 749, "end": 754, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_6f8cc21b77fdd1bb4b7b", "record_id": "article_6f8cc21b77fdd1bb", "canonical_url": "https://yaleclimateconnections.org/2024/04/your-chance-to-quiz-meteorologists-jeff-masters-and-bob-henson", "publisher_url": "https://yaleclimateconnections.org/2024/04/your-chance-to-quiz-meteorologists-jeff-masters-and-bob-henson", "title_original": "Your chance to quiz meteorologists Jeff Masters and Bob Henson", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-17T19:49:33+00:00", "source_text": "Jeff Masters and Bob Henson will soon face off in what promises to be the extreme weather trivia showdown of the year. The two meteorologists have agreed to compete in a contest — hosted by meteorologist Alexandra Steele — in which they’ll answer extreme weather trivia questions, including those suggested by Eye on the Storm readers. A third, mystery contestant will also compete for the crown. In accepting the invitation to compete, Masters wrote: “Bob and I would be formidable opponents; while I probably have the edge in hurricane-related trivia, he’s got me on tornadoes.” We’ll showcase the trivia contest — and reveal the ultimate champion of extreme weather facts — on our YouTube channel on June 7. Here’s where you come in. What are your suggestions for trivia questions we should ask?", "text_kind": "article_excerpt", "text_characters": 798, "text_sha256": "7f739d3b5702cef1ee9a93606680822b5e610de7bf974f2e67c9f5620d4e294f", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:07.117235+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 214, "end": 219, "evidence": "wo meteorologists have agreed to compete in a contest — hosted by meteorologist Alexandra Steele — in which they’ll answer extreme weather trivia questions, including those suggested by Eye on the Storm readers. A third, mystery contes"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:07.139877+00:00", "published_at_raw": "2024-04-17T19:49:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_790d8dba8bb4131e2ae9", "record_id": "article_790d8dba8bb4131e", "canonical_url": "https://news.mongabay.com/2024/04/panama-delays-promised-relocation-of-sinking-island-community", "publisher_url": "https://news.mongabay.com/2024/04/panama-delays-promised-relocation-of-sinking-island-community", "title_original": "Panama delays promised relocation of sinking island community", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-17T15:50:36+00:00", "source_text": "Plans to relocate an Indigenous community from a tiny Caribbean island off Panama to the country’s mainland to escape rising seas have been delayed due to administrative issues, previous COVID-19-related complications, and poor budgeting. Residents say the government has failed to integrate traditional and local knowledge in the relocation and site development plans. President Laurentino […]", "text_kind": "source_excerpt", "text_characters": 394, "text_sha256": "531e260a21bb0dd062ad8eb0bed02c861b358531d370f160e6cb6fe7deccf8e3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:46.614013+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PA", "alpha3": "PAN", "name_zh": "巴拿马", "name_en": "Panama"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 21, "end": 31, "evidence": "Plans to relocate an Indigenous community from a tiny Caribbean island off Panama to the country’s mainland to escape rising seas have been delayed due to administrative i"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PA", "alpha3": "PAN", "name_zh": "巴拿马", "name_en": "Panama"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:46.629538+00:00", "published_at_raw": "2024-04-17T15:50:36", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PA", "alpha3": "PAN", "name_zh": "巴拿马", "name_en": "Panama", "start": 0, "end": 6, "matched_text": "Panama", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "PA", "alpha3": "PAN", "name_zh": "巴拿马", "name_en": "Panama", "start": 75, "end": 81, "matched_text": "Panama", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_b9b3305426062ef89580", "record_id": "article_b9b3305426062ef8", "canonical_url": "https://news.mongabay.com/2024/04/indigenous-efforts-to-save-perus-maranon-river-could-spell-trouble-for-big-oil", "publisher_url": "https://news.mongabay.com/2024/04/indigenous-efforts-to-save-perus-maranon-river-could-spell-trouble-for-big-oil", "title_original": "Indigenous efforts to save Peru’s Marañon River could spell trouble for big oil", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-17T13:06:04+00:00", "source_text": "Living deep in the Peruvian Amazon, the Kukama Kukamiria Indigenous community have spent generations with their feet in the Marañón, the river emerging from the Andes that provides the main source of water for the Amazon River. They depend on the river to drink, bathe, fish and plant crops. They also believe family members who […]", "text_kind": "source_excerpt", "text_characters": 332, "text_sha256": "b040bb000855eafdbbdb8d6a0f9c65325945dcb09bd9e646bdbe1c8ef60ff25e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:46.683930+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 57, "end": 67, "evidence": "Living deep in the Peruvian Amazon, the Kukama Kukamiria Indigenous community have spent generations with their feet in the Marañón, the river emerging from the Andes that provides the main source of water f"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:46.700681+00:00", "published_at_raw": "2024-04-17T13:06:04", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru", "start": 27, "end": 31, "matched_text": "Peru", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_171ed781c6149b6782f0", "record_id": "article_171ed781c6149b67", "canonical_url": "https://news.mongabay.com/2024/04/caribbean-startups-are-turning-excess-seaweed-into-an-agroecology-solution", "publisher_url": "https://news.mongabay.com/2024/04/caribbean-startups-are-turning-excess-seaweed-into-an-agroecology-solution", "title_original": "Caribbean startups are turning excess seaweed into an agroecology solution", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-16T15:22:15+00:00", "source_text": "In 2015, smelly mats of a brown macroalgae called sargassum piled as high as 1.2 meter (4 feet) on the beaches of Barbados, recalls Joshua Forte. It was the fourth year in what has become an annual nightmare, with an estimated 18,100 kilograms (20 tons) of seaweed inundating Caribbean shorelines each year and wrecking the […]", "text_kind": "source_excerpt", "text_characters": 327, "text_sha256": "30321c9a9ca7d4a3168c82b90f29a0f2910560f936a95257db920ed5c1448ea3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:46.768165+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BB", "alpha3": "BRB", "name_zh": "巴巴多斯", "name_en": "Barbados"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BB", "alpha3": "BRB", "name_zh": "巴巴多斯", "name_en": "Barbados"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:46.782058+00:00", "published_at_raw": "2024-04-16T15:22:15", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BB", "alpha3": "BRB", "name_zh": "巴巴多斯", "name_en": "Barbados", "start": 114, "end": 122, "matched_text": "Barbados", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_4cb5d00e6cc673b1ea48", "record_id": "article_4cb5d00e6cc673b1", "canonical_url": "https://insideclimatenews.org/news/16042024/canada-plastic-treaty-arctic-indigenous-peoples", "publisher_url": "https://insideclimatenews.org/news/16042024/canada-plastic-treaty-arctic-indigenous-peoples", "title_original": "As Plastic Treaty Delegates Head to Canada, A Plea From the Arctic: Don’t Forget Vulnerable Indigenous Peoples", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-16T12:00:00+00:00", "source_text": "Indigenous people from Arctic communities are calling for environmental protection in the runup to this month’s round of negotiations aimed at securing a global treaty to end plastic pollution. U.N. talks resume April 23 in Ottawa and are expected to draw delegates from nearly 180 countries to Canada who seek to advance a plastics treaty […]", "text_kind": "source_excerpt", "text_characters": 343, "text_sha256": "0ed6237baac9e3fbd41ae2bb7993f25b3afa55fca98eed51d12c3bbaa35af88f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:04.192731+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 0, "end": 10, "evidence": "Indigenous people from Arctic communities are calling for environmental protection in the runup to this month’s round of negotiations aimed at securin"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:04.217256+00:00", "published_at_raw": "2024-04-16T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada", "start": 36, "end": 42, "matched_text": "Canada", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada", "start": 295, "end": 301, "matched_text": "Canada", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_69e642cddc04bf7efe0f", "record_id": "article_69e642cddc04bf7e", "canonical_url": "https://yaleclimateconnections.org/2024/04/schools-in-coal-country-are-going-solar", "publisher_url": "https://yaleclimateconnections.org/2024/04/schools-in-coal-country-are-going-solar", "title_original": "Schools in coal country are going solar", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-16T11:00:00+00:00", "source_text": "Deep in the heart of coal country, schools in Wayne County, West Virginia, are going solar. Conant: “The schools, they don’t have to pay for the equipment. They don’t have to pay for the panels, the labor. Instead, Solar Holler pays for all of that up front.” Dan Conant is the founder and CEO of Solar Holler . The West Virginia-based solar developer has partnered with Wayne County Public Schools on what’s known as a power purchase agreement. Solar Holler will pay to install thousands of solar panels on school district buildings. And the district has agreed to buy the electricity produced by those panels for 25 years at a locked-in rate that’s lower than what they currently pay for electricity.", "text_kind": "article_excerpt", "text_characters": 702, "text_sha256": "bb760851a9da360038b113c08669662d265c60bdb78a38e47acbe0e18df3d14d", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:12.243176+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 21, "end": 25, "evidence": "Deep in the heart of coal country, schools in Wayne County, West Virginia, are going solar. Conant: “The schools, they don’t have to pay for the equipment. They don’"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:12.261770+00:00", "published_at_raw": "2024-04-16T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 60, "end": 73, "matched_text": "West Virginia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_60181b84284e98f22761", "record_id": "article_60181b84284e98f2", "canonical_url": "https://insideclimatenews.org/news/15042024/noaa-declares-global-coral-bleaching-event", "publisher_url": "https://insideclimatenews.org/news/15042024/noaa-declares-global-coral-bleaching-event", "title_original": "NOAA Declares a Global Coral Bleaching Event in 2023", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-15T22:25:51+00:00", "source_text": "From shallow-water reefs in the Red Sea to graceful gorgonian species in the Caribbean and the rugged branching corals that form the structure of the Great Barrier Reef, the past year brought bleaching, decline and death to coral reefs around the world. The National Oceanic and Atmospheric Administration and the International Coral Reef Initiative today […]", "text_kind": "source_excerpt", "text_characters": 359, "text_sha256": "dd9d27ec799757ac2446143d12c46f4587612bfdfb7ab029fa31bd9646dcc046", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:04.281757+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:04.294547+00:00", "published_at_raw": "2024-04-15T22:25:51", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_1a2740615aabbc96ba2d", "record_id": "article_1a2740615aabbc96", "canonical_url": "https://yaleclimateconnections.org/2024/04/earth-just-had-its-warmest-march-on-record", "publisher_url": "https://yaleclimateconnections.org/2024/04/earth-just-had-its-warmest-march-on-record", "title_original": "Earth just had its warmest March on record", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-12T16:20:35+00:00", "source_text": "The third month of 2024 was Earth’s warmest March since global record-keeping began in 1850, NOAA’s National Centers for Environmental Information , or NCEI, reported April 12. Global weather agencies were in agreement on the March record, according to the Japan Meteorological Agency , Berkeley Earth , and NASA . NASA placed March at a record 1.62 degrees Celsius (3.01 °F) above the 1880-1899 period, its best estimate for when preindustrial temperatures last occurred. This beat the previous record from March 2016 by 0.04 degrees Celsius (0.07 °F). March 2024 had the fourth-greatest departure from average of any month in the NASA database, behind September 2023, February 2024, and November 2023.", "text_kind": "article_excerpt", "text_characters": 703, "text_sha256": "14c152ee250d9a27e6ccb8bfe14e53be3fe4a28c52648a943159dbb38ae4d74e", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:12.339630+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 445, "end": 456, "evidence": "es Celsius (3.01 °F) above the 1880-1899 period, its best estimate for when preindustrial temperatures last occurred. This beat the previous record from March 2016 by 0.04 degrees Celsius (0.07 °F). March 2024 had the fourth-greatest departu"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:12.358187+00:00", "published_at_raw": "2024-04-12T16:20:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan", "start": 257, "end": 262, "matched_text": "Japan", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_b311f1352f5ad76d4d04", "record_id": "article_b311f1352f5ad76d", "canonical_url": "https://news.mongabay.com/2024/04/research-links-deforestation-in-cambodia-to-stunting-in-kids-anemia-in-women", "publisher_url": "https://news.mongabay.com/2024/04/research-links-deforestation-in-cambodia-to-stunting-in-kids-anemia-in-women", "title_original": "Research links deforestation in Cambodia to stunting in kids, anemia in women", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-11T17:11:33+00:00", "source_text": "New research has linked prenatal exposure to deforestation in Cambodia to child stunting and anemia among women. This link between human well-being and forest loss illustrates how the latter can compound preexisting rural health issues in Cambodia, a country notorious for high levels of both deforestation and malnutrition. Gabriel Fuentes Cordoba, an associate professor at […]", "text_kind": "source_excerpt", "text_characters": 379, "text_sha256": "9b100f66faa12236fa9b162d8b4657b0a61824fb47b29cd21751010da0c0f9c9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:47.040978+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:47.052864+00:00", "published_at_raw": "2024-04-11T17:11:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia", "start": 32, "end": 40, "matched_text": "Cambodia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia", "start": 62, "end": 70, "matched_text": "Cambodia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_c1acbb9ece41c2d46802", "record_id": "article_c1acbb9ece41c2d4", "canonical_url": "https://news.mongabay.com/2024/04/a-short-walk-through-amazon-time-interview-with-archaeologist-anna-roosevelt", "publisher_url": "https://news.mongabay.com/2024/04/a-short-walk-through-amazon-time-interview-with-archaeologist-anna-roosevelt", "title_original": "A short walk through Amazon time: Interview with archaeologist Anna Roosevelt", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-10T19:06:36+00:00", "source_text": "Roosevelt said the recent hype regarding the “garden cities” in Ecuador is “annoying”, as it is not a new discovery and it ignores older research from Latin American archaeologists.", "text_kind": "source_excerpt", "text_characters": 181, "text_sha256": "feacf887daa32689e87b784fbba2f6b609a81aa698cd058fc7eb82cd68bc734a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:47.149997+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:47.162393+00:00", "published_at_raw": "2024-04-10T19:06:36", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador", "start": 64, "end": 71, "matched_text": "Ecuador", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_febd5f82ff1f9bc93cc9", "record_id": "article_febd5f82ff1f9bc9", "canonical_url": "https://yaleclimateconnections.org/2024/04/how-to-prepare-your-finances-for-an-extreme-weather-disaster", "publisher_url": "https://yaleclimateconnections.org/2024/04/how-to-prepare-your-finances-for-an-extreme-weather-disaster", "title_original": "How to prepare your finances for an extreme weather disaster", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-10T11:00:00+00:00", "source_text": "During an extreme weather disaster, your home could suffer costly damage and your place of work could close for weeks or months. There’s no way to make it easy, but you can take steps now to make your financial recovery smoother. Before extreme weather is in the forecast, make sure your insurance coverage is up to date. And take photos of the rooms in your house so you can more easily make claims for items that are damaged or destroyed. It’s a good idea to print out information about bank accounts, bills, and loans, so you can make payments and communicate with lenders. Store these records where you can access them quickly.", "text_kind": "article_excerpt", "text_characters": 631, "text_sha256": "e86cab5948288787aabe0ed85bf2e1bbf3e2108e52f9eee82a54d809f2aa6c54", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:12.531645+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:12.547734+00:00", "published_at_raw": "2024-04-10T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_fb319b665991352767f0", "record_id": "article_fb319b6659913527", "canonical_url": "https://news.mongabay.com/2024/04/as-fires-ravaged-indonesia-in-2023-some-positive-trends-emerged-data-show", "publisher_url": "https://news.mongabay.com/2024/04/as-fires-ravaged-indonesia-in-2023-some-positive-trends-emerged-data-show", "title_original": "As fires ravaged Indonesia in 2023, some positive trends emerged, data show", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-09T16:22:57+00:00", "source_text": "JAKARTA — 2023 saw the worst fire season in Indonesia since 2019, with an area the size of Qatar going up in flames, according to official government data. A total of 1.16 million hectares (2.87 million acres) of land and forest were burned last year, with an intense El Niño weather pattern a major factor. […]", "text_kind": "source_excerpt", "text_characters": 311, "text_sha256": "2704a1d9c11b82a6dfd7af42dbc06675a0f873a39df6cd8bda03b0412691d274", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:51.774137+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "1.16 million", "start": 167, "end": 179, "evidence": " A total of 1.16 million hectares (2.", "interpretation": "not_classified"}, {"value_text": "2.87 million", "start": 190, "end": 202, "evidence": "16 million hectares (2.87 million acres) of land and forest were burned last year, with an intense El Niño weather pattern a major factor.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "QA", "alpha3": "QAT", "name_zh": "卡塔尔", "name_en": "Qatar"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "QA", "alpha3": "QAT", "name_zh": "卡塔尔", "name_en": "Qatar"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:51.785913+00:00", "published_at_raw": "2024-04-09T16:22:57", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 17, "end": 26, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 44, "end": 53, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "QA", "alpha3": "QAT", "name_zh": "卡塔尔", "name_en": "Qatar", "start": 91, "end": 96, "matched_text": "Qatar", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_55d08dd693e257597765", "record_id": "article_55d08dd693e25759", "canonical_url": "https://insideclimatenews.org/news/08042024/awe-unites-during-total-solar-eclipse", "publisher_url": "https://insideclimatenews.org/news/08042024/awe-unites-during-total-solar-eclipse", "title_original": "Across the US, Awe Unites During the Darkness of a Total Solar Eclipse", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-09T01:48:21+00:00", "source_text": "ROLAND, Ark.—First came the gasps. As the final sliver of sunlight disappeared behind the persistent moon, eclipse viewers at the Pinnacle Mountain State Park visitors’ center outside Little Rock were left in awe. Nancy Carr had driven six hours from McCalla, Alabama, just outside Birmingham, to view the spectacle. As the sun’s corona began its […]", "text_kind": "source_excerpt", "text_characters": 350, "text_sha256": "820bcca6ae2848773683e8c77c78fbd0c9c3ea2e44e0a12d0766b87881668f93", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:04.950844+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:04.963302+00:00", "published_at_raw": "2024-04-09T01:48:21", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 11, "end": 13, "matched_text": "US", "method": "country-acronym-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_b1bafed4e3a6217493ee", "record_id": "article_b1bafed4e3a62174", "canonical_url": "https://yaleclimateconnections.org/2024/04/a-warming-planet-creates-more-hospitable-conditions-for-valley-fever-fungus", "publisher_url": "https://yaleclimateconnections.org/2024/04/a-warming-planet-creates-more-hospitable-conditions-for-valley-fever-fungus", "title_original": "As temperatures warm, valley fever fungus vastly expands its range", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-08T11:00:00+00:00", "source_text": "Fungi researcher Marieke Ramsey rises before dawn and puts on heavy long pants and hiking boots thick enough to stop a snake bite, keeping an N95 mask handy for a microscopic hazard that can be as dangerous as snake venom. Several times each summer she makes the long drive from her home in northern Arizona’s high country down to the lower elevations of the Sonoran Desert outside of Phoenix or Tucson. Hiking beneath giant saguaro cactuses and around creosote bushes, Ramsey searches for animal burrows. “I’ve been to rat burrows and ones with badgers, rabbits, even squirrels,” she explains.", "text_kind": "article_excerpt", "text_characters": 594, "text_sha256": "1bdfb6a93e286386bbb80bb65589fd6d2ecd6c2c56545b51123eab9c4ce0d0c0", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:12.629609+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:12.647650+00:00", "published_at_raw": "2024-04-08T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_f2538a325ea17a5a5ceb", "record_id": "article_f2538a325ea17a5a", "canonical_url": "https://news.mongabay.com/2024/04/island-building-and-overfishing-wreak-destruction-of-south-china-sea-reefs", "publisher_url": "https://news.mongabay.com/2024/04/island-building-and-overfishing-wreak-destruction-of-south-china-sea-reefs", "title_original": "Island-building and overfishing wreak destruction of South China Sea reefs", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-08T06:54:52+00:00", "source_text": "States jostling for territorial dominance in the South China Sea have inflicted untold damage on the marine environment, according to a new investigation by the Asia Maritime Transparency Initiative (AMTI) and China Ocean Institute, both based in the U.S. The findings, presented in a recent report, are the “most complete picture to date” of the […]", "text_kind": "source_excerpt", "text_characters": 350, "text_sha256": "bc22e667d9dbed0e16d465f78edb3f3e0e47f5e9941271a2f6718083d9d4a02a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:51.882077+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [{"id": "transparency", "label_zh": "透明度与核查", "label_en": "Transparency and reporting", "start": 175, "end": 187, "evidence": "d damage on the marine environment, according to a new investigation by the Asia Maritime Transparency Initiative (AMTI) and China Ocean Institute, both based in the U.S. The findings, presented in a recent report, are the “most complete pict"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:51.896996+00:00", "published_at_raw": "2024-04-08T06:54:52", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 59, "end": 64, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 55, "end": 60, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 251, "end": 255, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_6e7663133cd0e2428d60", "record_id": "article_6e7663133cd0e242", "canonical_url": "https://insideclimatenews.org/news/05042024/todays-climate-klamath-river-dam-removal-science", "publisher_url": "https://insideclimatenews.org/news/05042024/todays-climate-klamath-river-dam-removal-science", "title_original": "As Messy Side Effects of Klamath River Dam Removal Continue, Officials Stress That Short-Term Pain Will Yield Long-Term Gain", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-05T21:40:33+00:00", "source_text": "After years of heated debates and delays, the world’s largest dam removal is currently underway on the Klamath River across the California-Oregon border. Established in the early to mid-1900s by energy company PacifiCorp, the four dams have stored water and generated electricity for the region. But they’ve also prevented endangered salmon from reaching critical habitat […]", "text_kind": "source_excerpt", "text_characters": 375, "text_sha256": "0f8fe008f86de3f2e70b3a574cdde5e0a79023f28c151fc698734ba97e8afa22", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:10.101723+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 195, "end": 201, "evidence": "amath River across the California-Oregon border. Established in the early to mid-1900s by energy company PacifiCorp, the four dams have stored water and generated electricity for the region. But they’ve also prevented endangered salmon "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:10.115696+00:00", "published_at_raw": "2024-04-05T21:40:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 128, "end": 138, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_a2a01b7611a4631d20db", "record_id": "article_a2a01b7611a4631d", "canonical_url": "https://news.mongabay.com/2024/04/as-a-megaport-rises-in-cameroon-a-delicate-coastal-ecosystem-ebbs", "publisher_url": "https://news.mongabay.com/2024/04/as-a-megaport-rises-in-cameroon-a-delicate-coastal-ecosystem-ebbs", "title_original": "As a megaport rises in Cameroon, a delicate coastal ecosystem ebbs", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-05T07:45:19+00:00", "source_text": "Since he was old enough to work, Sam Elong has been a fisherman in Kribi, a coastal town of more than 90,000 inhabitants that stretches along the shore of the Gulf of Guinea at the mouth of the Kienké and Lobé rivers in Cameroon. “Before, when we went fishing, we used to come back with […]", "text_kind": "source_excerpt", "text_characters": 290, "text_sha256": "f302c045d9dbdf6ff2bd37be74320c675d0cec2bbe3c4d31c9900f593f48b0a2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:51.943118+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon"}, {"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon"}, {"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:51.955270+00:00", "published_at_raw": "2024-04-05T07:45:19", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon", "start": 23, "end": 31, "matched_text": "Cameroon", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea", "start": 167, "end": 173, "matched_text": "Guinea", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon", "start": 220, "end": 228, "matched_text": "Cameroon", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_d24a7603739b744bb475", "record_id": "article_d24a7603739b744b", "canonical_url": "https://news.mongabay.com/2024/04/stop-the-mining-before-it-starts-interview-with-community-organizer-carlos-zorrilla", "publisher_url": "https://news.mongabay.com/2024/04/stop-the-mining-before-it-starts-interview-with-community-organizer-carlos-zorrilla", "title_original": "How to ‘stop mining before it starts’: Interview with community organizer Carlos Zorrilla", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-04T21:29:07+00:00", "source_text": "Carlos Zorrilla is a leader in what locals say is the longest continuous resistance movement against mining in Latin America. Zorrilla’s family fled from Cuba to the U.S. in 1962 when he was 11 years old. He moved to the Intag Valley in Ecuador in the 1970s, citing his love for the cloud forest ecosystem […]", "text_kind": "source_excerpt", "text_characters": 309, "text_sha256": "f19bd41cac59084ce0abcf4650789961a8fd2cc4a214d3d93fb96cda4f55405d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:51.988077+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}, {"alpha2": "CU", "alpha3": "CUB", "name_zh": "古巴", "name_en": "Cuba"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador"}, {"alpha2": "CU", "alpha3": "CUB", "name_zh": "古巴", "name_en": "Cuba"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:52.000573+00:00", "published_at_raw": "2024-04-04T21:29:07", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CU", "alpha3": "CUB", "name_zh": "古巴", "name_en": "Cuba", "start": 154, "end": 158, "matched_text": "Cuba", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 166, "end": 170, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "EC", "alpha3": "ECU", "name_zh": "厄瓜多尔", "name_en": "Ecuador", "start": 237, "end": 244, "matched_text": "Ecuador", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_9cdca5348ac53078b20d", "record_id": "article_9cdca5348ac53078", "canonical_url": "https://dialogue.earth/en/nature/saving-chinas-seagrass-without-shutting-out-fishers", "publisher_url": "https://dialogue.earth/en/nature/saving-chinas-seagrass-without-shutting-out-fishers", "title_original": "Saving China’s seagrass without shutting out fishers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-04T12:44:35+00:00", "source_text": "In the 1980s, strong easterly winds would blow fragments of seagrass from Caofeidian in Hebei province across the bay to Hangu, Tianjin. Retired local fisher Liu Cuibo recalls the white internal shells of cuttlefish, known as cuttlebones, or locally as “sea rabbit shells”, mixed in with the seagrass. Liu used to make extra money by collecting them. The blow-ins weren’t as fresh as the ones in Hangu. But after cleaning, the local pharmacies would pay three cents [RMB 0.03] per bone, for use in traditional Chinese medicine.", "text_kind": "article_excerpt", "text_characters": 527, "text_sha256": "223edf15df007247dc538d1ede314a34ebfb6b86f24186aa6649fcfa8a62896e", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:37.287009+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:37.397059+00:00", "published_at_raw": "2024-04-04T12:44:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 7, "end": 12, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 88, "end": 93, "matched_text": "Hebei", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_2becb59b990daaed59fd", "record_id": "article_2becb59b990daaed", "canonical_url": "https://dialogue.earth/en/nature/mekongs-giant-fish-threatened-by-dams-and-wetland-conversions", "publisher_url": "https://dialogue.earth/en/nature/mekongs-giant-fish-threatened-by-dams-and-wetland-conversions", "title_original": "Mekong’s giant fish threatened by dams and wetland conversions", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-04T12:00:14+00:00", "source_text": "Etched in the ancient temples of Angkor, the giant barb is the largest carp species in the world and Cambodia’s national fish. Despite its revered status , however, it is among an estimated 19% of Mekong River fish species facing extinction. The giant barb may disappear along with other species unique to the Mekong unless decision-makers stop undervaluing and overlooking the Mekong’s fishes, according to the Mekong’s Forgotten Fishes report, which was produced by a cohort of 25 conservation groups. It warns that the loss of biodiversity will significantly affect the region’s culture, livelihoods and economies. The magic of the Mekong The Mekong is home to nearly 1,500 fish species, a quarter of which cannot be found anywhere else in the world.", "text_kind": "article_excerpt", "text_characters": 753, "text_sha256": "2f4458a0e5a438573ca4692456c0a045536324d0c97f4d0fd1f7540a538146b6", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:36.959048+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "19%", "start": 190, "end": 193, "evidence": " Despite its revered status , however, it is among an estimated 19% of Mekong River fish species facing extinction.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:37.045040+00:00", "published_at_raw": "2024-04-04T12:00:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia", "start": 101, "end": 109, "matched_text": "Cambodia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_5c875f1821c26cb4244d", "record_id": "article_5c875f1821c26cb4", "canonical_url": "https://insideclimatenews.org/news/04042024/alabama-africatown-asphalt-plant", "publisher_url": "https://insideclimatenews.org/news/04042024/alabama-africatown-asphalt-plant", "title_original": "Black Residents Want This Company Gone. Will Alabama’s Environmental Agency Approve a New Permit?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-04T09:05:00+00:00", "source_text": "MOBILE, Ala.—Walter Moorer likes to say he lives at 411 “Death Row Street.” At least that is what he compares his living conditions to as he is bombarded with the stench, pollution, noise and dust that emanates from an asphalt plant owned by Hosea Weaver and Sons Inc. “I changed it to Death Row because […]", "text_kind": "source_excerpt", "text_characters": 307, "text_sha256": "469006129281ff46ec7d8c2ca76f2519c9937781abc85cc4832f50da0af42748", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:10.502637+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:10.520658+00:00", "published_at_raw": "2024-04-04T09:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_4394faf97e9b05bbdd8c", "record_id": "article_4394faf97e9b05bb", "canonical_url": "https://insideclimatenews.org/news/03042024/african-great-apes-global-mining-risk", "publisher_url": "https://insideclimatenews.org/news/03042024/african-great-apes-global-mining-risk", "title_original": "The Global Mining Boom Puts African Great Apes at Greater Risk Than Previously Known", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-03T18:00:00+00:00", "source_text": "Africa’s great apes—from gorillas to chimpanzees and bonobos—are under far greater threat than scientists previously realized, a new study suggests. While primatologists and conservationists have long tracked great ape populations and the human activities that negatively impact them—from poaching to expanding agriculture and oil drilling—there has historically been a dearth of information on the location […]", "text_kind": "source_excerpt", "text_characters": 411, "text_sha256": "8be5de096e22c319e3fc5246ad4b7cb917fbfea8b75a730c848762944cbf174c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:10.635598+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:10.654276+00:00", "published_at_raw": "2024-04-03T18:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_cb137a051b75d17fdebb", "record_id": "article_cb137a051b75d17f", "canonical_url": "https://yaleclimateconnections.org/2024/04/how-might-the-next-super-tornado-outbreak-play-out-in-tomorrows-world", "publisher_url": "https://yaleclimateconnections.org/2024/04/how-might-the-next-super-tornado-outbreak-play-out-in-tomorrows-world", "title_original": "How might the next super tornado outbreak play out in tomorrow’s world?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-03T15:56:22+00:00", "source_text": "By any yardstick, the 1974 Super Outbreak of severe weather was a nation-rattling event. A total of 148 fast-moving tornadoes rampaged through the central and eastern United States and southern Ontario half a century ago, on April 3-4, 1974. The outbreak included a record total of 30 violent tornadoes, rated the equivalent of EF4 and EF5 on today’s Enhanced Fujita scale. Although warning and communication processes were sophisticated for the time, they were primitive by today’s standards, and people were far less tornado-savvy. More than 300 people died, and the destruction was immense. One silver lining: storm surveys carried out by Dr.", "text_kind": "article_excerpt", "text_characters": 645, "text_sha256": "7aa0c21521d1295661b21c80a1170305f3c55f4be8d7f60dd22be92d6d196241", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:12.783511+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:12.801492+00:00", "published_at_raw": "2024-04-03T15:56:22", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 167, "end": 180, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_1dcefa7d24ac3f83ecc1", "record_id": "article_1dcefa7d24ac3f83", "canonical_url": "https://insideclimatenews.org/news/02042024/texas-energy-clean-hydrogen", "publisher_url": "https://insideclimatenews.org/news/02042024/texas-energy-clean-hydrogen", "title_original": "Texas Energy Companies Are Betting Hydrogen Can Become a Cleaner Fuel for Transportation", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-02T09:00:00+00:00", "source_text": "This article was first published by The Texas Tribune, a nonprofit, nonpartisan media organization that informs Texans—and engages with them—about public policy, politics, government and statewide issues. JEFFERSON COUNTY—A concrete platform with fading blue paint marks the birthplace of the modern oil and gas industry in southeast Texas. Weather-beaten signs describe how drillers tapped the […]", "text_kind": "source_excerpt", "text_characters": 398, "text_sha256": "b417fb73acb331a7be9a8be9d2bee759a3ce704834c38f6454296845ba5738e6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:11.125921+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:11.150130+00:00", "published_at_raw": "2024-04-02T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 5, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 40, "end": 45, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_557c9f9a39858e719f70", "record_id": "article_557c9f9a39858e71", "canonical_url": "https://news.mongabay.com/2024/04/report-shows-dire-state-of-mekongs-fish-but-damage-can-still-be-undone", "publisher_url": "https://news.mongabay.com/2024/04/report-shows-dire-state-of-mekongs-fish-but-damage-can-still-be-undone", "title_original": "Report shows dire state of Mekong’s fish — but damage can still be undone", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-01T18:27:54+00:00", "source_text": "The threatened fish of the Mekong River are inching closer extinction, according to a new report that cites piling pressures on the waterway. Though the situation is serious, conservationists say it’s not too late to turn the tide for the river’s freshwater species. The nearly 5,000-kilometer (3,000-mile) Mekong supports millions of people across six countries, […]", "text_kind": "source_excerpt", "text_characters": 367, "text_sha256": "103b776fee9b51954f8183f5d77a0c3f2f5e7f7db4957a855bbf831a91b212f9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:52.267266+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:52.281874+00:00", "published_at_raw": "2024-04-01T18:27:54", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_f77f3192f46d0d98b13b", "record_id": "article_f77f3192f46d0d98", "canonical_url": "https://news.mongabay.com/2024/04/e-bikes-could-cut-smog-energy-use-and-congestion-globally-but-will-they", "publisher_url": "https://news.mongabay.com/2024/04/e-bikes-could-cut-smog-energy-use-and-congestion-globally-but-will-they", "title_original": "E-bikes could cut smog, energy use and congestion globally — but will they?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-01T15:50:55+00:00", "source_text": "While four-wheeled EVs get most of the media attention, electric bicycles are an economical, environmentally friendly mode of transportation being chosen by millions of consumers, commuters and businesses the world over. But barriers exist.", "text_kind": "source_excerpt", "text_characters": 240, "text_sha256": "9b5920edda783b320a54c58217a6c29cf6fbbdfbeb4d6fcd24bd02a622659093", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:52.311688+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:52.328882+00:00", "published_at_raw": "2024-04-01T15:50:55", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_7a646c94f17e6ce399f9", "record_id": "article_7a646c94f17e6ce3", "canonical_url": "https://yaleclimateconnections.org/2024/04/colorado-farmer-finds-success-with-drought-resilient-millet", "publisher_url": "https://yaleclimateconnections.org/2024/04/colorado-farmer-finds-success-with-drought-resilient-millet", "title_original": "Colorado farmer finds success with drought-resilient millet", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-04-01T11:00:00+00:00", "source_text": "About 100 miles from Denver, in the flat plains of northeastern Colorado, Nate Northup’s farm gets very little rain. Northup: “Our annual precipitation is 12 to 15 inches at best.” He farms thousands of acres with no irrigation, so he needs to choose crops that can tolerate the dry, arid conditions. One of those crops is millet. Northup: “Millet, for those that don’t know, is just essentially the little white seed that you see in birdseed.” Plenty of people eat it too. In some parts of the world, millet is a staple ingredient, hulled and cooked into porridge, or ground into flour. And it’s gaining popularity in the U.S. as a gluten-free substitute for wheat flour or to add crunch to baked goods and bars.", "text_kind": "article_excerpt", "text_characters": 713, "text_sha256": "e542c9effee8875632960c791c1a02eb5dfb9f2c0c47a934ac87c1033531b9d2", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:12.919605+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:12.945510+00:00", "published_at_raw": "2024-04-01T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 623, "end": 627, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_c4178a1d170ad2a9d4c2", "record_id": "article_c4178a1d170ad2a9", "canonical_url": "https://insideclimatenews.org/news/31032024/todays-climate-music-festivals-extreme-weather", "publisher_url": "https://insideclimatenews.org/news/31032024/todays-climate-music-festivals-extreme-weather", "title_original": "The Show Must Go On? Music Festival-Goers Are At Risk As Extreme Weather Events Become More Frequent and Severe", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-31T18:41:47+00:00", "source_text": "On March 22, droves of fans covered in glitter and body paint swarmed Miami’s Bayfront Park to attend the first day of the Ultra EDM Music Festival. Then the downpour started. Buckets of rain assaulted poncho-clad attendees as they sloshed through ankle-deep flooding and sludge, though some voluntarily played around in the mud instead, John […]", "text_kind": "source_excerpt", "text_characters": 346, "text_sha256": "d6473f53a94fe43d1233d51f40eaed12699aeeb66a2381de414fecde5135058a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:11.292424+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 259, "end": 264, "evidence": "arted. Buckets of rain assaulted poncho-clad attendees as they sloshed through ankle-deep flooding and sludge, though some voluntarily played around in the mud instead, John […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:11.324054+00:00", "published_at_raw": "2024-03-31T18:41:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_b23d0ee1c5110ee20312", "record_id": "article_b23d0ee1c5110ee2", "canonical_url": "https://insideclimatenews.org/news/31032024/amazon-river-flooding-droughts", "publisher_url": "https://insideclimatenews.org/news/31032024/amazon-river-flooding-droughts", "title_original": "A River in Flux", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-31T09:05:00+00:00", "source_text": "This project was originally published in Science magazine. The story was supported by the Pulitzer Center and the Pendleton Mazer Family Fund. MANAUS, Brazil—Jochen Schöngart darts back and forth along an escarpment just above the Amazon River, a short water taxi ride from downtown Manaus, Brazil. It’s still early this October morning in 2023, but […]", "text_kind": "source_excerpt", "text_characters": 353, "text_sha256": "28fb01ad1c64b09093df1a63c62682c32a8856cae88c73ac69f7289b401e1809", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:11.360261+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint"