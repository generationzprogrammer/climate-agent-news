{"text_id": "text_e07ff5fa5c42ac33d019", "record_id": "article_e07ff5fa5c42ac33", "canonical_url": "https://insideclimatenews.org/news/30032025/the-online-shopping-boom-comes-at-a-price-and-some-new-yorkers-pay-more-than-their-fair-share", "publisher_url": "https://insideclimatenews.org/news/30032025/the-online-shopping-boom-comes-at-a-price-and-some-new-yorkers-pay-more-than-their-fair-share", "title_original": "The Online Shopping Boom Comes at a Price—and Some New Yorkers Pay More Than Their Fair Share", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-30T09:00:00+00:00", "source_text": "NEW YORK—Package deliveries in New York City are booming, bolstered by the pandemic and online shopping, with 80 percent of households in New York City receiving a package a week, according to the Office of the Mayor. Almost 90 percent of goods are transported into or around the city by trucks, which emit fine particulate […]", "text_kind": "source_excerpt", "text_characters": 327, "text_sha256": "489210b8d87879c4405865051fa76627ebad956d81a36643e285bba65c82c69d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:29.028446+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "80 percent", "start": 110, "end": 120, "evidence": "NEW YORK—Package deliveries in New York City are booming, bolstered by the pandemic and online shopping, with 80 percent of households in New York City receiving a package a week, according to the Office of the Mayor.", "interpretation": "not_classified"}, {"value_text": "90 percent", "start": 225, "end": 235, "evidence": " Almost 90 percent of goods are transported into or around the city by trucks, which emit fine particulate […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:29.079283+00:00", "published_at_raw": "2025-03-30T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_a7e571c1744caced5d56", "record_id": "article_a7e571c1744caced", "canonical_url": "https://news.mongabay.com/2025/03/siamese-crocodile-release-into-the-wild-marks-conservation-milestone-in-cambodia", "publisher_url": "https://news.mongabay.com/2025/03/siamese-crocodile-release-into-the-wild-marks-conservation-milestone-in-cambodia", "title_original": "Siamese crocodile release into the wild marks conservation milestone in Cambodia", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-28T20:27:53+00:00", "source_text": "In a conservation milestone, 10 Siamese crocodiles were released this month into Cambodia’s Virachey National Park for the first time, as part of a decades-long effort to save the critically endangered species. The Siamese crocodile is one of the world’s rarest crocodilians, with less than 1,000 individuals estimated to be surviving in the wild. The […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "fe8980ae1d6c5e7ef0f805bea3068f05ed78f1de175fc95f880d5f6e7cdd9dd0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:42.558529+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:42.584933+00:00", "published_at_raw": "2025-03-28T20:27:53", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia", "start": 72, "end": 80, "matched_text": "Cambodia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia", "start": 81, "end": 89, "matched_text": "Cambodia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_d5ab517bb6fb77c1f0c2", "record_id": "article_d5ab517bb6fb77c1", "canonical_url": "https://news.mongabay.com/2025/03/netherlands-largest-forest-biomass-plant-canceled-forest-advocates-elated", "publisher_url": "https://news.mongabay.com/2025/03/netherlands-largest-forest-biomass-plant-canceled-forest-advocates-elated", "title_original": "Netherlands’ largest forest biomass plant canceled, forest advocates elated", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-27T15:31:26+00:00", "source_text": "Dutch forest campaigners are claiming a significant victory over one of the Netherlands’ top energy providers, Vattenfall, after the company decided in late February to cancel plans to build the nation’s largest wood pellet burning plant for energy. “This is enormous,” said Fenna Swart, leader of the Clean Air Committee, a Dutch forest advocacy group […]", "text_kind": "source_excerpt", "text_characters": 356, "text_sha256": "c7f3f3db87cda367183894b47721224c814eb7d0a611bf243c825b4fe96ea4c5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:47.121371+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NL", "alpha3": "NLD", "name_zh": "荷兰", "name_en": "Netherlands"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 93, "end": 99, "evidence": "ch forest campaigners are claiming a significant victory over one of the Netherlands’ top energy providers, Vattenfall, after the company decided in late February to cancel plans to build the nation’s largest wood pellet burning plant f"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NL", "alpha3": "NLD", "name_zh": "荷兰", "name_en": "Netherlands"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:47.138305+00:00", "published_at_raw": "2025-03-27T15:31:26", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NL", "alpha3": "NLD", "name_zh": "荷兰", "name_en": "Netherlands", "start": 0, "end": 11, "matched_text": "Netherlands", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "NL", "alpha3": "NLD", "name_zh": "荷兰", "name_en": "Netherlands", "start": 76, "end": 87, "matched_text": "Netherlands", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_672e128c1cce910907fe", "record_id": "article_672e128c1cce9109", "canonical_url": "https://news.mongabay.com/2025/03/indiscriminate-pesticide-use-threatens-bangladesh-honeybees", "publisher_url": "https://news.mongabay.com/2025/03/indiscriminate-pesticide-use-threatens-bangladesh-honeybees", "title_original": "Indiscriminate pesticide use threatens Bangladesh honey bees", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-27T07:11:14+00:00", "source_text": "In February, during the flowering time of black cumin (Nigella sativa), beekeeper Pavel Hossen set up an apiary on leased barren land adjacent to farmer Abdul Hakim’s crop field in Kazirhat of Shariatpur, a district under Dhaka division and an emerging hub of spices, including the black cumin seeds. Pavel deployed Apis mellifera honey bees […]", "text_kind": "source_excerpt", "text_characters": 345, "text_sha256": "f8cf622aab26b391cd71d8a055c5bfcfee69d792d3c8eff1857764b47d23aa86", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:47.173927+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint":