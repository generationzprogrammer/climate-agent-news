{"text_id": "text_539319a90e6967df45ed", "record_id": "article_539319a90e6967df", "canonical_url": "https://insideclimatenews.org/news/18102024/hurricane-helene-psychological-first-aid", "publisher_url": "https://insideclimatenews.org/news/18102024/hurricane-helene-psychological-first-aid", "title_original": "After Hurricane Helene, Therapists Dispense ‘Psychological First Aid’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-18T09:00:00+00:00", "source_text": "Makayla and Maddux Jamerson slept through a 6:30 a.m. flash flood warning and woke to their three kids screaming that water was coming into the house. In less than an hour there was already more than a foot of water flooding their first-floor duplex apartment in Pisgah Forest, North Carolina. It was Friday, Sept. 27, […]", "text_kind": "source_excerpt", "text_characters": 322, "text_sha256": "7ca211a73b3ba81f79d714aa79eed086313426826e81f8ede8b809febc81e356", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:47.458052+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 60, "end": 65, "evidence": "Makayla and Maddux Jamerson slept through a 6:30 a.m. flash flood warning and woke to their three kids screaming that water was coming into the house. In less than an hour there was already more th