{"text_id": "text_2f3f622e6dd123008dbe", "record_id": "article_2f3f622e6dd12300", "canonical_url": "https://insideclimatenews.org/news/17052024/california-gas-stove-warning-label-health-research", "publisher_url": "https://insideclimatenews.org/news/17052024/california-gas-stove-warning-label-health-research", "title_original": "As California Considers Warning Labels for Gas Stoves, Researchers Learn More About Their Negative Health Impacts", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-17T09:05:00+00:00", "source_text": "Ruth Ann Norton used to look forward to seeing the blue flame that danced on the burners of her gas stove. At one time, she says, she would have sworn that preparing meals with the appliance actually made her a better cook. But then she started learning about the toxic gasses, including carbon monoxide, formaldehyde […]", "text_kind": "source_excerpt", "text_characters": 321, "text_sha256": "eb052d321d771da4dd17df84d8bb65d5baddead5b959d775c994452027d0829e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:49.752704+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_