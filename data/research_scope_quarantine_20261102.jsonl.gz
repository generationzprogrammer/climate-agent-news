{"text_id": "text_7215ce19eca2c0bbe587", "record_id": "article_7215ce19eca2c0bb", "canonical_url": "https://insideclimatenews.org/news/27012024/alabama-landfill-caught-fire-and-smoldered-for-50-days", "publisher_url": "https://insideclimatenews.org/news/27012024/alabama-landfill-caught-fire-and-smoldered-for-50-days", "title_original": "A Publicly-Owned Landfill in Alabama Caught Fire and Smoldered for 50 Days. Nearby Residents Were Left in the Dark", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-27T10:00:00+00:00", "source_text": "NEW MARKET, Ala.—Merri Gardunia thought her house might be on fire. Gardunia, a special education teacher, was on her way home in August 2023 when she saw the smoke billowing above her road in New Market, Alabama, a small town just northeast of Huntsville. As she got closer, she sighed in relief. It wasn’t her […]", "text_kind": "source_excerpt", "text_characters": 315, "text_sha256": "cf7322083491f6e9c18cfd65409cc53b1b495cda5c6f12d673d39257dae5b80f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:39.648957+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/