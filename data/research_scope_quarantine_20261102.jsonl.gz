{"text_id": "text_92dc15c0408d817b8b53", "record_id": "article_92dc15c0408d817b", "canonical_url": "https://insideclimatenews.org/news/20102026/federal-bill-proposal-to-ban-wild-sloth-imports", "publisher_url": "https://insideclimatenews.org/news/20102026/federal-bill-proposal-to-ban-wild-sloth-imports", "title_original": "Federal Lawmakers to Introduce Bipartisan Bill to Ban Wild Sloth Imports", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-20T09:00:00+00:00", "source_text": "Federal lawmakers want to ban imports of wild sloths to the United States, a move experts say could have global implications for the conservation of the tree-dwelling species. Maxwell Alejandro Frost (D-Fla.) is set on Tuesday to introduce a bill, co-sponsored by Laurel Lee (R-Fla.), known as the “SLOTHS Act”—Stopping Legalized Organized Trafficking and Harm […]", "text_kind": "source_excerpt", "text_characters": 364, "text_sha256": "090ffd0c141ad79b2ebf6ae41f7bc78c78a19a876616e87e7cbac9f7d376c52d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:33.700868+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_m