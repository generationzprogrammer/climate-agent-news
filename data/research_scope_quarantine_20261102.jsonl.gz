{"text_id": "text_129b31081afe59437bdc", "record_id": "article_129b31081afe5943", "canonical_url": "https://news.mongabay.com/2024/01/a-mekong-island-too-tiny-for-industrial-farming-now-points-to-vietnams-future", "publisher_url": "https://news.mongabay.com/2024/01/a-mekong-island-too-tiny-for-industrial-farming-now-points-to-vietnams-future", "title_original": "A Mekong island too tiny for industrial farming now points to Vietnam’s future", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-11T20:44:13+00:00", "source_text": "CON CHIM, Vietnam — Off the coast of Vietnam’s Tra Vinh province lies Con Chim, a tiny stretch of land where the wind sweeps in off the water, weaving through mangroves and rustling across fields of rice. This land, all 62 hectares (153 acres) of it, is a rare example of what much of the […]", "text_kind": "source_excerpt", "text_characters": 292, "text_sha256": "9b382d1da293eff3ebe3e2d98b882ba6b7aee464285b8b263b67db6294ceaba8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:29.350923+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "VN", "alpha3": "VNM", "name_zh": "越南", "name_en": "Vietnam"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "VN", "alpha3": "VNM", "name_zh": "越南", "name_en": "Vietnam"}], "annotation_method": "dictionary-evidence-v1", "review_status"