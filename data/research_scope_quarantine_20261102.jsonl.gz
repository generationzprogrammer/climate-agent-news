{"text_id": "text_c388f4fb4b6e5d8e63e9", "record_id": "article_c388f4fb4b6e5d8e", "canonical_url": "https://insideclimatenews.org/news/17032026/corpus-christi-cuts-timeline-to-disaster-as-abbott-issues-emergency-orders", "publisher_url": "https://insideclimatenews.org/news/17032026/corpus-christi-cuts-timeline-to-disaster-as-abbott-issues-emergency-orders", "title_original": "Corpus Christi Cuts Timeline to Disaster as Abbott Issues Emergency Orders", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-18T00:42:02+00:00", "source_text": "City officials in Corpus Christi on Tuesday released modeling that showed emergency cuts to water demand could be required as soon as May as reservoir levels continue to decline. That means the region’s complex of refineries and chemical plants could face disruptions of their water supply sooner than previously predicted. At a regularly scheduled City […]", "text_kind": "source_excerpt", "text_characters": 357, "text_sha256": "85dea29429415a51c7eb90dd1bafb1885c375144999fb52960460cbb09751dbc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:25.276729+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:25.299847+00:00", "published_at_raw": "2026-03-18T00:42:02", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_32f979342aca3640325f", "record_id": "article_32f979342aca3640", "canonical_url": "https://insideclimatenews.org/news/17032026/trump-interior-department-staffing-cuts", "publisher_url": "https://insideclimatenews.org/news/17032026/trump-interior-department-staffing-cuts", "title_original": "After Trump’s Interior Secretary Transferred Thousands of Staff to His Office, Chaos Followed, Former Workers Say", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-17T09:00:00+00:00", "source_text": "One year into President Donald Trump’s second term, the Department of the Interior is in turmoil, hobbling many of the agencies overseeing the country’s public lands and waters. Not only has Interior lost some 11,000 employees, or more than 17 percent of its workforce, it is also reeling from a drastic centralization of personnel: Last […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "30202fea478c488085a8cf81b0a066171dc470a6535a5ffffb987d67831882ec", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:25.389985+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "17 percent", "start": 241, "end": 251, "evidence": " Not only has Interior lost some 11,000 employees, or more than 17 percent of its workforce, it is also reeling from a drastic centralization of personnel: Last […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:25.425476+00:00", "published_at_raw": "2026-03-17T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_08813a12564cc5247347", "record_id": "article_08813a12564cc524", "canonical_url": "https://yaleclimateconnections.org/2026/03/pick-your-weather-poison-this-week-tornadoes-blizzard-record-rain-wildfire-or-summerlike-heat", "publisher_url": "https://yaleclimateconnections.org/2026/03/pick-your-weather-poison-this-week-tornadoes-blizzard-record-rain-wildfire-or-summerlike-heat", "title_original": "Pick your weather poison this week: Tornadoes, blizzard, record rain, wildfire, or summerlike heat", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-16T18:31:15+00:00", "source_text": "What seemed like a tense meteorological face-off all winter – between persistent blasts of snow and cold in the Eastern U.S. and unsettling warmth and dryness out West – has devolved into a no-punches-pulled weather brawl. It’s a challenge just to keep score, much less make sense of it all, but we’ll do our best to put this head-spinning round of mid-March Madness in the U.S. weather into perspective. Here’s a capsule summary of what’s been happening and what’s on tap: Ferocious cold-front winds knocked out power to more than a million customers in and around Ohio on Friday, March 13. Winter wildfire has scorched over 700,00 acres in Nebraska — an area about the size of Rhode Island — since Thursday, including the state’s largest blaze in modern history.", "text_kind": "article_excerpt", "text_characters": 764, "text_sha256": "97d9140e56f8355da5c0a70302f3c8f7ec16fde5ed932b6d58bd8136f6508f90", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:20.288146+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 599, "end": 607, "evidence": "out power to more than a million customers in and around Ohio on Friday, March 13. Winter wildfire has scorched over 700,00 acres in Nebraska — an area about the size of Rhode Island — since Thursday, including the state’s largest blaze i"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:20.321867+00:00", "published_at_raw": "2026-03-16T18:31:15", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 120, "end": 124, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_609a5e26d335bb2ec2dc", "record_id": "article_609a5e26d335bb2e", "canonical_url": "https://insideclimatenews.org/news/15032026/new-mexico-climate-religious-pilgrimage", "publisher_url": "https://insideclimatenews.org/news/15032026/new-mexico-climate-religious-pilgrimage", "title_original": "A New Mexico Religious Pilgrimage Rode a Global Wave Hoping for Ripple Effects for the Environment", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-15T08:55:00+00:00", "source_text": "Oil and gas wells might seem unusual sites for religious pilgrims, but on January 12, three faith-motivated environmentalists set out on a 328-mile trek from Carlsbad, New Mexico, that would see them slogging on foot past fossil-fuel developments, through remote ranch lands and deep into the desert on their way to the state capitol in […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "b94a08c35b80385018aa1939b5e90005536325776968d7c648c84c2675f306a3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:26.019989+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:26.093359+00:00", "published_at_raw": "2026-03-15T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 2, "end": 12, "matched_text": "New Mexico", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 168, "end": 178, "matched_text": "New Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_ec59710232921d45966e", "record_id": "article_ec59710232921d45", "canonical_url": "https://news.mongabay.com/2026/03/costa-ricas-head-start-may-mask-tougher-eudr-road-ahead", "publisher_url": "https://news.mongabay.com/2026/03/costa-ricas-head-start-may-mask-tougher-eudr-road-ahead", "title_original": "Costa Rica’s head start may mask tougher EUDR road ahead", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-13T17:49:20+00:00", "source_text": "Costa Rica’s famous coffee industry says it’s nearly ready for EUDR. The upcoming European Union Deforestation Regulation (EUDR) requires that all coffee shipped into the EU not come from recently deforested land, prompting Costa Rica to develop a pilot program with its largest coffee cooperative. The initial program provided tools and training to help growers, […]", "text_kind": "source_excerpt", "text_characters": 367, "text_sha256": "3cb71b0ee163e3e851bab0fc7f35f3ac6cef5a986422f244fec66a35ef467b77", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:45.996025+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CR", "alpha3": "CRI", "name_zh": "哥斯达黎加", "name_en": "Costa Rica"}], "governance_themes": [], "policy_tools": [{"id": "standards", "label_zh": "标准与监管", "label_en": "Standards and regulation", "start": 111, "end": 121, "evidence": "offee industry says it’s nearly ready for EUDR. The upcoming Europ