{"text_id": "text_77f67b6702a85d32e588", "record_id": "article_77f67b6702a85d32", "canonical_url": "https://insideclimatenews.org/news/13062026/commercial-satellite-space-race-pollution", "publisher_url": "https://insideclimatenews.org/news/13062026/commercial-satellite-space-race-pollution", "title_original": "A Commercial Space Race Prompts a Thorny Question: Who Owns the Sky?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-13T09:00:00+00:00", "source_text": "The starry night sky has always anchored humanity’s sense of place in a vast universe. It’s a map guiding travelers, a calendar for migrations and harvests, a wellspring of stories. But a surge of commercial satellite launches into the upper fringes of Earth’s atmosphere threatens the relationship between people and the celestial commons by crowding […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "470b68022fc8a0866b99b6d356f02879d1759d83136bb3aa21403756820ac53e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:08.850589+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_c