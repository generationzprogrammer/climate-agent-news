": "KZ", "alpha3": "KAZ", "name_zh": "哈萨克斯坦", "name_en": "Kazakhstan"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:27.592768+00:00", "published_at_raw": "2024-11-24T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KZ", "alpha3": "KAZ", "name_zh": "哈萨克斯坦", "name_en": "Kazakhstan", "start": 8, "end": 18, "matched_text": "Kazakhstan", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "KZ", "alpha3": "KAZ", "name_zh": "哈萨克斯坦", "name_en": "Kazakhstan", "start": 63, "end": 73, "matched_text": "Kazakhstan", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "RU", "alpha3": "RUS", "name_zh": "俄罗斯", "name_en": "Russia", "start": 111, "end": 118, "matched_text": "Russian", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_eb7870c1e7d76c2c8c37", "record_id": "article_eb7870c1e7d76c2c", "canonical_url": "https://insideclimatenews.org/news/23112024/environmental-activists-alarmed-by-trump-cabinet-picks", "publisher_url": "https://insideclimatenews.org/news/23112024/environmental-activists-alarmed-by-trump-cabinet-picks", "title_original": "Environmental Activists Are Alarmed by Trump’s Picks to Run the EPA, the Department of Energy and the Department of the Interior", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-23T09:55:00+00:00", "source_text": "From our collaborating partner Living on Earth, public radio’s environmental news magazine, an interview by host Steve Curwood with Pat Parenteau, an emeritus professor at the Vermont Law and Graduate School. This interview has been edited for length and clarity. President-elect Donald Trump has unveiled his choices to run three of the federal departments critical […]", "text_kind": "source_excerpt", "text_characters": 370, "text_sha256": "5871c16747732bbd55ffe94217ccda4965de21464b94ca222af1249e7b96c4ed", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:27.721188+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:27.740963+00:00", "published_at_raw": "2024-11-23T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_c10f76d808046bbc09c3", "record_id": "article_c10f76d808046bbc", "canonical_url": "https://dialogue.earth/en/energy/what-chinas-green-overcapacity-could-mean-for-the-global-south", "publisher_url": "https://dialogue.earth/en/energy/what-chinas-green-overcapacity-could-mean-for-the-global-south", "title_original": "What China’s green ‘overcapacity’ could mean for the Global South", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-22T15:30:07+00:00", "source_text": "“Overcapacity” is a word that has dominated the global political agenda this year. In an April visit to China, US Treasury Secretary Janet Yellen raised – both privately and publicly – the Chinese economy’s “imbalances and overcapacity”. Yellen expressed worries that this overcapacity could harm US industries. A particular focus of attention on the overcapacity debate has been China’s “new three” sectors of solar power, electric vehicles (EVs) and lithium batteries – products that are also central to China’s and the world’s low-carbon energy transition. Analysts say that EVs are expected to face a further setback under the second term of US president-elect Donald Trump, whose transition team is planning to cut EV tax credits and further increase tariffs on Chinese goods.", "text_kind": "article_excerpt", "text_characters": 781, "text_sha256": "b419e21ee421f96927c74418e0f837886c3b0fc20cd4dc31f18999042944d7c6", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:48.628774+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 411, "end": 416, "evidence": "lar focus of attention on the overcapacity debate has been China’s “new three” sectors of solar power, electric vehicles (EVs) and lithium batteries – products that are also central to China’s and the world’s low-carbon energy transiti"}], "policy_tools": [{"id": "subsidy", "label_zh": "补贴与激励", "label_en": "Subsidies and incentives", "start": 723, "end": 733, "evidence": "cond term of US president-elect Donald Trump, whose transition team is planning to cut EV tax credits and further increase tariffs on Chinese goods."}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:48.649461+00:00", "published_at_raw": "2024-11-22T15:30:07", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 5, "end": 10, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 104, "end": 109, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 111, "end": 113, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_86bfd6708a92660010f8", "record_id": "article_86bfd6708a926600", "canonical_url": "https://insideclimatenews.org/news/22112024/illinois-data-centers-impact-chicago-electricity-bills", "publisher_url": "https://insideclimatenews.org/news/22112024/illinois-data-centers-impact-chicago-electricity-bills", "title_original": "As Illinois’ Governor Recruits Data Centers, Chicagoans’ Electricity Bills Are Getting More Expensive", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-22T10:05:00+00:00", "source_text": "This article is published in partnership with the Chicago Sun-Times. You may have no clue what a data center does. But a boom in these high-tech operations in the Chicago area and around the country—as the United States races to be a world leader in artificial intelligence—will hit home in the form of higher electricity […]", "text_kind": "source_excerpt", "text_characters": 325, "text_sha256": "9b884af66e5e7436effe8de931ae607aa4af75a00950d4cfd97969daeb77a18d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:27.836306+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotati