{"text_id": "text_e480dc08e615b8ff8b9b", "record_id": "article_e480dc08e615b8ff", "canonical_url": "https://news.mongabay.com/2024/03/field-stations-deliver-high-return-on-investment-for-conservation-study-finds", "publisher_url": "https://news.mongabay.com/2024/03/field-stations-deliver-high-return-on-investment-for-conservation-study-finds", "title_original": "Biological field stations deliver high return on investment for conservation, study finds", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-06T17:20:54+00:00", "source_text": "The term “field station” has an air of mystery, conjuring images of some tropical or icy outpost where scientists go to “do science.” And while it’s true that scientific research is the backbone of field stations, these places also provide many overlooked benefits and a huge return on investment for conservation, according to a new […]", "text_kind": "source_excerpt", "text_characters": 337, "text_sha256": "eede2a15513c75c4aff85a6ab3b7993d5dc7fa0b555053d19b9db0779ace8e02", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:03.204474+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:03.215436+00:00", "published_at_raw": "2024-03-06T17:20:54", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_70df210255e66f5b33cc", "record_id": "article_70df210255e66f5b", "canonical_url": "https://news.mongabay.com/2024/03/report-rising-slaughter-of-small-whales-and-dolphins-threatens-ocean-balance", "publisher_url": "https://news.mongabay.com/2024/03/report-rising-slaughter-of-small-whales-and-dolphins-threatens-ocean-balance", "title_original": "Report: Rising slaughter of small whales and dolphins threatens ocean balance", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-06T08:00:41+00:00", "source_text": "READER ADVISORY: This story contains images of dead cetaceans that some viewers may find disturbing. More than 100,000 dolphins, porpoises and small whales are killed annually, according to a new review from German and British NGOs Pro Wildlife and Whale and Dolphin Conservation. This update on a 2018 assessment by the same authors reveals concerning […]", "text_kind": "source_excerpt", "text_characters": 356, "text_sha256": "862b85467a7ea5ad338a3e21093a07fd74e124375d206716a70f0be9cf6030c8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:07.672116+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:07.688664+00:00", "published_at_raw": "2024-03-06T08:00:41", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 219, "end": 226, "matched_text": "British", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_b97accb61898fd565641", "record_id": "article_b97accb61898fd56", "canonical_url": "https://insideclimatenews.org/news/05032024/todays-climate-texas-wildfires-agriculture-cattle", "publisher_url": "https://insideclimatenews.org/news/05032024/todays-climate-texas-wildfires-agriculture-cattle", "title_original": "Texas Panhandle Wildfires Wreak Havoc on the State’s Agriculture Industry", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-05T20:36:50+00:00", "source_text": "For the past week, the Texas Panhandle has been covered in flames. The ongoing inferno—the largest wildfire in the state’s history—has burned up nearly 1.3 million acres of land, and firefighters have only managed to contain 15 percent of it as of Sunday. The state government is currently investigating the initial cause of the fire. […]", "text_kind": "source_excerpt", "text_characters": 338, "text_sha256": "4eafd9f1b341c0b6f7ecc0476be97c13f8d2fc1db68c5b7b4e61ddc4a729dc31", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:24.913792+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "1.3 million", "start": 152, "end": 163, "evidence": " The ongoing inferno—the largest wildfire in the state’s history—has burned up nearly 1.3 million acres of land, and firefighters have only managed to contain 15 percent of it as of Sunday.", "interpretation": "not_classified"}, {"value_text": "15 percent", "start": 225, "end": 235, "evidence": "3 million acres of land, and firefighters have only managed to contain 15 percent of it as of Sunday.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 99, "end": 107, "evidence": "ast week, the Texas Panhandle has been covered in flames. The ongoing inferno—the largest wildfire in the state’s history—has burned up nearly 1.3 million acres of land, and firefighters have only managed to contain 15 percent of it as of"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:24.925814+00:00", "published_at_raw": "2024-03-05T20:36:50", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 5, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 23, "end": 28, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_d6051c1c4a27347e0d65", "record_id": "article_d6051c1c4a27347e", "canonical_url": "https://news.mongabay.com/2024/03/breadfruits-low-carbon-storage-could-be-offset-by-fast-growth-study-finds", "publisher_url": "https://news.mongabay.com/2024/03/breadfruits-low-carbon-storage-could-be-offset-by-fast-growth-study-finds", "title_original": "Breadfruit’s low carbon storage could be offset by fast growth, study finds", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-05T17:56:14+00:00", "source_text": "On a hotter and hungrier planet, breadfruit is becoming a popular tree. It offers nutrient- and fiber-dense fruits that can feed a family and provide farming income, and with its long lifespan, it’s been heralded as a good way to remove carbon from the atmosphere and store it in trees, leaves and soil. But until […]", "text_kind": "source_excerpt", "text_characters": 317, "text_sha256": "995dba720cd72f7816cbfe0a477ccf8f73a58fc4f1e66c2c368ebd8b5f4b03c9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:07.773110+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:07.787800+00:00", "published_at_raw": "2024-03-05T17:56:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_54e723d5758256d03228", "record_id": "article_54e723d5758256d0", "canonical_url": "https://news.mongabay.com/2024/03/corals-dying-as-yet-more-bleaching-hits-heat-stressed-great-barrier-reef", "publisher_url": "https://news.mongabay.com/2024/03/corals-dying-as-yet-more-bleaching-hits-heat-stressed-great-barrier-reef", "title_original": "‘Corals dying’ as yet more bleaching hits heat-stressed Great Barrier Reef", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-03-05T13:14:56+00:00", "source_text": "The southern section of the Great Barrier Reef is undergoing extensive coral bleaching, according to researchers who recently surveyed the region. The discovery has raised fears that this fragile coral reef system is on the brink of a seventh mass bleaching event since 1998. In late February, scientists from the Australian Institute of Marine Science […]", "text_kind": "source_excerpt", "text_characters": 356, "text_sha256": "ad866db5301612af29cb6bf589c9676991850df8cd592588fe5eac7b9d536508", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:07.820484+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.co