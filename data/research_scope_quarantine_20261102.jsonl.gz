{"text_id": "text_3749d61830b4693aa4d4", "record_id": "article_3749d61830b4693a", "canonical_url": "https://insideclimatenews.org/news/31012026/questions-surround-floridas-attempt-to-expand-its-role-in-everglades-restoration", "publisher_url": "https://insideclimatenews.org/news/31012026/questions-surround-floridas-attempt-to-expand-its-role-in-everglades-restoration", "title_original": "In Florida, Questions Surround the State’s Attempt to Expand Its Role in Everglades Restoration", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-31T10:00:00+00:00", "source_text": "A few weeks after the U.S. government began incarcerating undocumented migrants in the fragile Florida Everglades, Gov. Ron DeSantis held a news event some 57 miles from the facility, in beachy Marco Island, that went somewhat unnoticed at the time among the national media. At the event, the governor and Acting Assistant Secretary of the […]", "text_kind": "source_excerpt", "text_characters": 343, "text_sha256": "aaece3eaeb8fa6c445ac363eda6c03d4572ee261aa2b94fbef3425c1003fdf10", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:54.627182+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 73, "end": 78, "evidence": "A few weeks after the U.S. government began incarcerating undocumented migrants in the fragile Florida Everglades, Gov. Ron DeSantis held a news event some 57 miles from the facility, in beachy Marco Island, that went "}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:54.650478+00:00", "published_at_raw": "2026-01-31T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 22, "end": 26, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_666f5c27cec161e6e955", "record_id": "article_666f5c27cec161e6", "canonical_url": "https://news.mongabay.com/2026/01/peru-to-invest-7-6-billion-to-continue-critical-minerals-extraction", "publisher_url": "https://news.mongabay.com/2026/01/peru-to-invest-7-6-billion-to-continue-critical-minerals-extraction", "title_original": "Peru to invest $7.6 billion to continue critical minerals extraction", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-30T22:50:21+00:00", "source_text": "Peru plans to reinforce its mining sector this year with billions of dollars in investment across several ongoing projects, some of them with a history of environmental damage. The Ministry of Energy and Mines announced it will invest $7.6 billion to expand and improve mining operations that extract zinc, lead, tin, silver, copper and gold. […]", "text_kind": "source_excerpt", "text_characters": 346, "text_sha256": "559b6d6ad6fe4475fcb92be1d4c98d86f594b48d1c7ed87062b69c27ea9e2286", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:21.544652+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$7.6 billion", "start": 235, "end": 247, "evidence": " The Ministry of Energy and Mines announced it will invest $7.6 billion to expand and improve mining operations that extract zinc, lead, tin, silver, copper and gold.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 193, "end": 199, "evidence": "al ongoing projects, some of them with a history of environmental damage. The Ministry of Energy and Mines announced it will invest $7.6 billion to expand and improve mining operations that extract zinc, lead, tin, silver, copper and go"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:21.586915+00:00", "published_at_raw": "2026-01-30T22:50:21", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru", "start": 0, "end": 4, "matched_text": "Peru", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru", "start": 0, "end": 4, "matched_text": "Peru", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_de40eccfe09c4bb5ee49", "record_id": "article_de40eccfe09c4bb5", "canonical_url": "https://news.mongabay.com/2026/01/brazil-sets-out-its-strategy-for-nature", "publisher_url": "https://news.mongabay.com/2026/01/brazil-sets-out-its-strategy-for-nature", "title_original": "Brazil sets out its strategy for nature", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-28T23:49:11+00:00", "source_text": "Brazil is the world’s most biodiverse country, and the title is not closely contested in absolute numbers: between 10% and 15% of all known species live within its borders. The country contains nearly two-thirds of the Amazon rainforest and supplies about a tenth of the world’s food. That combination of ecological wealth and economic […]", "text_kind": "source_excerpt", "text_characters": 339, "text_sha256": "f773b7136112bcdb58c38bcb697e0cf54e09c50febc5a34d309b601c119f72fe", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:22.047251+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "10%", "start": 115, "end": 118, "evidence": "Brazil is the world’s most biodiverse country, and the title is not closely contested in absolute numbers: between 10% and 15% of all known species live within its borders.", "interpretation": "not_classified"}, {"value_text": "15%", "start": 123, "end": 126, "evidence": "Brazil is the world’s most biodiverse country, and the title is not closely contested in absolute numbers: between 10% and 15% of all known species live within its borders.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:22.088972+00:00", "published_at_raw": "2026-01-28T23:49:11", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 0, "end": 6, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 0, "end": 6, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_5a9e256ff5f7b22c79cb", "record_id": "article_5a9e256ff5f7b22c", "canonical_url": "https://insideclimatenews.org/news/28012026/trumps-choice-to-be-alabamas-next-senator-finds-an-odd-political-target-the-modern-gas-can", "publisher_url": "https://insideclimatenews.org/news/28012026/trumps-choice-to-be-alabamas-next-senator-finds-an-odd-political-target-the-modern-gas-can", "title_original": "Trump’s Choice to Be Alabama’s Next Senator Finds an Odd Political Target: the Modern Gas Can", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-28T09:45:00+00:00", "source_text": "ENTERPRISE, Ala.—U.S. Rep. Barry Moore, a longtime political figure in this rural Alabama community, has his priorities. Among them? A reform effort aimed at the modern gas can. A congressman since 2021, the Republican may be headed toward one of the most powerful positions in Yellowhammer State politics, a seat in the U.S. Senate, given […]", "text_kind": "source_excerpt", "text_characters": 343, "text_sha256": "6584399dbc5f41587da6f7e10281d5415a89ce2109301eca20ac80f4647b185b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:01.431207+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:01.491001+00:00", "published_at_raw": "2026-01-28T09:45:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 17, "end": 21, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_2b777cb359cc111de906", "record_id": "article_2b777cb359cc111d", "canonical_url": "https://dialogue.earth/en/business/can-zimbabwes-steel-ambitions-be-green-2", "publisher_url": "https://dialogue.earth/en/business/can-zimbabwes-steel-ambitions-be-green-2", "title_original": "Can Zimbabwe’s steel ambitions be green?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-27T16:51:18+00:00", "source_text": "Zimbabwe is poised to become Africa’s largest steel producer following USD 5 billion in investments from two Chinese multinationals. Tsingshan Holding Group announced its USD 800 million investment in August 2025 through subsidiary Dinson Iron and Steel Company (DISCO). The company already owns a large steel plant in Manhize, central Zimbabwe. The investment is expected to double the facility’s capacity from 600,000 to 1.2 million tonnes per year. The plant, which began operating in 2024, was the driving force behind Zimbabwe’s eye-watering 1,500% growth in steel production in the first eight months of 2025. While this appears to be good news for Zimbabwe’s struggling economy, there are concerns over the use of coal to power the country’s steel ambitions.", "text_kind": "article_excerpt", "text_characters": 765, "text_sha256": "00b53d26288d615089b3631ba3b6784871a4257a63dd391bf0d7d6a601f0f661", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:53.199805+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "5 billion", "start": 75, "end": 84, "evidence": "Zimbabwe is poised to become Africa’s largest steel producer following USD 5 billion in investments from two Chinese multinationals.", "interpretation": "not_classified"}, {"value_text": "800 million", "start": 175, "end": 186, "evidence": " Tsingshan Holding Group announced its USD 800 million investment in August 2025 through subsidiary Dinson Iron and Steel Company (DISCO).", "interpretation": "not_classified"}, {"value_text": "1.2 million", "start": 423, "end": 434, "evidence": " The investment is expected to double the facility’s capacity from 600,000 to 1.2 million tonnes per year.", "interpretation": "not_classified"}, {"value_text": "1,500%", "start": 547, "end": 553, "evidence": " The plant, which began operating in 2024, was the driving force behind Zimbabwe’s eye-watering 1,500% growth in steel production in the first eight months of 2025.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ZW", "alpha3": "ZWE", "name_zh": "津巴布韦", "name_en": "Zimbabwe"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 46, "end": 51, "evidence": "Zimbabwe is poised to become Africa’s largest steel producer following USD 5 billion in investments from two Chinese multinationals. Tsingshan Holding Group announced its USD 800 million inve"}], "policy_tools": [{"id": "subsidy", "label_zh": "补贴与激励", "label_en": "Subsidies and incentives", "start": 221, "end": 227, "evidence": ". Tsingshan Holding Group announced its USD 800 million investment in August 2025 through subsidiary Dinson Iron and Steel Company (DISCO). The company already owns a large steel plant in Manhize, central Zimbabwe. The investment is exp"}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ZW", "alpha3": "ZWE", "name_zh": "津巴布韦", "name_en": "Zimbabwe"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:53.234587+00:00", "published_at_raw": "2026-01-27T16:51:18", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ZW", "alpha3": "ZWE", "name_zh": "津巴布韦", "name_en": "Zimbabwe", "start": 4, "end": 12, "matched_text": "Zimbabwe", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ZW", "alpha3": "ZWE", "name_zh": "津巴布韦", "name_en": "Zimbabwe", "start": 0, "end": 8, "matched_text": "Zimbabwe", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 109, "end": 116, "matched_text": "Chinese", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_e03e5891be6dc5f1e624", "record_id": "article_e03e5891be6dc5f1", "canonical_url": "https://insideclimatenews.org/news/27012026/the-biggest-tragedy-of-trumps-gutting-of-the-national-park-service", "publisher_url": "https://insideclimatenews.org/news/27012026/the-biggest-tragedy-of-trumps-gutting-of-the-national-park-service", "title_original": "The ‘Biggest Tragedy’ of Trump’s Gutting of the National Park Service", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-27T10:15:00+00:00", "source_text": "PENDLETON, Ore.—With the second coming of Donald J. Trump, the first Native American director of the National Park Service packed up his belongings in Washington, D.C., and retreated here to the sagebrush outback of eastern Oregon. Charles F. Sams III, whose Native name is Mocking Bird with Big Heart and who spent three and a […]", "text_kind": "source_excerpt", "text_characters": 331, "text_sha256": "705f3bb31a3df3b4b403910044fea6ec919452238d5773648b944ab00638d21e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:01.737945+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:01.774124+00:00", "published_at_raw": "2026-01-27T10:15:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_ec980240d29bdf7600b7", "record_id": "article_ec980240d29bdf76", "canonical_url": "https://insideclimatenews.org/news/27012026/texas-grid-holds-up-during-winter-weather", "publisher_url": "https://insideclimatenews.org/news/27012026/texas-grid-holds-up-during-winter-weather", "title_original": "Texas’ Grid Holds Up During Winter Weather", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-27T09:45:00+00:00", "source_text": "In the eyes of many Texans, this weekend’s freezing weather was a test. How the state’s independent electric grid fared would demonstrate whether Texas grid operators and energy leaders had learned how to fortify it from winter weather and avoid the nightmare of Winter Storm Uri, when millions were left without power and hundreds died. […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "102e5b44e6e65e1d8e78d1dc914f183e812750a49456396396ac4191c0c7a58d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:01.895102+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 171, "end": 177, "evidence": "tate’s independent electric grid fared would demonstrate whether Texas grid operators and energy leaders had learned how to fortify it from winter weather and avoid the nightmare of Winter Storm Uri, when millions were left without powe"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:01.916159+00:00", "published_at_raw": "2026-01-27T09:45:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 5, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 146, "end": 151, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_0e119cbd974af3f7e457", "record_id": "article_0e119cbd974af3f7", "canonical_url": "https://insideclimatenews.org/news/27012026/alabama-quarry-noise-dust-court-injunction", "publisher_url": "https://insideclimatenews.org/news/27012026/alabama-quarry-noise-dust-court-injunction", "title_original": "‘Relief from the Nightmare’: Alabama Judge Halts Operations at a Quarry Residents Say Is Ruining Their Community", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-27T09:30:00+00:00", "source_text": "For Brad Vice and his family, the nightmare is over, at least for a while. Nine years ago, Vice and his wife, Brittney, moved into the rural, unincorporated Belle Mina community in north Alabama. The house was built by Brittney’s great-grandparents and the couple welcomed their first child there two years ago. But for the […]", "text_kind": "source_excerpt", "text_characters": 327, "text_sha256": "27910e84507b4d913d6c3bdd8346a8e815f6819db7710dc819287b9a4bafb252", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:01.944627+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:01.968885+00:00", "published_at_raw": "2026-01-27T09:30:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_335db7cc6ca2f3a79c1d", "record_id": "article_335db7cc6ca2f3a7", "canonical_url": "https://news.mongabay.com/2026/01/political-will-is-everything-interview-with-kenyan-environment-minister-deborah-barasa", "publisher_url": "https://news.mongabay.com/2026/01/political-will-is-everything-interview-with-kenyan-environment-minister-deborah-barasa", "title_original": "‘Political will is everything’: Interview with Kenyan Environment Minister Deborah Barasa", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-26T16:24:06+00:00", "source_text": "In 2022, when William Ruto was elected president of Kenya, he pledged that his government would plant 15 billion trees by 2032. Many observers saw it as a bold and ambitious promise — one that would require coordinated planning, reliable monitoring, sustained financing, and long-term stewardship on a massive scale. According to estimates from the […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "cebc4e4e1719f6d1d3173e1d3593b14383aca080da19302100a1e4154631cefe", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:30.144477+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "15 billion", "start": 102, "end": 112, "evidence": "In 2022, when William Ruto was elected president of Kenya, he pledged that his government would plant 15 billion trees by 2032.", "interpretation": "target_or_commitment"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:30.179099+00:00", "published_at_raw": "2026-01-26T16:24:06", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 52, "end": 57, "matched_text": "Kenya", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_9edbf1888f13cf12b13e", "record_id": "article_9edbf1888f13cf12", "canonical_url": "https://yaleclimateconnections.org/2026/01/earth-was-hit-by-55-billion-dollar-weather-disasters-in-2025", "publisher_url": "https://yaleclimateconnections.org/2026/01/earth-was-hit-by-55-billion-dollar-weather-disasters-in-2025", "title_original": "Earth was hit by 55 billion-dollar weather disasters in 2025", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-26T12:00:00+00:00", "source_text": "The planet was besieged by 55 billion-dollar weather disasters in 2025, insurance broker Gallagher Re said in its annual report issued Jan. 21. The total damage wrought by weather disasters in 2024 was $277 billion; 45% of those costs were covered by insurance. The 2025 damages were 25% lower than the 10-year inflation-adjusted average of $367 billion. A separate report issued Jan. 20 by insurance broker Aon put the total damage wrought by weather disasters in 2024 at $242 billion, with 47 billion-dollar weather disasters. Billion-dollar weather disasters cause about 76% of the total damages wrought by weather disasters, according to Steve Bowen of Gallagher Re. The primary reason for the below-average total cost in 2025 was the absence of a landfalling U.S.", "text_kind": "article_excerpt", "text_characters": 768, "text_sha256": "f7504b14f078c0f3871344e3c058c021802ff33687c5530de0fcc01b2964389e", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:34.116900+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "55 billion", "start": 27, "end": 37, "evidence": "The planet was besieged by 55 billion-dollar weather disasters in 2025, insurance broker Gallagher Re said in its annual report issued Jan.", "interpretation": "not_classified"}, {"value_text": "$277 billion", "start": 202, "end": 214, "evidence": " The total damage wrought by weather disasters in 2024 was $277 billion; 45% of those costs were covered by insurance.", "interpretation": "not_classified"}, {"value_text": "45%", "start": 216, "end": 219, "evidence": " The total damage wrought by weather disasters in 2024 was $277 billion; 45% of those costs were covered by insurance.", "interpretation": "not_classified"}, {"value_text": "25%", "start": 284, "end": 287, "evidence": " The 2025 damages were 25% lower than the 10-year inflation-adjusted average of $367 billion.", "interpretation": "not_classified"}, {"value_text": "$367 billion", "start": 341, "end": 353, "evidence": " The 2025 damages were 25% lower than the 10-year inflation-adjusted average of $367 billion.", "interpretation": "not_classified"}, {"value_text": "$242 billion", "start": 473, "end": 485, "evidence": " 20 by insurance broker Aon put the total damage wrought by weather disasters in 2024 at $242 billion, with 47 billion-dollar weather disasters.", "interpretation": "not_classified"}, {"value_text": "47 billion", "start": 492, "end": 502, "evidence": " 20 by insurance broker Aon put the total damage wrought by weather disasters in 2024 at $242 billion, with 47 billion-dollar weather disasters.", "interpretation": "not_classified"}, {"value_text": "76%", "start": 574, "end": 577, "evidence": " Billion-dollar weather disasters cause about 76% of the total damages wrought by weather disasters, according to Steve Bowen of Gallagher Re.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:34.150182+00:00", "published_at_raw": "2026-01-26T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 764, "end": 768, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_ea176bc9f8d35ad39c76", "record_id": "article_ea176bc9f8d35ad3", "canonical_url": "https://news.mongabay.com/2026/01/patagonia-fires-reignite-debate-over-argentinas-underfunded-environmental-agencies", "publisher_url": "https://news.mongabay.com/2026/01/patagonia-fires-reignite-debate-over-argentinas-underfunded-environmental-agencies", "title_original": "Patagonia fires reignite debate over Argentina’s underfunded environmental agencies", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-26T08:00:31+00:00", "source_text": "Fires have surged through the forests of Argentina’s Patagonia region since the start of the year, with officials still working to contain damage to some of the world’s oldest ecosystems. The two major fires broke out in January in the southern province of Chubut, threatening parts of Los Alerces National Park, a UNESCO World Heritage […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "9a79c6cad8f6662712f3603e497999be6d5b24204ceb19c0c4032a4af08763be", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:30.336774+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:30.376439+00:00", "published_at_raw": "2026-01-26T08:00:31", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina", "start": 37, "end": 46, "matched_text": "Argentina", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina", "start": 41, "end": 50, "matched_text": "Argentina", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_ff68d3c4cb8078cf9f82", "record_id": "article_ff68d3c4cb8078cf", "canonical_url": "https://insideclimatenews.org/news/22012026/canadas-mining-firms-are-big-beneficiaries-of-the-global-order-its-prime-minister-just-criticized", "publisher_url": "https://insideclimatenews.org/news/22012026/canadas-mining-firms-are-big-beneficiaries-of-the-global-order-its-prime-minister-just-criticized", "title_original": "Canada’s Mining Firms Are Big Beneficiaries of the Global Order Its Prime Minister Just Criticized", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-22T18:29:23+00:00", "source_text": "When Canadian Prime Minister Mark Carney delivered a pointed rebuke this week of Donald Trump and the global economic system Washington helped shape, he urged other nations to help build a new world order—one that, he said, “embodies our values, like respect for human rights, sustainable development, solidarity, sovereignty and the territorial integrity of states.” […]", "text_kind": "source_excerpt", "text_characters": 371, "text_sha256": "aa86db1b6dfa76d39560554ad535ccb93d145ede96eaddde61ba7a429aa1d626", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:02.923373+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:02.950972+00:00", "published_at_raw": "2026-01-22T18:29:23", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada", "start": 0, "end": 6, "matched_text": "Canada", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_e9c07228b4e72a5c4499", "record_id": "article_e9c07228b4e72a5c", "canonical_url": "https://news.mongabay.com/2026/01/indonesia-revokes-forest-and-mine-permits-over-role-in-deadly-sumatra-landslides", "publisher_url": "https://news.mongabay.com/2026/01/indonesia-revokes-forest-and-mine-permits-over-role-in-deadly-sumatra-landslides", "title_original": "Indonesia revokes forest and mine permits over role in deadly Sumatra landslides", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-22T01:38:30+00:00", "source_text": "JAKARTA — The Indonesian government has revoked the permits of 28 companies over environmental violations that authorities say exacerbated the deadly floods and landslides that struck the island of Sumatra in late 2025. The revocations follow an audit carried out by a government task force responsible for forest area enforcement after disasters triggered by Cyclone […]", "text_kind": "source_excerpt", "text_characters": 371, "text_sha256": "a83f74b583721b6fd15cf634009ffdb1ef99e1d35c9ec30f290905d41d5abf39", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:30.578122+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 150, "end": 155, "evidence": "of 28 companies over environmental violations that authorities say exacerbated the deadly floods and landslides that struck the island of Sumatra in late 2025. The revocations follow an audit carried out by a government task force resp"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:30.611750+00:00", "published_at_raw": "2026-01-22T01:38:30", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 0, "end": 9, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_0e68cb5b1b82a6813027", "record_id": "article_0e68cb5b1b82a681", "canonical_url": "https://news.mongabay.com/2026/01/earth-rover-program-seeks-to-track-the-worlds-soil-health", "publisher_url": "https://news.mongabay.com/2026/01/earth-rover-program-seeks-to-track-the-worlds-soil-health", "title_original": "Earth Rover Program seeks to track the world’s soil health", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-21T18:02:09+00:00", "source_text": "With a synchronized tap from run-of-the-mill hammers on metal plates resting on the ground, researchers kneeling in nine fields across four continents believe they’ve hit upon more than just the earth beneath their feet. “Waiting for it,” someone said. And then, “Waveforms!” “Excellent, waveforms!” another said, as the tiles on screen reveal EKG-like sets of […]", "text_kind": "source_excerpt", "text_characters": 364, "text_sha256": "4378cfa71d539a5226b02eb5d9575f169e00671d49bdecee864f1ede8370348e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:30.740852+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_colle