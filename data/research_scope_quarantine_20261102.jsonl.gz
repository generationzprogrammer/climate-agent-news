{"text_id": "text_6dc2b14a26b7302c3dbf", "record_id": "article_6dc2b14a26b7302c", "canonical_url": "https://insideclimatenews.org/news/15102026/texas-land-commissioner-big-bend-border-wall", "publisher_url": "https://insideclimatenews.org/news/15102026/texas-land-commissioner-big-bend-border-wall", "title_original": "Texas Land Commissioner Treads Carefully as Trump Border Wall Advances on State Property", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-15T08:55:00+00:00", "source_text": "Border wall construction in the Big Bend region puts Republican Texas Land Commissioner Dawn Buckingham in a bind: back President Donald Trump’s immigration agenda or respond to growing bipartisan opposition to the wall. The Texas General Land Office manages 13 million acres across the state, much of it in far West Texas. Among its holdings […]", "text_kind": "source_excerpt", "text_characters": 346, "text_sha256": "02a04dbfd6b79f5c8ee1eb9dd6a57d63b52ddd2b4035686180adf8b8f03b7b9a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:34.611233+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "13 million", "start": 259, "end": 269, "evidence": " The Texas General Land Office manages 13 million acres across the state, much of it in far West Texas.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:34.624592+00:00", "published_at_raw": "2026-10-15T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 5, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 64, "end": 69, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_978355495b39816da97e", "record_id": "article_978355495b39816d", "canonical_url": "https://news.mongabay.com/2026/10/belize-looks-to-the-deep-sea-to-complete-its-30-ocean-protection-pledge", "publisher_url": "https://news.mongabay.com/2026/10/belize-looks-to-the-deep-sea-to-complete-its-30-ocean-protection-pledge", "title_original": "Belize looks to the deep sea to complete its 30% ocean protection pledge", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-15T07:00:05+00:00", "source_text": "Belize is turning to its deep waters to fulfill its pledge to protect 30% of its ocean and achieve the sixth milestone of its Blue Bond agreement. A draft marine spatial plan submitted on Sept. 8 for government approval proposes closing the final gap to 30% by establishing three offshore marine protected areas (MPAs). Officials […]", "text_kind": "source_excerpt", "text_characters": 333, "text_sha256": "00c47dd43ddfe5d49a494609becd8e5c2aa1c443b1906842de073e5371e8ab50", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:33.015510+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "30%", "start": 70, "end": 73, "evidence": "Belize is turning to its deep waters to fulfill its pledge to protect 30% of its ocean and achieve the sixth milestone of its Blue Bond agreement.", "interpretation": "target_or_commitment"}, {"value_text": "30%", "start": 254, "end": 257, "evidence": " 8 for government approval proposes closing the final gap to 30% by establishing three offshore marine protected areas (MPAs).", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BZ", "alpha3": "BLZ", "name_zh": "伯利兹", "name_en": "Belize"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BZ", "alpha3": "BLZ", "name_zh": "伯利兹", "name_en": "Belize"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:33.033024+00:00", "published_at_raw": "2026-10-15T07:00:05", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BZ", "alpha3": "BLZ", "name_zh": "伯利兹", "name_en": "Belize", "start": 0, "end": 6, "matched_text": "Belize", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BZ", "alpha3": "BLZ", "name_zh": "伯利兹", "name_en": "Belize", "start": 0, "end": 6, "matched_text": "Belize", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_6245478260310989efa8", "record_id": "article_6245478260310989", "canonical_url": "https://insideclimatenews.org/news/14102026/hurricane-isaias-alabama-death", "publisher_url": "https://insideclimatenews.org/news/14102026/hurricane-isaias-alabama-death", "title_original": "Isaias Made It to Birmingham. The Consequences Were Deadly.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-14T22:02:21+00:00", "source_text": "BIRMINGHAM, Ala.—It’s hard to forget Uncle Bobo. And on this humid October day, his nephew says it’s hard to remember him, too. Devolin “Bobo” Webster, 66, died unexpectedly in his home Saturday morning as the remnants of Hurricane Isaias passed through the Magic City, more than 200 miles from where the category 2 storm made […]", "text_kind": "source_excerpt", "text_characters": 330, "text_sha256": "b9fe7e85cc82723fa0bfe27f959a68d268947483435eb9d9c27597692d55d7d7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:34.680245+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:34.695178+00:00", "publi