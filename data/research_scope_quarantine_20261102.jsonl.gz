{"text_id": "text_0487b53a2866ad05cb4e", "record_id": "article_0487b53a2866ad05", "canonical_url": "https://news.mongabay.com/2026/09/as-fires-spread-in-indonesia-bornean-orangutans-run-out-of-forest-to-flee", "publisher_url": "https://news.mongabay.com/2026/09/as-fires-spread-in-indonesia-bornean-orangutans-run-out-of-forest-to-flee", "title_original": "As fires spread in Indonesia, Bornean orangutans run out of forest to flee", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-23T05:21:56+00:00", "source_text": "JAKARTA — As fires continue to engulf large swaths of forest in Indonesian Borneo, orangutans have increasingly fewer places to flee, with fires either surrounding them or eliminating the forest on which they depend. Fires are spreading across a connected but heavily fragmented forest landscape and the habitat of critically endangered Bornean orangutans (Pongo pygmaeus) […]", "text_kind": "source_excerpt", "text_characters": 376, "text_sha256": "47801285765038824c85e0ab3182f195ab26ba444d22f54b28836e4169d8d35a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:46.533582+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:46.570455+00:00", "published_at_raw": "2026-09-23T05:21:56", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 19, "end": 28, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_d3a705981e7e8dc48aa4", "record_id": "article_d3a705981e7e8dc4", "canonical_url": "https://insideclimatenews.org/news/22092026/georgia-residents-sue-over-openai-data-center", "publisher_url": "https://insideclimatenews.org/news/22092026/georgia-residents-sue-over-openai-data-center", "title_original": "Georgia Residents Sue Over OpenAI Data Center", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-22T18:23:51+00:00", "source_text": "A $20 billion data center campus announced in July near Rincon, Georgia, is now facing its second lawsuit from Effingham County residents and environmental advocates. OpenAI, best known for creating ChatGPT, is planning a massive campus that would include about 4.4 million square feet of data-center space 30 miles northwest of Savannah. The project, known […]", "text_kind": "source_excerpt", "text_characters": 361, "text_sha256": "4710b0803bff074e8c04e575ab25b2ef79bbe8e2e08fe7e8865a23ae8cd520f0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:50.403709+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$20 billion", "start": 2, "end": 13, "evidence": "A $20 billion data center campus announced in July near Rincon, Georgia, is now facing its second lawsuit from Effingham County residents and environmental advocates.", "interpretation": "not_classified"}, {"value_text": "4.4 million", "start": 262, "end": 273, "evidence": " OpenAI, best known for creating ChatGPT, is planning a massive campus that would include about 4.4 million square feet of data-center space 30 miles northwest of Savannah.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:50.437201+00:00", "published_at_raw": "2026-09-22T18:23:51", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_71b03250ed5f9720d180", "record_id": "article_71b03250ed5f9720", "canonical_url": "https://yaleclimateconnections.org/2026/09/un-huracan-de-categoria-5-podria-azotar-esta-semana-la-costa-del-pacifico-de-mexico", "publisher_url": "https://yaleclimateconnections.org/2026/09/un-huracan-de-categoria-5-podria-azotar-esta-semana-la-costa-del-pacifico-de-mexico", "title_original": "El poderoso huracán Polo alcanza la categoría 5 cerca de México", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-21T20:32:00+00:00", "source_text": "[Read in English here] Actualización: A las 6 a. m. CST del martes (7 a. m. EDT del martes) : Polo continuó intensificándose rápidamente durante la noche y, a las 6 a. m., hora del centro, el Centro Nacional de Huracanes anunció oficialmente que Polo había alcanzado la categoría 5, con vientos máximos sostenidos de 160 mph, o 260 km/h . Esto convierte oficialmente a Polo en el* tercer huracán de categoría 5 de la temporada . Solo ha habido otras tres temporadas con tres huracanes de categoría 5 en el Pacífico oriental o central: 1994, 2002 y 2018. La tormenta se desplaza lentamente frente a las costas de México y se espera que continúe avanzando despacio, a unos 5 mph, o 10 km/h, durante los próximos dos días.", "text_kind": "article_excerpt", "text_characters": 719, "text_sha256": "f65c74e7351cff1af5f59c7dd4df9ff1ccf0a12d51f48e5ff7f386adbcc6b7a8", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:29.223590+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:29.258421+00:00", "published_at_raw": "2026-09-21T20:32:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_6a58a57b3320523b7724", "record_id": "article_6a58a57b3320523b", "canonical_url": "https://yaleclimateconnections.org/2026/09/a-category-5-hurricane-could-be-raging-off-mexicos-pacific-coast-this-week", "publisher_url": "https://yaleclimateconnections.org/2026/09/a-category-5-hurricane-could-be-raging-off-mexicos-pacific-coast-this-week", "title_original": "Powerful Hurricane Polo reaches Category 5 status near Mexico", "title_zh": "本周墨西哥太平洋海岸外海可能正肆虐着一场五级飓风", "title_en": null, "summary_zh": "由于当前强烈的厄尔尼诺现象，大西洋和太平洋飓风季的对比本周将更加鲜明。大西洋上的热带风暴法伊正在减弱，而墨西哥里维拉以南温热海水上的飓风波洛正快速增强，预计将在周中接近或超过五级飓风标准，并逼近墨西哥海岸。受人为气候变化影响，海水表面温度创下或接近历史纪录。", "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-21T19:35:39+00:00", "source_text": "[Lee esta nota en español aquí] Update : As of 6 a.m. CST Tuesday (7 a.m. EDT Tuesday) : Polo continued to intensify rapidly overnight, and as of 6 AM Central Time, the National Hurricane Center officially announced that Polo had reached Category 5 status, with maximum sustained winds of 160 mph, or 260 km/h . This officially makes Polo the third Category 5 hurricane of the season . There have only been three other seasons with three Category 5 hurricanes across the eastern or central Pacific: 1994, 2002, and 2018 . The storm is moving slowly off the coast of Mexico, and it should continue moving slowly at about 5 mph, or 10 km/h, during the next couple of days. A Tropical Storm Watch is in effect from Tecpan de Galeana to Manzanillo, Mexico.", "text_kind": "article_excerpt", "text_characters": 752, "text_sha256": "a4df0b9efedac14b7baf78364b3160c8062eb0ae94490655e68efd3db70c4fc8", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:29.287453+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:29.323460+00:00", "published_at_raw": "2026-09-21T19:35:39", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 55, "end": 61, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 566, "end": 572, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_3815b5559039a4921ef1", "record_id": "article_3815b5559039a492", "canonical_url": "https://news.mongabay.com/2026/09/indias-tiger-success-brings-a-new-challenge-living-alongside-the-big-cats", "publisher_url": "https://news.mongabay.com/2026/09/indias-tiger-success-brings-a-new-challenge-living-alongside-the-big-cats", "title_original": "India’s tiger success brings a new challenge: Living alongside the big cats", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-17T14:43:11+00:00", "source_text": "Forty-five-year-old Mahadeva Gowda was tending to his cotton farm in the village of Badagalapura in the southern Indian state of Karnataka when a tiger lunged at him from behind. He was caught unaware: He says he wasn’t aware that the forest department was trying to capture a tiger roaming through the area. Before he realized […]", "text_kind": "source_excerpt", "text_characters": 331, "text_sha256": "ad1b663518e12d0bd4367cf9a4dda7e46fb4ec02ef6193853a651a5e8d2b991c", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:47.316996+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:47.344821+00:00", "published_at_raw": "2026-09-17T14:43:11", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 0, "end": 5, "matched_text": "India", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_462081d769bbdb54dae7", "record_id": "article_462081d769bbdb54", "canonical_url": "https://insideclimatenews.org/news/17092026/florida-springs-cleanup-plan-settlement", "publisher_url": "https://insideclimatenews.org/news/17092026/florida-springs-cleanup-plan-settlement", "title_original": "Nine Florida Springs Will Get New Cleanup Plans Under Legal Settlement", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-17T08:50:00+00:00", "source_text": "Under a recent legal settlement, Florida will have to adopt new plans for addressing pollution in nine of the hundreds of freshwater springs in the state that constitute one of the largest concentrations of springs in the world. The agreement between environmental groups and the state Department of Environmental Protection, announced earlier this month, applies […]", "text_kind": "source_excerpt", "text_characters": 367, "text_sha256": "e4365437f07d64bd2a116bb1a9398b1d9285ddc2d5ecbbd98ac448c3c11daddc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:52.060601+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:52.102560+00:00", "published_at_raw": "2026-09-17T08:50:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_fba37d5e71d8db458a61", "record_id": "article_fba37d5e71d8db45", "canonical_url": "https://news.mongabay.com/2026/09/dhakas-waste-to-energy-project-faces-opposition-from-pollution-weary-residents", "publisher_url": "https://news.mongabay.com/2026/09/dhakas-waste-to-energy-project-faces-opposition-from-pollution-weary-residents", "title_original": "Dhaka’s waste-to-energy project faces opposition from pollution-weary residents", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-09-15T16:30:44+00:00", "source_text": "At 40 years old, Yeasmin Begum has lived near the Amin Bazar landfill on the outskirts of Dhaka her whole life. She says the stench often triggers allergies, including colds and coughing. “Sometimes it is quite difficult for us to breathe when waste collectors burn the waste under the open sky. Smoke and ashes envelop […]", "text_kind": "source_excerpt", "text_characters": 323, "text_sha256": "c3e500807cc6f9dbe8c200dc9b6a5d3fd7c94250890a4ae6c56f7bdd37145c47", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:47.749601+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/