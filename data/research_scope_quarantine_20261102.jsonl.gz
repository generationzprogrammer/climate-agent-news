{"text_id": "text_d417deac12d00d75cb28", "record_id": "article_d417deac12d00d75", "canonical_url": "https://insideclimatenews.org/news/30032026/fema-skips-national-hurricane-conference", "publisher_url": "https://insideclimatenews.org/news/30032026/fema-skips-national-hurricane-conference", "title_original": "FEMA Skips National Hurricane Conference Amid DHS Shutdown", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-30T22:41:58+00:00", "source_text": "ORLANDO, Fla.—A major conference to help communities prepare for hurricane season kicked off Monday without the agency that coordinates federal disaster response. Federal Emergency Management Agency representatives attributed their absence at the National Hurricane Conference to the partial government shutdown. The conference is one of the largest aimed at helping communities prepare for the Atlantic […]", "text_kind": "source_excerpt", "text_characters": 407, "text_sha256": "075d2146b29d8bf747b951583ad13411ed69c2d6a229e06a55acc5a40afc9dce", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:15.888101+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimaten