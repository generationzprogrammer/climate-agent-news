{"text_id": "text_432fd23ca3c093f380cb", "record_id": "article_432fd23ca3c093f3", "canonical_url": "https://insideclimatenews.org/news/14052025/trump-administration-water-pfas-toxic-chemicals-standards", "publisher_url": "https://insideclimatenews.org/news/14052025/trump-administration-water-pfas-toxic-chemicals-standards", "title_original": "The Trump Administration Plans to Undo Standards on Toxic ‘Forever Chemicals’ in the U.S. Drinking Water Supply", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-14T23:57:29+00:00", "source_text": "The Trump administration on Wednesday announced plans to rescind and postpone rules limiting “forever chemicals” in drinking water that were enacted under the Biden administration and designed to prevent millions of people from exposure to these persistent and dangerous contaminants. Lee Zeldin, the administrator of the Environmental Protection Agency, said the agency plans to issue […]", "text_kind": "source_excerpt", "text_characters": 389, "text_sha256": "bc4100beda48ce77b01f1ee5f22d643f00d74691f8c116c508a859d7b7e28359", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:57.361569+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:57.392915+00:00", "published_at_raw": "2025-05-14T23:57:29", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 85, "end": 89, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_5af40188f94a2ae4c1dd", "record_id": "article_5af40188f94a2ae4", "canonical_url": "https://yaleclimateconnections.org/2025/05/reality-check-there-was-plenty-of-water-in-socal-reservoirs-during-the-la-fires", "publisher_url": "https://yaleclimateconnections.org/2025/05/reality-check-there-was-plenty-of-water-in-socal-reservoirs-during-the-la-fires", "title_original": "Reality check: There was plenty of water in SoCal reservoirs during the LA fires", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-14T11:00:00+00:00", "source_text": "Transcript: In January, devastating wildfires destroyed more than 10,000 homes in Los Angeles. Firefighters struggled to battle the blazes – and in some areas, fire hydrants ran dry. Rumors and misinformation swirled online. Then president-elect Trump claimed that water was being withheld in northern California. But Peter Gleick , cofounder of the nonprofit Pacific Institute , says that the L.A. region did not need more water. Gleick: “There was plenty of water in reservoirs in Southern California. The reservoirs were actually relatively full for this time of year.” But the fires were so large and powerful that the city’s water pipes, storage tanks, and fire hydrants could not keep up with the unprecedented needs of firefighters.", "text_kind": "article_excerpt", "text_characters": 739, "text_sha256": "2b8ae070a37a3fbfe6a5f712c83c89263816a5b689e9306a2727e23c1fcc5e1c", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:57.542101+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 36, "end": 44, "evidence": "Transcript: In January, devastating wildfires destroyed more than 10,000 homes in Los Angeles. Firefighters struggled to battle the blazes – and in some areas, fire hydrants ran dry. R"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:57.574542+00:00", "published_at_raw": "2025-05-14T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 302, "end": 312, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_42719646b8153b43f054", "record_id": "article_42719646b8153b43", "canonical_url": "https://news.mongabay.com/2025/05/why-whos-pandemic-prevention-draft-agreement-takes-a-nature-centric-one-health-approach-commentary", "publisher_url": "https://news.mongabay.com/2025/05/why-whos-pandemic-prevention-draft-agreement-takes-a-nature-centric-one-health-approach-commentary", "title_original": "Why WHO’s pandemic prevention draft agreement takes a nature-centric, One Health approach (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-13T17:56:46+00:00", "source_text": "At 4 a.m. CET on April 16, 2025, in Geneva, after years of negotiation and a final day of intense deliberation, the World Health Organization’s Intergovernmental Negotiating Body reached consensus on a Draft Pandemic Agreement. This historic agreement lays the groundwork for how the world will prevent, prepare for, and respond to future pandemics. More […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "7f332d4dd4d5a5eaf2db16d5fe50c5095640a2a0f1b4b220c1aa535daad20f24", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:16.427598+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:16.446490+00:00", "published_at_raw": "2025-05-13T17:56:46", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_24b08c5791ab57228a95", "record_id": "article_24b08c5791ab5722", "canonical_url": "https://insideclimatenews.org/news/13052025/texas-rio-grande-pecos-river-fracking", "publisher_url": "https://insideclimatenews.org/news/13052025/texas-rio-grande-pecos-river-fracking", "title_original": "Texas Oil and Gas Companies Drill With River Water During Extreme Drought", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-13T09:00:00+00:00", "source_text": "PECOS, Texas—Extreme drought has diminished the flows of the Rio Grande and Pecos River, two of the most iconic waterways in Texas. The advocacy group American Rivers recently named the Lower Rio Grande one of its most endangered rivers, describing a “near-permanent human-induced megadrought threatening all life that depends on it.” On the Pecos River, […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "a8279c195af402c2f1484323e10a396659bffb4893f6d251ab49a5a1b8849be2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:57.815959+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 21, "end": 28, "evidence": "PECOS, Texas—Extreme drought has diminished the flows of the Rio Grande and Pecos River, two of the most iconic waterways in Texas. The advocacy group American Rivers r"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:57.832946+00:00", "published_at_raw": "2025-05-13T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 5, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 7, "end": 12, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_1ed869159f9bc15c3283", "record_id": "article_1ed869159f9bc15c", "canonical_url": "https://insideclimatenews.org/news/13052025/southwest-swamp-coolers-affected-by-high-temperatures", "publisher_url": "https://insideclimatenews.org/news/13052025/southwest-swamp-coolers-affected-by-high-temperatures", "title_original": "Swamp Coolers’ Ability to Beat the Heat is Evaporating in Record Southwestern Temperatures", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-13T08:55:00+00:00", "source_text": "“I just couldn’t think straight,” Albuquerque resident Becky Wood said, describing what it felt like attempting to get work done in an 85-degree house during the city’s hottest summer days. “I would find myself sitting on the couch, wanting to take a nap. I felt like I had brain fog, but it was just like […]", "text_kind": "source_excerpt", "text_characters": 309, "text_sha256": "0e68afe1b95e6ca29b716c4dea80a3a8e8eb5de4d0b3a1ab122e2e4a0b3e6988", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:57.863761+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_c