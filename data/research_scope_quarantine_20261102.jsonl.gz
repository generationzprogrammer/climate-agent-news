{"text_id": "text_f85a90111951f643d8ec", "record_id": "article_f85a90111951f643", "canonical_url": "https://news.mongabay.com/2025/04/bolivian-communities-push-back-against-foreign-backed-lithium-projects", "publisher_url": "https://news.mongabay.com/2025/04/bolivian-communities-push-back-against-foreign-backed-lithium-projects", "title_original": "Bolivian communities push back against foreign-backed lithium projects", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-17T12:00:05+00:00", "source_text": "Dionicio Colque, 42, has fond memories of growing up on the edge of Salar de Uyuni in Bolivia. It’s the world’s largest salt flat, spanning about 10,500 square kilometers (4,050 square miles). His family farmed potatoes on the outskirts of Colcha K, a community of around 1,000 residents in Nor Lípez province. But in around […]", "text_kind": "source_excerpt", "text_characters": 328, "text_sha256": "bb18a4ca299b6f2aa1cf1428f618411647a3a95f1436cebbf01fd44a95591a91", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:35.646731+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BO", "alpha3": "BOL", "name_zh": "玻利维亚", "name_en": "Bolivia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BO", "alpha3": "BOL", "name_zh": "玻利维亚", "name_en": "Bolivia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:35.664275+00:00", "published_at_raw": "2025-04-17T12:00:05", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BO", "alpha3": "BOL", "name_zh": "玻利维亚", "name_en": "Bolivia", "start": 86, "end": 93, "matched_text": "Bolivia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_6a9c187cbfcbfebfaa6e", "record_id": "article_6a9c187cbfcbfebf", "canonical_url": "https://insideclimatenews.org/news/16042025/north-carolina-pfas-in-sewage-sludge-dairy-farm", "publisher_url": "https://insideclimatenews.org/news/16042025/north-carolina-pfas-in-sewage-sludge-dairy-farm", "title_original": "EPA Weighs N.C. Environmental Harms From Sewage Sludge Used as Fertilizer", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-16T08:55:00+00:00", "source_text": "WINSTON-SALEM, N.C.—Perhaps it was rain dripping through one of the many holes in the roof that condensed the ammonium nitrate into a potentially explosive cake. Or maybe it was an electrical short, like the one that had occurred a month earlier, igniting a pile of fertilizer. Regardless of the cause, on the evening of Jan. […]", "text_kind": "source_excerpt", "text_characters": 329, "text_sha256": "a808b89b8db4173f7d9555be183426f58a79ee0bd3d75a864f56ddf64097d6c6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:21.296939+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_