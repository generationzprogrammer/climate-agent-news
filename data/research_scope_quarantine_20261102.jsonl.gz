{"text_id": "text_8ffbaedeb8b3e912e399", "record_id": "article_8ffbaedeb8b3e912", "canonical_url": "https://insideclimatenews.org/news/18042025/judge-orders-florida-to-address-pollution-that-led-to-manatee-deaths", "publisher_url": "https://insideclimatenews.org/news/18042025/judge-orders-florida-to-address-pollution-that-led-to-manatee-deaths", "title_original": "Federal Judge Orders Florida to Address Pollution That Led to Manatee Deaths", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-18T08:55:00+00:00", "source_text": "The state of Florida is in violation of the Endangered Species Act and must develop a plan for addressing the pollution that led in recent years to an unprecedented die-off of manatees, a federal judge has ruled. The litigation is centered on state wastewater discharge regulations that have failed to control nutrient pollution in the […]", "text_kind": "source_excerpt", "text_characters": 339, "text_sha256": "3caaf9a4762fc520eedd66ff930afb58c7d7e76500fb8d0d5768bb96dd298dfe", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:13.369231+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "standards", "label_zh": "标准与监管", "label_en": "Standards and regulation", "start": 270, "end": 280, "evidence": "tees, a federal judge has ruled. The litigation is centered on state wastewater discharge regul