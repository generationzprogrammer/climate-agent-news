{"text_id": "text_71f57fbbcd645e8fd2ed", "record_id": "article_71f57fbbcd645e8f", "canonical_url": "https://insideclimatenews.org/news/18112025/alabama-city-council-approves-rezoning-for-massive-data-center", "publisher_url": "https://insideclimatenews.org/news/18112025/alabama-city-council-approves-rezoning-for-massive-data-center", "title_original": "An Alabama City Council Approves Rezoning for a Massive Data Center, Dividing a Community", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-19T00:20:14+00:00", "source_text": "BESSEMER, Ala.—Cleo King prays about every vote he casts on behalf of the people he represents in this city of 25,000 just southwest of Birmingham. And on Tuesday, King said those prayers led him to vote against rezoning hundreds of acres of forested land at the city’s edge to make way for a 4.5 million […]", "text_kind": "source_excerpt", "text_characters": 308, "text_sha256": "722e1acc41c7aeb325fa5f63e888cfff27f84a99633c5415d505712533f61968", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:44.074152+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "4.5 million", "start": 293, "end": 304, "evidence": " And on Tuesday, King said those prayers led him to vote against rezoning hundreds of acres of forested land at the city’s edge to make way for a 4.5 million […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:44.102092+00:00", "published_at_raw": "2025-11-19T00:20:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_6ceff8679e9a91a87035", "record_id": "article_6ceff8679e9a91a8", "canonical_url": "https://news.mongabay.com/2025/11/construction-of-totalenergies-pipeline-cuts-through-coral-reefs-in-mozambique", "publisher_url": "https://news.mongabay.com/2025/11/construction-of-totalenergies-pipeline-cuts-through-coral-reefs-in-mozambique", "title_original": "Construction of TotalEnergies pipeline cuts through coral reefs in Mozambique", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-18T15:20:32+00:00", "source_text": "Over the past year, a dredger operated by Dutch company Van Oord cut through a coral reef off the coast of northern Mozambique, part of the construction of French oil and gas giant TotalEnergies’ troubled liquefied natural gas project in Cabo Delgado. Data scientists analyzing satellite imagery and vessel data have found that a massive […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "5a6b41e9f80365c899c1fa33e195dfedb3638f89685b707b98ea890ef44f5817", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:11.103189+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MZ", "alpha3": "MOZ", "name_zh": "莫桑比克", "name_en": "Mozambique"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MZ", "alpha3": "MOZ", "name_zh": "莫桑比克", "name_en": "Mozambique"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:11.118172+00:00", "published_at_raw": "2025-11-18T15:20:32", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MZ", "alpha3": "MOZ", "name_zh": "莫桑比克", "name_en": "Mozambique", "start": 67, "end": 77, "matched_text": "Mozambique", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "MZ", "alpha3": "MOZ", "name_zh": "莫桑比克", "name_en": "Mozambique", "start": 116, "end": 126, "matched_text": "Mozambique", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_1b05ff0fa579b1030362", "record_id": "article_1b05ff0fa579b103", "canonical_url": "https://news.mongabay.com/2025/11/plans-to-dispose-of-mining-waste-in-norways-arctic-ocean-worries-sami-fishers-herders", "publisher_url": "https://news.mongabay.com/2025/11/plans-to-dispose-of-mining-waste-in-norways-arctic-ocean-worries-sami-fishers-herders", "title_original": "Plans to dispose of mining waste in Norway’s Arctic Ocean worries Sámi fishers, herders", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-18T02:29:24+00:00", "source_text": "The Norwegian government has granted permission for the construction and operation of the Nussir copper mine in Hammerfest, a municipality on the northwestern coast of the island of Kvaløya, in Norway. The company plans to pipe between 1 million and 2 million metric tons of mining waste, or tailings, annually to the bottom of Repparfjord, […]", "text_kind": "source_excerpt", "text_characters": 344, "text_sha256": "83f3a981bbecc1f7402ef3481868ba6c0abe52b6e9338c63b92d07f695a21338", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:17.226025+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "1 million", "start": 236, "end": 245, "evidence": " The company plans to pipe between 1 million and 2 million metric tons of mining waste, or tailings, annually to the bottom of Repparfjord, […]", "interpretation": "not_classified"}, {"value_text": "2 million", "start": 250, "end": 259, "evidence": " The company plans to pipe between 1 million and 2 million metric tons of mining waste, or tailings, annually to the bottom of Repparfjord, […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway"}], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 29, "end": 34, "evidence": "The Norwegian government has granted permission for the construction and operation of the Nussir copper mine in Hammerfest, a municipality on the northwestern coast of the is"}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:17.291676+00:00", "published_at_raw": "2025-11-18T02:29:24", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway", "start": 36, "end": 42, "matched_text": "Norway", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway", "start": 194, "end": 200, "matched_text": "Norway", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_991ad200e4e4c8dafea2", "record_id": "article_991ad200e4e4c8da", "canonical_url": "https://www.carbonbrief.org/cop30-carbon-briefs-second-ask-us-anything-webinar", "publisher_url": "https://www.carbonbrief.org/cop30-carbon-briefs-second-ask-us-anything-webinar", "title_original": "Webinar: Carbon Brief’s second ‘ask us anything’ at COP30", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-17T17:06:51+00:00", "source_text": "Print article Share As COP30 reaches its midway point in the Brazilian city of Belém, Carbon Brief has hosted its second “ask us anything” webinar to exclusively answer questions submitted by holders of the Insider Pass . The webinar kicked off with an overview of where the negotiations are on Day 8, plus what it was like to be among the 70,000 -strong “people’s march” on Saturday. At present, there are 44 agreed texts at COP30, with many negotiating streams remaining highly contested, as shown by Carbon Brief’s live text tracker . Topics discussed during the webinar included the potential of a “cover text” at COP30, plus updates on negotiations such as the global goal on adaptation and the just-transition work programme.", "text_kind": "article_excerpt", "text_characters": 731, "text_sha256": "f8f91f8ccd415a184bfbd3b6644600c1b9fdf8cd8885f0cbc1ea6e414c9f9570", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:57.819136+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": ["COP30"], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "adaptation", "label_zh": "适应与韧性", "label_en": "Adaptation and resilience", "start": 681, "end": 691, "evidence": "ntial of a “cover text” at COP30, plus updates on negotiations such as the global goal on adaptation and the just-transition work programme."}], "policy_tools": [], "policy_stages": [], "track": "negotiations", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:57.840564+00:00", "published_at_raw": "2025-11-17T17:06:51", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_ad644383466760be2f51", "record_id": "article_ad644383466760be", "canonical_url": "https://insideclimatenews.org/news/14112025/australian-company-bhp-found-liable-for-damages-in-one-of-brazils-worst-mining-disasters", "publisher_url": "https://insideclimatenews.org/news/14112025/australian-company-bhp-found-liable-for-damages-in-one-of-brazils-worst-mining-disasters", "title_original": "Australian Company BHP Found Liable for Damages in One of Brazil’s Worst Mining Disasters", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-15T01:55:00+00:00", "source_text": "In 2015, a mine tailings dam failed near the town of Bento Rodrigues, in the Brazilian state of Minas Gerais. The collapse spilled about 40 million cubic meters of iron ore mining waste into the landscape, burying villages under mud, killing 19 people and polluting thousands of streams along the River Doce. One year ago, […]", "text_kind": "source_excerpt", "text_characters": 326, "text_sha256": "dce1453987aba366e73fd96dab45c7d3c784914606f8489c889edff35c564d2e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:46.049432+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "40 million", "start": 137, "end": 147, "evidence": " The collapse spilled about 40 million cubic meters of iron ore mining waste into the landscape, burying villages under mud, killing 19 people and polluting thousands of streams along the River Doce.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:46.117497+00:00", "published_at_raw": "2025-11-15T01:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 58, "end": 64, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_78c5cb8d5f994ce6eca3", "record_id": "article_78c5cb8d5f994ce6", "canonical_url": "https://insideclimatenews.org/news/13112025/proposed-alabama-data-center-clashes-with-northern-beltline-birmingham-darter", "publisher_url": "https://insideclimatenews.org/news/13112025/proposed-alabama-data-center-clashes-with-northern-beltline-birmingham-darter", "title_original": "A Proposed Alabama Data Center Faces New Hurdles: A ‘Road to Nowhere’ and the Birmingham Darter", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-13T23:55:59+00:00", "source_text": "BESSEMER, Ala.—When Yale biologist Thomas Near and members of his research team visited the Yellowhammer State in October, the state’s famous Dreamland BBQ wasn’t the only thing on the agenda, though it was high on the list. During their trip, the researchers documented the existence of the Birmingham darter, a newly identified fish species, just […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "6ddf101f65173dbdd27e3e67c834c4668de8d5cc804e1f663e722ebf4eaef53a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:46.577380+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:46.637083+00:00", "published_at_raw": "2025-11-13T23:55:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_872ee344f9a0dd642b14", "record_id": "article_872ee344f9a0dd64", "canonical_url": "https://insideclimatenews.org/news/13112025/andrea-crosta-earth-league-international-fight-to-stop-totoaba-illegal-trade", "publisher_url": "https://insideclimatenews.org/news/13112025/andrea-crosta-earth-league-international-fight-to-stop-totoaba-illegal-trade", "title_original": "Inside the Fight to Stop the Illegal Trade Driving the Vaquita Porpoise Toward Extinction", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-13T09:55:00+00:00", "source_text": "In Mexico’s Upper Gulf of California, a lucrative and deadly wildlife trade continues to threaten the survival of the world’s most endangered marine mammal—the vaquita porpoise. At the center of this crisis is the totoaba, a large, endangered fish whose swim bladder is prized in traditional Chinese medicine for its purported health benefits. Some of […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "e7f829ae09f22b31aca5407acdae21160882e2a68a42011a8816f0fcc342a190", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:47.004199+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:47.041999+00:00", "published_at_raw": "2025-11-13T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 3, "end": 9, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 26, "end": 36, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 292, "end": 299, "matched_text": "Chinese", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_596e0d1146b6c183c48a", "record_id": "article_596e0d1146b6c183", "canonical_url": "https://news.mongabay.com/2025/11/in-the-amazon-political-systems-fail-to-prioritize-the-environment", "publisher_url": "https://news.mongabay.com/2025/11/in-the-amazon-political-systems-fail-to-prioritize-the-environment", "title_original": "In the Amazon, political systems fail to prioritize the environment", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-12T12:00:48+00:00", "source_text": "Realizing the goals of sustainable development and environmental conservation in the Pan Amazon will require profound changes in the region’s legal and economic framework. This type of change can only be obtained via the political process. Fortunately, there is broad support within Amazonian nations for a change in the policies that drive deforestation and unsustainable […]", "text_kind": "source_excerpt", "text_characters": 376, "text_sha256": "b0d0230ddae4f90d8dab700caf78a4a9eda36bdaabf451638d8ccb5e0609ad87", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:19.904912+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:19.998639+00:00", "published_at_raw": "2025-11-12T12:00:48", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_ec92c0db16b54018ce5d", "record_id": "article_ec92c0db16b54018", "canonical_url": "https://insideclimatenews.org/news/11112025/sable-offshore-oil-drilling-california", "publisher_url": "https://insideclimatenews.org/news/11112025/sable-offshore-oil-drilling-california", "title_original": "An Oil Company Running Into Rough Waters off the California Coast Is Looking to Trump for Help", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-11T23:39:41+00:00", "source_text": "President Donald Trump may announce his plan to open California waters to oil drilling as soon as this week. The move, if it goes through, could bring about the first federal oil lease sales in the Pacific Ocean since 1984. But for one company trying to restart production at a set of wells under an […]", "text_kind": "source_excerpt", "text_characters": 303, "text_sha256": "ae23f9df1b250489521bbcddefb65d0ef6aa78ee825415fcba52ff379537dca6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:47.721680+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:47.757766+00:00", "published_at_raw": "2025-11-11T23:39:41", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 49, "end": 59, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 53, "end": 63, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_07275eebc0479d83da3f", "record_id": "article_07275eebc0479d83", "canonical_url": "https://news.mongabay.com/2025/11/turning-outdoor-exploration-into-environmental-discovery-gregg-treinish-and-the-rise-of-adventure-scientists", "publisher_url": "https://news.mongabay.com/2025/11/turning-outdoor-exploration-into-environmental-discovery-gregg-treinish-and-the-rise-of-adventure-scientists", "title_original": "Turning outdoor exploration into environmental discovery: Gregg Treinish and the rise of Adventure Scientists", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-11T22:25:03+00:00", "source_text": "Some revolutions begin not with technology, but with a feeling. For Gregg Treinish, that feeling was guilt. He was spending years on long wilderness expeditions—crossing ranges, sleeping rough, watching the world’s edges—and began to wonder what any of it added up to. “I was spending years in the wilderness, doing long expeditions, and I began […]", "text_kind": "source_excerpt", "text_characters": 349, "text_sha256": "1162fec76f5e2efc6bdff3047979768762c9a95e14202fdc6d0cd48b4dcbb5b0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:20.702334+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:20.767101+00:00", "published_at_raw": "2025-11-11T22:25:03", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_548cdffd1840aa69f6ce", "record_id": "article_548cdffd1840aa69", "canonical_url": "https://news.mongabay.com/2025/11/how-a-green-gold-rush-in-the-amazon-led-to-dubious-carbon-deals-on-indigenous-lands", "publisher_url": "https://news.mongabay.com/2025/11/how-a-green-gold-rush-in-the-amazon-led-to-dubious-carbon-deals-on-indigenous-lands", "title_original": "How a ‘green gold rush’ in the Amazon led to dubious carbon deals on Indigenous lands", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-11T19:06:47+00:00", "source_text": "BARCELONA — In December 2022, one of Brazil’s largest Indigenous territories and one of the smallest would each sign a 118-page, 10-year contract they would soon come to regret —as would faraway investors looking to capitalize on the billion-dollar carbon and biodiversity markets. In Brazil’s lush westernmost states of Amazonas and Acre, which border Peru, […]", "text_kind": "source_excerpt", "text_characters": 362, "text_sha256": "237c7b33d97010e5c388faaf92e7b0b71704bd709fc38469a7df6c70377bcf6f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:21.016491+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 54, "end": 64, "evidence": "BARCELONA — In December 2022, one of Brazil’s largest Indigenous territories and one of the smallest would each sign a 118-page, 10-year contract they would soon come to regret —as would faraway investors"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:21.116029+00:00", "published_at_raw": "2025-11-11T19:06:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 37, "end": 43, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru", "start": 353, "end": 357, "matched_text": "Peru", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_a447688ac373111f72e3", "record_id": "article_a447688ac373111f", "canonical_url": "https://news.mongabay.com/2025/11/sierra-leone-communities-sign-carbon-agreement-based-on-carbon-justice-principles", "publisher_url": "https://news.mongabay.com/2025/11/sierra-leone-communities-sign-carbon-agreement-based-on-carbon-justice-principles", "title_original": "Sierra Leone communities sign carbon agreement based on carbon justice principles", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-11T14:28:19+00:00", "source_text": "More than 220 communities in Sierra Leone have signed a benefit-sharing carbon agreement with a developer that will help protect a key mangrove ecosystem. Namati Sierra Leone, a legal advocacy group counseling all involved communities, said the agreement between the communities in the chiefdom of Sittia in Bonthe district and the Africa Conservation Initiative (ACI) […]", "text_kind": "source_excerpt", "text_characters": 372, "text_sha256": "640dbc70d62cf288ea89284c42534778cdc8cbc1df58ce10d4310a8fde2546b7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:21.269447+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "SL", "alpha3": "SLE", "name_zh": "塞拉利昂", "name_en": "Sierra Leone"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "SL", "alpha3": "SLE", "name_zh": "塞拉利昂", "name_en": "Sierra Leone"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:21.338790+00:00", "published_at_raw": "2025-11-11T14:28:19", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "SL", "alpha3": "SLE", "name_zh": "塞拉利昂", "name_en": "Sierra Leone", "start": 0, "end": 12, "matched_text": "Sierra Leone", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "SL", "alpha3": "SLE", "name_zh": "塞拉利昂", "name_en": "Sierra Leone", "start": 29, "end": 41, "matched_text": "Sierra Leone", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_9f8d125598aa154c2ca0", "record_id": "article_9f8d125598aa154c", "canonical_url": "https://insideclimatenews.org/news/11112025/french-caribbean-islands-seek-justice-pesticide-poisoning", "publisher_url": "https://insideclimatenews.org/news/11112025/french-caribbean-islands-seek-justice-pesticide-poisoning", "title_original": "Two Caribbean Islands Seek Justice From France for Pesticide Poisoning", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-11T10:00:00+00:00", "source_text": "As a kid in the French Caribbean island of Guadeloupe, Georgina Lambert spent her days playing beneath banana trees and swimming in rivers that shimmered with sunlight. She had no idea that the soil beneath her feet, the water she swam in and the air she breathed were laced with chlordecone, an extremely toxic pesticide. […]", "text_kind": "source_excerpt", "text_characters": 326, "text_sha256": "81cfdd2654e5d0bd6505448ee7015e9b8c807282ed2d6410da80899f631237e6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:47.968470+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "FR", "alpha3": "FRA", "name_zh": "法国", "name_en": "France"}, {"alpha2": "GP", "alpha3": "GLP", "name_zh": "瓜德罗普", "name_en": "Guadeloupe"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GP", "alpha3": "GLP", "name_zh": "瓜德罗普", "name_en": "Guadeloupe"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:47.990305+00:00", "published_at_raw": "2025-11-11T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "FR", "alpha3": "FRA", "name_zh": "法国", "name_en": "France", "start": 40, "end": 46, "matched_text": "France", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GP", "alpha3": "GLP", "name_zh": "瓜德罗普", "name_en": "Guadeloupe", "start": 43, "end": 53, "matched_text": "Guadeloupe", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_066beef872ca558907fd", "record_id": "article_066beef872ca5589", "canonical_url": "https://news.mongabay.com/2025/11/healing-life-on-earth-begins-with-healing-our-bonds-voices-from-the-land-commentary", "publisher_url": "https://news.mongabay.com/2025/11/healing-life-on-earth-begins-with-healing-our-bonds-voices-from-the-land-commentary", "title_original": "Healing life on Earth begins with healing our bonds: Voices from the land (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-10T07:00:39+00:00", "source_text": "This series, Voices from the Land, brings together opinion pieces led and written by Indigenous peoples from around the world. Through these commentaries, we share our lived realities and reflections on urgent issues shaping our time — environmental destruction, our relationship with nature, and systemic injustice. We write from the heart of our communities, where […]", "text_kind": "source_excerpt", "text_characters": 370, "text_sha256": "2bfddf1c6da1bb96457bf68e5eeeeee671c2897798da3249d4978809c9c0393b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:22.709152+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 85, "end": 95, "evidence": "This series, Voices from the Land, brings together opinion pieces led and written by Indigenous peoples from around the world. Through these commentaries, we share our lived realities and reflections on urgent issues shaping our time —"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:22.778888+00:00", "published_at_raw": "2025-11-10T07:00:39", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_e032256aa631f9c2271f", "record_id": "article_e032256aa631f9c2", "canonical_url": "https://news.mongabay.com/2025/11/early-career-journalists-join-the-next-wave-of-environmental-reporting-commentary", "publisher_url": "https://news.mongabay.com/2025/11/early-career-journalists-join-the-next-wave-of-environmental-reporting-commentary", "title_original": "Early-career journalists join the next wave of environmental reporting (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-07T15:55:35+00:00", "source_text": "English poet Thomas Gray famously wrote, “where ignorance is bliss, ‘Tis folly to be wise.” He wasn’t particularly speaking of journalists or of Earth’s precarious future. I believe that ignorance is the enemy of journalism, it is no bliss, but the very thing we are meant to expose. Perhaps ignorance is an ally of […]", "text_kind": "source_excerpt", "text_characters": 319, "text_sha256": "f737dae418cfb3d9c38f1a613b3943a99c8861b5518555fb3d6685a99125ec6b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:23.231079+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:23.288144+00:00", "published_at_raw": "2025-11-07T15:55:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_dbda2643895f79013ed4", "record_id": "article_dbda2643895f7901", "canonical_url": "https://yaleclimateconnections.org/2025/11/reinsurance-meet-your-insurance-companys-insurance-company", "publisher_url": "https://yaleclimateconnections.org/2025/11/reinsurance-meet-your-insurance-companys-insurance-company", "title_original": "Reinsurance: Meet your insurance company’s insurance company", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-07T12:00:00+00:00", "source_text": "Transcript: After a wildfire or hurricane, insurance companies may be flooded with claims from homeowners. Quigley: “These types of events can impact thousands of insurance policyholders simultaneously, and that, because of the large-scale nature of them, put an insurance company at risk of insolvency.” Michael Quigley is with Munich Re , a company that offers what’s known as “reinsurance.” Reinsurance is insurance for insurance companies, and helps them stay afloat if a major disaster forces them to pay out many claims at once.", "text_kind": "article_excerpt", "text_characters": 534, "text_sha256": "b6713df9ef75a0261956b7655e2407f91b5acec854078f3e1e73fb21695d02d7", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:52.700624+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 20, "end": 28, "evidence": "Transcript: After a wildfire or hurricane, insurance companies may be flooded with claims from homeowners. Quigley: “These types of events can impact thousands of insur"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:52.743087+00:00", "published_at_raw": "2025-11-07T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_7b20177a1f10d1f3f8b6", "record_id": "article_7b20177a1f10d1f3", "canonical_url": "https://news.mongabay.com/2025/11/the-uncertain-future-of-drcs-traditional-medicine-a-heritage-to-save-commentary", "publisher_url": "https://news.mongabay.com/2025/11/the-uncertain-future-of-drcs-traditional-medicine-a-heritage-to-save-commentary", "title_original": "The uncertain future of DRC’s traditional medicine, a heritage to save (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-06T18:24:32+00:00", "source_text": "Congolese traditional medicine is disappearing. Not due to a lack of usefulness, but due to a lack of space in an increasingly standardized medical world. Faced with the rise of modern medicine, supported by institutions and universities, ancestral knowledge is being forgotten and sometimes even scorned. Yet, in rural areas where hospitals are scarce […]", "text_kind": "source_excerpt", "text_characters": 356, "text_sha256": "052702e53f234ca2d50075fdfed8f58371a8033bcfba8df441bc1090ef2ae48d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:29.661168+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:29.726743+00:00", "published_at_raw": "2025-11-06T18:24:32", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)", "start": 24, "end": 27, "matched_text": "DRC", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_cccf16b18a1c9b3e72b4", "record_id": "article_cccf16b18a1c9b3e", "canonical_url": "https://insideclimatenews.org/news/06112025/inside-clean-energy-cpower-grid-relief", "publisher_url": "https://insideclimatenews.org/news/06112025/inside-clean-energy-cpower-grid-relief", "title_original": "When the Power Grid Needs Relief from High Demand, Here’s Who You Call", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-06T14:00:00+00:00", "source_text": "When electricity supplies are tight, being able to flip a few switches and save 38 gigawatt-hours is a pretty cool trick. CPower Energy said this week that its customers reduced their grid electricity usage by that amount from January to September, which is enough to power about 8 million houses during a grid emergency. The […]", "text_kind": "source_excerpt", "text_characters": 329, "text_sha256": "8e5fb40aebcdc0d332160258f86427fdb39601e5da8a1656070014ade5de0fe0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:54.977543+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "8 million", "start": 280, "end": 289, "evidence": " CPower Energy said this week that its customers reduced their grid electricity usage by that amount from January to September, which is enough to power about 8 million houses during a grid emergency.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 129, "end": 135, "evidence": "ing able to flip a few switches and save 38 gigawatt-hours is a pretty cool trick. CPower Energy said this week that its customers reduced their grid electricity usage by that amount from January to September, which is enough to power a"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:54.999244+00:00", "published_at_raw": "2025-11-06T14:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_188b4c5c2ec31244c3ab", "record_id": "article_188b4c5c2ec31244", "canonical_url": "https://insideclimatenews.org/news/06112025/midwest-hurricane-tropical-storm-impacts", "publisher_url": "https://insideclimatenews.org/news/06112025/midwest-hurricane-tropical-storm-impacts", "title_original": "Hurricane and Tropical Storm Remnants Impact the Midwest, Too", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-06T09:50:00+00:00", "source_text": "When hurricanes form, all eyes are on the places where they make landfall—for obvious reasons. But their effects can extend hundreds of miles inland. Case in point: Remnants of dozens of hurricanes and tropical storms have swept through the Midwest. Had Hurricane Melissa taken a more westerly route last week, it could have brought the […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "30932629441863b5219673167d5ec30b76cfe80466a14b3870714a851c8a6dab", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:55.116965+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:55.136839+00:00", "published_at_raw": "2025-11-06T09:50:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_dff01d12199894a533ac", "record_id": "article_dff01d12199894a5", "canonical_url": "https://insideclimatenews.org/news/05112025/hawaii-raw-sewage-threatens-coast-coral-reefs-public-health", "publisher_url": "https://insideclimatenews.org/news/05112025/hawaii-raw-sewage-threatens-coast-coral-reefs-public-health", "title_original": "Raw Sewage Sneaking Into West Hawaii’s Coastal Waters Threatens Coral Reefs and Public Health, Scientists Find", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-05T09:55:00+00:00", "source_text": "For generations, West Hawaii’s picturesque coastlines have been a gathering place for fishing, swimming and ceremony. But those sacred waters are also gathering something else. Using airborne mapping, field sampling and advanced statistical analysis, researchers at Arizona State University’s Center for Global Discovery and Conservation Science in Hawaii revealed that nearly half of West Hawaii’s […]", "text_kind": "source_excerpt", "text_characters": 402, "text_sha256": "dfc923096c3805d6ab4b86dca0b5d63ee86660a6e57ac011d3d09de8f6dbaae7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:55.439813+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:55.456035+00:00", "published_at_raw": "2025-11-05T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_0721d98b2af93ec0d1d5", "record_id": "article_0721d98b2af93ec0", "canonical_url": "https://insideclimatenews.org/news/04112025/miccosukee-tribe-florida-everglades-forever-chemicals", "publisher_url": "https://insideclimatenews.org/news/04112025/miccosukee-tribe-florida-everglades-forever-chemicals", "title_original": "‘Forever Chemicals’ Represent New Environmental Threat for Florida’s Fragile Everglades", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-04T09:55:00+00:00", "source_text": "A dozen different “forever chemicals” linked with cancer and other human health problems have been detected in the Everglades, Florida’s most important freshwater resource, responsible for the drinking water of millions in the state, according to new research. It is the first time PFAS, or perfluoroalkyl and polyfluoroalkyl substances, have been measured on the Everglades […]", "text_kind": "source_excerpt", "text_characters": 378, "text_sha256": "805e31c37272059913dc6382106b026deb130e3dd926e3249ef786166ddda190", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:55.585959+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:55.630683+00:00", "published_at_raw": "2025-11-04T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_03af368c10b1b0baffff", "record_id": "article_03af368c10b1b0ba", "canonical_url": "https://news.mongabay.com/2025/11/critical-minerals-drive-legalization-of-mining-on-amazon-indigenous-lands", "publisher_url": "https://news.mongabay.com/2025/11/critical-minerals-drive-legalization-of-mining-on-amazon-indigenous-lands", "title_original": "Critical minerals drive legalization of mining on Amazon Indigenous lands", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-03T17:56:34+00:00", "source_text": "The Brazilian Constitution bans illegal mining on Indigenous lands under any circumstances. But the high demand for minerals, especially gold, drove miners to invade Indigenous lands anyway. Since 2018, the area of gold mines in the Amazon has doubled ( 1,217% since 1985), while the metal’s value has nearly tripled, reaching an all-time record high. Since 2023, the federal government has conducted a crackdown on illegal miners, dealing significant blows to criminal operations in Indigenous lands. In the Yanomami Indigenous Territory (Brazil’s largest), operations resulted in more than 500 million reais ($93 million) in losses for illegal miners until mid-October, largely reducing the area affected by the activity, authorities say.", "text_kind": "article_excerpt", "text_characters": 740, "text_sha256": "eb5f25072d89ae72e7f30f2a6cb83fdcd29d8a585a0ccd1dfbba04f3469fd123", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:31.771600+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "1,217%", "start": 254, "end": 260, "evidence": " Since 2018, the area of gold mines in the Amazon has doubled ( 1,217% since 1985), while the metal’s value has nearly tripled, reaching an all-time record high.", "interpretation": "not_classified"}, {"value_text": "500 million", "start": 592, "end": 603, "evidence": " In the Yanomami Indigenous Territory (Brazil’s largest), operations resulted in more than 500 million reais ($93 million) in losses for illegal miners until mid-October, largely reducing the area affected by the activity, authorities say.", "interpretation": "not_classified"}, {"value_text": "$93 million", "start": 611, "end": 622, "evidence": " In the Yanomami Indigenous Territory (Brazil’s largest), operations resulted in more than 500 million reais ($93 million) in losses for illegal miners until mid-October, largely reducing the area affected by the activity, authorities say.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 50, "end": 60, "evidence": "The Brazilian Constitution bans illegal mining on Indigenous lands under any circumstances. But the high demand for minerals, especially gold, drove miners to invade Indigenous lands anyway. Since 201"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:31.845094+00:00", "published_at_raw": "2025-11-03T17:56:34", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 540, "end": 546, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_0226ad0735f52d5b1e42", "record_id": "article_0226ad0735f52d5b", "canonical_url": "https://insideclimatenews.org/news/02112025/cattle-solar-grazing", "publisher_url": "https://insideclimatenews.org/news/02112025/cattle-solar-grazing", "title_original": "Can Cows and Solar Power Coexist? We’re About to Find Out", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-02T09:55:00+00:00", "source_text": "LANCASTER, Ky.—It is unusual to have a utility-scale solar array in Kentucky, and even more unusual that the grounds crew here is a live-in flock of more than a thousand sheep. On a recent afternoon, the sheep lounged beneath the shade created by solar panels, supervised by three dogs: Honey, Junior and Roxy. The property […]", "text_kind": "source_excerpt", "text_characters": 327, "text_sha256": "b23d5f99625a4313e7b8c6613033617dc424eb1d3a6641aa50ef8cb8ed7b5313", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:55.971504+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 53, "end": 58, "evidence": "LANCASTER, Ky.—It is unusual to have a utility-scale solar array in Kentucky, and even more unusual that the grounds crew here is a live-in flock of more than a thousand sheep. On a recent afternoon"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:55.985838+00:00", "published_at_raw": "2025-11-02T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_3e117e61f63931999e31", "record_id": "article_3e117e61f6393199", "canonical_url": "https://news.mongabay.com/2025/10/heading-into-cop-brazils-amazon-deforestation-rate-is-falling-what-about-fires", "publisher_url": "https://news.mongabay.com/2025/10/heading-into-cop-brazils-amazon-deforestation-rate-is-falling-what-about-fires", "title_original": "Heading into COP, Brazil’s Amazon deforestation rate is falling. What about fires?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-30T21:49:37+00:00", "source_text": "As the world’s attention turns toward COP30 in Belém next month, the story of Brazil’s Amazon is shifting—though not quite in a straightforward way. According to the government’s satellite-based monitoring system, INPE’s PRODES, deforestation in the region known as the “Legal Amazon” totaled 5,796 square kilometers for the 12 months ending July 31st, 2025. That’s […]", "text_kind": "source_excerpt", "text_characters": 369, "text_sha256": "3432549a66152b2af767d95cb68de1f3a17b1eeb550dce7735e3d683e60f7d25", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:32.799871+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": ["COP30"], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "negotiations", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:32.909049+00:00", "published_at_raw": "2025-10-30T21:49:37", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 18, "end": 24, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 78, "end": 84, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_77367e4eb0551bbbef45", "record_id": "article_77367e4eb0551bbb", "canonical_url": "https://yaleclimateconnections.org/2025/10/the-anthropologists-holding-funerals-for-the-worlds-dying-glaciers", "publisher_url": "https://yaleclimateconnections.org/2025/10/the-anthropologists-holding-funerals-for-the-worlds-dying-glaciers", "title_original": "The anthropologists holding funerals for the world’s dying glaciers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-30T11:00:00+00:00", "source_text": "To help people grasp what it means to lose 273 billion tons of ice a year, two researchers are treating glaciers like community members – and giving them the memorials they deserve.", "text_kind": "source_excerpt", "text_characters": 181, "text_sha256": "f1d69673bfaf7c17aeef2338037ad6ed783433562ed799e4fc9a1210f2bba256", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:59.046175+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "273 billion", "start": 43, "end": 54, "evidence": "To help people grasp what it means to lose 273 billion tons of ice a year, two researchers are treating glaciers like community members – and giving them the memorials they deserve.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:59.058055+00:00", "published_at_raw": "2025-10-30T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_7a9dc8e7bd309f37a86d", "record_id": "article_7a9dc8e7bd309f37", "canonical_url": "https://www.carbonbrief.org/qa-how-vehicle-to-grid-technology-could-boost-chinas-electricity-system", "publisher_url": "https://www.carbonbrief.org/qa-how-vehicle-to-grid-technology-could-boost-chinas-electricity-system", "title_original": "Q&A: How ‘vehicle-to-grid’ technology could boost China’s electricity system", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-29T15:46:10+00:00", "source_text": "China’s surging electric vehicles (EVs) ownership – now exceeding 25.5m – is opening the door to a new technology that can help to enhance the flexibility of electricity supply. EVs connected via “ vehicle-to-grid ” (V2G) technology can function as “ batteries on wheels ” that charge and discharge according to the needs of the wider electricity system. The idea of turning EVs into “ power banks ” has already sparked both business and political interest in China. How can V2G help balance the grid? V2G involves two-way electric charging that allows EVs to act as flexible power sources, which can potentially help with the electricity supply from the grid.", "text_kind": "article_excerpt", "text_characters": 660, "text_sha256": "043dd2d4889aa1989e178a04c17ee949b5095e01474b5cefbe83c88e77dfd423", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:58.678828+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:58.709440+00:00", "published_at_raw": "2025-10-29T15:46:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 50, "end": 55, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 0, "end": 5, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_c2fcf2fcbbcc18d3b16e", "record_id": "article_c2fcf2fcbbcc18d3", "canonical_url": "https://news.mongabay.com/2025/10/virus-outbreak-deepens-rift-over-return-of-spixs-macaw-to-brazil", "publisher_url": "https://news.mongabay.com/2025/10/virus-outbreak-deepens-rift-over-return-of-spixs-macaw-to-brazil", "title_original": "Virus outbreak deepens rift over return of Spix’s macaw to Brazil", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-28T15:20:45+00:00", "source_text": "CURAÇÁ, Brazil — Under the scorching sun of Brazil’s semiarid Caatinga shrubland, squawks tear through the skies, signaling the arrival of one of the most threatened bird species in the world. Quickly, the unmistakable blue silhouettes fly overhead. It’s the Spix’s macaw (Cyanopsitta spixii), a species declared extinct in the wild in 2000 and now […]", "text_kind": "source_excerpt", "text_characters": 352, "text_sha256": "91afac54d30be84c7171f2754e9fa8cf93bb6a555619abdbcfc88e78faf2a36b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:39.781423+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v