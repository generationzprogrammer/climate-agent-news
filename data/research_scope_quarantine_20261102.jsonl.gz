{"text_id": "text_1c3912915ea5afbdce8a", "record_id": "article_1c3912915ea5afbd", "canonical_url": "https://insideclimatenews.org/news/16022024/new-york-state-restricts-investments-in-exxonmobil-but-falls-short-of-divestment", "publisher_url": "https://insideclimatenews.org/news/16022024/new-york-state-restricts-investments-in-exxonmobil-but-falls-short-of-divestment", "title_original": "New York State Restricts Investments in ExxonMobil, But Falls Short of Divestment", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-16T10:05:00+00:00", "source_text": "New York State’s largest public pension fund is restricting its investments in ExxonMobil after determining the oil company is failing to prepare for a low-carbon world. The announcement falls far short of pledging a full divestment from Exxon, however, and the fund will continue to hold hundreds of millions of dollars worth of shares in […]", "text_kind": "source_excerpt", "text_characters": 343, "text_sha256": "0c32307b2972d8f3d4494dbb391b1324b7a12e7a8f6f40f5d5dc1c43a99561ce", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:32.193339+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_so