{"text_id": "text_4db28e50f8dc57f5413d", "record_id": "article_4db28e50f8dc57f5", "canonical_url": "https://news.mongabay.com/2026/07/conservationists-urge-caution-over-bangladeshs-plan-to-plant-250-million-trees", "publisher_url": "https://news.mongabay.com/2026/07/conservationists-urge-caution-over-bangladeshs-plan-to-plant-250-million-trees", "title_original": "Conservationists urge caution over Bangladesh’s plan to plant 250 million trees", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-20T07:10:07+00:00", "source_text": "With an aim to increase the country’s green cover in line with the current government’s election manifesto, Bangladesh is preparing for a nationwide plantation of 250 million trees across the country in the next five years. “Currently, we are coordinating with various government agencies, including the Ministry of Agriculture; the Ministry of Local Government, Rural […]", "text_kind": "source_excerpt", "text_characters": 372, "text_sha256": "997e80e4d6ce18e1ce1885fbf2f0cf438a2389322ca4d59cef21f2e3a5b262b0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:37.485290+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "250 million", "start": 163, "end": 174, "evidence": "With an aim to increase the country’s green cover in line with the current government’s election manifesto, Bangladesh is preparing for a nationwide plantation of 250 million trees across the country in the next five years.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:37.513382+00:00", "published_at_raw": "2026-07-20T07:10:07", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh", "start": 35, "end": 45, "matched_text": "Bangladesh", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BD", "alpha3": "BGD", "name_zh": "孟加拉国", "name_en": "Bangladesh", "start": 108, "end": 118, "matched_text": "Bangladesh", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_53b0d46dde9a72c6b02d", "record_id": "article_53b0d46dde9a72c6", "canonical_url": "https://insideclimatenews.org/news/18072026/why-plastics-have-overtaken-the-planet", "publisher_url": "https://insideclimatenews.org/news/18072026/why-plastics-have-overtaken-the-planet", "title_original": "Why Plastics Have Overtaken the Planet", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-18T08:55:00+00:00", "source_text": "From our collaborating partner Living on Earth, public radio’s environmental news magazine, an interview by Paloma Beltran with Judith Enck, the founder of advocacy group Beyond Plastics. After World War II, plastics grew from a cheap wartime alternative to a staple in the American home. From Tupperware to disposable water bottles and children’s toys, plastic […]", "text_kind": "source_excerpt", "text_characters": 365, "text_sha256": "64add8c42fdf569c3ff20f4b8f0f881a0b6147e7cdc6d01215cd84f20ee4c683", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:38.438755+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T