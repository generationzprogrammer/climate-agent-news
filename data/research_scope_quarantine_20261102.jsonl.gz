{"text_id": "text_1f10d8f52f9cc83698f6", "record_id": "article_1f10d8f52f9cc836", "canonical_url": "https://news.mongabay.com/2026/10/heavy-rains-during-critical-period-of-cacao-cultivation-hit-ghanas-yields", "publisher_url": "https://news.mongabay.com/2026/10/heavy-rains-during-critical-period-of-cacao-cultivation-hit-ghanas-yields", "title_original": "Heavy rains during critical period of cacao cultivation hit Ghana’s yields", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-21T10:32:24+00:00", "source_text": "Heavy rainfall during the cacao flowering season is a major driver of Ghana’s recent harvest fluctuations, new research finds. A study published in September by researchers at the Harvard University Center for the Environment in the U.S. found that heavy rainfall during cacao’s flowering and early pod development is linked to significant yield decreases. The […]", "text_kind": "source_excerpt", "text_characters": 364, "text_sha256": "3146b9ac3904c4e3d8d337673731ca433693cfdddfbf434cd779ca7cf31cd895", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:26.879172+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:26.895111+00:00", "published_at_raw": "2026-10-21T10:32:24", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana", "start": 60, "end": 65, "matched_text": "Ghana", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana", "start": 70, "end": 75, "matched_text": "Ghana", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 233, "end": 237, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_8f0cce88965d5e130efc", "record_id": "article_8f0cce88965d5e13", "canonical_url": "https://news.mongabay.com/2026/10/search-for-the-asian-unicorn-faces-an-uncertain-future-amid-funding-losses", "publisher_url": "https://news.mongabay.com/2026/10/search-for-the-asian-unicorn-faces-an-uncertain-future-amid-funding-losses", "title_original": "Search for the ‘Asian unicorn’ faces an uncertain future amid funding losses", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-20T22:26:46+00:00", "source_text": "The search for the enigmatic creature often called the Asian unicorn is stumbling forward on a month-to-month basis, according to the Saola Foundation, which organizes the search. The group says it’s now frantically raising funds to keep the search for the saola in Laos going. “The team comes out of the forest each July for […]", "text_kind": "source_excerpt", "text_characters": 329, "text_sha256": "e713e690617cfad285deb7a7c24c0fca3d3e7b915402a6c8486008f3bb045d52", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:26.927860+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "LA", "alpha3": "LAO", "name_zh": "老挝人民民主共和国", "name_en": "Laos"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "LA", "alpha3": "LAO", "name_zh": "老挝人民民主共和国", "name_en": "Laos"}], "annotation_method": "dic