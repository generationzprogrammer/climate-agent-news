{"text_id": "text_c1bb7eee48b600305093", "record_id": "article_c1bb7eee48b60030", "canonical_url": "https://insideclimatenews.org/news/05122024/reflective-low-clouds-decline-may-contribute-to-record-heat", "publisher_url": "https://insideclimatenews.org/news/05122024/reflective-low-clouds-decline-may-contribute-to-record-heat", "title_original": "Decline of Reflective Low Clouds May Have Contributed to Recent Record Heat", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-12-05T19:00:00+00:00", "source_text": "Earth has often been described by astronauts as a glistening marble floating in a black void, but the planet has lost some of its sheen in recent decades, especially with the well-documented decline of ice and snow in polar and mountain regions. New research published today shows the planet is also dulling from a steady […]", "text_kind": "source_excerpt", "text_characters": 325, "text_sha256": "e54256439143ba0901b9e74b771b16de77ffd166523918cc6d6545ce7553f814", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:20.329892+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:20.349600+00:00", "published_at_raw": "2024-12-05T19:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_dc633900cac49bc05ddf", "record_id": "article_dc633900cac49bc0", "canonical_url": "https://news.mongabay.com/2024/12/severe-drought-in-peruvian-amazon-isolated-more-than-130-indigenous-communities", "publisher_url": "https://news.mongabay.com/2024/12/severe-drought-in-peruvian-amazon-isolated-more-than-130-indigenous-communities", "title_original": "Severe drought in Peruvian Amazon isolated more than 130 Indigenous communities", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-12-05T10:27:09+00:00", "source_text": "More than 130 Indigenous communities in the Peruvian Amazon were left isolated after a severe drought caused rivers used for transport to dry up, leaving families with little food, water or health care access. This affected the livelihoods of communities that rely on fish for food and trade, as well as crops and native plants […]", "text_kind": "source_excerpt", "text_characters": 331, "text_sha256": "025839b92a689ff49133093ad797ef3920dd9e878a862727ce7b5471b5e3ad11", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:46.162789+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 14, "end": 24, "evidence": "More than 130 Indigenous communities in the Peruvian Amazon were left isolated after a severe drought caused rivers used for transport to dry u