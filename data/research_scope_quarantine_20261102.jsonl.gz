{"text_id": "text_53d238e5944b6882efff", "record_id": "article_53d238e5944b6882", "canonical_url": "https://news.mongabay.com/2024/11/india-advances-deep-sea-mining-technology-in-the-andaman-sea", "publisher_url": "https://news.mongabay.com/2024/11/india-advances-deep-sea-mining-technology-in-the-andaman-sea", "title_original": "India advances deep-sea mining technology in the Andaman Sea", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-21T16:23:50+00:00", "source_text": "India’s government organization dedicated to developing technologies for exploring and harnessing ocean resources has been exploring parts of the Indian Ocean for the last few years. In October, the National Institute of Ocean Technology (NIOT) conducted a successful exploratory mining trial in the Andaman Sea, between India’s Andaman and Nicobar Islands and Myanmar, for obtaining […]", "text_kind": "source_excerpt", "text_characters": 387, "text_sha256": "399a911f35616ca529f95eb94e7f191ba5a9aba9a35782a637e652249ea991d2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:51.895600+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MM", "alpha3": "MMR", "name_zh": "缅甸", "name_en": "Myanmar"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MM", "alpha3": "MMR", "name_zh": "缅甸", "name_en": "Myanmar"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:51.910713+00:00", "published_at_raw": "2024-11-21T16:23:50", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 0, "end": 5, "matched_text": "India", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 0, "end": 5, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "MM", "alpha3": "MMR", "name_zh": "缅甸", "name_en": "Myanmar", "start": 361, "end": 368, "matched_text": "Myanmar", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_4e709f5e49226eff2dfa", "record_id": "article_4e709f5e49226eff", "canonical_url": "https://insideclimatenews.org/news/21112024/inside-clean-energy-utility-companies-transmission-line-spending", "publisher_url": "https://insideclimatenews.org/news/21112024/inside-clean-energy-utility-companies-transmission-line-spending", "title_original": "Utilities Are Spending a Lot for Power Lines We May Not Need, and Spending Less on Ones We Do Need", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-21T14:00:00+00:00", "source_text": "Certain kinds of projects can lead to easy money for utility companies, while others require a long and difficult approval process. So it shouldn’t be surprising when the companies choose the easy path, which in this case means construction and maintenance of local transmission lines. At the same time, the companies are focusing less on […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "9fde33d6c48ea2218308e5be0846b433076c31fe2a33666020fa2c8d3839cde7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:28.097896+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:28.117625+00:00", "published_at_raw": "2024-11-21T14:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_a19ef74beeebc34724d7", "record_id": "article_a19ef74beeebc347", "canonical_url": "https://insideclimatenews.org/news/21112024/mid-atlantic-states-call-for-electric-grid-operator-to-change-rules", "publisher_url": "https://insideclimatenews.org/news/21112024/mid-atlantic-states-call-for-electric-grid-operator-to-change-rules", "title_original": "Following Capacity Price Spike, Mid-Atlantic States Call for Electric Grid Operator PJM to Change Rules", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-21T10:05:00+00:00", "source_text": "PJM Interconnection, the electric grid operator that serves customers in portions of the mid-Atlantic, South and Midwest, is under increasing pressure from state governors, advocates and consumer protection agencies to reform its current rules, which they believe give utilities and energy conglomerates an outsized say in generation and transmission planning. This hinders states’ ability to […]", "text_kind": "source_excerpt", "text_characters": 396, "text_sha256": "a62c10335e4e5105a99c63b72f3f0a66137747601b32df2fe6bb421b4fe4e539", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:28.148958+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 283, "end": 289, "evidence": "er protection agencies to reform its current rules, which they believe give utilities and energy conglomerates an outsized say in generation and transmission planning. This hinders states’ ability to […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:28.172831+00:00", "published_at_raw": "2024-11-21T10:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_95d39ab1e88b1d7d32db", "record_id": "article_95d39ab1e88b1d7d", "canonical_url": "https://dialogue.earth/en/justice/new-indonesian-broadcasting-bill-threatens-environmental-journalism", "publisher_url": "https://dialogue.earth/en/justice/new-indonesian-broadcasting-bill-threatens-environmental-journalism", "title_original": "New Indonesian Broadcasting Bill threatens environmental journalism", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-20T14:09:43+00:00", "source_text": "In March 2024, Indonesia’s House of Representatives released a draft of the new Broadcasting Bill without prior consultation or notice. The bill proposes stringent controls over digital journalism, including restrictions on investigative reporting and any content related to the political interests of a digital platform’s owner. This development is at odds with the new Indonesian administration’s stated commitment to press freedom. Following President Prabowo Subianto’s inauguration last month, his director-general of information and public communication, Prabunindya Revta Revolusi, promised to improve the country’s standing on the Reporters Without Borders’ (RSF) world press freedom index , where it ranks 111 th out of 180 – having steadily declined during the past decade.", "text_kind": "article_excerpt", "text_characters": 783, "text_sha256": "d78c31dae9c20c44325684a4a57ac636b9f49293be83bef0610f910c42e31e9c", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:48.752550+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:48.788198+00:00", "published_at_raw": "2024-11-20T14:09:43", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 15, "end": 24, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_dedebe07b9e43e0f4f94", "record_id": "article_dedebe07b9e43e0f", "canonical_url": "https://yaleclimateconnections.org/2024/11/es-cierto-que-el-cambio-climatico-reducira-significativamente-nuestra-esperanza-de-vida", "publisher_url": "https://yaleclimateconnections.org/2024/11/es-cierto-que-el-cambio-climatico-reducira-significativamente-nuestra-esperanza-de-vida", "title_original": "¿Es cierto que el cambio climático reducirá significativamente nuestra esperanza de vida?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-20T12:00:00+00:00", "source_text": "Uno de nuestros lectores nos preguntó: ¿Es cierto que el cambio climático reducirá significativamente nuestra esperanza de vida? Leí que para el año 2030, la humanidad podría enfrentar la extinción debido a la falta de agua y que las temperaturas se volverían insoportables. Pedimos a Johani Ponce, una contribuidora de YCC en español, que contestara […]", "text_kind": "source_excerpt", "text_characters": 354, "text_sha256": "83d0f92b2cb4a66b9e46e58de191afa73fb743841551d5ecadf9ebea8bb1e5d6", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:48.741619+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:48.769954+00:00", "published_at_raw": "2024-11-20T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_cf8424c6d44a847ee73e", "record_id": "article_cf8424c6d44a847e", "canonical_url": "https://news.mongabay.com/2024/11/scottish-salmon-farms-seek-growth-despite-mounting-fish-deaths-and-environmental-concerns", "publisher_url": "https://news.mongabay.com/2024/11/scottish-salmon-farms-seek-growth-despite-mounting-fish-deaths-and-environmental-concerns", "title_original": "Scottish salmon farms seek growth despite mounting fish deaths and environmental concerns", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-20T08:00:36+00:00", "source_text": "ULLAPOOL, U.K. — The fish float on the surface by the dozen, their bellies pointing toward the still-dark sky of the early morning. We are peering into a cage of an intensive Atlantic salmon farm, owned by the Norwegian multinational Mowi, in Upper Loch Torridon along Scotland’s west coast. It’s September 2024. It’s difficult to […]", "text_kind": "source_excerpt", "text_characters": 334, "text_sha256": "01389345db86ebf5886625df1512cc9482ec1361b6a20ad89d30a7b690f90f1b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:52.038953+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:52.053129+00:00", "published_at_raw": "2024-11-20T08:00:36", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 10, "end": 14, "matched_text": "U.K.", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_85795e660c1b2bc67153", "record_id": "article_85795e660c1b2bc6", "canonical_url": "https://insideclimatenews.org/news/17112024/massive-land-return-to-maine-penobscot-indigenous-tribe", "publisher_url": "https://insideclimatenews.org/news/17112024/massive-land-return-to-maine-penobscot-indigenous-tribe", "title_original": "31,000 Acres at the Front of a Movement", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-17T09:55:00+00:00", "source_text": "Chuck Loring knows all the good spots for finding dropped moose antlers. It’s part passion and part professional. He spends whatever free time he can packing his snowmobile into the bed of his truck and hauling it out to the Penobscot tribal trust land in north central Maine, where he works as the tribe’s director […]", "text_kind": "source_excerpt", "text_characters": 319, "text_sha256": "ca06c978fef8be7ef4a89e4c2c50dbeca3a74152440f1647aeed6c5273ef62b9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:33.275385+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:33.287181+00:00", "published_at_raw": "2024-11-17T09:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_e259f8043ad6979156c0", "record_id": "article_e259f8043ad69791", "canonical_url": "https://yaleclimateconnections.org/2024/11/category-5-super-typhoon-man-yi-hits-the-philippines", "publisher_url": "https://yaleclimateconnections.org/2024/11/category-5-super-typhoon-man-yi-hits-the-philippines", "title_original": "Category 5 Super Typhoon Man-yi hits the Philippines", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-16T19:20:41+00:00", "source_text": "Super Typhoon Man-yi (called Pepito in the Philippines) made landfall on Catanduanes Island in the Philippines at 9:40 p.m. local time on Saturday, Nov. 16, as a category 4 storm with 150 mph winds, less than eight hours after peaking as a category 5 storm with 160 mph winds and a central pressure of 923 mb, as determined by the Joint Typhoon Warning Center (JTWC). The Philippines have suffered an unprecedented battering by November typhoons, with Man-yi being the fourth typhoon to hit the nation in a span of less than 10 days. The four landfalls: Typhoon Yinxing (Cat 4): Nov. 7 Typhoon Toraji (Cat 1): Nov. 11 Super Typhoon Usagi (Cat 4): Nov. 14 Super Typhoon Man-Yi (Cat 5): Nov.", "text_kind": "article_excerpt", "text_characters": 689, "text_sha256": "834653ad541486083ea7f78c12b9051cd3d4304df54659770c7287ec77909a22", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:48:49.172911+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:49.210349+00:00", "published_at_raw": "2024-11-16T19:20:41", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines", "start": 41, "end": 52, "matched_text": "Philippines", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines", "start": 43, "end": 54, "matched_text": "Philippines", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_ac17e6b42184ed93d0d0", "record_id": "article_ac17e6b42184ed93", "canonical_url": "https://insideclimatenews.org/news/16112024/nations-must-ratify-treaty-of-high-seas-to-protect-oceans", "publisher_url": "https://insideclimatenews.org/news/16112024/nations-must-ratify-treaty-of-high-seas-to-protect-oceans", "title_original": "To Protect Vast Expanses of Ocean Beyond All National Boundaries, 60 Nations Must Ratify the Treaty of the High Seas", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-16T10:05:00+00:00", "source_text": "For the Indigenous Rapa Nui people who live on Easter Island, one of the most remote inhabited islands in the world, the high seas have played an integral role in their daily lives for at least two thousand years. These ocean areas that extend beyond any one country’s national jurisdiction connect their small island—which they […]", "text_kind": "source_excerpt", "text_characters": 332, "text_sha256": "5a4b7eeff0c8a4da055c79f2ad0d973045ce8ef732a58c5d7ad3472601c56a65", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:33.305595+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 8, "end": 18, "evidence": "For the Indigenous Rapa Nui people who live on Easter Island, one of the most remote inhabited islands in the world, the high seas have played an integral rol"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:33.317262+00:00", "published_at_raw": "2024-11-16T10:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_5d115958338d7bc12786", "record_id": "article_5d115958338d7bc1", "canonical_url": "https://insideclimatenews.org/news/15112024/nations-struggle-to-agree-on-global-plastics-treaty", "publisher_url": "https://insideclimatenews.org/news/15112024/nations-struggle-to-agree-on-global-plastics-treaty", "title_original": "Facing an Imminent Deadline, Nations Struggle to Agree on a Global Plastics Treaty", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-15T10:00:00+00:00", "source_text": "Two years in, delegates from more than 175 countries working to craft a global plastics pollution treaty remain widely divided. Whether an agreement emerges from a final scheduled round of negotiations this month is anyone’s guess. The current 70-page draft contains over 3,000 disputed words or sentences—an unworkable text with just a week of formal […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "ef16a32f1f710e6d952ba0a4f85b279d1b113f8757205f89a524f3dcbb79ec2b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:33.447008+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:33.459149+00:00", "published_at_raw": "2024-11-15T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_182b08d520fd302fb480", "record_id": "article_182b08d520fd302f", "canonical_url": "https://insideclimatenews.org/news/14112024/inside-clean-energy-election-cant-stop-momentum", "publisher_url": "https://insideclimatenews.org/news/14112024/inside-clean-energy-election-cant-stop-momentum", "title_original": "What Just Happened to the Idea of Progress?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-14T14:00:00+00:00", "source_text": "The morning after last week’s presidential election, I had to be up at 4 a.m. to drive my mother to the hospital for a surgery whose timing was not ideal. While my colleagues wrote about the ramifications of the election (and did so really well), I spent much of the remainder of the week in […]", "text_kind": "source_excerpt", "text_characters": 295, "text_sha256": "599ea627c5152c0f7f73076fa61bc30324a58672571f5bd07cf433ddb85f96bc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:33.530256+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:33.546172+00:00", "published_at_raw": "2024-11-14T14:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_893bebc2f7726040f314", "record_id": "article_893bebc2f7726040", "canonical_url": "https://insideclimatenews.org/news/12112024/todays-climate-human-caused-wildfires-drought", "publisher_url": "https://insideclimatenews.org/news/12112024/todays-climate-human-caused-wildfires-drought", "title_original": "In a Parched US, Human-Triggered Wildfires Are Poised to Thrive", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-12T20:26:46+00:00", "source_text": "After a soaking peak hurricane season, much of the United States is now parched. At the end of October, the U.S. Drought Monitor found that around 87 percent of the contiguous U.S. was in the throes of abnormally dry to exceptional drought conditions—a record high in the federal program’s 25-year history. These continuing droughts go […]", "text_kind": "source_excerpt", "text_characters": 339, "text_sha256": "dcd659621e2de8a88b8d5ec26ba3798dc0abd82cf68f4f3ef968132a40266869", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:33.737501+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "87 percent", "start": 147, "end": 157, "evidence": " Drought Monitor found that around 87 percent of the contiguous U.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 113, "end": 120, "evidence": "rricane season, much of the United States is now parched. At the end of October, the U.S. Drought Monitor found that around 87 percent of the contiguous U.S. was in the throes of abnormally dry to exceptional drought conditions—a record "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:33.748536+00:00", "published_at_raw": "2024-11-12T20:26:46", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 13, "end": 15, "matched_text": "US", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 51, "end": 64, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_92d444713afbecac1664", "record_id": "article_92d444713afbecac", "canonical_url": "https://news.mongabay.com/2024/11/a-kenya-water-fund-partners-with-farmers-to-protect-vital-resources", "publisher_url": "https://news.mongabay.com/2024/11/a-kenya-water-fund-partners-with-farmers-to-protect-vital-resources", "title_original": "A Kenya water fund partners with farmers to protect vital resources", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-11T18:02:04+00:00", "source_text": "This is Part 1 of a two-part series on Kenya’s Eldoret-Iten Water Fund. Part 2 is available here. When farmers in the upstream Moiben catchment of Kenya’s Cherangany Hills Water Tower shifted from raising merino sheep to growing Irish potatoes, a more profitable crop, an unexpected issue arose downstream. Unlike the grass that once had […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "0f6f2869db24807f855312416166de157458a3cfa4d1eabea6e9566818b8b558", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:57.070786+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:57.085372+00:00", "published_at_raw": "2024-11-11T18:02:04", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 2, "end": 7, "matched_text": "Kenya", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 39, "end": 44, "matched_text": "Kenya", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_c21414a8893f84ec8d86", "record_id": "article_c21414a8893f84ec", "canonical_url": "https://news.mongabay.com/2024/11/amazon-deforestation-in-brazil-plunges-31-to-lowest-level-in-9-years", "publisher_url": "https://news.mongabay.com/2024/11/amazon-deforestation-in-brazil-plunges-31-to-lowest-level-in-9-years", "title_original": "Amazon deforestation in Brazil plunges 31% to lowest level in 9 years", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-11-10T01:19:27+00:00", "source_text": "Deforestation in the Brazilian Amazon dropped by 30.6% over the past year, reaching the lowest level of destruction in nine years, according to data from the country’s national space research institute, INPE. For the year ending July 31, the Brazilian Amazon rainforest lost 6,288 square kilometers (2,428 square miles)—roughly the size of Delaware in the […]", "text_kind": "source_excerpt", "text_characters": 359, "text_sha256": "e54d62ac42ceb5d9b3872ff33c181cd21eb7ae1690bdc228fb69228d72717bfa", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:57.172479+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "30.6%", "start": 49, "end": 54, "evidence": "Deforestation in the Brazilian Amazon dropped by 30.6% over the past year, reaching the lowest level of destruction in nine years, according to data from the country’s national space research institute, INPE.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:57.185013+00:00", "published_at_raw": "2024-11-10T01:19:27", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 24, "end": 30, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
