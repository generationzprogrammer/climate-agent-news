{"text_id": "text_606e72f75aa66d847343", "record_id": "article_606e72f75aa66d84", "canonical_url": "https://insideclimatenews.org/news/24062025/north-carolina-power-surge-fraying-electric-system", "publisher_url": "https://insideclimatenews.org/news/24062025/north-carolina-power-surge-fraying-electric-system", "title_original": "In North Carolina, Exploding Bulbs and Fridges on the Fritz Reveal a Town’s Fraying Electric System", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-24T09:00:00+00:00", "source_text": "RED SPRINGS, N.C.—Early one evening this April, Kim Overstreet had just turned off the stove when she heard a boom. The panel box in the kitchen swung open and fuses shot out of their holders, bouncing off the fridge. Less than a block away, Debra Duncan’s robot vacuum bolted off its charging station toward her, […]", "text_kind": "source_excerpt", "text_characters": 317, "text_sha256": "9571d0de14924d32b49a2b0273c3d91e2a287d3f03eae9649eb4dc760f011908", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:34.113695+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:34.142525+00:00", "published_at_raw": "2025-06-24T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_94cd9e8ce12af93f0881", "record_id": "article_94cd9e8ce12af93f", "canonical_url": "https://insideclimatenews.org/news/22062025/california-gas-line-decommissioning-in-low-income-neighborhoods", "publisher_url": "https://insideclimatenews.org/news/22062025/california-gas-line-decommissioning-in-low-income-neighborhoods", "title_original": "In California, a Push to Decommission Gas Lines in Low-Income Neighborhoods Moves Forward", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-22T08:55:00+00:00", "source_text": "In Richmond, California, Zenaida Gomez is ready to say goodbye to the gas stove in the apartment she has rented for over a decade. She has a hunch that the pollution it emits is exacerbating her 10-year-old son’s asthma attacks, and she has heard from public health experts and doctors who’ve said it probably is. […]", "text_kind": "source_excerpt", "text_characters": 317, "text_sha256": "29e99de2e48fb5baa035af7a110c2c84a760af5c78b7373742bacae121744674", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:34.488839+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:34.510546+00:00", "published_at_raw": "2025-06-22T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 3, "end": 13, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 13, "end": 23, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_d4d817e16c73e49816a3", "record_id": "article_d4d817e16c73e498", "canonical_url": "https://insideclimatenews.org/news/20062025/geothermal-tax-credits-budget-bill", "publisher_url": "https://insideclimatenews.org/news/20062025/geothermal-tax-credits-budget-bill", "title_original": "Ground Source Heat Pump Manufacturers Urge Senators to Preserve Geothermal Tax Credits", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-20T21:01:27+00:00", "source_text": "Ground source heat pumps, a small but growing segment of the U.S. heating and cooling sector, could help slash energy demands, boost American manufacturing and stabilize the electric grid as AI-fueled power demands soar. That is the argument that executives whose companies manufacture the devices are making to their senators after the Senate’s draft of […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "e584e815f6ee62732a4023ccdbd1760736f4d3bd8584577f8b719bd63965d525", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:34.721466+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 111, "end": 117, "evidence": "mps, a small but growing segment of the U.S. heating and cooling sector, could help slash energy demands, boost American manufacturing and stabilize the electric grid as AI-fueled power demands soar. That is the argument that executives"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:34.749818+00:00", "published_at_raw": "2025-06-20T21:01:27", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 61, "end": 65, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_02f9dfd4a8aca03e1e7e", "record_id": "article_02f9dfd4a8aca03e", "canonical_url": "https://news.mongabay.com/2025/06/in-the-brazilian-amazon-sustainability-policies-clash-with-development-goals", "publisher_url": "https://news.mongabay.com/2025/06/in-the-brazilian-amazon-sustainability-policies-clash-with-development-goals", "title_original": "In the Brazilian Amazon, sustainability policies clash with development goals", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-20T14:00:56+00:00", "source_text": "Elected officials in the Brazilian Amazon have embraced the rhetoric of sustainable development, and most support programs that promote sustainable production paradigms. Nonetheless, most also continue to support investments in infrastructure that is known to drive deforestation. Why might they pursue seemingly contradictory development pathways? Either they assume that sustainable practices will take root and […]", "text_kind": "source_excerpt", "text_characters": 417, "text_sha256": "f8a1e7378bfb77d033704634f28a2a8a34e1427aeabb87e198362106349e274e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:55.229523+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:55.255636+00:00", "published_at_raw": "2025-06-20T14:00:56", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_95f161c4e00a68691c05", "record_id": "article_95f161c4e00a6869", "canonical_url": "https://yaleclimateconnections.org/2025/06/warmer-winters-increase-west-nile-risk", "publisher_url": "https://yaleclimateconnections.org/2025/06/warmer-winters-increase-west-nile-risk", "title_original": "Warmer winters increase West Nile risk", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-20T11:00:00+00:00", "source_text": "Transcript: Today marks the start of summer – a time for swimming with the kids, cooking out with friends, and fighting off mosquitoes. These annoying insects can spread dangerous diseases like West Nile virus . Most people who are infected with West Nile have no symptoms, but some suffer a headache. And in severe cases, the virus infects the brain and can cause neurological damage. Haley: “So paralysis or cloudy consciousness, disorientation, and so forth, and that can be fatal.” Robert Haley of the University of Texas Southwestern Medical Center says West Nile outbreaks tend to occur after winters with few hard freezes and a lot of rain.", "text_kind": "article_excerpt", "text_characters": 647, "text_sha256": "ac611ef2ef7337179394464f061c3a787e6a5cd936d49cea90f30b245712baf5", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:43.069939+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:43.093941+00:00", "published_at_raw": "2025-06-20T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 520, "end": 525, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_82953a2ef391b256893a", "record_id": "article_82953a2ef391b256", "canonical_url": "https://news.mongabay.com/2025/06/despite-protected-status-vietnams-corals-have-declined-in-20-years-study", "publisher_url": "https://news.mongabay.com/2025/06/despite-protected-status-vietnams-corals-have-declined-in-20-years-study", "title_original": "Major coral loss in Vietnam’s first marine protected area: Study", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-20T07:52:00+00:00", "source_text": "Vietnam’s first marine protected area, Nha Trang Bay, has lost nearly 200 hectares (494 acres) of coral reef since its creation in 2002, a new study shows. The alarming decline raises fresh questions about how effective conservation efforts have been in protecting one of the country’s most iconic coastal ecosystems. Published in April in the […]", "text_kind": "source_excerpt", "text_characters": 347, "text_sha256": "56a78208b84cb12227b337c66b1d5f24d775af604ec3053fe5f040f77db7c0b9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:55.320746+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "VN", "alpha3": "VNM", "name_zh": "越南", "name_en": "Vietnam"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "VN", "alpha3": "VNM", "name_zh": "越南", "name_en": "Vietnam"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:55.352332+00:00", "published_at_raw": "2025-06-20T07:52:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "VN", "alpha3": "VNM", "name_zh": "越南", "name_en": "Vietnam", "start": 20, "end": 27, "matched_text": "Vietnam", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "VN", "alpha3": "VNM", "name_zh": "越南", "name_en": "Vietnam", "start": 0, "end": 7, "matched_text": "Vietnam", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_6d5fc3da77a2b2a2a819", "record_id": "article_6d5fc3da77a2b2a2", "canonical_url": "https://dialogue.earth/en/pollution/the-homegrown-start-ups-hoping-to-solve-africas-e-waste-crisis", "publisher_url": "https://dialogue.earth/en/pollution/the-homegrown-start-ups-hoping-to-solve-africas-e-waste-crisis", "title_original": "The homegrown start-ups hoping to solve Africa’s e-waste crisis", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-19T16:50:26+00:00", "source_text": "There is no night or day in Ghana’s infamous e-waste graveyard Agbogbloshie . Hundreds of unofficial e-waste pickers scour its sprawling terrain to extract components that contain copper, cobalt, lithium and other precious metals. If it has a circuit board or battery, it is fair game. These components fetch a decent price on the black market , where demand is high. Africa has an e-waste problem. Collection and recycling are mostly controlled by informal actors who often lack knowledge of the health and environmental dangers posed by improper handling. Hussein Apeh, supervisor and operations officer at Hinckley Recycling, a Nigerian e-waste recycler, said informal pickers are swift and persistent.", "text_kind": "article_excerpt", "text_characters": 705, "text_sha256": "0494ce35eb23a265a68d5277638bf88736cdf9edc28c4cd816c5145b7ccef4e6", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:26.068786+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:26.122606+00:00", "published_at_raw": "2025-06-19T16:50:26", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GH", "alpha3": "GHA", "name_zh": "加纳", "name_en": "Ghana", "start": 28, "end": 33, "matched_text": "Ghana", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_5703c2373f453f7f4c39", "record_id": "article_5703c2373f453f7f", "canonical_url": "https://news.mongabay.com/2025/06/un-ocean-conference-makes-progress-on-protecting-marine-waters", "publisher_url": "https://news.mongabay.com/2025/06/un-ocean-conference-makes-progress-on-protecting-marine-waters", "title_original": "UN Ocean Conference makes progress on protecting marine waters", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-19T15:58:55+00:00", "source_text": "The United Nations Ocean Conference, held June 9-13 in Nice, France, saw some progress on better protecting the hundreds of thousands of species that live in marine waters and the communities that depend on the sea for work or sustenance. New countries committed to the high seas treaty, a moratorium on deep-sea mining and the […]", "text_kind": "source_excerpt", "text_characters": 331, "text_sha256": "c29d0c2418c30c310db39c97e8b0e893301a9e75a23df1188e0521ef616da873", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:55.406639+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "FR", "alpha3": "FRA", "name_zh": "法国", "name_en": "France"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "FR", "alpha3": "FRA", "name_zh": "法国", "name_en": "France"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:55.420334+00:00", "published_at_raw": "2025-06-19T15:58:55", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "FR", "alpha3": "FRA", "name_zh": "法国", "name_en": "France", "start": 61, "end": 67, "matched_text": "France", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_769b3a8d7e6930303e06", "record_id": "article_769b3a8d7e693030", "canonical_url": "https://yaleclimateconnections.org/2025/06/el-huracan-erick-podria-hacer-historia-con-un-potente-impacto-temprano-en-la-temporada-en-mexico", "publisher_url": "https://yaleclimateconnections.org/2025/06/el-huracan-erick-podria-hacer-historia-con-un-potente-impacto-temprano-en-la-temporada-en-mexico", "title_original": "El Huracán Erick podría hacer historia con un potente impacto temprano en la temporada en México", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-18T18:47:29+00:00", "source_text": "Después de alcanzar fuerza de huracán a primera hora del miércoles, Erick podría convertirse en la tormenta más intensa en tocar tierra tan temprano en la temporada a lo largo de la costa del Pacífico de México.", "text_kind": "source_excerpt", "text_characters": 211, "text_sha256": "0357a0442a21daf5b8917da3034f25a6473a6b5ab06b1e9bc194cf10f94f71a8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:48.157268+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:48.183489+00:00", "published_at_raw": "2025-06-18T18:47:29", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_c5134688081838fa6763", "record_id": "article_c5134688081838fa", "canonical_url": "https://news.mongabay.com/2025/06/another-way-to-check-the-health-of-a-coral-reef-study-the-microbes-in-the-seawater", "publisher_url": "https://news.mongabay.com/2025/06/another-way-to-check-the-health-of-a-coral-reef-study-the-microbes-in-the-seawater", "title_original": "Another way to check the health of a coral reef: Study the microbes in the seawater", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-17T19:45:50+00:00", "source_text": "Prochlorococcus, a genus of bacteria that’s key to oxygen production in the ocean, tends to disappear when faced with marine pollution. It lives throughout the sunlit layer of tropical oceans and, while it doesn’t necessarily play a key role in coral biology, its abundance is a sign of a healthy coral reef ecosystem. A growing […]", "text_kind": "source_excerpt", "text_characters": 332, "text_sha256": "53f1883532713ea00ffaabf0004f3c6fee87df600115e0f4a6359421ae5f86c2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:55.843965+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:55.879351+00:00", "published_at_raw": "2025-06-17T19:45:50", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_d9c61d0d550aa9f209c9", "record_id": "article_d9c61d0d550aa9f2", "canonical_url": "https://news.mongabay.com/2025/06/worlds-largest-carbon-credit-deal-under-fire-as-amazon-prosecutors-seek-repeal", "publisher_url": "https://news.mongabay.com/2025/06/worlds-largest-carbon-credit-deal-under-fire-as-amazon-prosecutors-seek-repeal", "title_original": "‘World’s largest’ carbon credit deal under fire as Amazon prosecutors seek repeal", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-17T19:18:22+00:00", "source_text": "A Brazilian state was set to close a massive $180 million carbon credit deal, but now faces an escalating legal battle, accused of violating national laws and Indigenous rights, potentially ruining the project.", "text_kind": "source_excerpt", "text_characters": 210, "text_sha256": "5ca5b1ec8b0c16f657c09dfbf6bc9897ddae4c03be8f50f6e45eb81557081c05", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:55.903768+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$180 million", "start": 45, "end": 57, "evidence": "A Brazilian state was set to close a massive $180 million carbon credit deal, but now faces an escalating legal battle, accused of violating national laws and Indigenous rights, potentially ruining the project.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "carbon_markets", "label_zh": "碳市场", "label_en": "Carbon markets", "start": 58, "end": 71, "evidence": "A Brazilian state was set to close a massive $180 million carbon credit deal, but now faces an escalating legal battle, accused of violating national laws and Indigenous rights, potentially ruining the project."}, {"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 159, "end": 169, "evidence": "it deal, but now faces an escalating legal battle, accused of violating national laws and Indigenous rights, potentially ruining the project."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:55.917326+00:00", "published_at_raw": "2025-06-17T19:18:22", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_bba579b026d962482444", "record_id": "article_bba579b026d96248", "canonical_url": "https://dialogue.earth/en/food/can-chinese-salmon-farming-be-sustainable", "publisher_url": "https://dialogue.earth/en/food/can-chinese-salmon-farming-be-sustainable", "title_original": "Can Chinese salmon farming be sustainable?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-17T16:32:38+00:00", "source_text": "Yaoyao (not her real name) is a white-collar worker with a Shanghai internet company. She’s also a big salmon fan, eating salmon sashimi about three times a month. “I like salmon more than local seafood. It’s rich in beneficial fats yet doesn’t taste fatty,” she told Dialogue Earth. When buying salmon, Yaoyao pays most attention to flavour, freshness and food safety. The origin of the fish and its carbon footprint aren’t concerns for her. She’s not the only fan. Demand for salmon is growing quickly across China, and imports are rising to meet it. In 2023, China overtook Japan and Korea as the biggest market for Atlantic salmon from Norway. That year, its overall imports of Atlantic salmon were up 46% on the previous year, reaching nearly 93,000 tonnes.", "text_kind": "article_excerpt", "text_characters": 762, "text_sha256": "6acc90c421abc8ad8bcfbd9886cc0137bd81f4eeafd4a629fdec4cf65f7e62e6", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:26.321391+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "46%", "start": 706, "end": 709, "evidence": " That year, its overall imports of Atlantic salmon were up 46% on the previous year, reaching nearly 93,000 tonnes.", "interpretation": "not_classified"}, {"value_text": "93,000 tonnes", "start": 748, "end": 761, "evidence": " That year, its overall imports of Atlantic salmon were up 46% on the previous year, reaching nearly 93,000 tonnes.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan"}, {"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}, {"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan"}, {"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:26.353707+00:00", "published_at_raw": "2025-06-17T16:32:38", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 4, "end": 11, "matched_text": "Chinese", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 511, "end": 516, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan", "start": 577, "end": 582, "matched_text": "Japan", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea", "start": 587, "end": 592, "matched_text": "Korea", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway", "start": 640, "end": 646, "matched_text": "Norway", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_dc3ab11b75b4c01868a2", "record_id": "article_dc3ab11b75b4c018", "canonical_url": "https://www.carbonbrief.org/analysis-reform-led-councils-threaten-6gw-of-solar-and-battery-schemes-across-england", "publisher_url": "https://www.carbonbrief.org/analysis-reform-led-councils-threaten-6gw-of-solar-and-battery-schemes-across-england", "title_original": "Analysis: Reform-led councils threaten 6GW of solar and battery schemes across England", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-16T14:45:09+00:00", "source_text": "Reform UK’s local-election victories in May 2025 could put 6 gigawatts (GW) of new clean-energy capacity at risk, according to Carbon Brief analysis. The hard-right populist party took control of 10 English councils in last month’s local elections and has said it will use “ every lever ” to block new wind, solar and battery projects. Those 10 areas have jurisdiction over 5,076 megawatts (MW) of battery schemes, 786MW of solar and 56MW of wind, according to Carbon Brief’s analysis of industry data. While Reform has also pledged to “ban” battery systems, councils do not have direct control over these projects, which are determined by local planning authorities. It could still influence local planning decisions, planning experts tell Carbon Brief.", "text_kind": "article_excerpt", "text_characters": 754, "text_sha256": "ef412e2041ec25d0c493a3606329c0735421bf9dfe5b0905b5a685d1f44dbcc3", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:15.743742+00:00", "extractor_version": "1.0.0", "document_type": "commentary_or_analysis", "document_type_basis": "explicit_title_prefix", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "786MW", "start": 415, "end": 420, "evidence": " Those 10 areas have jurisdiction over 5,076 megawatts (MW) of battery schemes, 786MW of solar and 56MW of wind, according to Carbon Brief’s analysis of industry data.", "interpretation": "not_classified"}, {"value_text": "56MW", "start": 434, "end": 438, "evidence": " Those 10 areas have jurisdiction over 5,076 megawatts (MW) of battery schemes, 786MW of solar and 56MW of wind, according to Carbon Brief’s analysis of industry data.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 89, "end": 95, "evidence": "Reform UK’s local-election victories in May 2025 could put 6 gigawatts (GW) of new clean-energy capacity at risk, according to Carbon Brief analysis. The hard-right populist party took control of 10 English councils in last month’s loc"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:15.772914+00:00", "published_at_raw": "2025-06-16T14:45:09", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 79, "end": 86, "matched_text": "England", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 7, "end": 9, "matched_text": "UK", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_c44edaff14cac5a355fd", "record_id": "article_c44edaff14cac5a3", "canonical_url": "https://insideclimatenews.org/news/15062025/icn-sunday-morning-noaa-hurricane-season", "publisher_url": "https://insideclimatenews.org/news/15062025/icn-sunday-morning-noaa-hurricane-season", "title_original": "What’s In Store This Hurricane Season", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-15T09:00:00+00:00", "source_text": "Uncertainty swirls at the start of this year’s hurricane season. NOAA, the National Oceanic and Atmospheric Administration, forecasts an above-average number of storms, while the Trump administration fires employees, freezes funding and dismantles agencies—like NOAA and FEMA—set up to help. Amy explains the role the federal government now plays in disaster response and recovery, how […]", "text_kind": "source_excerpt", "text_characters": 389, "text_sha256": "81b518b024e3749719c1654891fcb65a8bc874b7d576e1d2c4a59ebe9ff31f88", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:35.840160+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 225, "end": 232, "evidence": "n above-average number of storms, while the Trump administration fires employees, freezes funding and dismantles agencies—like NOAA and FEMA—set up to help. Amy explains the role the federal government now plays in disaster response and "}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:35.857223+00:00", "published_at_raw": "2025-06-15T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_24fa5f183607477ec7d0", "record_id": "article_24fa5f183607477e", "canonical_url": "https://insideclimatenews.org/news/13062025/alabama-mining-regulator-wary-of-possible-trump-cuts", "publisher_url": "https://insideclimatenews.org/news/13062025/alabama-mining-regulator-wary-of-possible-trump-cuts", "title_original": "In a Deep Red State, a Mining Regulator Is Wary of Possible Trump Cuts to Its Budget", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-13T19:31:38+00:00", "source_text": "JASPER, Ala.—If federal funds designated for Alabama’s mining regulator dry up—there is a 16 percent cut in state grants now being debated in Congress—director Kathy Love believes she has a quick and compelling rebuttal. Alabama has primary oversight, as do 14 other states, over its mines but it needs the federal government to help pay […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "465b5844222477518b983e8941d9979144fbc62f48be264e00b7c2f94ea5ae88", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:41.148802+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "16 percent", "start": 90, "end": 100, "evidence": "—If federal funds designated for Alabama’s mining regulator dry up—there is a 16 percent cut in state grants now being debated in Congress—director Kathy Love believes she has a quick and compelling rebuttal.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 114, "end": 119, "evidence": "funds designated for Alabama’s mining regulator dry up—there is a 16 percent cut in state grants now being debated in Congress—director Kathy Love believes she has a quick and compelling rebuttal. Alabama has primary oversight, as do 1"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:41.163259+00:00", "published_at_raw": "2025-06-13T19:31:38", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_12e77ff84c5567e8660c", "record_id": "article_12e77ff84c5567e8", "canonical_url": "https://dialogue.earth/en/energy/argentinas-first-solar-panel-factory-nears-opening", "publisher_url": "https://dialogue.earth/en/energy/argentinas-first-solar-panel-factory-nears-opening", "title_original": "Argentina’s first solar panel factory nears opening", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-13T17:47:10+00:00", "source_text": "Lucas Estrada is confident Argentina’s first solar panel factory will start producing parts this year. He is president of Energía Provincial Sociedad del Estado (EPSE), the state-owned company that will run the factory. EPSE is also in charge of promoting and managing the production and distribution of energy in San Juan, a province close to the Andes in western-central Argentina. In San Juan, the economy is centred around mining, especially of gold and silver, although there are now plans to diversify into minerals crucial to the clean-energy transition, such as copper. Though the province ranks 13th in terms of its population, with just over 4,800 jobs associated with mining in 2024, it often ranked second in mining exports between 2006 and 2023.", "text_kind": "article_excerpt", "text_characters": 758, "text_sha256": "5560976b5b94cc3d40c21a2b373be1e76de655385dd72f54365984dd62674b6b", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:26.364694+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 45, "end": 50, "evidence": "Lucas Estrada is confident Argentina’s first solar panel factory will start producing parts this year. He is president of Energía Provincial Sociedad del Estado (EPSE), the state-owned compa"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:26.401133+00:00", "published_at_raw": "2025-06-13T17:47:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina", "start": 0, "end": 9, "matched_text": "Argentina", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "AR", "alpha3": "ARG", "name_zh": "阿根廷", "name_en": "Argentina", "start": 27, "end": 36, "matched_text": "Argentina", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_b13c2d0cecf556fe7537", "record_id": "article_b13c2d0cecf556fe", "canonical_url": "https://dialogue.earth/en/ocean/reimaanlok-puts-indigenous-voices-at-the-heart-of-ocean-conservation", "publisher_url": "https://dialogue.earth/en/ocean/reimaanlok-puts-indigenous-voices-at-the-heart-of-ocean-conservation", "title_original": "‘Reimaanlok’ puts Indigenous voices at the heart of ocean conservation", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-13T17:09:12+00:00", "source_text": "The Republic of the Marshall Islands was once used by the United States as a convenient place to explode nuclear bombs, with little regard for local interests. But these days, the expectations of the islands’ Indigenous residents is the standard by which conservation success is measured. The site of US bomb tests at Bikini Atoll in the mid-20th century, the Marshall Islands covers only 181 square kilometres of land. However, it also oversees an “exclusive economic zone” which covers two million square kilometres of the Pacific Ocean, roughly 2,000 kilometres due east of the Philippines. With a population of fewer than 40,000 people , but more than a thousand land masses and many more atolls, the republic faces unique conservation challenges.", "text_kind": "article_excerpt", "text_characters": 751, "text_sha256": "cfd763f32e6bc5c57e66c42594ea05d89a2167f29fa011eedd54b247912b9d53", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:26.431808+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines"}, {"alpha2": "MH", "alpha3": "MHL", "name_zh": "马绍尔群岛", "name_en": "Marshall Islands"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 209, "end": 219, "evidence": " with little regard for local interests. But these days, the expectations of the islands’ Indigenous residents is the standard by which conservation success is measured. The site of US bomb tests at Bikini Atoll in the mid-20th century, the"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines"}, {"alpha2": "MH", "alpha3": "MHL", "name_zh": "马绍尔群岛", "name_en": "Marshall Islands"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:26.467896+00:00", "published_at_raw": "2025-06-13T17:09:12", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MH", "alpha3": "MHL", "name_zh": "马绍尔群岛", "name_en": "Marshall Islands", "start": 20, "end": 36, "matched_text": "Marshall Islands", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 58, "end": 71, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "PH", "alpha3": "PHL", "name_zh": "菲律宾", "name_en": "Philippines", "start": 581, "end": 592, "matched_text": "Philippines", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_64b83c67e8bbc11d0d0b", "record_id": "article_64b83c67e8bbc11d", "canonical_url": "https://insideclimatenews.org/news/12062025/inside-clean-energy-big-beautiful-bill-solar-power", "publisher_url": "https://insideclimatenews.org/news/12062025/inside-clean-energy-big-beautiful-bill-solar-power", "title_original": "Tax Cuts in the “Big Beautiful Bill” Could Kill Solar Power Progress", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-12T13:00:00+00:00", "source_text": "The loss of federal tax credits for rooftop solar could wreck the business that Allan O’Shea has built in Michigan. O’Shea, who runs his company along with his wife and sons, has been selling solar panels since the 1990s. He’s witnessed the growing popularity of rooftop solar in the state, which accounted for 19 percent […]", "text_kind": "source_excerpt", "text_characters": 325, "text_sha256": "4e7d14b6137a4bab173df2f5722dff8b849e0eb688ddd6a244b9ea8ebd7a0a5b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:41.492463+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "19 percent", "start": 311, "end": 321, "evidence": " He’s witnessed the growing popularity of rooftop solar in the state, which accounted for 19 percent […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 44, "end": 49, "evidence": "The loss of federal tax credits for rooftop solar could wreck the business that Allan O’Shea has built in Michigan. O’Shea, who runs his company along with his wife and sons, has been selli"}], "policy_tools": [{"id": "subsidy", "label_zh": "补贴与激励", "label_en": "Subsidies and incentives", "start": 20, "end": 30, "evidence": "The loss of federal tax credits for rooftop solar could wreck the business that Allan O’Shea has built in Michigan. O’Shea, who runs his company along with his wife and s"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:41.510885+00:00", "published_at_raw": "2025-06-12T13:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_7838e131dfe80954c749", "record_id": "article_7838e131dfe80954", "canonical_url": "https://yaleclimateconnections.org/2025/06/an-electric-firetruck-puts-out-blazes-in-madison-wisconsin", "publisher_url": "https://yaleclimateconnections.org/2025/06/an-electric-firetruck-puts-out-blazes-in-madison-wisconsin", "title_original": "An electric firetruck puts out blazes in Madison, Wisconsin", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-12T11:00:00+00:00", "source_text": "Transcript: Madison, Wisconsin’s new fire truck seems like any other fire truck – shiny and red with a wailing siren. But unlike most other fire trucks, this one runs on electricity instead of diesel fuel. Wong: “From the outside, if you didn’t know it was electric, you wouldn’t really know.” That’s Matt Wong of the Madison Fire Department . The department started testing a prototype electric fire truck a few years ago and put this new production model truck into service in February. Wong says it’s fit into their operations seamlessly. Wong: “We have never run the thing out of battery, even on the prototype version on electric driving mode. … I don’t know if we’ve ever got it below 50% in our daily usage.” But the truck has a backup diesel engine, just in case.", "text_kind": "article_excerpt", "text_characters": 771, "text_sha256": "1ad5ad277bb03b823664eee01e62f868f9f94026926f11c06f94dcf966769c6c", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:48.928597+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "50%", "start": 691, "end": 694, "evidence": " … I don’t know if we’ve ever got it below 50% in our daily usage.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:48.983716+00:00", "published_at_raw": "2025-06-12T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_11e8da5ab500f2b306eb", "record_id": "article_11e8da5ab500f2b3", "canonical_url": "https://insideclimatenews.org/news/12062025/alabama-camp-hill-water-access", "publisher_url": "https://insideclimatenews.org/news/12062025/alabama-camp-hill-water-access", "title_original": "In Majority-Black Camp Hill, a Young Mayor Fights for Water", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-12T09:00:00+00:00", "source_text": "CAMP HILL, Ala.—A dispute over soaring water bills for this town’s 1,000 residents has ended up in court this summer after Mayor Messiah Williams-Cole said that his town’s water contract has been violated by its neighbors in Dadeville, who control the flow. The water woes began in January, when a water main break sent Camp […]", "text_kind": "source_excerpt", "text_characters": 328, "text_sha256": "598e32d17e500d9a0685d6d132bdebd99668ac1d73bca12b61b24559a04bc10b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:41.538473+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:41.555753+00:00", "published_at_raw": "2025-06-12T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_e20987be5995665a12e2", "record_id": "article_e20987be5995665a", "canonical_url": "https://yaleclimateconnections.org/2025/06/10-ways-that-trumps-tax-bill-would-undermine-his-energy-promises", "publisher_url": "https://yaleclimateconnections.org/2025/06/10-ways-that-trumps-tax-bill-would-undermine-his-energy-promises", "title_original": "10 ways that Trump’s tax bill would undermine his energy promises", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-11T14:41:02+00:00", "source_text": "President Donald Trump has promised to reduce gas prices , improve energy security , create domestic manufacturing jobs , boost the economy, and ensure that Americans breathe the cleanest air . But by gutting the Inflation Reduction Act , or IRA, Congress’ big new budget bill would undermine all of these objectives – and more. House Republicans’ top two priorities are to extend the soon-to-expire tax cuts that they passed in 2017, and to minimize the amount that doing so will add to the nation’s over $36 trillion in debt . The massive budget bill they narrowly passed in May is their effort to achieve both.", "text_kind": "article_excerpt", "text_characters": 613, "text_sha256": "894dffef6d19a8a0e8e674993dc4b983dc5cc75db411f8778df1062ea3cdc6da", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:49.051552+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$36 trillion", "start": 506, "end": 518, "evidence": " House Republicans’ top two priorities are to extend the soon-to-expire tax cuts that they passed in 2017, and to minimize the amount that doing so will add to the nation’s over $36 trillion in debt .", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 67, "end": 73, "evidence": "President Donald Trump has promised to reduce gas prices , improve energy security , create domestic manufacturing jobs , boost the economy, and ensure that Americans breathe the cleanest air . But by gutting the "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:49.104051+00:00", "published_at_raw": "2025-06-11T14:41:02", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_daac4f9cb23aa40a7b6f", "record_id": "article_daac4f9cb23aa40a", "canonical_url": "https://news.mongabay.com/2025/06/resilient-forests-are-key-to-ecological-economic-and-social-resilience-report-finds", "publisher_url": "https://news.mongabay.com/2025/06/resilient-forests-are-key-to-ecological-economic-and-social-resilience-report-finds", "title_original": "Resilient forests are key to ecological, economic and social resilience, report finds", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-10T23:37:22+00:00", "source_text": "The vital role forests play in providing habitat for biodiversity, storing carbon and supporting cultures also buttresses global society economically and socially, according to a new report by authors at the International Union of Forest Research Organizations. But in making those vital connections, the authors also bring together data showing how humanity’s cumulative negative impacts […]", "text_kind": "source_excerpt", "text_characters": 392, "text_sha256": "ad31d081be69cb939d26069bdd0d25b24799a10d8369d711c68c3d13cd2bf468", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:03.330798+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:52:03.360258+00:00", "published_at_raw": "2025-06-10T23:37:22", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_908667374a7ffbfb26e6", "record_id": "article_908667374a7ffbfb", "canonical_url": "https://news.mongabay.com/2025/06/seventy-southern-white-rhinos-arrive-at-their-new-home-in-rwanda-from-south-africa", "publisher_url": "https://news.mongabay.com/2025/06/seventy-southern-white-rhinos-arrive-at-their-new-home-in-rwanda-from-south-africa", "title_original": "Seventy southern white rhinos arrive at their new home in Rwanda from South Africa", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-06-10T16:27:48+00:00", "source_text": "Seventy southern white rhinos have successfully completed a journey from South Africa to Rwanda’s Akagera National Park. It’s the first international translocation from Platinum Rhino, a massive captive breeding operation that was put up for auction in 2023, after years of financial difficulties. When no bidders came forward, African Parks bought the 7,800-hectare property, which […]", "text_kind": "source_excerpt", "text_characters": 386, "text_sha256": "e8979ab0a10582a9b97b1aa72a19ff153e1c6d4f68ea940a36531e2c7b1a196e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:03.418678+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "RW", "alpha3": "RWA", "name_zh": "卢旺达", "name_en": "Rwanda"}, {"alpha2": "ZA", "alpha3": "ZAF", "name_zh": "南非", "name_en": "South Africa"}], "governance_themes": [], "policy_tools": [], "policy_sta