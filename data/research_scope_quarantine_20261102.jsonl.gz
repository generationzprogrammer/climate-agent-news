{"text_id": "text_55d78ea45fd6b0a5ea47", "record_id": "article_55d78ea45fd6b0a5", "canonical_url": "https://insideclimatenews.org/news/08082026/gas-dominates-pjm-interconnections-reformed-grid-queue", "publisher_url": "https://insideclimatenews.org/news/08082026/gas-dominates-pjm-interconnections-reformed-grid-queue", "title_original": "Natural Gas Dominates PJM’s First Reformed Grid Queue, Driven by Data-Center Demand", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-08T08:55:00+00:00", "source_text": "Natural gas surged to the top in the first round of power projects accepted into PJM Interconnection’s reformed interconnection process, making up nearly half of the more than 200 gigawatts of capacity qualified for study. Battery storage and solar trail natural gas, according to the latest figures by the grid operator. The picture stands in […]", "text_kind": "source_excerpt", "text_characters": 347, "text_sha256": "0f3ada575458f2f82e544a856dbd2621343e5a0575c2f616a30e85e0c8256f90", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:29.227070+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 243, "end": 248, "evidence": " half of the more than 200 gigawatts of capacity qualified for study. Battery storage and solar trail natural gas, according to the latest figures by the grid operator. The picture stands in […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:29.238403+00:00", "published_at_raw": "2026-08-08T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_d20498a0e42c6b61a43e", "record_id": "article_d20498a0e42c6b61", "canonical_url": "https://insideclimatenews.org/news/07082026/minnesota-riverview-dairy-expansion-prompts-lawsuits-against-regulators", "publisher_url": "https://insideclimatenews.org/news/07082026/minnesota-riverview-dairy-expansion-prompts-lawsuits-against-regulators", "title_original": "A Minnesota Dairy Company’s Rapid Expansion Is Prompting Lawsuits Against Regulators", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-07T20:15:50+00:00", "source_text": "As Riverview LLP aggressively expands its mega-dairies across the Upper Midwest, advocacy groups and worried residents are mounting legal challenges and orchestrating local efforts to push back. The Minnesota-based dairy giant, the second-largest producer of milk and milk products in the United States, has been on the march in recent years, building and enlarging its […]", "text_kind": "source_excerpt", "text_characters": 373, "text_sha256": "76435a9473d6ccc88921c93b42c705f59b7e730cba8bc459e7d3ceba50e98435", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:29.300758+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:29.315550+00:00", "published_at_raw": "2026-08-07T20:15:50", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 289, "end": 302, "matched_text": "United States", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_bc6b7c21805f2c42c675", "record_id": "article_bc6b7c21805f2c42", "canonical_url": "https://news.mongabay.com/2026/08/as-canadas-captive-belugas-arrive-in-the-us-questions-linger-about-their-future", "publisher_url": "https://news.mongabay.com/2026/08/as-canadas-captive-belugas-arrive-in-the-us-questions-linger-about-their-future", "title_original": "As Canada’s captive belugas arrive in the US, questions linger about their future", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-07T16:16:11+00:00", "source_text": "Thirteen beluga whales, part of a pod of about 30 that were left languishing in a shuttered Canadian theme park, arrived in the U.S. The first transfer of six whales happened on July 21, and another seven were shipped out on August 3. These whales are part of the emergency transfers from Canada’s Marineland to […]", "text_kind": "source_excerpt", "text_characters": 315, "text_sha256": "e068ed14eaa5aebe885c8c733c221b3942a7700a6ff334b36f2cde2f5c1b7f74", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:23.759003+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:23.771840+00:00", "published_at_raw": "2026-08-07T16:16:11", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada", "start": 3, "end": 9, "matched_text": "Canada", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 42, "end": 44, "matched_text": "US", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 128, "end": 132, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "CA", "alpha3": "CAN", "name_zh": "加拿大", "name_en": "Canada", "start": 289, "end": 295, "matched_text": "Canada", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_8cb7053522e5c787c3c7", "record_id": "article_8cb7053522e5c787", "canonical_url": "https://news.mongabay.com/2026/08/how-social-media-and-parrotfish-poop-are-protecting-the-maldives", "publisher_url": "https://news.mongabay.com/2026/08/how-social-media-and-parrotfish-poop-are-protecting-the-maldives", "title_original": "How social media and parrotfish poop are protecting the Maldives", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-06T23:17:21+00:00", "source_text": "It started six years ago when Shaha Hashim began seeing posts across social media: Vulnerable and protected species were being fished throughout the atoll islands of the Maldives, and some were even turning up in fish markets. This included animals like the giant clam (genus Tridacna), Napoleon wrasse (Cheilinus undulatus), and even species of parrotfish […]", "text_kind": "source_excerpt", "text_characters": 360, "text_sha256": "0e0a202a00127f1940a124b3f4d95315f21d1d7e231fb493edef9ddee0d9e3a2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:23.825419+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MV", "alpha3": "MDV", "name_zh": "马尔代夫", "name_en": "Maldives"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MV", "alpha3": "MDV", "name_zh": "马尔代夫", "name_en": "Maldives"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:23.854871+00:00", "published_at_raw": "2026-08-06T23:17:21", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MV", "alpha3": "MDV", "name_zh": "马尔代夫", "name_en": "Maldives", "start": 56, "end": 64, "matched_text": "Maldives", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "MV", "alpha3": "MDV", "name_zh": "马尔代夫", "name_en": "Maldives", "start": 170, "end": 178, "matched_text": "Maldives", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_06f191fb7bca64e10468", "record_id": "article_06f191fb7bca64e1", "canonical_url": "https://dialogue.earth/en/forests/what-makes-multinational-companies-conserve-mangroves-in-india", "publisher_url": "https://dialogue.earth/en/forests/what-makes-multinational-companies-conserve-mangroves-in-india", "title_original": "What makes multinational companies conserve mangroves in India?", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-06T19:02:47+00:00", "source_text": "It’s mid-July, and heavy monsoon rains lash the coast of Maharashtra. Kailas Gawand meets us in Mankule, four kilometres from his village of Hashiware. Here he points towards the submerged landscape around his village, much of which becomes difficult to reach during the rainy season. Gawand recalls how a coastal bund failed in 1990, allowing seawater to inundate what was once fertile agricultural land in the area. But the intrusion of seawater has also transformed the landscape. Saltwater mangroves, which can buffer the coast from storms, began taking root on abandoned farmlands, including Gawand’s two-hectare plot. Hashiware and its surrounding areas have since survived powerful cyclones making land on India’s western coast, including Nisarga in 2020 and Tauktae in 2021.", "text_kind": "article_excerpt", "text_characters": 782, "text_sha256": "224ab47053791136c64886853c8a650b7a81289bf00b63a1c43e619c00e89f67", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:27.973667+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:27.992014+00:00", "published_at_raw": "2026-08-06T19:02:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 57, "end": 62, "matched_text": "India", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 713, "end": 718, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_3ff6709a7141e0558d7b", "record_id": "article_3ff6709a7141e055", "canonical_url": "https://news.mongabay.com/2026/08/global-hunger-levels-fall-but-africa-still-lags-behind-un-report-finds", "publisher_url": "https://news.mongabay.com/2026/08/global-hunger-levels-fall-but-africa-still-lags-behind-un-report-finds", "title_original": "Global hunger levels fall but Africa still lags behind, UN report finds", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-04T13:22:06+00:00", "source_text": "In its latest report on food security and nutrition around the world, the UN’s Food and Agriculture Organization says the number of people facing hunger globally has declined for the third consecutive year, but Africa still has the highest number of people with insufficient food. The FAO report estimated that 20% of Africans faced hunger […]", "text_kind": "source_excerpt", "text_characters": 343, "text_sha256": "bfb17373cff8a6b1f37f9b7ae7aca271cd92ddc4d7caa48dbd5cf50981c962b5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:24.089803+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "20%", "start": 311, "end": 314, "evidence": " The FAO report estimated that 20% of Africans faced hunger […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:24.119756+00:00", "published_at_raw": "2026-08-04T13:22:06", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_7f8278ca832ffa1180ca", "record_id": "article_7f8278ca832ffa11", "canonical_url": "https://yaleclimateconnections.org/2026/08/last-chance-help-me-cover-hurricanes", "publisher_url": "https://yaleclimateconnections.org/2026/08/last-chance-help-me-cover-hurricanes", "title_original": "Last chance: Help me cover hurricanes", "title_zh": "极端天气风险出现新动态", "title_en": null, "summary_zh": "这条情报聚焦洪水、强降雨或风暴造成的气候风险。需要重点关注其对政策执行、谈判表述或风险研判的影响。", "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-08-01T11:00:00+00:00", "source_text": "Folks, Season after season, readers like you have shown me that you value my coverage of hurricanes and other extreme weather. You’ve used it to stay informed and keep your loved ones safe. Now, I’m asking for your help to keep this coverage going and growing. Today is the final day of our fundraiser for extreme weather coverage, and we’re hoping to add a few more donors to help us hit our $10,000 matching challenge. Will you be one of them? Donate We know that this is a time of great uncertainty, so anything you can spare is appreciated, but if you can become a monthly donor at $15 a month or make a one-time donation of $50, that would make a huge difference to our essential hurricane coverage.", "text_kind": "article_excerpt", "text_characters": 704, "text_sha256": "1c434fbb97e92f8d7b867df2de848d9963ce498628cd6fd52e62471ce3e777c5", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:44.156710+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:44.250491+00:00", "published_at_raw": "2026-08-01T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_015622cef664bfdba263", "record_id": "article_015622cef664bfdb", "canonical_url": "https://insideclimatenews.org/news/31072026/colorado-river-final-environmental-impact-statement", "publisher_url": "https://insideclimatenews.org/news/31072026/colorado-river-final-environmental-impact-statement", "title_original": "Federal Plan Makes Steep Colorado River Water Cuts to Arizona, California and Nevada", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-31T22:49:31+00:00", "source_text": "Water users in the American Southwest confronted on Friday the strong possibility that cities and farms in the region must reduce Colorado River use by hundreds of billions of gallons after the Trump administration released a new management plan for the coming decade. The document, published by the federal Bureau of Reclamation, outlines a 10-year […]", "text_kind": "source_excerpt", "text_characters": 353, "text_sha256": "9f3a1d3fd1b9c0345aa25768ac48fc7b99deace9fa4df39b5d63e7c3e88dabc4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:30.034113+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:30.049895+00:00", "published_at_raw": "2026-07-31T22:49:31", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 63, "end": 73, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_78d83ef5b5e61f64453c", "record_id": "article_78d83ef5b5e61f64", "canonical_url": "https://insideclimatenews.org/news/31072026/washington-state-data-centers-environmental-justice", "publisher_url": "https://insideclimatenews.org/news/31072026/washington-state-data-centers-environmental-justice", "title_original": "More Than Half of Washington State’s Data Centers Are Located in Environmental Justice Areas", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-31T16:57:14+00:00", "source_text": "In central and eastern Washington, cheap electricity from the Bonneville Power Administration and its network of dams has long been attractive to the companies behind data centers, like Microsoft and Amazon, both headquartered in the state. But now, as hyperscale data centers spread across the country, concerns are growing about the impact that these operations—sometimes […]", "text_kind": "source_excerpt", "text_characters": 377, "text_sha256": "560b6277d1a91b422605316f3d7815ea84b2ef26f219633cf361cde3a304a1e5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:30.222956+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:30.236311+00:00", "published_at_raw": "2026-07-31T16:57:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_ee05e4cbdaec4e4ed0ff", "record_id": "article_ee05e4cbdaec4e4e", "canonical_url": "https://insideclimatenews.org/news/31072026/georgia-data-center-private-power-plant", "publisher_url": "https://insideclimatenews.org/news/31072026/georgia-data-center-private-power-plant", "title_original": "Georgia’s First ‘Pop-Up’ Power Plant for Data Centers Faces Scrutiny", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-31T09:00:00+00:00", "source_text": "As utilities struggle to keep pace with the explosive electricity demand from AI data centers, developers are increasingly bringing their own power. In Georgia, the first known company to test that strategy has already run into trouble. Georgia has become a hotspot for data center development, but long waits for electric grid connections are pushing […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "056d67d684c3e9ad36335a14cb8836e7102f32752c033ed056fbc2f66985eb38", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:30.288626+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_colle