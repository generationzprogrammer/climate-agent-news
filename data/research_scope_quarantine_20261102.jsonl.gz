{"text_id": "text_73dc09bb8b33be5c5b68", "record_id": "article_73dc09bb8b33be5c", "canonical_url": "https://insideclimatenews.org/news/07102025/epa-drops-coke-plant-air-quality-monitoring", "publisher_url": "https://insideclimatenews.org/news/07102025/epa-drops-coke-plant-air-quality-monitoring", "title_original": "EPA Drops Planned Delay in Compliance With Fenceline Monitoring at Coke Plants", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-07T15:20:17+00:00", "source_text": "Public health advocates pushed back when the U.S. Environmental Protection Agency said it planned to delay for two years a requirement that steel companies monitor air quality at the perimeters of their 11 coke plants in Western Pennsylvania and across the country. Two groups sued. Now, the EPA has reversed course. The deadline to begin […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "1305d34bc307ed739d92df1581a9a4314e39a586b41636a138b045b0464bd7a5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:14.592325+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 140, "end": 145, "evidence": "Environmental Protection Agency said it planned to delay for two years a requirement that steel companies monitor air quality at the perimeters of their 11 coke plants in Western Pennsylvania and across the country. Two groups sued. No"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:14.606508+00:00", "published_at_raw": "2025-10-07T15:20:17", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 45, "end": 49, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_b665d1184390976005a7", "record_id": "article_b665d11843909760", "canonical_url": "https://yaleclimateconnections.org/2025/10/central-atlantic-disturbance-95l-likely-to-develop", "publisher_url": "https://yaleclimateconnections.org/2025/10/central-atlantic-disturbance-95l-likely-to-develop", "title_original": "Central Atlantic disturbance 95L likely to develop", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-06T15:52:43+00:00", "source_text": "A tropical wave designated Invest 95L by the National Hurricane Center, or NHC, is speeding west-northwest at about 15-20 mph across the central Atlantic. The wave is expected to steadily develop this week, becoming a tropical depression or tropical storm by Thursday, when it will be nearing the northeastern Leeward Islands. Satellite images on Monday showed 95L was well-organized, with plenty of spin and an increasing amount of heavy thunderstorm activity. The system had favorable conditions for development, with moderate wind shear of 10-15 knots, warm ocean temperatures of 29 degrees Celsius (84°F), and a moist atmosphere with a mid-level relative humidity of 70%.", "text_kind": "article_excerpt", "text_characters": 675, "text_sha256": "be215f90f31fb9326ff7c1401a6a6c6b779d1d1328e6b5b16716b50f19eca5ed", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:07.761225+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "70%", "start": 671, "end": 674, "evidence": " The system had favorable conditions for development, with moderate wind shear of 10-15 knots, warm ocean temperatures of 29 degrees Celsius (84°F), and a moist atmosphere with a mid-level relative humidity of 70%.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 567, "end": 578, "evidence": "favorable conditions for development, with moderate wind shear of 10-15 knots, warm ocean temperatures of 29 degrees Celsius (84°F), and a moist atmosphere with a mid-level relative humidity of 70%."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:07.846936+00:00", "published_at_raw": "2025-10-06T15:52:43", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_762a54726b61635a9dfe", "record_id": "article_762a54726b61635a", "canonical_url": "https://news.mongabay.com/2025/10/tony-pritzkers-patient-strategy-for-the-planet", "publisher_url": "https://news.mongabay.com/2025/10/tony-pritzkers-patient-strategy-for-the-planet", "title_original": "Tony Pritzker’s patient strategy for the planet", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-06T01:28:44+00:00", "source_text": "Tony Pritzker approaches environmental philanthropy like a patient strategist. A scion of one of America’s best-known business families, he has spent decades moving between boardrooms, laboratories, and community meetings, applying the training of an engineer to problems that range from stormwater treatment in Los Angeles to packaging waste in global supply chains. Guided less by […]", "text_kind": "source_excerpt", "text_characters": 386, "text_sha256": "f5dfdb8a3315fbbfa89757c6dd9de5bc4bbfd66ac826c1f3313b88d6b70099dd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:53.230245+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:53.249422+00:00", "published_at_raw": "2025-10-06T01:28:44", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_c8c40817fd522c48a7aa", "record_id": "article_c8c40817fd522c48", "canonical_url": "https://news.mongabay.com/2025/10/jane-goodall-quotes-words-from-a-reluctant-global-icon", "publisher_url": "https://news.mongabay.com/2025/10/jane-goodall-quotes-words-from-a-reluctant-global-icon", "title_original": "Jane Goodall quotes: Words from a reluctant global icon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-03T22:29:38+00:00", "source_text": "Over the years, Mongabay staff and contributors have conducted numerous interviews with Jane Goodall. The following is a recap of her ideas and reflections, organized by theme. A list of the interviews and other pieces appears at the end. When Jane Goodall died on October 1st at the age of 91, the tributes were immediate […]", "text_kind": "source_excerpt", "text_characters": 326, "text_sha256": "d28ae46c31f795989544908bf3723714e1cdc0b98069af68ca7f14e6acba4161", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:53.270013+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:53.282624+00:00", "published_at_raw": "2025-10-03T22:29:38", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_f99d37a0f2a8dd150c0c", "record_id": "article_f99d37a0f2a8dd15", "canonical_url": "https://insideclimatenews.org/news/03102025/roadless-rule-reversal-cleveland-national-forest-logging", "publisher_url": "https://insideclimatenews.org/news/03102025/roadless-rule-reversal-cleveland-national-forest-logging", "title_original": "Proposal to Undo Roadless Rule Would Open Some of Southern California’s Last Wild Forests to Development", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-03T09:00:00+00:00", "source_text": "To see what Southern California looked like before millions of homes sprawled through the region, head to Cleveland National Forest. Nestled between Los Angeles and San Diego, the forest’s three districts are a refuge for the region’s wildlife and locals looking to escape the hustle and bustle of the state’s two biggest cities. From above, […]", "text_kind": "source_excerpt", "text_characters": 345, "text_sha256": "911583295dad0ee311ec21d5e6bf79930db71e22798ece2bf015f1ed4ba4a39f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:15.537454+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:15.585783+00:00", "published_at_raw": "2025-10-03T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 59, "end": 69, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 21, "end": 31, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_17fd969229732f750e39", "record_id": "article_17fd969229732f75", "canonical_url": "https://news.mongabay.com/2025/10/how-to-carry-jane-goodalls-light-forward", "publisher_url": "https://news.mongabay.com/2025/10/how-to-carry-jane-goodalls-light-forward", "title_original": "How to carry Jane Goodall’s light forward", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-02T12:23:14+00:00", "source_text": "I find it hard to believe Jane Goodall is gone. She was more than an icon to me. She was a friend, a mentor, and someone whose presence—whether with presidents, students, or my own children—felt like both a gift and a lesson. Our friendship began in the most Jane way possible: an email that opened, […]", "text_kind": "source_excerpt", "text_characters": 303, "text_sha256": "d79f1aa7cbca96b8c340092150e5e10bf86691e0033cc22fb4def6b83e4d29a7", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:53.544452+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:53.556065+00:00", "published_at_raw": "2025-10-02T12:23:14", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_dc851bb95c0e2fd4cba5", "record_id": "article_dc851bb95c0e2fd4", "canonical_url": "https://news.mongabay.com/2025/10/just-as-raja-ampat-fetches-unesco-biosphere-reserve-title-nickel-mining-looms", "publisher_url": "https://news.mongabay.com/2025/10/just-as-raja-ampat-fetches-unesco-biosphere-reserve-title-nickel-mining-looms", "title_original": "Just as Raja Ampat fetches UNESCO Biosphere Reserve title, nickel mining looms", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-02T05:29:08+00:00", "source_text": "JAKARTA — Even as UNESCO hails Raja Ampat as a global conservation model, nickel mining threatens to carve up its forests and coral reefs. On Sept. 27, UNESCO designated 26 new biosphere reserves across 21 countries — the highest number in 20 years. Among them is Raja Ampat, strengthening its place as a flagship site […]", "text_kind": "source_excerpt", "text_characters": 322, "text_sha256": "fa62dcb99a877a42a6a69d7481ff1dced8750168cc776e22f15fdefc39b5b83d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:53.566513+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:53.580636+00:00", "published_at_raw": "2025-10-02T05:29:08", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_8fa1cd1f053f68e773ab", "record_id": "article_8fa1cd1f053f68e7", "canonical_url": "https://insideclimatenews.org/news/01102025/chicago-quantum-campus-community-concerns", "publisher_url": "https://insideclimatenews.org/news/01102025/chicago-quantum-campus-community-concerns", "title_original": "As Chicago Quantum Campus Breaks Ground, Residents Call for Community Benefits", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-01T18:28:31+00:00", "source_text": "CHICAGO—A Silicon Valley startup broke ground Tuesday afternoon at a former steelworks site on the Southeast Side for what is planned as the nation’s first large-scale quantum computing facility. The company—called PsiQuantum—will be the anchor tenant for the Illinois Quantum and Microelectronics Park, a multi-million-dollar effort by lawmakers, universities and the private sector to make […]", "text_kind": "source_excerpt", "text_characters": 395, "text_sha256": "1c78a248f25c8653785772f946fd98b0c6c68cb3eca7c585d2de3aa8207d5e5d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:16.617648+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 76, "end": 81, "evidence": "CHICAGO—A Silicon Valley startup broke ground Tuesday afternoon at a former steelworks site on the Southeast Side for what is planned as the nation’s first large-scale quantum computing facility. The company—called PsiQua"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:16.662604+00:00", "published_at_raw": "2025-10-01T18:28:31", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_d643a2b452b83bb1e2e6", "record_id": "article_d643a2b452b83bb1", "canonical_url": "https://www.carbonbrief.org/antarctic-sea-ice-winter-peak-in-2025-is-third-smallest-on-record", "publisher_url": "https://www.carbonbrief.org/antarctic-sea-ice-winter-peak-in-2025-is-third-smallest-on-record", "title_original": "Antarctic sea ice winter peak in 2025 is third smallest on record", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-01T15:25:27+00:00", "source_text": "Antarctic sea ice has recorded its third-smallest winter peak extent since satellite records began 47 years ago, new data reveals. Provisional data from the US National Snow and Ice Data Center (NSIDC) shows that Antarctic sea ice reached a winter maximum of 17.81m square kilometres (km2) on 17 September. This is 900,000km2 below the 1981-2010 average maximum extent – the historical baseline against which more recent sea ice extent is typically compared. According to one expert, the “lengthening trend of lower Antarctic sea ice poses real concerns regarding stability and melting of the ice sheet”. Meanwhile, at the Earth’s other pole, Arctic sea ice reached its annual minimum on 10 September, ranking as the joint-10th lowest in the satellite record.", "text_kind": "article_excerpt", "text_characters": 759, "text_sha256": "03b363e119d9a6bb0cd0a0c20436882b64fa6ece2b1cfcdec8a3fe38db56b235", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:07.899396+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:07.917786+00:00", "published_at_raw": "2025-10-01T15:25:27", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 157, "end": 159, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_91994aa98c1cac8800d7", "record_id": "article_91994aa98c1cac88", "canonical_url": "https://insideclimatenews.org/news/01102025/pennsylvania-roadway-regulations-oil-gas-brines", "publisher_url": "https://insideclimatenews.org/news/01102025/pennsylvania-roadway-regulations-oil-gas-brines", "title_original": "Appeal Could Make It Easier for Companies to Spread Drilling Fluids on Pennsylvania Roadways", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-01T08:55:00+00:00", "source_text": "In rural Western Pennsylvania, communities routinely spray briny fluids on unpaved backroads to control dust in the warmer months and ice in the winter. Often, those liquids are drilling byproducts from nearby conventional oil and gas wells. That mostly comes courtesy of a loophole in state law that opponents say poses a risk to human […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "8b0b01c2a1aa85dba915aa265578422f0590726852b55009206e936ffb17b2c9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:16.949500+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:16.989088+00:00", "published_at_raw": "2025-10-01T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_b6f04bf26e6999915484", "record_id": "article_b6f04bf26e699991", "canonical_url": "https://news.mongabay.com/2025/10/anguish-for-residents-as-thailands-most-polluting-coal-plant-gets-new-lease-of-life", "publisher_url": "https://news.mongabay.com/2025/10/anguish-for-residents-as-thailands-most-polluting-coal-plant-gets-new-lease-of-life", "title_original": "Anguish for residents as Thailand’s most polluting coal plant gets new lease of life", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-01T04:15:06+00:00", "source_text": "MAE MOH, Thailand — Thailand has announced it will delay the decommissioning of several coal-fired units at the 2,400-megawatt Mae Moh power plant in Lampang province, prompting fears among communities who have dealt with health problems linked to the plant for decades. The Aug. 21 announcement, made by the National Energy Policy Committee, also undermines pledges […]", "text_kind": "source_excerpt", "text_characters": 370, "text_sha256": "351eb8d8090387cad32e8dac305e83c4c2c2b1a3afeeaed681719034876c2271", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:53.676751+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 88, "end": 92, "evidence": "MAE MOH, Thailand — Thailand has announced it will delay the decommissioning of several coal-fired units at the 2,400-megawatt Mae Moh power plant in Lampang province, prompting fears among communities who have dealt with health pro"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:53.692645+00:00", "published_at_raw": "2025-10-01T04:15:06", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand", "start": 25, "end": 33, "matched_text": "Thailand", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "TH", "alpha3": "THA", "name_zh": "泰国", "name_en": "Thailand", "start": 9, "end": 17, "matched_text": "Thailand", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_d44d525e19769432ccb7", "record_id": "article_d44d525e19769432", "canonical_url": "https://insideclimatenews.org/news/30092025/government-shutdown-threatens-environment-science-agencies", "publisher_url": "https://insideclimatenews.org/news/30092025/government-shutdown-threatens-environment-science-agencies", "title_original": "Government Shutdown Threatens Further Destruction of Environment and Science Agencies, Advocates Warn", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-30T22:29:05+00:00", "source_text": "A government shutdown will likely lead to further dismantling of federal environmental science, enforcement and conservation agencies, advocates warned this week. Previous government shutdowns have seen federal employees furloughed until funding resumes. But this time, Russell Vought, director of the Office of Management and Budget, has told federal agencies to prepare for widespread layoffs. “That […]", "text_kind": "source_excerpt", "text_characters": 405, "text_sha256": "8195e2b97587727fabc87bca35da748038d9e7b489403e51ac046735980e1010", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:17.095269+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 238, "end": 245, "evidence": "ned this week. Previous government shutdowns have seen federal employees furloughed until funding resumes. But this time, Russell Vought, director of the Office of Management and Budget, has told federal agencies to prepare for widesprea"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:17.138574+00:00", "published_at_raw": "2025-09-30T22:29:05", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_111863618f1ec4c10708", "record_id": "article_111863618f1ec4c1", "canonical_url": "https://insideclimatenews.org/news/30092025/chesapeake-bay-program-restoration-crossroads", "publisher_url": "https://insideclimatenews.org/news/30092025/chesapeake-bay-program-restoration-crossroads", "title_original": "The Chesapeake Bay Program Reaches a Crossroads", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-30T08:55:00+00:00", "source_text": "The management board of the Chesapeake Bay Program will meet this week to hammer out the next iteration of the agreement that has governed the restoration of the watershed for more than four decades. But this year, they face dual challenges of getting states to sign off on a robust, accountability-driven pact while anticipating a […]", "text_kind": "source_excerpt", "text_characters": 335, "text_sha256": "0fbb2d33ebe272c1061f92d893dcf351047d2fbef79415c211718cd6615b44f4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:17.591472+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:17.655541+00:00", "published_at_raw": "2025-09-30T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_5b4ce89c52d811c9013d", "record_id": "article_5b4ce89c52d811c9", "canonical_url": "https://yaleclimateconnections.org/2025/09/while-humberto-rages-another-fast-evolving-system-bears-a-close-watch", "publisher_url": "https://yaleclimateconnections.org/2025/09/while-humberto-rages-another-fast-evolving-system-bears-a-close-watch", "title_original": "As Humberto rages, another fast-evolving system bears a close watch", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-09-26T18:49:45+00:00", "source_text": "Invest 94L will likely become a tropical storm over the Bahamas this weekend, and it might reach the Southeast U.S. as a hurricane by Monday, but the uncertainty is high.", "text_kind": "source_excerpt", "text_characters": 170, "text_sha256": "1167bafe26268b862be8b30765f640ada186736b94de1028b62e2ec7b0d9030e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:09.571253+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "BS", "alpha3": "BHS", "name_zh": "巴哈马", "name_en": "Bahamas"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "BS", "alpha3": "BHS", "name_zh": "巴哈马", "name_en": "Bahamas"}], "annotation_met