{"text_id": "text_99916b01c63d8ecbf1c9", "record_id": "article_99916b01c63d8ecb", "canonical_url": "https://news.mongabay.com/2024/01/really-a-sad-day-as-norway-votes-to-allow-deep-sea-mining-in-arctic-waters", "publisher_url": "https://news.mongabay.com/2024/01/really-a-sad-day-as-norway-votes-to-allow-deep-sea-mining-in-arctic-waters", "title_original": "‘Really a sad day’ as Norway votes to allow deep-sea mining in Arctic waters", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-09T20:11:59+00:00", "source_text": "Norway’s parliament has officially voted to allow deep-sea mining to go forward in the Norwegian Sea, despite warnings from scientists and conservationists that it could damage the marine environment. This result was already anticipated in December 2023 after Norway’s minority government negotiated a deal with opposition parties to open up the ocean off Norway’s coast […]", "text_kind": "source_excerpt", "text_characters": 374, "text_sha256": "586042166f68878dfcf14c80848b181b12cbc30460d6b16b241d6feaef0cbcb4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:29.469331+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:29.484501+00:00", "published_at_raw": "2024-01-09T20:11:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway", "start": 22, "end": 28, "matched_text": "Norway", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "NO", "alpha3": "NOR", "name_zh": "挪威", "name_en": "Norway", "start": 0, "end": 6, "matched_text": "Norway", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_d3f9d441d2b769edca0c", "record_id": "article_d3f9d441d2b769ed", "canonical_url": "https://yaleclimateconnections.org/2024/01/gasoline-is-cheap-right-now-but-charging-an-ev-is-still-cheaper", "publisher_url": "https://yaleclimateconnections.org/2024/01/gasoline-is-cheap-right-now-but-charging-an-ev-is-still-cheaper", "title_original": "Gasoline is cheap right now — but charging an EV is still cheaper", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-01-08T12:00:00+00:00", "source_text": "It was easy to make the case for the low cost of electric vehicle charging way back in 2022 when gasoline prices were high and charging an EV was about 70% cheaper than filling up at the pump. But now that the price of gasoline is dipping below $3 per gallon, is it still cheaper to fill up a car on electrons rather than gasoline? The answer is yes — by a lot. By far the least expensive and least polluting option is to get around on foot, bike, or public transit. But if you need a personal vehicle, EVs cost less to drive compared to a similar gasoline-powered vehicle, and they also emit less carbon pollution. The map below shows the price of charging an EV expressed in “eGallons,” which is the cost of charging an EV by an amount equivalent to one gallon of gasoline.", "text_kind": "article_excerpt", "text_characters": 775, "text_sha256": "5b1565c044a64ca93a32e4fbc0f2a9f6d86c6b43fa1ffd6dd0e2c99bc7f3bbdc", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:43.098987+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "70%", "start": 152, "end": 155, "evidence": "It was easy to make the case for the low cost of electric vehicle charging way back in 2022 when gasoline prices were high and charging an EV was about 70% cheaper than filling up at the pump.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:43.125612+00:00", "published_at_raw": "2024-01-08T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
