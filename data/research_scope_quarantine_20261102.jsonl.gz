{"text_id": "text_36d6073a96cce001e6b2", "record_id": "article_36d6073a96cce001", "canonical_url": "https://news.mongabay.com/2025/04/for-scandal-ridden-carbon-credit-industry-amazon-restoration-offers-redemption", "publisher_url": "https://news.mongabay.com/2025/04/for-scandal-ridden-carbon-credit-industry-amazon-restoration-offers-redemption", "title_original": "For scandal-ridden carbon credit industry, Amazon restoration offers redemption", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-04-09T07:00:49+00:00", "source_text": "As REDD projects around the world face setbacks, restoration projects in the Amazon are flourishing as a means of reviving market confidence in forest-based carbon credits.", "text_kind": "source_excerpt", "text_characters": 172, "text_sha256": "1ecd12dae110c584d1578eb1f7a21e1ed8cebc52293bff36e85102bda95dcfa1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:36.575665+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "carbon_markets", "label_zh": "碳市场", "label_en": "Carbon markets", "start": 157, "end": 170, "evidence": "ts in the Amazon are flourishing as a means of reviving market confidence in forest-based carbon credits."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified",