{"text_id": "text_eff48cc7b56a768fa05b", "record_id": "article_eff48cc7b56a768f", "canonical_url": "https://insideclimatenews.org/news/22082025/great-lakes-water-demand-data-centers", "publisher_url": "https://insideclimatenews.org/news/22082025/great-lakes-water-demand-data-centers", "title_original": "Water Management in Great Lakes States Deserves a Closer Look, Group Says", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-08-22T08:50:00+00:00", "source_text": "Demand for water in Great Lakes states is likely to spike from data centers, mining and other uses, and officials should take a more proactive management approach to stave off shortages, according to a new report published by the nonprofit Alliance for the Great Lakes. Municipalities will need more information about usage, and potentially will […]", "text_kind": "source_excerpt", "text_characters": 349, "text_sha256": "5ca9d50bd5ca6072f147ad70b3d8a4df99c990aae6efb7ecbaabf6b48291b947", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:55.167889+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_