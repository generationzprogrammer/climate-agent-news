{"text_id": "text_8b3dd596a548e5dfe06b", "record_id": "article_8b3dd596a548e5df", "canonical_url": "https://insideclimatenews.org/news/08072025/todays-climate-flash-floods-texas-summer-camp", "publisher_url": "https://insideclimatenews.org/news/08072025/todays-climate-flash-floods-texas-summer-camp", "title_original": "Texas Flooding Signals Growing Extreme Weather Threats to Summer Camps", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-08T20:02:35+00:00", "source_text": "The deluge hit in the early morning hours of July 4. In the Hill Country region of central Texas, torrential rains triggered flash flooding that devastated communities along the Guadalupe River. Around 3 a.m., the river climbed about 1 foot every 5 minutes in Hunt, Texas, according to the National Weather Service. Water levels ultimately […]", "text_kind": "source_excerpt", "text_characters": 343, "text_sha256": "800d0f7f6f43cc81169f80d23a01046a9bb8d113647bf7ce21306bca36983208", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:24.232299+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 131, "end": 136, "evidence": " of July 4. In the Hill Country region of central Texas, torrential rains triggered flash flooding that devastated communities along the Guadalupe River. Around 3 a.m., the river climbed about 1 foot every 5 minutes in Hunt, Texas, acc"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:51:24.249175+00:00", "published_at_raw": "2025-07-08T20:02:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 5, "matched_text": "Texas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 91, "end": 96, "matched_text": "Texas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.574692+00:00"}
{"text_id": "text_75aa76e8aeee6aa95713", "record_id": "article_75aa76e8aeee6aa9", "canonical_url": "https://yaleclimateconnections.org/2025/07/trump-just-gave-a-huge-gift-to-chinas-economy", "publisher_url": "https://yaleclimateconnections.org/2025/07/trump-just-gave-a-huge-gift-to-chinas-economy", "title_original": "Trump just gave a huge gift to China’s economy", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-07-08T19:50:33+00:00", "source_text": "Chinese manufacturers are already dominating clean tech industries. The GOP’s huge new tax and spending law will make it even harder for U.S. companies to compete.", "text_kind": "source_excerpt", "text_characters": 163, "text_sha256": "3a62f64e86c6c4744562c5c7d6f202594fa409cbddd59098ec4eef489f764d57", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:42.101749+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_