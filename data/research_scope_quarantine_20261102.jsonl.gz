{"text_id": "text_9cfbb1c585a0c3078b90", "record_id": "article_9cfbb1c585a0c307", "canonical_url": "https://news.mongabay.com/2024/05/indonesia-civil-society-groups-raise-concerns-over-proposed-borneo-nuclear-reactor", "publisher_url": "https://news.mongabay.com/2024/05/indonesia-civil-society-groups-raise-concerns-over-proposed-borneo-nuclear-reactor", "title_original": "Indonesia civil society groups raise concerns over proposed Borneo nuclear reactor", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-14T00:34:45+00:00", "source_text": "JAKARTA — Civil society organizations in Indonesia staged protests in late April to raise awareness of a planned nuclear plant near Pontianak, capital of West Kalimantan province on the island of Borneo. “We are advocating that West Kalimantan be kept away from the threat of a nuclear radiation disaster. Indonesia is not Chernobyl,” said Hendrikus […]", "text_kind": "source_excerpt", "text_characters": 353, "text_sha256": "fd7782458c3838da0c8471c31ae70aa86f766650b0310f384d3acc7037b2b823", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:33.689019+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "na