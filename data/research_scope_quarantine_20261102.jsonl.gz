{"text_id": "text_e86d1ecf9c95bffb2c5b", "record_id": "article_e86d1ecf9c95bffb", "canonical_url": "https://insideclimatenews.org/news/03022026/congress-forests-act-wildfire", "publisher_url": "https://insideclimatenews.org/news/03022026/congress-forests-act-wildfire", "title_original": "Wildfire Urgency Unites Congress. The ‘Fix Our Forests’ Act Does Not.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-03T22:15:33+00:00", "source_text": "Lawmakers from both parties agreed at a congressional hearing Tuesday that the federal government must act to address the growing threat of catastrophic wildfires, but they were sharply divided over how, and whether pending legislation known as the Fix Our Forests Act offers the right path forward. The House of Representatives passed the FOFA legislation […]", "text_kind": "source_excerpt", "text_characters": 360, "text_sha256": "c6441593068af13b8eaff87e8948210074d554d892b49e87939ef249c35acac2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:54.163560+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 153, "end": 161, "evidence": "uesday that the federal government must act to address the growing threat of catastrophic wildfires, but they were sharply divided over how, and whether pending legislation known as the Fix Our Forests Act offers the right path forward. T"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:54.190907+00:00", "published_at_raw": "2026-02-03T22:15:33", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_639112db9f8acadd465a", "record_id": "article_639112db9f8acadd", "canonical_url": "https://dialogue.earth/en/energy/the-belt-and-road-boomed-in-2025", "publisher_url": "https://dialogue.earth/en/energy/the-belt-and-road-boomed-in-2025", "title_original": "The Belt and Road boomed in 2025", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-03T18:34:52+00:00", "source_text": "Last year, Chinese companies’ “engagement” in 150 countries involved in the Belt and Road Initiative (BRI) reached its highest level since the BRI was launched 12 years ago. The value of construction deals involving Chinese companies reached USD 128 billion, up 81% on 2024. While investments totalled USD 85 billion, up 62%. The unprecedented boom has been revealed by annual data from the Griffith Asia Institute, an Australian think-tank, and the Green Finance and Development Center, a think-tank hosted in Fudan University, Shanghai. “I did not foresee last year that 2025 would be such a strong year [for BRI engagement],” said report author Christoph Nedopil Wang during an online launch.", "text_kind": "article_excerpt", "text_characters": 695, "text_sha256": "5a22e87e3a7213e7fc107d9316b3c188ab551342392657877acd0f27b56db3aa", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:52.877846+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "128 billion", "start": 246, "end": 257, "evidence": " The value of construction deals involving Chinese companies reached USD 128 billion, up 81% on 2024.", "interpretation": "not_classified"}, {"value_text": "81%", "start": 262, "end": 265, "evidence": " The value of construction deals involving Chinese companies reached USD 128 billion, up 81% on 2024.", "interpretation": "not_classified"}, {"value_text": "85 billion", "start": 306, "end": 316, "evidence": " While investments totalled USD 85 billion, up 62%.", "interpretation": "not_classified"}, {"value_text": "62%", "start": 321, "end": 324, "evidence": " While investments totalled USD 85 billion, up 62%.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:52.919260+00:00", "published_at_raw": "2026-02-03T18:34:52", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 11, "end": 18, "matched_text": "Chinese", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_fe146e79d2c9790dd169", "record_id": "article_fe146e79d2c9790d", "canonical_url": "https://news.mongabay.com/2026/02/when-nature-becomes-a-security-risk", "publisher_url": "https://news.mongabay.com/2026/02/when-nature-becomes-a-security-risk", "title_original": "When nature becomes a security risk", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-02T14:58:27+00:00", "source_text": "Britain’s national security thinking has traditionally been shaped by familiar concerns: hostile states, terrorism, energy supply, and, more recently, cyber threats. A new assessment from the U.K. government adds a different category to that list. Global biodiversity loss and ecosystem collapse, it argues, now pose a direct and growing risk to national security, with implications […]", "text_kind": "source_excerpt", "text_characters": 386, "text_sha256": "49b3cff7530151a093f00ea07b6458f7721ef6b23281fa4464010688073656bd", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:21.310240+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 116, "end": 122, "evidence": "y thinking has traditionally been shaped by familiar concerns: hostile states, terrorism, energy supply, and, more recently, cyber threats. A new assessment from the U.K. government adds a different category to that list. Global biodive"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:21.332160+00:00", "published_at_raw": "2026-02-02T14:58:27", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 0, "end": 7, "matched_text": "Britain", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_51af67adb095f3607a5a", "record_id": "article_51af67adb095f360", "canonical_url": "https://insideclimatenews.org/news/01022026/with-waters-rising-pennsylvanias-historical-treasures-must-adapt-or-collapse", "publisher_url": "https://insideclimatenews.org/news/01022026/with-waters-rising-pennsylvanias-historical-treasures-must-adapt-or-collapse", "title_original": "With Waters Rising, Pennsylvania’s Historical Treasures Must ‘Adapt or Collapse’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-02-01T10:00:00+00:00", "source_text": "PHILADELPHIA—Karen Young stood in a cavernous room perched on the edge of the Schuylkill River that was once a public swimming pool. Abandoned in 1972 after a hurricane, the old natatorium is part of the Fairmount Water Works, an interpretive center and event venue housed in a 200-year-old structure that powered Philadelphia’s municipal water system […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "7c78c5d9fa89ef2874e766cb2481e4718a9fe9c21410cc408c358705d43bb9f9", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:54.452226+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:48:54.476026+00:00", "published_at_raw": "2026-02-01T10:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
