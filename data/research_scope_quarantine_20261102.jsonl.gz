{"text_id": "text_100ad730609179a0bb33", "record_id": "article_100ad730609179a0", "canonical_url": "https://news.mongabay.com/2026/03/sri-lanka-sweats-in-scorching-heat-but-reasons-unlikely-due-to-el-nino", "publisher_url": "https://news.mongabay.com/2026/03/sri-lanka-sweats-in-scorching-heat-but-reasons-unlikely-due-to-el-nino", "title_original": "Sri Lanka sweats in scorching heat, but reasons ‘unlikely due to El Niño’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-03-31T05:44:03+00:00", "source_text": "COLOMBO — Amid the hustle and bustle of Pettah, one of the busiest marketplaces in the Colombo district, Sri Lanka’s commercial region, Sandya Jayasekara was busy cutting king coconuts for her customers. Despite the heat, Sandya must engage in her business outdoors to earn a living and to fund her medical treatment. “I have […]", "text_kind": "source_excerpt", "text_characters": 329, "text_sha256": "04e37e862e033e6edc99df7f3db53402af943032892c0bc300e532bbe5a0c3bf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:48:37.030095+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "LK", "alpha3": "LKA", "name_zh": "斯里兰卡", "name_en": "Sri Lanka"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "LK", "alpha3": "LKA", "name_zh": "斯里兰卡", "name_en": "Sri Lanka"}], "annotation_method": "dictionary-evi