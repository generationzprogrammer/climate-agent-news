{"text_id": "text_7c52d5afa4667c7e5d9e", "record_id": "article_7c52d5afa4667c7e", "canonical_url": "https://news.mongabay.com/2024/08/the-andes-are-a-key-supplier-of-gold-for-the-amazon-basin", "publisher_url": "https://news.mongabay.com/2024/08/the-andes-are-a-key-supplier-of-gold-for-the-amazon-basin", "title_original": "The Andes are a key supplier of gold for the Amazon Basin", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-15T17:00:38+00:00", "source_text": "One of the most remarkable placer gold fields in the world is found in the Andean piedmont in the department of Madre de Dios in southern Peru. Gold was discovered in the 1970s in the District of Huepetuhe, where a small stream that drains into the Río Inambari, approximately 20 kilometers downstream from the narrow […]", "text_kind": "source_excerpt", "text_characters": 321, "text_sha256": "15fdafb154fa380ceb9c040e8518e960e265180013cc94864b1e2440b8bcfa7f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:39.096603+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:39.109324+00:00", "published_at_raw": "2024-08-15T17:00:38", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru", "start": 138, "end": 142, "matched_text": "Peru", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_3496c54bd3702a96e531", "record_id": "article_3496c54bd3702a96", "canonical_url": "https://insideclimatenews.org/news/15082024/kebler-pass-conservation-coalitions-aspen-tree", "publisher_url": "https://insideclimatenews.org/news/15082024/kebler-pass-conservation-coalitions-aspen-tree", "title_original": "What Conservation Coalitions Have Learned from an Aspen Tree", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-15T09:05:00+00:00", "source_text": "On the shoulder of Kebler Pass, about seven miles west of Crested Butte, a giant lounges in the Colorado high country. The Kebler Pass aspen stand covers the equivalent of just over 100 football fields, with over 47,000 aspen trees, populus tremuloides, connected by a single, subterranean root system called a rhizome. The trees are […]", "text_kind": "source_excerpt", "text_characters": 337, "text_sha256": "372e7f4ff751e9fda099ceafeda382b31eca468d7949ba4b4ed6a3043f926dbc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:14.712260+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:14.726056+00:00", "published_at_raw": "2024-08-15T09:05:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_6b2c0af211170103a4c3", "record_id": "article_6b2c0af211170103", "canonical_url": "https://insideclimatenews.org/news/15082024/baltimores-sewer-cleanup-efforts-stalled", "publisher_url": "https://insideclimatenews.org/news/15082024/baltimores-sewer-cleanup-efforts-stalled", "title_original": "As Baltimore’s Sewer System Buckles Under Extreme Weather, City Refuses to Help Residents With Cleanup Efforts", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-15T09:00:00+00:00", "source_text": "A sewage cleanup program meant to assist Baltimore residents with backups in their homes has been in limbo for more than a year because of a deadlock between city authorities, the U.S. Environmental Protection Agency (EPA) and the Maryland Department of the Environment (MDE). The haggling over the future scope of the cleanup program has […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "083df19e71873f1321d79859ac11cab4dc0cd4af7f7a01a90fec7587d215e733", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:14.744940+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:14.762336+00:00", "published_at_raw": "2024-08-15T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 180, "end": 184, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_757b6237090ad3d5cc99", "record_id": "article_757b6237090ad3d5", "canonical_url": "https://yaleclimateconnections.org/2024/08/ernesto-strengthens-on-approach-to-puerto-rico-virgin-islands", "publisher_url": "https://yaleclimateconnections.org/2024/08/ernesto-strengthens-on-approach-to-puerto-rico-virgin-islands", "title_original": "Ernesto strengthens on approach to Puerto Rico, Virgin Islands", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-13T17:25:04+00:00", "source_text": "Tropical Storm Ernesto was organizing at an increasingly rapid clip over the northeast Caribbean on Tuesday, and it’s expected to become a large, powerful, and prolonged hurricane as it barrels northward from the Caribbean starting on Wednesday. A Hurricane Watch was issued Tuesday morning for the U.S. and British Virgin Islands, Vieques, and Culebra, as Ernesto could become a Category 1 storm while passing over or near those islands early Wednesday. Nearby Puerto Rico is predicted to experience somewhat weaker winds on the left-hand (west) side of Ernesto, but widespread gales, torrential rains, and flash flooding will hammer the island. At 11 a.m. EDT Tuesday , Ernesto was centered about 155 miles east-southeast of St.", "text_kind": "article_excerpt", "text_characters": 730, "text_sha256": "663a4e2b8d9698bf3642b93671e38fdf4df905985331e1f11a6002d6ddd3e12f", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:32.855322+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PR", "alpha3": "PRI", "name_zh": "波多黎各", "name_en": "Puerto Rico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "VG", "alpha3": "VGB", "name_zh": "英属维尔京群岛", "name_en": "British Virgin Islands"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 614, "end": 619, "evidence": "n the left-hand (west) side of Ernesto, but widespread gales, torrential rains, and flash flooding will hammer the island. At 11 a.m. EDT Tuesday , Ernesto was centered about 155 miles east-southeast of St."}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PR", "alpha3": "PRI", "name_zh": "波多黎各", "name_en": "Puerto Rico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "VG", "alpha3": "VGB", "name_zh": "英属维尔京群岛", "name_en": "British Virgin Islands"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:32.892153+00:00", "published_at_raw": "2024-08-13T17:25:04", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PR", "alpha3": "PRI", "name_zh": "波多黎各", "name_en": "Puerto Rico", "start": 35, "end": 46, "matched_text": "Puerto Rico", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 299, "end": 303, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "VG", "alpha3": "VGB", "name_zh": "英属维尔京群岛", "name_en": "British Virgin Islands", "s