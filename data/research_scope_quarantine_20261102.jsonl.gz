{"text_id": "text_b53f0d3c9e0eae355e31", "record_id": "article_b53f0d3c9e0eae35", "canonical_url": "https://news.mongabay.com/2026/10/funding-uncertainty-threatens-tasmanias-gains-against-kelp-grazing-sea-urchins", "publisher_url": "https://news.mongabay.com/2026/10/funding-uncertainty-threatens-tasmanias-gains-against-kelp-grazing-sea-urchins", "title_original": "Funding uncertainty threatens Tasmania’s gains against kelp-grazing sea urchins", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-19T06:00:06+00:00", "source_text": "For nearly a decade, divers off Tasmania’s east coast have been getting a boost from the government to harvest the invasive sea urchins killing off kelp forests that fringe the Australian island state. A state program offers financial incentives to support a commercial fishery for the highly valuable roe of the long-spined sea urchin (Centrostephanus […]", "text_kind": "source_excerpt", "text_characters": 356, "text_sha256": "fb99251c72563ec932fe6987d34648054fa724d98b62df2789145b86a2ceea26", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:27.192752+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "subsidy", "label_zh": "补贴与激励", "label_en": "Subsidies and incentives", "start": 235, "end": 244, "evidence": "ff kelp forests that fringe the Australian island state. A state program offers financial incentives to support a commercial fishery for the highly valuable roe of the long-spined sea urchin (Centrostephanus […]"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:27.223135+00:00", "published_at_raw": "2026-10-19T06:00:06", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.571626+00:00"}
{"text_id": "text_1005d963df925c05badf", "record_id": "article_1005d963df925c05", "canonical_url": "https://news.mongabay.com/2026/10/celebrity-shark-trapped-in-south-korean-canal-stirs-concerns-over-warming-seas", "publisher_url": "https://news.mongabay.com/2026/10/celebrity-shark-trapped-in-south-korean-canal-stirs-concerns-over-warming-seas", "title_original": "Celebrity shark trapped in South Korean canal stirs concerns over warming seas", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-10-16T15:01:00+00:00", "source_text": "SEOUL — Wedged between skyscrapers and a bustling passenger ferry port in Busan, South Korea’s second-largest city, a celebrity of sorts is drawing thousands of admirers as it has been swimming for weeks now in a shallow city canal. Bukangi, a shark named after the waterfront park where she is trapped, has attracted nearly 1.4 […]", "text_kind": "source_excerpt", "text_characters": 332, "text_sha256": "8eb67e28a2f2f8cb2da64dd3ff94ca6cb3e2a3f9ec6e3f206bedb837ab413dfb", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:45:27.447035+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea"}], "annotation_method": "di