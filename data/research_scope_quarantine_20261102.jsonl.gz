{"text_id": "text_10479269149afa6d2559", "record_id": "article_10479269149afa6d", "canonical_url": "https://insideclimatenews.org/news/12012026/congress-may-cut-lead-pipe-replacement-funding", "publisher_url": "https://insideclimatenews.org/news/12012026/congress-may-cut-lead-pipe-replacement-funding", "title_original": "States Say They Need More Help Replacing Lead Pipes. Congress May Cut the Funding Instead.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-12T18:38:11+00:00", "source_text": "The Senate is taking up a spending package passed by the House of Representatives that would cut $125 million in funding promised this year to replace toxic lead pipes. Including three of 12 appropriations bills, this package will fund parts of the federal government, including the Environmental Protection Agency. The Senate is slated to vote […]", "text_kind": "source_excerpt", "text_characters": 348, "text_sha256": "63c38cd958a084919d47f6f572fc4ae1f0e86de2d51d1cabfd288124e4c5c9e8", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:11.043643+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$125 million", "start": 97, "end": 109, "evidence": "The Senate is taking up a spending package passed by the House of Representatives that would cut $125 million in funding promised this year to replace toxic lead pipes.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [{"id": "investment", "label_zh": "公共投入与融资", "label_en": "Public investment and finance", "start": 113, "end": 120, "evidence": " a spending package passed by the House of Representatives that would cut $125 million in funding promised this year to replace toxic lead pipes. Including three of 12 appropriations bills, this package will fund parts of the federal gov"}], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:11.102821+00:00", "published_at_raw": "2026-01-12T18:38:11", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_a4c72af436d07f895abe", "record_id": "article_a4c72af436d07f89", "canonical_url": "https://yaleclimateconnections.org/2026/01/atlanta-park-doubles-as-a-flood-protection-system", "publisher_url": "https://yaleclimateconnections.org/2026/01/atlanta-park-doubles-as-a-flood-protection-system", "title_original": "Atlanta park doubles as a flood protection system", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-12T12:00:00+00:00", "source_text": "Transcript: On most days, Rodney Cook Sr. Park in Atlanta is alive with kids playing on the playground, teenagers shooting hoops, and families strolling around gardens and fountains. But during a heavy storm, the park fills with water – exactly as it was designed to do. Wozniak: “When there are major storms that occur … the park basically acts as a saucer.” Jay Wozniak is with the Trust for Public Land , which helped the city create Cook Park. It’s in Vine City, a neighborhood that has long struggled with flooding, and it was built on the site of a flood that destroyed dozens of homes in 2002. The park includes ponds, wetlands, rain gardens, and an underground cistern that together can hold more water than 13 Olympic-sized swimming pools.", "text_kind": "article_excerpt", "text_characters": 748, "text_sha256": "71d88b30d3cbea08d4a651a70ec0648d936f993d48a92fdc197e0ec7fa2a13ba", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:35.278994+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 511, "end": 516, "evidence": "the city create Cook Park. It’s in Vine City, a neighborhood that has long struggled with flooding, and it was built on the site of a flood that destroyed dozens of homes in 2002. The park includes ponds, wetlands, rain gardens, and an"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:35.315588+00:00", "published_at_raw": "2026-01-12T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_82f36dd7e59a6bafc9d4", "record_id": "article_82f36dd7e59a6baf", "canonical_url": "https://insideclimatenews.org/news/12012026/indigenous-knowledge-helped-whanganui-river-rights", "publisher_url": "https://insideclimatenews.org/news/12012026/indigenous-knowledge-helped-whanganui-river-rights", "title_original": "‘I Am the River’: How Indigenous Knowledge Reshaped New Zealand’s Law", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-01-12T10:00:00+00:00", "source_text": "Ned Tapa has spent his life along New Zealand’s Whanganui River. For Tapa, a Māori leader, the river is not a resource to be managed or a commodity to be owned. It is an ancestor. A living being. A life force. That worldview—captured in the Māori phrase “I am the river, and the river is […]", "text_kind": "source_excerpt", "text_characters": 291, "text_sha256": "0c3ac080c8e71d8be1ab51867ba034724dbbc876a74357a9b724a9a06d9f21d3", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:11.227360+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NZ", "alpha3": "NZL", "name_zh": "新西兰", "name_en": "New Zealand"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NZ", "alpha3": "NZL", "name_zh": "新西兰", "name_en": "New Zealand"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_no