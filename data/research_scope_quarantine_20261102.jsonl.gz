{"text_id": "text_ecb3baae5dbd841c62b3", "record_id": "article_ecb3baae5dbd841c", "canonical_url": "https://insideclimatenews.org/news/05062026/trump-energy-department-funds-coal-projects", "publisher_url": "https://insideclimatenews.org/news/05062026/trump-energy-department-funds-coal-projects", "title_original": "Trump Funds Two New Coal Plants and Extends Another Dozen, Citing ‘Energy Dominance’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-06T00:12:15+00:00", "source_text": "Thursday’s flurry of coal news from energy officials included $425 million to extend the life of 12 coal plants in several states, such as $50 million from the U.S. Department of Energy (DOE) for the Wheeling Power Company’s plans to “modernize” the Mitchell Plant in Moundsville, West Virginia. “This was not necessarily a surprise. But […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "cb3661ca89fd229506c37e87689671a4b5039e8e560b273254690f440d63674b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:21.484116+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$425 million", "start": 62, "end": 74, "evidence": "Thursday’s flurry of coal news from energy officials included $425 million to extend the life of 12 coal plants in several states, such as $50 million from the U.", "interpretation": "not_classified"}, {"value_text": "$50 million", "start": 139, "end": 150, "evidence": "Thursday’s flurry of coal news from energy officials included $425 million to extend the life of 12 coal plants in several states, such as $50 million from the U.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 21, "end": 25, "evidence": "Thursday’s flurry of coal news from energy officials included $425 million to extend the life of 12 coal plants in several states, such as $50 million from the U.S. "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:21.521165+00:00", "published_at_raw": "2026-06-06T00:12:15", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 160, "end": 164, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_081d2c6c9554ffa24b25", "record_id": "article_081d2c6c9554ffa2", "canonical_url": "https://insideclimatenews.org/news/05062026/iran-war-jeopardizes-global-food-security", "publisher_url": "https://insideclimatenews.org/news/05062026/iran-war-jeopardizes-global-food-security", "title_original": "Iran War Jeopardizes Global Food Security", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-05T20:11:10+00:00", "source_text": "The worldwide fallout from the U.S. war in Iran isn’t limited to gas prices. The largely blocked Strait of Hormuz has become “a critical failure point for global food security,” Máximo Torero Cullen, chief economist of the United Nations’ Food and Agriculture Organization, warned this week. Approximately a third of the world’s seaborne fertilizer trade […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "f806e5018da7414639afce2fa9aff3cf0c69f534392b3a6d7ae1390eb70e4093", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:21.853444+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:21.888908+00:00", "published_at_raw": "2026-06-05T20:11:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran", "start": 0, "end": 4, "matched_text": "Iran", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 31, "end": 35, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "IR", "alpha3": "IRN", "name_zh": "伊朗", "name_en": "Iran", "start": 43, "end": 47, "matched_text": "Iran", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_7e224f10f25bfd9ca90b", "record_id": "article_7e224f10f25bfd9c", "canonical_url": "https://news.mongabay.com/2026/06/rights-groups-renew-call-to-free-jailed-cambodian-environmental-activists", "publisher_url": "https://news.mongabay.com/2026/06/rights-groups-renew-call-to-free-jailed-cambodian-environmental-activists", "title_original": "Rights groups renew call to free jailed Cambodian environmental activists", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-05T02:51:38+00:00", "source_text": "BANGKOK — Seven hundred days after activists from the environmental group Mother Nature Cambodia were imprisoned on charges widely regarded as retaliatory for their activism, 73 international and Cambodian civil society organizations have renewed calls for their unconditional release. After a trial lasting just over a month, 10 activists from Mother Nature Cambodia were sentenced […]", "text_kind": "source_excerpt", "text_characters": 386, "text_sha256": "e2920de7a4c694a3168700ab7c174a1ea96725903703c57d6948e95fa4c2ed89", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:16.330885+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:16.391902+00:00", "published_at_raw": "2026-06-05T02:51:38", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KH", "alpha3": "KHM", "name_zh": "柬埔寨", "name_en": "Cambodia", "start": 88, "end": 96, "matched_text": "Cambodia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_95a235d5ebbcde398ffc", "record_id": "article_95a235d5ebbcde39", "canonical_url": "https://insideclimatenews.org/news/04062026/new-york-data-center-moratorium-bill", "publisher_url": "https://insideclimatenews.org/news/04062026/new-york-data-center-moratorium-bill", "title_original": "New York State Gets One Step Closer to a Data Center Moratorium", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-05T00:59:30+00:00", "source_text": "The New York Legislature passed a one-year moratorium Thursday night on data center permits, the latest sign of pushback amid a nationwide rush to build the power-hungry facilities. New York would become the first state in the nation to enact such a freeze if Gov. Kathy Hochul signs the bill into law. But Hochul, who […]", "text_kind": "source_excerpt", "text_characters": 322, "text_sha256": "24a6ba0719ea7fa2c7856f1ad416b308d0849912649d7b8b635ca388ce13ba8e", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:22.328072+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:22.387806+00:00", "published_at_raw": "2026-06-05T00:59:30", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_b2cbe1cc3f12bc73106f", "record_id": "article_b2cbe1cc3f12bc73", "canonical_url": "https://insideclimatenews.org/news/04062026/inside-clean-energy-virtual-power-plants-role-in-transition-away-from-fossil-fuels", "publisher_url": "https://insideclimatenews.org/news/04062026/inside-clean-energy-virtual-power-plants-role-in-transition-away-from-fossil-fuels", "title_original": "As Energy Demand Rises, More States Turn to Virtual Power Plants", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-04T13:00:00+00:00", "source_text": "An executive order in Massachusetts and a regulatory commission action in Minnesota are among the big moves this year that highlight the growing role of virtual power plants in grid management. A virtual power plant, or VPP, is a network of resources that a central controller can call upon to send power to the grid […]", "text_kind": "source_excerpt", "text_characters": 320, "text_sha256": "e0f3494354963670b2bfb985ecfe14bf4d1d2d7ff252c08be4083e17e6b8f003", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:22.536690+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:22.578135+00:00", "published_at_raw": "2026-06-04T13:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 22, "end": 35, "matched_text": "Massachusetts", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_581edbd7820a8c77640f", "record_id": "article_581edbd7820a8c77", "canonical_url": "https://yaleclimateconnections.org/2026/06/how-balcony-solar-could-help-fight-rising-utility-costs", "publisher_url": "https://yaleclimateconnections.org/2026/06/how-balcony-solar-could-help-fight-rising-utility-costs", "title_original": "How ‘balcony solar’ could help fight rising utility costs", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-04T11:00:00+00:00", "source_text": "If you feel like your electricity bill just keeps climbing, you aren’t imagining it. Since 2020, U.S. residential energy prices have surged by about 30%, making power the largest household energy expense behind gasoline, according to the U.S. Energy Information Administration. But for residents like Alex Curtis, the days of feeling powerless against rising costs are coming to an end. Curtis is waging a war on his electric bill, and his new weapon of choice is a lightweight, thin-film solar panel. “Oh, it’s super light too,” Curtis remarked as he unboxed the kit on the balcony of his condo in Sunnyvale, California. It weighs just about 10 pounds.", "text_kind": "article_excerpt", "text_characters": 653, "text_sha256": "cb4c893be09f8abb7d95f5222122636cf6e7c7898f7489940eb365a232f30a35", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:58.986020+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "30%", "start": 149, "end": 152, "evidence": " residential energy prices have surged by about 30%, making power the largest household energy expense behind gasoline, according to the U.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 114, "end": 120, "evidence": "ectricity bill just keeps climbing, you aren’t imagining it. Since 2020, U.S. residential energy prices have surged by about 30%, making power the largest household energy expense behind gasoline, according to the U.S. Energy Informatio"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:59.052673+00:00", "published_at_raw": "2026-06-04T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 97, "end": 101, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_c2a6fa7d211666d12994", "record_id": "article_c2a6fa7d211666d1", "canonical_url": "https://insideclimatenews.org/news/04062026/california-pesticide-applications-rise-despite-regulations", "publisher_url": "https://insideclimatenews.org/news/04062026/california-pesticide-applications-rise-despite-regulations", "title_original": "California Pesticide Regulators Say New Rules Protect Communities as Applications of a Dangerous Fumigant Rise", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-04T09:00:00+00:00", "source_text": "California regulators passed a rule in January 2024 that they said would protect communities from one of the state’s most popular, and dangerous, pesticides. For decades, they knew that 1,3-dichloropropane, or 1,3-D, causes tumors in multiple organs in laboratory animals, which led the state to flag it as a carcinogen in 1989. Yet regulators allowed […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "33ae1f4ef261de62dd71a3f065d49740f5d056b3a7cd83d8f66bb17fb32210fc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:22.692698+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:22.753826+00:00", "published_at_raw": "2026-06-04T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 10, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 0, "end": 10, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_d8f139225576a96ada0b", "record_id": "article_d8f139225576a96a", "canonical_url": "https://insideclimatenews.org/news/03062026/alabama-public-service-commission-restructuring-lawsuit", "publisher_url": "https://insideclimatenews.org/news/03062026/alabama-public-service-commission-restructuring-lawsuit", "title_original": "In the Wake of Georgia’s Blue Wave, Alabama Changed Its Utility Regulation Elections. This Black Democrat Is Suing.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-03T08:50:00+00:00", "source_text": "MONTGOMERY, Ala—Sheila McNeil thought she knew the race ahead of her. Without a primary challenger, McNeil knew she was slated to be the Democratic nominee for a seat on the Public Service Commission, the state agency charged with regulating utilities like Alabama Power. Then, after the conclusion of the Republican primary process, McNeil would compete […]", "text_kind": "source_excerpt", "text_characters": 358, "text_sha256": "e43c7fb471e2681303677c72f9136302df7cce0091e91bdc7420663605570793", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:23.777902+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:23.841463+00:00", "published_at_raw": "2026-06-03T08:50:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_4192188f62d99a5a1ae5", "record_id": "article_4192188f62d99a5a", "canonical_url": "https://news.mongabay.com/2026/06/natures-feedback-loops-can-drive-collapse-thomas-crowther-thinks-they-can-also-drive-recovery", "publisher_url": "https://news.mongabay.com/2026/06/natures-feedback-loops-can-drive-collapse-thomas-crowther-thinks-they-can-also-drive-recovery", "title_original": "Nature’s feedback loops can drive collapse. Thomas Crowther thinks they can also drive recovery", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-01T00:55:10+00:00", "source_text": "Thomas Crowther’s career has been shaped by large claims about small things. A seed, a patch of soil, a soundscape, a moment of fear, a local restoration project: each, in his telling, can become part of a larger system of cause and effect. His new book, Nature’s Echo, is built around that idea. Feedback loops, […]", "text_kind": "source_excerpt", "text_characters": 316, "text_sha256": "f07f6913b9f92f7939da9e566eda71574fd8a6b36af42d7a2a2bd381abcdd222", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:28.799875+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:28.823813+00:00", "published_at_raw": "2026-06-01T00:55:10", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_670f4e496b43f365be75", "record_id": "article_670f4e496b43f365", "canonical_url": "https://insideclimatenews.org/news/31052026/experts-warn-of-upcoming-wildfire-season", "publisher_url": "https://insideclimatenews.org/news/31052026/experts-warn-of-upcoming-wildfire-season", "title_original": "Why Wildfire Experts Are So Worried About This Year’s Fire Season", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-31T09:00:00+00:00", "source_text": "As bad as things got in Los Angeles in January 2025, when 31 people died and more than 16,000 buildings were destroyed by wildfires roaring into residential neighborhoods, many wildland firefighters look back on the rest of last year as a dodged bullet. Across the nation, according to the National Interagency Fire Center (NIFC), which […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "17dc78e386b9bcea98ee86848844748fae6af801c74c0958358be28ae683c77a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:25.414684+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 122, "end": 130, "evidence": "les in January 2025, when 31 people died and more than 16,000 buildings were destroyed by wildfires roaring into residential neighborhoods, many wildland firefighters look back on the rest of last year as a dodged bullet. Across the natio"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:25.491405+00:00", "published_at_raw": "2026-05-31T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_d3f8e12ea026ba1db113", "record_id": "article_d3f8e12ea026ba1d", "canonical_url": "https://insideclimatenews.org/news/31052026/georgia-okefenokee-swamp-nears-unesco-recognition", "publisher_url": "https://insideclimatenews.org/news/31052026/georgia-okefenokee-swamp-nears-unesco-recognition", "title_original": "A Georgia Wildlife Haven Forged by Fire and Peat Nears UNESCO Recognition", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-31T08:55:00+00:00", "source_text": "FOLKSTON, Ga.—The world’s smallest heron hops from blade to blade in a patch of tall grass, testing its footing above the dark water as it searches for an evening meal. “This was already worth the trip out today,” Joshua Howard said earlier this month from a gray flat-bottomed tour boat just a few yards away. […]", "text_kind": "source_excerpt", "text_characters": 314, "text_sha256": "a4bc269d26ad4bcdcf93d3e66627cb7017df15d557e384db2e12b43f8c861af2", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:25.633035+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:25.672569+00:00", "published_at_raw": "2026-05-31T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_58430765bde1096fdc6f", "record_id": "article_58430765bde1096f", "canonical_url": "https://www.carbonbrief.org/ai-boom-means-us-is-now-investing-more-in-fossil-fuel-power-than-china", "publisher_url": "https://www.carbonbrief.org/ai-boom-means-us-is-now-investing-more-in-fossil-fuel-power-than-china", "title_original": "AI boom means US is now ‘investing more’ in fossil-fuel power than China", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Carbon Brief", "source_id": "INT001", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-29T12:58:11+00:00", "source_text": "The “data-centre boom” is driving a surge in gas investment in the US, pushing its fossil-power spending ahead of China, according to the International Energy Agency (IEA). A rapid expansion of data centres across the nation is at the heart of the US tech sector’s plans to continue “ dominat[ing] ” the global artificial intelligence (AI) industry. High demand for electricity to power these data centres has led to companies rushing to build new gas-fired power plants across the country. This trend, combined with “ soaring ” gas-turbine prices, drove a threefold increase in US gas‑power investment in 2025 – and the IEA expects this to continue throughout 2026.", "text_kind": "article_excerpt", "text_characters": 666, "text_sha256": "0baaa7eabb2afed3c9a2917932c351a57789f13b09c3b878e27c35077da4c839", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:38.611411+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 152, "end": 158, "evidence": " the US, pushing its fossil-power spending ahead of China, according to the International Energy Agency (IEA). A rapid expansion of data centres across the nation is at the heart of the US tech sector’s plans to continue “ dominat[ing] "}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://www.carbonbrief.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:38.632087+00:00", "published_at_raw": "2026-05-29T12:58:11", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 14, "end": 16, "matched_text": "US", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 67, "end": 72, "matched_text": "China", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 67, "end": 69, "matched_text": "US", "method": "country-acronym-v2", "source_field": "source_text"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 114, "end": 119, "matched_text": "China", "method": "country-span-v2", "source_field": "