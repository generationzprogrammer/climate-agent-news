{"text_id": "text_961a410ebb7a0766f241", "record_id": "article_961a410ebb7a0766", "canonical_url": "https://news.mongabay.com/2025/12/a-small-preserve-leads-a-big-effort-to-save-native-plants-in-the-bahamas", "publisher_url": "https://news.mongabay.com/2025/12/a-small-preserve-leads-a-big-effort-to-save-native-plants-in-the-bahamas", "title_original": "A small preserve leads a big effort to save native plants in the Bahamas", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-30T19:37:19+00:00", "source_text": "ELEUTHERA, Bahamas — Tucked away beside the main road that runs along Eleuthera, a narrow island in the Bahamas, the Leon Levy Native Plant Preserve holds 12 hectares (30 acres) of dense subtropical dry forest. Black witch moths (Ascalapha odorata), as large as bats, zigzag between the branches as fluorescent wasps hum along the path’s […]", "text_kind": "source_excerpt", "text_characters": 341, "text_sha256": "adc5b050b2d15f06da18e96cd793f2fdfa526f0269cebabcdf7ad1e7782b2dad", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:39.402333+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BS", "alpha3": "BHS", "name_zh": "巴哈马", "name_en": "Bahamas"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BS", "alpha3": "BHS", "name_zh": "巴哈马", "name_en": "Bahamas"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:39.426743+00:00", "published_at_raw": "2025-12-30T19:37:19", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BS", "alpha3": "BHS", "name_zh": "巴哈马", "name_en": "Bahamas", "start": 65, "end": 72, "matched_text": "Bahamas", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "BS", "alpha3": "BHS", "name_zh": "巴哈马", "name_en": "Bahamas", "start": 11, "end": 18, "matched_text": "Bahamas", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_29ee8c4af71cfe2a84e5", "record_id": "article_29ee8c4af71cfe2a", "canonical_url": "https://news.mongabay.com/2025/12/rare-bats-at-risk-as-iron-ore-mine-advances-in-guineas-nimba-mountains", "publisher_url": "https://news.mongabay.com/2025/12/rare-bats-at-risk-as-iron-ore-mine-advances-in-guineas-nimba-mountains", "title_original": "Rare bats at risk as iron ore mine advances in Guinea’s Nimba Mountains", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-30T14:47:23+00:00", "source_text": "In 2018, researchers from Bat Conservation International, Cameroon’s University of Maroua and the American Museum of Natural History entered abandoned mining tunnels in Guinea’s Nimba Mountains as part of an environmental and social impact assessment for an iron ore project. They wanted to better understand the habitat and behavior of the critically endangered Lamotte’s roundleaf […]", "text_kind": "source_excerpt", "text_characters": 386, "text_sha256": "f5c15caa32df6aabd761be89e89d1b200759876933f7c6ba28b1591705b0075f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:39.439356+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon"}, {"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon"}, {"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:39.470136+00:00", "published_at_raw": "2025-12-30T14:47:23", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea", "start": 47, "end": 53, "matched_text": "Guinea", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CM", "alpha3": "CMR", "name_zh": "喀麦隆", "name_en": "Cameroon", "start": 58, "end": 66, "matched_text": "Cameroon", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "GN", "alpha3": "GIN", "name_zh": "几内亚", "name_en": "Guinea", "start": 169, "end": 175, "matched_text": "Guinea", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_df6f055771e5d6ff034b", "record_id": "article_df6f055771e5d6ff", "canonical_url": "https://news.mongabay.com/2025/12/amazon-fishers-help-scientists-map-dam-harms-to-madeira-river-stocks", "publisher_url": "https://news.mongabay.com/2025/12/amazon-fishers-help-scientists-map-dam-harms-to-madeira-river-stocks", "title_original": "Amazon fishers help scientists map dam harms to Madeira River stocks", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-29T14:05:08+00:00", "source_text": "LAGO PURUZINHO, Brazil — Looking at the clear waters of Puruzinho Lake, fisher Raimundo Nonato dos Santos regrets the decline in fish stocks affecting the livelihood of his community in the Brazilian Amazon. Species like pirarucu ( Arapaima gigas ), tambaqui ( Colossoma macropomum ) and pirapitinga ( Piaractus brachypomus ) have “disappeared” from Lago Puruzinho community in northern Amazonas state, dos Santos said. “When we catch one, it’s a surprise.” A resident of Puruzinho since he was born 53 years ago, dos Santos, leader of the Puruzinho community and known by his nickname Leleca, said the construction of the Santo Antônio hydroelectric power plant in neighboring Rondônia state in 2008 “triggered the ruin” of his community.", "text_kind": "article_excerpt", "text_characters": 739, "text_sha256": "2a337b71319a629f29fac8a7d2d3c551e549769652c6b25febbf3d140b128dc1", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:49:44.738143+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:44.811037+00:00", "published_at_raw": "2025-12-29T14:05:08", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 16, "end": 22, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_c175cdac8f44864efec4", "record_id": "article_c175cdac8f44864e", "canonical_url": "https://news.mongabay.com/2025/12/fights-against-development-projects-marks-2025-for-nepals-indigenous-people", "publisher_url": "https://news.mongabay.com/2025/12/fights-against-development-projects-marks-2025-for-nepals-indigenous-people", "title_original": "Fights against development projects marks 2025 for Nepal’s Indigenous people", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-29T10:22:25+00:00", "source_text": "As Indigenous peoples and local communities globally struggle to safeguard their rights over their land and forests, Nepal hasn’t been an exception. In the face of socioeconomic and environmental threats, from infrastructure development projects including hydropower, cable car and mining, Nepal’s communities protested and took corporations to court to uphold their rights. At COP30 in […]", "text_kind": "source_excerpt", "text_characters": 390, "text_sha256": "e2b45317dbd1714b6ef3e93ef78148cb14ef2a1bd58377a80b070bf802ff1c3d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:44.930362+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": ["COP30"], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 3, "end": 13, "evidence": "As Indigenous peoples and local communities globally struggle to safeguard their rights over their land and forests, Nepal hasn’t been an exception. In t"}], "policy_tools": [], "policy_stages": [], "track": "negotiations", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:44.992744+00:00", "published_at_raw": "2025-12-29T10:22:25", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 51, "end": 56, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 117, "end": 122, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_2bb6046003e625d78979", "record_id": "article_2bb6046003e625d7", "canonical_url": "https://news.mongabay.com/2025/12/striking-red-gold-with-saffron-farming-in-algeria-interview-with-keltouma-adouane", "publisher_url": "https://news.mongabay.com/2025/12/striking-red-gold-with-saffron-farming-in-algeria-interview-with-keltouma-adouane", "title_original": "Striking ‘red gold’ with saffron farming in Algeria: Interview with Keltouma Adouane", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-29T09:16:00+00:00", "source_text": "The world’s most expensive plant, saffron, is as delicate as it is valuable. Each purple flower blooms for less than three weeks a year, and only its three tiny, fragile red stigmas are edible. Harvesting them is a painstaking process: picked by hand at dawn and dried with extreme care, as even the slightest pressure […]", "text_kind": "source_excerpt", "text_characters": 322, "text_sha256": "839f4c46d2b0544a9236c0d5a55241e286683e75bcb21da30e22c719a52ebc0d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:45.024635+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "DZ", "alpha3": "DZA", "name_zh": "阿尔及利亚", "name_en": "Algeria"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_