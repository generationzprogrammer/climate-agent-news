{"text_id": "text_23a71c0b856dcaece5e9", "record_id": "article_23a71c0b856dcaec", "canonical_url": "https://news.mongabay.com/2026/07/costa-rica-banana-plantation-destroyed-protected-wetland-complaint-alleges", "publisher_url": "https://news.mongabay.com/2026/07/costa-rica-banana-plantation-destroyed-protected-wetland-complaint-alleges", "title_original": "Costa Rica banana plantation destroyed protected wetland, complaint alleges", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-30T19:09:55+00:00", "source_text": "A legal complaint in Costa Rica has alleged that a banana plantation destroyed parts of a protected wetland in Bananito Sur, located in the Valle La Estrella district in the central province of Limón. Workers on the La Paz banana plantation, owned by Standard Fruit Company de Costa Rica, a subsidiary of Dole, cut down […]", "text_kind": "source_excerpt", "text_characters": 323, "text_sha256": "920122908e9846dde6e2ccc9b82fb9d853672ee07c4fc275b92bec4286767684", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:24.755058+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CR", "alpha3": "CRI", "name_zh": "哥斯达黎加", "name_en": "Costa Rica"}], "governance_themes": [], "policy_tools": [{"id": "subsidy", "label_zh": "补贴与激励", "label_en": "Subsidies and incentives", "start": 291, "end": 297, "evidence": "Workers on the La Paz banana plantation, owned by Standard Fruit Company de Costa Rica, a subsidiary of Dole, cut down […]"}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CR", "alpha3": "CRI", "name_zh": "哥斯达黎加", "name_en": "Costa Rica"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:24.767732+00:00", "published_at_raw": "2026-07-30T19:09:55", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CR", "alpha3": "CRI", "name_zh": "哥斯达黎加", "name_en": "Costa Rica", "start": 0, "end": 10, "matched_text": "Costa Rica", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CR", "alpha3": "CRI", "name_zh": "哥斯达黎加", "name_en": "Costa Rica", "start": 21, "end": 31, "matched_text": "Costa Rica", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_b488ac9a9a96330b69a0", "record_id": "article_b488ac9a9a96330b", "canonical_url": "https://news.mongabay.com/2026/07/its-time-we-recognize-the-roles-of-rangers-and-prioritize-their-safety-commentary", "publisher_url": "https://news.mongabay.com/2026/07/its-time-we-recognize-the-roles-of-rangers-and-prioritize-their-safety-commentary", "title_original": "It’s time we recognize the roles of rangers — and prioritize their safety (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-30T15:34:48+00:00", "source_text": "It is always a tragedy when a ranger is injured in the line of duty. Sadly, it is a story we have come to know all too well: brave men and women head into the field each day, and on occasion, whether at the hands of armed groups, dangerous wildlife, or environmental emergencies, it goes […]", "text_kind": "source_excerpt", "text_characters": 291, "text_sha256": "14bdc130aa10d2fb2ec4e5aaf2a9f8c580daa409b6b554ad1bf54e45a8d0e81f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:30.050893+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:30.064636+00:00", "published_at_raw": "2026-07-30T15:34:48", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_233b6eb790ef9c62a56c", "record_id": "article_233b6eb790ef9c62", "canonical_url": "https://insideclimatenews.org/news/28072026/el-nino-could-impact-pacific-fishing", "publisher_url": "https://insideclimatenews.org/news/28072026/el-nino-could-impact-pacific-fishing", "title_original": "This Year’s El Niño Could Spell Disaster for American Fishermen", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-28T18:35:31+00:00", "source_text": "The last El Niño was linked to severe droughts in Southern Africa, wildfires in Indonesia and global coral bleaching. Now, ocean advocates are warning that American fishermen could face significant financial losses as fish stocks struggle to survive in warmer waters. With the National Oceanic and Atmospheric Administration (NOAA) predicting an 81 percent chance of […]", "text_kind": "source_excerpt", "text_characters": 370, "text_sha256": "f6aed009a8f581b25b952c88ec47af673c3975e1e29b24a91f0b67196225ed9d", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:36.586487+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "81 percent", "start": 346, "end": 356, "evidence": " With the National Oceanic and Atmospheric Administration (NOAA) predicting an 81 percent chance of […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_theme