{"text_id": "text_5365affda57977385945", "record_id": "article_5365affda5797738", "canonical_url": "https://insideclimatenews.org/news/28052026/pennsylvania-gov-shapiro-ai-data-center-plan", "publisher_url": "https://insideclimatenews.org/news/28052026/pennsylvania-gov-shapiro-ai-data-center-plan", "title_original": "Pennsylvania’s Governor Has a Plan to Make Data Centers Bring Their Own Energy. Now Comes the Hard Part.", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-28T09:00:00+00:00", "source_text": "For months, Pennsylvania Gov. Josh Shapiro promised a plan to blunt fast-rising energy costs in the state by pushing power-hungry AI data centers to pay their own way. Now his office has formally released details on how he intends to turn BYOE—“bring your own energy”—into more than just a slogan. The question now is whether […]", "text_kind": "source_excerpt", "text_characters": 329, "text_sha256": "c85740a30c9ae9cb3d6fa15d94de7b83a52b9cde1298ff42b17863daf73d9bf1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:27.247512+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 80, "end": 86, "evidence": "For months, Pennsylvania Gov. Josh Shapiro promised a plan to blunt fast-rising energy costs in the state by pushing power-hungry AI data centers to pay their own way. Now his office has formally released details on how he int"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:27.307530+00:00", "published_at_raw": "2026-05-28T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_cd5a8e525c47f9caac07", "record_id": "article_cd5a8e525c47f9ca", "canonical_url": "https://dialogue.earth/en/climate/they-are-still-in-school-but-they-are-already-designing-environmental-solutions", "publisher_url": "https://dialogue.earth/en/climate/they-are-still-in-school-but-they-are-already-designing-environmental-solutions", "title_original": "They are still in school, but they are already designing environmental solutions", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-27T15:48:34+00:00", "source_text": "In Kiambu county on the outskirts of Nairobi, diesel fumes hang over traffic like a second weather system. Frederick Njoroge Kariuki, 17, has spent many afternoons peering into the tailpipes of matatus. These ubiquitous minibuses power Kenya’s public transport system, and Kariuki wondered if pollution had to be accepted as the price of movement. This is personal for him. He remembers being 12 and struggling with allergic bronchitis, a chronic lung condition that can be brought on by air pollution. Over 300 km away to the west, Miron Onsarigo, 17, grew up in Kisumu, close to the Ugandan border, but breathing the same exhaust smoke that chokes road travel across East Africa. The two met in 2023 after being admitted to the same cohort at M-Pesa Foundation Academy in Thika, central Kenya.", "text_kind": "article_excerpt", "text_characters": 795, "text_sha256": "4c94563d084f926b573edc3f0f67fe9f014e091adeb030039b78cc2991fa9fa5", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:36.787280+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:45:36.822461+00:00", "published_at_raw": "2026-05-27T15:48:34", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya", "start": 236, "end": 241, "matched_text": "Kenya", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_18893b960be6f17b4521", "record_id": "article_18893b960be6f17b", "canonical_url": "https://yaleclimateconnections.org/2026/05/el-nino-podria-traer-huracanes-fuertes-al-occidente-de-mexico-esta-temporada", "publisher_url": "https://yaleclimateconnections.org/2026/05/el-nino-podria-traer-huracanes-fuertes-al-occidente-de-mexico-esta-temporada", "title_original": "El Niño podría traer huracanes fuertes al occidente de México esta temporada", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-26T14:22:35+00:00", "source_text": "El pronóstico para el Pacífico oriental indica un 70% de probabilidad de entre 15 y 22 tormentas con nombre, de las cuales se espera que entre 9 y 14 se conviertan en huracanes, incluyendo entre 5 y 9 huracanes mayores.", "text_kind": "source_excerpt", "text_characters": 219, "text_sha256": "4c3fe0427555096585fd02fa0e0e99069775d2fc0a5501dd22df2323bb07b62a", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:00.941497+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "70%", "start": 50, "end": 53, "evidence": "El pronóstico para el Pacífico oriental indica un 70% de probabilidad de entre 15 y 22 tormentas con nombre, de las cuales se espera que entre 9 y 14 se conviertan en huracanes, incluyendo entre 5 y 9 huracanes mayores.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:00.972103+00:00", "published_at_raw": "2026-05-26T14:22:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_b0aea1493b4362065d53", "record_id": "article_b0aea1493b436206", "canonical_url": "https://news.mongabay.com/2026/05/amid-efforts-to-save-australias-southern-cassowaries-their-numbers-remain-unknown", "publisher_url": "https://news.mongabay.com/2026/05/amid-efforts-to-save-australias-southern-cassowaries-their-numbers-remain-unknown", "title_original": "Amid efforts to save Australia’s southern cassowaries, their numbers remain unknown", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-26T12:46:09+00:00", "source_text": "With a striking blue neck, jet black plumage and bright red drooping wattles, the southern cassowary cuts an imposing figure in the dense tropical rainforests of Far North Queensland, Australia. Standing up to 2 meters (6.5 feet) tall and armed with razor-sharp claws, it is often labeled as the world’s most dangerous bird. In reality, […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "94d6be9fda46a5c7d307f633150c30d29c4198216beebf48d60cf4295cd9eab1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:29.599260+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:29.628705+00:00", "published_at_raw": "2026-05-26T12:46:09", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia", "start": 21, "end": 30, "matched_text": "Australia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "AU", "alpha3": "AUS", "name_zh": "澳大利亚", "name_en": "Australia", "start": 184, "end": 193, "matched_text": "Australia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_30edfca469d8cb4a8c46", "record_id": "article_30edfca469d8cb4a", "canonical_url": "https://insideclimatenews.org/news/25052026/florida-indiantown-hyperscale-data-center-proposals", "publisher_url": "https://insideclimatenews.org/news/25052026/florida-indiantown-hyperscale-data-center-proposals", "title_original": "In Florida, an Agricultural Town in Need of an Economic Boost Eyes Hyperscale Data Centers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-25T09:00:00+00:00", "source_text": "INDIANTOWN, Fla.—Carroll McAllister frets over the prospect of a hyperscale data center opening next to the grassy expanse where she grew up, in a shack her father built. Now 87, McAllister is a tiny but sturdy woman with a bob of blonde hair. She fondly recalls running wild on the land in her youth with […]", "text_kind": "source_excerpt", "text_characters": 309, "text_sha256": "da43e0eb226e72c6bd94a056314e0f070713c13cdd415d998bb68c16d401833f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:28.277993+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:28.346380+00:00", "published_at_raw": "2026-05-25T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_66b956d002c3f08825bc", "record_id": "article_66b956d002c3f088", "canonical_url": "https://insideclimatenews.org/news/24052026/potomac-river-sewage-fuel-spills-contaminate-drinking-water", "publisher_url": "https://insideclimatenews.org/news/24052026/potomac-river-sewage-fuel-spills-contaminate-drinking-water", "title_original": "Sewage and Fuel Leaks Contaminate the Potomac River, Source of Drinking Water for More Than 5 Million People", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-24T08:55:00+00:00", "source_text": "The warning signs were years in the making. And yet, regulators failed to heed the writing on the wall, according to Dean Naujoks. An investigator with the Potomac Riverkeeper Network, Naujoks spent three years documenting what he calls a systemic failure that culminated in dual environmental catastrophes now threatening the health of the entire Potomac […]", "text_kind": "source_excerpt", "text_characters": 359, "text_sha256": "bef1d3b8c80b4e7f82f5ff81491a0f74865b2345b6278e5995dda69cdc6e1751", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:38.828782+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:38.840644+00:00", "published_at_raw": "2026-05-24T08:55:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_f52ea615ab1026c0a89d", "record_id": "article_f52ea615ab1026c0", "canonical_url": "https://news.mongabay.com/2026/05/corporate-capture-of-critical-minerals-risks-repeating-drcs-extractive-past-warns-indigenous-leader", "publisher_url": "https://news.mongabay.com/2026/05/corporate-capture-of-critical-minerals-risks-repeating-drcs-extractive-past-warns-indigenous-leader", "title_original": "‘Corporate capture’ of critical minerals risks repeating DRC’s extractive past, warns indigenous leader", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-22T20:46:35+00:00", "source_text": "The global rush for minerals needed for the green energy transition risks repeating the same old extractive patterns that have long left communities in the Democratic Republic of Congo bearing the costs while others reap the benefits, an indigenous leader from the country warns. Robert Agenong’a, a civil society leader and also politician from the […]", "text_kind": "source_excerpt", "text_characters": 353, "text_sha256": "5bd89af8a2ef411a1ab71b486084c80b6a25503034a98ddeb35a15b95f7e11a5", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:47:38.819188+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 50, "end": 56, "evidence": "The global rush for minerals needed for the green energy transition risks repeating the same old extractive patterns that have long left communities in the Democratic Republic of Congo bearing the"}, {"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 238, "end": 248, "evidence": " in the Democratic Republic of Congo bearing the costs while others reap the benefits, an indigenous leader from the country warns. Robert Agenong’a, a civil society leader and also politician from the […]"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:38.849202+00:00", "published_at_raw": "2026-05-22T20:46:35", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)", "start": 57, "end": 60, "matched_text": "DRC", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CD", "alpha3": "COD", "name_zh": "刚果民主共和国(DRC)", "name_en": "Congo (DRC)", "start": 156, "end": 184, "matched_text": "Democratic Republic of Congo", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_afb733a9d091f0ef281f", "record_id": "article_afb733a9d091f0ef", "canonical_url": "https://yaleclimateconnections.org/2026/05/el-nino-expected-to-help-spur-intense-hurricane-and-typhoon-seasons-in-the-north-pacific", "publisher_url": "https://yaleclimateconnections.org/2026/05/el-nino-expected-to-help-spur-intense-hurricane-and-typhoon-seasons-in-the-north-pacific", "title_original": "El Niño expected to help spur intense hurricane and typhoon seasons in the North Pacific", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-05-22T11:00:00+00:00", "source_text": "[Haz clic aquí para leer este artículo en español] In their annual seasonal hurricane forecast for the northeast Pacific issued May 21, NOAA predicted an above-average 2026 hurricane season in both the eastern Pacific (for storms affecting Mexico) and the central Pacific (for storms affecting Hawaii). The eastern Pacific outlook calls for a 70% probability of 15-22 named storms, with 9-14 expected to become hurricanes, including 5-9 major hurricanes. Accumulated cyclone energy ( ACE ) is predicted to be 120-190% of the median. Using the midpoint of these ranges, NOAA is calling for 18.5 named storms, 11.5 hurricanes, and seven major hurricanes. These numbers are well above the 1991-2020 averages of 15 named storms, eight hurricanes, and four major hurricanes.", "text_kind": "article_excerpt", "text_characters": 769, "text_sha256": "93056716198d24f80ed8daf9038bbc3f7a863726277053654d2323d65f4b7857", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:46:01.384308+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "70%", "start": 343, "end": 346, "evidence": " The eastern Pacific outlook calls for a 70% probability of 15-22 named storms, with 9-14 expected to become hurricanes, including 5-9 major hurricanes.", "interpretation": "not_classified"}, {"value_text": "190%", "start": 513, "end": 517, "evidence": " Accumulated cyclone energy ( ACE ) is predicted to be 120-190% of the median.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 475, "end": 481, "evidence": "h 9-14 expected to become hurricanes, including 5-9 major hurricanes. Accumulated cyclone energy ( ACE ) is predicted to be 120-190% of the median. Using the midpoint of these ranges, NOAA is calling for 18.5 named storms, 11.5 hurrican"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:01.503066+00:00", "published_at_raw": "2026-05-22T11:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 240, "end": 246, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_head