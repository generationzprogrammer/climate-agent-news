{"text_id": "text_3b446d9b304f10f07ffb", "record_id": "article_3b446d9b304f10f0", "canonical_url": "https://insideclimatenews.org/news/16032025/wyoming-rooftop-solar-net-metering-energy-independence", "publisher_url": "https://insideclimatenews.org/news/16032025/wyoming-rooftop-solar-net-metering-energy-independence", "title_original": "‘An Unlikely Coalition’ Failed to Expand Rooftop Solar in Wyoming. Lawmakers Plan to Try Again", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-03-16T08:55:00+00:00", "source_text": "When Jason Thornock applied for a grant from the Rural Energy for America Program after it was infused with over $1 billion in funds from former President Joe Biden’s Inflation Reduction Act, he envisioned installing rooftop solar panels on his ranch in Cokeville, Wyoming to help lower his electricity bill. Thornock figured he could generate […]", "text_kind": "source_excerpt", "text_characters": 347, "text_sha256": "26e18d0e498d2f60a94e86be2b8002441a34bcd05d188349ed8487484bb89d41", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:52:37.711360+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$1 billion", "start": 113, "end": 123, "evidence": "When Jason Thornock applied for a grant from the Rural Energy for America Program after it was infused with over $1 billion in funds from former President Joe Biden’s Inflation Reduction Act, he envisioned installing rooftop solar panels on his ranch in Cokeville, Wyoming to help lower his electricity bill.", "interpretation": "not_classified"}