{"text_id": "text_c42557cc99697c433ef8", "record_id": "article_c42557cc99697c43", "canonical_url": "https://news.mongabay.com/2024/02/after-50-years-of-the-u-s-endangered-species-act-we-need-new-biodiversity-protection-laws-commentary", "publisher_url": "https://news.mongabay.com/2024/02/after-50-years-of-the-u-s-endangered-species-act-we-need-new-biodiversity-protection-laws-commentary", "title_original": "After 50 years of the U.S. Endangered Species Act, we need new biodiversity protection laws (commentary)", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-16T19:04:39+00:00", "source_text": "The 50th anniversary of the Endangered Species Act (ESA) — the most consequential environmental legislation ever created — is ringing in a new year of hope. As we welcome 2024 and celebrate the strides made in biodiversity legislation, let’s draw inspiration to forge even more robust laws this new year. In the face of the […]", "text_kind": "source_excerpt", "text_characters": 327, "text_sha256": "0af6c109c124b87ce1992f4aa61113dca0f5fb73546fc901fdcf06cf78feaa90", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:13.404434+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:56:13.420998+00:00", "published_at_raw": "2024-02-16T19:04:39", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 22, "end": 26, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_d5d3bb565f6a2fa7f33a", "record_id": "article_d5d3bb565f6a2fa7", "canonical_url": "https://yaleclimateconnections.org/2024/02/great-lakes-ice-coverage-hits-a-record-low", "publisher_url": "https://yaleclimateconnections.org/2024/02/great-lakes-ice-coverage-hits-a-record-low", "title_original": "Great Lakes ice coverage hits a record low", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-16T12:00:00+00:00", "source_text": "Ice extent on the Great Lakes hit a record low February 8 and has remained at record low levels as of February 16 as a result of the warmest winter on record over much of the region. For the U.S. portion of the Great Lakes region, the November 30-February 14 period was mostly between the first- and third-warmest on record (Figure 1). The Canadian portion of the Great Lakes was also record-warm to near record-warm. In Chicago , 87% of the days from December 1-February 14 had average- to above-average temperatures. A 10-day cold snap in mid-January in the region was not intense enough to allow much ice to grow on the Great Lakes, and January ice extent was just 6% of the lake surface, compared to the 50-year average of 18%. This was the ninth-lowest January ice level on record.", "text_kind": "article_excerpt", "text_characters": 786, "text_sha256": "b887a97d1fc4a1faa1a789f3675574b5c1721e22935e1c9ae05bbf61eaabd46e", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:50:25.887263+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "87%", "start": 431, "end": 434, "evidence": " In Chicago , 87% of the days from December 1-February 14 had average- to above-average temperatures.", "interpretation": "not_classified"}, {"value_text": "6%", "start": 668, "end": 670, "evidence": " A 10-day cold snap in mid-January in the region was not intense enough to allow much ice to grow on the Great Lakes, and January ice extent was just 6% of the lake surface, compared to the 50-year average of 18%.", "interpretation": "not_classified"}, {"value_text": "18%", "start": 727, "end": 730, "evidence": " A 10-day cold snap in mid-January in the region was not intense enough to allow much ice to grow on the Great Lakes, and January ice extent was just 6% of the lake surface, compared to the 50-year average of 18%.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 505, "end": 516, "evidence": "m. In Chicago , 87% of the days from December 1-February 14 had average- to above-average temperatures. A 10-day cold snap in mid-January in the region was not intense enough to allow much ice to grow on the Great Lakes, and January ice exte"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:25.928281+00:00", "published_at_raw": "2024-02-16T12:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938