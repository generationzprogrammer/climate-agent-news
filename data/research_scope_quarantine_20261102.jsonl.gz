{"text_id": "text_21bb5ac989343c756464", "record_id": "article_21bb5ac989343c75", "canonical_url": "https://news.mongabay.com/2025/11/bird-diversity-drops-in-human-dominated-habitats-nepal-study-suggests", "publisher_url": "https://news.mongabay.com/2025/11/bird-diversity-drops-in-human-dominated-habitats-nepal-study-suggests", "title_original": "Bird diversity drops in human-dominated habitats, Nepal study suggests", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-11-26T13:55:54+00:00", "source_text": "KATHMANDU — Birds prefer to live in a mix of forests, fields and wetlands, but human activities such as logging, hunting and sand and gravel mining are taking a toll on such mosaics in Nepal’s southern plains, a recent study shows. The research, published in the Journal of Environmental Management, suggests such a mosaic of […]", "text_kind": "source_excerpt", "text_characters": 329, "text_sha256": "f7a760a10445ff29988324c0afbc1a22f956f046e3478a8b855855bd218ae572", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:04.929033+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "annotation_method": "dictionary-evidence-v1", "rev