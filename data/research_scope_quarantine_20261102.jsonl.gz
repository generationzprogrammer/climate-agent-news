{"text_id": "text_9b2bf8fa846dccccab30", "record_id": "article_9b2bf8fa846dcccc", "canonical_url": "https://news.mongabay.com/2025/12/the-year-in-rainforests-2025-deforestation-fell-the-risks-did-not", "publisher_url": "https://news.mongabay.com/2025/12/the-year-in-rainforests-2025-deforestation-fell-the-risks-did-not", "title_original": "The year in rainforests 2025: Deforestation fell; the risks did not", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-26T20:11:46+00:00", "source_text": "The story of the world’s tropical forests in 2025 was not one of dramatic reversal, but one shaped by accumulated pressure. In several regions, deforestation slowed. In others, loss continued in less visible forms, shaped by fire, degradation, and political choices not limited to large-scale clearing alone. Governments continued to speak the language of protection, […]", "text_kind": "source_excerpt", "text_characters": 371, "text_sha256": "687949d6c47cde8585e3875b9802ea8ecd02b8857606a345fc5d16e0c9daa610", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:45.526094+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:45.598115+00:00", "published_at_raw": "2025-12-26T20:11:46", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_7880a4d2979389660cc6", "record_id": "article_7880a4d297938966", "canonical_url": "https://news.mongabay.com/2025/12/stuart-brooks-conservationist-of-unfashionable-landscapes", "publisher_url": "https://news.mongabay.com/2025/12/stuart-brooks-conservationist-of-unfashionable-landscapes", "title_original": "Stuart Brooks, peat protector, has died", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-12-26T08:02:17+00:00", "source_text": "Founder’s Briefs: An occasional series where Mongabay founder Rhett Ayers Butler shares analysis, perspectives and story summaries. For much of the late 20th and early 21st centuries, peatlands sat awkwardly at the edge of public consciousness. Neither conventionally scenic nor easily commodified, they were drained, burned, planted over, or dismissed as wasteland. Only gradually did […]", "text_kind": "source_excerpt", "text_characters": 389, "text_sha256": "01d9dd50baba16efad9465152c94235d4ab4836ce34266acf2cac681bebd6e3b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:45.768564+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive