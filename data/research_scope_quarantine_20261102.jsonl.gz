{"text_id": "text_c6222b8204884df81a57", "record_id": "article_c6222b8204884df8", "canonical_url": "https://news.mongabay.com/2024/10/jbs-broke-its-own-rules-while-buying-cattle-from-deforested-areas-in-pantanal", "publisher_url": "https://news.mongabay.com/2024/10/jbs-broke-its-own-rules-while-buying-cattle-from-deforested-areas-in-pantanal", "title_original": "JBS broke its own rules while buying cattle from deforested areas in Pantanal", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-31T10:00:52+00:00", "source_text": "JBS, the world’s largest meatpacking company, has over the last five years been buying cattle from farms that were caught illegally deforesting Brazil’s Pantanal wetlands despite the company’s claims of environmental responsibility.", "text_kind": "source_excerpt", "text_characters": 232, "text_sha256": "7e45b9cd7be159a3de6ab6b80c77f2d3428282acee1cebd0273cab31e51d8704", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:02.785343+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpo