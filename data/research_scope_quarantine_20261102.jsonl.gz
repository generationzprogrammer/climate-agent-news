{"text_id": "text_a442ff354340d406e7b0", "record_id": "article_a442ff354340d406", "canonical_url": "https://news.mongabay.com/2024/07/in-nepal-criticizing-government-conservation-policies-is-becoming-harder", "publisher_url": "https://news.mongabay.com/2024/07/in-nepal-criticizing-government-conservation-policies-is-becoming-harder", "title_original": "In Nepal, criticizing government conservation policies is becoming harder", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-30T15:13:28+00:00", "source_text": "KATHMANDU — When Nepal’s government approved a controversial measure at the start of the year to permit hydropower development inside protected areas, there was an uproar in the conservation community — but a largely muted one. While many privately expressed their discontent, only a few people and organizations publicly criticized the move, despite its potential […]", "text_kind": "source_excerpt", "text_characters": 368, "text_sha256": "24ef03d0671b6355a5d1291b94420459c5fb17fa652ce5ba4f3822900278200f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:50.285863+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "adopted", "label_zh": "通过", "label_en": "Adopted", "start": 36, "end": 44, "evidence": "KATHMANDU — When Nepal’s government approved a controversial measure at the start of the year to permit hydropower development inside protected areas, there was an uproar in the conser"}], "track": "action", "country_mentions": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:50.337445+00:00", "published_at_raw": "2024-07-30T15:13:28", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 3, "end": 8, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "NP", "alpha3": "NPL", "name_zh": "尼泊尔", "name_en": "Nepal", "start": 17, "end": 22, "matched_text": "Nepal", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_15087f52b5429e0f8579", "record_id": "article_15087f52b5429e0f", "canonical_url": "https://news.mongabay.com/2024/07/dna-testing-proves-that-cocoa-originated-in-the-amazon-and-reveals-robust-pre-columbian-trade", "publisher_url": "https://news.mongabay.com/2024/07/dna-testing-proves-that-cocoa-originated-in-the-amazon-and-reveals-robust-pre-columbian-trade", "title_original": "DNA testing proves that cocoa originated in the Amazon and reveals robust pre-Columbian trade", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-29T11:46:37+00:00", "source_text": "It’s hard to imagine the history that lies behind the cacao trees grown on agroforestry farms in the Amazon today. For a long time, people believed that cacao’s origins lay elsewhere. Archaeological evidence had pointed to what is today southern Mexico and Central America — Mesoamerica — as the birthplace of the domesticated form of […]", "text_kind": "source_excerpt", "text_characters": 338, "text_sha256": "d15e7f3559b8be6b5ca6105fd5762ced7c10cba7db408b8fe9238aec9357c2bf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:50.805028+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:50.832862+00:00", "published_at_raw": "2024-07-29T11:46:37", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 246, "end": 252, "matched_text": "Mexico", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_b0129d24841ed0e972a1", "record_id": "article_b0129d24841ed0e9", "canonical_url": "https://insideclimatenews.org/news/26072024/todays-climate-olympics-heat-health-risks", "publisher_url": "https://insideclimatenews.org/news/26072024/todays-climate-olympics-heat-health-risks", "title_original": "At the Olympics, Heat Can Raise the Danger Bar of Competitions", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-26T17:45:47+00:00", "source_text": "Athletes from more than 200 countries have convened in Paris for the Olympic Games. But looming over it is the memory of the last summer Olympics in 2021, the hottest on record. Forced to compete in temperatures regularly above 92 degrees Fahrenheit, athletes from different sports buckled under Tokyo’s unusually high summer temperatures. Marathoners vomited […]", "text_kind": "source_excerpt", "text_characters": 363, "text_sha256": "f457bd8af9abb8f3becc170a0476126bdf70e70fe4bc21c95e1b8632d1f45a94", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:23.416899+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "science", "label_zh": "气候科学与风险", "label_en": "Climate science and risk", "start": 199, "end": 210, "evidence": "e memory of the last summer Olympics in 2021, the hottest on record. Forced to compete in temperatures regularly above 92 degrees Fahrenheit, athletes from different sports buckled under Tokyo’s unusually high summer temperatures. Marathoner"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:23.430090+00:00", "published_at_raw": "2024-07-26T17:45:47", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_0ecbbf33aa92fec3dc4f", "record_id": "article_0ecbbf33aa92fec3", "canonical_url": "https://insideclimatenews.org/news/26072024/western-states-industry-groups-unite-to-block-blm-land-policy", "publisher_url": "https://insideclimatenews.org/news/26072024/western-states-industry-groups-unite-to-block-blm-land-policy", "title_original": "Western States and Industry Groups Unite to Block BLM’s Conservation Priority Land Rule", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-26T09:00:00+00:00", "source_text": "Efforts are growing in the West to block the Bureau of Land Management’s new public land policy aimed at enhancing the conservation and ecological health of public lands. The WEST (Western Economic Security Today) Act, which passed in the U.S. House of Representatives last week, is the latest attempt by Western states to repeal the […]", "text_kind": "source_excerpt", "text_characters": 337, "text_sha256": "bfca7cd3adc4799e520296552a4410a024d8cfb83b5c6c97e779eb2365f48117", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:23.517801+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:23.529855+00:00", "published_at_raw": "2024-07-26T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 239, "end": 243, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_251e71f66d96cca4257a", "record_id": "article_251e71f66d96cca4", "canonical_url": "https://news.mongabay.com/2024/07/indigenous-communities-in-the-bolivian-amazon-combat-droughts-and-floods", "publisher_url": "https://news.mongabay.com/2024/07/indigenous-communities-in-the-bolivian-amazon-combat-droughts-and-floods", "title_original": "Indigenous communities in the Bolivian Amazon combat droughts and floods", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-07-25T09:28:43+00:00", "source_text": "Luis Fernando Pumuy turns on the spigot outside of his house and splashes water onto most of his body, trying to cool off from the unrelenting heat in the Indigenous community of Asunción del Quiquibey, where the Mosetén and Tsimané ethnic groups both live. Even though the water now flows out of the spigot with […]", "text_kind": "source_excerpt", "text_characters": 316, "text_sha256": "a18a969e66a6797d8010413f7ca2a78afe539f1d529e6f6d4ca2ebf71efb4604", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:51.184610+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 155, "end": 165, "evidence": "splashes water onto most of his body, trying to cool off from the unrelenting heat in the Indigenous community of Asunción del Quiquibey, where the Mosetén and Tsimané ethnic gr