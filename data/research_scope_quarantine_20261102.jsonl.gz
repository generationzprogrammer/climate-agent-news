{"text_id": "text_d5f1c05ee6467cb9f0d5", "record_id": "article_d5f1c05ee6467cb9", "canonical_url": "https://insideclimatenews.org/news/14022024/to-save-the-planet-traditional-indigenous-knowledge-is-indispensable", "publisher_url": "https://insideclimatenews.org/news/14022024/to-save-the-planet-traditional-indigenous-knowledge-is-indispensable", "title_original": "Q&A: To Save The Planet, Traditional Indigenous Knowledge Is Indispensable", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-14T10:10:00+00:00", "source_text": "The past few years have been a triumph for traditional Indigenous knowledge, the body of observations, innovations and practices developed by Indigenous peoples throughout history with regard to their local environment. First, the world’s top scientific and environmental policymaking bodies embraced it. Then, in 2022, the Biden administration instructed U.S. federal agencies to include it […]", "text_kind": "source_excerpt", "text_characters": 395, "text_sha256": "6185281f9be1bf0865f4e839d07d31206c77edc95bca7d0d24d1badad20de4ed", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:32.514710+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [{"id": "justice", "label_zh": "公正转型", "label_en": "Just transition", "start": 55, "end": 65, "evidence": "The past few years have been a triumph for traditional Indigenous knowledge, the body of observations, innovations and practices developed by Indigenous peoples throughout history with regard to their loca"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:32.533239+00:00", "published_at_raw": "2024-02-14T10:10:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 356, "end": 360, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_8e4904eda191e22752d6", "record_id": "article_8e4904eda191e227", "canonical_url": "https://dialogue.earth/en/food/book-review-survival-at-stake-makes-a-case-for-veganism", "publisher_url": "https://dialogue.earth/en/food/book-review-survival-at-stake-makes-a-case-for-veganism", "title_original": "Book review: Survival at Stake makes a case for veganism", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-13T16:27:30+00:00", "source_text": "Poorva Joshipura’s heavily-researched book, Survival at Stake, is a devastating catalogue of both human cruelty towards animals, and also how our unrestrained exploitation of the animal kingdom endangers humanity. Joshipura’s work with the People for the Ethical Treatment of Animals (PETA) Foundation UK underpins her arguments, and she offers granular details to back up her claims. Unfortunately, by focussing overwhelmingly on what she defines as the well-being of animals, Joshipura makes some critical errors. The book begins by focussing on the Covid-19 pandemic.", "text_kind": "article_excerpt", "text_characters": 570, "text_sha256": "783e2c66e0ef0114a3e977619ecfd4d8495c9d1c2e71dcb246c94831984d3022", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:45.820888+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:45.838822+00:00", "published_at_raw": "2024-02-13T16:27:30", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "GB", "alpha3": "GBR", "name_zh": "英国", "name_en": "United Kingdom", "start": 302, "end": 304, "matched_text": "UK", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577910+00:00"}
{"text_id": "text_bfd3808389ef42a98d8b", "record_id": "article_bfd3808389ef42a9", "canonical_url": "https://news.mongabay.com/2024/02/black-rhinos-moved-to-kenyas-loisaba-conservancy-as-species-recovers", "publisher_url": "https://news.mongabay.com/2024/02/black-rhinos-moved-to-kenyas-loisaba-conservancy-as-species-recovers", "title_original": "Black rhinos moved to Kenya’s Loisaba Conservancy as species recovers", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-02-13T00:01:01+00:00", "source_text": "Twenty-one critically endangered black rhinos have been safely delivered to Loisaba Conservancy in northern Kenya from other parts of the country, part of a wider mission to secure the long-term future of the species in Kenya. “It’s been a massive operation,” says Tom Silvester, CEO of Loisaba Conservancy, who oversaw the process. “It’s incredible to […]", "text_kind": "source_excerpt", "text_characters": 356, "text_sha256": "887b6720bad336ae4e50a62a7cc64795939c7414a542383093894c870a305814", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:56:13.786423+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "KE", "alpha3": "KEN", "name_zh": "肯尼亚", "name_en": "Kenya"}], "annotation_method": "dicti