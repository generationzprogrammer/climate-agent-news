{"text_id": "text_fcfce841a8e43eab2735", "record_id": "article_fcfce841a8e43eab", "canonical_url": "https://news.mongabay.com/2024/05/pemex-waste-contaminates-mexican-communities-while-talking-sustainability", "publisher_url": "https://news.mongabay.com/2024/05/pemex-waste-contaminates-mexican-communities-while-talking-sustainability", "title_original": "Pemex waste contaminates Mexican communities while talking ‘sustainability’", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-05-14T13:07:46+00:00", "source_text": "When the machines and men came to bury toxic sludge on a property near her house in the Mexican state of Tabasco, Lorenza Castro Castro at first thought it was a kind of fertile soil. Companies contracted by Mexico’s state-owned oil giant, Petróleos Mexicanos, or Pemex, had come with truckloads of black earth and set […]", "text_kind": "source_excerpt", "text_characters": 322, "text_sha256": "8a7aaf4fc38afecd639fbf0e2aef785fa84a306af6169a98a0a65a64e021d803", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:33.602783+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v