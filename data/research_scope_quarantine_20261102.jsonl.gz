{"text_id": "text_998f587683b4e5b3795b", "record_id": "article_998f587683b4e5b3", "canonical_url": "https://news.mongabay.com/2025/10/how-to-clean-solar-panels-in-arid-areas-waterless-systems-could-improve-efficiency", "publisher_url": "https://news.mongabay.com/2025/10/how-to-clean-solar-panels-in-arid-areas-waterless-systems-could-improve-efficiency", "title_original": "How to clean solar panels in arid areas? Waterless systems could improve efficiency", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-24T16:41:54+00:00", "source_text": "As the world grapples with the challenges of meeting rising electricity demand, particularly in developing countries, solar energy has emerged as a beacon of hope. In sub-Saharan Africa, where energy poverty is a persistent challenge, the potential for solar energy is vast. Monocrystalline photovoltaic (PV) panels have become a popular choice for solar energy generation […]", "text_kind": "source_excerpt", "text_characters": 376, "text_sha256": "0ff190d0d6cd6d0a63a4dc00a039038e037bdbab63380a5326521b6d4d1eb0bb", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:40.382969+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 118, "end": 123, "evidence": "he challenges of meeting rising electricity demand, particularly in developing countries, solar energy has emerged as a beacon of hope. In sub-Saharan Africa, where energy poverty is a persistent challenge, the potential for solar ener"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:50:40.439736+00:00", "published_at_raw": "2025-10-24T16:41:54", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.573678+00:00"}
{"text_id": "text_19f43d93f9fa5efe6e6c", "record_id": "article_19f43d93f9fa5efe", "canonical_url": "https://news.mongabay.com/2025/10/ai-system-eavesdrops-on-elephants-to-prevent-deadly-encounters-in-india", "publisher_url": "https://news.mongabay.com/2025/10/ai-system-eavesdrops-on-elephants-to-prevent-deadly-encounters-in-india", "title_original": "AI system eavesdrops on elephants to prevent deadly encounters in India", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-10-23T15:35:10+00:00", "source_text": "When elephant biologist Seema Lokhandwala, with the Elephants Acoustic Project, visited a village near Balipara in India’s Assam state, as part of her fieldwork in December 2015, she witnessed firsthand what it takes to live alongside elephants. After night fell, a herd of 150 elephants — “I counted them,” she says — devoured all of […]", "text_kind": "source_excerpt", "text_characters": 338, "text_sha256": "96affd5ac14914b8b348d0bbc5049800e9ece25d333828b02b92bd1594c32462", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:50:40.527551+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-eviden