{"text_id": "text_dbe67b05eb56e6e51c15", "record_id": "article_dbe67b05eb56e6e5", "canonical_url": "https://insideclimatenews.org/news/21072026/california-commercial-salmon-fishing", "publisher_url": "https://insideclimatenews.org/news/21072026/california-commercial-salmon-fishing", "title_original": "As Commercial Salmon Fishing Resumes in California, the Industry Faces a Murky Outlook", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-21T09:00:00+00:00", "source_text": "When he stares out from the docks on the Feather River, James Stone—a 46-year-old lifelong fisherman—feels a pang of concern. Fishing for chinook salmon, also called king salmon, had been called off completely for California’s commercial fishermen since 2023 and nearly as long for recreational anglers. While the fishery is open again this year, and […]", "text_kind": "source_excerpt", "text_characters": 354, "text_sha256": "3a3088671060407f65cd3fa9ebdce5fb434d2b80b69a9f12af75b6d0ab5fec9b", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:37.812788+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:37.828292+00:00", "published_at_raw": "2026-07-21T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 40, "end": 50, "matched_text": "California", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 214, "end": 224, "matched_text": "California", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_868da20372257db06892", "record_id": "article_868da20372257db0", "canonical_url": "https://news.mongabay.com/2026/07/clean-cooking-expands-at-record-pace-in-africa-but-lags-behind-population-growth", "publisher_url": "https://news.mongabay.com/2026/07/clean-cooking-expands-at-record-pace-in-africa-but-lags-behind-population-growth", "title_original": "Clean cooking expands at record pace in Africa, but lags behind population growth", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-20T16:13:53+00:00", "source_text": "Sub-Saharan Africa is on track to record its fastest-ever annual expansion in access to clean cooking in 2026, according to a new report by the International Energy Agency. But population growth continues to outpace those gains, leaving more than 1 billion people without access to clean cooking. The region is home to the world’s largest […]", "text_kind": "source_excerpt", "text_characters": 342, "text_sha256": "fb1872fd48910db9860c58c7e4845cee6ded6a3165b3c5dab9a92fc74b9c0124", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:37.332888+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "1 billion", "start": 247, "end": 256, "evidence": " But population growth continues to outpace those gains, leaving more than 1 billion people without access to clean cooking.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [{"id": "energy", "label_zh": "能源与产业", "label_en": "Energy and industry", "start": 158, "end": 164, "evidence": "ansion in access to clean cooking in 2026, according to a new report by the International Energy Agency. But population growth continues to outpace those gains, leaving more than 1 billion people without access to clean cooking. The reg"}], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:37.363130+00:00", "published_at_raw": "2026-07-20T16:13:53", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_2be8f35af9afbaa675ed", "record_id": "article_2be8f35af9afbaa6", "canonical_url": "https://news.mongabay.com/2026/07/perus-only-penguin-species-at-risk-from-upcoming-el-nino-and-bird-flu-experts-warn", "publisher_url": "https://news.mongabay.com/2026/07/perus-only-penguin-species-at-risk-from-upcoming-el-nino-and-bird-flu-experts-warn", "title_original": "Peru’s only penguin species at risk from upcoming El Niño and bird flu, experts warn", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-20T11:11:02+00:00", "source_text": "SAN JUAN DE MARCONA, Peru — First, there was the H5N1 avian influenza of 2022, then El Niño arrived in 2023, disrupting coastal waters and fish availability. For Peru’s Humboldt penguins, the only species of penguins that breeds in the country, the burden was too heavy: Its population dropped by two-thirds between 2022 and 2025. […]", "text_kind": "source_excerpt", "text_characters": 334, "text_sha256": "6486d6d1193d9a997098aba23ce0cfa90dbecda35cf525e8ab0f3f0885fd9cbe", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:37.424045+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:46:37.455332+00:00", "published_at_raw": "2026-07-20T11:11:02", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru", "start": 0, "end": 4, "matched_text": "Peru", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "PE", "alpha3": "PER", "name_zh": "秘鲁", "name_en": "Peru", "start": 21, "end": 25, "matched_text": "Peru", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.572641+00:00"}
{"text_id": "text_6d84e1afedef201ccd2b", "record_id": "article_6d84e1afedef201c", "canonical_url": "https://yaleclimateconnections.org/2026/07/kids-plant-trees-change-neighborhoods", "publisher_url": "https://yaleclimateconnections.org/2026/07/kids-plant-trees-change-neighborhoods", "title_original": "Kids plant trees, change neighborhoods", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-07-20T11:00:00+00:00", "source_text": "Transcript: Children in the Pittsburgh area are helping improve their neighborhoods by planting trees. The One Tree Per Child Program , run by the nonprofit Tree Pittsburgh, helps children plant trees around schools, parks, streets, playgrounds, and other spots. Fantazier: “We really love when we’re able to plant trees in a space that those students are going to experience again and again. … Typically, it’s pretty magical. Young people often want to name the tree that they plant.” Jonathan Fantazier, who runs the program, says the One Tree Per Child Initiative was started in Australia by singer Olivia Newton-John and her friend Jon Dee. It was brought to Pittsburgh about 10 years ago, and participants have since planted hundreds of trees.", "text_kind": "article_excerpt", "text_characters": 748, "text_sha256": "9157bf30eb8f05ef41fb515b2f1db60b8d3a2447d47341b2c8a1d2e79a875a8c", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:45:45.324798+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": 