{"text_id": "text_b7ccb5a69813f1691a38", "record_id": "article_b7ccb5a69813f169", "canonical_url": "https://news.mongabay.com/2024/08/holistic-care-for-an-ethiopian-lake-system-interview-with-redwan-mohammed", "publisher_url": "https://news.mongabay.com/2024/08/holistic-care-for-an-ethiopian-lake-system-interview-with-redwan-mohammed", "title_original": "Holistic care for an Ethiopian lake system: Interview with Redwan Mohammed", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-06T17:47:31+00:00", "source_text": "Ethiopia’s Abijata-Shalla Lakes National Park is set in a semiarid landscape of grassy plains, hills scattered with acacia trees, and ravines cut by seasonal streams. Spanning 887 square kilometers (342 square miles) and located some 200 kilometers (120 miles) south of the capital, Addis Ababa, it includes the two Rift Valley lakes it’s named after. […]", "text_kind": "source_excerpt", "text_characters": 355, "text_sha256": "4c51af5ffacd2c0146db5c161003d7a49512724ed78976dc533b10a2237e5adb", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:44.193290+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:44.208007+00:00", "published_at_raw": "2024-08-06T17:47:31", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ET", "alpha3": "ETH", "name_zh": "埃塞俄比亚", "name_en": "Ethiopia", "start": 0, "end": 8, "matched_text": "Ethiopia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576866+00:00"}
{"text_id": "text_7c950ed7efc7aadf7470", "record_id": "article_7c950ed7efc7aadf", "canonical_url": "https://insideclimatenews.org/news/04082024/florida-coral-unprecedented-marine-heat", "publisher_url": "https://insideclimatenews.org/news/04082024/florida-coral-unprecedented-marine-heat", "title_original": "For Florida Corals, Unprecedented Marine Heat Prompts New Restoration Strategy—On Shore", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-04T09:05:00+00:00", "source_text": "ORLANDO, Fla.—Tucked away in an office park hundreds of miles from the southeast Florida coast where North America’s only barrier reef is at dire risk, a collection of brain corals performed a once-a-year feat—producing a constellation of egg sacks, each a bundle of hope. The brain corals, with their geometric design of grooves, are among […]", "text_kind": "source_excerpt", "text_characters": 344, "text_sha256": "056769a1acdee0b8e417d5927856710622d1954d21bb5a8b0ccdce9639139ff4", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:16.613160+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archi