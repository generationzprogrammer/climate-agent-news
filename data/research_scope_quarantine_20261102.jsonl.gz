{"text_id": "text_b7baf8e59878813101fc", "record_id": "article_b7baf8e598788131", "canonical_url": "https://news.mongabay.com/2024/06/indonesia-must-integrate-marine-protection-with-fisheries-subsidies-study-says", "publisher_url": "https://news.mongabay.com/2024/06/indonesia-must-integrate-marine-protection-with-fisheries-subsidies-study-says", "title_original": "Indonesia must integrate marine protection with fisheries subsidies, study says", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-29T04:53:56+00:00", "source_text": "JAKARTA — In continuing to provide controversial subsidies for small-scale fishers, Indonesia must also integrate marine protection measures into social protection schemes, a new study has said. Government subsidies for fisheries have enabled industries to fish in economically unfeasible ocean areas, but this support has faced wide criticism for harming the long-term viability of marine […]", "text_kind": "source_excerpt", "text_characters": 393, "text_sha256": "465239e4da4afd1e34696fb2613f50615ac6f4bbca6bd315affa029e6b1799bc", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:01.733082+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "governance_themes": [], "policy_tools": [{"id": "subsidy", "label_zh": "补贴与激励", "label_en": "Subsidies and incentives", "start": 49, "end": 55, "evidence": "JAKARTA — In continuing to provide controversial subsidies for small-scale fishers, Indonesia must also integrate marine protection measures into social protection schemes, a new study has said. "}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:01.746179+00:00", "published_at_raw": "2024-06-29T04:53:56", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 0, "end": 9, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 84, "end": 93, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_ef934d9c696666510c48", "record_id": "article_ef934d9c69666651", "canonical_url": "https://dialogue.earth/en/nature/qa-nature-based-solutions-with-chinese-characteristics", "publisher_url": "https://dialogue.earth/en/nature/qa-nature-based-solutions-with-chinese-characteristics", "title_original": "Q&A: Nature-based solutions with Chinese characteristics", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-28T08:15:00+00:00", "source_text": "In an article published recently in Global Environmental Change, Annah Lake Zhu and co-researchers analysed China’s approach to “nature-based solutions” (NbS) and the increasing appearance of the concept in China’s cooperation with Global South countries. Dialogue Earth sat down with Dr Zhu, an assistant professor of environmental policy at Wageningen University in the Netherlands, to learn more. The interview has been lightly edited for length and clarity. Dialogue Earth: NbS is a globally used concept, but you argue in your paper that it may have specific meanings in China. What are NbS with Chinese characteristics? In a nutshell, they are large-scale, “eco-developmental” projects that blur the boundaries between the natural and the engineered.", "text_kind": "article_excerpt", "text_characters": 756, "text_sha256": "0df9d83366d93f95912569645c7099c73e3dcc0927bd09090ebd8ba5489339ab", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:13.588914+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "NL", "alpha3": "NLD", "name_zh": "荷兰", "name_en": "Netherlands"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "governance_themes": [], "policy_tools": [{"id": "cooperation", "label_zh": "合作与技术支持", "label_en": "Cooperation and technology", "start": 215, "end": 226, "evidence": "to “nature-based solutions” (NbS) and the increasing appearance of the concept in China’s cooperation with Global South countries. Dialogue Earth sat down with Dr Zhu, an assistant professor of environmental policy at Wageningen University i"}], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "NL", "alpha3": "NLD", "name_zh": "荷兰", "name_en": "Netherlands"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:13.645132+00:00", "published_at_raw": "2024-06-28T08:15:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 33, "end": 40, "matched_text": "Chinese", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "CN", "alpha3": "CHN", "name_zh": "中华人民共和国", "name_en": "China", "start": 108, "end": 113, "matched_text": "China", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "NL", "alpha3": "NLD", "name_zh": "荷兰", "name_en": "Netherlands", "start": 372, "end": 383, "matched_text": "Netherlands", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_fe01f71ed7b9171964a8", "record_id": "article_fe01f71ed7b91719", "canonical_url": "https://news.mongabay.com/2024/06/environmental-agents-intensify-strike-amid-record-fires-in-brazil", "publisher_url": "https://news.mongabay.com/2024/06/environmental-agents-intensify-strike-amid-record-fires-in-brazil", "title_original": "Environmental agents intensify strike amid record fires in Brazil", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-28T07:00:49+00:00", "source_text": "After six months of a partial strike , Brazilian environmental agents doubled down and announced an intensification of their protest for better work conditions and wages. The decision came after months of deadlock in the negotiations with the federal government, which in early June stated it had “reached the maximum limit, from a budgetary point of view, of what it can offer.” “The government unilaterally closed the negotiating channel we had,” Wallace Lopes, a director at the association representing the environmental specialists, ASCEMA, told Mongabay.", "text_kind": "article_excerpt", "text_characters": 560, "text_sha256": "8fd1a21cdea6ed0be9dfe724db999d5ed0740d9d5287cda8af08b4dfae8a7a32", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:55:01.868698+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:01.889282+00:00", "published_at_raw": "2024-06-28T07:00:49", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "BR", "alpha3": "BRA", "name_zh": "巴西", "name_en": "Brazil", "start": 59, "end": 65, "matched_text": "Brazil", "method": "country-span-v2", "source_field": "title_original"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_d9ae22c50a02e34a903e", "record_id": "article_d9ae22c50a02e34a", "canonical_url": "https://news.mongabay.com/2024/06/mineral-hotspots-in-the-pan-amazon", "publisher_url": "https://news.mongabay.com/2024/06/mineral-hotspots-in-the-pan-amazon", "title_original": "Mineral hotspots in the Pan Amazon", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-27T18:00:59+00:00", "source_text": "The mineral resources of the Pan Amazon are not randomly distributed across the region but are located on landscapes with specific geological histories. There are three conspicuous macro regions: A. The Amazon Craton is the term used to describe the complex of ancient rocks that form the heart of the continent, which was created via […]", "text_kind": "source_excerpt", "text_characters": 338, "text_sha256": "0cafbfe42bd4cc40b2c8915107356edd9d3634972624fe8c6f8da8691a4070c0", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:01.938962+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:01.954952+00:00", "published_at_raw": "2024-06-27T18:00:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_583fb240aca8d0dd0143", "record_id": "article_583fb240aca8d0dd", "canonical_url": "https://yaleclimateconnections.org/2024/06/trabajadores-al-aire-libre-desprotegidos", "publisher_url": "https://yaleclimateconnections.org/2024/06/trabajadores-al-aire-libre-desprotegidos", "title_original": "Trabajadores al aire libre en Miami desprotegidos legalmente ante el calor extremo", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Yale Climate Connections", "source_id": "INT008", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-27T15:18:05+00:00", "source_text": "A pesar del aumento significativo en las temperaturas, el gobernador Ron DeSantis firmó el proyecto de ley HB 433, que impide a los gobiernos locales exigir derechos humanos básicos como agua, sombra y descanso", "text_kind": "source_excerpt", "text_characters": 210, "text_sha256": "dfe239e78adbfb77d904a3f77d0bfb9a5ade7a35f8cc8002b6527ec5bc9367fa", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:49:49.912174+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://yaleclimateconnections.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:49:49.929126+00:00", "published_at_raw": "2024-06-27T15:18:05", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_31a08c0b5fa2e4b46600", "record_id": "article_31a08c0b5fa2e4b4", "canonical_url": "https://news.mongabay.com/2024/06/fire-bans-not-effective-as-the-amazon-and-pantanal-burn-study-says", "publisher_url": "https://news.mongabay.com/2024/06/fire-bans-not-effective-as-the-amazon-and-pantanal-burn-study-says", "title_original": "Fire bans not effective as the Amazon and Pantanal burn, study says", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-27T07:00:59+00:00", "source_text": "This year, both the Pantanal and the Amazon have recorded alarming rates of burning, with the wetland breaking recent records that caused an international uproar.", "text_kind": "source_excerpt", "text_characters": 162, "text_sha256": "c473f6509799dc6d7ece5d9b94e36e043553f0a7c98b6c416b6ea880158fd0ca", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:55:06.842347+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:55:06.854059+00:00", "published_at_raw": "2024-06-27T07:00:59", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
{"text_id": "text_9afdd73439d29862c022", "record_id": "article_9afdd73439d29862", "canonical_url": "https://dialogue.earth/en/water/ethnic-conflict-puts-indias-loktak-lake-under-stress", "publisher_url": "https://dialogue.earth/en/water/ethnic-conflict-puts-indias-loktak-lake-under-stress", "title_original": "Ethnic conflict puts India’s Loktak lake under stress", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Dialogue Earth", "source_id": "INT009", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-06-27T06:00:00+00:00", "source_text": "Loktak Lake, in the northeastern state of Manipur, spanning 287 sq km , is one of the largest freshwater lakes in India. Over 100,000 people live in villages along its shores, relying on its fish for their livelihoods. Embedded deeply in Manipuri culture and folklore , the lake has served as a vital lifeline to many as conflict between the Meitei and Kuki-Zo ethnic groups has consumed the state since May 2023 . Laishram Shanta, 50, from the village of Thinungei on the lake’s shore, used to earn a living as a woodcutter, travelling to remote hill villages for work. However, the ethnic violence in Manipur has made such travel perilous. In the past 14 months, more than 226 people have been killed and at least 67,000 displaced, dividing the state between Meitei areas and Kuki-Zo areas.", "text_kind": "article_excerpt", "text_characters": 792, "text_sha256": "7abbc91e5de090d564977b295c6b3a79a35450bcc40ffb0d8991596715cbe983", "text_basis": "public_wordpress_content_excerpt", "collected_at": "2026-11-02T01:47:13.723500+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://dialogue.earth/en/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:47:13.761600+00:00", "published_at_raw": "2024-06-27T06:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 21, "end": 26, "matched_text": "India", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "IN", "alpha3": "IND", "name_zh": "印度", "name_en": "India", "start": 114, "end": 119, "matched_text": "India", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.577387+00:00"}
