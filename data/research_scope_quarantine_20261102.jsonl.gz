{"text_id": "text_b18f4ba4941dae691f02", "record_id": "article_b18f4ba4941dae69", "canonical_url": "https://insideclimatenews.org/news/09082024/todays-climate-sustainable-aviation-fuel-greenwashing-claims", "publisher_url": "https://insideclimatenews.org/news/09082024/todays-climate-sustainable-aviation-fuel-greenwashing-claims", "title_original": "Sustainable Aviation Fuels Are Struggling to Take Off Amid Greenwashing Claims", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-08-09T15:21:21+00:00", "source_text": "Last November, Virgin Atlantic Airways made headlines for completing the world’s first transatlantic flight using “100 percent sustainable aviation fuel.” This week, the Advertising Standard Authority (ASA) of the U.K. banned a Virgin radio ad released prior to the flight, in which they touted their “unique flight mission.” While Virgin did use fuel that releases […]", "text_kind": "source_excerpt", "text_characters": 369, "text_sha256": "af8216160b864e7af5c9f08e4148768ff92d7df3903087ee1155c1cff3961101", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:15.222754+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "100 percent", "start": 115, "end": 126, "evidence": "Last November, Virgin Atlantic Airways made headlines for completing the world’s first transatlantic flight using “100 percent sustainable aviation fuel.", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "c