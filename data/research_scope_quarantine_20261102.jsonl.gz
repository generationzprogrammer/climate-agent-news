{"text_id": "text_949335864f8ac5c289b1", "record_id": "article_949335864f8ac5c2", "canonical_url": "https://insideclimatenews.org/news/21052025/el-paso-dust-storm-drought-climate-change", "publisher_url": "https://insideclimatenews.org/news/21052025/el-paso-dust-storm-drought-climate-change", "title_original": "El Paso Hasn’t Seen This Many Dust Storms Since the Dust Bowl", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2025-05-21T09:00:00+00:00", "source_text": "EL PASO, Texas—On a Tuesday afternoon in May, earth system scientist Thomas Gill was tracking yet more dust rolling through this border city. Gill, a member of the faculty at the University of Texas at El Paso (UTEP), was waiting to see whether this dusty day would swirl into a full-blown dust storm, in which […]", "text_kind": "source_excerpt", "text_characters": 314, "text_sha256": "c5beeb1fa6dc6377acc4297934990fab0fb798460ae82050302b5bdffc03ac02", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:51:54.913168+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not