{"text_id": "text_e194e3a411a3099d20c6", "record_id": "article_e194e3a411a3099d", "canonical_url": "https://insideclimatenews.org/news/30102024/us-auto-industry-ev-future-clash-at-the-border", "publisher_url": "https://insideclimatenews.org/news/30102024/us-auto-industry-ev-future-clash-at-the-border", "title_original": "Competing Visions for U.S. Auto Industry Clash in Presidential Election, With the EV Future Pressing at the Border", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-30T09:00:00+00:00", "source_text": "MEXICO CITY—Paulina Hernández inspected her new BYD King plug-in hybrid sedan when the sales team removed the oversized red bow and cover. She noticed a smudge on the “Time Grey” finish and her sales rep, Veronica Montoya, rushed to her side with a spray bottle and cloth. Montoya held them as she answered her customer’s […]", "text_kind": "source_excerpt", "text_characters": 325, "text_sha256": "954c5de5495f4bbf31571deb361875d41ea52adceb633dc30f68898255ae331f", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:53:39.924838+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}, {"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://insideclimatenews.org/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:53:39.936734+00:00", "published_at_raw": "2024-10-30T09:00:00", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "US", "alpha3": "USA", "name_zh": "美国", "name_en": "United States", "start": 22, "end": 26, "matched_text": "U.S.", "method": "country-acronym-v2", "source_field": "title_original"}, {"alpha2": "MX", "alpha3": "MEX", "name_zh": "墨西哥", "name_en": "Mexico", "start": 0, "end": 6, "matched_text": "MEXICO", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_f9b3622c7a238bb68fdf", "record_id": "article_f9b3622c7a238bb6", "canonical_url": "https://news.mongabay.com/2024/10/glimmers-of-promise-for-30x30-goal-as-un-report-calls-for-boosted-efforts", "publisher_url": "https://news.mongabay.com/2024/10/glimmers-of-promise-for-30x30-goal-as-un-report-calls-for-boosted-efforts", "title_original": "‘Glimmers of promise’ for 30×30 goal as UN report calls for boosted efforts", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-29T16:59:20+00:00", "source_text": "In December 2022, nearly 200 countries adopted the Kunming-Montreal Global Biodiversity Framework, committing to protect 30% of Earth’s lands and waters by 2030. Now, two years into this initiative, a new U.N. report shows both progress and challenges ahead. The “Protected Planet Report 2024,” released this week by the United Nations Environment Programme’s World Conservation […]", "text_kind": "source_excerpt", "text_characters": 382, "text_sha256": "e894da111f13f6d7f065e8ec744731c1f848cc8f6a941dc5af9365d16c925edf", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:02.900111+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "30%", "start": 121, "end": 124, "evidence": "In December 2022, nearly 200 countries adopted the Kunming-Montreal Global Biodiversity Framework, committing to protect 30% of Earth’s lands and waters by 2030.", "interpretation": "target_or_commitment"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_stages": [{"id": "adopted", "label_zh": "通过", "label_en": "Adopted", "start": 39, "end": 46, "evidence": "In December 2022, nearly 200 countries adopted the Kunming-Montreal Global Biodiversity Framework, committing to protect 30% of Earth’s lands and waters by 2030. Now, two years into this"}], "track": "action", "country_mentions": [], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:02.912659+00:00", "published_at_raw": "2024-10-29T16:59:20", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantined_at": "2026-11-02T02:09:04.576363+00:00"}
{"text_id": "text_6e3ae05504665f6bf68b", "record_id": "article_6e3ae05504665f6b", "canonical_url": "https://news.mongabay.com/2024/10/indonesia-biomass-zone-for-japan-and-s-korea-energy-razes-rainforest-in-sulawesi", "publisher_url": "https://news.mongabay.com/2024/10/indonesia-biomass-zone-for-japan-and-s-korea-energy-razes-rainforest-in-sulawesi", "title_original": "Indonesia biomass zone for Japan and S. Korea energy razes rainforest in Sulawesi", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Mongabay", "source_id": "INT007", "source_type": "professional_climate_media", "language": "en", "published_at": "2024-10-28T04:12:31+00:00", "source_text": "POHUWATO, Indonesia — Heavy trucks roll toward a semiremote coastline here on Indonesia’s Sulawesi Island before idling alongside a waiting barge, which will later make a vast shipment of wood pellets to Japan and South Korea. The shipping terminal was built by PT Biomasa Jaya Abadi (BJA), an Indonesian firm with ambitions to become a […]", "text_kind": "source_excerpt", "text_characters": 340, "text_sha256": "1460aa1d37b4e6a1d6d1da324a88b2b79463eb6b61ff69da8896635d568f85c1", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:54:03.179516+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}, {"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan"}, {"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea"}], "governance_themes": [], "policy_tools": [], "policy_stages": [], "track": "action", "country_mentions": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia"}, {"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan"}, {"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea"}], "annotation_method": "dictionary-evidence-v1", "review_status": "machine_extracted_not_human_verified", "archive_source_endpoint": "https://news.mongabay.com/wp-json/wp/v2/posts", "archive_collected_at": "2026-11-02T01:54:03.191935+00:00", "published_at_raw": "2024-10-28T04:12:31", "sample_frame": "public_archives_20261102", "sampling_method": "deterministic_uniform_url_hash", "sampling_probability": 0.30234709214938144, "country_evidence": [{"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 0, "end": 9, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan", "start": 27, "end": 32, "matched_text": "Japan", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea", "start": 40, "end": 45, "matched_text": "Korea", "method": "country-span-v2", "source_field": "title_original"}, {"alpha2": "ID", "alpha3": "IDN", "name_zh": "印度尼西亚", "name_en": "Indonesia", "start": 10, "end": 19, "matched_text": "Indonesia", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "JP", "alpha3": "JPN", "name_zh": "日本", "name_en": "Japan", "start": 204, "end": 209, "matched_text": "Japan", "method": "country-span-v2", "source_field": "source_text"}, {"alpha2": "KR", "alpha3": "KOR", "name_zh": "韩国", "name_en": "Korea", "start": 214, "end": 225, "matched_text": "South Korea", "method": "country-span-v2", "source_field": "source_text"}], "country_tag_version": "country-span-v2", "quarantine_reason": "stored_excerpt_and_headline_do_not_establish_climate_scope", "quarantin