{"text_id": "text_3e1c95cbbb4fc5d09faf", "record_id": "article_3e1c95cbbb4fc5d0", "canonical_url": "https://insideclimatenews.org/news/25062026/supreme-court-delivers-victory-for-pesticides", "publisher_url": "https://insideclimatenews.org/news/25062026/supreme-court-delivers-victory-for-pesticides", "title_original": "Supreme Court Delivers a Victory for Pesticide Companies in Fight Over Cancer Claims", "title_zh": null, "title_en": null, "summary_zh": null, "summary_en": null, "source_name": "Inside Climate News", "source_id": "INT004", "source_type": "professional_climate_media", "language": "en", "published_at": "2026-06-25T20:03:41+00:00", "source_text": "A Supreme Court ruling issued Thursday limits Americans’ ability to sue pesticide makers over alleged health harms from their products. The 7-2 decision overturned a 2023 Missouri circuit court ruling that required agrochemical company Monsanto to pay John Durnell of St. Louis $1.25 million in compensatory damages for failing to warn customers of the cancer-causing […]", "text_kind": "source_excerpt", "text_characters": 371, "text_sha256": "8320e83eb321b78d8521d45f5d223a4bef45a13fab7ae2904ae0a62174c28025", "text_basis": "public_wordpress_excerpt", "collected_at": "2026-11-02T01:46:56.836433+00:00", "extractor_version": "1.0.0", "document_type": "source_report", "document_type_basis": "document_genre_not_independently_established", "event_date": null, "event_date_precision": null, "source_updated_at": null, "policy_direction": null, "legal_effect": null, "summary_model": null, "quantitative_claims": [{"value_text": "$1.25 million", "start": 278, "end": 291, "evidence": " Louis $1.25 million in compensatory damages for failing to warn customers of the cancer-causing […]", "interpretation": "not_classified"}], "conference_ids": [], "agenda_item_id": null, "thematic_day_id": null, "rights_status": "source_attributed_excerpt_not_full_text", "country_codes": [], "governance_themes": [], "policy_tools": [], "policy_s