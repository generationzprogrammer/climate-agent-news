# Install outside repository as /etc/green-daily-fulltext.env (mode 600).
# Use the API key and endpoint from the SAME region. Never commit real values.
DAILY_FULLTEXT_API_KEY=
DAILY_FULLTEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DAILY_FULLTEXT_MODEL=qwen-plus
DAILY_FULLTEXT_DAILY_REQUEST_LIMIT=240
DAILY_FULLTEXT_INTERVAL=6
GREEN_PYTHON=.venv/bin/python
